diff --git a/scripts/main.gd b/scripts/main.gd
index b25b040..c54fcf5 100644
--- a/scripts/main.gd
+++ b/scripts/main.gd
@@ -1373,7 +1373,7 @@ func _refresh() -> void:
 	var visible_count := 0
 	if not Navigation.indoor(location) or visual_focus == "window": visible_count = world.visible_residents().size()
 	scene_view.update_view(location,world.hour_of_day(),str(world.s.weather),world.has_home_power() if Navigation.indoor(location) else bool(world.s.grid_online),world.can_trade(shop_id) if not shop_id.is_empty() else true,visible_count,visual_focus)
