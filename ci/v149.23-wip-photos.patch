+	picture.texture = scene_view.location_texture(location,"apartment" if world.s.profile.housing=="集合住宅" and location=="建物前" else "", _visual_phase())
 	district_card.visible = District.SITES.has(location) and picture.texture == null
 	district_card.text = location + "\n" + str({"コンビニ":"棚の並ぶ店内","近所の空き家":"人のいない住宅","デパート":"広い売り場"}.get(location, ""))
 	preview_button.visible = picture.texture != null
diff --git a/scripts/scene_view.gd b/scripts/scene_view.gd
index 28c415f..13bc5b0 100644
--- a/scripts/scene_view.gd
+++ b/scripts/scene_view.gd
@@ -4,7 +4,7 @@ extends Control
 const PHOTO_NAMES={
 	"寝室":"bedroom","居間":"living","台所":"kitchen","廊下":"hall",
 	"玄関":"entrance","共用廊下":"corridor","建物前":"building",
-	"屋外":"street","商店通り":"street","住宅街":"street","駅前":"street",
+	"屋外":"street","商店通り":"shopping_street","住宅街":"street","駅前":"street",
 	"食品店":"grocer","金物店":"hardware","薬局":"pharmacy",
 	"コンビニ":"konbini","近所の空き家":"vacant_house","デパート":"department_store"
 }
@@ -16,9 +16,13 @@ var shop_open:=true
 var people:=0
 var context:=""
 var cache:Dictionary={}
-func location_texture(location: String, override_name: String = "") -> Texture2D:
+## `phase` (alert / collapse / overgrown) picks "<photo>_<phase>.jpg" when that
+## variant exists; places without one keep their ordinary photo.
+func location_texture(location: String, override_name: String = "", phase: String = "") -> Texture2D:
 	var file:String=override_name if not override_name.is_empty() else PHOTO_NAMES.get(location,"")
 	if file.is_empty():return null
+	if not phase.is_empty() and phase != "normal" and ResourceLoader.exists("res://assets/photos/"+file+"_"+phase+".jpg"):
+		file += "_" + phase
 	if not cache.has(file):cache[file]=load("res://assets/photos/"+file+".jpg")
 	return cache[file]
 func update_view(next_place:String,next_hour:float,next_weather:String,next_power:bool,next_shop_open:bool,visible_people:int,next_context:String)->void:
diff --git a/tests/test_ui149_21.gd b/tests/test_ui149_21.gd
index 837f962..93b7d4f 100644
--- a/tests/test_ui149_21.gd
+++ b/tests/test_ui149_21.gd
@@ -131,6 +131,20 @@ func run() -> void:
 	await settle()
 	check(not game.drawer.visible and game.location == "コンビニ", "going from the map walks there")
 
+	# --- The shopping street's photo follows the city's stage; other places keep theirs.
+	await game._on_command("商店通りへ行く")
+	check(str(game.picture.texture.resource_path).ends_with("shopping_street.jpg"), "a normal day shows the ordinary shopping street")
+	for spec in [["alert", 15, "alert"], ["emergency", 500, "collapse"]]:
+		game.world.s.society = spec[0]
+		game.world.s.regional_cases = spec[1]
+		game._refresh()
+		check(str(game.picture.texture.resource_path).ends_with("shopping_street_%s.jpg" % spec[2]), "stage %s shows the %s photo" % [spec[0], spec[2]])
+	game.world.s.minute = 366 * 1440
+	game._refresh()
+	check(str(game.picture.texture.resource_path).ends_with("shopping_street_overgrown.jpg"), "a year later the street is overgrown")
+	await game._on_command("住宅街へ行く")
+	check(str(game.picture.texture.resource_path).ends_with("street.jpg"), "places without variants keep their photo")
+
 	# --- Settings: text size rebuilds the chronicle and is remembered.
 	game._open_tool("settings")
 	await settle()
