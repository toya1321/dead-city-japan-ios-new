+extends SceneTree
+## Everyday free-text inputs, played with the real model (DCJ_LLAMA_PROBE,
+## DCJ_GGUF); prints what the game did, to be read by a person.
+const Main = preload("res://main.tscn")
+const Real = preload("res://qa/real_npc_scenarios.gd")
+const Combat = preload("res://scripts/combat.gd")
+const Shelter = preload("res://scripts/shelter.gd")
+const CASES := [
+	["home", "腹減ったし何か食べるか"],
+	["home", "ちょっと外の様子を見てみる"],
+	["home", "喉かわいた"],
+	["home", "タバコ一本吸って落ち着く"],
+	["home", "暇だから本でも読もうかな"],
+	["home", "眠いからもう寝よう"],
+	["home", "玄関に鍵かけといて"],
+	["home", "コンビニに買い出しに行く"],
+	["home", "窓を全部ふさいで光が漏れないようにする"],
+	["home", "お風呂に水ためとこう"],
+	["konbini", "水を3本と食料を2つください"],
+	["konbini", "タバコひと箱"],
+	["fight", "近くにある自転車を倒して足止めする"],
+	["fight", "後ろに下がって距離をとる"],
+	["fight", "包丁で首を狙う"],
+	["fight", "全力で逃げる"],
+	["fight", "物陰に隠れてやり過ごす"],
+	["shelter", "配給の列に並ぶ"],
+	["shelter", "見張りを手伝わせてください"],
+	["shelter", "体育館で一晩泊まる"],
+	["outside", "家に戻る"],
+	["outside", "あたりを見回す"],
+]
+func _initialize() -> void:
+	call_deferred("run")
+func setup(g, state: String) -> void:
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 41
+	g._start_new_game(p)
+	g._finish_intro()
+	var w = g.world
+	w.s.minute = 4 * 1440 + 3 * 60
+	w.s.hunger = 50.0
+	w.s.thirst = 50.0
+	w.s.cigarettes = 5
+	g.location = "居間"
+	match state:
+		"konbini":
+			g.location = "コンビニ"
+		"fight":
+			w.s.society = "emergency"
+			g.location = "商店通り"
+			w.s.walkers.places = {"商店通り": 2}
+			w.s.walkers.encounter = {"place": "商店通り", "count": 2, "near": true, "since": w.s.minute, "from": "屋外"}
+			Combat.sync(w)
+		"shelter":
+			w.s.society = "disrupted"
+			var st: Dictionary = Shelter.state(w)
+			st.status = "open"; st.pop = 80; st.stock = 300.0
+			g.location = "避難所"
+		"outside":
+			g.location = "商店通り"
+	g._sync_player_position()
+	g._refresh()
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var use_model := not OS.get_environment("DCJ_GGUF").is_empty()
+	var only := OS.get_environment("DCJ_ONLY")
+	var backend = Real.RealModel.new() if use_model else null
+	if use_model:
+		g.local_model.backend = backend
+	g.local_model.load_timeout_ms = 400000
+	g.local_model.generation_timeout_ms = 400000
+	for case in CASES:
+		if not only.is_empty() and not str(case[1]) in only.split("|"):
+			continue
+		setup(g, str(case[0]))
+		g.local_model.enabled = use_model
+		var before: int = g.log_entries.size()
+		var started := Time.get_ticks_msec()
+		await g._on_command(str(case[1]))
+		while g.advancing:
+			await process_frame
+		var lines: Array = []
+		for i in range(max(0, before), g.log_entries.size()):
+			lines.append(str(g.log_entries[i]).replace("\n", " / ").left(150))
+		print("CASE [%s] %s  (%.1fs)\n    -> %s" % [case[0], case[1], (Time.get_ticks_msec() - started) / 1000.0, "\n    -> ".join(lines)])
+	quit()
