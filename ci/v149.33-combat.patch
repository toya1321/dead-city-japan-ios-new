diff --git a/tests/test_combat5_149_33.gd b/tests/test_combat5_149_33.gd
new file mode 100644
index 0000000..9c23a93
--- /dev/null
+++ b/tests/test_combat5_149_33.gd
@@ -0,0 +1,158 @@
+extends SceneTree
+## v149.33 combat stage 5: skills (Lv.1-100) from what was done, how hard it
+## was and whether it was new; no grinding; techniques grow gradually; the
+## eye for a walker's weaknesses grows with experience.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+const Skills = preload("res://scripts/skills.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const IntroScript = preload("res://scripts/intro.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func fresh_combat(w, skills := {"strike": 0.0, "blade": 0.0, "agility": 0.0}, tech := {}) -> void:
+	var t := {}
+	for k in Skills.TECH:
+		t[k] = float(tech.get(k, 0.0))
+	w.s.combat = {"weapons": [{"type": "pipe", "wear": 999}], "held": "pipe", "found": {}, "armor": [], "magazine_left": 0, "wounds": [], "stuck": "", "skills": skills.duplicate(), "tech": t, "day_xp": {"day": -1}}
+
+func fight(w, count: int) -> void:
+	w.s.walkers.places["屋外"] = count
+	w.s.walkers.encounter = {"place": "屋外", "count": count, "near": true, "since": int(w.s.minute), "from": "建物前"}
+	Combat.sync(w)
+
+func run() -> void:
+	# A past, one per world, told in the opening and felt in a fight.
+	var bg_a := Skills.background_for(7)
+	check(Skills.background_for(7) == bg_a, "the same world gives the same past")
+	var pasts := {}
+	for seed in 60:
+		pasts[str(Skills.background_for(seed).id)] = true
+	check(pasts.size() >= 4, "worlds give different pasts (%d kinds)" % pasts.size())
+	var seed_bb := -1
+	for seed in 200:
+		if str(Skills.background_for(seed).id) == "baseball":
+			seed_bb = seed
+			break
+	var profile := {"name": "トウヤ", "age": 31, "address": "東京", "job": "無職", "housing": "一戸建て", "cohabitants": 0, "seed": seed_bb}
+	check(str(IntroScript.pages(profile)[0].body).contains("野球部"), "the opening mentions the past")
+
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed_bb
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.minute = 2 * 60
+	w.s.erase("combat")
+	check(Weapons.owns(w, "bat") and Skills.lv(w, "strike") >= 5 and Skills.lv(w, "strike") <= 8, "an old baseball player has a bat by the door and some skill with it")
+
+	# Levels.
+	check(Skills.level(0) == 1 and Skills.level(Skills.xp_for(50)) == 50 and Skills.level(1e9) == 100, "levels run from 1 to 100")
+	fresh_combat(w)
+	w.s.mood = 70.0
+	w.s.fatigue = 0.0
+	fight(w, 1)
+	var z: Dictionary = Combat.front(w)
+	var novice := Combat.hit_chance(w, "head", z)
+	fresh_combat(w, {"strike": Skills.xp_for(50), "blade": 0.0, "agility": 0.0})
+	var mid := Combat.hit_chance(w, "head", z)
+	fresh_combat(w, {"strike": Skills.xp_for(100), "blade": 0.0, "agility": 0.0}, {"aim": 100.0, "calm": 100.0})
+	var master := Combat.hit_chance(w, "head", z)
+	check(mid > novice + 10 and master > mid, "skill steadies the hand (%d → %d → %d)" % [novice, mid, master])
+	check(master - novice <= 45, "even at the top it is a person, not a superhero (+%d)" % (master - novice))
+	fresh_combat(w, {"strike": 0.0, "blade": Skills.xp_for(60), "agility": 0.0})
+	check(Combat.hit_chance(w, "head", z) == novice, "skill with blades does not help with a pipe")
+
+	# Experience: harder, riskier and newer teaches more; repeats and a long
+	# day teach less.
+	fresh_combat(w)
+	var hard := Skills.gain(w, "strike", 6.0, 20, true, "a|1")
+	fresh_combat(w)
+	var easy := Skills.gain(w, "strike", 6.0, 90, true, "a|1")
+	check(hard > easy * 2, "a hard blow teaches more than an easy one (%.1f vs %.1f)" % [hard, easy])
+	fresh_combat(w)
+	var safe := Skills.gain(w, "strike", 6.0, 50, false, "a|1")
+	fresh_combat(w)
+	var risky := Skills.gain(w, "strike", 6.0, 50, true, "a|1")
+	check(safe < risky * 0.5, "beating one that is down and alone teaches little")
+	var again := Skills.gain(w, "strike", 6.0, 50, true, "a|1")
+	check(again < risky, "the same thing again teaches less (and nothing is new about it)")
+	fresh_combat(w)
+	for i in 30:
+		Skills.gain(w, "strike", 6.0, 40, true, "b%d|%d" % [i % 3, i])
+	var late := Skills.gain(w, "strike", 6.0, 40, true, "c|x")
+	check(late < 3.0, "a long day of fighting stops teaching much (%.1f)" % late)
+	fresh_combat(w)
+	var before_kills := float(w.s.combat.skills.strike)
+	Skills.gain(w, "strike", 6.0, 50, true, "kill|1")
+	check(float(w.s.combat.skills.strike) > before_kills, "experience comes from the deed, not from a kill count")
+
+	# Techniques grow little by little, and so does their effect.
+	fresh_combat(w, {}, {"efficient": 0.0})
+	var t0 := Skills.time_factor(w, "attack")
+	fresh_combat(w, {}, {"efficient": 50.0})
+	var t50 := Skills.time_factor(w, "attack")
+	fresh_combat(w, {}, {"efficient": 100.0})
+	var t100 := Skills.time_factor(w, "attack")
+	check(t0 > t50 and t50 > t100 and t100 >= 0.75, "a technique's effect grows with it, with no sudden jump")
+	fresh_combat(w)
+	for i in 5:
+		Skills.gain(w, "strike", 6.0, 40, true, "t%d|%d" % [i, i])
+	check(Skills.tech(w, "aim") > 0.0 and Skills.tech(w, "aim") < 10.0, "a few blows start a technique, they do not master it")
+
+	# The eye: a novice sees one coming; an old hand sees the limp and the reach.
+	fresh_combat(w)
+	fight(w, 1)
+	z = Combat.front(w)
+	z.hurt.legs = 1
+	z.kind = "old"
+	z.dist = 1.2
+	check(Skills.observe(w, z).is_empty(), "a novice notices nothing in particular")
+	fresh_combat(w, {"strike": Skills.xp_for(20), "blade": 0.0, "agility": Skills.xp_for(10)})
+	var eye := Skills.observe(w, z)
+	check(eye.contains("脚を引きずっている") and eye.contains("届く距離"), "an old hand sees the limp and the reach: " + eye)
+	z.hurt.legs = 0
+	z.kind = "fresh"
+	check(not Skills.observe(w, z).contains("脚を引きずって"), "and does not see a limp that is not there")
+
+	# Played through: the end of a fight says what was learned.
+	fresh_combat(w)
+	g.location = "屋外"
+	g._sync_player_position()
+	w.s.health = 100.0
+	fight(w, 1)
+	Combat.front(w).state = "downed"
+	Combat.front(w).dist = 1.0
+	for i in 12:
+		if not Combat.active(w):
+			break
+		await g._on_command("頭を狙って振り下ろす")
+	check(str(g.log_entries.slice(-6)).contains("経験：打撃"), "the end of a fight says what was learned")
+	check(Weapons.gear_text(w).contains("腕前：打撃 Lv."), "the gear list shows the skills")
+
+	# Saved; a broken record is refused.
+	var xp := float(w.s.combat.skills.strike)
+	g._save()
+	w.s.combat.skills.strike = 0.0
+	g._load()
+	w = g.world
+	check(is_equal_approx(float(w.s.combat.skills.strike), xp), "skills are saved")
+	check(not Weapons.valid({"skills": {"strike": -5}}), "a negative skill in a save is refused")
+	print("v149.33 combat stage 5 checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
