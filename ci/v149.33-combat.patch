new file mode 100644
index 0000000..aef54f2
--- /dev/null
+++ b/scripts/weapons.gd
@@ -0,0 +1,312 @@
+extends RefCounted
+## v149.33 (combat stage 3): weapons, armour and the player's wounds.
+## Kept in s.combat (never in s.inventory: old saves are checked against the
+## inventory's keys).
+##   s.combat = {weapons: [{type, wear}], held: type or "", found: {place: true},
+##               armor: [type], magazine_left: int, wounds: [{part, kind, sev, at, treated}],
+##               stuck: type or ""}
+
+## reach (m), weight (kg), handling (hit +/-), head (chance a head hit
+## ends it), legs (chance a leg hit brings it down), wear (uses before it
+## breaks), noise (minutes the sound carries), narrow (hit in a corridor;
+## -100 = cannot swing there), class (blunt / blade / fists / spear).
+const TYPES := {
+	"fists": {"name": "素手", "reach": 0.7, "weight": 0.0, "handling": 0, "head": 5, "legs": 35, "wear": 0, "noise": 10, "narrow": 0, "class": "fists"},
+	"plank": {"name": "角材", "reach": 1.2, "weight": 1.5, "handling": 5, "head": 25, "legs": 70, "wear": 15, "noise": 45, "narrow": -5, "class": "blunt"},
+	"knife": {"name": "包丁", "reach": 0.9, "weight": 0.2, "handling": 15, "head": 65, "legs": 25, "wear": 40, "noise": 10, "narrow": 0, "class": "blade"},
+	"bat": {"name": "金属バット", "reach": 1.4, "weight": 1.0, "handling": 10, "head": 30, "legs": 85, "wear": 80, "noise": 60, "narrow": -10, "class": "blunt"},
+	"pipe": {"name": "鉄パイプ", "reach": 1.4, "weight": 2.0, "handling": 0, "head": 45, "legs": 75, "wear": 200, "noise": 60, "narrow": -5, "class": "blunt"},
+	"bar": {"name": "バール", "reach": 1.3, "weight": 2.5, "handling": -5, "head": 60, "legs": 70, "wear": 200, "noise": 60, "narrow": -5, "class": "blunt"},
+	"golf": {"name": "ゴルフクラブ", "reach": 1.5, "weight": 0.4, "handling": 0, "head": 35, "legs": 60, "wear": 25, "noise": 45, "narrow": -10, "class": "blunt"},
+	"spear": {"name": "物干し竿の槍", "reach": 2.2, "weight": 1.5, "handling": -10, "head": 50, "legs": 40, "wear": 20, "noise": 15, "narrow": -100, "class": "spear"},
+	"nailbat": {"name": "釘バット", "reach": 1.4, "weight": 1.2, "handling": 5, "head": 50, "legs": 85, "wear": 40, "noise": 60, "narrow": -10, "class": "blunt"},
+}
+## Where weapons turn up ("武器を探す"), once per place.
+const FINDS := {
+	"金物店": ["bar", "pipe"], "近所の空き家": ["bat", "golf"], "デパート": ["golf", "bat"],
+	"共用廊下": ["extinguisher"], "建物前": [],
+}
+## Bite protection by part (percent), from material, thickness and cover.
+const ARMOR := {
+	"coat": {"name": "厚手のコート", "cover": {"arms": 30, "torso": 30}},
+	"leather": {"name": "革ジャン", "cover": {"arms": 50, "torso": 50}},
+	"gloves": {"name": "作業用の手袋", "cover": {"hands": 40}},
+	"helmet": {"name": "ヘルメット", "cover": {"head": 60}},
+	"magazine": {"name": "腕に巻いた雑誌", "cover": {"arms": 40}},
+	"boots": {"name": "作業用のブーツ", "cover": {"legs": 40}},
+}
+const ARMOR_FINDS := {"金物店": ["gloves", "helmet", "boots"], "近所の空き家": ["leather"], "デパート": ["leather", "gloves"]}
+const WOUND_NAMES := {"bruise": "打撲", "cut": "裂傷", "fracture": "骨折", "bleeding": "出血", "bite": "噛み傷"}
+const PART_NAMES := {"arms": "腕", "hands": "手", "legs": "脚", "torso": "胴", "head": "頭", "neck": "首"}
+## Hours until a wound stops mattering (untreated / treated).
+const HEAL_HOURS := {"bruise": [72, 48], "cut": [144, 72], "fracture": [720, 480], "bleeding": [12, 1], "bite": [100000, 100000]}
+
+static func state(world) -> Dictionary:
+	if not world.s.get("combat") is Dictionary:
+		# Everyone has a kitchen knife and, in November, a heavy coat.
+		world.s.combat = {"weapons": [{"type": "knife", "wear": 40}], "held": "", "found": {}, "armor": ["coat"], "magazine_left": 0, "wounds": [], "stuck": ""}
+	var st: Dictionary = world.s.combat
+	for key in ["weapons", "armor", "wounds"]:
+		if not st.get(key) is Array:
+			st[key] = []
+	if not st.get("found") is Dictionary:
+		st.found = {}
+	for key in ["held", "stuck"]:
+		if not st.get(key) is String:
+			st[key] = ""
+	return st
+
+static func valid(value: Variant) -> bool:
+	if not value is Dictionary:
+		return false
+	for key in ["weapons", "armor", "wounds"]:
+		if value.has(key) and not value[key] is Array:
+			return false
+	if value.has("weapons"):
+		for w in value.weapons:
+			if not w is Dictionary or not TYPES.has(str(w.get("type", ""))) and str(w.get("type", "")) != "extinguisher":
+				return false
+	if value.has("wounds"):
+		for wound in value.wounds:
+			if not wound is Dictionary or not WOUND_NAMES.has(str(wound.get("kind", ""))):
+				return false
+	return true
+
+static func owns(world, type: String) -> bool:
+	return state(world).weapons.any(func(w): return str(w.type) == type)
+
+static func improvised(world) -> String:
+	return "plank" if int(world.s.inventory.get("wood", 0)) > 0 else "fists"
+
+## The weapon in hand: the one chosen, else the best one owned, else a plank
+## of wood if there is one, else fists. A blade stuck in a skull is not in hand.
+static func held(world) -> String:
+	var st := state(world)
+	var chosen := str(st.held)
+	if not chosen.is_empty() and owns(world, chosen) and chosen != str(st.stuck):
+		return chosen
+	var best := ""
+	var score := -1
+	for w in st.weapons:
+		var t := str(w.type)
+		if not TYPES.has(t) or t == str(st.stuck):
+			continue
+		var v := int(TYPES[t].head) + int(TYPES[t].legs) + int(TYPES[t].handling) * 2
+		if v > score:
+			score = v
+			best = t
+	return best if not best.is_empty() else improvised(world)
+
+static func spec(world, type: String = "") -> Dictionary:
+	if type.is_empty():
+		type = held(world)
+	return TYPES.get(type, TYPES.fists)
+
+static func name_of(type: String) -> String:
+	if type == "extinguisher":
+		return "消火器"
+	return str(TYPES.get(type, {}).get("name", type))
+
+## Words in an order that name a weapon the player has (or could use).
+const WORDS := {
+	"knife": ["包丁", "ナイフ"], "bat": ["バット"], "pipe": ["パイプ"], "bar": ["バール"], "golf": ["ゴルフ", "クラブ"],
+	"spear": ["槍", "竿"], "nailbat": ["釘バット"], "plank": ["角材", "棒", "木材"], "fists": ["素手", "拳", "殴り", "蹴"],
+	"extinguisher": ["消火器"],
+}
+
+static func named_in(text: String) -> String:
+	if text.contains("釘バット"):
+		return "nailbat"
+	for type in WORDS:
+		for word in WORDS[type]:
+			if text.contains(word):
+				return type
+	return ""
+
+static func wear(world, type: String, amount: int = 1) -> String:
+	var st := state(world)
+	if type in ["fists", "plank"]:
+		if type == "plank" and amount > 0 and world.draw(int(world.s.minute), 61, "plank-wear", 100) < 100 / int(TYPES.plank.wear):
+			world.s.inventory.wood = maxi(0, int(world.s.inventory.wood) - 1)
+			return "角材が、乾いた音を立てて折れた。"
+		return ""
+	for w in st.weapons:
+		if str(w.type) == type:
+			w.wear = int(w.wear) - amount
+			if int(w.wear) <= 0:
+				st.weapons.erase(w)
+				if str(st.held) == type:
+					st.held = ""
+				return "%sが、%s。もう使えない。" % [name_of(type), "ぐにゃりと曲がった" if type == "golf" else ("柄から折れた" if type in ["spear", "knife"] else "ひしゃげた")]
+			return ""
+	return ""
+
+static func condition_words(world, type: String) -> String:
+	for w in state(world).weapons:
+		if str(w.type) == type:
+			var left := float(w.wear) / maxf(1.0, float(TYPES.get(type, {"wear": 1}).wear))
+			return "新品同様" if left > 0.8 else ("傷あり" if left > 0.4 else "ひびが入っている")
+	return ""
+
+## Bite protection (0-90) for a part from everything worn.
+static func protection(world, part: String) -> int:
+	var st := state(world)
+	var through := 1.0
+	for a in st.armor:
+		var cover: Dictionary = ARMOR.get(str(a), {}).get("cover", {})
+		through *= 1.0 - float(cover.get(part, 0)) / 100.0
+	return mini(90, int(round((1.0 - through) * 100.0)))
+
+# ---- wounds -------------------------------------------------------------
+
+static func wound(world, part: String, kind: String, sev: int = 1) -> void:
+	state(world).wounds.append({"part": part, "kind": kind, "sev": sev, "at": int(world.s.minute), "treated": false})
+	world.s.injuries = float(world.s.get("injuries", 0)) + 1.0
+
+## Wounds that still hurt (bites never heal; they are the infection).
+static func open_wounds(world) -> Array:
+	return state(world).wounds
+
+## Hit penalty from hurt arms and hands; slower legs.
+static func arm_penalty(world) -> int:
+	var p := 0
+	for w in open_wounds(world):
+		if str(w.part) in ["arms", "hands"] and str(w.kind) != "bite":
+			p += {"bruise": 5, "cut": 8, "fracture": 25, "bleeding": 5}.get(str(w.kind), 0)
+	return mini(30, p)
+
+static func leg_factor(world) -> float:
+	var f := 1.0
+	for w in open_wounds(world):
+		if str(w.part) == "legs":
+			f += {"bruise": 0.1, "cut": 0.15, "fracture": 0.6, "bleeding": 0.1}.get(str(w.kind), 0.0)
+	return minf(2.0, f)
+
+static func wounds_words(world) -> String:
+	var parts: Array = []
+	for w in open_wounds(world):
+		parts.append("%sの%s" % [PART_NAMES.get(str(w.part), "体"), WOUND_NAMES.get(str(w.kind), "傷")])
+	return "・".join(parts)
+
+## Each hour: bleeding drains, wounds heal (faster once treated).
+static func hourly(world) -> void:
+	if not world.s.get("combat") is Dictionary:
+		return
+	var st := state(world)
+	var now := int(world.s.minute)
+	for w in st.wounds.duplicate():
+		if str(w.kind) == "bleeding" and not bool(w.treated):
+			world.s.health = maxf(0.0, float(world.s.health) - 1.5)
+		var hours: Array = HEAL_HOURS.get(str(w.kind), [72, 48])
+		if (now - int(w.at)) / 60 >= int(hours[1 if bool(w.treated) else 0]):
+			st.wounds.erase(w)
+			world.s.injuries = maxf(0.0, float(world.s.get("injuries", 0)) - 1.0)
+
+## Bandaging treats every wound at once (the old "傷を手当てする").
+static func treat(world) -> void:
+	for w in state(world).wounds:
+		w.treated = true
+
+# ---- finding and making --------------------------------------------------
+
+static func search(world, place: String) -> String:
+	var st := state(world)
+	if bool(st.found.get(place, false)):
+		return "ここで武器になりそうな物は、もう探した。"
+	var types: Array = FINDS.get(place, [])
+	var armor: Array = ARMOR_FINDS.get(place, [])
+	if types.is_empty() and armor.is_empty():
+		return "ここには、武器になりそうな物は見当たらない。"
+	if place in ["金物店", "デパート"] and not bool(world.s.district.sites.get(place, {}).get("vacant", false)):
+		return "店の品物だ。店が開いているうちは、勝手に持ち出せない。"
+	st.found[place] = true
+	world.advance_safe(15)
+	var got: Array = []
+	for t in types:
+		if t == "extinguisher":
+			if not owns(world, "extinguisher"):
+				st.weapons.append({"type": "extinguisher", "wear": 1})
+				got.append("消火器")
+		elif not owns(world, t):
+			st.weapons.append({"type": t, "wear": int(TYPES[t].wear)})
+			got.append(name_of(t))
+	for a in armor:
+		if not a in st.armor:
+			st.armor.append(a)
+			got.append(str(ARMOR[a].name))
+	if got.is_empty():
+		return "探してみたが、手持ちと同じような物しかなかった。"
+	return "棚や物陰を探して、%sを見つけた。（15分）" % "、".join(got)
+
+static func craft(world, what: String, at_home: bool) -> String:
+	var st := state(world)
+	match what:
+		"nailbat":
+			if not owns(world, "bat"):
+				return "釘を打つバットがない。"
+			if int(world.s.inventory.get("parts", 0)) < 1:
+				return "釘になる部品が足りない（部品1）。"
+			world.s.inventory.parts = int(world.s.inventory.parts) - 1
+			for w in st.weapons:
+				if str(w.type) == "bat":
+					w.type = "nailbat"
+					w.wear = mini(int(w.wear), int(TYPES.nailbat.wear))
+			if str(st.held) == "bat":
+				st.held = "nailbat"
+			world.advance_safe(30)
+			return "バットに釘を何本も打ち込んだ。頭には効きそうだが、釘の根元からひびが入りやすくなった。（30分・部品1）"
+		"spear":
+			if not at_home:
+				return "物干し竿は家のベランダにある。家で作ろう。"
+			if not owns(world, "knife"):
+				return "竿の先にくくりつける刃物がない。"
+			for w in st.weapons:
+				if str(w.type) == "knife":
+					st.weapons.erase(w)
+					break
+			st.weapons.append({"type": "spear", "wear": int(TYPES.spear.wear)})
+			if str(st.held) == "knife":
+				st.held = "spear"
+			world.advance_safe(30)
+			return "物干し竿の先に包丁をガムテープで固く巻きつけた。間合いは長いが、狭い場所では振り回せない。包丁は竿の先になった。（30分）"
+		"magazine":
+			if not at_home:
+				return "雑誌とガムテープは家にある。"
+			if "magazine" in st.armor:
+				return "もう腕に巻いている。"
+			st.armor.append("magazine")
+			st.magazine_left = 3
+			world.advance_safe(10)
+			return "古い雑誌を両腕に巻きつけ、ガムテープで留めた。少し動きにくいが、歯は通りにくい。（10分）"
+	return ""
+
+static func equip(world, type: String) -> String:
+	var st := state(world)
+	if type == "fists":
+		st.held = "fists"
+		return "武器を置いて、素手で構えた。"
+	if type == "plank":
+		if int(world.s.inventory.get("wood", 0)) <= 0:
+			return "角材を持っていない。"
+		st.held = "plank"
+		return "角材を握った。"
+	if not owns(world, type):
+		return "%sを持っていない。" % name_of(type)
+	st.held = type
+	return "%sを手に取った。" % name_of(type)
+
+static func gear_text(world) -> String:
+	var st := state(world)
+	var lines: Array = ["手に持つ物：%s" % name_of(held(world))]
+	var owned: Array = []
+	for w in st.weapons:
+		var t := str(w.type)
+		owned.append(name_of(t) + ("（%s）" % condition_words(world, t) if TYPES.has(t) else ""))
+	if int(world.s.inventory.get("wood", 0)) > 0:
+		owned.append("角材")
+	lines.append("武器：%s" % ("、".join(owned) if not owned.is_empty() else "なし"))
+	var worn: Array = st.armor.map(func(a): return str(ARMOR.get(str(a), {}).get("name", a)))
+	lines.append("身につけている物：%s" % ("、".join(worn) if not worn.is_empty() else "なし"))
+	var hurt := wounds_words(world)
+	lines.append("けが：%s" % (hurt if not hurt.is_empty() else "なし"))
+	return "\n".join(lines)
