+extends SceneTree
+## v149.33 combat stage 3: weapons (finding, choosing, making, wearing out),
+## body parts, the player's wounds and armour, and how a fight reads (lines
+## from parts; the model's retelling only when it claims nothing more).
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const CombatText = preload("res://scripts/combat_text.gd")
+const Intent = preload("res://scripts/combat_intent.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+class FakeModel:
+	extends RefCounted
+	var queue: Array = []
+	var requests := 0
+	func model_available() -> bool:
+		return true
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, _text: String, _input: String) -> bool:
+		requests += 1
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		pass
+
+func fight(w, count: int, near: bool, place: String = "屋外") -> void:
+	w.s.walkers.places[place] = count
+	w.s.walkers.encounter = {"place": place, "count": count, "near": near, "since": int(w.s.minute), "from": "建物前"}
+	Combat.sync(w)
+
+func kit(w, weapons: Array, held: String = "", armor: Array = []) -> void:
+	w.s.combat = {"weapons": weapons, "held": held, "found": {}, "armor": armor, "magazine_left": 0, "wounds": [], "stuck": ""}
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 33
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.minute = 2 * 60
+	w.s.inventory.wood = 0
+
+	# A kitchen knife and a coat from the start; the knife is in hand.
+	w.s.erase("combat")
+	check(Weapons.owns(w, "knife") and "coat" in Weapons.state(w).armor and Weapons.held(w) == "knife", "everyone starts with a kitchen knife and a heavy coat")
+
+	# Finding weapons: once per place, not from an open shop.
+	w.s.society = "normal"
+	check(Weapons.search(w, "金物店").contains("勝手に持ち出せない"), "an open shop's tools are not taken")
+	w.s.district.sites["金物店"].vacant = true
+	var found := Weapons.search(w, "金物店")
+	check(Weapons.owns(w, "bar") and Weapons.owns(w, "pipe") and "helmet" in Weapons.state(w).armor and found.contains("バール"), "the hardware shop has a crowbar, a pipe and a helmet")
+	check(Weapons.search(w, "金物店").contains("もう探した"), "a place is searched once")
+	check(Weapons.held(w) in ["bar", "pipe", "knife"], "the best weapon owned is in hand unless one is chosen")
+	Weapons.equip(w, "pipe")
+	check(Weapons.held(w) == "pipe", "choosing a weapon puts it in hand")
+	check(Weapons.equip(w, "golf").contains("持っていない"), "a weapon not owned cannot be chosen")
+
+	# Making: a nail bat needs a bat and a part; a spear takes the knife.
+	kit(w, [{"type": "bat", "wear": 80}, {"type": "knife", "wear": 40}], "bat", ["coat"])
+	w.s.inventory.parts = 0
+	check(Weapons.craft(w, "nailbat", true).contains("足りない"), "no part, no nail bat")
+	w.s.inventory.parts = 1
+	Weapons.craft(w, "nailbat", true)
+	check(Weapons.owns(w, "nailbat") and not Weapons.owns(w, "bat") and int(w.s.inventory.parts) == 0 and Weapons.held(w) == "nailbat", "a bat and a part make a nail bat")
+	check(int(Weapons.TYPES.nailbat.wear) < int(Weapons.TYPES.bat.wear), "a nail bat is not simply better: it wears out sooner")
+	Weapons.craft(w, "spear", true)
+	check(Weapons.owns(w, "spear") and not Weapons.owns(w, "knife"), "the spear takes the kitchen knife")
+	# A spear cannot be swung in a corridor.
+	Weapons.equip(w, "spear")
+	fight(w, 1, true, "共用廊下")
+	var r: Dictionary = Combat.act(w, {"act": "attack", "part": "head"})
+	check(bool(r.invalid) and str(r.lines).contains("狭くて"), "a spear cannot be swung in a narrow corridor")
+	check(Combat.reach(w, "spear") > Combat.reach(w, "knife"), "a spear reaches further than a knife")
+
+	# Wear: a weapon breaks.
+	kit(w, [{"type": "golf", "wear": 1}], "golf", [])
+	var broke := Weapons.wear(w, "golf", 1)
+	check(not Weapons.owns(w, "golf") and broke.contains("曲がった"), "a golf club bends and is gone")
+
+	# Weapons feel different: a bat brings legs down more often than a knife.
+	fight(w, 1, true)
+	var downs := {"bat": 0, "knife": 0}
+	for type in ["bat", "knife"]:
+		kit(w, [{"type": type, "wear": 999}], type, [])
+		for i in 120:
+			w.s.minute += 1
+			var z := {"id": "t%d" % i, "dist": 1.0, "state": "standing", "hurt": {"head": 0, "arms": 0, "legs": 0, "torso": 0}, "kind": "old"}
+			Combat._hit(w, z, "legs", type)
+			if str(z.state) == "downed":
+				downs[type] += 1
+	check(downs.bat > downs.knife * 2, "a bat brings legs down far more often than a knife (%d vs %d)" % [downs.bat, downs.knife])
+	check(Combat.hit_chance(w, "head", Combat.front(w), "knife") > Combat.hit_chance(w, "head", Combat.front(w), "bar"), "a light knife is easier to place than a heavy crowbar")
+
+	# A blade can stick; it comes back when the fight is won, not when running.
+	kit(w, [{"type": "knife", "wear": 40}], "knife", [])
+	Weapons.state(w).stuck = "knife"
+	check(Weapons.held(w) != "knife", "a stuck knife is not in hand")
+	fight(w, 1, true)
+	Combat._kill(w, Combat.front(w))
+	r = Combat.act(w, {"act": "wait", "part": ""})
+	check(str(r.lines).contains("引き抜いた") and str(Weapons.state(w).stuck).is_empty() and Weapons.owns(w, "knife"), "the stuck knife is pulled out once the street is clear")
+
+	# Armour by part.
+	kit(w, [], "", ["coat"])
+	check(Weapons.protection(w, "arms") == 30 and Weapons.protection(w, "neck") == 0, "a coat covers the arms, not the neck")
+	kit(w, [], "", ["leather", "magazine"])
+	check(Weapons.protection(w, "arms") == 70, "a leather jacket and a magazine together (50% and 40%)")
+	check(Weapons.craft(w, "magazine", true).contains("もう"), "magazines are wrapped once")
+
+	# Wounds: they last, they get in the way, bleeding drains, bandages help.
+	kit(w, [{"type": "bat", "wear": 80}], "bat", [])
+	fight(w, 1, true)
+	var clean_odds := Combat.hit_chance(w, "legs", Combat.front(w))
+	var clean_secs := Combat.step_seconds(w, "retreat")
+	Weapons.wound(w, "arms", "fracture")
+	Weapons.wound(w, "legs", "cut")
+	check(Combat.hit_chance(w, "legs", Combat.front(w)) < clean_odds, "a broken arm makes it harder to hit")
+	check(Combat.step_seconds(w, "retreat") > clean_secs, "a cut leg makes stepping back slower")
+	Weapons.wound(w, "torso", "bleeding")
+	w.s.health = 80.0
+	Weapons.hourly(w)
+	check(float(w.s.health) < 80.0, "bleeding drains health each hour until treated")
+	Weapons.treat(w)
+	var hp := float(w.s.health)
+	w.s.minute += 120
+	Weapons.hourly(w)
+	check(float(w.s.health) == hp and not Weapons.state(w).wounds.any(func(x): return str(x.kind) == "bleeding"), "once bandaged, bleeding stops")
+	Weapons.wound(w, "arms", "bite")
+	w.s.minute += 60 * 2000
+	Weapons.hourly(w)
+	check(Weapons.state(w).wounds.any(func(x): return str(x.kind) == "bite") and not Weapons.state(w).wounds.any(func(x): return str(x.kind) == "cut"), "cuts heal; a bite never does")
+	check(Weapons.gear_text(w).contains("噛み傷"), "the gear list shows the wounds")
+
+	# Saving keeps it; old saves without it load; a bad record is refused.
+	kit(w, [{"type": "pipe", "wear": 150}], "pipe", ["coat", "helmet"])
+	Weapons.wound(w, "legs", "bruise")
+	g._save()
+	w.s.combat = {}
+	g._load()
+	w = g.world
+	check(Weapons.held(w) == "pipe" and "helmet" in Weapons.state(w).armor and Weapons.state(w).wounds.size() == 1, "save and load keep weapons, armour and wounds")
+	check(not Weapons.valid({"weapons": [{"type": "laser"}]}) and Weapons.valid({"weapons": [{"type": "knife", "wear": 3}], "wounds": []}), "an unknown weapon in a save is refused")
+
+	# How it reads: lines from parts, varied, and the model kept honest.
+	var seen := {}
+	for i in 30:
+		w.s.minute += 1
+		seen[CombatText.land(w, "blunt", "legs", "金属バット")] = true
+	check(seen.size() >= 3, "the same blow is told several ways (%d)" % seen.size())
+	check(Intent.unusual("自転車を蹴り倒してぶつける") and Intent.unusual("傘で目を突く") and not Intent.unusual("バットで膝を狙う") and not Intent.unusual("頭を狙って振り下ろす"), "an unusual move is told apart from an ordinary one")
+	check(CombatText.accept("傘の先が相手の目をかすめたが、相手は止まらない。", {"hit": true}) != "", "a retelling that claims nothing more is kept")
+	check(CombatText.accept("傘で突くと、相手は動かなくなった。", {"hit": true}) == "", "a retelling that claims a kill the rules did not decide is thrown away")
+	check(CombatText.accept("自転車がぶつかった。", {"hit": false}) == "", "a retelling that claims a hit on a miss is thrown away")
+
+	var fake := FakeModel.new()
+	g.local_model.enabled = true
+	g.local_model.backend = fake
+	kit(w, [{"type": "bat", "wear": 80}], "bat", ["coat"])
+	g.location = "屋外"
+	g._sync_player_position()
+	fight(w, 2, true)
+	fake.queue = ['{"kind":"chat","value":"自転車を蹴り倒すと、相手は動かなくなった。"}']
+	await g._on_command("自転車を蹴り倒して膝にぶつける")
+	check(fake.requests == 1 and not str(g.log_entries.slice(-4)).contains("自転車を蹴り倒すと、相手は動かなくなった"), "the model's line is dropped when it claims an outcome")
+	check(CombatText.accept_move("自転車を蹴り倒すと、膝に当たった。") == "" and CombatText.accept_move("足元の自転車を蹴り倒し、相手の膝へ叩きつけた。") != "", "a retold move may say how it was done, not whether it landed")
+	if Combat.active(w):
+		fake.queue = ['{"kind":"chat","value":"傘の先を、相手の顔めがけて突き出した。"}']
+		var asked := fake.requests
+		await g._on_command("傘で頭を突く")
+		check(fake.requests == asked + 1, "an unusual move asks the model for words")
+		check(str(g.log_entries.slice(-4)).contains("傘の先を、相手の顔めがけて突き出した。"), "the retold move is used, followed by the rules' result")
+	var asked_before := fake.requests
+	if Combat.active(w):
+		await g._on_command("脚を払う")
+	check(fake.requests == asked_before, "an ordinary move does not ask the model")
+	print("v149.33 combat stage 3 checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
