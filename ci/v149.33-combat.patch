+extends SceneTree
+## Full playthrough with screenshots of every action card shown.
+## DCJ_CMDS=file, DCJ_OUT=dir, DCJ_SEED. "#chip N" plays the Nth suggestion;
+## "#society X", "#day N", "#walkers PLACE N" are test cheats.
+const Main = preload("res://main.tscn")
+const Combat = preload("res://scripts/combat.gd")
+var shots := 0
+func _initialize() -> void:
+	call_deferred("run")
+func snap(g, label: String) -> void:
+	for i in 6: await process_frame
+	shots += 1
+	var path := "%s/%02d_%s.png" % [OS.get_environment("DCJ_OUT"), shots, label]
+	root.get_texture().get_image().save_png(path)
+	print("   [shot] ", path)
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	profile.seed = int(OS.get_environment("DCJ_SEED"))
+	profile.cohabitants = 0
+	g._start_new_game(profile)
+	print("INTRO: ", g.intro_body.text.replace("\n", " / "))
+	g._finish_intro()
+	g.local_model.enabled = false
+	print(g.log_entries[-1].replace("\n", " / "))
+	print("   chips: ", g._suggestions())
+	var lines := FileAccess.get_file_as_string(OS.get_environment("DCJ_CMDS")).split("\n")
+	for line in lines:
+		var cmd := line.strip_edges()
+		if cmd.is_empty() or cmd.begins_with("//"): continue
+		if float(g.world.s.health) <= 0:
+			print("== DEAD =="); break
+		if cmd.begins_with("#society"):
+			g.world.s.society = cmd.split(" ")[1]
+			g.world.s.regional_cases = 900 if g.world.s.society == "emergency" else 300
+			g.world.s.sim.initial_society = g.world.s.society
+			print("   (cheat) society=", g.world.s.society); continue
+		if cmd.begins_with("#day"):
+			g.world.s.minute = int(cmd.split(" ")[1]) * 1440 + int(g.world.s.minute) % 1440; continue
+		if cmd.begins_with("#walkers"):
+			var parts := cmd.split(" ")
+			g.world.s.walkers.places[parts[1]] = int(parts[2])
+			print("   (cheat) walkers ", parts[1], "=", parts[2]); continue
+		if cmd == "#shelter":
+			var st: Dictionary = load("res://scripts/shelter.gd").state(g.world)
+			st.status = "open"; st.pop = 80; st.stock = 320.0; st.tick_day = int(g.world.s.minute) / 1440
+			print("   (cheat) shelter open"); continue
+		if cmd.begins_with("#vacant"):
+			g.world.s.district.sites[cmd.split(" ")[1]].vacant = true
+			print("   (cheat) vacant"); continue
+		if cmd.begins_with("#give"):
+			g.world.s.inventory[cmd.split(" ")[1]] = float(cmd.split(" ")[2]); continue
+		if cmd.begins_with("#snap"):
+			await snap(g, cmd.split(" ")[1]); continue
+		if cmd.begins_with("#chip"):
+			var chips: Array = g._suggestions()
+			var n := int(cmd.split(" ")[1])
+			if chips.size() <= n: print("   (no chip ", n, ")"); continue
+			cmd = str(chips[n])
+		print("> ", cmd)
+		var before: int = g.log_entries.size()
+		g.action_card_kind = ""
+		await g._on_command(cmd)
+		while g.advancing:
+			await process_frame
+		for i in range(max(0, before - 1), g.log_entries.size()):
+			print(g.log_entries[i].replace("\n", " / "))
+		var s = g.world.s
+		print("   [%s %s %s | 体%.0f 満%.0f 水%.0f 休%.0f 心%.0f | 食%.1f 水%.1f | 感染者:%s | 街:%s]" % [g.day_label.text, g.clock_label.text, g.location, s.health, 100-s.hunger, 100-s.thirst, 100-s.fatigue, float(s.get("mood",70)), s.food, s.water, s.walkers.places, s.society])
+		if Combat.active(g.world):
+			for l in Combat.status_lines(g.world): print("   | ", l)
+		print("   chips: ", g._suggestions())
+		if g.action_card != null and g.action_card.visible and g.action_card_kind != "":
+			await snap(g, g.action_card_kind)
+	quit()
