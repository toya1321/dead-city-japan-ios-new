+
+static func pick(world, list: Array, tag: String) -> String:
+	if list.is_empty():
+		return ""
+	var enc: Dictionary = world.s.get("walkers", {}).get("encounter", {})
+	var salt := int(enc.get("beat", 0)) * 13 + tag.hash() % 1009
+	return str(list[world.draw(int(world.s.minute), salt, "ctext-" + tag, list.size())])
