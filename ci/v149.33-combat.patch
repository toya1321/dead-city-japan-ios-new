diff --git a/qa/fight_play.gd b/qa/fight_play.gd
new file mode 100644
index 0000000..5d9c306
--- /dev/null
+++ b/qa/fight_play.gd
@@ -0,0 +1,55 @@
+extends SceneTree
+## Plays a fight and prints the panel, chips and story each turn (DCJ_CMDS=a|b|c, DCJ_SEED, DCJ_N).
+const Main = preload("res://main.tscn")
+const Combat = preload("res://scripts/combat.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED")) if OS.get_environment("DCJ_SEED") != "" else 3
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.inventory.wood = 2
+	if OS.get_environment("DCJ_WEAPON") != "":
+		w.s.combat = {"weapons": [{"type": OS.get_environment("DCJ_WEAPON"), "wear": 80}, {"type": "knife", "wear": 40}, {"type": "extinguisher", "wear": 1}], "held": OS.get_environment("DCJ_WEAPON"), "found": {}, "armor": ["coat"], "magazine_left": 0, "wounds": [], "stuck": ""}
+	if OS.get_environment("DCJ_MATES") != "":
+		var Survivors = load("res://scripts/survivors.gd")
+		var ids: Array = Survivors.ensure(w).people.keys().filter(func(k): return not bool(Survivors.ensure(w).people[k].get("neighbor", false)) and str(Survivors.ensure(w).people[k].place) != "避難所")
+		var courage := OS.get_environment("DCJ_MATES").split(",")
+		for i in courage.size():
+			var sp: Dictionary = Survivors.ensure(w).people[ids[i]]
+			sp.traits.courage = int(courage[i])
+			Survivors._join(w, ids[i])
+		for m in w.s.household_members:
+			m.location = "屋外"
+			m.activity = "外出"
+			print("   mate ", m.name, " job=", m.job, " courage=", load("res://scripts/allies.gd").courage(w, m), " skill=", load("res://scripts/allies.gd").skill(w, m))
+	var n := int(OS.get_environment("DCJ_N")) if OS.get_environment("DCJ_N") != "" else 2
+	w.s.walkers.places["商店通り"] = n
+	g.location = "屋外"
+	g._sync_player_position()
+	await g._on_command("商店通りへ行く")
+	for m in w.s.household_members:
+		m.location = g.location
+	for cmd in OS.get_environment("DCJ_CMDS").split("|"):
+		print("   [", " / ".join(Combat.status_lines(w)), "]")
+		print("   chips: ", g._suggestions(), "  photo: ", Combat.picture_name(w))
+		var start: int = g.log_entries.size()
+		await g._on_command(cmd)
+		for i in range(start, g.log_entries.size()): print(g.log_entries[i].replace("\n", " / "))
+		if not Combat.active(w): print("   (encounter over)  killed=", w.s.walkers.get("killed", 0), " health=", w.s.health); break
+	if OS.get_environment("DCJ_OUT") != "":
+		for i in 10: await process_frame
+		g._hide_action_card()
