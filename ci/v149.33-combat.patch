+static func land(world, klass: String, part: String, weapon_name: String) -> String:
+	var table: Dictionary = LAND.get(klass, LAND.blunt)
+	var line := pick(world, table.get(part, table.torso), "land-%s-%s" % [klass, part])
+	return line % weapon_name if line.contains("%s") else line
+
+static func result(world, key: String) -> String:
+	return pick(world, RESULT.get(key, []), "res-" + key)
+
+static func miss(world, part: String, down: bool, dark: bool) -> String:
+	if down:
+		return pick(world, MISS.down, "miss-down")
+	if dark:
+		return pick(world, MISS.dark, "miss-dark")
+	if part == "head":
+		return pick(world, MISS.head, "miss-head")
+	return pick(world, MISS.any, "miss-any")
+
+# ---- the local model's retelling ------------------------------------------
+
+const NARRATE_INSTRUCTIONS := """ゾンビのような感染者との戦いを描く小説の語り手。「プレイヤーの行動」を、使った物や動きの言葉を生かして、過去形の短い1文（35字以内）に書き直す。
+行動そのものだけを書き、結果（当たった・外れた・倒れた・動かなくなった・噛まれた）は書かない。結果はゲームが続けて書く。数字・会話文は入れない。
+例：「ゴミ箱を投げる」→「そばのゴミ箱をつかみ、相手めがけて放り投げた。」
+出力はJSONのみ：{"kind":"chat","value":"1文"}"""
+
+## What it did, after a retold move (the move itself is the model's).
+const MISS_TAIL := ["だが、手応えはなかった。", "だが、わずかにそれた。", "相手は体を揺らし、それをかわした。"]
+
+static func miss_tail(world) -> String:
+	return pick(world, MISS_TAIL, "miss-tail")
+
+## Words that claim an outcome. A retelling may use them only if the rules
+## decided that outcome.
+const CLAIMS := {
+	"kill": ["動かなくなった", "息絶え", "死んだ", "仕留め", "倒した", "動かない", "絶命", "とどめ"],
+	"down": ["倒れ", "転倒", "転が", "崩れ", "膝をつ"],
+	"hit": ["命中", "当たっ", "当た", "ぶつか", "直撃", "入った", "捉え", "叩きつけ", "打ち抜", "突き刺", "切りつけ", "手応え"],
+	"bitten": ["噛まれ", "噛みつ", "歯が"],
+}
+
+## The retold move, or "" when it says more than the move (any outcome at all:
+## the outcome is the rules' own sentence, added after it).
+const MOVE_CLAIMS := ["当た", "命中", "手応え", "直撃", "捉え", "外れ", "かわ", "それた", "空を切"]
+
+static func accept_move(line: String) -> String:
+	var text := line.strip_edges().trim_suffix("。") + "。"
+	if text.length() > 50 or text.length() < 6:
+		return ""
+	for word in MOVE_CLAIMS:
+		if text.contains(word):
+			return ""
+	# Verbs of striking are the move itself; outcomes are not.
+	return accept(text, {"hit": true})
+
+## The retold line, or "" when it says more (or other) than what happened.
+static func accept(line: String, outcome: Dictionary) -> String:
+	var text := line.strip_edges()
+	if text.is_empty() or text.length() > 90 or text.contains("%") or text.contains("「"):
+		return ""
+	for c in "0123456789０１２３４５６７８９":
+		if text.contains(c):
+			return ""
+	for claim in CLAIMS:
+		if bool(outcome.get(claim, false)):
+			continue
+		for word in CLAIMS[claim]:
+			if text.contains(word):
+				return ""
+	return text
+
+## The facts handed to the model (no numbers, no odds).
+static func facts(outcome: Dictionary, part: String, weapon_name: String) -> String:
+	var parts: Array = ["使った物：%s" % weapon_name, "狙った所：%s" % {"head": "頭", "legs": "脚", "arms": "腕", "torso": "胴", "": "体"}.get(part, "体")]
+	if bool(outcome.get("kill", false)):
+		parts.append("結果：相手は動かなくなった")
+	elif bool(outcome.get("down", false)):
+		parts.append("結果：当たって、相手は倒れた")
+	elif bool(outcome.get("hit", false)):
+		parts.append("結果：当たったが、相手はまだ動いている")
+	else:
+		parts.append("結果：外れた")
+	return "、".join(parts)
