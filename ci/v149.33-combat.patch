+extends SceneTree
+## Real-model check: retelling unusual moves; prints what the model wrote and
+## whether the rules accept it.
+const Main = preload("res://main.tscn")
+const Real = preload("res://qa/real_npc_scenarios.gd")
+const CombatText = preload("res://scripts/combat_text.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	g._start_new_game(g.world.DEFAULT_PROFILE.duplicate(true))
+	g._finish_intro()
+	g.local_model.backend = Real.RealModel.new()
+	g.local_model.load_timeout_ms = 400000
+	g.local_model.generation_timeout_ms = 400000
+	var cases := [
+		["自転車を蹴り倒して膝にぶつける", {"hit": true, "down": true}, "legs", "素手"],
+		["傘で目を突く", {"hit": false}, "head", "素手"],
+		["ゴミ箱を投げつけて頭を殴る", {"hit": true}, "head", "金属バット"],
+		["看板を引き抜いて振り回す", {"hit": true, "down": true, "kill": true}, "head", "素手"],
+		["マンホールの蓋で脚を払う", {"hit": false}, "legs", "素手"],
+	]
+	var kept := 0
+	for c in cases:
+		var t0 := Time.get_ticks_msec()
+		var told: Dictionary = await g.local_model.ask(g, {"使っている武器": c[3], "プレイヤーの行動": c[0]}, false, CombatText.NARRATE_INSTRUCTIONS)
+		var line := str(told.get("value", ""))
+		var ok := CombatText.accept_move(line)
+		if not ok.is_empty(): kept += 1
+		print("%s | %s | %dms | %s" % [c[0], "KEPT" if not ok.is_empty() else "DROPPED", Time.get_ticks_msec() - t0, line])
+	print("kept %d / %d" % [kept, cases.size()])
+	quit()
