+
+static func unusual(text: String) -> bool:
+	var re := RegEx.new()
+	re.compile("([一-龯ァ-ヴーぁ-ん]{1,8}?)(で|を使って|をぶつけ|を投げつけ|を蹴り倒|を倒して|を浴びせ)")
+	for m in re.search_all(text):
+		var noun := m.get_string(1)
+		if noun.length() < 2 and not noun in ["傘", "石", "瓶", "鍋"]:
+			continue
+		var known := false
+		for word in KNOWN_NOUNS:
+			if noun.ends_with(word):
+				known = true
+		if not Weapons.named_in(noun).is_empty():
+			known = true
+		if not known:
+			return true
