new file mode 100644
index 0000000..e19e987
--- /dev/null
+++ b/scripts/skills.gd
@@ -0,0 +1,181 @@
+extends RefCounted
+## v149.33 (combat stage 5): getting better at it.
+## Three skills, Lv.1-100: strike (bats, pipes, fists), blade (knives,
+## spears), agility (stepping back, pushing off, running, shaking loose).
+## Experience comes from what was done, how hard it was, whether it was
+## new, and the level already reached — not from kills alone. Beating a
+## walker that is down and alone, or doing the same thing over and over,
+## teaches little; so does a long day of it.
+## Techniques grow slowly from the same experience (0-100 each), and their
+## effect grows with them: nothing switches on at a level.
+## Even at Lv.100 the bonus is modest (+30 to hit at most): no superhuman.
+##
+## s.combat.skills = {strike: xp, blade: xp, agility: xp}
+## s.combat.tech = {aim, range, parry, calm, efficient, stamina} (0-100)
+## s.combat.day_xp = {day, strike, blade, agility}
+
+const SKILLS := {"strike": "打撃", "blade": "刃物", "agility": "身のこなし"}
+const TECH := {
+	"aim": "狙いの安定", "range": "距離感", "parry": "受け流し", "calm": "冷静な対処",
+	"efficient": "武器の扱いの無駄のなさ", "stamina": "疲れにくい動き",
+}
+## Which techniques an experience feeds.
+const FEEDS := {"strike": ["aim", "efficient", "stamina"], "blade": ["aim", "efficient"], "agility": ["range", "parry", "calm"]}
+const DAILY_SOFT_CAP := 35
+
+## A past the player brings, one per world (from the world's seed).
+const BACKGROUNDS := [
+	{"id": "baseball", "skill": "strike", "xp": 80, "intro": "玄関の傘立てには、高校の野球部で使っていた金属バットが、今も立てかけてある。", "bat": true},
+	{"id": "cook", "skill": "blade", "xp": 80, "intro": "料理だけは好きで、台所の包丁は毎週自分で研いでいる。", "bat": false},
+	{"id": "runner", "skill": "agility", "xp": 80, "intro": "運動は得意ではないが、昔から逃げ足だけは速かった。", "bat": false},
+	{"id": "dojo", "skill": "", "xp": 0, "intro": "子どもの頃、近所の道場に少しだけ通っていた。体の動かし方は、まだどこかで覚えている。", "bat": false},
+	{"id": "none", "skill": "", "xp": 0, "intro": "", "bat": false},
+]
+
+static func background_for(seed: int) -> Dictionary:
+	return BACKGROUNDS[absi(hash([seed, "background"])) % BACKGROUNDS.size()]
+
+## Lv = 1 + (xp / K)^(1/EXP). Tuned with qa/skill_curve.gd: three fights a
+## day reach about Lv.25 in a month, Lv.45 in four, Lv.70 in about a year.
+const K := 1.3
+const EXP := 2.3
+
+static func level(xp: float) -> int:
+	return clampi(1 + int(floor(pow(maxf(0.0, xp) / K, 1.0 / EXP) + 0.0001)), 1, 100)
+
+static func xp_for(lv: int) -> float:
+	return K * pow(float(lv - 1), EXP)
+
+static func ensure(st: Dictionary, seed: int) -> void:
+	if not st.get("skills") is Dictionary:
+		st.skills = {"strike": 0.0, "blade": 0.0, "agility": 0.0}
+		var bg := background_for(seed)
+		if not str(bg.skill).is_empty():
+			st.skills[str(bg.skill)] = float(bg.xp)
+		elif str(bg.id) == "dojo":
+			st.skills.strike = 35.0
+			st.skills.agility = 35.0
+	if not st.get("tech") is Dictionary:
+		st.tech = {}
+		for t in TECH:
+			st.tech[t] = 0.0
+	if not st.get("day_xp") is Dictionary:
+		st.day_xp = {"day": -1}
+
+static func lv(world, skill: String) -> int:
+	return level(float(_st(world).skills.get(skill, 0.0)))
+
+static func tech(world, name: String) -> float:
+	return float(_st(world).tech.get(name, 0.0))
+
+static func _st(world) -> Dictionary:
+	var st: Dictionary = world.s.combat
+	ensure(st, int(world.s.get("seed", 0)))
+	return st
+
+static func skill_for_class(klass: String) -> String:
+	return "blade" if klass in ["blade", "spear"] else "strike"
+
+## Hit bonus from skill (0 at Lv.1, +30 at Lv.100) and steady aim on the head.
+static func hit_bonus(world, klass: String, part: String) -> int:
+	var b := int(0.3 * float(lv(world, skill_for_class(klass)) - 1))
+	if part == "head":
+		b += int(tech(world, "aim") / 10.0)
+	return b
+
+## How much of the fear and the crowd still gets to the player (1.0 = all).
+static func composure(world) -> float:
+	return 1.0 - tech(world, "calm") / 200.0
+
+static func grab_reduction(world) -> int:
+	return int(tech(world, "parry") / 8.0) + int(0.1 * float(lv(world, "agility") - 1))
+
+static func time_factor(world, act: String) -> float:
+	if act == "attack":
+		return 1.0 - tech(world, "efficient") / 500.0
+	if act in ["retreat", "flee", "approach", "push", "rescue"]:
+		return 1.0 - tech(world, "range") / 500.0 - 0.001 * float(lv(world, "agility") - 1)
+	return 1.0
+
+static func fatigue_factor(world) -> float:
+	return 1.0 - tech(world, "stamina") / 250.0
+
+## Experience for one deed. chance = how likely it was to work (harder →
+## more); risk = whether anything else was close (alone and down → little);
+## key = what was done, to tell repeats.
+static func gain(world, skill: String, base: float, chance: int, risky: bool, key: String) -> float:
+	var st := _st(world)
+	var day := int(world.s.minute) / 1440
+	if int(st.day_xp.get("day", -1)) != day:
+		st.day_xp = {"day": day}
+	var amount := base * clampf((100.0 - float(chance)) / 50.0, 0.4, 1.6)
+	if not risky:
+		amount *= 0.3
+	var last := str(st.get("last_deed", ""))
+	if last == key:
+		amount *= 0.5
+	st.last_deed = key
+	var seen: Dictionary = st.get("seen", {})
+	if not seen.has(key.get_slice("|", 0)):
+		amount *= 1.5
+		seen[key.get_slice("|", 0)] = true
+		st.seen = seen
+	amount *= 1.0 - float(lv(world, skill)) / 130.0
+	if float(st.day_xp.get(skill, 0.0)) > DAILY_SOFT_CAP:
+		amount *= 0.2
+	amount = snappedf(maxf(0.0, amount), 0.1)
+	st.skills[skill] = float(st.skills.get(skill, 0.0)) + amount
+	st.day_xp[skill] = float(st.day_xp.get(skill, 0.0)) + amount
+	for t in FEEDS.get(skill, []):
+		var now := float(st.tech.get(t, 0.0))
+		st.tech[t] = minf(100.0, now + amount * 0.025 * (1.0 - now / 120.0))
+	return amount
+
+## Lines for the end of a fight: what was learned (from xp before → now).
+static func summary(world, before: Dictionary, tech_before: Dictionary) -> Array:
+	var st := _st(world)
+	var lines: Array = []
+	var parts: Array = []
+	for s in SKILLS:
+		var was := float(before.get(s, 0.0))
+		var now := float(st.skills.get(s, 0.0))
+		if now - was >= 1.5 or level(now) > level(was):
+			var lv_now := level(now)
+			var up := lv_now > level(was)
+			parts.append("%s +%.0f%s" % [SKILLS[s], maxf(1.0, round(now - was)), "（Lv.%d に上がった）" % lv_now if up else "（Lv.%d）" % lv_now])
+	if not parts.is_empty():
+		lines.append("経験：" + "、".join(parts))
+	for t in TECH:
+		var was_t := float(tech_before.get(t, 0.0))
+		var now_t := float(st.tech.get(t, 0.0))
+		for mark in [10.0, 30.0, 60.0, 90.0]:
+			if was_t < mark and now_t >= mark:
+				lines.append("（%s：%s）" % [TECH[t], {10.0: "少しつかめてきた", 30.0: "身についてきた", 60.0: "体が覚えている", 90.0: "考えなくてもできる"}[mark]])
+	return lines
+
+## What the player notices about the one in front, by experience. Only what
+## can be seen: a limp, a hurt arm, how fast it moves, how close its reach is.
+static func observe(world, z: Dictionary) -> String:
+	var seen := float(_st(world).skills.get("strike", 0.0)) + float(_st(world).skills.get("blade", 0.0)) + float(_st(world).skills.get("agility", 0.0))
+	var eye := level(seen)
+	if eye < 6 or z.is_empty():
+		return ""
+	var notes: Array = []
+	if int(z.hurt.get("legs", 0)) > 0 and str(z.state) == "standing":
+		notes.append("脚を引きずっている")
+	elif str(z.kind) == "fresh" and str(z.state) == "standing":
+		notes.append("動きが速い")
+	if int(z.hurt.get("arms", 0)) > 0:
+		notes.append("腕に力が入っていない")
+	if eye >= 14:
+		if str(z.kind) == "old" and str(z.state) == "standing":
+			notes.append("素早い方向転換は苦手そうだ")
+		if float(z.dist) <= 1.5 and str(z.state) == "standing":
+			notes.append("ただし、腕を伸ばせば届く距離にいる")
+	return "、".join(notes)
+
+static func panel_words(world) -> String:
+	var parts: Array = []
+	for s in SKILLS:
+		parts.append("%s Lv.%d" % [SKILLS[s], lv(world, s)])
+	return " ・ ".join(parts)
