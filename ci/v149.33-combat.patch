diff --git a/scripts/allies.gd b/scripts/allies.gd
new file mode 100644
index 0000000..0eef067
--- /dev/null
+++ b/scripts/allies.gd
@@ -0,0 +1,260 @@
+extends RefCounted
+## v149.33 (combat stage 4): housemates in a fight act on their own — by
+## courage, experience, mood and wounds they stand and fight, hang back,
+## hide, run, free themselves, call for help, or help the player.
+##
+## The principle on death: no housemate is bitten by a single roll. A grab
+## is a warning ("助けて！") that the player can answer; only when it is not
+## answered (the player did something else, ran, or failed to pull it off),
+## or after a risky order ("前に出て"), can the teeth reach them.
+##
+## encounter.allies = {"<index>": {stance, held_by, held_at, order, risky, fled, kills}}
+##   stance: fight (beside the player, in reach) / back (behind) / hide / gone
+
+const Walkers = preload("res://scripts/walkers.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const Mood = preload("res://scripts/mood.gd")
+const Chronicle = preload("res://scripts/chronicle.gd")
+
+const JOB_SKILL := {"元自衛官": 30, "警備員": 18, "大工": 12, "居酒屋の店主": 6, "看護師": 0, "高校生": 0, "小学生": -30}
+
+static func courage(world, mate: Dictionary) -> int:
+	var c := 50
+	var sid := str(mate.get("survivor", ""))
+	if not sid.is_empty():
+		c = int(Survivors.person(world, sid).get("traits", {}).get("courage", 50))
+	c += 10 if str(mate.get("role", "")) == "watch" else 0
+	if float(mate.get("mood", 55.0)) < 30.0:
+		c -= 15
+	if float(mate.get("health", 100.0)) < 50.0:
+		c -= 10
+	if int(mate.get("age", 30)) <= 12:
+		c -= 30
+	return clampi(c, 0, 100)
+
+static func skill(world, mate: Dictionary) -> int:
+	var s := 30 + int(JOB_SKILL.get(str(mate.get("job", "")), 0)) + (courage(world, mate) - 50) / 5
+	if float(mate.get("health", 100.0)) < 50.0:
+		s -= 10
+	return clampi(s, 5, 80)
+
+static func mate(world, key: String) -> Dictionary:
+	var i := int(key)
+	return world.s.household_members[i] if i >= 0 and i < world.s.household_members.size() else {}
+
+## Everyone present gets a place in the fight: the brave and able beside
+## the player, the rest behind.
+static func ensure(world, present: Array) -> Dictionary:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	if enc.is_empty():
+		return {}
+	if not enc.get("allies") is Dictionary:
+		enc.allies = {}
+	var allies: Dictionary = enc.allies
+	for index in present:
+		var key := str(index)
+		if allies.has(key):
+			continue
+		var m: Dictionary = world.s.household_members[index]
+		var brave := courage(world, m) >= 60 and skill(world, m) >= 35
+		allies[key] = {"stance": "fight" if brave else "back", "held_by": "", "held_at": -1, "order": "", "risky": false, "kills": 0}
+	return allies
+
+static func active(world) -> Array:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	var out: Array = []
+	for key in enc.get("allies", {}):
+		var a: Dictionary = enc.allies[key]
+		var m := mate(world, key)
+		if m.is_empty() or float(m.get("health", 0.0)) <= 0.0 or str(a.stance) == "gone":
+			continue
+		out.append(key)
+	return out
+
+static func held(world) -> Array:
+	return active(world).filter(func(k): return not str(Walkers.ensure(world).encounter.allies[k].held_by).is_empty())
+
+static func _line(world, m: Dictionary, brave: String, polite: String, scared: String) -> String:
+	var c := courage(world, m)
+	var voice := str(m.get("speech", {}).get("voice", "")) if m.get("speech") is Dictionary else ""
+	if c < 30:
+		return scared
+	return polite if voice in ["young", "calm"] else brave
+
+## Orders by name: "詩音は下がって", "詩音、一緒に戦って", "詩音、前に出て".
+## Returns lines (empty when no order was given).
+static func order(world, cmd: String, present: Array) -> Array:
+	var lines: Array = []
+	var allies := ensure(world, present)
+	for key in allies:
+		var m := mate(world, key)
+		if m.is_empty() or not cmd.contains(str(m.name)):
+			continue
+		var a: Dictionary = allies[key]
+		var name := str(m.name)
+		if _has(cmd, ["前に出", "突っ込", "囮", "おとり", "先に行って"]):
+			if courage(world, m) < 25:
+				lines.append("%s「む、無理……！」%sは首を振って、その場から動けない。" % [name, name])
+				continue
+			a.stance = "fight"
+			a.risky = true
+			a.order = "front"
+			lines.append("%s「……わかった」%sは青い顔で、前に踏み出した。" % [name, name])
+		elif _has(cmd, ["戦って", "手伝って", "一緒に", "援護", "かかって", "やっつけ", "手を貸"]):
+			if courage(world, m) < 25:
+				lines.append("%s「ごめん、足が……動かない」%sは後ろで震えている。" % [name, name])
+				continue
+			a.stance = "fight"
+			a.order = "fight"
+			lines.append(_line(world, m, "%s「おう、任せろ」" % name, "%s「はい！」" % name, "%s「や、やってみる……」" % name))
+		elif _has(cmd, ["隠れて", "身を隠", "伏せて"]):
+			a.stance = "hide"
+			a.risky = false
+			lines.append("%sは物陰にしゃがみこんだ。" % name)
+		elif _has(cmd, ["逃げて", "先に帰", "家に戻って", "行って", "走って"]):
+			if not str(a.held_by).is_empty():
+				lines.append("%sはつかまれていて、逃げられない！" % name)
+				continue
+			a.stance = "gone"
+			m.location = "居間"
+			m.activity = "在宅"
+			lines.append("%sは振り返らずに、家の方へ走っていった。" % name)
+		elif _has(cmd, ["下がって", "後ろに", "離れて", "来るな", "下がれ"]):
+			a.stance = "back"
+			a.risky = false
+			lines.append("%sは数歩下がった。" % name)
+	return lines
+
+static func _has(text: String, words: Array) -> bool:
+	for w in words:
+		if text.contains(w):
+			return true
+	return false
+
+## Who the walker in front gets hold of: the player, or someone standing
+## beside them (only those standing in the fight).
+static func pick_victim(world, roll: int) -> String:
+	var front: Array = active(world).filter(func(k): return str(Walkers.ensure(world).encounter.allies[k].stance) == "fight" and str(Walkers.ensure(world).encounter.allies[k].held_by).is_empty())
+	if front.is_empty():
+		return ""
+	# Beside the player, they are as likely to be the one grabbed.
+	var slots := front.size() + 1
+	var pick := roll % slots
+	return "" if pick == 0 else str(front[pick - 1])
+
+## A housemate is grabbed: a warning, not yet a bite.
+static func grab(world, key: String, zombie_id: String) -> String:
+	var a: Dictionary = Walkers.ensure(world).encounter.allies[key]
+	var m := mate(world, key)
+	a.held_by = zombie_id
+	a.held_at = int(Walkers.ensure(world).encounter.get("beat", 0))
+	m.health = maxf(1.0, float(m.health) - 4.0)
+	Mood.change(m, -6.0)
+	return "%sが腕をつかまれた！「%s」（「%sを助ける」）" % [m.name, "助けて！" if courage(world, m) < 60 else "くそっ、放せ！", m.name]
+
+## The player pulls a held housemate free. chance from how the player goes about it.
+static func rescue(world, key: String, roll: int, chance: int) -> String:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	var a: Dictionary = enc.allies[key]
+	var m := mate(world, key)
+	if roll < chance:
+		for z in enc.get("zombies", []):
+			if str(z.id) == str(a.held_by):
+				z.dist = float(z.dist) + 1.5
+		a.held_by = ""
+		Mood.change(m, 4.0)
+		return "%sの腕をつかむ手を、力ずくで引きはがした。%sはよろめきながら、こちらの後ろへ下がった。" % [m.name, m.name]
+	return "引きはがそうとしたが、指が腕に食いこんで離れない！"
+
+static func _bite(world, key: String, why: String) -> String:
+	var index := int(key)
+	var m := mate(world, key)
+	var a: Dictionary = Walkers.ensure(world).encounter.allies[key]
+	a.held_by = ""
+	a.stance = "back"
+	Walkers.bite_housemate(world, index)
+	Chronicle.note(world, "%sが、感染者に噛まれた。%s" % [m.name, why], "bitten", str(m.name))
+	return "%sの悲鳴が上がった。……噛まれた。腕に、くっきりと歯の跡が残っている。" % m.name
+
+## The housemates' part of one moment of the fight (after the player's
+## step, during the same seconds). Returns lines.
+static func act(world, roll_of: Callable, combat) -> Array:
+	var lines: Array = []
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	if enc.is_empty():
+		return lines
+	var beat := int(enc.get("beat", 0))
+	for key in active(world):
+		var a: Dictionary = enc.allies[key]
+		var m := mate(world, key)
+		var name := str(m.name)
+		if not str(a.held_by).is_empty():
+			if int(a.held_at) >= beat:
+				continue
+			# A turn has passed since the warning: they try themselves first.
+			if int(roll_of.call("free-" + key)) < 20 + skill(world, m) / 3:
+				a.held_by = ""
+				lines.append("%sは自分で相手の指を振りほどき、後ろへ転がり出た。" % name)
+				continue
+			var bite := 35 + (20 if bool(a.risky) else 0)
+			if int(roll_of.call("ally-bite-" + key)) < bite:
+				lines.append(_bite(world, key, "助けが間に合わなかった。" if not bool(a.risky) else "前に出るよう言われていた。"))
+				continue
+			a.held_at = beat
+			lines.append("%sはまだつかまれている。必死にもがいている！（「%sを助ける」）" % [name, name])
+			continue
+		# Fear: the timid break away when the dead crowd in.
+		if str(a.stance) == "fight" and str(a.order).is_empty() and courage(world, m) < 35 and combat.close_count(world, 2.0) >= 2:
+			a.stance = "back"
+			lines.append("%sは息をのんで、後ろへ下がった。" % name)
+			continue
+		if str(a.stance) != "fight":
+			continue
+		# Standing beside the player: they hit the nearest one in reach.
+		var target: Dictionary = {}
+		for z in combat.zombies(world):
+			if float(z.dist) <= 1.6:
+				target = z
+				break
+		if target.is_empty():
+			continue
+		var down := str(target.state) in ["downed", "crawling", "pinned"]
+		var aim := "head" if down else "legs"
+		var chance := skill(world, m) + (25 if down else 5) - (15 if combat.dark(world) else 0)
+		if int(roll_of.call("ally-hit-" + key)) < chance:
+			var hit: Dictionary = combat._hit(world, target, aim, "plank")
+			if bool(hit.outcome.kill):
+				a.kills = int(a.get("kills", 0)) + 1
+			lines.append("%sが横から打ちかかった。%s" % [name, str(hit.line).substr(combat._last_land.length())])
+		else:
+			lines.append("%sが横から打ちかかったが、当たらなかった。" % name)
+	return lines
+
+## The panel's line about the housemates.
+static func status_words(world) -> String:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	var parts: Array = []
+	for key in active(world):
+		var a: Dictionary = enc.allies[key]
+		var m := mate(world, key)
+		var where := ""
+		if not str(a.held_by).is_empty():
+			where = "つかまれている！"
+		else:
+			where = {"fight": "隣で構えている", "back": "後ろにいる", "hide": "物陰に隠れている"}.get(str(a.stance), "")
+		parts.append("%s：%s" % [m.name, where])
+	return " ／ ".join(parts)
+
+## When the player runs: those standing free come along; one held is left.
+static func on_flee(world) -> Array:
+	var lines: Array = []
+	for key in held(world):
+		var m := mate(world, key)
+		var a: Dictionary = Walkers.ensure(world).encounter.allies[key]
+		if world.draw(int(world.s.minute), int(key) * 41 + 7, "left-behind", 100) < 70:
+			_bite(world, key, "つかまれたまま、置いていかれた。")
+			lines.append("背後で、%sの悲鳴が聞こえた。" % m.name)
+		else:
+			a.held_by = ""
+			lines.append("%sは自分で振りほどき、遅れて追いついてきた。息が上がり、顔は真っ青だ。" % m.name)
+	return lines
diff --git a/scripts/combat.gd b/scripts/combat.gd
new file mode 100644
index 0000000..cbaec12
--- /dev/null
+++ b/scripts/combat.gd
@@ -0,0 +1,774 @@
+extends RefCounted
+## v149.33 (combat stage 1): each walker in an encounter as its own body —
+## distance, state, wounds — and how many seconds an action takes. The
+## outcome of actions is still decided in walkers.gd (stage 2 replaces it);
+## this keeps the bodies, the clock and what the player can see.
+##
+## encounter.zombies = [{id, dist, state, hurt{head,arms,legs,torso}, kind}]
+##   state: standing / downed / crawling / pinned
+##   kind:  fresh (recently turned, quicker) / old (decayed, slower)
+## Only the nearest few are tracked one by one; the rest stay a number.
+## Old saves have no zombies list: it is made from the count on first use.
+
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+const Intent = preload("res://scripts/combat_intent.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const CombatText = preload("res://scripts/combat_text.gd")
+const Allies = preload("res://scripts/allies.gd")
+
+const TRACKED := 6
+const SPEED := {"fresh": 1.3, "old": 0.8}
+const CRAWL_SPEED := 0.3
+## A noticed walker stops at arm's reach; the grab itself is walkers.gd's.
+const REACH := 0.6
+## Base seconds for each encounter action (before body and place).
+const BASE_SECONDS := {"look": 2.0, "fight": 2.0, "distract": 3.0, "hide": 4.0, "flee": 4.0}
+
+static func active(world) -> bool:
+	return not Walkers.ensure(world).encounter.is_empty()
+
+static func zombies(world) -> Array:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	return enc.get("zombies", []) if enc.get("zombies", []) is Array else []
+
+## Keeps the tracked bodies in step with the walkers counted at the place:
+## new ones are added at a distance, the killed or departed are removed
+## nearest first (a kill in walkers.gd is always the one in front).
+static func sync(world) -> void:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	if enc.is_empty():
+		return
+	if not enc.get("zombies") is Array:
+		enc.zombies = []
+	if not enc.has("clock"):
+		enc.clock = 0.0
+	var list: Array = enc.zombies
+	var total := maxi(1, Walkers.count(world, str(enc.place)))
+	var want := mini(total, TRACKED)
+	_sort(list)
+	while list.size() > want:
+		list.pop_front()
+	var serial := int(enc.get("serial", 0))
+	while list.size() < want:
+		serial += 1
+		var minute := int(world.s.minute)
+		var near := bool(enc.get("near", false)) and list.is_empty()
+		var dist := 2.0 if near else 5.0 + float(world.draw(minute, serial * 7, "z-dist", 120)) / 10.0
+		list.append({
+			"id": "z%d_%d" % [int(enc.get("since", minute)), serial],
+			"dist": dist,
+			"state": "standing",
+			"hurt": {"head": 0, "arms": 0, "legs": 0, "torso": 0},
+			"kind": "fresh" if world.draw(minute, serial * 11, "z-kind", 100) < 35 else "old",
+		})
+	enc.serial = serial
+	# Stage 2: "noticed" and "how close" are kept apart. An encounter that
+	# began noticed and close (walkers.gd's `near`) starts with the front one
+	# at two metres; after that only time and actions move them.
+	if not enc.has("noticed"):
+		enc.noticed = bool(enc.get("near", false))
+		if bool(enc.noticed) and not list.is_empty():
+			_sort(list)
+			list[0].dist = minf(float(list[0].dist), 2.0)
+	_sort(list)
+
+static func _sort(list: Array) -> void:
+	list.sort_custom(func(a, b): return float(a.dist) < float(b.dist))
+
+## How long an action takes for this body in this place, in seconds.
+static func seconds(world, kind: String) -> float:
+	var t := float(BASE_SECONDS.get(kind, 2.0))
+	var tired := clampf(float(world.s.get("fatigue", 0.0)) / 100.0, 0.0, 1.0)
+	t *= 1.0 + 0.5 * tired
+	t *= 1.0 + 0.08 * minf(float(world.s.get("injuries", 0)), 5.0)
+	if kind == "flee" and terrain(world) == "corridor":
+		t *= 1.2
+	return snappedf(t, 0.1)
+
+## Time passes for the walkers too: those that have noticed come closer.
+static func tick(world, secs: float) -> void:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	if enc.is_empty():
+		return
+	enc.clock = float(enc.get("clock", 0.0)) + secs
+	if not bool(enc.get("noticed", enc.get("near", false))):
+		return
+	for z in zombies(world):
+		var speed := 0.0
+		match str(z.state):
+			"standing": speed = float(SPEED.get(str(z.kind), 0.8))
+			"crawling": speed = CRAWL_SPEED
+			"blinded": speed = 0.2
+		z.dist = maxf(REACH, float(z.dist) - speed * secs)
+	_sort(zombies(world))
+
+## Where the fight happens, from the place.
+static func terrain(world, place: String = "") -> String:
+	if place.is_empty():
+		place = str(Walkers.ensure(world).encounter.get("place", ""))
+	if place in ["廊下", "共用廊下"]:
+		return "corridor"
+	if place in ["玄関"]:
+		return "doorway"
+	if place in ["コンビニ", "デパート", "デパート地下", "食品店", "金物店", "薬局", "近所の空き家"]:
+		return "shop"
+	if place in ["寝室", "居間", "台所"]:
+		return "room"
+	return "street"
+
+const TERRAIN_WORDS := {"corridor": "狭い廊下", "doorway": "玄関先", "shop": "建物の中（棚や物がある）", "room": "部屋の中", "street": "見通しのいい通り"}
+
+## Dark enough that numbers and distances are guesses.
+static func dark(world) -> bool:
+	var hour: float = world.hour_of_day()
+	var night := hour < 6.0 or hour >= 18.0
+	var place := str(Walkers.ensure(world).encounter.get("place", ""))
+	if terrain(world, place) in ["street"]:
+		return night
+	return night or not bool(world.s.get("grid_online", true))
+
+static func distance_words(d: float, dark_now: bool) -> String:
+	if d <= 1.0:
+		return "手が届きそうな距離"
+	if d <= 2.5:
+		return "すぐ目の前（%.0fmほど）" % d if not dark_now else "すぐ目の前"
+	if dark_now:
+		return "暗くて、距離がはっきりしない"
+	if d <= 6.0:
+		return "数歩先（%.0fmほど）" % d
+	return "少し離れたところ（%.0fmほど）" % d
+
+## What could be hit and how hard it looks, in words (never numbers).
+static func target_words(world) -> String:
+	var list := zombies(world)
+	if list.is_empty():
+		return ""
+	var z: Dictionary = list[0]
+	if float(z.dist) > 8.0:
+		return "攻撃：まだ届かない距離"
+	var parts: Array = []
+	for part in ["head", "legs", "arms", "torso"]:
+		if part == "legs" and str(z.state) != "standing":
+			continue
+		parts.append("%s：%s" % [PART_NAMES[part], odds_words(hit_chance(world, part, z))])
+	return " ／ ".join(parts)
+
+## What the player can see, for the panel above the story.
+static func status_lines(world) -> Array:
+	if not active(world):
+		return []
+	sync(world)
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	var list := zombies(world)
+	var total := maxi(1, Walkers.count(world, str(enc.place)))
+	var dark_now := dark(world)
+	var lines: Array = []
+	var head_count := ""
+	if dark_now and total > 1:
+		head_count = "何人かいる（暗くて数えられない）"
+	elif total >= 10:
+		head_count = "数えきれない（%d人以上）" % (total / 10 * 10)
+	elif int(enc.get("counted", 0)) == total:
+		head_count = "%d人" % total
+	else:
+		# Only what a glance gives, as the header does, until counted.
+		head_count = Walkers.estimate(total)
+	var front: Dictionary = list[0] if not list.is_empty() else {}
+	var front_words := distance_words(float(front.get("dist", 8.0)), dark_now)
+	var state_words := ""
+	match str(front.get("state", "standing")):
+		"downed": state_words = "・倒れている"
+		"crawling": state_words = "・這ってくる"
+		"pinned": state_words = "・挟まって動けない"
+	lines.append("感染者：%s ・ 一番近いのは%s%s" % [head_count, front_words, state_words])
+	if not bool(enc.get("noticed", enc.get("near", false))):
+		lines.append("まだ、こちらには気づいていない")
+	lines.append("手持ち：%s ・ 場所：%s" % [weapon_words(world), TERRAIN_WORDS[terrain(world)]])
+	lines.append("体：%s" % body_words(world))
+	var company := Allies.status_words(world)
+	if not company.is_empty():
+		lines.append(company)
+	var targets := target_words(world)
+	if not targets.is_empty():
+		lines.append(targets)
+	return lines
+
+static func weapon_words(world) -> String:
+	var type := Weapons.held(world)
+	var cond := Weapons.condition_words(world, type)
+	return Weapons.name_of(type) + ("（%s）" % cond if not cond.is_empty() else "")
+
+static func body_words(world) -> String:
+	var parts: Array = []
+	var hp := float(world.s.health)
+	parts.append("元気" if hp >= 80.0 else ("傷が痛む" if hp >= 40.0 else "ふらついている"))
+	var tired := float(world.s.get("fatigue", 0.0))
+	if tired >= 70.0:
+		parts.append("息が上がっている")
+	elif tired >= 40.0:
+		parts.append("少し疲れている")
+	var hurt := Weapons.wounds_words(world)
+	if not hurt.is_empty():
+		parts.append(hurt)
+	return "・".join(parts)
+
+## The picture of the fight as it stands (assets/combat/<name>.jpg), from
+## what the player can see: how many, how near, standing or down, where,
+## and how dark. Variants are tried most specific first:
+## <name>_<terrain>_night, <name>_<terrain>, <name>_night, <name>.
+const PICTURES := "res://assets/combat/"
+
+static func picture_name(world) -> String:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	if enc.is_empty():
+		return ""
+	sync(world)
+	var list := zombies(world)
+	var total := maxi(1, Walkers.count(world, str(enc.place)))
+	var front: Dictionary = list[0] if not list.is_empty() else {}
+	var d := float(front.get("dist", 8.0))
+	var near := bool(enc.get("noticed", enc.get("near", false)))
+	if total >= 10 or Walkers.horde_at(world, str(enc.place)) > 0:
+		return "fight_horde"
+	if str(front.get("state", "")) in ["downed", "crawling"] and d <= 3.0:
+		return "fight_downed"
+	if bool(enc.get("grabbed", false)):
+		return "fight_grab"
+	if not near:
+		return "fight_far_many" if total >= 2 else "fight_far"
+	if d <= 3.0 and total >= 3:
+		return "fight_many_close"
+	if d <= 2.5:
+		return "fight_close"
+	return "fight_noticed"
+
+static func picture_path(world, name: String = "") -> String:
+	if name.is_empty():
+		name = picture_name(world)
+	if name.is_empty():
+		return ""
+	var where := terrain(world)
+	var night := dark(world)
+	var options: Array = []
+	if where != "street":
+		if night:
+			options.append("%s_%s_night" % [name, where])
+		options.append("%s_%s" % [name, where])
+	if night:
+		options.append("%s_night" % name)
+	options.append(name)
+	for base in options:
+		for ext in [".jpg", ".png", ".webp"]:
+			if ResourceLoader.exists(PICTURES + str(base) + ext):
+				return PICTURES + str(base) + ext
+	return ""
+
+
+# --------------------------------------------------------------------------
+# Stage 2: the rules. Each step of an order is resolved here; the walkers
+# move during the seconds it takes; a grab is checked at the end. The local
+# model never decides any of this (it may only read the order, and later put
+# the result into words).
+
+const PART_NAMES := {"head": "頭", "legs": "脚", "arms": "腕", "torso": "胴", "": "体"}
+## How easy each part is to hit on a standing, approaching walker.
+const PART_BASE := {"head": 22, "legs": 55, "arms": 45, "torso": 70, "": 60}
+## Seconds of each act before body and place (stage 3 adds weapon weight).
+const ACT_SECONDS := {"rescue": 2.0, "spray": 2.0, "attack": 2.0, "push": 2.0, "retreat": 3.0, "approach": 2.0, "wait": 2.0, "close_door": 2.0, "obstacle": 5.0,
+	"look": 2.0, "flee": 4.0, "hide": 4.0, "distract": 3.0}
+const PLAYER_SPEED := 1.5
+
+## Kept for the legacy rules (raiders, the neighbour): the weapon in hand as
+## a bonus.
+static func weapon(world) -> int:
+	return int(Weapons.spec(world).handling) + int(Weapons.spec(world).head) / 3
+
+## How far the player can strike with what is in hand.
+static func reach(world, type: String = "") -> float:
+	return float(Weapons.spec(world, type).reach)
+
+static func noticed(world) -> bool:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	return bool(enc.get("noticed", enc.get("near", false)))
+
+static func front(world) -> Dictionary:
+	var list := zombies(world)
+	return list[0] if not list.is_empty() else {}
+
+static func close_count(world, metres: float) -> int:
+	return zombies(world).filter(func(z): return float(z.dist) <= metres).size()
+
+## The chance (5-95) of hitting this part of this walker now.
+static func hit_chance(world, part: String, z: Dictionary, type: String = "") -> int:
+	var w := Weapons.spec(world, type)
+	var c := int(PART_BASE.get(part, 60)) + int(w.handling)
+	if terrain(world) == "corridor":
+		c += mini(0, int(w.narrow))
+	var down := str(z.get("state", "standing")) in ["downed", "crawling", "pinned"]
+	if down:
+		c += 35 if part == "head" else 10
+	elif str(z.get("state", "")) == "blinded":
+		c += 15
+	elif noticed(world):
+		c -= 5
+	if dark(world):
+		c -= 15
+	c -= mini(20, int(float(world.s.get("fatigue", 0.0)) / 5.0))
+	c -= Weapons.arm_penalty(world)
+	c -= Mood.nerve_penalty(world.s)
+	c -= 8 * maxi(0, close_count(world, 3.0) - 1)
+	return clampi(c, 5, 95)
+
+static func odds_words(chance: int) -> String:
+	if chance <= 20:
+		return "かなり難しい"
+	if chance <= 40:
+		return "難しい"
+	if chance <= 65:
+		return "狙える"
+	return "狙いやすい"
+
+static func step_seconds(world, act: String) -> float:
+	var t := float(ACT_SECONDS.get(act, 2.0))
+	var tired := clampf(float(world.s.get("fatigue", 0.0)) / 100.0, 0.0, 1.0)
+	t *= 1.0 + 0.5 * tired
+	t *= 1.0 + 0.08 * minf(float(world.s.get("injuries", 0)), 5.0)
+	if act in ["flee", "retreat"] and terrain(world) == "corridor":
+		t *= 1.2
+	if act in ["flee", "retreat", "approach"]:
+		t *= Weapons.leg_factor(world)
+	if act == "attack":
+		t += 0.2 * float(Weapons.spec(world).weight)
+	return snappedf(t, 0.1)
+
+static func _roll(world, tag: String) -> int:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	enc.beat = int(enc.get("beat", 0)) + 1
+	return world.draw(int(world.s.minute), int(enc.beat) * 37 + tag.hash() % 997, "combat-" + tag, 100)
+
+static func _kill(world, z: Dictionary) -> void:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	zombies(world).erase(z)
+	Walkers._add(world, str(enc.place), -1)
+	w.killed = int(w.get("killed", 0)) + 1
+
+## Resolves one step. Returns {lines, seconds, card, ended, bitten, stop,
+## invalid, kind (for the legacy moves), minutes}.
+static func act(world, step: Dictionary, present: Array = []) -> Dictionary:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	var out := {"lines": [], "seconds": 0.0, "card": "", "ended": false, "bitten": false, "stop": false, "invalid": false, "kind": "", "minutes": 0, "weapon": "", "outcome": {}, "part": "", "result_text": ""}
+	if enc.is_empty():
+		out.lines.append("近くに感染者はいない。")
+		out.ended = true
+		return out
+	sync(world)
+	Allies.ensure(world, present)
+	enc.grabbed = false
+	var kind := str(step.get("act", ""))
+	var part := str(step.get("part", ""))
+	var z := front(world)
+	if str(step.get("target", "")) == "down":
+		for each in zombies(world):
+			if str(each.state) in ["downed", "crawling", "pinned"] and float(each.dist) <= 3.0:
+				z = each
+				break
+	elif kind == "attack" and str(step.get("part", "")) == "legs" and not z.is_empty() and str(z.state) != "standing":
+		# A sweep at the legs is for one still on its feet.
+		for each in zombies(world):
+			if str(each.state) in ["standing", "blinded"] and float(each.dist) <= 8.0:
+				z = each
+				break
+	var place := str(enc.place)
+	var close_before := close_count(world, 2.0)
+	match kind:
+		"flee", "hide", "distract", "look":
+			# Sneaking, running and throwing keep their v149.24 rules; the
+			# legacy `near` means noticed and within two and a half metres.
+			enc.near = noticed(world) and float(z.get("dist", 9.0)) <= 2.5
+			# Housemates are not caught by the legacy rules (stage 4: their
+			# danger comes in steps, below); they still count as company.
+			var held_allies := Allies.held(world)
+			var r := Walkers.resolve(world, kind, weapon(world), present.size(), [])
+			out.lines.append(str(r.text))
+			if kind == "flee" and bool(r.ended) and not bool(r.bitten) and not held_allies.is_empty():
+				Walkers.ensure(world).encounter = enc
+				for line in Allies.on_flee(world):
+					out.lines.append(line)
+				Walkers.ensure(world).encounter = {}
+			out.bitten = bool(r.bitten)
+			out.ended = bool(r.ended) or w.encounter.is_empty()
+			out.minutes = int(r.minutes)
+			out.kind = kind
+			out.seconds = step_seconds(world, kind)
+			if not w.encounter.is_empty():
+				if bool(w.encounter.get("near", false)):
+					w.encounter.noticed = true
+				tick(world, out.seconds)
+			out.stop = out.ended or out.bitten
+			return out
+		"attack":
+			if z.is_empty():
+				out.lines.append("狙える相手がいない。")
+				out.invalid = true
+				return out
+			var type := str(step.get("weapon", ""))
+			if type == "extinguisher":
+				return _spray(world, out, present, place, close_before)
+			if type.is_empty():
+				type = Weapons.held(world)
+			elif not type in ["fists"] and not Weapons.owns(world, type) and not (type == "plank" and int(world.s.inventory.get("wood", 0)) > 0):
+				out.lines.append("%sは持っていない。（何もしていない）" % Weapons.name_of(type))
+				out.invalid = true
+				return out
+			if type == str(Weapons.state(world).stuck):
+				out.lines.append("%sは、倒れた相手に刺さったままだ。（何もしていない）" % Weapons.name_of(type))
+				out.invalid = true
+				return out
+			var spec := Weapons.spec(world, type)
+			if terrain(world) == "corridor" and int(spec.narrow) <= -100:
+				out.lines.append("廊下が狭くて、%sを構えられない。（何もしていない）" % Weapons.name_of(type))
+				out.invalid = true
+				return out
+			out.weapon = type
+			# A swing at someone in sight includes closing the gap (they come
+			# too, if they have noticed). An unnoticed one may be reached from
+			# behind. Further than eight metres, or unseen in the dark, it is
+			# not an attack yet.
+			var gap := float(z.dist) - float(spec.reach)
+			if float(z.dist) > 8.0 or (dark(world) and float(z.dist) > 3.0):
+				out.lines.append("まだ届かない。相手は%s。近づくか、待ち構えるしかない。（何もしていない）" % distance_words(float(z.dist), dark(world)))
+				out.invalid = true
+				return out
+			out.seconds = step_seconds(world, "attack")
+			var sneak := false
+			var lead := ""
+			if gap > 0.05:
+				var closing := PLAYER_SPEED + (float(SPEED.get(str(z.kind), 0.8)) if noticed(world) else 0.0)
+				out.seconds += snappedf(gap / closing, 0.1)
+				if not noticed(world):
+					sneak = _roll(world, "sneak") < 55 - 5 * maxi(0, Walkers.count(world, place) - 1)
+					lead = "足音を殺して、背後から近づいた。" if sneak else "近づくうちに、相手がこちらに気づいて振り向いた。"
+				else:
+					lead = "間合いを詰めた。"
+				z.dist = float(spec.reach)
+			Walkers.make_noise(world, place, int(spec.noise))
+			enc.noticed = true
+			world.s.fatigue = minf(100.0, float(world.s.get("fatigue", 0.0)) + 0.5 + 0.6 * float(spec.weight))
+			var chance := hit_chance(world, part, z, type) + (25 if sneak else 0)
+			var aim := part
+			if _roll(world, "hit-" + part) < chance:
+				if aim.is_empty():
+					var pick := _roll(world, "where")
+					aim = "torso" if pick < 30 else ("arms" if pick < 50 else ("legs" if pick < 75 else "head"))
+				var hit := _hit(world, z, aim, type)
+				out.outcome = hit.outcome
+				out.part = aim
+				out.result_text = str(hit.line).substr(_last_land.length())
+				out.lines.append(lead + str(hit.line))
+				out.card = "fight_head" if aim == "head" else ("fight_legs" if aim == "legs" else "fight_head")
+				var broke := Weapons.wear(world, type, 2 if aim == "head" else 1)
+				if not broke.is_empty():
+					out.lines.append(broke)
+			else:
+				out.outcome = {"hit": false}
+				out.part = part
+				out.result_text = CombatText.miss_tail(world)
+				out.lines.append(lead + CombatText.miss(world, part, str(z.state) in ["downed", "crawling", "pinned"], dark(world)))
+				out.card = "fight_miss"
+		"spray":
+			return _spray(world, out, present, place, close_before)
+		"rescue":
+			var holding := Allies.held(world)
+			var key := ""
+			for k in holding:
+				if str(step.get("text", "")).contains(str(Allies.mate(world, k).name)):
+					key = k
+			if key.is_empty() and not holding.is_empty():
+				key = str(holding[0])
+			if key.is_empty():
+				out.lines.append("今、つかまれている人はいない。（何もしていない）")
+				out.invalid = true
+				return out
+			out.seconds = step_seconds(world, "push")
+			var chance := 55 + int(Weapons.spec(world).handling) - Weapons.arm_penalty(world) - mini(20, int(float(world.s.get("fatigue", 0.0)) / 5.0))
+			out.lines.append(Allies.rescue(world, key, _roll(world, "rescue"), chance))
+		"push":
+			if z.is_empty() or float(z.dist) > 3.0:
+				out.lines.append("押し返せるほど近くにはいない。（何もしていない）")
+				out.invalid = true
+				return out
+			out.seconds = step_seconds(world, "push")
+			if float(z.dist) > 1.3:
+				out.seconds += snappedf((float(z.dist) - 1.0) / PLAYER_SPEED, 0.1)
+				z.dist = 1.0
+			enc.noticed = true
+			if _roll(world, "push") < 65 - mini(20, int(float(world.s.get("fatigue", 0.0)) / 5.0)):
+				z.dist = float(z.dist) + 1.5
+				if _roll(world, "push-down") < 35 and str(z.state) == "standing":
+					z.state = "downed"
+					z.down_for = 4.0
+					out.lines.append("両手で胸を突き飛ばした。相手はよろめいて、仰向けに倒れた。")
+				else:
+					out.lines.append("両手で胸を突き飛ばした。相手は数歩よろめいて、距離が開いた。")
+				out.card = "push"
+			else:
+				out.lines.append("突き飛ばそうとしたが、相手の体は思ったより重かった。びくともしない。")
+		"retreat":
+			out.seconds = step_seconds(world, "retreat")
+			for each in zombies(world):
+				each.dist = float(each.dist) + PLAYER_SPEED * out.seconds
+			out.lines.append("相手から目を離さずに、数歩ずつ下がった。")
+		"approach":
+			out.seconds = step_seconds(world, "approach")
+			for each in zombies(world):
+				each.dist = maxf(REACH, float(each.dist) - PLAYER_SPEED * out.seconds)
+			out.lines.append("武器を構えたまま、間合いを詰めた。")
+		"wait":
+			out.seconds = step_seconds(world, "wait")
+			enc.noticed = true
+			out.lines.append("足を止めて構え、相手が来るのを待った。")
+		"close_door":
+			if terrain(world) == "street":
+				out.lines.append("ここには、閉められる扉がない。（何もしていない）")
+				out.invalid = true
+				return out
+			out.seconds = step_seconds(world, "close_door")
+			if z.is_empty() or float(z.dist) > 1.0:
+				w.encounter = {}
+				out.lines.append("扉を力いっぱい閉めた。向こう側で、何かがぶつかる鈍い音がした。")
+				out.ended = true
+				out.stop = true
+				return out
+			out.lines.append("扉を閉めようとしたが、相手の腕が隙間に割り込んでいる。閉まらない。")
+		"obstacle":
+			if terrain(world) != "shop":
+				out.lines.append("ここには、倒して道をふさげるような物がない。（何もしていない）")
+				out.invalid = true
+				return out
+			out.seconds = step_seconds(world, "obstacle")
+			Walkers.make_noise(world, place)
+			for each in zombies(world):
+				each.dist = float(each.dist) + 3.0
+			out.lines.append("棚を引き倒して、通路をふさいだ。商品が派手に散らばる。相手は棚に足を取られている。")
+		_:
+			out.lines.append("どう動くか、もう少し具体的に書いてほしい。（何もしていない）")
+			out.invalid = true
+			return out
+	# The others move while it happened; then the one in front may grab.
+	_recover(world, out.seconds)
+	tick(world, out.seconds)
+	sync(world)
+	if Walkers.count(world, place) <= 0:
+		w.encounter = {}
+		out.lines.append("あたりに、ほかの姿はない。物音が響いたので、長居はしない方がいい。")
+		var stuck := str(Weapons.state(world).stuck)
+		if not stuck.is_empty():
+			Weapons.state(world).stuck = ""
+			out.lines.append("倒れた相手から、%sを力ずくで引き抜いた。" % Weapons.name_of(stuck))
+		out.ended = true
+		out.stop = true
+		return out
+	for line in Allies.act(world, func(tag): return _roll(world, tag), load("res://scripts/combat.gd")):
+		out.lines.append(line)
+		if line.contains("噛まれた") or line.contains("つかまれ"):
+			out.stop = true
+	sync(world)
+	if Walkers.count(world, place) <= 0:
+		w.encounter = {}
+		out.lines.append("あたりに、ほかの姿はない。")
+		out.ended = true
+		out.stop = true
+		return out
+	var made_room := bool(Dictionary(out.outcome).get("down", false)) or bool(Dictionary(out.outcome).get("kill", false))
+	var grab := {} if made_room else _grab(world, present)
+	if not grab.is_empty():
+		out.lines.append(str(grab.text))
+		out.bitten = bool(grab.bitten)
+		out.card = "bitten" if out.bitten else "grabbed"
+		out.stop = true
+		out.ended = out.bitten
+		return out
+	if close_count(world, 2.0) > close_before:
+		out.lines.append("別の一人が、すぐそばまで来ている。")
+		out.stop = true
+	return out
+
+## Fallen walkers get up after a few seconds; those with ruined legs crawl.
+static func _recover(world, secs: float) -> void:
+	for z in zombies(world):
+		if str(z.state) in ["downed", "blinded"]:
+			z.down_for = float(z.get("down_for", 4.0)) - secs
+			if float(z.down_for) <= 0.0:
+				z.state = "crawling" if int(z.hurt.legs) >= 2 else "standing"
+
+## The "how it landed" half of the last blow (the rest is its result).
+static var _last_land := ""
+
+## A blow that landed. Returns {line, outcome{hit, down, kill}}.
+static func _hit(world, z: Dictionary, aim: String, type: String = "") -> Dictionary:
+	if type.is_empty():
+		type = Weapons.held(world)
+	var spec := Weapons.spec(world, type)
+	var klass := str(spec.class)
+	var down := str(z.state) in ["downed", "crawling", "pinned"]
+	z.hurt[aim] = int(z.hurt.get(aim, 0)) + 1
+	var outcome := {"hit": true, "down": false, "kill": false}
+	var line := CombatText.land(world, klass, aim, Weapons.name_of(type))
+	_last_land = line
+	match aim:
+		"head":
+			var kill := int(spec.head) + (30 if down else 0) + 25 * (int(z.hurt.head) - 1)
+			if _roll(world, "head-kill") < kill:
+				_kill(world, z)
+				outcome.kill = true
+				outcome.down = true
+				line += CombatText.result(world, "kill_down" if down else ("kill_blade" if klass == "blade" else "kill"))
+				# A blade in a skull does not always come out.
+				if klass == "blade" and _roll(world, "stuck") < 30:
+					Weapons.state(world).stuck = type
+					line += "%sが骨に刺さったまま、抜けない。" % Weapons.name_of(type)
+				return {"line": line, "outcome": outcome}
+			if down:
+				return {"line": line + CombatText.result(world, "head_wound_down"), "outcome": outcome}
+			z.dist = float(z.dist) + 0.5
+			return {"line": line + CombatText.result(world, "head_wound"), "outcome": outcome}
+		"legs":
+			if str(z.state) == "standing" or str(z.state) == "blinded":
+				if _roll(world, "leg-down") < int(spec.legs) + 10 * (int(z.hurt.legs) - 1):
+					z.state = "downed"
+					z.down_for = 5.0
+					outcome.down = true
+					return {"line": line + CombatText.result(world, "cripple" if int(z.hurt.legs) >= 2 else "down"), "outcome": outcome}
+				return {"line": line + CombatText.result(world, "leg_hold"), "outcome": outcome}
+			return {"line": line + CombatText.result(world, "leg_hit_down"), "outcome": outcome}
+		"arms":
+			return {"line": line + CombatText.result(world, "arms_twice" if int(z.hurt.arms) >= 2 else "arms"), "outcome": outcome}
+		_:
+			z.dist = float(z.dist) + 1.0
+			if _roll(world, "torso-down") < 25 and str(z.state) == "standing":
+				z.state = "downed"
+				z.down_for = 3.0
+				outcome.down = true
+				return {"line": line + CombatText.result(world, "torso_sit"), "outcome": outcome}
+			return {"line": line + CombatText.result(world, "torso"), "outcome": outcome}
+
+## The extinguisher: a white cloud for a few seconds; it is then empty.
+static func _spray(world, out: Dictionary, present: Array, place: String, close_before: int) -> Dictionary:
+	var st := Weapons.state(world)
+	if not Weapons.owns(world, "extinguisher"):
+		out.lines.append("消火器は持っていない。（何もしていない）")
+		out.invalid = true
+		return out
+	for w in st.weapons:
+		if str(w.type) == "extinguisher":
+			st.weapons.erase(w)
+			break
+	out.seconds = 2.0
+	Walkers.make_noise(world, place, 60)
+	Walkers.ensure(world).encounter.noticed = true
+	var blinded := 0
+	var near := 0
+	for z in zombies(world):
+		if float(z.dist) <= 3.5:
+			near += 1
+			if str(z.state) == "standing":
+				z.state = "blinded"
+				z.down_for = 6.0
+				blinded += 1
+	var after := "相手の姿が、白い煙の中でよろめいている。" if blinded > 0 else ("倒れている相手には、あまり意味がなかった。" if near > 0 else "だが、届く所に相手はいなかった。")
+	out.lines.append("消火器のレバーを握りこんだ。白い粉が噴き出し、あたりが真っ白になる。" + after)
+	out.card = "extinguisher"
+	out.outcome = {"hit": false}
+	_recover(world, out.seconds)
+	tick(world, out.seconds)
+	return out
+
+## At arm's reach, the walker in front may get hold of someone: where it
+## grabs, what is worn there, and whether the teeth get through.
+static func _grab(world, present: Array) -> Dictionary:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	var z := front(world)
+	if z.is_empty() or not noticed(world) or float(z.dist) > REACH + 0.05:
+		return {}
+	var chance := 0
+	match str(z.state):
+		"standing": chance = 28 - 10 * int(z.hurt.arms)
+		"crawling": chance = 15
+		_: chance = 0
+	if chance <= 0 or _roll(world, "grab") >= chance:
+		return {}
+	# Stage 4: someone standing beside the player may be the one it gets
+	# hold of. For them it is a warning, not yet a bite (allies.gd).
+	var victim := Allies.pick_victim(world, _roll(world, "victim"))
+	if not victim.is_empty():
+		enc.grabbed = true
+		return {"text": Allies.grab(world, victim, str(z.id)), "bitten": false, "ended": false, "minutes": 0, "ally": victim}
+	var held: Dictionary = enc.duplicate(true)
+	var crawling := str(z.state) == "crawling"
+	var roll := _roll(world, "grab-part")
+	var part := "legs" if crawling and roll < 70 else ("arms" if roll < 60 else ("hands" if roll < 75 else ("torso" if roll < 88 else ("legs" if roll < 95 else "neck"))))
+	var n := maxi(1, close_count(world, 1.5))
+	var bite := 8 + 12 * (mini(n, 5) - 1)
+	if part == "neck":
+		bite *= 3
+	bite = bite * (100 - Weapons.protection(world, part)) / 100
+	var where := str(Weapons.PART_NAMES.get(part, "腕"))
+	# Someone beside the player grabs the walker too.
+	var helper := ""
+	for k in Allies.active(world):
+		if str(enc.allies[k].stance) == "fight" and str(enc.allies[k].held_by).is_empty() and Allies.courage(world, Allies.mate(world, k)) >= 40:
+			helper = str(Allies.mate(world, k).name)
+			bite /= 2
+			break
+	if _roll(world, "bite") < bite:
+		var r := Walkers._bite(world, held, "つかみかかられた。", part)
+		r.text = str(r.text).replace("腕に鋭い痛みが走った。", "%sに鋭い痛みが走った。" % where)
+		return r
+	# Not bitten: what the nails and the struggle did.
+	world.s.health = maxf(0.0, float(world.s.health) - 6.0)
+	var st := Weapons.state(world)
+	var armored := Weapons.protection(world, part) >= 40
+	var text := ""
+	if armored:
+		Weapons.wound(world, part, "bruise")
+		text = "つかみかかられた。%sに歯が当たったが、服の上からだった。痛みはあるが、皮膚は破れていない。" % where
+	elif n >= 3 and _roll(world, "pulled-down") < 25:
+		Weapons.wound(world, "torso", "bruise")
+		Weapons.wound(world, part, "cut")
+		text = "つかまれて、地面に引き倒された。必死に蹴り離して起き上がった。%sに引っかき傷、体じゅうが痛む。" % where
+	else:
+		Weapons.wound(world, part, "bleeding" if Weapons.protection(world, part) < 20 and _roll(world, "bleed") < 25 else "cut")
+		text = "つかみかかられた。爪が%sを裂いた。歯は届かなかった。振りほどいて距離をとった。" % where
+	if not helper.is_empty():
+		text += "%sが相手の肩をつかんで、引きはがすのを手伝ってくれた。" % helper
+	if part == "arms" and "magazine" in st.armor:
+		st.magazine_left = int(st.get("magazine_left", 3)) - 1
+		if int(st.magazine_left) <= 0:
+			st.armor.erase("magazine")
+			text += "腕の雑誌は、もうぼろぼろだ。"
+	w.encounter = held
+	held.grabbed = true
+	var again := front(world)
+	if not again.is_empty():
+		again.dist = float(again.dist) + 1.0
+	return {"text": text, "bitten": false, "ended": false, "minutes": 0}
+
+static func chips(world) -> Array:
+	var z := front(world)
+	var holding := Allies.held(world)
+	if not holding.is_empty():
+		return ["%sを助ける" % Allies.mate(world, str(holding[0])).name, "脚を払う", "逃げる"]
+	if not noticed(world):
+		return ["隠れる", "逃げる", "物を投げて気をそらす", "戦う", "様子を見る"]
+	if not z.is_empty() and str(z.state) in ["downed", "crawling", "pinned"] and float(z.dist) <= reach(world) + 2.6:
+		return ["頭を狙って振り下ろす", "逃げる", "下がる"]
+	if not z.is_empty() and float(z.dist) <= 1.3:
+		return ["突き飛ばす", "頭を狙う", "脚を払う", "逃げる"]
+	if not z.is_empty() and float(z.dist) <= 8.0:
+		return ["脚を払う", "頭を狙う", "下がる", "逃げる"]
+	return ["逃げる", "隠れる", "待ち構える", "物を投げて気をそらす"]
