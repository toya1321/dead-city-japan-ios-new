@@ -0,0 +1,46 @@
+extends SceneTree
+## Many one-on-one fights for a fresh character: how often each ends in a kill,
+## a bite, or a getaway (DCJ_WEAPON, DCJ_CMD, DCJ_COUNT, DCJ_N).
+const Main = preload("res://main.tscn")
+const Combat = preload("res://scripts/combat.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var kills := 0
+	var bites := 0
+	var other := 0
+	var beats := 0
+	var n := int(OS.get_environment("DCJ_N"))
+	for trial in n:
+		var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+		p.seed = 500 + trial
+		p.cohabitants = 0
+		g._start_new_game(p)
+		g._finish_intro()
+		g.local_model.enabled = false
+		var w = g.world
+		w.s.household_members = []
+		w.s.society = "emergency"
+		w.s.minute = 4 * 1440 + 2 * 60
+		if OS.get_environment("DCJ_WEAPON") != "":
+			w.s.combat = {"weapons": [{"type": OS.get_environment("DCJ_WEAPON"), "wear": 80}], "held": OS.get_environment("DCJ_WEAPON"), "found": {}, "armor": ["coat"], "magazine_left": 0, "wounds": [], "stuck": ""}
+		g.location = "商店通り"
+		g._sync_player_position()
+		var c := int(OS.get_environment("DCJ_COUNT"))
+		w.s.walkers.places["商店通り"] = c
+		w.s.walkers.encounter = {"place": "商店通り", "count": c, "near": false, "since": int(w.s.minute), "from": "屋外"}
+		Combat.sync(w)
+		var k0 := int(w.s.walkers.get("killed", 0))
+		for i in 25:
+			if not Combat.active(w) or bool(w.s.get("bitten", false)): break
+			beats += 1
+			await g._on_command(OS.get_environment("DCJ_CMD"))
+			if trial == 0 and i < 3: print("LOG ", g.log_entries[-1].replace("\n", " / "), " active=", Combat.active(w))
+		if bool(w.s.get("bitten", false)): bites += 1
+		elif int(w.s.walkers.get("killed", 0)) - k0 >= c: kills += 1
+		else: other += 1
+	print("RESULT weapon=%s count=%d cmd=%s  kills=%d bites=%d other=%d  beats/fight=%.1f" % [OS.get_environment("DCJ_WEAPON"), int(OS.get_environment("DCJ_COUNT")), OS.get_environment("DCJ_CMD"), kills, bites, other, float(beats) / n])
+	quit()
