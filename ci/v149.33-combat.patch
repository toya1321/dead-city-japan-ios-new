new file mode 100644
index 0000000..5610b7f
--- /dev/null
+++ b/tests/test_combat149_33.gd
@@ -0,0 +1,130 @@
+extends SceneTree
+## v149.33 combat stage 1: walkers as bodies (distance, state, kind), the
+## seconds an action takes, what the player can see, and save/load.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 9
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	# An old-style encounter (no bodies) gets them from the count.
+	w.s.walkers.places["屋外"] = 3
+	w.s.walkers.encounter = {"place": "屋外", "count": 3, "near": false, "since": int(w.s.minute), "from": "建物前"}
+	Combat.sync(w)
+	var list: Array = Combat.zombies(w)
+	check(list.size() == 3, "three walkers become three bodies")
+	check(list.all(func(z): return float(z.dist) >= 5.0 and str(z.state) == "standing" and z.hurt.has("head") and str(z.kind) in ["fresh", "old"]), "unnoticed walkers stand at a distance, unhurt")
+	var ids: Array = list.map(func(z): return str(z.id))
+	Combat.sync(w)
+	check(Combat.zombies(w).map(func(z): return str(z.id)) == ids, "syncing again keeps the same bodies")
+	# Not noticed: they do not close in.
+	var before := float(Combat.zombies(w)[0].dist)
+	Combat.tick(w, 4.0)
+	check(is_equal_approx(float(Combat.zombies(w)[0].dist), before), "walkers that have not noticed do not approach")
+	# Noticed: the front one is close and they approach at their own speed.
+	w.s.walkers.encounter = {"place": "屋外", "count": 3, "near": true, "since": int(w.s.minute), "from": "建物前"}
+	Combat.sync(w)
+	check(float(Combat.zombies(w)[0].dist) <= 2.0, "once noticed, the front one has closed in")
+	var far: Dictionary = Combat.zombies(w)[2]
+	var far_before := float(far.dist)
+	Combat.tick(w, 2.0)
+	var speed: float = Combat.SPEED[str(far.kind)]
+	check(is_equal_approx(float(far.dist), maxf(Combat.REACH, far_before - speed * 2.0)), "a noticed walker moves its speed × the seconds")
+	check(float(Combat.zombies(w)[0].dist) >= Combat.REACH, "no walker comes nearer than arm's reach on its own")
+	# A kill removes the one in front.
+	var front_id := str(Combat.zombies(w)[0].id)
+	w.s.walkers.places["屋外"] = 2
+	Combat.sync(w)
+	check(Combat.zombies(w).size() == 2 and not Combat.zombies(w).any(func(z): return str(z.id) == front_id), "the walker killed is the one in front, and it is not counted twice")
+	# Seconds depend on the body.
+	w.s.fatigue = 0.0
+	w.s.injuries = 0
+	var fresh_secs := Combat.seconds(w, "flee")
+	w.s.fatigue = 90.0
+	w.s.injuries = 2
+	check(Combat.seconds(w, "flee") > fresh_secs, "a tired, hurt body takes longer")
+	w.s.fatigue = 0.0
+	w.s.injuries = 0
+	# What the player sees: by day, a count and a distance; at night, guesses.
+	w.s.minute = 2 * 60
+	var day_lines: Array = Combat.status_lines(w)
+	check(str(day_lines).contains("感染者：") and str(day_lines).contains("m") and str(day_lines).contains("体："), "by day: how many (a glance) and how far")
+	w.s.minute = 13 * 60
+	w.s.walkers.places["屋外"] = 2
+	var night_lines: Array = Combat.status_lines(w)
+	check(str(night_lines).contains("暗くて"), "at night: numbers and distances are guesses")
+	w.s.minute = 2 * 60
+	# Playing an action through the game moves the clock and the walkers.
+	g.location = "屋外"
+	g._sync_player_position()
+	var clock := float(w.s.walkers.encounter.get("clock", 0.0))
+	await g._on_command("様子を見る")
+	check(not Combat.active(w) or float(w.s.walkers.encounter.get("clock", 0.0)) > clock, "an action spends seconds of the encounter clock")
+	g._refresh()
+	check(g.combat_panel.visible == Combat.active(w), "the panel shows only during an encounter")
+	# Save and load keep the bodies.
+	if Combat.active(w):
+		var saved_ids: Array = Combat.zombies(w).map(func(z): return str(z.id))
+		var saved_dist := float(Combat.zombies(w)[0].dist)
+		g._save()
+		w.s.walkers.encounter = {}
+		g._load()
+		w = g.world
+		check(Combat.active(w) and Combat.zombies(w).map(func(z): return str(z.id)) == saved_ids and is_equal_approx(float(Combat.zombies(w)[0].dist), saved_dist), "save and load keep each walker and its distance")
+	else:
+		check(true, "save and load keep each walker (encounter already over)")
+	# The picture follows what the player can see.
+	w.s.minute = 2 * 60
+	w.s.walkers.places["屋外"] = 1
+	w.s.walkers.encounter = {"place": "屋外", "count": 1, "near": false, "since": int(w.s.minute), "from": "建物前"}
+	check(Combat.picture_name(w) == "fight_far", "one far away, unnoticed: fight_far")
+	w.s.walkers.places["屋外"] = 3
+	check(Combat.picture_name(w) == "fight_far_many", "several far away: fight_far_many")
+	w.s.walkers.encounter = {"place": "屋外", "count": 3, "near": true, "since": int(w.s.minute), "from": "建物前"}
+	Combat.sync(w)
+	check(Combat.picture_name(w) == "fight_many_close", "noticed, close, more behind: fight_many_close")
+	w.s.walkers.places["屋外"] = 1
+	w.s.walkers.encounter = {"place": "屋外", "count": 1, "near": true, "since": int(w.s.minute), "from": "建物前"}
+	Combat.sync(w)
+	check(Combat.picture_name(w) == "fight_close", "one close: fight_close")
+	Combat.zombies(w)[0].state = "crawling"
+	check(Combat.picture_name(w) == "fight_downed", "down and crawling: fight_downed")
+	Combat.zombies(w)[0].state = "standing"
+	Combat.zombies(w)[0].dist = 6.0
+	check(Combat.picture_name(w) == "fight_noticed", "noticed but still a way off: fight_noticed")
+	w.s.walkers.places["屋外"] = 14
+	check(Combat.picture_name(w) == "fight_horde", "ten or more: fight_horde")
+	w.s.walkers.places["屋外"] = 1
+	g.location = "屋外"
+	g._refresh()
+	check(g.picture.texture != null and str(g.picture.texture.resource_path).begins_with("res://assets/combat/"), "the scene picture shows the fight")
+	w.s.minute = 13 * 60
+	check(Combat.picture_path(w).ends_with(Combat.picture_name(w) + ".jpg"), "no night picture yet: the day one stands in")
+	w.s.minute = 2 * 60
+	# The encounter ends: no panel.
+	w.s.walkers.encounter = {}
+	g._refresh()
+	check(not g.combat_panel.visible, "no encounter, no panel")
+	print("v149.33 combat checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
