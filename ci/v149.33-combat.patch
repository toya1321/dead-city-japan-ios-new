diff --git a/tests/test_combat2_149_33.gd b/tests/test_combat2_149_33.gd
new file mode 100644
index 0000000..7d12a1a
--- /dev/null
+++ b/tests/test_combat2_149_33.gd
@@ -0,0 +1,174 @@
+extends SceneTree
+## v149.33 combat stage 2: free-text orders read into steps, the rules decide
+## hits by part, the walkers move during each step, a grab stops the plan,
+## and the local model is never asked when the rules can read the order.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+const Intent = preload("res://scripts/combat_intent.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func steps(text: String) -> Array:
+	return Intent.parse(text).map(func(s): return "%s:%s" % [s.act, s.part])
+
+func fight(w, count: int, near: bool) -> void:
+	w.s.walkers.places["屋外"] = count
+	w.s.walkers.encounter = {"place": "屋外", "count": count, "near": near, "since": int(w.s.minute), "from": "建物前"}
+	Combat.sync(w)
+
+class FakeModel:
+	extends RefCounted
+	var queue: Array = []
+	var requests := 0
+	var instructions := ""
+	func model_available() -> bool:
+		return true
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, text: String, _input: String) -> bool:
+		requests += 1
+		instructions = text
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		pass
+
+func run() -> void:
+	# Reading orders.
+	check(steps("バットで感染者の膝を狙う") == ["attack:legs"], "膝を狙う → an attack on the legs")
+	check(steps("感染者を突き飛ばして逃げる") == ["push:", "flee:"], "突き飛ばして逃げる → push, then flee")
+	check(steps("脚を払って、倒れたら頭を叩く") == ["attack:legs", "attack:head"], "脚を払って、倒れたら頭を叩く → legs, then head")
+	check(steps("落ち着いて頭を狙って振り下ろす") == ["attack:head"], "one swing said two ways is one swing")
+	check(steps("距離を保ちながら後退する") == ["retreat:"], "後退する → step back")
+	check(steps("ドアを閉めて侵入を防ぐ") == ["close_door:"], "ドアを閉める → the door")
+	check(steps("棚を倒して通路を塞ぐ") == ["obstacle:"], "棚を倒す is not an attack")
+	check(steps("ニュースを見る").is_empty(), "an order with nothing to do in a fight reads as nothing")
+	check(steps("戦う") == ["attack:"], "戦う → an attack, no part named")
+
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 21
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	var fake := FakeModel.new()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.minute = 2 * 60
+	g.location = "屋外"
+	g._sync_player_position()
+
+	# Too far to reach: nothing happens and no time passes.
+	fight(w, 1, false)
+	Combat.zombies(w)[0].dist = 9.0
+	var clock := float(w.s.walkers.encounter.get("clock", 0.0))
+	var r: Dictionary = Combat.act(w, {"act": "attack", "part": "head"})
+	check(bool(r.invalid) and float(r.seconds) == 0.0 and float(w.s.walkers.encounter.get("clock", 0.0)) == clock, "a swing at someone nine metres away is not made")
+
+	# Odds in words: the head of a standing walker is hard, of a fallen one easier.
+	fight(w, 1, true)
+	var z: Dictionary = Combat.front(w)
+	var standing_head := Combat.hit_chance(w, "head", z)
+	z.state = "downed"
+	var down_head := Combat.hit_chance(w, "head", z)
+	z.state = "standing"
+	check(down_head > standing_head + 20, "a fallen walker's head is much easier to hit")
+	check(Combat.hit_chance(w, "legs", z) > standing_head, "legs are easier than the head")
+	w.s.minute = 13 * 60
+	check(Combat.hit_chance(w, "head", z) < standing_head, "darkness makes it harder")
+	w.s.minute = 2 * 60
+	check(Combat.target_words(w).contains("頭：") and not Combat.target_words(w).contains("%"), "the panel shows odds as words, never numbers")
+
+	# A blow to the legs brings it down; it gets up again after a few seconds.
+	w.s.combat = {"weapons": [{"type": "bat", "wear": 80}], "held": "bat", "found": {}, "armor": [], "magazine_left": 0, "wounds": [], "stuck": ""}
+	var landed: Dictionary = {}
+	for i in 6:
+		z.state = "standing"
+		z.hurt.legs = 0
+		landed = Combat._hit(w, z, "legs")
+		if str(z.state) == "downed":
+			break
+	check(str(z.state) == "downed" and bool(landed.outcome.down), "a bat to the legs brings it down")
+	Combat._recover(w, 6.0)
+	check(str(z.state) == "standing", "a walker with one blow to the legs gets up again")
+	for i in 6:
+		z.state = "standing"
+		z.hurt.legs = 1
+		Combat._hit(w, z, "legs")
+		if str(z.state) == "downed":
+			break
+	Combat._recover(w, 6.0)
+	check(str(z.state) == "crawling", "after two blows to the legs it can only crawl")
+
+	# A kill removes exactly that walker, once.
+	var killed := int(w.s.walkers.get("killed", 0))
+	var before_count := Walkers.count(w, "屋外")
+	var zid := str(z.id)
+	Combat._kill(w, z)
+	Combat.sync(w)
+	check(int(w.s.walkers.killed) == killed + 1 and Walkers.count(w, "屋外") == before_count - 1 and not Combat.zombies(w).any(func(x): return str(x.id) == zid), "a kill is counted once and that walker is gone")
+
+	# The others move while you act.
+	fight(w, 3, true)
+	var back: Dictionary = Combat.zombies(w)[2]
+	var back_before := float(back.dist)
+	Combat.act(w, {"act": "wait", "part": ""})
+	check(float(back.dist) < back_before, "while you wait, the ones behind come closer")
+
+	# Retreating opens the gap more than they close it.
+	fight(w, 1, true)
+	var gap_before := float(Combat.front(w).dist)
+	Combat.act(w, {"act": "retreat", "part": ""})
+	check(float(Combat.front(w).dist) > gap_before, "stepping back opens the gap")
+
+	# No door to close in the street.
+	check(bool(Combat.act(w, {"act": "close_door", "part": ""}).invalid), "no door in the street")
+
+	# The same state and order give the same result (no hidden luck).
+	fight(w, 2, true)
+	var saved: Dictionary = w.s.duplicate(true)
+	var first: Dictionary = Combat.act(w, {"act": "attack", "part": "legs"})
+	w.s = saved.duplicate(true)
+	var second: Dictionary = Combat.act(w, {"act": "attack", "part": "legs"})
+	check(str(first.lines) == str(second.lines), "the same moment and order give the same result")
+
+	# Played through the game: the model is not asked when the rules can read
+	# the order, a plan stops when something changes, and the fight ends.
+	g.local_model.enabled = true
+	g.local_model.backend = fake
+	fight(w, 2, true)
+	var asked := fake.requests
+	for i in 30:
+		if not Combat.active(w) or float(w.s.health) <= 0:
+			break
+		await g._on_command("脚を払って、倒れたら頭を叩く")
+	check(fake.requests == asked, "the model is never asked when the rules read the order")
+	check(not Combat.active(w), "the fight ends one way or another")
+	check(int(w.s.walkers.noise.get("屋外", 0)) > 0, "fighting is loud")
+
+	# Not fighting works too.
+	w.s.health = 100.0
+	fight(w, 2, false)
+	for i in 6:
+		if not Combat.active(w):
+			break
+		await g._on_command("隠れる")
+	check(not Combat.active(w) or float(w.s.health) > 0, "hiding is still a way through")
+	print("v149.33 combat stage 2 checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
