+extends RefCounted
+## v149.33 (combat stage 7): holding the house. When the dead press on the
+## front door, the player can take them on from inside: stab through the
+## gap, hold the door, nail on another board, drop something heavy from the
+## upstairs window, fall back up the stairs, or slip out the back. They
+## batter the door (walkers.gd's boards and door_hp) and, when many, a
+## window; noise draws more of those really nearby; if a way in breaks they
+## come in one at a time through the narrow hall.
+##
+## The encounter carries `siege: true`, place "建物前". Each walker has a
+## `pos`: door / window (outside, not in reach) or inside (in the house,
+## `dist` from the player as in any fight).
+##   encounter.house = {window_hp, drops, upstairs, held, won}
+
+const Walkers = preload("res://scripts/walkers.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const Skills = preload("res://scripts/skills.gd")
+const Chronicle = preload("res://scripts/chronicle.gd")
+const Mood = preload("res://scripts/mood.gd")
+const Remains = preload("res://scripts/remains.gd")
+
+const OUTSIDE := "建物前"
+const INSIDE := "玄関"
+## Damage each walker does per second to what it is pressing on.
+const DOOR_PUSH := 0.35
+const WINDOW_PUSH := 0.25
+const WINDOW_HP := 60.0
+const DROPS := ["植木鉢", "鋳物の鍋", "古いブラウン管テレビ"]
+
+static func active(world) -> bool:
+	return bool(Walkers.ensure(world).encounter.get("siege", false))
+
+static func porch(world) -> int:
+	return Walkers.count(world, OUTSIDE)
+
+## The player takes on those at the door (from inside the house).
+static func begin(world) -> void:
+	var w := Walkers.ensure(world)
+	w.encounter = {"place": OUTSIDE, "count": porch(world), "near": true, "noticed": true, "siege": true, "since": int(world.s.minute), "from": "",
+		"house": {"window_hp": WINDOW_HP + (40.0 if bool(world.s.get("blackout", false)) else 0.0), "drops": 0, "upstairs": false, "held": false}}
+	sync(world)
+
+## Bodies at the door and window outside, and any that got in, inside.
+static func sync(world) -> void:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	if not enc.get("zombies") is Array:
+		enc.zombies = []
+	var list: Array = enc.zombies
+	var outside := mini(porch(world), 8)
+	var inside := mini(Walkers.count(world, INSIDE), 6)
+	var out_list: Array = list.filter(func(z): return str(z.get("pos", "door")) != "inside")
+	var in_list: Array = list.filter(func(z): return str(z.get("pos", "")) == "inside")
+	while out_list.size() > outside:
+		list.erase(out_list.pop_back())
+	while in_list.size() > inside:
+		list.erase(in_list.pop_front())
+	var serial := int(enc.get("serial", 0))
+	while out_list.size() < outside or in_list.size() < inside:
+		serial += 1
+		var going_in := in_list.size() < inside
+		var z := {"id": "s%d_%d" % [int(enc.get("since", 0)), serial], "dist": 2.5 if going_in else 99.0, "state": "standing",
+			"hurt": {"head": 0, "arms": 0, "legs": 0, "torso": 0}, "kind": "old" if world.draw(int(world.s.minute), serial, "s-kind", 100) >= 35 else "fresh",
+			"pos": "inside" if going_in else "door", "life": Remains.life_for(world, OUTSIDE, serial)}
+		list.append(z)
+		if going_in:
+			in_list.append(z)
+		else:
+			out_list.append(z)
+	enc.serial = serial
+	# The crowd spreads: past four at the door, the rest try a window.
+	var at_door := 0
+	for z in list:
+		if str(z.pos) in ["door", "window"]:
+			at_door += 1
+			z.pos = "door" if at_door <= 4 else "window"
+	list.sort_custom(func(a, b): return float(a.dist) < float(b.dist))
+	if not enc.has("xp_start"):
+		var cst := Weapons.state(world)
+		enc.xp_start = Dictionary(cst.skills).duplicate()
+		enc.tech_start = Dictionary(cst.tech).duplicate()
+
+static func at(world, pos: String) -> Array:
+	return Walkers.ensure(world).encounter.get("zombies", []).filter(func(z): return str(z.get("pos", "")) == pos)
+
+static func house(world) -> Dictionary:
+	return Walkers.ensure(world).encounter.get("house", {})
+
+static func door_words(world) -> String:
+	if bool(world.s.get("door_broken", false)):
+		return "玄関の扉は破られている"
+	var hp := Walkers.door_hp(world)
+	var boards := int(world.s.barricade)
+	var state := "まだしっかりしている" if hp > 75.0 else ("きしんでいる" if hp > 50.0 else ("大きく揺れている" if hp > 20.0 else "今にも破れそうだ"))
+	return "玄関の扉：%s%s" % [state, "（補強板%d段）" % boards if boards > 0 else ""]
+
+static func status_lines(world) -> Array:
+	var lines: Array = []
+	var door := at(world, "door").size()
+	var window := at(world, "window").size()
+	var inside := at(world, "inside").size()
+	lines.append("籠城：外に%d人（扉に%d%s）%s" % [door + window, door, "・窓に%d" % window if window > 0 else "", "　家の中に%d人！" % inside if inside > 0 else ""])
+	lines.append(door_words(world) + (" ・ 窓：%s" % ("持ちこたえている" if float(house(world).get("window_hp", WINDOW_HP)) > 25.0 else "割れかけている") if window > 0 else ""))
+	lines.append("あなたは%s ・ 手持ち：%s" % ["二階の階段の上" if bool(house(world).get("upstairs", false)) else "玄関の内側", Weapons.name_of(Weapons.held(world))])
+	return lines
+
+## One step of a siege. Returns the same shape as Combat.act.
+static func act(world, step: Dictionary, present: Array, combat) -> Dictionary:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	var h := house(world)
+	sync(world)
+	var out := {"lines": [], "seconds": 0.0, "card": "", "ended": false, "bitten": false, "stop": false, "invalid": false, "kind": "", "minutes": 0, "weapon": "", "outcome": {}, "part": "", "result_text": ""}
+	var kind := str(step.get("act", ""))
+	var text := str(step.get("text", ""))
+	var door_list := at(world, "door")
+	var inside := at(world, "inside")
+	h.held = false
+	# The siege's own moves.
+	if _has(text, ["扉越し", "ドア越し", "隙間から", "隙間に", "郵便受け", "のぞき穴"]) and kind in ["attack", ""]:
+		kind = "stab_gap"
+	elif _has(text, ["落と", "落下"]) and _has(text, ["窓", "上から", "二階", "ベランダ"]):
+		kind = "drop"
+	elif kind == "close_door" or _has(text, ["扉を押さえ", "ドアを押さえ", "扉を支え", "ドアを支え", "背中で押さえ"]):
+		kind = "hold"
+	elif _has(text, ["板を打ち", "打ちつけ", "補強する", "補強を足"]):
+		kind = "board"
+	elif _has(text, ["二階へ", "二階に", "階段を上", "階段の上", "上の階"]):
+		kind = "upstairs"
+	elif kind == "flee" or _has(text, ["裏口", "勝手口", "ベランダから", "避難はしご"]):
+		kind = "escape"
+	match kind:
+		"stab_gap":
+			if bool(world.s.get("door_broken", false)):
+				out.lines.append("扉はもう破られている。隙間どころではない。（何もしていない）")
+				out.invalid = true
+				return out
+			if door_list.is_empty():
+				out.lines.append("扉の向こうに、相手はいない。（何もしていない）")
+				out.invalid = true
+				return out
+			var type := Weapons.held(world)
+			if not str(Weapons.spec(world, type).class) in ["blade", "spear"]:
+				out.lines.append("隙間から突けるのは、包丁や槍のような細い刃物だけだ。（何もしていない）")
+				out.invalid = true
+				return out
+			out.seconds = combat.step_seconds(world, "attack")
+			var z: Dictionary = door_list[0]
+			# Pressed against the door, the head is there to be found.
+			var probe := z.duplicate(true)
+			probe.state = "pinned"
+			var chance: int = combat.hit_chance(world, "head", probe, type) - 22
+			Walkers.make_noise(world, OUTSIDE, 20)
+			if combat._roll(world, "gap") < chance:
+				var kill: bool = combat._roll(world, "gap-kill") < int(Weapons.spec(world, type).head)
+				Skills.gain(world, Skills.skill_for_class(str(Weapons.spec(world, type).class)), 8.0 + (6.0 if kill else 0.0), chance, true, "gap|%s" % str(z.id))
+				if kill:
+					combat._kill(world, z)
+					out.lines.append("扉の隙間から、%sを突き出した。手応えがあった。向こう側で、何かが崩れ落ちる音がした。" % Weapons.name_of(type))
+				else:
+					out.lines.append("扉の隙間から、%sを突き出した。浅い。扉を叩く音が、かえって激しくなった。" % Weapons.name_of(type))
+				Weapons.wear(world, type, 1)
+				out.card = "siege_stab"
+			else:
+				Skills.gain(world, Skills.skill_for_class(str(Weapons.spec(world, type).class)), 4.0, chance, true, "gap|%s" % str(z.id))
+				out.lines.append("隙間から突いたが、手応えがない。揺れる扉の向こうで、うめき声が続いている。")
+				out.card = "siege_stab"
+		"drop":
+			if bool(h.get("upstairs", false)) or str(world.s.profile.housing) == "一戸建て":
+				var n := int(h.get("drops", 0))
+				if n >= DROPS.size():
+					out.lines.append("落とせるような重い物は、もう二階に残っていない。（何もしていない）")
+					out.invalid = true
+					return out
+				if door_list.is_empty() and at(world, "window").is_empty():
+					out.lines.append("真下には、もう誰もいない。（何もしていない）")
+					out.invalid = true
+					return out
+				h.drops = n + 1
+				out.seconds = 8.0
+				Walkers.make_noise(world, OUTSIDE, 60)
+				var targets := door_list if not door_list.is_empty() else at(world, "window")
+				var z: Dictionary = targets[0]
+				var what := str(DROPS[n])
+				if combat._roll(world, "drop") < 55:
+					if combat._roll(world, "drop-kill") < 65:
+						combat._kill(world, z)
+						out.lines.append("二階の窓から、%sを真下に落とした。鈍い音。玄関の前の一人が、それきり動かなくなった。" % what)
+					else:
+						z.state = "downed"
+						out.lines.append("二階の窓から、%sを落とした。肩に当たり、相手は玄関の前に倒れこんだ。" % what)
+				else:
+					out.lines.append("二階の窓から、%sを落とした。わずかに外れ、地面で砕ける大きな音が響いた。" % what)
+				out.card = "siege_drop"
+			else:
+				out.lines.append("ここには、上から物を落とせる窓がない。（何もしていない）")
+				out.invalid = true
+				return out
+		"hold":
+			if bool(world.s.get("door_broken", false)):
+				out.lines.append("扉はもう、押さえて何とかなる状態ではない。（何もしていない）")
+				out.invalid = true
+				return out
+			out.seconds = 4.0
+			h.held = true
+			Skills.gain(world, "agility", 3.0, 50, true, "hold")
+			out.lines.append("扉に背中を押しつけ、足を踏ん張った。叩かれるたびに、衝撃が体に響く。")
+			out.card = "siege_hold"
+		"board":
+			if bool(world.s.get("door_broken", false)):
+				out.lines.append("扉が破られていて、板を打ちつける場所がない。（何もしていない）")
+				out.invalid = true
+				return out
+			if int(world.s.inventory.get("wood", 0)) < 1:
+				out.lines.append("打ちつける板（木材）がない。（何もしていない）")
+				out.invalid = true
+				return out
+			world.s.inventory.wood = int(world.s.inventory.wood) - 1
+			world.s.barricade = int(world.s.barricade) + 1
+			world.s.board_damage = 0.0
+			out.seconds = 12.0
+			Walkers.make_noise(world, OUTSIDE, 60)
+			out.lines.append("揺れる扉に板を当て、震える手で釘を打ちこんだ。補強板が%d段になった。金づちの音が、外にも響いている。" % int(world.s.barricade))
+		"upstairs":
+			if str(world.s.profile.housing) != "一戸建て":
+				out.lines.append("この部屋に、上の階はない。（何もしていない）")
+				out.invalid = true
+				return out
+			h.upstairs = true
+			out.seconds = 4.0
+			for z in inside:
+				z.dist = float(z.dist) + 4.0
+			out.lines.append("階段を駆け上がり、二階の踊り場で振り返った。上がってくる相手を、上から迎え撃てる。")
+		"wait", "look", "hide":
+			if not inside.is_empty() and kind != "look":
+				return {}
+			out.seconds = 3.0
+			out.lines.append("息を殺して、扉の向こうの気配をうかがった。" if inside.is_empty() else "相手の動きをうかがった。")
+		"escape":
+			out.seconds = 6.0
+			w.encounter = {}
+			out.ended = true
+			out.kind = "escape"
+			if bool(h.get("upstairs", false)):
+				out.lines.append("二階の窓から屋根に出て、雨どいを伝って裏の地面に降りた。家の中から、うめき声が聞こえる。")
+			elif not inside.is_empty():
+				out.lines.append("台所の勝手口から飛び出した。家の中に、うめき声が残っている。")
+			else:
+				out.lines.append("裏口からそっと抜け出した。背後で、扉を叩く音がまだ続いている。")
+			return out
+		_:
+			# Anything else is an ordinary fight with whoever is inside.
+			if inside.is_empty():
+				out.lines.append("相手は扉の向こうだ。扉越しに刺すか、扉を押さえるか、二階の窓から物を落とすか、板を打ちつけるか、裏口から逃げることができる。（何もしていない）")
+				out.invalid = true
+				return out
+			return {}
+	_pass(world, out, present, combat)
+	return out
+
+## The seconds pass for the house: the door and the window take the blows,
+## noise draws in those really nearby, a broken way lets them in.
+static func _pass(world, out: Dictionary, present: Array, combat) -> void:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	if enc.is_empty():
+		return
+	var h := house(world)
+	var secs := float(out.seconds)
+	var holders := 1 if bool(h.get("held", false)) else 0
+	# Housemates: the timid hold the door, the brave stab through the gap.
+	for key in enc.get("allies", {}):
+		var a: Dictionary = enc.allies[key]
+		var m: Dictionary = world.s.household_members[int(key)] if int(key) < world.s.household_members.size() else {}
+		if m.is_empty() or str(a.get("stance", "")) in ["gone", "hide"]:
+			continue
+		if str(a.stance) == "fight" and not at(world, "door").is_empty() and not bool(world.s.get("door_broken", false)):
+			var z: Dictionary = at(world, "door")[0]
+			if combat._roll(world, "ally-gap-" + str(key)) < 20 + int(load("res://scripts/allies.gd").skill(world, m)) / 3:
+				combat._kill(world, z)
+				out.lines.append("%sが、扉の隙間から棒を突き出した。向こうで、一人が崩れ落ちた。" % m.name)
+		else:
+			holders += 1
+	var door_n := at(world, "door").size()
+	var window_n := at(world, "window").size()
+	if door_n > 0 and not bool(world.s.get("door_broken", false)):
+		var push := DOOR_PUSH * door_n * secs * (1.0 if holders == 0 else (0.4 if holders == 1 else 0.25))
+		var note := Walkers.batter_door(world, push)
+		if not note.is_empty():
+			out.lines.append(note.trim_prefix("【危険】").trim_prefix("【警告】"))
+	if window_n > 0:
+		h.window_hp = float(h.get("window_hp", WINDOW_HP)) - WINDOW_PUSH * window_n * secs
+		if float(h.window_hp) <= 0.0:
+			for z in at(world, "window"):
+				z.pos = "inside"
+				z.dist = 3.0 if not bool(h.get("upstairs", false)) else 6.0
+				Walkers._add(world, OUTSIDE, -1)
+				Walkers._add(world, INSIDE, 1)
+			out.lines.append("居間の窓が割れる音がした。誰かが、家の中に入ってきた！")
+			out.stop = true
+	if bool(world.s.get("door_broken", false)):
+		var came := 0
+		for z in at(world, "door"):
+			if came >= 2:
+				break
+			z.pos = "inside"
+			z.dist = 2.5 if not bool(h.get("upstairs", false)) else 6.0
+			Walkers._add(world, OUTSIDE, -1)
+			Walkers._add(world, INSIDE, 1)
+			came += 1
+		if came > 0:
+			out.lines.append("破れた扉から、%d人が玄関になだれ込んできた。狭い廊下では、一人ずつしか来られない。" % came)
+			out.stop = true
+	# Noise draws only those really nearby (the street outside), one at a time.
+	if int(w.noise.get(OUTSIDE, -1)) >= int(world.s.minute) and Walkers.count(world, "屋外") > 0 and combat._roll(world, "siege-more") < int(5.0 * secs):
+		Walkers._add(world, "屋外", -1)
+		Walkers._add(world, OUTSIDE, 1)
+		out.lines.append("物音を聞きつけて、通りからもう一人、家の前に来た。")
+	# Those inside come on through the hall (the stairs, if the player is up).
+	var tick_list: Array = [] if bool(out.get("no_tick", false)) else at(world, "inside")
+	for z in tick_list:
+		var speed := 0.0 if str(z.state) != "standing" else float(combat.SPEED.get(str(z.kind), 0.8)) * (0.5 if bool(h.get("upstairs", false)) else 1.0)
+		z.dist = maxf(combat.REACH, float(z.dist) - speed * secs)
+	sync(world)
+	combat.queue_up(world)
+	if porch(world) <= 0 and Walkers.count(world, INSIDE) <= 0:
+		won(world, out)
+
+static func won(world, out: Dictionary) -> void:
+	var st := Weapons.state(world)
+	st.sieges_won = int(st.get("sieges_won", 0)) + 1
+	Walkers.ensure(world).encounter = {}
+	Walkers.ensure(world).erase("knocking")
+	Mood.everyone(world, 8.0)
+	Chronicle.note(world, "家に押し寄せた感染者を、家の中から退けた。", "siege")
+	out.lines.append("扉を叩く音が、やんだ。家の前は、静かになった。……守りきった。")
+	out.ended = true
+	out.stop = true
+
+static func chips(world) -> Array:
+	var out: Array = []
+	if not at(world, "inside").is_empty():
+		return ["頭を狙う", "脚を払う", "二階へ上がる", "裏口から逃げる"]
+	if not bool(world.s.get("door_broken", false)):
+		if str(Weapons.spec(world).class) in ["blade", "spear"]:
+			out.append("扉越しに刺す")
+		out.append("扉を押さえる")
+		if int(world.s.inventory.get("wood", 0)) > 0:
+			out.append("板を打ちつける")
+	if str(world.s.profile.housing) == "一戸建て" and int(house(world).get("drops", 0)) < DROPS.size():
+		out.append("二階の窓から物を落とす")
+	out.append("裏口から逃げる")
+	return out
+
+static func _has(text: String, words: Array) -> bool:
+	for word in words:
+		if text.contains(word):
+			return true
+	return false
