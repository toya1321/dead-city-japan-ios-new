@@ -0,0 +1,66 @@
+extends RefCounted
+## v149.33 (combat stage 6): how safe a place is right now, from what is
+## actually there — the dead here and next door (they drift), recent noise
+## (it draws them), people living nearby (they make noise), and what blocks
+## the way (fallen shelves, a fortified base). Clearing a street makes it
+## safer only as long as nothing drifts back in: there is no "safe for N
+## days" switch.
+
+const Walkers = preload("res://scripts/walkers.gd")
+const Navigation = preload("res://scripts/navigation.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+
+static func blocked(world, place: String) -> bool:
+	return int(Walkers.ensure(world).get("blocks", {}).get(place, -1)) > int(world.s.minute)
+
+static func block(world, place: String, days: int = 3) -> void:
+	var w := Walkers.ensure(world)
+	if not w.get("blocks") is Dictionary:
+		w.blocks = {}
+	w.blocks[place] = int(world.s.minute) + days * 1440
+
+static func fortified(world, place: String) -> bool:
+	var sites: Dictionary = world.s.get("district", {}).get("sites", {})
+	return sites.has(place) and int(sites[place].get("level", 0)) >= 2
+
+static func people_at(world, place: String) -> int:
+	if place == "避難所":
+		return 0
+	return Survivors.here(world, place).size() if world.s.has("survivors") else 0
+
+## {score 0-100, words, reasons} for a place.
+static func assess(world, place: String) -> Dictionary:
+	var w := Walkers.ensure(world)
+	var minute := int(world.s.minute)
+	var here := Walkers.count(world, place)
+	var around := 0
+	for next in Navigation.graph(str(world.s.profile.housing)).get(place, []):
+		if next in Walkers.OUTDOOR or next in Walkers.BUILDINGS:
+			around += Walkers.count(world, next)
+	var noisy := int(w.noise.get(place, -1)) >= minute
+	var score := 100 - 15 * mini(here, 6) - 4 * mini(around, 10) - (15 if noisy else 0) - 3 * mini(people_at(world, place), 4)
+	var reasons: Array = []
+	if here > 0:
+		reasons.append("すぐ近くに感染者がいる")
+	if around >= 3:
+		reasons.append("隣の通りから流れてくるかもしれない")
+	elif around > 0:
+		reasons.append("近くの通りにも気配がある")
+	if noisy:
+		reasons.append("さっきの物音が、まだ周りを呼んでいる")
+	if blocked(world, place):
+		score += 10
+		reasons.append("倒した棚が、通り道をふさいでいる")
+	if fortified(world, place):
+		score += 15
+		reasons.append("補強した拠点がある")
+	score = clampi(score, 0, 100)
+	# Nothing that is drawing them in can be called quiet.
+	if noisy or here > 0 or around >= 3:
+		score = mini(score, 79)
+	var words := "静かだ。今のところ、安全そうに見える" if score >= 80 else ("比較的落ち着いている" if score >= 55 else ("油断できない" if score >= 30 else "危険だ"))
+	return {"score": score, "words": words, "reasons": reasons}
+
+static func line(world, place: String) -> String:
+	var a := assess(world, place)
+	return "このあたりは、%s。%s" % [a.words, ("（" + "、".join(a.reasons) + "）") if not a.reasons.is_empty() else ""]
