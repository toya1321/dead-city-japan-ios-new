+extends RefCounted
+## v149.33: how a fight reads. The rules decide what happened; these lines
+## put it into words from parts (the move, the weapon on the body part, the
+## result), several ways each, picked by the world's dice so a save replays
+## the same words. The local model may retell an unusual move in the player's
+## own words, but its line is thrown away if it says anything the rules did
+## not decide (see `accept`).
+
+## How each kind of weapon lands, by part. %s = the weapon's name.
+const LAND := {
+	"blunt": {
+		"head": ["%sを側頭部に叩きつけた。", "%sを頭めがけて振り下ろした。", "体ごと、%sを頭に打ちこんだ。"],
+		"legs": ["%sを低く振って、膝を払った。", "%sで、すねを横から打ち抜いた。", "腰を落として、%sを膝に叩きつけた。"],
+		"arms": ["伸びてきた腕を、%sで打ち払った。", "%sを腕に振り下ろした。"],
+		"torso": ["%sを胴に叩きこんだ。", "%sで、胸のあたりを突き返した。"],
+	},
+	"blade": {
+		"head": ["%sを、こめかみに突き立てた。", "顎の下から、%sを突き上げた。", "%sを、目のあたりに突き入れた。"],
+		"legs": ["%sで、膝の裏を切りつけた。", "かがんで、%sで足首を切った。"],
+		"arms": ["つかもうとする腕を、%sで切り払った。", "%sで、腕を深く切りつけた。"],
+		"torso": ["%sを胴に突き刺した。", "%sで、腹を切りつけた。"],
+	},
+	"spear": {
+		"head": ["%sを、顔めがけて突き出した。", "間合いの外から、%sで頭を突いた。"],
+		"legs": ["%sの先で、膝を突いた。", "%sで、足元を払った。"],
+		"arms": ["%sで、伸びてくる腕を突き払った。"],
+		"torso": ["%sで、胸を突いて押し返した。", "%sを、胴に突き立てた。"],
+	},
+	"fists": {
+		"head": ["拳を、顔に叩きこんだ。", "思い切り、横っ面を殴りつけた。"],
+		"legs": ["膝を、横から蹴りつけた。", "足払いをかけた。"],
+		"arms": ["伸びてきた腕を、手ではたき落とした。"],
+		"torso": ["胸を、力いっぱい蹴り飛ばした。", "肩から体当たりした。"],
+	},
+}
+## What it did, after the blow.
+const RESULT := {
+	"kill": ["相手は糸が切れたように崩れ落ち、もう動かなかった。", "鈍い手応えがあった。相手はその場に崩れ、動かなくなった。", "相手の体から、ふっと力が抜けた。それきりだった。"],
+	"kill_blade": ["刃が深く入った。相手は崩れ落ち、動かなくなった。", "手応えがあった。相手の体が重くなり、地面に沈んだ。"],
+	"kill_down": ["倒れた相手の頭に、真上から。それきり、動かなくなった。", "地面の相手は、もう二度と起き上がらなかった。"],
+	"head_wound": ["相手はよろめいたが、まだ倒れない。こちらに向き直ってくる。", "当たった。だが浅い。相手は首をかしげたまま、また歩き出した。"],
+	"head_wound_down": ["浅かった。相手は地面でもがきながら、まだこちらへ手を伸ばしてくる。"],
+	"down": ["相手はバランスを崩して、前のめりに倒れこんだ。", "膝が折れ、相手は地面に転がった。", "相手の脚がもつれ、仰向けに倒れた。"],
+	"cripple": ["膝がおかしな方向に曲がり、相手は崩れ落ちた。もう立てないだろう。", "脚はもう体を支えていない。相手は地面を這いはじめた。"],
+	"leg_hit_down": ["倒れた相手の脚を打った。這う速さが鈍った。"],
+	"leg_hold": ["脚に当たったが、相手は踏みとどまった。", "相手はぐらついたが、倒れなかった。"],
+	"arms": ["つかみかかる腕の勢いが鈍った。", "腕がだらりと下がった。つかむ力は弱っているはずだ。"],
+	"arms_twice": ["もう一方の腕も止めた。伸びてくる腕に、もう力がない。"],
+	"torso": ["相手は少し押し戻されたが、痛がる様子はない。", "胴に入ったが、相手は止まらない。体は痛みを感じていないようだ。"],
+	"torso_sit": ["相手は後ろによろけて、尻もちをついた。"],
+}
+const MISS := {
+	"head": ["頭を狙ったが、揺れる頭はうまく捉えられなかった。空を切った。", "頭を狙った一撃は、肩をかすめただけだった。"],
