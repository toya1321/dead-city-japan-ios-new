+				out.lines.append("%sが、扉の隙間から棒を突き出した。向こうで、一人が崩れ落ちた。" % m.name)
+		else:
+			holders += 1
+	var door_n := at(world, "door").size()
+	var window_n := at(world, "window").size()
+	if door_n > 0 and not bool(world.s.get("door_broken", false)):
+		var push := DOOR_PUSH * door_n * secs * (1.0 if holders == 0 else (0.4 if holders == 1 else 0.25))
+		var note := Walkers.batter_door(world, push)
+		if not note.is_empty():
+			out.lines.append(note.trim_prefix("【危険】").trim_prefix("【警告】"))
+	if window_n > 0:
