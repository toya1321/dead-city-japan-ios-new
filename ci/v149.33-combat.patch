diff --git a/tests/test_playthrough149_33.gd b/tests/test_playthrough149_33.gd
new file mode 100644
index 0000000..2c0928d
--- /dev/null
+++ b/tests/test_playthrough149_33.gd
@@ -0,0 +1,147 @@
+extends SceneTree
+## v149.33: fixes from a full playthrough with the real photos — phrasing that
+## was not understood, the door walked to, smoke not called cooking, a bite
+## that the body status did not show, the time of a held house, shelter words.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const Siege = preload("res://scripts/siege.gd")
+const Shelter = preload("res://scripts/shelter.gd")
+const CombatText = preload("res://scripts/combat_text.gd")
+const ActionPhotos = preload("res://scripts/action_photos.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 7
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+
+	await g._on_command("家の中を見て回る")
+	check(not g.log_entries[-1].contains("解釈できません"), "looking around the house is understood")
+	await g._on_command("鍵を閉める")
+	check(g.location == "玄関" and g.log_entries[-1].contains("もう閉まっている"), "locking walks to the door and says when it is already locked")
+	g._append(g._move_to("寝室"))
+	await g._on_command("玄関を補強する")
+	check(g.location == "玄関", "fortifying the door walks there")
+
+	w.s.cigarettes = 3
+	await g._on_command("タバコを吸う")
+	check(g.log_entries[-1].begins_with("窓を少し開けて") and ActionPhotos.detect(g.log_entries[-1]).get("kind", "") == "smoke", "smoking away from the kitchen opens a window, and shows its photo")
+	check(Walkers.reason_text(Walkers.ensure(w), "smell") == "タバコのにおい", "the smell it leaves is tobacco, not cooking")
+	Walkers.make_smell(w, 80)
+	check(Walkers.reason_text(Walkers.ensure(w), "smell") == "料理のにおい", "cooking smells of cooking")
+
+	w.s.walkers.places["建物前"] = 1
+	await g._on_command("静かになるのを待つ")
+	check(g.log_entries.slice(-3).any(func(l): return str(l).begins_with("窓の隙間から")), "waiting for it to go quiet is understood")
+	w.s.walkers.places = {}
+
+	check(Shelter.keep_watch(w).contains("まだ避難所は開いていない"), "a shelter not yet open is not described as abandoned")
+
+	# A sick resident's lunge leaves a wound the status shows, and never
+	# lands in the middle of a fight.
+	var before: int = Weapons.state(w).wounds.size()
+	var src := FileAccess.get_file_as_string("res://scripts/world_legacy.gd")
+	check(src.contains("walkers.get(\"encounter\", {}).is_empty()") and src.contains("wound(self, \"arms\""), "a lunge outside a fight is recorded as a wound, and none comes during one")
+	check(before == Weapons.state(w).wounds.size(), "(nothing recorded without a lunge)")
+
+	# The same miss is not told twice in a row.
+	w.s.walkers.encounter = {"place": "屋外", "count": 1, "beat": 0}
+	var same := 0
+	var last := ""
+	for i in 12:
+		w.s.walkers.encounter.beat = i % 2
+		var line: String = CombatText.miss(w, "head", false, false)
+		if line == last: same += 1
+		last = line
+	check(same == 0, "a miss is never told the same way twice in a row")
+	w.s.walkers.encounter = {}
+
+	# A held house takes time.
+	g.location = "玄関"
+	g._sync_player_position()
+	w.s.walkers.places = {"建物前": 2, "屋外": 0, "玄関": 0}
+	Siege.begin(w)
+	for i in 3:
+		if w.s.walkers.encounter.is_empty(): break
+		await g._on_command("扉越しに刺す")
+	var card := ""
+	for line in g.log_entries.slice(-8):
+		if str(line).begins_with("【戦いの結果】"): card = str(line)
+	check(w.s.walkers.encounter.is_empty() == false or not card.contains("約1秒") , "the time of a held door counts every stab")
+	if not w.s.walkers.encounter.is_empty():
+		check(float(w.s.walkers.encounter.get("clock", 0.0)) >= 3.0, "the clock runs at the door (%.1f s)" % float(w.s.walkers.encounter.get("clock", 0.0)))
+	# The konbini fills its shelves each morning while deliveries run.
+	w.s.walkers.encounter = {}
+	w.s.society = "normal"
+	w.s.district.sites["コンビニ"].food = 0.0
+	var day_start := int(w.s.minute) / 1440
+	w.advance_safe(24 * 60)
+	check(float(w.s.district.sites["コンビニ"].food) >= 8.0, "the konbini is restocked in normal times")
+	# A fed, rested body mends; a bitten one does not.
+	w.s.health = 50.0
+	w.s.hunger = 10.0
+	w.s.thirst = 10.0
+	w.s.fatigue = 10.0
+	w.s.bitten = false
+	w.s.symptomatic = false
+	w.s.injuries = 0.0
+	w.s.combat.wounds = []
+	w.advance_safe(12 * 60)
+	check(float(w.s.health) > 50.5, "health slowly comes back with food, water and rest (%.1f)" % float(w.s.health))
+	var mended := float(w.s.health)
+	w.s.bitten = true
+	w.s.hunger = 10.0
+	w.s.thirst = 10.0
+	w.advance_safe(6 * 60)
+	check(float(w.s.health) <= mended + 0.01, "but never after a bite")
+	w.s.bitten = false
+	# Crowds elsewhere are heard from the window.
+	w.s.walkers.places["駅前"] = 9
+	check(Walkers.far_sounds(w, "台所").contains("駅前の方角から"), "a crowd at the station is heard from home")
+	w.s.walkers.places.erase("駅前")
+	check(Walkers.far_sounds(w, "台所").is_empty(), "and nothing when there is none")
+	# A blade left in a body can be taken back.
+	var Remains = load("res://scripts/remains.gd")
+	Remains.add_body(w, "商店通り", {"id": "zz", "life": {"who": "見知らぬ人", "items": []}})
+	var owned_before: int = Weapons.state(w).weapons.size()
+	check(Remains.leave_blade(w, "商店通り", "knife", 33), "a stuck knife stays in the body")
+	var found: String = Remains.search(w, "商店通り")
+	check(found.contains("包丁を、力をこめて引き抜いた") and Weapons.state(w).weapons.size() == owned_before + 1, "and searching the body gives it back")
+	# Calm days hold the mind steady.
+	w.s.society = "normal"
+	check(load("res://scripts/mood.gd").rest_point(w) >= 65.0, "calm days do not wear the mind down")
+	# A new shelter holds for its first days.
+	var st: Dictionary = Shelter.state(w)
+	st.status = "open"; st.opened_day = Shelter._day(w)
+	check(Shelter._new(w, st), "a shelter just opened holds for a few days")
+	st.status = "school"; st.opened_day = -1
+	# Phrasings found with the real model, now read by the rules too.
+	var CI = load("res://scripts/combat_intent.gd")
+	var neck: Array = CI.parse("包丁で首を狙う")
+	check(not neck.is_empty() and str(neck[0].get("part", "")) == "head", "aiming at the neck is a blow to the head")
+	var ankle: Array = CI.parse("足首を切る")
+	check(not ankle.is_empty() and str(ankle[0].get("part", "")) == "legs", "but an ankle is still the legs")
+	# A death says how it ended before the story is told.
+	w.s.health = 0.0
+	await g._on_command("様子を見る")
+	var told := str(g.log_entries.slice(-3))
+	check(told.contains("【最期】") and told.contains("―― "), "a death is told in a line before the life story")
+	print("v149.33 playthrough checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
