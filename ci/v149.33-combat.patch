index 0000000..52e40fd
--- /dev/null
+++ b/tests/test_combat6_149_33.gd
@@ -0,0 +1,156 @@
+extends SceneTree
+## v149.33 combat stage 6: what the dead carried (decided by who they were,
+## found only by searching the body, once), leads to other places, and how
+## safe a place is from what is actually around it.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+const Remains = preload("res://scripts/remains.gd")
+const AreaSafety = preload("res://scripts/area_safety.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func fight(w, place: String, count: int) -> void:
+	w.s.walkers.places[place] = count
+	w.s.walkers.encounter = {"place": place, "count": count, "near": true, "since": int(w.s.minute), "from": "屋外"}
+	Combat.sync(w)
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 66
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.minute = 2 * 60
+
+	# Every walker has a life the moment it is seen; it does not change.
+	fight(w, "商店通り", 3)
+	var lives: Array = Combat.zombies(w).map(func(z): return z.life.duplicate(true))
+	check(lives.all(func(l): return not str(l.who).is_empty() and l.items is Array), "each walker was someone, with what they carried")
+	Combat.sync(w)
+	check(Combat.zombies(w).map(func(z): return z.life) == lives, "who they were does not change once seen")
+
+	# A kill leaves a body with those things; nothing is made up after.
+	var front: Dictionary = Combat.front(w)
+	var carried: Array = front.life.items.duplicate()
+	Combat._kill(w, front)
+	var bodies: Array = Remains.unsearched(w, "商店通り")
+	check(bodies.size() == 1 and bodies[0].items == carried, "the body holds exactly what that person carried")
+	check(int(w.s.cash) >= 0 and Remains.search(w, "商店通り").length() > 0 and Remains.unsearched(w, "商店通り").is_empty(), "searching takes what is there")
+	check(Remains.search(w, "商店通り").contains("調べていない遺体はない"), "a body is searched once")
+
+	# Known people keep who they were: a survivor who died, the neighbour.
+	var people: Dictionary = Survivors.ensure(w).people
+	var nb: Dictionary = people.neighbor_0
+	nb.status = "dead"
+	nb.cause = "turned"
+	w.s.walkers.encounter = {}
+	fight(w, str(nb.place), 1)
+	var z: Dictionary = Combat.front(w)
+	check(str(z.life.name) == str(nb.name) and "house_key" in z.life.items, "the neighbour who turned is the neighbour, with their house key")
+	Combat._kill(w, z)
+	var found := Remains.search(w, str(nb.place))
+	check(found.contains(str(nb.label)) and found.contains("隣の家の鍵"), "searching them: who it was, and the key")
+	check(not Remains.open_leads(w, str(nb.place)).is_empty(), "the key is a lead")
+	w.s.district.bag = {"food": 0.0, "water": 0.0}
+	var opened := Remains.follow(w, str(nb.place))
+	check(opened.contains("隣の家") and float(w.s.district.bag.food) > 0.0 and Remains.open_leads(w, str(nb.place)).is_empty(), "the key opens the house next door, once")
+	# The same person is not two walkers.
+	w.s.walkers.encounter = {}
+	fight(w, str(nb.place), 2)
+	check(not Combat.zombies(w).any(func(x): return str(x.life.name) == str(nb.name)), "the neighbour is not met a second time")
+
+	# A housemate who rose is remembered where they rose.
+	Remains.remember(w, "詩音", "駅前", "mate")
+	w.s.walkers.encounter = {}
+	fight(w, "駅前", 1)
+	check(str(Combat.front(w).life.name) == "詩音" and "photo" in Combat.front(w).life.items, "a housemate who rose is met again, with a photo in their pocket")
+
+	# Leads from town walkers: a memo or a key points somewhere on the map.
+	var leads_before: int = Remains.state(w).leads.size()
+	var body := {"id": "test", "who": "配達員の制服の男", "name": "", "items": ["memo"], "kind": "town", "searched": false, "at": int(w.s.minute)}
+	Remains.state(w).bodies["屋外"] = [body]
+	var memo := Remains.search(w, "屋外")
+	var lead: Dictionary = Remains.state(w).leads[-1]
+	check(Remains.state(w).leads.size() == leads_before + 1 and memo.contains(str(lead.place)), "a memo names a place: " + str(lead.place))
+
+	# Played through: after a fight, the chips offer a search; the look says how safe it is.
+	w.s.walkers.encounter = {}
+	g.location = "商店通り"
+	g._sync_player_position()
+	Remains.add_body(w, "商店通り", {"id": "z-chip", "life": {"who": "作業着の男", "items": ["tools"], "kind": "town"}})
+	check("死体を調べる" in g._suggestions(), "a body not yet searched is offered")
+	var parts := int(w.s.inventory.get("parts", 0))
+	await g._on_command("死体を調べる")
+	check(int(w.s.inventory.parts) == parts + 1, "「死体を調べる」 takes what is there")
+	fight(w, "商店通り", 1)
+	await g._on_command("死体を調べる")
+	check(g.log_entries[-1].contains("余裕はない") or str(g.log_entries.slice(-3)).contains("余裕はない"), "not in the middle of a fight")
+	w.s.walkers.encounter = {}
+
+	# Safety follows what is actually there.
+	w.s.walkers.places = {"商店通り": 0, "住宅街": 0, "屋外": 0, "駅前": 0}
+	w.s.walkers.noise = {}
+	var quiet := AreaSafety.assess(w, "商店通り")
+	w.s.walkers.places["住宅街"] = 4
+	var next_door := AreaSafety.assess(w, "商店通り")
+	w.s.walkers.places["商店通り"] = 2
+	var here := AreaSafety.assess(w, "商店通り")
+	check(int(quiet.score) > int(next_door.score) and int(next_door.score) > int(here.score), "safety drops with the dead next door, and more with them here (%d, %d, %d)" % [quiet.score, next_door.score, here.score])
+	Walkers.make_noise(w, "商店通り")
+	check(int(AreaSafety.assess(w, "商店通り").score) < int(here.score) and str(AreaSafety.line(w, "商店通り")).contains("物音"), "a recent noise makes it worse, and says why")
+	# Clearing a street helps only while nothing drifts back: walkers drift
+	# into a cleared street over the hours.
+	w.s.walkers.places = {"商店通り": 0, "住宅街": 8, "屋外": 0, "駅前": 0}
+	w.s.walkers.noise = {}
+	var drifted := 0
+	for h in 24:
+		w.s.minute += 60
+		Walkers.hourly(w)
+		drifted = maxi(drifted, Walkers.count(w, "商店通り"))
+	check(drifted > 0, "the dead drift back into a cleared street")
+	# A fallen shelf keeps most of them out of a shop.
+	w.s.walkers.places = {"商店通り": 10, "コンビニ": 0}
+	var into_open := 0
+	for h in 48:
+		w.s.minute += 60
+		w.s.walkers.places["商店通り"] = 10
+		w.s.walkers.places["コンビニ"] = 0
+		Walkers.hourly(w)
+		into_open += Walkers.count(w, "コンビニ")
+	AreaSafety.block(w, "コンビニ", 10)
+	var into_blocked := 0
+	for h in 48:
+		w.s.minute += 60
+		w.s.walkers.places["商店通り"] = 10
+		w.s.walkers.places["コンビニ"] = 0
+		Walkers.hourly(w)
+		into_blocked += Walkers.count(w, "コンビニ")
+	check(into_blocked < into_open, "a blocked doorway lets fewer in (%d vs %d)" % [into_blocked, into_open])
+
+	# Saved; a broken record is refused.
+	g._save()
+	var leads_n: int = Remains.state(w).leads.size()
+	w.s.remains = {}
+	g._load()
+	w = g.world
+	check(Remains.state(w).leads.size() == leads_n, "bodies and leads are saved")
+	check(not Remains.valid({"bodies": []}), "a broken record is refused")
+	print("v149.33 combat stage 6 checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
