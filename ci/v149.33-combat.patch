@@ -0,0 +1,57 @@
+extends SceneTree
+## How skill grows over many ordinary fights (3 a day), and from grinding.
+const Main = preload("res://main.tscn")
+const Combat = preload("res://scripts/combat.gd")
+const Skills = preload("res://scripts/skills.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 4
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.combat = {"weapons": [{"type": "pipe", "wear": 99999}], "held": "pipe", "found": {}, "armor": ["leather"], "magazine_left": 0, "wounds": [], "stuck": ""}
+	w.s.combat.skills = {"strike": 0.0, "blade": 0.0, "agility": 0.0}
+	var actions := 0
+	for day in 365:
+		for f in 3:
+			w.s.health = 100.0
+			w.s.fatigue = 10.0
+			w.s.bitten = false
+			w.s.minute = day * 1440 + (f + 2) * 60
+			w.s.walkers.places["屋外"] = 2
+			w.s.walkers.encounter = {"place": "屋外", "count": 2, "near": true, "since": int(w.s.minute), "from": "建物前"}
+			Combat.sync(w)
+			for i in 30:
+				if not Combat.active(w): break
+				w.s.minute += 1
+				var steps := ["脚を払う", "頭を狙う"] if i % 2 == 0 else ["頭を狙う"]
+				for st in steps:
+					Combat.act(w, {"act": "attack", "part": "legs" if st == "脚を払う" else "head", "text": st})
+					actions += 1
+					if not Combat.active(w): break
+			w.s.walkers.encounter = {}
+		w.s.combat.wounds = []
+		if day in [0, 6, 29, 59, 119, 179, 364]:
+			print("day %d: actions %d  strike Lv.%d  agility Lv.%d  aim %.0f calm %.0f  head odds %s" % [day + 1, actions, Skills.lv(w, "strike"), Skills.lv(w, "agility"), Skills.tech(w, "aim"), Skills.tech(w, "calm"), str(Combat.hit_chance(w, "head", {"state": "standing", "dist": 1.0, "hurt": {}})) + " nerve " + str(load("res://scripts/mood.gd").nerve_penalty(w.s))])
+	# Grinding: a lone walker, down, hit over and over.
+	var before := float(w.s.combat.skills.strike)
+	for i in 50:
+		w.s.minute += 1
+		w.s.walkers.places["屋外"] = 1
+		w.s.walkers.encounter = {"place": "屋外", "count": 1, "near": true, "since": 0, "from": "建物前"}
+		Combat.sync(w)
+		var z: Dictionary = Combat.front(w)
+		z.state = "crawling"
+		Skills.gain(w, "strike", 6.0, 90, false, "attack:pipe:head|" + str(z.id))
+	print("grinding 50 hits on a lone crawler: +%.1f xp" % (float(w.s.combat.skills.strike) - before))
+	quit()
