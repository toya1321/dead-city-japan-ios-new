@@ -0,0 +1,152 @@
+extends RefCounted
+## v149.33 (combat stage 2): reads a free-text order during an encounter into
+## steps: {act, part, dir}. Only reads; it never decides what happens.
+##   act:  attack / push / retreat / approach / flee / hide / distract / look /
+##         close_door / wait
+##   part: head / legs / arms / torso / "" (no part named: "just hit it")
+## "脚を払って、倒れたら頭を叩く" → two steps. Up to three steps per order.
+
+const Weapons = preload("res://scripts/weapons.gd")
+
+const PARTS := [
+	["head", ["頭", "脳天", "顔", "額", "頭部", "首から上"]],
+	["legs", ["脚", "足", "膝", "ひざ", "すね", "太もも", "足首", "足元"]],
+	["arms", ["腕", "手首", "手を", "肩"]],
+	["torso", ["胴", "腹", "胸", "体を", "体に", "背中"]],
+]
+## Order matters: the first matching word wins.
+const ACTS := [
+	["obstacle", ["棚を倒", "塞ぐ", "ふさぐ", "バリケード", "道をふさ", "通路をふさ"]],
+	["spray", ["噴射", "消火器を吹", "消火器をかけ", "消火器を浴び", "目くらまし", "粉をかけ"]],
+	["rescue", ["を助け", "助けに", "引きはが", "引き剥が", "を放せ", "を離せ", "から離れろ", "を救"]],
+	["close_door", ["ドアを閉め", "扉を閉め", "戸を閉め", "シャッターを閉め", "ドアを押さえ", "扉を押さえ"]],
+	["flee", ["逃げ", "走って帰", "家に帰", "引き返"]],
+	["hide", ["隠れ", "やり過ご", "息を殺", "身を伏せ", "物陰", "しゃが", "潜"]],
+	["distract", ["投げ", "気をそら", "注意をそら", "おとり", "囮", "音を出", "鳴らし", "気を引"]],
+	["push", ["突き飛ば", "押し返", "押しのけ", "突き放", "振りほど", "押し倒", "体当たり"]],
+	["retreat", ["下が", "後退", "距離を", "離れ", "後ずさ", "引い"]],
+	["approach", ["近づ", "詰め", "踏み込", "間合いに入"]],
+	["attack", ["殴", "叩", "振り下ろ", "振る", "振っ", "打ち", "打つ", "刺", "突", "斬", "切りつけ", "蹴", "払", "攻撃", "狙", "倒す", "倒し", "やっつけ", "割", "砕", "戦"]],
+	["look", ["様子", "観察", "数え", "うかが", "周りを見", "相手を見", "動きを見"]],
+	["wait", ["待ち構え", "待つ", "引きつけ", "構え"]],
+]
+const SPLITTERS := ["してから", "それから", "その後", "そのあと", "したら", "たら、", "て、", "で、", "、", "。", "そして"]
+
+static func _find(text: String, table: Array) -> String:
+	var best := ""
+	var at := 1 << 30
+	for row in table:
+		for word in row[1]:
+			var i := text.find(word)
+			if i >= 0 and i < at:
+				at = i
+				best = str(row[0])
+	return best
+
+## Every action named in a clause, in the order written. Higher rows win
+## where words overlap ("棚を倒して" is an obstacle, not an attack), and
+## the same act said twice in a row is one act ("狙って振り下ろす").
+static func _acts(text: String) -> Array:
+	var masked := text
+	var found: Array = []
+	for row in ACTS:
+		for word in row[1]:
+			var from := 0
+			while true:
+				var i := masked.find(word, from)
+				if i < 0:
+					break
+				found.append([i, str(row[0])])
+				masked = masked.substr(0, i) + " ".repeat(word.length()) + masked.substr(i + word.length())
+				from = i + word.length()
+	found.sort_custom(func(x, y): return int(x[0]) < int(y[0]))
+	var out: Array = []
+	for f in found:
+		if out.is_empty() or str(out[-1][1]) != str(f[1]):
+			out.append(f)
+	return out
+
+## The order split into clauses, each read on its own.
+static func _clauses(text: String) -> Array:
+	var parts: Array = [text]
+	for sep in SPLITTERS:
+		var next: Array = []
+		for piece in parts:
+			for bit in str(piece).split(sep, false):
+				if not bit.strip_edges().is_empty():
+					next.append(bit.strip_edges())
+		parts = next
+	return parts
+
+static func parse(text: String) -> Array:
+	var steps: Array = []
+	var carry_part := ""
+	var carry_if := ""
+	for clause in _clauses(text.strip_edges()):
+		var acts := _acts(clause)
+		var clause_part := _find(clause, PARTS)
+		# "膝を狙う" is an attack on the legs even without a verb of hitting.
+		if acts.is_empty() and not clause_part.is_empty():
+			acts = [[0, "attack"]]
+		if acts.is_empty():
+			# "倒れたら" and the like set a condition, not an action.
+			if not clause_part.is_empty():
+				carry_part = clause_part
+			if _has_any(clause, ["倒れたら", "倒れ", "転んだら", "転んだ", "膝をついたら"]):
+				carry_if = "down"
+			continue
+		for k in acts.size():
+			var act := str(acts[k][1])
+			var part := ""
+			if act == "attack":
+				# The body part named before this verb (and after the last one).
+				var start := 0 if k == 0 else int(acts[k - 1][0])
+				part = _find(clause.substr(start, int(acts[k][0]) + 3 - start), PARTS)
+				if part.is_empty():
+					part = clause_part if acts.size() == 1 else ""
+				if part.is_empty():
+					part = carry_part
+				if part.is_empty() and clause.substr(int(acts[k][0]), 2).begins_with("払"):
+					part = "legs"
+			# "倒れた頭" / "這ってくる奴" picks the one on the ground.
+			var target := "down" if _has_any(clause, ["倒れ", "這", "転ん", "足元の", "地面の"]) else ""
+			# "倒れたら頭を叩く": only if the one before brought it down.
+			var cond := carry_if if k == 0 else ""
+			if k == 0 and _has_any(clause, ["倒れたら", "転んだら", "倒したら", "膝をついたら"]):
+				cond = "down"
+			if cond == "down" and target.is_empty():
+				target = "down"
+			steps.append({"act": act, "part": part, "text": clause, "target": target, "weapon": Weapons.named_in(clause), "if": cond})
+			carry_part = ""
+			carry_if = ""
+			if steps.size() >= 3:
+				return steps
+	return steps
+
+static func _has_any(text: String, words: Array) -> bool:
+	for word in words:
+		if text.contains(word):
+			return true
+	return false
+
+## Words the rules know; anything else the player brings into a move
