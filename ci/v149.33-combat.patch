@@ -0,0 +1,225 @@
+extends RefCounted
+## v149.33 (combat stage 8): what a fight came to, and what a life of them
+## did. A short result card at the end of each fight; a running record
+## (s.combat.stats); achievements and titles (no powers attached); lines for
+## the ending.
+
+const Walkers = preload("res://scripts/walkers.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const Skills = preload("res://scripts/skills.gd")
+const Remains = preload("res://scripts/remains.gd")
+const AreaSafety = preload("res://scripts/area_safety.gd")
+const Navigation = preload("res://scripts/navigation.gd")
+const Chronicle = preload("res://scripts/chronicle.gd")
+
+## id: [name, title, how it was earned]
+const ACHIEVEMENTS := {
+	"first_kill": ["初めての撃破", "", "初めて、感染者を倒した"],
+	"kills_10": ["十体", "場数を踏んだ人", "感染者を10体倒した"],
+	"kills_100": ["百体", "百を数えた者", "感染者を100体倒した"],
+	"siege_won": ["家を守った", "家を守る人", "家に押し寄せた感染者を退けた"],
+	"horde": ["群れからの生還", "群れを抜けた人", "10体以上に囲まれて、噛まれずに切り抜けた"],
+	"pacifist": ["誰も傷つけずに", "誰も傷つけなかった人", "30日間、一度も感染者を倒さずに生き延びた"],
+	"together": ["背中を預けて", "仲間と戦う人", "同居人と一緒に戦い、勝った"],
+	"heavy": ["重傷からの生還", "しぶとい人", "体力が4分の1を切るほどの傷から立ち直った"],
+}
+
+static func stats(world) -> Dictionary:
+	var st := Weapons.state(world)
+	if not st.get("stats") is Dictionary:
+		st.stats = {"fights": 0, "kills": 0, "ally_kills": 0, "escapes": 0, "bites": 0, "sieges": 0, "together": 0, "wounds": {}, "weapons": {}, "last_kill": -1, "worst_hp": 100.0, "max_seen": 0}
+	if not st.get("ach") is Dictionary:
+		st.ach = {}
+	return st.stats
+
+## Taken when a fight begins (kept in the encounter).
+static func begin(world, enc: Dictionary) -> void:
+	if enc.has("rec"):
+		return
+	var wear := {}
+	for w in Weapons.state(world).weapons:
+		wear[str(w.type)] = int(w.get("wear", 0))
+	enc.rec = {"kills0": int(Walkers.ensure(world).get("killed", 0)), "wounds0": Weapons.state(world).wounds.size(), "wear0": wear,
+		"clock0": float(enc.get("clock", 0.0)), "minute0": int(world.s.minute), "max_seen": Walkers.count(world, str(enc.get("place", ""))), "hp0": float(world.s.health)}
+
+static func seen(world, enc: Dictionary) -> void:
+	if enc.has("rec"):
+		var n := Walkers.count(world, str(enc.get("place", ""))) + (Walkers.count(world, "玄関") if bool(enc.get("siege", false)) else 0)
+		enc.rec.max_seen = maxi(int(enc.rec.max_seen), n)
+
+static func _seconds_words(s: float) -> String:
+	if s < 60.0:
+		return "約%d秒" % maxi(1, int(round(s / 5.0)) * 5)
+	return "約%d分" % maxi(1, int(round(s / 60.0)))
+
+## The fight is over. how: won / escaped / bitten. Returns the result card
+## and any achievements, as lines.
+static func finish(world, enc: Dictionary, how: String, xp_start: Dictionary, tech_start: Dictionary) -> Array:
+	var rec: Dictionary = enc.get("rec", {})
+	if rec.is_empty():
+		return []
+	var s := stats(world)
+	var w := Walkers.ensure(world)
+	var kills := int(w.get("killed", 0)) - int(rec.kills0)
+	var ally_kills := 0
+	var together := false
+	for key in enc.get("allies", {}):
+		ally_kills += int(enc.allies[key].get("kills", 0))
+		together = together or str(enc.allies[key].get("stance", "")) in ["fight", "back", "hide"]
+	s.fights = int(s.fights) + 1
+	# The player's own count; a housemate's kills are theirs.
+	s.kills = int(s.kills) + kills - ally_kills
+	s.ally_kills = int(s.ally_kills) + ally_kills
+	s.max_seen = maxi(int(s.max_seen), int(rec.max_seen))
+	if kills - ally_kills > 0:
+		s.last_kill = int(world.s.minute)
+	if how == "escaped":
+		s.escapes = int(s.escapes) + 1
+	if how == "bitten":
+		s.bites = int(s.bites) + 1
+	if bool(enc.get("siege", false)):
+		s.sieges = int(s.sieges) + 1
+	if together and how == "won":
+		s.together = int(s.together) + 1
+	var held := Weapons.held(world)
+	if kills - ally_kills > 0:
+		s.weapons[held] = int(s.weapons.get(held, 0)) + kills - ally_kills
+	var lines: Array = ["【戦いの結果】"]
+	var who := "倒した：%d人" % kills if kills > 0 else "倒した：なし"
+	if ally_kills > 0:
+		who += "（うち同居人が%d人）" % ally_kills
+	lines.append(who + " ・ かかった時間：" + _seconds_words(float(enc.get("clock", 0.0)) - float(rec.clock0)))
+	# Wounds from this fight.
+	var new_wounds: Array = Weapons.state(world).wounds.slice(int(rec.wounds0))
+	var hurt: Array = []
+	for wound in new_wounds:
+		hurt.append("%sの%s" % [Weapons.PART_NAMES.get(str(wound.part), "体"), Weapons.WOUND_NAMES.get(str(wound.kind), "傷")])
+		s.wounds[str(wound.kind)] = int(s.wounds.get(str(wound.kind), 0)) + 1
+	lines.append("けが：" + ("、".join(hurt) if not hurt.is_empty() else "なし"))
+	# What the weapons went through.
+	var gear: Array = []
+	var wear0: Dictionary = rec.get("wear0", {})
+	for type in wear0:
+		if not Weapons.owns(world, type):
+			gear.append("%sを失った" % Weapons.name_of(type))
+		elif Weapons.TYPES.has(type):
+			for owned in Weapons.state(world).weapons:
+				if str(owned.type) == type and int(owned.wear) < int(wear0[type]) and Weapons.condition_words(world, type) != "新品同様":
+					gear.append("%s（%s）" % [Weapons.name_of(type), Weapons.condition_words(world, type)])
+	if not gear.is_empty():
+		lines.append("武器：" + "、".join(gear))
+	# What was learned (the experience itself may be shown as numbers).
+	lines.append_array(Skills.summary(world, xp_start, tech_start))
+	# What lies there to be searched, and what the noise may bring.
+	var place := str(enc.get("place", ""))
+	var where := "玄関" if bool(enc.get("siege", false)) else place
+	var bodies := Remains.unsearched(world, where) + (Remains.unsearched(world, place) if bool(enc.get("siege", false)) else [])
+	if how != "escaped" and not bodies.is_empty():
+		lines.append("倒れた%d人は、まだ調べていない。（「死体を調べる」）" % bodies.size())
+	if how == "won" and not Navigation.indoor(place) and not bool(enc.get("siege", false)):
+		lines.append(AreaSafety.line(world, place))
+	# Slipping away from the dead with nothing happening needs no card.
+	# (A level gained on the way is told in one quiet line, not a whole card.)
+	if how == "escaped" and kills == 0 and new_wounds.is_empty() and gear.is_empty():
+		var quiet: Array = []
+		for line in Skills.summary(world, xp_start, tech_start):
+			quiet.append(str(line))
+		quiet.append_array(check(world))
+		return quiet
+	var card := "\n".join(lines)
+	var out: Array = [card]
+	out.append_array(check(world))
+	return out
+
+## New achievements, as lines; remembered with the minute they came.
+static func check(world) -> Array:
+	var s := stats(world)
+	var ach: Dictionary = Weapons.state(world).ach
+	var got: Array = []
+	var day := int(world.s.minute) / 1440
+	var tests := {
+		"first_kill": int(s.kills) >= 1,
+		"kills_10": int(s.kills) >= 10,
+		"kills_100": int(s.kills) >= 100,
+		"siege_won": int(Weapons.state(world).get("sieges_won", 0)) >= 1,
+		"horde": int(s.max_seen) >= 10 and int(s.bites) == 0,
+		"pacifist": day >= 30 and int(s.kills) == 0 and float(world.s.health) > 0.0,
+		"together": int(s.together) >= 1,
+		"heavy": float(s.worst_hp) < 25.0 and float(world.s.health) >= 60.0,
+	}
+	for id in ACHIEVEMENTS:
+		if bool(tests[id]) and not ach.has(id):
+			ach[id] = int(world.s.minute)
+			got.append("【実績】「%s」……%s。" % [ACHIEVEMENTS[id][0], ACHIEVEMENTS[id][2]])
+			Chronicle.note(world, "実績「%s」。" % ACHIEVEMENTS[id][0], "achievement")
+	return got
+
+## Hourly: the lowest health, and the achievements that come with time.
+static func hourly(world) -> void:
+	if not world.s.get("combat") is Dictionary:
+		# Someone who has never fought still earns "誰も傷つけずに".
+		if int(world.s.minute) / 1440 < 30:
+			return
+		Weapons.state(world)
+	var s := stats(world)
+	s.worst_hp = minf(float(s.worst_hp), float(world.s.health))
+	for line in check(world):
+		Walkers.ensure(world).notices.append(line)
+
+## The title shown in the records: the latest one with a title.
+static func title(world) -> String:
+	var ach: Dictionary = Weapons.state(world).get("ach", {}) if world.s.get("combat") is Dictionary else {}
+	var best := ""
+	var when := -1
+	for id in ach:
+		if not str(ACHIEVEMENTS[id][1]).is_empty() and int(ach[id]) >= when:
+			when = int(ach[id])
+			best = str(ACHIEVEMENTS[id][1])
+	return best
+
+static func records_text(world) -> String:
+	if not world.s.get("combat") is Dictionary:
+		return "戦いの記録\nまだ、一度も戦っていない。"
+	var s := stats(world)
+	var lines: Array = ["戦いの記録"]
+	lines.append("戦った回数：%d ・ 倒した数：%d（同居人が倒した数：%d） ・ 逃げ切った回数：%d" % [int(s.fights), int(s.kills), int(s.ally_kills), int(s.escapes)])
+	lines.append("家を守った回数：%d ・ 腕前：%s" % [int(Weapons.state(world).get("sieges_won", 0)), Skills.panel_words(world)])
+	var t := title(world)
+	if not t.is_empty():
+		lines.append("称号：%s" % t)
+	var ach: Dictionary = Weapons.state(world).ach
+	lines.append("実績（%d / %d）" % [ach.size(), ACHIEVEMENTS.size()])
+	for id in ACHIEVEMENTS:
+		if ach.has(id):
+			lines.append("・%s（%d日目）%s" % [ACHIEVEMENTS[id][0], int(ach[id]) / 1440 + 1, ACHIEVEMENTS[id][2]])
+		else:
+			lines.append("・？？？")
+	return "\n".join(lines)
+
+## A line or two for the ending, from the record of the fights.
+static func epilogue(world, name: String, pick: Callable) -> Array:
+	if not world.s.get("combat") is Dictionary:
+		return [pick.call(["%sは、一度も感染者に手を上げなかった。" % name], "f-none")] if int(world.s.minute) / 1440 >= 7 else []
+	var s := stats(world)
+	var out: Array = []
+	var kills := int(s.kills)
+	var favourite := ""
+	var most := 0
+	for type in s.weapons:
+		if int(s.weapons[type]) > most:
+			most = int(s.weapons[type])
+			favourite = Weapons.name_of(str(type))
+	if kills >= 100:
+		out.append(pick.call(["この街で、%d体を土に還した。" % kills, "%sが倒した感染者は、百を超えた。" % name], "f-100"))
+	elif kills >= 10:
+		out.append(pick.call(["%d体の感染者を倒した。最後まで手放さなかったのは、%sだった。" % [kills, favourite] if not favourite.is_empty() else "%d体の感染者を倒した。" % kills], "f-10"))
+	elif kills == 0 and int(world.s.minute) / 1440 >= 7:
+		out.append(pick.call(["一度も、誰も傷つけずに生きた。", "%sは、最後まで感染者に手を上げなかった。逃げ、隠れ、やり過ごして生きた。" % name], "f-0"))
+	var sieges := int(Weapons.state(world).get("sieges_won", 0))
+	if sieges >= 1:
+		out.append(pick.call(["押し寄せる感染者から、家を%d度守りきった。" % sieges if sieges > 1 else "押し寄せる感染者から、一度、家を守りきった。"], "f-siege"))
+	elif int(s.together) >= 1:
+		out.append(pick.call(["仲間と背中を合わせて戦った日のことを、%sは忘れなかった。" % name], "f-together"))
+	elif Skills.lv(world, "strike") >= 30 or Skills.lv(world, "blade") >= 30:
+		out.append(pick.call(["最初は震えていた手が、最後には迷わなかった。"], "f-skill"))
+	return out.slice(0, 2)
