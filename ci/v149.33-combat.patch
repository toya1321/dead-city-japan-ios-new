+extends SceneTree
+## v149.33 combat stage 7: holding the house — the door and window take the
+## blows, the player and housemates fight from inside, noise draws only the
+## dead really nearby, a broken way lets them in one at a time, and there is
+## always a way out the back.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+const Siege = preload("res://scripts/siege.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const Allies = preload("res://scripts/allies.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func kit(w, type: String) -> void:
+	w.s.combat = {"weapons": [{"type": type, "wear": 999}], "held": type, "found": {}, "armor": ["coat"], "magazine_left": 0, "wounds": [], "stuck": ""}
+
+func setup(w, porch: int, street: int, door: float = 100.0, boards: int = 1) -> void:
+	w.s.walkers.encounter = {}
+	w.s.walkers.places = {"建物前": porch, "屋外": street, "玄関": 0}
+	w.s.walkers.noise = {}
+	w.s.door_hp = door
+	w.s.door_broken = false
+	w.s.barricade = boards
+	w.s.board_damage = 0.0
+
+func total(w) -> int:
+	return Walkers.count(w, "建物前") + Walkers.count(w, "屋外") + Walkers.count(w, "玄関")
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 77
+	p.cohabitants = 0
+	p.housing = "一戸建て"
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.minute = 2 * 60
+	g.location = "玄関"
+	g._sync_player_position()
+
+	# The dead at the door can be taken on from inside.
+	kit(w, "knife")
+	setup(w, 4, 0)
+	check("家の中から迎え撃つ" in g._suggestions(), "with the dead at the door, the house can be held")
+	await g._on_command("家の中から迎え撃つ")
+	check(Siege.active(w) and Siege.at(w, "door").size() == 4, "the four at the door are there, outside")
+	check(str(Combat.status_lines(w)).contains("補強板1段") and str(Combat.status_lines(w)).contains("外に4人"), "the panel shows the door, the boards, and how many outside")
+	check("扉越しに刺す" in g._suggestions() and "裏口から逃げる" in g._suggestions(), "the choices are the siege's own")
+
+	# Only a blade or a spear goes through the gap.
+	kit(w, "pipe")
+	check(bool(Siege.act(w, {"act": "attack", "part": "head", "text": "扉越しに刺す"}, [], Combat).invalid), "a pipe does not go through the gap")
+	kit(w, "knife")
+	var before := Walkers.count(w, "建物前")
+	var tries := 0
+	while Walkers.count(w, "建物前") == before and tries < 30:
+		w.s.minute += 1
+		Siege.act(w, {"act": "attack", "part": "head", "text": "扉越しに刺す"}, [], Combat)
+		tries += 1
+	check(Walkers.count(w, "建物前") == before - 1 and not Remains_bodies(w).is_empty(), "a knife through the gap can bring one down, and the body is outside")
+
+	# Holding the door slows the battering.
+	setup(w, 4, 0, 100.0, 0)
+	Siege.begin(w)
+	Siege.act(w, {"act": "wait", "part": "", "text": "様子を見る"}, [], Combat)
+	var free_door := 100.0 - float(w.s.door_hp)
+	setup(w, 4, 0, 100.0, 0)
+	Siege.begin(w)
+	Siege.act(w, {"act": "close_door", "part": "", "text": "扉を押さえる"}, [], Combat)
+	var held_door := (100.0 - float(w.s.door_hp)) * 2.0 / 4.0
+	check(held_door < free_door or free_door == 0.0, "holding the door takes most of the force (per second: %.2f vs %.2f)" % [held_door, free_door / 2.0])
+
+	# Nailing on a board takes wood; the drop runs out.
+	setup(w, 4, 0, 100.0, 0)
+	Siege.begin(w)
+	w.s.inventory.wood = 1
+	Siege.act(w, {"act": "board", "part": "", "text": "板を打ちつける"}, [], Combat)
+	check(int(w.s.barricade) == 1 and int(w.s.inventory.wood) == 0, "a board is nailed on, using the wood")
+	check(bool(Siege.act(w, {"act": "board", "part": "", "text": "板を打ちつける"}, [], Combat).invalid), "no wood, no board")
+	for i in 3:
+		w.s.minute += 1
+		Siege.act(w, {"act": "siege_drop", "part": "", "text": "二階の窓から物を落とす"}, [], Combat)
+	check(bool(Siege.act(w, {"act": "siege_drop", "part": "", "text": "二階の窓から物を落とす"}, [], Combat).invalid), "only three heavy things to drop")
+
+	# Noise draws only the dead really nearby: nothing appears from nowhere.
+	setup(w, 3, 0)
+	Siege.begin(w)
+	Walkers.make_noise(w, "建物前", 60)
+	for i in 20:
+		w.s.minute += 1
+		Siege.act(w, {"act": "close_door", "part": "", "text": "扉を押さえる"}, [], Combat)
+	check(total(w) <= 3, "with no one in the street, noise brings no one new")
+	setup(w, 2, 5)
+	Siege.begin(w)
+	var t0 := total(w)
+	Walkers.make_noise(w, "建物前", 60)
+	for i in 20:
+		w.s.minute += 1
+		Siege.act(w, {"act": "close_door", "part": "", "text": "扉を押さえる"}, [], Combat)
+	check(total(w) == t0 and Walkers.count(w, "建物前") > 2, "noise draws those in the street to the door; the number of dead stays the same")
+
+	# A broken door lets them in, a couple at a time, into the narrow hall.
+	setup(w, 4, 0, 1.0, 0)
+	Siege.begin(w)
+	Siege.act(w, {"act": "wait", "part": "", "text": "様子を見る"}, [], Combat)
+	Siege.act(w, {"act": "wait", "part": "", "text": "様子を見る"}, [], Combat)
+	var inside := Siege.at(w, "inside")
+	check(bool(w.s.door_broken) and inside.size() >= 1 and inside.size() <= 4, "the door breaks and some come in")
+	check(Combat.terrain(w) == "corridor", "inside, it is a narrow hall")
+	Combat.tick(w, 10.0)
+	var gaps_ok := true
+	var list: Array = Siege.at(w, "inside")
+	for k in range(1, list.size()):
+		gaps_ok = gaps_ok and float(list[k].dist) >= float(list[k - 1].dist) + 0.79
+	check(gaps_ok, "in the hall they come one behind the other")
+	# Up the stairs: easier to hit, harder to be grabbed.
+	var z: Dictionary = Combat.front(w)
+	var floor_odds := Combat.hit_chance(w, "head", z)
+	Siege.act(w, {"act": "upstairs", "part": "", "text": "二階へ上がる"}, [], Combat)
+	check(Combat.terrain(w) == "stairs" and Combat.hit_chance(w, "head", z) > floor_odds, "from the top of the stairs it is easier to hit")
+	# A bite in the house does not end the fight.
+	var held: Dictionary = w.s.walkers.encounter
+	var r: Dictionary = Walkers._bite(w, held.duplicate(true), "つかみかかられた。", "arms")
+	w.s.walkers.encounter = held
+	check(Siege.active(w), "(setup) still in the house")
+	w.s.bitten = false
+
+	# Save and load in the middle of it.
+	var house_state: Dictionary = Siege.house(w).duplicate(true)
+	var positions: Array = w.s.walkers.encounter.zombies.map(func(x): return str(x.pos))
+	g._save()
+	w.s.walkers.encounter = {}
+	g._load()
+	w = g.world
+	check(Siege.active(w) and Siege.house(w) == house_state and w.s.walkers.encounter.zombies.map(func(x): return str(x.pos)) == positions, "a siege is saved as it stands")
+
+	# The way out the back.
+	g.location = "玄関"
+	await g._on_command("裏口から逃げる")
+	check(not Siege.active(w) and g.location == "屋外", "out the back: the siege is left behind")
+
+	# Housemates hold the door or stab through the gap.
+	var ids: Array = Survivors.ensure(w).people.keys().filter(func(k): return not bool(Survivors.ensure(w).people[k].get("neighbor", false)) and str(Survivors.ensure(w).people[k].place) != "避難所")
+	Survivors.ensure(w).people[ids[0]].traits.courage = 15
+	Survivors._join(w, ids[0])
+	var mate: Dictionary = w.s.household_members[-1]
+	mate.location = "玄関"
+	g.location = "玄関"
+	kit(w, "pipe")
+	setup(w, 4, 0, 100.0, 0)
+	Siege.begin(w)
+	Allies.ensure(w, [w.s.household_members.size() - 1])
+	Siege.act(w, {"act": "wait", "part": "", "text": "様子を見る"}, [], Combat)
+	var with_mate := 100.0 - float(w.s.door_hp)
+	check(with_mate < free_door, "a timid housemate leans on the door (%.1f vs %.1f)" % [with_mate, free_door])
+
+	# Clearing them all is a siege won, remembered.
+	setup(w, 1, 0)
+	Siege.begin(w)
+	var won_before := int(Weapons.state(w).get("sieges_won", 0))
+	Combat._kill(w, Siege.at(w, "door")[0])
+	var out := {"lines": [], "seconds": 1.0, "stop": false}
+	Siege._pass(w, out, [], Combat)
+	check(int(Weapons.state(w).get("sieges_won", 0)) == won_before + 1 and str(out.lines).contains("守りきった"), "a house held is remembered")
+	print("v149.33 combat stage 7 checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
+
+func Remains_bodies(w) -> Array:
+	return w.s.get("remains", {}).get("bodies", {}).get("建物前", [])
