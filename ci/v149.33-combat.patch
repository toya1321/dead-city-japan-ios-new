@@ -0,0 +1,152 @@
+extends RefCounted
+## v149.33: how a fight reads. The rules decide what happened; these lines
+## put it into words from parts (the move, the weapon on the body part, the
+## result), several ways each, picked by the world's dice so a save replays
+## the same words. The local model may retell an unusual move in the player's
+## own words, but its line is thrown away if it says anything the rules did
+## not decide (see `accept`).
+
+## How each kind of weapon lands, by part. %s = the weapon's name.
+const LAND := {
+	"blunt": {
+		"head": ["%sを側頭部に叩きつけた。", "%sを頭めがけて振り下ろした。", "体ごと、%sを頭に打ちこんだ。"],
+		"legs": ["%sを低く振って、膝を払った。", "%sで、すねを横から打ち抜いた。", "腰を落として、%sを膝に叩きつけた。"],
+		"arms": ["伸びてきた腕を、%sで打ち払った。", "%sを腕に振り下ろした。"],
+		"torso": ["%sを胴に叩きこんだ。", "%sで、胸のあたりを突き返した。"],
+	},
+	"blade": {
+		"head": ["%sを、こめかみに突き立てた。", "顎の下から、%sを突き上げた。", "%sを、目のあたりに突き入れた。"],
+		"legs": ["%sで、膝の裏を切りつけた。", "かがんで、%sで足首を切った。"],
+		"arms": ["つかもうとする腕を、%sで切り払った。", "%sで、腕を深く切りつけた。"],
+		"torso": ["%sを胴に突き刺した。", "%sで、腹を切りつけた。"],
+	},
+	"spear": {
+		"head": ["%sを、顔めがけて突き出した。", "間合いの外から、%sで頭を突いた。"],
+		"legs": ["%sの先で、膝を突いた。", "%sで、足元を払った。"],
+		"arms": ["%sで、伸びてくる腕を突き払った。"],
+		"torso": ["%sで、胸を突いて押し返した。", "%sを、胴に突き立てた。"],
+	},
+	"fists": {
+		"head": ["拳を、顔に叩きこんだ。", "思い切り、横っ面を殴りつけた。"],
+		"legs": ["膝を、横から蹴りつけた。", "足払いをかけた。"],
+		"arms": ["伸びてきた腕を、手ではたき落とした。"],
+		"torso": ["胸を、力いっぱい蹴り飛ばした。", "肩から体当たりした。"],
+	},
+}
+## What it did, after the blow.
+const RESULT := {
+	"kill": ["相手は糸が切れたように崩れ落ち、もう動かなかった。", "鈍い手応えがあった。相手はその場に崩れ、動かなくなった。", "相手の体から、ふっと力が抜けた。それきりだった。"],
+	"kill_blade": ["刃が深く入った。相手は崩れ落ち、動かなくなった。", "手応えがあった。相手の体が重くなり、地面に沈んだ。"],
+	"kill_down": ["それきり、動かなくなった。", "地面の相手は、もう二度と起き上がらなかった。", "地面でもがいていた手が、ぱたりと落ちた。"],
+	"head_wound": ["相手はよろめいたが、まだ倒れない。こちらに向き直ってくる。", "当たった。だが浅い。相手は首をかしげたまま、また歩き出した。"],
+	"head_wound_down": ["浅かった。相手は地面でもがきながら、まだこちらへ手を伸ばしてくる。"],
+	"down": ["相手はバランスを崩して、前のめりに倒れこんだ。", "膝が折れ、相手は地面に転がった。", "相手の脚がもつれ、仰向けに倒れた。"],
+	"cripple": ["膝がおかしな方向に曲がり、相手は崩れ落ちた。もう立てないだろう。", "脚はもう体を支えていない。相手は地面を這いはじめた。"],
+	"leg_hit_down": ["這う速さが鈍った。", "まだ腕で地面をかいて、こちらへ寄ってくる。"],
+	"leg_hold": ["脚に当たったが、相手は踏みとどまった。", "相手はぐらついたが、倒れなかった。"],
+	"arms": ["つかみかかる腕の勢いが鈍った。", "腕がだらりと下がった。つかむ力は弱っているはずだ。"],
+	"arms_twice": ["もう一方の腕も止めた。伸びてくる腕に、もう力がない。"],
+	"torso": ["相手は少し押し戻されたが、痛がる様子はない。", "胴に入ったが、相手は止まらない。体は痛みを感じていないようだ。"],
+	"torso_sit": ["相手は後ろによろけて、尻もちをついた。"],
+}
+const MISS := {
+	"head": ["頭を狙ったが、揺れる頭はうまく捉えられなかった。空を切った。", "頭を狙った一撃は、肩をかすめただけだった。", "こめかみを狙ったが、届く前に相手が首をかしげ、一撃は耳の横を抜けた。", "頭へ振った一撃は、浅くかすめただけだった。", "頭を狙ったが、腕に当たって弾かれた。"],
+	"down": ["地面の相手を狙ったが、わずかにそれた。", "振り下ろした一撃は、相手の頭の横をかすめた。"],
+	"dark": ["暗くて、間合いがつかめない。振った手応えがなかった。", "闇の中で振った一撃は、何もない所を切った。"],
+	"any": ["振ったが、当たらなかった。相手はまだ迫ってくる。", "踏み込みが浅かった。空を切った。", "相手が不意に体を傾け、一撃はそれた。"],
+}
+
+static func pick(world, list: Array, tag: String) -> String:
+	if list.is_empty():
+		return ""
+	var enc: Dictionary = world.s.get("walkers", {}).get("encounter", {})
+	var salt := int(enc.get("beat", 0)) * 13 + tag.hash() % 1009
+	var i: int = world.draw(int(world.s.minute), salt, "ctext-" + tag, list.size())
+	# The same sentence twice in a row reads like a broken record.
+	if list.size() > 1 and str(list[i]) == str(enc.get("last_line", "")):
+		i = (i + 1) % list.size()
+	if not enc.is_empty():
+		enc.last_line = str(list[i])
+	return str(list[i])
+
+static func land(world, klass: String, part: String, weapon_name: String) -> String:
+	var table: Dictionary = LAND.get(klass, LAND.blunt)
+	var line := pick(world, table.get(part, table.torso), "land-%s-%s" % [klass, part])
+	return line % weapon_name if line.contains("%s") else line
+
+static func result(world, key: String) -> String:
+	return pick(world, RESULT.get(key, []), "res-" + key)
+
+static func miss(world, part: String, down: bool, dark: bool) -> String:
+	if down:
+		return pick(world, MISS.down, "miss-down")
+	if dark:
+		return pick(world, MISS.dark, "miss-dark")
+	if part == "head":
+		return pick(world, MISS.head, "miss-head")
+	return pick(world, MISS.any, "miss-any")
+
+# ---- the local model's retelling ------------------------------------------
+
+const NARRATE_INSTRUCTIONS := """ゾンビのような感染者との戦いを描く小説の語り手。「プレイヤーの行動」を、使った物や動きの言葉を生かして、過去形の短い1文（35字以内）に書き直す。
+行動そのものだけを書き、結果（当たった・外れた・倒れた・動かなくなった・噛まれた）は書かない。結果はゲームが続けて書く。数字・会話文は入れない。
+例：「ゴミ箱を投げる」→「そばのゴミ箱をつかみ、相手めがけて放り投げた。」
+出力はJSONのみ：{"kind":"chat","value":"1文"}"""
+
+## What it did, after a retold move (the move itself is the model's).
+const MISS_TAIL := ["だが、手応えはなかった。", "だが、わずかにそれた。", "相手は体を揺らし、それをかわした。"]
+
+static func miss_tail(world) -> String:
+	return pick(world, MISS_TAIL, "miss-tail")
+
+## Words that claim an outcome. A retelling may use them only if the rules
+## decided that outcome.
+const CLAIMS := {
+	"kill": ["動かなくなった", "息絶え", "死んだ", "仕留め", "倒した", "動かない", "絶命", "とどめ"],
+	"down": ["倒れ", "転倒", "転が", "崩れ", "膝をつ"],
+	"hit": ["命中", "当たっ", "当た", "ぶつか", "直撃", "入った", "捉え", "叩きつけ", "打ち抜", "突き刺", "切りつけ", "手応え"],
+	"bitten": ["噛まれ", "噛みつ", "歯が"],
+}
+
+## The retold move, or "" when it says more than the move (any outcome at all:
+## the outcome is the rules' own sentence, added after it).
+const MOVE_CLAIMS := ["当た", "命中", "手応え", "直撃", "捉え", "外れ", "かわ", "それた", "空を切", "押しつけ", "押さえつけ", "倒れた", "崩れ", "止まった", "動かなくな"]
+
+static func accept_move(line: String) -> String:
+	var text := line.strip_edges().trim_suffix("。") + "。"
+	if text.length() > 50 or text.length() < 6:
+		return ""
+	for word in MOVE_CLAIMS:
+		if text.contains(word):
+			return ""
+	# Verbs of striking are the move itself; outcomes are not.
+	return accept(text, {"hit": true})
+
+## The retold line, or "" when it says more (or other) than what happened.
+static func accept(line: String, outcome: Dictionary) -> String:
+	var text := line.strip_edges()
+	if text.is_empty() or text.length() > 90 or text.contains("%") or text.contains("「"):
+		return ""
+	for c in "0123456789０１２３４５６７８９":
+		if text.contains(c):
+			return ""
+	for claim in CLAIMS:
+		if bool(outcome.get(claim, false)):
+			continue
+		for word in CLAIMS[claim]:
+			if text.contains(word):
+				return ""
+	return text
+
+## The facts handed to the model (no numbers, no odds).
+static func facts(outcome: Dictionary, part: String, weapon_name: String) -> String:
+	var parts: Array = ["使った物：%s" % weapon_name, "狙った所：%s" % {"head": "頭", "legs": "脚", "arms": "腕", "torso": "胴", "": "体"}.get(part, "体")]
+	if bool(outcome.get("kill", false)):
+		parts.append("結果：相手は動かなくなった")
+	elif bool(outcome.get("down", false)):
+		parts.append("結果：当たって、相手は倒れた")
+	elif bool(outcome.get("hit", false)):
+		parts.append("結果：当たったが、相手はまだ動いている")
+	else:
+		parts.append("結果：外れた")
+	return "、".join(parts)
