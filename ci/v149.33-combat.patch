+extends SceneTree
+## v149.33 combat stage 8: the result of a fight, achievements and titles,
+## the ending — and a run through the whole combat system against the
+## checks of the spec: existing things still work, save/load mid-fight, the
+## model cannot change a result, housemates act sensibly, no double kills,
+## no double experience or loot, positions agree with time, and danger can
+## always be avoided without fighting.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+const CombatRecord = preload("res://scripts/combat_record.gd")
+const Weapons = preload("res://scripts/weapons.gd")
+const Remains = preload("res://scripts/remains.gd")
+const Allies = preload("res://scripts/allies.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const Chronicle = preload("res://scripts/chronicle.gd")
+const Siege = preload("res://scripts/siege.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+class FakeModel:
+	extends RefCounted
+	var queue: Array = []
+	var requests := 0
+	func model_available() -> bool:
+		return true
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, _text: String, _input: String) -> bool:
+		requests += 1
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		pass
+
+func fight(w, place: String, count: int, near: bool = true) -> void:
+	w.s.walkers.places[place] = count
+	w.s.walkers.encounter = {"place": place, "count": count, "near": near, "since": int(w.s.minute), "from": "屋外"}
+	Combat.sync(w)
+
+func play_out(g, w, order: String, limit: int = 30) -> void:
+	for i in limit:
+		if not Combat.active(w) or float(w.s.health) <= 0:
+			return
+		w.s.health = 100.0
+		w.s.bitten = false
+		await g._on_command(order)
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 88
+	p.cohabitants = 0
+	g._start_new_game(p)
