diff --git a/qa/autoplay.gd b/qa/autoplay.gd
new file mode 100644
index 0000000..9136871
--- /dev/null
+++ b/qa/autoplay.gd
@@ -0,0 +1,182 @@
+extends SceneTree
+## A sensible player, played automatically for DCJ_DAYS days (DCJ_SEED).
+## Prints notable moments and a line per day; nothing is cheated.
+const Main = preload("res://main.tscn")
+const Combat = preload("res://scripts/combat.gd")
+const Shelter = preload("res://scripts/shelter.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+var g
+var steps := 0
+var fights := 0
+var trips := 0
+func _initialize() -> void:
+	call_deferred("run")
+func w():
+	return g.world
+func do(cmd: String) -> void:
+	steps += 1
+	var tail: String = str(g.log_entries[-1]) if not g.log_entries.is_empty() else ""
+	await g._on_command(cmd)
+	while g.advancing:
+		await process_frame
+	var start := 0
+	for i in g.log_entries.size():
+		if str(g.log_entries[i]) == tail:
+			start = i + 1
+	var verbose := OS.get_environment("DCJ_VERBOSE") == "1"
+	if verbose:
+		print("> ", cmd)
+	for i in range(start, g.log_entries.size()):
+		var line: String = str(g.log_entries[i]).replace("\n", " / ")
+		if verbose or line.begins_with("【") or line.contains("噛まれ") or line.contains("つかみかか") or line.contains("物語は") or line.contains("倒した") or line.contains("解釈でき") or line.contains("足りない") or line.contains("できない"):
+			print("  %s %s [%s] %s | %s" % [g.day_label.text, g.clock_label.text, g.location, cmd, line.left(240)])
+func hour() -> float:
+	return float(w().hour_of_day())
+func home() -> bool:
+	return g.location in ["寝室", "居間", "台所", "廊下", "玄関"]
+func fight_out() -> void:
+	var n := 0
+	while Combat.active(w()) and float(w().s.health) > 0 and n < 30:
+		n += 1
+		var count: int = Combat.zombies(w()).size()
+		var noticed := bool(w().s.walkers.encounter.get("noticed", w().s.walkers.encounter.get("near", false)))
+		if not noticed and n == 1:
+			await do("隠れる")
+		elif count >= 3 or float(w().s.health) < 35:
+			await do("逃げる")
+		else:
+			await do("脚を払って、倒れたら頭を叩く")
+	if n > 0:
+		fights += 1
+func go(place: String) -> void:
+	await do(place + "へ行く")
+	await fight_out()
+func crowd(place: String) -> bool:
+	return Walkers.count(w(), place) + Walkers.horde_at(w(), place) >= 5
+func trip() -> void:
+	# A player looks out first, and does not walk toward a crowd they can hear.
+	await do("窓から外を見る")
+	trips += 1
+	var s = w().s
+	var sites: Dictionary = s.district.sites
+	if not bool(sites["コンビニ"].vacant) and not crowd("商店通り") and hour() >= 6 and hour() < 22 and float(s.get("money", 50000)) > 3000:
+		for shop in ["コンビニ", "食品店"]:
+			if float(w().s.food) + float(w().s.district.bag.food) >= 3.0:
+				break
+			if bool(sites[shop].vacant):
+				continue
+			await go(shop)
+			if g.location != shop:
+				break
+			for n in [3, 2, 1]:
+				var before := float(w().s.district.bag.food)
+				await do("食料を%d個買う" % n)
+				if float(w().s.district.bag.food) > before:
+					break
+			for n in [4, 2, 1]:
+				var before_w := float(w().s.district.bag.water)
+				await do("水を%d本買う" % n)
+				if float(w().s.district.bag.water) > before_w:
+					break
+	elif Shelter.is_open(w()) and not crowd("住宅街") and int(Shelter.state(w()).ration_day) != Shelter._day(w()):
+		await go("避難所")
+		if g.location == "避難所":
+			await do("配給を受け取る")
+	else:
+		var best := ""
+		for place in sites:
+			if bool(sites[place].vacant) and float(sites[place].food) > 0.3 and not crowd(place) and not crowd("商店通り" if place in ["コンビニ", "食品店", "金物店", "薬局"] else "住宅街"):
+				best = place
+				break
+		if best.is_empty():
+			print("  %s %s | (行ける所に食料が残っていない)" % [g.day_label.text, g.clock_label.text])
+			return
+		await go(best)
+		if g.location == best:
+			await do("物資を探索する")
+			await fight_out()
+			if bool(sites[best].vacant) and Combat.zombies(w()).is_empty():
+				await do("武器を探す")
+	if float(w().s.health) > 0:
+		await do("家に帰る")
+		await fight_out()
+		if not home():
+			await do("家に帰る")
+			await fight_out()
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED"))
+	if OS.get_environment("DCJ_HOUSING") != "":
+		p.housing = OS.get_environment("DCJ_HOUSING")
+	if OS.get_environment("DCJ_MATES") != "":
+		var names: Array = OS.get_environment("DCJ_MATES").split(",")
+		p.cohabitants = names.size()
+		p.companion_names = names
+		p.companion_genders = ["女性", "男性", "女性"].slice(0, names.size())
+	g._start_new_game(p)
+	print("INTRO: ", g.intro_body.text.replace("\n", " / ").left(400))
+	g._finish_intro()
+	g.local_model.enabled = false
+	var days := int(OS.get_environment("DCJ_DAYS"))
+	var last_day := -1
+	var filled := false
+	var dark := false
+	while float(w().s.health) > 0 and int(w().s.minute) / 1440 < days and steps < 9000:
+		var s = w().s
+		var day := int(s.minute) / 1440
+		if day != last_day:
+			last_day = day
+			if OS.get_environment("DCJ_SAVELOAD") == "1" and day > 0 and not Combat.active(w()):
+				var before_state := JSON.stringify(w().s)
+				var before_place: String = g.location
+				g._save()
+				g._load()
+				for i in 3: await process_frame
+				var after_state := JSON.stringify(w().s)
+				if before_state != after_state or before_place != g.location:
+					var a: Dictionary = JSON.parse_string(before_state)
+					var b: Dictionary = JSON.parse_string(after_state)
+					var diff: Array = []
+					for key in a:
+						if JSON.stringify(a[key]) != JSON.stringify(b.get(key)):
+							diff.append(key)
+					for key in b:
+						if not a.has(key):
+							diff.append("+" + key)
+					print("SAVELOAD MISMATCH day %d place %s->%s keys %s" % [day + 1, before_place, g.location, diff])
+				else:
+					print("SAVELOAD ok day %d" % (day + 1))
+				s = w().s
+			print("DAY %d %s | 街:%s 体%.0f 心%.0f 食%.1f 水%.1f 携行食%.1f | 倒した%d 噛まれ:%s 戦闘%d 外出%d | 感染者:%s 避難所:%s" % [day + 1, g.clock_label.text, s.society, s.health, float(s.get("mood", 70)), s.food, s.water, float(s.get("carried_food", 0.0)), int(s.walkers.get("killed", 0)), str(s.get("bitten", false)), fights, trips, s.walkers.places, Shelter.status(w())])
+		if Combat.active(w()):
+			await fight_out(); continue
+		if not home():
+			if g.location == "避難所" and Shelter.is_open(w()) and (float(s.health) < 60 or hour() >= 17 or hour() < 6):
+				await do("避難所で寝る"); continue
+			await do("家に帰る"); await fight_out(); continue
+		if not filled and str(s.society) != "normal":
+			filled = true
+			await do("浴槽に水をためる")
+		if not dark and str(s.society) in ["disrupted", "emergency"]:
+			dark = true
+			await do("家じゅうの窓をふさぐ")
+		var porch := Walkers.count(w(), "建物前") + Walkers.count(w(), "屋外")
+		if porch > 0 and hour() >= 6 and hour() < 20:
+			await do("通りが空くまで待つ"); continue
+		if (float(s.food) < 2.0 or float(s.water) < 2.5) and hour() >= 7 and hour() < 17 and porch == 0:
+			await trip(); continue
+		if hour() >= 21 or hour() < 6 or float(s.fatigue) > 65:
+			await do("寝る"); continue
+		if float(s.health) < 70 and s.get("combat") is Dictionary and not s.combat.get("wounds", []).is_empty() and float(s.inventory.get("bandage", 0)) > 0:
+			await do("傷を手当てする")
+		if float(s.hunger) > 55:
+			await do("食事する"); continue
+		await do("1時間休息")
+	print("MATES ", w().s.household_members.map(func(m): return "%s:%s:%.0f" % [m.name, m.get("location", "?"), float(m.health)]))
+	print("END day %d health %.0f bitten %s killed %d fights %d trips %d steps %d" % [int(w().s.minute) / 1440 + 1, w().s.health, str(w().s.get("bitten", false)), int(w().s.walkers.get("killed", 0)), fights, trips, steps])
+	print(load("res://scripts/combat_record.gd").records_text(w()))
+	quit()
