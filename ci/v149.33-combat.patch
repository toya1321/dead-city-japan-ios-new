+extends RefCounted
+## v149.33 (combat stage 6): the dead had lives. Each walker carries what
+## that person carried — decided when it is first seen, from who it was (a
+## survivor met earlier, the neighbour, a housemate who rose, or someone
+## from the town), never made up after the fight. What it carried is found
+## only by searching the body, once. Some things lead somewhere: a key with
+## an address tag, a memo about a locker, a phone's last message.
+##
+## s.remains = {bodies: {place: [{id, who, name, items, searched, at}]},
+##              leads: [{place, what, food, water, parts, bandage, text, done}],
+##              known: [{name, place, kind}], claimed: [name]}
+
+const Survivors = preload("res://scripts/survivors.gd")
+const Chronicle = preload("res://scripts/chronicle.gd")
+const Mood = preload("res://scripts/mood.gd")
+
+const ITEMS := {
+	"wallet": "財布", "phone": "携帯電話", "key": "住所のタグがついた鍵", "memo": "折りたたんだメモ",
+	"medicine": "常備薬と包帯", "tools": "小さな工具", "bag": "小さなリュック", "cigarettes": "タバコ",
+	"photo": "一枚の写真", "house_key": "隣の家の鍵",
+}
+## Who the town's dead were, and what such a person carries.
+const LIVES := [
+	["スーツ姿の男", ["wallet", "phone", "key"]], ["制服の高校生", ["phone", "bag"]], ["エプロン姿の女", ["key", "wallet"]],
+	["作業着の男", ["tools", "cigarettes", "key"]], ["パジャマ姿の老人", ["medicine", "wallet"]], ["ジャージの若者", ["bag", "phone"]],
+	["配達員の制服の男", ["memo", "bag"]], ["看護師の服の女", ["medicine", "memo"]], ["コートの女", ["wallet", "phone"]],
+]
+const BODY_CAP := 6
+const BODY_DAYS := 20
+## Where a key or a memo may lead (a place on the map, and what is there).
+const LEAD_PLACES := {
+	"key": [["近所の空き家", "鍵の合う勝手口"], ["住宅街", "タグの住所の家"]],
+	"memo": [["駅前", "コインロッカー"], ["商店通り", "閉まった店の裏の倉庫"], ["コンビニ", "バックヤードの棚の奥"]],
+}
+
+static func state(world) -> Dictionary:
+	if not world.s.get("remains") is Dictionary:
+		world.s.remains = {"bodies": {}, "leads": [], "known": [], "claimed": []}
+	var st: Dictionary = world.s.remains
+	for key in ["bodies"]:
+		if not st.get(key) is Dictionary:
+			st[key] = {}
+	for key in ["leads", "known", "claimed"]:
+		if not st.get(key) is Array:
+			st[key] = []
+	return st
+
+static func valid(value: Variant) -> bool:
+	if not value is Dictionary:
+		return false
+	if value.has("bodies") and not value.bodies is Dictionary:
+		return false
+	for key in ["leads", "known", "claimed"]:
+		if value.has(key) and not value[key] is Array:
+			return false
+	for place in value.get("bodies", {}):
+		if not value.bodies[place] is Array or value.bodies[place].size() > 50:
+			return false
+	return true
+
+## A housemate who died and rose is remembered where they rose.
+static func remember(world, name: String, place: String, kind: String) -> void:
+	state(world).known.append({"name": name, "place": place, "kind": kind})
+
+## Who a newly seen walker at this place was. Known people first (once
+## each), then someone from the town, from the world's dice.
+static func life_for(world, place: String, serial: int) -> Dictionary:
+	var st := state(world)
+	var claimed: Array = st.claimed
+	for k in st.known:
+		if str(k.place) == place and not str(k.name) in claimed:
+			claimed.append(str(k.name))
+			return {"who": str(k.name), "name": str(k.name), "items": ["photo"] if str(k.kind) == "mate" else ["wallet"], "kind": str(k.kind)}
+	var people: Dictionary = world.s.get("survivors", {}).get("people", {})
+	for id in people:
+		var p: Dictionary = people[id]
+		if str(p.get("status", "")) != "dead" or str(p.get("place", "")) != place or str(p.get("cause", "")) not in ["bitten", "turned"] or str(p.name) in claimed:
+			continue
+		claimed.append(str(p.name))
+		var items: Array = ["wallet"]
+		if bool(p.get("neighbor", false)):
+			items.append("house_key")
+		else:
+			for offer in p.get("offers", []):
+				var mapped: String = {"bandage": "medicine", "cigarettes": "cigarettes", "food": "bag", "water": "bag", "wood": "tools", "parts": "tools"}.get(str(offer), "")
+				if not mapped.is_empty():
+					items.append(mapped)
+					break
+		return {"who": str(p.label), "name": str(p.name), "items": items, "kind": "neighbor" if bool(p.get("neighbor", false)) else "survivor"}
+	var minute := int(world.s.minute)
+	var life: Array = LIVES[world.draw(minute, serial * 29 + place.hash() % 97, "life", LIVES.size())]
+	var items: Array = []
+	for item in life[1]:
+		if world.draw(minute, serial * 31 + str(item).hash() % 89, "life-item", 100) < 55:
+			items.append(item)
+	return {"who": str(life[0]), "name": "", "items": items, "kind": "town"}
+
+## A walker that fell stays where it fell, with what it carried.
+static func add_body(world, place: String, z: Dictionary) -> void:
+	var st := state(world)
+	var life: Dictionary = z.get("life", {})
+	if not st.bodies.has(place):
+		st.bodies[place] = []
+	var list: Array = st.bodies[place]
+	list.append({"id": str(z.get("id", "")), "who": str(life.get("who", "見知らぬ人")), "name": str(life.get("name", "")), "items": life.get("items", []).duplicate(), "kind": str(life.get("kind", "town")), "searched": false, "at": int(world.s.minute)})
+	while list.size() > BODY_CAP:
+		list.pop_front()
+
+## Read-only: looking does not create the record.
+static func _peek(world) -> Dictionary:
+	return world.s.get("remains") if world.s.get("remains") is Dictionary else {}
+
+static func unsearched(world, place: String) -> Array:
+	var now := int(world.s.minute)
+	var bodies: Dictionary = _peek(world).get("bodies", {})
+	return bodies.get(place, []).filter(func(b): return not bool(b.searched) and now - int(b.at) < BODY_DAYS * 1440)
+
+## Searching the most recent body here. Returns the lines.
+static func search(world, place: String) -> String:
+	var bodies := unsearched(world, place)
+	if bodies.is_empty():
+		return "ここには、調べていない遺体はない。"
+	var body: Dictionary = bodies[-1]
+	body.searched = true
+	world.advance_safe(10)
+	var lines: Array = []
+	var who := str(body.who)
+	if str(body.kind) in ["survivor", "neighbor", "mate"]:
+		lines.append("倒れているのは、%sだった。" % who)
+	else:
+		lines.append("%sのポケットと持ち物を調べた。（10分）" % who)
+	if body.items.is_empty():
+		lines.append("何も持っていなかった。")
+	for item in body.items:
+		lines.append(_take(world, str(item), body, place))
+	if str(body.kind) in ["survivor", "neighbor", "mate"]:
+		Chronicle.note(world, "%sの遺体を見つけ、持ち物を調べた。" % who, "remains", str(body.name))
+	return "\n".join(lines)
+
+## v149.33: a blade left in a body stays there, to be taken back later.
+static func leave_blade(world, place: String, type: String, wear: int) -> bool:
+	var list: Array = state(world).bodies.get(place, [])
+	if list.is_empty():
+		return false
+	var body: Dictionary = list[-1]
+	if bool(body.searched):
+		body.items = []
+		body.searched = false
+	body.items.append("blade:%s:%d" % [type, wear])
+	return true
+
+static func _take(world, item: String, body: Dictionary, place: String) -> String:
+	var minute := int(world.s.minute)
+	if item.begins_with("blade:"):
+		var parts := item.split(":")
+		var Weapons = load("res://scripts/weapons.gd")
+		Weapons.state(world).weapons.append({"type": parts[1], "wear": int(parts[2]) if parts.size() > 2 else 30})
+		return "頭に刺さったままだった%sを、力をこめて引き抜いた。" % Weapons.name_of(parts[1])
+	var salt := str(body.id).hash() % 997 + item.hash() % 101
+	match item:
+		"wallet":
+			var cash: int = 1000 * (1 + world.draw(minute, salt, "wallet", 8))
+			world.s.cash = int(world.s.get("cash", 0)) + cash
+			if not str(body.name).is_empty():
+				return "財布の中の免許証に、%sの名前があった。（現金%d円）" % [body.name, cash]
+			return "財布に、現金が%d円。免許証の顔写真は、知らない誰かの穏やかな笑顔だった。" % cash
+		"phone":
+			var horde: Dictionary = world.s.get("walkers", {}).get("horde", {})
+			if not horde.is_empty():
+				return "携帯電話の画面に、最後のメッセージが残っていた。「%sの方、ものすごい数。近づくな」" % str(horde.get("place", "駅前"))
+			return "携帯電話は、もう電池が切れていた。待ち受けの写真だけが、一瞬だけ光った。"
+		"medicine":
+			world.s.inventory.bandage = int(world.s.inventory.get("bandage", 0)) + 1
+			return "ポーチに、常備薬と包帯が入っていた。（包帯 +1）"
+		"tools":
+			world.s.inventory.parts = int(world.s.inventory.get("parts", 0)) + 1
+			return "腰の袋に、小さな工具が入っていた。（部品 +1）"
+		"cigarettes":
+			world.s.cigarettes = int(world.s.get("cigarettes", 0)) + 6
+			return "胸ポケットに、タバコが半分ほど残った箱。（タバコ +6本）"
+		"bag":
+			var bag: Dictionary = world.s.district.bag
+			bag.food = minf(4.0, float(bag.get("food", 0.0)) + 0.5)
+			bag.water = minf(8.0, float(bag.get("water", 0.0)) + 0.5)
+			return "小さなリュックに、菓子パンと水のペットボトル。（持ち出し袋に 食料0.5・水0.5L）"
+		"photo":
+			Mood.change(world.s, -4.0)
+			return "ポケットから、写真が一枚出てきた。みんなで笑っている写真だ。……持って帰ることにした。"
+		"house_key":
+			return _lead(world, "house_key", "住宅街", "隣の家", {"food": 3.0, "water": 6.0, "bandage": 1}, "%sの家の鍵だ。隣の家には、まだ食べ物が残っているかもしれない。（住宅街で「隣の家の鍵を使う」）" % str(body.name))
+		"key", "memo":
+			var options: Array = LEAD_PLACES[item]
+			var pick: Array = options[world.draw(minute, salt, "lead-" + item, options.size())]
+			var what := str(pick[1])
+			if item == "key":
+				return _lead(world, item, str(pick[0]), what, {"food": 1.5, "water": 3.0}, "鍵に、住所を書いたタグがついている。%sの、%sのものらしい。（%sで「鍵を使う」）" % [pick[0], what, pick[0]])
+			return _lead(world, item, str(pick[0]), what, {"food": 2.0, "water": 4.0, "parts": 1}, "メモに、走り書きがある。「%s　%s　水と缶詰」（%sで「メモの場所を調べる」）" % [pick[0], what, pick[0]])
+	return ""
+
+static func _lead(world, item: String, place: String, what: String, goods: Dictionary, text: String) -> String:
+	var st := state(world)
+	var lead := {"item": item, "place": place, "what": what, "done": false}
+	lead.merge(goods)
+	st.leads.append(lead)
+	return text
+
+static func open_leads(world, place: String) -> Array:
+	return _peek(world).get("leads", []).filter(func(l): return not bool(l.done) and str(l.place) == place)
+
+## Following a lead at its place: what was there goes into the bag.
+static func follow(world, place: String) -> String:
+	var leads := open_leads(world, place)
+	if leads.is_empty():
+		return ""
+	var lead: Dictionary = leads[0]
+	lead.done = true
+	world.advance_safe(15)
+	var bag: Dictionary = world.s.district.bag
+	var food := float(lead.get("food", 0.0))
+	var water := float(lead.get("water", 0.0))
+	var took_food := minf(food, maxf(0.0, 4.0 - float(bag.get("food", 0.0))))
+	var took_water := minf(water, maxf(0.0, 8.0 - float(bag.get("water", 0.0))))
+	bag.food = float(bag.get("food", 0.0)) + took_food
+	bag.water = float(bag.get("water", 0.0)) + took_water
+	var extra := ""
+	if int(lead.get("parts", 0)) > 0:
+		world.s.inventory.parts = int(world.s.inventory.get("parts", 0)) + int(lead.parts)
+		extra += "、部品%d" % int(lead.parts)
+	if int(lead.get("bandage", 0)) > 0:
+		world.s.inventory.bandage = int(world.s.inventory.get("bandage", 0)) + int(lead.bandage)
+		extra += "、包帯%d" % int(lead.bandage)
+	var left := (food - took_food) + (water - took_water)
+	var opener: String = {"house_key": "鍵を回すと、隣の家の玄関が開いた。台所の戸棚に、手つかずの食料が残っていた。", "key": "鍵は、%sに合った。中は荒らされていなかった。" % str(lead.what), "memo": "メモの通り、%sに物資が隠してあった。" % str(lead.what)}.get(str(lead.item), "")
+	return "%s（15分。持ち出し袋に 食料%.1f・水%.1fL%s%s）" % [opener, took_food, took_water, extra, "。袋に入りきらない分は置いてきた" if left > 0.05 else ""]
