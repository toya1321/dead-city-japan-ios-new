+extends SceneTree
+## v149.33 combat stage 4: housemates act on their own in a fight, take
+## orders by name, and are never bitten by a single roll: a grab is a
+## warning the player can answer.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+const Allies = preload("res://scripts/allies.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func fight(w, count: int) -> void:
+	w.s.walkers.places["商店通り"] = count
+	w.s.walkers.encounter = {"place": "商店通り", "count": count, "near": true, "since": int(w.s.minute), "from": "屋外"}
+	Combat.sync(w)
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 44
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.minute = 2 * 60
+	# Two housemates from survivors: one brave, one timid.
+	var ids: Array = Survivors.ensure(w).people.keys().filter(func(k): return not bool(Survivors.ensure(w).people[k].get("neighbor", false)) and str(Survivors.ensure(w).people[k].place) != "避難所")
+	Survivors.ensure(w).people[ids[0]].traits.courage = 85
+	Survivors.ensure(w).people[ids[0]].job = "元自衛官"
+	Survivors.ensure(w).people[ids[1]].traits.courage = 15
+	Survivors._join(w, ids[0])
+	Survivors._join(w, ids[1])
+	var brave: Dictionary = w.s.household_members[0]
+	var timid: Dictionary = w.s.household_members[1]
+	g.location = "商店通り"
+	g._sync_player_position()
+	for m in w.s.household_members:
+		m.location = "商店通り"
+		m.activity = "外出"
+	var present := [0, 1]
+
+	fight(w, 2)
+	var allies := Allies.ensure(w, present)
+	check(str(allies["0"].stance) == "fight" and str(allies["1"].stance) == "back", "the brave one stands beside the player; the timid one hangs back")
+	check(Allies.status_words(w).contains("隣で構えている") and Allies.status_words(w).contains("後ろにいる"), "the panel says where each one is")
+
+	# Orders by name, and refusals by character.
+	var said: Array = Allies.order(w, "%s、一緒に戦って" % timid.name, present)
+	check(str(said).contains("動かない") and str(allies["1"].stance) == "back", "the timid one cannot make themselves fight")
+	Allies.order(w, "%sは下がって" % brave.name, present)
+	check(str(allies["0"].stance) == "back", "下がって: they step back")
+	Allies.order(w, "%s、前に出て" % brave.name, present)
+	check(str(allies["0"].stance) == "fight" and bool(allies["0"].risky), "前に出て: they go, and it is a risky order")
+	# An order is not the player's own move.
+	var killed := int(w.s.walkers.get("killed", 0))
+	var log_size: int = g.log_entries.size()
+	await g._on_command("%sは後ろに下がって" % brave.name)
+	check(str(allies["0"].stance) == "back" and not str(g.log_entries.slice(log_size)).contains("振った") and int(w.s.walkers.get("killed", 0)) == killed, "「Xは後ろに下がって」moves X, not the player")
+	allies["0"].risky = false
+
+	# Only those standing in the fight can be grabbed.
+	allies["0"].stance = "back"
+	var victims := {}
+	for r in 50:
+		victims[Allies.pick_victim(w, r)] = true
+	check(victims.keys() == [""], "no one standing behind is ever the one grabbed")
+	allies["0"].stance = "fight"
+	victims = {}
+	for r in 50:
+		victims[Allies.pick_victim(w, r)] = true
+	check(victims.has("0") and victims.has(""), "one standing beside may be grabbed instead of the player")
+
+	# A grab is a warning; the bite cannot come in the same moment.
+	var zid := str(Combat.front(w).id)
+	var warned := Allies.grab(w, "0", zid)
+	check(warned.contains("助ける") and Allies.held(w) == ["0"] and not bool(brave.get("bitten", false)), "a housemate grabbed: a warning and a way to answer it")
+	var same_beat := Allies.act(w, func(_t): return 0, Combat)
+	check(not bool(brave.get("bitten", false)) and same_beat.is_empty(), "no bite in the same moment as the grab")
+	# Answered: the player pulls them free.
+	check(Allies.rescue(w, "0", 0, 60).contains("引きはがした") and Allies.held(w).is_empty(), "the player pulls them free")
+	# Through the game: "Xを助ける".
+	Allies.grab(w, "0", zid)
+	await g._on_command("%sを助ける" % brave.name)
+	check(str(g.log_entries.slice(-6)).contains("引きはが"), "「Xを助ける」 is answered with a rescue attempt")
+
+	# Not answered: after a moment, they free themselves or are bitten.
+	var bitten := 0
+	var freed := 0
+	for trial in 40:
+		brave.bitten = false
+		fight(w, 2)
+		Allies.ensure(w, present)
+		w.s.walkers.encounter.allies["0"] = {"stance": "fight", "held_by": "", "held_at": -1, "order": "", "risky": false, "kills": 0}
+		w.s.walkers.encounter.beat = trial * 3
+		Allies.grab(w, "0", str(Combat.front(w).id))
+		w.s.walkers.encounter.beat = trial * 3 + 1
+		w.s.minute += 1
+		var rolled := [0]
+		Allies.act(w, func(tag): rolled[0] += 1; return w.draw(int(w.s.minute), rolled[0] * 7 + trial, tag, 100), Combat)
+		if bool(brave.get("bitten", false)):
+			bitten += 1
+		elif Allies.held(w).is_empty():
+			freed += 1
+	check(bitten > 0 and freed > 0 and bitten < 40, "left unanswered, some free themselves and some are bitten (%d bitten, %d freed)" % [bitten, freed])
+	brave.bitten = false
+	brave.erase("bitten_at")
+
+	# Fear: the timid one, put in front, breaks away when two crowd in.
+	fight(w, 3)
+	Allies.ensure(w, present)
+	for z in Combat.zombies(w):
+		z.dist = 1.0
+	w.s.walkers.encounter.allies["1"].stance = "fight"
+	w.s.walkers.encounter.allies["1"].order = ""
+	var lines := Allies.act(w, func(_t): return 99, Combat)
+	check(str(w.s.walkers.encounter.allies["1"].stance) == "back" and str(lines).contains("下がった"), "a frightened housemate steps back on their own")
+
+	# Running while one is held leaves them.
+	fight(w, 2)
+	Allies.ensure(w, present)
+	w.s.walkers.encounter.allies["0"] = {"stance": "fight", "held_by": str(Combat.front(w).id), "held_at": 0, "order": "", "risky": false, "kills": 0}
+	var outcome: Array = Allies.on_flee(w)
+	check(str(outcome).contains(str(brave.name)), "running while a housemate is held leaves them to it")
+	brave.bitten = false
+
+	# The old rules never bite a housemate directly while fleeing or hiding.
+	for i in 30:
+		fight(w, 3)
