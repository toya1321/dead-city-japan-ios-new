+extends SceneTree
+## Screenshot of an encounter with the combat panel (DCJ_OUT=png).
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	p.cohabitants = 0
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	w.s.society = "emergency"
+	w.s.walkers.places["屋外"] = 3
+	g.location = "屋外"
+	g._sync_player_position()
+	w.s.walkers.encounter = {"place": "屋外", "count": 3, "near": false, "since": int(w.s.minute), "from": "建物前"}
+	g._refresh()
+	for line in Combat.status_lines(w): print("A ", line)
+	await g._on_command("様子を見る")
+	for line in Combat.status_lines(w): print("B ", line)
+	for z in Combat.zombies(w): print("   ", z.id, " ", z.dist, " ", z.kind)
+	await g._on_command("様子を見る")
+	for line in Combat.status_lines(w): print("C ", line)
+	for i in 10: await process_frame
+	root.get_texture().get_image().save_png(OS.get_environment("DCJ_OUT"))
+	print(g.log_entries.slice(-3))
+	quit()
diff --git a/scripts/combat.gd b/scripts/combat.gd
new file mode 100644
index 0000000..b9b9c67
--- /dev/null
+++ b/scripts/combat.gd
@@ -0,0 +1,208 @@
+extends RefCounted
+## v149.33 (combat stage 1): each walker in an encounter as its own body —
+## distance, state, wounds — and how many seconds an action takes. The
+## outcome of actions is still decided in walkers.gd (stage 2 replaces it);
+## this keeps the bodies, the clock and what the player can see.
+##
+## encounter.zombies = [{id, dist, state, hurt{head,arms,legs,torso}, kind}]
+##   state: standing / downed / crawling / pinned
+##   kind:  fresh (recently turned, quicker) / old (decayed, slower)
+## Only the nearest few are tracked one by one; the rest stay a number.
+## Old saves have no zombies list: it is made from the count on first use.
+
+const Walkers = preload("res://scripts/walkers.gd")
+
+const TRACKED := 6
+const SPEED := {"fresh": 1.3, "old": 0.8}
+const CRAWL_SPEED := 0.3
+## A noticed walker stops at arm's reach; the grab itself is walkers.gd's.
+const REACH := 0.6
+## Base seconds for each encounter action (before body and place).
+const BASE_SECONDS := {"look": 2.0, "fight": 2.0, "distract": 3.0, "hide": 4.0, "flee": 4.0}
+
+static func active(world) -> bool:
+	return not Walkers.ensure(world).encounter.is_empty()
+
+static func zombies(world) -> Array:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	return enc.get("zombies", []) if enc.get("zombies", []) is Array else []
+
+## Keeps the tracked bodies in step with the walkers counted at the place:
+## new ones are added at a distance, the killed or departed are removed
+## nearest first (a kill in walkers.gd is always the one in front).
+static func sync(world) -> void:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	if enc.is_empty():
+		return
+	if not enc.get("zombies") is Array:
+		enc.zombies = []
+	if not enc.has("clock"):
+		enc.clock = 0.0
+	var list: Array = enc.zombies
+	var total := maxi(1, Walkers.count(world, str(enc.place)))
+	var want := mini(total, TRACKED)
+	_sort(list)
+	while list.size() > want:
+		list.pop_front()
+	var serial := int(enc.get("serial", 0))
+	while list.size() < want:
+		serial += 1
+		var minute := int(world.s.minute)
+		var near := bool(enc.get("near", false)) and list.is_empty()
+		var dist := 2.0 if near else 5.0 + float(world.draw(minute, serial * 7, "z-dist", 120)) / 10.0
+		list.append({
+			"id": "z%d_%d" % [int(enc.get("since", minute)), serial],
+			"dist": dist,
+			"state": "standing",
+			"hurt": {"head": 0, "arms": 0, "legs": 0, "torso": 0},
+			"kind": "fresh" if world.draw(minute, serial * 11, "z-kind", 100) < 35 else "old",
+		})
+	enc.serial = serial
+	# Noticed and close (walkers.gd's `near`): the front one has closed in.
+	if bool(enc.get("near", false)) and not list.is_empty():
+		_sort(list)
+		list[0].dist = minf(float(list[0].dist), 2.0)
+	_sort(list)
+
+static func _sort(list: Array) -> void:
+	list.sort_custom(func(a, b): return float(a.dist) < float(b.dist))
+
+## How long an action takes for this body in this place, in seconds.
+static func seconds(world, kind: String) -> float:
+	var t := float(BASE_SECONDS.get(kind, 2.0))
+	var tired := clampf(float(world.s.get("fatigue", 0.0)) / 100.0, 0.0, 1.0)
+	t *= 1.0 + 0.5 * tired
+	t *= 1.0 + 0.08 * minf(float(world.s.get("injuries", 0)), 5.0)
+	if kind == "flee" and terrain(world) == "corridor":
+		t *= 1.2
+	return snappedf(t, 0.1)
+
+## Time passes for the walkers too: those that have noticed come closer.
+static func tick(world, secs: float) -> void:
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	if enc.is_empty():
+		return
+	enc.clock = float(enc.get("clock", 0.0)) + secs
+	if not bool(enc.get("near", false)):
+		return
+	for z in zombies(world):
+		var speed := 0.0
+		match str(z.state):
+			"standing": speed = float(SPEED.get(str(z.kind), 0.8))
+			"crawling": speed = CRAWL_SPEED
+		z.dist = maxf(REACH, float(z.dist) - speed * secs)
+	_sort(zombies(world))
+
+## Where the fight happens, from the place.
+static func terrain(world, place: String = "") -> String:
+	if place.is_empty():
+		place = str(Walkers.ensure(world).encounter.get("place", ""))
+	if place in ["廊下", "共用廊下"]:
+		return "corridor"
+	if place in ["玄関"]:
+		return "doorway"
+	if place in ["コンビニ", "デパート", "デパート地下", "食品店", "金物店", "薬局", "近所の空き家"]:
+		return "shop"
+	if place in ["寝室", "居間", "台所"]:
+		return "room"
+	return "street"
+
+const TERRAIN_WORDS := {"corridor": "狭い廊下", "doorway": "玄関先", "shop": "建物の中（棚や物がある）", "room": "部屋の中", "street": "見通しのいい通り"}
+
+## Dark enough that numbers and distances are guesses.
+static func dark(world) -> bool:
+	var hour: float = world.hour_of_day()
+	var night := hour < 6.0 or hour >= 18.0
+	var place := str(Walkers.ensure(world).encounter.get("place", ""))
+	if terrain(world, place) in ["street"]:
+		return night
+	return night or not bool(world.s.get("grid_online", true))
+
+static func distance_words(d: float, dark_now: bool) -> String:
+	if d <= 1.0:
+		return "手が届きそうな距離"
+	if d <= 2.5:
+		return "すぐ目の前（%.0fmほど）" % d if not dark_now else "すぐ目の前"
+	if dark_now:
+		return "暗くて、距離がはっきりしない"
+	if d <= 6.0:
+		return "数歩先（%.0fmほど）" % d
+	return "少し離れたところ（%.0fmほど）" % d
+
+## A rough sense of what could be hit, from where the nearest one stands.
+## Stage 2 replaces this with the real odds put into words.
+static func target_words(world) -> String:
+	var list := zombies(world)
+	if list.is_empty():
+		return ""
+	var z: Dictionary = list[0]
+	var d := float(z.dist)
+	if d > 2.5:
+		return "攻撃：まだ届かない距離"
+	var head := "かなり難しい"
+	if str(z.state) in ["downed", "pinned"]:
+		head = "狙いやすい"
+	elif str(z.state) == "crawling":
+		head = "難しい"
+	var legs := "狙いやすい" if str(z.state) == "standing" else "必要ない"
+	return "頭：%s ／ 脚：%s ／ 胴：狙いやすい" % [head, legs]
+
+## What the player can see, for the panel above the story.
+static func status_lines(world) -> Array:
+	if not active(world):
+		return []
+	sync(world)
+	var enc: Dictionary = Walkers.ensure(world).encounter
+	var list := zombies(world)
+	var total := maxi(1, Walkers.count(world, str(enc.place)))
+	var dark_now := dark(world)
+	var lines: Array = []
+	var head_count := ""
+	if dark_now and total > 1:
+		head_count = "何人かいる（暗くて数えられない）"
+	elif total >= 10:
+		head_count = "数えきれない（%d人以上）" % (total / 10 * 10)
+	elif int(enc.get("counted", 0)) > 0 or total <= 3:
+		head_count = "%d人" % total
+	else:
+		head_count = "数人"
+	var front: Dictionary = list[0] if not list.is_empty() else {}
+	var front_words := distance_words(float(front.get("dist", 8.0)), dark_now)
+	var state_words := ""
+	match str(front.get("state", "standing")):
+		"downed": state_words = "・倒れている"
+		"crawling": state_words = "・這ってくる"
+		"pinned": state_words = "・挟まって動けない"
+	lines.append("感染者：%s ・ 一番近いのは%s%s" % [head_count, front_words, state_words])
+	if not bool(enc.get("near", false)):
+		lines.append("まだ、こちらには気づいていない")
+	lines.append("手持ち：%s ・ 場所：%s" % [weapon_words(world), TERRAIN_WORDS[terrain(world)]])
+	lines.append("体：%s" % body_words(world))
+	var targets := target_words(world)
+	if not targets.is_empty():
+		lines.append(targets)
+	return lines
+
+## Stage 1 stand-in: the improvised weapon walkers.gd already counts.
+static func weapon_words(world) -> String:
+	var inv: Dictionary = world.s.inventory
+	if int(inv.get("parts", 0)) > 0:
+		return "金属の部品（殴れる）"
+	if int(inv.get("wood", 0)) > 0:
+		return "角材"
+	return "素手"
+
+static func body_words(world) -> String:
+	var parts: Array = []
+	var hp := float(world.s.health)
+	parts.append("元気" if hp >= 80.0 else ("傷が痛む" if hp >= 40.0 else "ふらついている"))
+	var tired := float(world.s.get("fatigue", 0.0))
+	if tired >= 70.0:
+		parts.append("息が上がっている")
+	elif tired >= 40.0:
+		parts.append("少し疲れている")
+	var hurt := int(world.s.get("injuries", 0))
+	if hurt > 0:
+		parts.append("けがが%d箇所" % hurt)
+	return "・".join(parts)
