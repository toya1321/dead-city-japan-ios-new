diff --git a/tests/test_shop149_34.gd b/tests/test_shop149_34.gd
new file mode 100644
index 0000000..23bccec
--- /dev/null
+++ b/tests/test_shop149_34.gd
@@ -0,0 +1,51 @@
+extends SceneTree
+## v149.34: the shop counter window — opens on arrival and by asking, lists
+## what each shop sells, buys through the usual rules, closes on leaving.
+const Main = preload("res://main.tscn")
+const ShopWindow = preload("res://scripts/shop_window.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.minute = 3 * 60
+	await g._on_command("コンビニへ行く")
+	check(g.shop_window != null and g.shop_window.visible, "arriving at an open konbini opens the counter window")
+	var names: Array = ShopWindow.offers(g).map(func(o): return str(o.name))
+	check(names == ["食料", "飲料水", "タバコ", "カセットボンベ"], "the konbini sells food, water, cigarettes and gas cans")
+	check("品物を見る" in g._suggestions(), "and a chip opens it again")
+	var cash := int(w.s.cash)
+	var food: Dictionary = ShopWindow.offers(g)[0]
+	g.shop_window.counts["food"] = 2
+	await g.shop_window._buy(food)
+	check(int(w.s.cash) == cash - 1200 and float(w.s.district.bag.food) == 2.0, "buying two meals charges 1200 yen and they are carried")
+	check(int(ShopWindow.offers(g)[0].stock) == int(food.stock) - 2, "and the stock shown goes down")
+	g.shop_window.visible = false
+	await g._on_command("在庫を見る")
+	check(g.shop_window.visible and g.log_entries[-1].contains("品ぞろえを確かめた"), "「在庫を見る」 opens the window")
+	await g._on_command("食品店へ行く")
+	check(g.shop_window.visible and ShopWindow.offers(g).map(func(o): return str(o.name)) == ["食料", "飲料水"], "the grocer's window shows its own goods")
+	await g._on_command("薬局へ行く")
+	var bandages := int(w.s.inventory.bandage)
+	g.shop_window.counts["bandage"] = 1
+	await g.shop_window._buy(ShopWindow.offers(g)[0])
+	check(int(w.s.inventory.bandage) == bandages + 1, "bandages bought at the pharmacy")
+	await g._on_command("家に帰る")
+	check(not g.shop_window.visible, "leaving the shop closes it")
+	w.s.minute = 15 * 60   # 23:00, the small shops shut
+	await g._on_command("薬局へ行く")
+	check(ShopWindow.offers(g).is_empty() and not g.shop_window.visible, "a closed shop does not open the window")
+	print("v149.34 shop checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
