diff --git a/qa/shop_shot.gd b/qa/shop_shot.gd
new file mode 100644
index 0000000..b9ac8ab
--- /dev/null
+++ b/qa/shop_shot.gd
@@ -0,0 +1,36 @@
+extends SceneTree
+## Screenshot of the shop window (DCJ_PLACE, DCJ_OUT); also buys one item.
+const Main = preload("res://main.tscn")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	g.world.s.minute = 3 * 60
+	await g._on_command(OS.get_environment("DCJ_PLACE") + "へ行く")
+	for i in 10: await process_frame
+	print("visible=", g.shop_window != null and g.shop_window.visible, " offers=", g.ShopWindow.offers(g).map(func(o): return o.name))
+	print("chips=", g._suggestions())
+	root.get_texture().get_image().save_png(OS.get_environment("DCJ_OUT"))
+	if g.shop_window != null and g.shop_window.visible:
+		var offer: Dictionary = g.ShopWindow.offers(g)[0]
+		g.shop_window.counts[str(offer.id)] = 2
+		await g.shop_window._buy(offer)
+		for i in 10: await process_frame
+		print("after buy: ", g.log_entries.slice(-2), " note=", g.shop_window.note_label.text)
+		root.get_texture().get_image().save_png(OS.get_environment("DCJ_OUT").replace(".png", "_after.png"))
+		g.shop_window.visible = false
+		await g._on_command("在庫を見る")
+		for i in 5: await process_frame
+		print("reopen by command: ", g.shop_window.visible, " ", g.log_entries[-1])
+		await g._on_command("家に帰る")
+		for i in 5: await process_frame
+		print("after leaving: ", g.shop_window.visible)
+	quit()
