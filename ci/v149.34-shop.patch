diff --git a/scripts/shop_window.gd b/scripts/shop_window.gd
new file mode 100644
index 0000000..79480a1
--- /dev/null
+++ b/scripts/shop_window.gd
@@ -0,0 +1,236 @@
+extends PanelContainer
+## v149.34: the shop counter as a window. Opens on arriving at an open shop
+## (or with 「品物を見る」「在庫を見る」), lists what is on sale with price and
+## stock, and buys through the same typed commands as before, so time, money,
+## stock and what can be carried follow the existing rules. Item pictures are
+## the same as in 「持ち物」 (assets/items/<name>.jpg, shown when present).
+
+const UI = preload("res://scripts/ui_kit.gd")
+const District = preload("res://scripts/district.gd")
+const HomeLife = preload("res://scripts/home_life.gd")
+const ICON_DIR := "res://assets/items/"
+
+var game
+var place := ""
+var counts := {}
+var list_box: VBoxContainer
+var title_label: Label
+var cash_label: Label
+var note_label: Label
+var busy := false
+
+## What this place sells now: [{id, name, unit, price, stock, command}].
+## stock is how many can be bought (-1: no limit). Empty when not a shop or
+## not open. Reads only (never creates state).
+static func offers(game_node) -> Array:
+	var world = game_node.world
+	var where := str(game_node.location)
+	var out: Array = []
+	if float(world.s.health) <= 0:
+		return out
+	match where:
+		"コンビニ", "デパート地下":
+			var site_name := "コンビニ" if where == "コンビニ" else "デパート"
+			var site: Dictionary = world.s.district.sites[site_name]
+			if bool(site.vacant) or not District.can_enter(world, site_name):
+				return out
+			out.append({"id": "food", "name": "食料", "unit": "1人日分", "price": 600, "stock": int(floor(float(site.food))), "command": "食料を%d個買う"})
+			out.append({"id": "water", "name": "飲料水", "unit": "2L", "price": 120, "stock": int(floor(float(site.water) / 2.0)), "command": "水を%d本買う"})
+			if where == "コンビニ":
+				var tobacco: Dictionary = world.s.get("tobacco_stock") if world.s.get("tobacco_stock") is Dictionary else HomeLife.TOBACCO_START
+				out.append({"id": "tobacco", "name": "タバコ", "unit": "1箱（20本）", "price": 600, "stock": int(tobacco.get("コンビニ", 0)), "command": "タバコを%d箱買う"})
+				out.append({"id": "gas", "name": "カセットボンベ", "unit": "1本", "price": 150, "stock": -1, "command": "カセットボンベを%d本買う"})
+		"食品店", "金物店", "薬局":
+			var id: String = {"食品店": "grocer", "金物店": "hardware", "薬局": "pharmacy"}[where]
+			if not world.can_trade(id):
+				return out
+			var words := {"food": "食料を%d個買う", "water": "水を%d本買う", "wood": "木材を%d個買う", "parts": "部品を%d個買う", "seeds": "種を%d袋買う", "bandage": "包帯を%d個買う", "filter": "浄水器を%d個買う", "solar": "ソーラーパネルを%d個買う", "battery": "蓄電池を%d個買う"}
+			var units := {"food": "1人日分", "water": "2L", "wood": "1束", "parts": "1袋", "seeds": "1袋", "bandage": "1巻", "filter": "1台", "solar": "1台", "battery": "1台"}
+			for item in world.CATALOG:
+				var entry: Dictionary = world.CATALOG[item]
+				if str(entry.shop) != id:
+					continue
+				var stock := int(floor(float(world.s.shops[id].stock.get(item, 0)) / float(entry.amount)))
+				if item in ["filter", "solar", "battery"]:
+					stock = mini(stock, 1)
+				out.append({"id": str(item), "name": str(entry.name), "unit": str(units.get(item, "")), "price": int(entry.price), "stock": stock, "command": str(words[item])})
+			if id == "hardware":
+				out.append({"id": "gas", "name": "カセットボンベ", "unit": "1本", "price": 150, "stock": -1, "command": "カセットボンベを%d本買う"})
+	return out
+
+static func title_for(where: String) -> String:
+	return {"デパート地下": "デパ地下の食品売場"}.get(where, where)
+
+func _init() -> void:
+	var style := UI.box(UI.PANEL, UI.LINE.lightened(0.25), 16, 12, 12)
+	style.shadow_color = Color(0, 0, 0, 0.6)
+	style.shadow_size = 18
+	add_theme_stylebox_override("panel", style)
+	mouse_filter = Control.MOUSE_FILTER_STOP
+	var column := VBoxContainer.new()
+	column.add_theme_constant_override("separation", 8)
+	add_child(column)
+	var head := HBoxContainer.new()
+	column.add_child(head)
+	title_label = UI.label("", 17, UI.TEXT, false)
+	title_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	head.add_child(title_label)
+	var close := UI.button("閉じる", false, 36, 13)
+	close.custom_minimum_size.x = 72
+	close.pressed.connect(func(): visible = false)
+	head.add_child(close)
+	cash_label = UI.label("", 12, UI.MUTED, true)
+	column.add_child(cash_label)
+	var scroll := ScrollContainer.new()
+	scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
+	scroll.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	scroll.custom_minimum_size = Vector2(0, 120)
+	column.add_child(scroll)
+	list_box = VBoxContainer.new()
+	list_box.add_theme_constant_override("separation", 6)
+	list_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	scroll.add_child(list_box)
+	note_label = UI.label("", 13, UI.ACCENT, true)
+	column.add_child(note_label)
+
+func open(game_node) -> bool:
+	game = game_node
+	var items := offers(game)
+	if items.is_empty():
+		visible = false
+		return false
+	if place != str(game.location):
+		counts.clear()
+		note_label.text = ""
+	place = str(game.location)
+	_fill(items)
+	visible = true
+	return true
+
+func refresh() -> void:
+	if not visible or game == null:
+		return
+	if str(game.location) != place:
+		visible = false
+		return
+	var items := offers(game)
+	if items.is_empty():
+		visible = false
+		return
+	_fill(items)
+
+func _place_on_screen() -> void:
+	var parent := get_parent() as Control
+	var area: Vector2 = parent.size if parent != null else Vector2(390, 844)
+	var width := minf(380.0, area.x - 24.0)
+	var rows := list_box.get_child_count()
+	var height := minf(110.0 + 64.0 * rows + (24.0 if not note_label.text.is_empty() else 0.0), area.y * 0.72)
+	custom_minimum_size = Vector2(width, height)
+	size = Vector2(width, height)
+	for row in list_box.get_children():
+		row.custom_minimum_size.x = width - 24.0
+	position = Vector2((area.x - width) / 2.0, maxf(12.0, area.y * 0.1))
+
+func _fill(items: Array) -> void:
+	var world = game.world
+	title_label.text = "%s（営業中）" % title_for(place)
+	var bag: Dictionary = world.s.district.get("bag", {})
+	var carry := ""
+	if place in ["コンビニ", "デパート地下"]:
+		carry = "\n持てる量：食料 %.0f／%.0f ・ 水 %.0f／%.0f L" % [float(bag.get("food", 0.0)), District.FOOD_LIMIT, float(bag.get("water", 0.0)), District.WATER_LIMIT]
+	cash_label.text = "所持金 %d円%s" % [int(world.s.cash), carry]
+	for child in list_box.get_children():
+		list_box.remove_child(child)
+		child.queue_free()
+	for offer in items:
+		list_box.add_child(_row(offer))
+	_place_on_screen()
+
+const ICON_NAMES := {"tobacco": "cigarettes", "gas": "gas_cans"}
+
+func _icon(id: String) -> Control:
+	var path := ""
+	for ext in [".jpg", ".png", ".webp"]:
+		var candidate: String = ICON_DIR + str(ICON_NAMES.get(id, id)) + ext
+		if ResourceLoader.exists(candidate):
+			path = candidate
+			break
+	if not path.is_empty():
+		var picture := TextureRect.new()
+		picture.texture = load(path)
+		picture.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		picture.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
+		picture.custom_minimum_size = Vector2(40, 40)
+		return picture
+	# No picture yet: a plain tile with the first letter.
+	var tile := PanelContainer.new()
+	tile.add_theme_stylebox_override("panel", UI.box(UI.PANEL_2, UI.EDGE, 8, 0, 0))
+	tile.custom_minimum_size = Vector2(40, 40)
+	var letter := UI.label("", 16, UI.ACCENT, false)
+	letter.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	letter.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+	tile.add_child(letter)
+	return tile
+
+func _row(offer: Dictionary) -> Control:
+	var id := str(offer.id)
+	var stock := int(offer.stock)
+	var top := 12 if stock < 0 else mini(12, stock)
+	var n := clampi(int(counts.get(id, 1)), 1, maxi(1, top))
+	counts[id] = n
+	var row := PanelContainer.new()
+	row.add_theme_stylebox_override("panel", UI.box(UI.PANEL_2, UI.LINE, 10, 8, 6))
+	var line := HBoxContainer.new()
+	line.add_theme_constant_override("separation", 4)
+	row.add_child(line)
+	var icon := _icon(id)
+	if icon is PanelContainer:
+		(icon.get_child(0) as Label).text = str(offer.name).left(1)
+	line.add_child(icon)
+	var text := VBoxContainer.new()
+	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	text.add_theme_constant_override("separation", 0)
+	line.add_child(text)
+	var name_label := UI.label(str(offer.name), 14, UI.TEXT, false)
+	name_label.clip_text = true
+	text.add_child(name_label)
+	var stock_words := "" if stock < 0 else (" 売り切れ" if stock <= 0 else " 残り%d" % stock)
+	var detail := UI.label("%d円（%s）%s" % [int(offer.price), offer.unit, stock_words], 11, UI.MUTED, true)
+	detail.custom_minimum_size.x = 60
+	text.add_child(detail)
+	var minus := UI.button("−", false, 36, 15)
+	minus.custom_minimum_size.x = 32
+	var amount := UI.label(str(n), 15, UI.TEXT, false)
+	amount.custom_minimum_size.x = 22
+	amount.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	var plus := UI.button("+", false, 36, 15)
+	plus.custom_minimum_size.x = 32
+	var buy := UI.button("買う", true, 36, 14)
+	buy.custom_minimum_size.x = 52
+	minus.pressed.connect(func():
+		counts[id] = maxi(1, int(counts[id]) - 1)
+		amount.text = str(counts[id]))
+	plus.pressed.connect(func():
+		counts[id] = mini(maxi(1, top), int(counts[id]) + 1)
+		amount.text = str(counts[id]))
+	buy.pressed.connect(func(): _buy(offer))
+	buy.disabled = stock == 0
+	minus.disabled = stock == 0
+	plus.disabled = stock == 0
+	line.add_child(minus)
+	line.add_child(amount)
+	line.add_child(plus)
+	line.add_child(buy)
+	return row
+
+func _buy(offer: Dictionary) -> void:
+	if busy or game == null:
+		return
+	busy = true
+	var n := int(counts.get(str(offer.id), 1))
+	var command := str(offer.command) % n
+	await game._on_command(command)
+	busy = false
+	var last := str(game.log_entries[-1]) if not game.log_entries.is_empty() else ""
+	note_label.text = last.get_slice("\n", 0).left(80)
+	refresh()
