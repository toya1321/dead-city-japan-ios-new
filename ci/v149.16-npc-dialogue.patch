@@ -0,0 +1,195 @@
+extends SceneTree
+## v149.16: model-first NPC conversation grounded in game state, per-NPC
+## profiles, free-time activity and relevance-based long-term memory.
+const Main = preload("res://main.tscn")
+const Mind = preload("res://scripts/npc_mind.gd")
+const Model = preload("res://scripts/local_npc_model.gd")
+const Memory = preload("res://scripts/household_memory.gd")
+const Smalltalk = preload("res://scripts/household_smalltalk.gd")
+
+class ScriptedModel extends RefCounted:
+	var queue: Array = []
+	var payload := {}
+	var payloads: Array = []
+	var requests := 0
+	var cancelled := false
+	var installed := true
+	func model_available() -> bool:
+		return installed
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, _instructions: String, input: String) -> bool:
+		requests += 1
+		payload = Model.decode_request(input)
+		payloads.append(payload)
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		cancelled = true
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func say(model: ScriptedModel, line: String) -> void:
+	model.queue.append(JSON.stringify({"kind":"chat", "value":line}))
+
+func run() -> void:
+	var game = Main.instantiate()
+	root.add_child(game)
+	await process_frame
+	var profile: Dictionary = game.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = 2
+	profile.companion_names = ["詩音", "湊"]
+	game._start_new_game(profile)
+	game._finish_intro()
+	game.location = "居間"
+	game._sync_player_position()
+	game.world.s.minute = 120
+	game.world.s.society = "disrupted"
+	game.world._household_hour()
+	var fake := ScriptedModel.new()
+	game.local_model.backend = fake
+	game.local_model.generation_timeout_ms = 300
+	var shion: Dictionary = game.world.s.household_members[0]
+
+	# --- The reported problem: an everyday question goes to the model even when
+	# an older keyword rule would have produced a canned answer.
+	say(fake, "青と紫が混ざると、落ち着いた青紫になるよ。夜明け前の空みたいで好きだな。")
+	await game._on_command("詩音、青と紫が混ざった色ってどんな気分になる？")
+	check(fake.requests == 1 and game.last_npc_reply_source.source == "ai" and game.log_entries[-1].contains("青紫"), "open question is answered by the model")
+	var first_reply := "青と紫が混ざると、落ち着いた青紫になるよ。夜明け前の空みたいで好きだな。"
+	say(fake, "青紫、ブルーバイオレットとも呼ぶね。")
+	await game._on_command("それって何色って言うの？")
+	var history: Array = fake.payload["_history"]
+	check(fake.requests == 2 and history.back()[1] == first_reply.left(120) and fake.payload["発言"] == "それって何色って言うの？", "follow-up carries the previous exchange to the model")
+	check(game.log_entries[-1].contains("ブルーバイオレット"), "follow-up shows the model answer")
+	say(fake, "静かなピアノ曲をよく聴くよ。")
+	await game._on_command("音楽何聴くの？")
+	check(fake.requests == 3 and game.last_npc_reply_source.source == "ai", "keyword preference table no longer preempts the model")
+
+	# --- Persona and preferences are consistent between the model and the game.
+	var person_block: Dictionary = fake.payload["人物"]
+	var offline_music := Smalltalk._preference_answer("音楽", shion.tastes, int(game.world.s.seed), 0)
+	check(person_block["好きな音楽"] == offline_music and person_block["名前"] == "詩音" and person_block.has("今の目標") and person_block.has("趣味"), "model receives the same saved preferences the offline replies use")
+	check(Mind.profile(game.world, 0) == Mind.profile(game.world, 0) and Mind.profile(game.world, 0) != Mind.profile(game.world, 1), "profiles are stable per NPC and distinct between NPCs")
+	var facts: Dictionary = fake.payload["事実"]
+	check(facts["今日の予定"].contains("%d時" % game.world.HOUSEHOLD_SLEEP) and facts["家の状況"].contains("%.1f" % float(game.world.s.food)) and facts["約束"] == "なし", "facts include schedule, household stock and promises")
+	game.observed_news = "PLAYER_ONLY_NEWS"
+	say(fake, "うん、聞いてるよ。")
+	await game._on_command("ねえ、聞いてる？")
+	check(not JSON.stringify(fake.payload).contains("PLAYER_ONLY_NEWS"), "player-only news is not given to the NPC")
+
+	# --- Generated lines must agree with the facts that were supplied.
+	var before_reject: int = game.log_entries.size()
+	say(fake, "冷蔵庫にプリンが3個あるよ。")
+	await game._on_command("何か甘いものない？")
+	check(game.last_npc_reply_source.source == "fallback" and game.last_npc_reply_source.reason == "filtered_unverifiable_world_claim" and not game.log_entries[-1].contains("プリン"), "invented stock is rejected and the offline reply is used")
+	check(game.log_entries.size() > before_reject, "a rejected generation still produces a reply")
+	say(fake, "明日の夜7時に映画を観る約束だったよね。")
+	say(fake, "明日の夜に映画を観る約束だったよね。")
+	await game._on_command("今夜は何しようか")
+	check(game.last_npc_reply_source.reason == "filtered_invented_promise+filtered_invented_promise" and fake.queue.is_empty(), "invented promise is rejected, retried once, then falls back")
+	check(fake.payload.get("注意", "").contains("存在しない約束"), "the retry tells the model why the first reply was rejected")
+	say(fake, "詩音は、あなたと話せてうれしい。")
+	say(fake, "あなたと話せてうれしいよ。")
+	await game._on_command("話せてよかった")
+	check(game.last_npc_reply_source.reason == "generated_chat_after_retry" and game.log_entries[-1].contains("あなたと話せてうれしいよ"), "third-person narration is retried and the corrected line is shown")
+	say(fake, "あなたと話せてうれしいよ。")
+	say(fake, "そう言ってもらえると、私も安心する。")
+	await game._on_command("ほんとにね")
+	check(game.log_entries[-1].contains("安心する"), "a verbatim repeat of the previous reply is retried")
+	say(fake, "%d時ごろには寝るつもりだよ。" % game.world.HOUSEHOLD_SLEEP)
+	await game._on_command("今夜は何時ごろ寝るの？")
+	check(game.last_npc_reply_source.source == "ai" and game.log_entries[-1].contains("%d時" % game.world.HOUSEHOLD_SLEEP), "a schedule answer matching the facts is accepted")
+	say(fake, "たぶん十分あると思うよ。")
+	await game._on_command("食べ物ってまだどれくらいある？")
+	check(game.last_npc_reply_source.source == "game_fact" and game.log_entries[-1].contains("%.2f" % float(game.world.s.food)), "stock question uses the authoritative quantity")
+	check(Mind.asks_stock("食べ物で好きなのある？") == "" and Mind.asks_stock("水はあと何日もつ？") == "water" and Mind.asks_stock("備蓄の食料って足りる？") == "food", "stock detection ignores preference questions")
+	check(Mind.reject_reason("買ってきたよ。", "", {}) == "completion_claim" and Mind.reject_reason("五個あるよ。", "", {"facts": {"家の状況": "食料は5.0人日分"}}) == "", "completion claims are rejected; matching kanji quantities are allowed")
+	check(Mind.reject_reason("今、俺のことどう思ってる？", "俺のことどう思ってる？", {}) == "echoed_question" and Mind.reject_reason("俺のこと？頼りにしてるよ。", "俺のことどう思ってる？", {}) == "", "echoing the question is rejected but answering it is not")
