+constexpr int context_tokens = 3072;
+constexpr int output_tokens = 128;
 constexpr int batch_tokens = 128;
 constexpr char response_grammar[] = R"GRAM(
 root ::= "{" ws "\"kind\"" ws ":" ws "\"" kind "\"" ws "," ws "\"value\"" ws ":" ws string ws "}"
@@ -29,6 +29,45 @@ std::string escape_markers(std::string text) {
     return text;
 }
 
+// A request may carry earlier conversation turns separated by ASCII record
+// separators: player, reply, player, reply, ..., final request. Earlier turns
+// become real ChatML user/assistant messages so the model continues a dialogue
+// instead of describing a transcript. Without separators the request is one
+// user message, exactly as before.
+std::string json_string(const std::string &text) {
+    std::string out = "\"";
+    for (const char c : text) {
+        switch (c) {
+            case '"': out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n"; break;
+            case '\r': break;
+            case '\t': out += "\\t"; break;
+            default:
+                if (static_cast<unsigned char>(c) >= 0x20) out += c;
+        }
+    }
+    return out + "\"";
+}
+
+std::string build_prompt(const std::string &system, const std::string &input) {
+    std::vector<std::string> parts;
+    size_t start = 0;
+    for (size_t at = input.find('\x1e'); at != std::string::npos; at = input.find('\x1e', start)) {
+        parts.push_back(input.substr(start, at - start));
+        start = at + 1;
+    }
+    parts.push_back(input.substr(start));
+    if (parts.size() % 2 == 0) parts.erase(parts.begin());  // malformed: keep a valid alternation
+    std::string prompt = "<|im_start|>system\n" + escape_markers(system) + "<|im_end|>\n";
+    for (size_t i = 0; i + 1 < parts.size(); i += 2) {
+        prompt += "<|im_start|>user\n" + escape_markers(parts[i]) + "<|im_end|>\n";
+        prompt += "<|im_start|>assistant\n{\"kind\":\"chat\",\"value\":" + escape_markers(json_string(parts[i + 1])) + "}<|im_end|>\n";
+    }
+    return prompt + "<|im_start|>user\n" + escape_markers(parts.back()) +
+        "<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n";
+}
+
 long since(Clock::time_point start) {
     return std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - start).count();
 }
