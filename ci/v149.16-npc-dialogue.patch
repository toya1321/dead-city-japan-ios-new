@@ -0,0 +1,401 @@
+extends RefCounted
+## Per-NPC identity, free-time behaviour and grounded facts for dialogue.
+##
+## Everything here is derived deterministically from saved state (seed, NPC id,
+## name, tastes, game clock and the typed memory journal). No new save fields are
+## needed, so old saves keep working and every answer about the same moment is
+## reproducible: what the NPC says it did is what the game says it did.
+const Navigation = preload("res://scripts/navigation.gd")
+const Smalltalk = preload("res://scripts/household_smalltalk.gd")
+const Persona = preload("res://scripts/conversation_persona.gd")
+const Memory = preload("res://scripts/household_memory.gd")
+
+# Index matches ConversationPersona.variant_for(name) so offline lines and the
+# model share one character.
+const TEMPERAMENTS := [
+	{"性格":"穏やかで聞き上手", "話し方の癖":"相手の気持ちを先に受け止めてから話す。急かさない。", "大事にしていること":"みんなが落ち着いて過ごせること"},
+	{"性格":"率直で実際的", "話し方の癖":"結論から短く言う。段取りや備えの話になると具体的になる。", "大事にしていること":"無駄なく確実に暮らすこと"},
+	{"性格":"好奇心が強くよく質問する", "話し方の癖":"気になったことを一つ聞き返して話を広げる。", "大事にしていること":"新しいことを知ること"},
+]
+const GOALS := [
+	"離れて暮らす家族の無事を確かめたい",
+	"家の戸締まりと備えをもっと固めたい",
+	"夜にぐっすり眠れる毎日を取り戻したい",
+	"近所で頼れる人を見つけておきたい",
+	"保存のきく料理のレパートリーを増やしたい",
+	"どんな日でも少しは趣味の時間を作りたい",
+]
+const DAYTIME := [
+	"駅前の事務所で働いている",
+	"近所のスーパーでパートをしている",
+	"大学に通っている",
+	"図書館で資格の勉強をしている",
+	"市役所で働いている",
+	"配送の仕事をしている",
+]
+# One list per 趣味 preference index. Pastimes never consume or create items,
+# so they cannot contradict the household inventory.
+const PASTIMES := [
+	["窓から近所の道を眺めていた", "地図を見て散歩道を考えていた", "ストレッチをしていた"],
+	["レシピ帳を眺めていた", "台所の調味料を整理していた", "次の献立を考えていた"],
+	["本を読んでいた", "読みかけの小説を進めていた", "本棚を整理していた"],
+	["撮った写真を見返していた", "カメラの手入れをしていた", "窓からの景色を撮っていた"],
+	["鉢植えの葉の様子を見ていた", "植物の本を読んでいた", "鉢の置き場所を考えていた"],
+	["一人でパズルを解いていた", "ボードゲームのルールを読み返していた", "カードを並べて遊んでいた"],
+	["スケッチをしていた", "色鉛筆で絵を描いていた", "窓の外を見ながら下絵を描いていた"],
+	["自転車の手入れをしていた", "地図で走りたい道を探していた", "ストレッチをしていた"],
+]
+const COMMON_PASTIMES := ["音楽を聴いていた", "部屋を片付けていた"]
+
+static func _pick(seed_value: int, id: int, label: String, size: int) -> int:
+	return posmod(hash([seed_value, id, label]), size)
+
+static func _taste(world, index: int, topic: String) -> int:
+	var person: Dictionary = world.s.household_members[index]
+	return Smalltalk._preference_index(topic, person.get("tastes", {}), int(world.s.seed), index)
+
+static func temperament(person: Dictionary) -> Dictionary:
+	return TEMPERAMENTS[Persona.variant_for(str(person.name))]
+
+static func profile(world, index: int) -> Dictionary:
+	var person: Dictionary = world.s.household_members[index]
+	var seed_value := int(world.s.seed)
+	var id := int(person.id)
+	var traits: Dictionary = temperament(person)
+	var music := _taste(world, index, "音楽")
+	var film := _taste(world, index, "映画")
+	var food := _taste(world, index, "食べ物")
+	return {
+		"性格": traits["性格"],
+		"話し方の癖": traits["話し方の癖"],
+		"大事にしていること": traits["大事にしていること"],
+		"好きな音楽": Smalltalk.PREFERENCES["音楽"][music],
+		"好きなアーティスト": Smalltalk.MUSIC_DETAILS[music][0],
+		"好きな映画のジャンル": Smalltalk.PREFERENCES["映画"][film],
+		"一番好きな映画": Smalltalk.FILM_RECOMMENDATIONS[film],
+		"好きな食べ物": Smalltalk.PREFERENCES["食べ物"][food],
+		"苦手な食べ物": Smalltalk.DISLIKED_FOODS[food],
+		"趣味": Smalltalk.PREFERENCES["趣味"][_taste(world, index, "趣味")],
+		"普段の日中": DAYTIME[_pick(seed_value, id, "daytime", DAYTIME.size())],
+		"今の目標": GOALS[_pick(seed_value, id, "goal", GOALS.size())],
+	}
+
+static func hour_at(world, minute: int) -> int:
+	return int(fmod(float(world.s.start_hour) + float(minute) / 60.0, 24.0))
+
+static func day_at(world, minute: int) -> int:
+	return int(floor((float(world.s.start_hour) * 60.0 + float(minute)) / 1440.0))
+
+static func _pastimes(world, index: int) -> Array:
+	var options: Array = PASTIMES[_taste(world, index, "趣味")].duplicate()
+	options.append_array(COMMON_PASTIMES)
+	return options
+
+## Activity for an at-home hour. Confirmed journal events in that hour win over
+## the generated pastime so a shared film or a cooked meal is never forgotten.
+static func pastime_at(world, memory, index: int, minute: int) -> String:
+	var person: Dictionary = world.s.household_members[index]
+	var id := int(person.id)
+	var hour_start := minute - posmod(int(float(world.s.start_hour) * 60.0) + minute, 60)
+	if memory != null:
+		for entry in memory.entries.get(str(id), []):
+			var stamp := int(entry.minute)
+			if stamp < hour_start or stamp >= hour_start + 60:
+				continue
+			if entry.kind == "movie":
+				return "一緒に『%s』を観ていた" % entry.subject
+			if entry.kind == "experience" and str(entry.subject) == "料理":
+				return "料理をしていた"
+	var scheduled: String = world.household_activity_at(hour_at(world, minute))
+	if minute == int(world.s.minute):
+		scheduled = str(person.activity)
+	match scheduled:
+		"睡眠":
+			return "寝ていた"
+		"外出":
+			return "出かけていた"
+		"料理":
+			return "料理をしていた"
+	var options := _pastimes(world, index)
+	return options[posmod(hash([int(world.s.seed), id, day_at(world, minute), hour_at(world, minute)]), options.size())]
+
+static func present(past: String) -> String:
+	return past.trim_suffix("ていた") + "ている" if past.ends_with("ていた") else past
+
+## Journal entries are written when an event finishes, so they describe the
+## past; the present comes from the live activity and the free-time schedule.
+static func now_doing(world, _memory, index: int) -> String:
+	var person: Dictionary = world.s.household_members[index]
+	match str(person.activity):
+		"睡眠": return "寝ている"
+		"外出": return "外出している"
+		"料理": return "料理をしている"
+	return present(pastime_at(world, null, index, int(world.s.minute)))
+
+static func _finished_event(memory, id: int, since: int, before: int) -> String:
+	if memory == null:
+		return ""
+	var journal: Array = memory.entries.get(str(id), [])
+	for i in range(journal.size() - 1, -1, -1):
+		var entry: Dictionary = journal[i]
+		var stamp := int(entry.minute)
+		if stamp > before:
+			continue
+		if stamp < since:
+			break
+		if entry.kind == "movie":
+			return "一緒に『%s』を観ていた" % entry.subject
+		if entry.kind == "experience" and str(entry.subject) == "料理":
+			return "料理をしていた"
+	return ""
+
+## Up to `hours` previous at-home hours, newest first, merged when repeated.
+static func recent_pastimes(world, memory, index: int, hours: int = 3) -> Array:
+	var now := int(world.s.minute)
+	var result: Array = []
+	var just_finished := _finished_event(memory, int(world.s.household_members[index].id), now - 60, now)
+	if not just_finished.is_empty():
+		result.append(just_finished)
+	for back in range(1, hours + 1):
+		var minute := now - back * 60
+		if minute < 0:
+			break
+		var done := pastime_at(world, memory, index, minute)
+		if done in ["寝ていた", "出かけていた"] and not result.is_empty():
+			break
+		if result.is_empty() or result.back() != done:
+			result.append(done)
+	return result
+
+static func yesterday_summary(world, memory, index: int) -> String:
+	var now := int(world.s.minute)
+	var today := day_at(world, now)
+	if today == 0:
+		return ""
+	var went_out := false
+	var at_home: Array = []
+	for hour in range(24):
+		var minute := (today - 1) * 1440 + hour * 60 - int(world.s.start_hour) * 60
+		if minute < 0:
+			continue
+		var done := pastime_at(world, memory, index, minute)
+		if done == "出かけていた":
+			went_out = true
+		elif done != "寝ていた" and done not in at_home:
+			at_home.append(done)
+	var parts: Array[String] = []
+	if went_out:
+		parts.append("日中に出かけていた")
+	if not at_home.is_empty():
+		parts.append("家では" + "、".join(at_home.slice(0, 2)))
+	return "。".join(parts)
+
+## Confirmed shared events of the last week, newest first. An explicit
+## "特になし" gives the model something true to say instead of inventing.
+static func recent_events(memory, id: int, now: int) -> String:
+	var lines: Array[String] = []
+	var journal: Array = memory.entries.get(str(id), []) if memory != null else []
+	for i in range(journal.size() - 1, -1, -1):
+		var entry: Dictionary = journal[i]
+		if int(entry.minute) < now - 7 * 1440 or lines.size() >= 3:
+			break
+		var ago := Memory.describe(entry, now).get_slice("（", 1).get_slice("）", 0)
+		match str(entry.kind):
+			"movie":
+				lines.append("%sにプレイヤーと『%s』を観た" % [ago, entry.subject])
+			"experience":
+				lines.append("%sに%sをした" % [ago, entry.subject])
+			"errand":
+				lines.append("%sに買い物を頼まれた（%s）" % [ago, str(entry.detail).left(40)])
+	return "、".join(lines) if not lines.is_empty() else "特になし（家で普段どおり過ごしていた）"
+
+static func plan_today(world, index: int) -> String:
+	var hour := world.hour_of_day() as float
+	var goes_out: bool = world.household_activity_at(world.HOUSEHOLD_LEAVE) == "外出"
+	var parts: Array[String] = ["%d時ごろ起きる" % world.HOUSEHOLD_WAKE]
+	if goes_out:
+		parts.append("%d時ごろ出かけて%d時ごろ帰る（%s）" % [world.HOUSEHOLD_LEAVE, world.HOUSEHOLD_RETURN, profile(world, index)["普段の日中"]])
+	else:
+		parts.append("今日は外出せず家にいる")
+	parts.append("%d時ごろ寝る" % world.HOUSEHOLD_SLEEP)
+	var line := "、".join(parts)
+	if goes_out and hour >= world.HOUSEHOLD_RETURN:
+		line += "。今日の外出はもう終わった"
+	return line
+
+static func relationship(memory, person: Dictionary, conversation_turns: int) -> String:
+	var id := str(int(person.id))
+	var films: Array[String] = []
+	var meals := 0
+	var talks := 0
+	for entry in memory.entries.get(id, []):
+		match str(entry.kind):
+			"movie":
+				if str(entry.subject) not in films:
+					films.append(str(entry.subject))
+			"experience":
+				meals += 1 if str(entry.subject) == "料理" else 0
+			"talk":
+				talks += 1
+	var line := "同居人。"
+	if not films.is_empty():
+		line += "一緒に観終えた映画: " + "、".join(films.slice(-3)) + "。"
+	if meals > 0:
+		line += "プレイヤーたちに料理を作ったことが%d回ある。" % meals
+	var closeness := talks + conversation_turns + films.size() * 3 + meals * 2
+	line += "まだ打ち解けはじめたところ。" if closeness < 6 else ("気軽に話せる仲。" if closeness < 20 else "気心の知れた仲。")
+	return line
+
+## Facts the NPC can know right now. Player-only knowledge (news the player read,
+## unconfirmed events) is deliberately absent.
+static func facts(game, index: int) -> Dictionary:
+	var world = game.world
+	var person: Dictionary = world.s.household_members[index]
+	var id := int(person.id)
+	var now := int(world.s.minute)
+	var result := {
+		"現在時刻": world.clock(),
+		"自分の居場所": str(person.location),
+		"プレイヤーの居場所": str(game.location),
+		"今していること": now_doing(world, game.npc_memory, index),
+		"体調": _condition(person),
+		"今日の予定": plan_today(world, index),
+	}
+	var earlier := recent_pastimes(world, game.npc_memory, index)
+	if not earlier.is_empty():
+		result["さっきまで（新しい順）"] = "、".join(earlier)
+	var yesterday := yesterday_summary(world, game.npc_memory, index)
+	if not yesterday.is_empty():
+		result["昨日"] = yesterday
+	result["外出の状況"] = "普段どおり外出できる" if str(world.s.society) == "normal" else "最近は外出を控えて、家の中で過ごしている"
+	result["最近の出来事"] = recent_events(game.npc_memory, id, now)
+	if Navigation.indoor(str(person.location)):
+		result["家の状況"] = "食料は%.1f人日分、飲料水は%.1fリットル、電気は%s" % [float(world.s.food), float(world.s.water), "使える" if world.has_home_power() else "使えない"]
+	var promise: Dictionary = game.npc_memory.latest(id, "promise", now)
+	if not promise.is_empty() and int(promise.subject) + 60 > now:
+		result["約束"] = "%sに家で『%s』を観る" % [Time.get_datetime_string_from_unix_time(int(Time.get_unix_time_from_datetime_string(world.START_TIME)) + int(promise.subject) * 60).replace("T", " ").left(16), promise.detail]
+	else:
+		result["約束"] = "なし"
+	if not Navigation.indoor(str(person.location)) and str(person.location) == str(game.location):
+		var weather: String = {"clear":"晴れ","cloudy":"くもり","rain":"雨","snow":"雪"}.get(world.s.weather, "")
+		if not weather.is_empty():
+			result["天気"] = weather
+	return result
+
+static func _condition(person: Dictionary) -> String:
+	if float(person.health) < 70.0:
+		return "少し具合が悪い"
+	if float(person.thirst) >= 35.0:
+		return "喉が渇いてきた"
+	if float(person.hunger) >= 35.0:
+		return "お腹が空いてきた"
+	if float(person.fatigue) >= 65.0:
+		return "少し疲れている"
+	return "元気"
+
+# ---------------------------------------------------------------------------
+# Reply validation against the facts that were given to the model.
+
+const COMPLETION_CLAIMS := ["買ってきた", "買ってくる", "買いに行", "もう済ませ", "しておいた", "しておく", "済んだ", "持って帰", "行ってきた", "出かけてくる", "閉めた", "開けた", "閉めておく", "開けておく", "作っておく", "作っておいた"]
+const UNVERIFIABLE := ["冷蔵庫", "在庫", "感染", "断水", "ゾンビ", "噛まれ"]
+const KANJI_DIGITS := {"〇":0, "一":1, "二":2, "三":3, "四":4, "五":5, "六":6, "七":7, "八":8, "九":9, "十":10}
+
+static func _normalize_digits(text: String) -> String:
+	var out := ""
+	for i in text.length():
+		var code := text.unicode_at(i)
+		out += String.chr(code - 0xFEE0) if code >= 0xFF10 and code <= 0xFF19 else text.substr(i, 1)
+	return out
+
+static func _numbers(text: String) -> Array:
+	var found: Array = []
+	var pattern := RegEx.new()
+	pattern.compile("[0-9]+(?:\\.[0-9]+)?")
+	for m in pattern.search_all(_normalize_digits(text)):
+		found.append(m.get_string())
+	# Small kanji quantities bound to a counter ("三個", "二時").
+	var counted := RegEx.new()
+	counted.compile("([〇一二三四五六七八九十]{1,3})(?:個|本|人|日|時|分|回|リットル|L|食|袋|缶|箱)")
+	for m in counted.search_all(text):
+		var digits := m.get_string(1)
+		var ten := digits.find("十")
+		var value := 0
+		if ten < 0:
+			value = int(KANJI_DIGITS[digits.left(1)])
+		else:
+			var tens := 1 if ten == 0 else int(KANJI_DIGITS[digits.left(1)])
+			var ones := 0 if ten == digits.length() - 1 else int(KANJI_DIGITS[digits.right(1)])
+			value = tens * 10 + ones
+		found.append(str(value))
+	return found
+
+## Returns "" when the generated line is consistent with the supplied evidence,
+## otherwise a short machine-readable reason. Free Japanese cannot be fully
+## verified; this rejects the claim classes that change or misstate game state.
+static func similarity(a: String, b: String) -> float:
+	var x := Memory.bigrams(a)
+	var y := Memory.bigrams(b)
+	if x.is_empty() or y.is_empty():
+		return 1.0 if a.strip_edges() == b.strip_edges() else 0.0
+	var shared := 0
+	for gram in x:
+		if y.has(gram):
+			shared += 1
+	return float(shared) / float(mini(x.size(), y.size()))
+
+static func reject_reason(line: String, speech: String, evidence: Dictionary) -> String:
+	var own_name := str(evidence.get("name", ""))
+	if not own_name.is_empty() and (line.begins_with(own_name + "は") or line.begins_with(own_name + "が")):
+		return "third_person_narration"
+	if similarity(line, speech) >= 0.8 and line.length() <= speech.length() + 6:
+		return "echoed_question"
+	for previous in evidence.get("own_replies", []):
+		if similarity(line, str(previous)) >= 0.8:
+			return "repeated_reply"
+	if line.contains("<") or line.contains(">") or line.contains("://") or line.contains("▶") or line.contains("{"):
+		return "markup"
+	for claim in COMPLETION_CLAIMS:
+		if line.contains(claim):
+			return "completion_claim"
+	for word in UNVERIFIABLE:
+		if line.contains(word) and not speech.contains(word):
+			return "unverifiable_world_claim"
+	var known_numbers := {}
+	for number in _numbers(JSON.stringify(evidence) + speech):
+		known_numbers[number] = true
+		known_numbers[str(int(float(number)))] = true
+		known_numbers[str(snappedf(float(number), 0.1))] = true
+		if float(number) == floorf(float(number)):
+			known_numbers[str(int(float(number))) + ".0"] = true
+	for number in _numbers(line):
+		if not known_numbers.has(number):
+			return "unsupported_number"
+	# Watching a film is a recorded game event; a favourite title in the
+	# profile must not turn into an experience that never happened.
+	var record := JSON.stringify(evidence.get("facts", {})) + JSON.stringify(evidence.get("context", {}).get("記憶", []))
+	if Memory._mentions(line, ["観た", "見た", "観てた", "見てた", "観ていた", "見ていた", "眺めてた", "見返した", "観返した", "再確認した", "観直した", "見直した"]):
+		for i in Smalltalk.FILM_RECOMMENDATIONS.size():
+			var title := Smalltalk._movie_title(i)
+			if line.contains(title) and not record.contains(title):
+				return "invented_experience"
+	var facts: Dictionary = evidence.get("facts", {})
+	if line.contains("停電") and str(facts.get("家の状況", "")).contains("電気は使える"):
+		return "contradicts_power"
+	if line.contains("約束") and str(facts.get("約束", "なし")) == "なし" and not (line.contains("ない") or line.contains("なかった") or line.contains("？") or line.contains("?")):
+		return "invented_promise"
+	return ""
+
+## Questions whose answer is a household quantity are answered from the game
+## state even if the model replied with chat.
+static func asks_stock(speech: String) -> String:
+	if Memory._mentions(speech, ["好き", "苦手", "嫌い", "食べたい", "飲みたい", "おすすめ", "作って", "買って"]):
+		return ""
+	var amount := Memory._mentions(speech, ["残って", "残り", "どれくらい", "どのくらい", "何個", "何本", "何日", "足りる", "足りない", "もつ", "まだある", "まだあ"])
+	var store := Memory._mentions(speech, ["備蓄", "在庫", "ストック"])
+	if not amount and not store:
+		return ""
+	if Memory._mentions(speech, ["飲み水", "飲料水", "水の", "水は", "水って", "水まだ", "水が", "水、"]):
+		return "water"
+	if Memory._mentions(speech, ["冷蔵庫", "食料", "食べ物", "食べるもの", "ご飯", "備蓄", "在庫"]):
+		return "food"
+	return ""
