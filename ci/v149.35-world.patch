+extends SceneTree
+## v149.35 world stage 1: survivors live on their own — they move, take from
+## the same shelves as the player, go to the shelter, meet one another, and
+## the same world gives the same history, reloaded or not.
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Trade = preload("res://scripts/trade.gd")
+const NpcLife = preload("res://scripts/npc_life.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func fresh(g, seed: int) -> void:
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+
+func days(w, n: int) -> void:
+	for d in n:
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.advance_safe(60)
+
+func places(w) -> Dictionary:
+	var out := {}
+	var people: Dictionary = Survivors.ensure(w).people
+	for id in people:
+		out[id] = "%s:%s" % [people[id].status, people[id].place]
+	return out
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	fresh(g, 12)
+	var w = g.world
+	var start := places(w)
+	days(w, 2)
+	check(places(w) == start, "while life is ordinary, nobody wanders")
+	# Into the breakdown.
+	days(w, 14)
+	var people: Dictionary = Survivors.ensure(w).people
+	var moved := 0
+	var met := 0
+	for id in people:
+		if start.has(id) and str(places(w)[id]).get_slice(":", 1) != str(start[id]).get_slice(":", 1):
+			moved += 1
+		met += people[id].get("acq", {}).size()
+	check(moved >= 3, "once the town comes apart, people move on their own (%d)" % moved)
+	check(met >= 4, "and meet one another, and remember it (%d)" % met)
+	var log: Array = Survivors.ensure(w).get("events", [])
+	check(log.any(func(e): return str(e.text).contains("避難所に入った")), "some make for the shelter")
+	check(log.any(func(e): return str(e.text).contains("棚から物資を持ち出した")), "some take from the shelves")
+
+	# What they take is gone from the shelf, and is theirs.
