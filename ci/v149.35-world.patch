+extends SceneTree
+## v149.38: the town's households live their own lives — every home has its
+## family from the seed; each morning they decide (stay, stock up, leave town,
+## the shelter, hole up); holed-up homes eat, go out, are bitten, starve; the
+## player meets them at the door (knock, give, break in) and in the signs on
+## the street. The same seed gives the same town.
+const Main = preload("res://main.tscn")
+const Residents = preload("res://scripts/residents.gd")
+const Dwellings = preload("res://scripts/dwellings.gd")
+const District = preload("res://scripts/district.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func new_game(seed: int):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+func D_behind(w, area: String, i: int) -> bool:
+	return Dwellings.behind_barricade(w, area, i)
+func days(w, n: int) -> void:
+	for d in n:
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.advance_safe(60)
+func run() -> void:
+	var g = await new_game(11)
+	var w = g.world
+	days(w, 1)
+	var c: Dictionary = Residents.census(w)
+	check(Residents.ready(w) and c.home == 790, "every one of the town's 790 homes has its household: %s" % c)
+	check(int(c.people) > 1000, "well over a thousand people live in them (%d)" % int(c.people))
+	var who: Dictionary = Residents.who(w, "団地", 47)
+	check(who.people.size() >= 1 and str(who.family) == str(Dwellings.home(w, "団地", 47).family), "the household is the family the home shows")
+	# Same seed, same town.
+	# From the first hour, the homes have people in them (not only from day 2).
+	var g0 = await new_game(12)
+	g0.location = "団地"
+	g0._sync_player_position()
+	check(Residents.ready(g0.world), "the households are there on the first morning")
+	await g0._on_command("ノックする")
+	check(str(g0.log_entries[-1]).contains("ノックするドアがない"), "knocking with no door in front says so: " + str(g0.log_entries[-1]).left(40))
+	g0.queue_free()
+	var g2 = await new_game(11)
+	days(g2.world, 1)
+	check(JSON.stringify(w.s.residents.hh) == JSON.stringify(g2.world.s.residents.hh), "the same seed gives the same households")
+	g2.queue_free()
+	# The outbreak: some leave town while they can; then the shelter or the door locked.
+	while str(w.s.society) in ["normal", "alert"] and int(w.s.minute) < 20 * 1440:
+		days(w, 1)
+	days(w, 2)
+	c = Residents.census(w)
+	check(int(c.away) > 0, "some families left town for relatives (%d)" % int(c.away))
+	check(int(c.holed) > 300 and int(c.shelter) > 0 and int(c.home) == 0, "once it breaks down, they hole up or go to the shelter: %s" % c)
+	check(int(w.s.shelter.get("pop", 0)) > 0, "the shelter fills with the town's own people")
+	# Stage 2: the shelter is the town's own people and those from elsewhere.
+	var sh: Dictionary = w.s.shelter
+	var ours: int = Residents.in_shelter(w)
+	check(ours > 0 and int(sh.pop) == int(sh.outsiders) + ours, "the shelter's count is its residents and outsiders together (%d = %d + %d)" % [int(sh.pop), int(sh.outsiders), ours])
+	g.location = "避難所"
+	g._sync_player_position()
+	var report: String = load("res://scripts/shelter.gd").report(w)
+	check(report.contains("さん"), "the town's families are seen there by name: " + report.right(80))
+	check(load("res://scripts/shelter.gd").board(w).contains("家族は体育館にいます"), "and leave notes on the board")
+	w.s.survivors.history.append({"day": 1, "at": 0, "kind": "death", "place": "団地", "text": "テストのうわさ", "ref": "", "known": false})
+	var n_log: int = g.log_entries.size()
+	await g._on_command("話を聞く")
+	var said := "\n".join(g.log_entries.slice(n_log))
+	check(said.contains("テストのうわさ") and bool(w.s.survivors.history[-1].known), "the shelter is where the news is heard: " + said.left(200))
