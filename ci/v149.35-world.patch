+extends RefCounted
+## v149.35 world stage 5: the town's history, and how it reaches the player.
+## What happens out there is written down as it happens (s.survivors.history:
+## day, kind, place, text). The player learns of it only through a channel
+## that could carry it — smoke seen from the window, a voice on the radio a
+## day or more later, what a trusted survivor says — and only what is true.
+## What has been learned is kept and can be read back (「町のうわさ」).
+
+const CAP := 200
+
+static func _history(world) -> Array:
+	var st: Dictionary = world.s.survivors
+	if not st.get("history") is Array:
+		st.history = []
+	return st.history
+
+static func _peek(world) -> Array:
+	var st = world.s.get("survivors")
+	return st.get("history", []) if st is Dictionary and st.get("history") is Array else []
+
+static func record(world, kind: String, place: String, text: String, ref: String = "") -> void:
+	if not world.s.get("survivors") is Dictionary:
+		return
+	var h := _history(world)
+	h.append({"day": int(world.s.minute) / 1440 + 1, "at": int(world.s.minute), "kind": kind, "place": place, "text": text, "ref": ref, "known": false})
+	while h.size() > CAP:
+		h.pop_front()
+
+static func _learn(entry: Dictionary, how: String) -> void:
+	entry.known = true
+	entry.how = how
+
+## Smoke from a cooking fire, seen from home: groups living along the street.
+const IN_SIGHT := ["食品店", "金物店", "薬局"]
+static func from_window(world) -> String:
+	var Groups = load("res://scripts/npc_groups.gd")
+	var lines: Array = []
+	for place in IN_SIGHT:
+		var g: Dictionary = Groups.at(world, place)
+		if g.is_empty():
+			continue
+		lines.append("%sの方から、煮炊きの煙が細く上がっている。誰かが暮らしているようだ。" % place)
+		for e in _peek(world):
+			if str(e.kind) == "group_found" and str(e.ref) == str(g.id) and not bool(e.known):
+				_learn(e, "窓から見た")
+	return "".join(lines)
+
+## A voice on the radio or the net: one thing a day or more old, not yet known.
+static func from_air(world, channel: String) -> String:
+	if not str(world.s.get("society", "normal")) in ["disrupted", "emergency"]:
+		return ""
+	var now := int(world.s.minute)
+	for i in range(_peek(world).size() - 1, -1, -1):
+		var e: Dictionary = _peek(world)[i]
+		if bool(e.known) or not str(e.kind) in ["group_found", "group_end", "raid", "gang", "gang_end"] or now - int(e.at) < 1440:
+			continue
+		# Not every listen carries it.
+		if world.draw(now / 60, i, "town-air", 100) >= 45:
+			return ""
+		_learn(e, "ラジオで聞いた" if channel == "radio" else "SNSで見た")
+		var what := "%sに、何人かで立てこもって暮らしている人たちがいるらしい。" % str(e.place) if str(e.kind) == "group_found" else "%sで暮らしていた人たちは、いなくなったらしい。" % str(e.place)
+		# v149.38: what the town's residents did is said as it was told.
+		if str(e.kind) in ["raid", "gang", "gang_end"] or str(e.get("text", "")).contains("らしい"):
+			what = str(e.text)
+		return ("（無線から、かすれた声）" if channel == "radio" else "（SNSの投稿）") + what
+	return ""
+
+## What a survivor who trusts the player tells of people they know.
+static func from_person(world, id: String) -> String:
+	var people: Dictionary = world.s.survivors.people
+	var p: Dictionary = people.get(id, {})
+	# v149.38: one of the town's own knows what became of their neighbours.
+	if p.get("resident") is Array:
+		var home := str(p.resident[0])
+		for k in range(_peek(world).size() - 1, -1, -1):
+			var e: Dictionary = _peek(world)[k]
+			if not bool(e.known) and str(e.place) == home:
+				_learn(e, "%sから聞いた" % str(p.get("name", "")))
+				return "%sのことなら……%s" % [home, str(e.text)]
+	var Groups = load("res://scripts/npc_groups.gd")
+	for other in p.get("acq", {}):
+		var g: Dictionary = Groups.of(world, str(other))
+		if g.is_empty() or bool(g.get("ended", false)) or str(p.get("group", "")) == str(g.id):
+			continue
+		for e in _peek(world):
+			if str(e.kind) == "group_found" and str(e.ref) == str(g.id):
+				_learn(e, "%sから聞いた" % str(p.get("name", "")))
+		return "%sさんたちが、%sで暮らしてる。行けば話くらいはできると思う。" % [str(people[other].get("name", "")), str(g.home)]
+	return ""
+
+## The town as the player knows it.
+static func known_text(world) -> String:
+	var lines: Array = []
+	for e in _peek(world):
+		if bool(e.known):
+			lines.append("%d日目（%s）：%s" % [int(e.day), str(e.get("how", "")), str(e.text)])
+	if lines.is_empty():
+		return "町のことは、まだ何も耳に入っていない。（窓の外、ラジオ、人の話から知ることができる）"
+	return "\n".join(lines.slice(maxi(0, lines.size() - 12)))
