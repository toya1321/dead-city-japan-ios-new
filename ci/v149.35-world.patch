diff --git a/qa/npc_watch.gd b/qa/npc_watch.gd
new file mode 100644
index 0000000..f4fd60f
--- /dev/null
+++ b/qa/npc_watch.gd
@@ -0,0 +1,40 @@
+extends SceneTree
+## Watches the survivors live on their own for DCJ_DAYS days (nobody acts).
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Trade = preload("res://scripts/trade.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED"))
+	g._start_new_game(p)
+	g._finish_intro()
+	var w = g.world
+	var seen_events := 0
+	for day in int(OS.get_environment("DCJ_DAYS")):
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.advance_safe(60)
+		var st: Dictionary = Survivors.ensure(w)
+		var line: Array = []
+		for id in st.people:
+			var q: Dictionary = st.people[id]
+			if str(q.status) == "alive" and not bool(q.get("neighbor", false)) and not str(id).begins_with("shelter"):
+				var gd: Dictionary = Trade.goods(w, str(id))
+				line.append("%s@%s(%s f%.0f w%.0f)" % [q.name, q.place, q.get("plan", "-"), float(gd.get("food", 0)), float(gd.get("water", 0))])
+		print("DAY %d %s | %s" % [day + 1, w.s.society, " ".join(line)])
+		var events: Array = st.get("events", [])
+		for e in events.slice(maxi(0, events.size() - (events.size() - seen_events))):
+			pass
+		for i in range(seen_events, events.size()):
+			print("   * ", events[i].text)
+		seen_events = events.size()
+	var sites := {}
+	for k in w.s.district.sites:
+		sites[k] = "%.0f/%.0f" % [float(w.s.district.sites[k].food), float(w.s.district.sites[k].water)]
+	print("SITES ", sites)
+	quit()
diff --git a/qa/perf_long.gd b/qa/perf_long.gd
new file mode 100644
index 0000000..617ec1b
--- /dev/null
+++ b/qa/perf_long.gd
@@ -0,0 +1,33 @@
+extends SceneTree
+## Time per simulated day and save size, over DCJ_DAYS days (nobody acts).
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 9
+	p.cohabitants = 1
+	p.companion_names = ["詩音"]
+	g._start_new_game(p)
+	g._finish_intro()
+	var w = g.world
+	var days := int(OS.get_environment("DCJ_DAYS"))
+	var t0 := Time.get_ticks_msec()
+	for day in days:
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			for m in w.s.household_members:
+				m.hunger = 0.0; m.thirst = 0.0; m.health = 100.0
+			w.advance_safe(60)
+		if day % 30 == 29:
+			var people: Dictionary = Survivors.ensure(w).people
+			var alive := 0
+			for id in people:
+				if str(people[id].status) == "alive": alive += 1
+			var size := JSON.stringify(w.s).length()
+			print("DAY %d ms/day=%.0f save=%dKB society=%s survivors_alive=%d walkers_total=%d events=%d chronicle=%d" % [day + 1, float(Time.get_ticks_msec() - t0) / float(day + 1), size / 1024, w.s.society, alive, load("res://scripts/walkers.gd").total(w), w.s.events.size(), load("res://scripts/chronicle.gd").state(w).get("notes", []).size()])
+	quit()
