+## What one room holds (the same every time it is first opened).
+static func _room_goods(world, area: String, i: int, room: String) -> Dictionary:
+	var r := func(salt: String, n: int) -> int: return _h(world, area, i, room + salt) % n
+	match room:
+		"台所":
+			return {"food": float(2 + r.call("f", 4)), "water": float(2 * r.call("w", 3))}
+		"押し入れ":
+			# The emergency kit the city told everyone to keep.
+			var kit: bool = r.call("kit", 100) < 45
+			return {"food": 2.0 if kit else 0.0, "water": 6.0 if kit else 0.0, "bandage": 2 if kit else 0, "blanket": 1 if r.call("b", 100) < 70 else 0}
+		"居間":
+			return {"cigarettes": 20 * (1 if r.call("c", 100) < 25 else 0), "cash": 1000 * r.call("cash", 6)}
+		"寝室":
+			return {"cash": 1000 * r.call("cash", 15), "blanket": 1 if r.call("b", 100) < 50 else 0}
+		"子ども部屋":
+			return {"weapon": "bat" if r.call("bat", 100) < 30 else ""}
+		"風呂場":
+			return {"water": float(4 * (1 if r.call("w", 100) < 30 else 0))}
+		"物置":
+			return {"wood": r.call("wd", 3), "parts": r.call("pt", 2), "seeds": 1 if r.call("s", 100) < 40 else 0, "weapon": "golf" if r.call("g", 100) < 15 else ""}
+	return {}
+
+## Searching a room: ten minutes, and what is there is taken (what can be
+## carried); a ransacked home has little left but what nobody wanted.
+static func search(world, room: String) -> String:
+	var at: Dictionary = world.s.get("inside", {})
+	if at.is_empty() or bool(at.get("at_door", false)):
+		return "まず部屋に入る必要がある。"
+	var area := str(at.area)
+	var i := int(at.index)
+	if not room in home(world, area, i).rooms:
+		return "この家に%sはない。" % room
+	var st := state(world, area, i)
+	if bool(st.get("walker_pending", false)):
+		if not Walkers.ensure(world).encounter.is_empty():
+			return "まだ、部屋の中に動くものがいる。"
+		st.cleared = true
+		st.erase("walker_pending")
+	var left_here: Dictionary = st.get("left", {}).get(room, {})
+	if room in st.rooms_done and left_here.is_empty():
+		return "%sはもう調べた。" % room
+	world.advance_safe(10 if left_here.is_empty() else 3)
+	var goods := _room_goods(world, area, i, room)
+	var picked := ransacked(world, area, i)
+	if not left_here.is_empty():
+		# Coming back for what could not be carried the first time.
+		goods = left_here.duplicate()
+		picked = false
+	if not room in st.rooms_done:
+		st.rooms_done.append(room)
+	st.last_room = room
+	var leftover := {}
+	var bag: Dictionary = world.s.district.bag
+	var found: Array = []
+	var pool: Dictionary = District.houses(world, area)
+	for item in goods:
+		var v = goods[item]
+		if picked and item in ["food", "water", "cash", "cigarettes", "bandage"]:
+			continue
+		match item:
+			"food":
+				var take := minf(float(v), minf(District.FOOD_LIMIT - float(bag.food), float(pool.food)))
+				if take > 0.0:
+					bag.food = float(bag.food) + take
+					pool.food = float(pool.food) - take
+					found.append("食料%.0f人日分" % take)
+				if float(v) > take:
+					leftover.food = float(v) - take
+			"water":
+				var take := minf(float(v), minf(District.WATER_LIMIT - float(bag.water), float(pool.water)))
+				if take > 0.0:
+					bag.water = float(bag.water) + take
+					pool.water = float(pool.water) - take
+					found.append("水%.0fL" % take)
+				if float(v) > take:
+					leftover.water = float(v) - take
+			"bandage", "wood", "parts", "seeds":
+				if int(v) > 0:
+					world.s.inventory[item] = int(world.s.inventory.get(item, 0)) + int(v)
+					found.append("%s%d" % [District.EXTRA_LABEL[item], int(v)])
+			"cigarettes":
+				if int(v) > 0:
+					world.s.cigarettes = int(world.s.get("cigarettes", 0)) + int(v)
+					found.append("タバコ1箱")
+			"cash":
+				if int(v) > 0:
+					world.s.cash = int(world.s.cash) + int(v)
+					found.append("現金%d円" % int(v))
+			"blanket":
+				if int(v) > 0:
+					var cold: Dictionary = load("res://scripts/cold.gd").state(world)
+					cold.blankets = int(cold.get("blankets", 0)) + int(v)
+					found.append("毛布")
+			"weapon":
+				if not str(v).is_empty():
+					var Weapons = load("res://scripts/weapons.gd")
+					Weapons.state(world).weapons.append({"type": str(v), "wear": 60})
+					found.append(Weapons.name_of(str(v)))
+	# What could not be carried stays in the room, to come back for.
+	var all_left: Dictionary = st.get("left", {})
+	if leftover.is_empty():
+		all_left.erase(room)
+	else:
+		all_left[room] = leftover
+		found.append("持ちきれなかった%sは、そのまま置いてきた（取りに戻れる）" % "と".join(leftover.keys().map(func(k): return "食料%.0f人日分" % float(leftover[k]) if k == "food" else "水%.0fL" % float(leftover[k]))))
+	st.left = all_left
+	var left := rooms_left(world, area, i)
+	var rest := "（残り：%s）" % "、".join(left) if not left.is_empty() else "（この家は、もう調べるところがない）"
+	if found.is_empty():
+		return "%sを調べた（10分）。%s何も見つからなかった。%s" % [room, "荒らされた後で、" if picked else "", rest]
+	return "%sを調べた（10分）。見つけた：%s。%s" % [room, "、".join(found), rest]
+
+static func leave(world) -> String:
+	if world.s.get("inside", {}).is_empty():
+		return "部屋の中にはいない。"
+	world.s.inside = {}
+	world.advance_safe(1)
+	return "部屋を出て、外へ戻った。"
+
+## v149.38: the picture inside a home. At the door, the building's own
+## door (danchi steel door, tower inner corridor, house porch) by the
+## state of the town; in a room, that room — as it was left, gone through,
+## or a year on. "" when there is nothing to show (no file yet: the frame
+## shows the address in words instead).
+const ROOM_FILES := {"台所": "kitchen", "居間": "living", "寝室": "bedroom", "押し入れ": "closet",
+	"子ども部屋": "kids", "風呂場": "bath", "物置": "shed"}
+static func photo(world, phase: String) -> String:
+	var at: Dictionary = world.s.get("inside", {}) if world.s.get("inside") is Dictionary else {}
+	if at.is_empty():
+		return ""
+	var area := str(at.area)
+	var i := int(at.index)
+	var names: Array = []
+	var room := str(_peek_state(world, area, i).get("last_room", ""))
+	if bool(at.get("at_door", false)) or room.is_empty():
+		var kind: String = {"団地": "danchi", "駅前のマンション": "tower"}.get(area, "house")
+		var base := "door_" + str(kind)
+		match phase:
+			"overgrown": names = [base + "_overgrown", base + "_collapse", base]
+			"collapse": names = [base + "_collapse", base]
+			"alert": names = [base + "_alert", base]
+			_: names = [base]
+	else:
+		var base := "home_" + str(ROOM_FILES.get(room, "living"))
+		if phase == "overgrown":
+			names.append(base + "_overgrown")
+		# A year on, a room without its own photo looks gone through, not tidy.
+		if ransacked(world, area, i) or phase == "overgrown":
+			names.append(base + "_ransacked")
+		names.append(base)
+	for n in names:
+		if ResourceLoader.exists("res://assets/photos/%s.jpg" % n):
+			return "res://assets/photos/%s.jpg" % n
+	return ""
+
+static func inside(world) -> bool:
+	return not world.s.get("inside", {}).is_empty()
+
+## Leaving an area (or the town) means leaving any home in it.
+static func left_area(world, place: String) -> void:
+	var at: Dictionary = world.s.get("inside", {})
+	if not at.is_empty() and str(at.get("area", "")) != place:
+		world.s.inside = {}
