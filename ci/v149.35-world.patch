+	check(NpcGroups.describe(w, "近所の空き家").contains("2人"), "and the player finds them there")
+	check(NpcGroups.shelter_factor(w, a) == 1.0, "walls start at nothing")
+	# Days at home: what they carry beyond their needs goes into the store,
+	# walls go up, a garden comes, and the store feeds them.
+	Trade.goods(w, a).food = 8.0
