+extends SceneTree
+## v149.35: the station's waiting room and footbridge; the neighbourhood's
+## life as it grows (street of houses); planters that sprout, grow, ripen —
+## and wither after three dry days.
+const Main = preload("res://main.tscn")
+const SiteRooms = preload("res://scripts/site_rooms.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 11
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var ok := true
+	for r in SiteRooms.rooms("駅のホーム"):
+		for ph in ["", "_alert", "_collapse", "_overgrown"]:
+			if not ResourceLoader.exists("res://assets/photos/station_platform_%s%s.jpg" % [r.key, ph]):
+				ok = false
+	check(ok and SiteRooms.rooms("駅のホーム").size() == 3, "gates, waiting room and footbridge each have their pictures")
+	g._move_to("駅前")
+	g.location = "駅のホーム"
+	g._sync_player_position()
+	await g._on_command("待合室に行く")
+	check(SiteRooms.current(w, "駅のホーム") == "待合室" and SiteRooms.photo(w, "駅のホーム", "collapse").ends_with("station_platform_waiting_collapse.jpg"), "into the waiting room")
+	await g._on_command("跨線橋に行く")
+	check(SiteRooms.current(w, "駅のホーム") == "跨線橋", "over the footbridge")
+	# Neighbourhood life pictures by how far the patch has come.
+	var Communities = load("res://scripts/communities.gd")
+	var Residents = load("res://scripts/residents.gd")
+	if Residents.ready(w):
+		var cm: Dictionary = Communities.all(w)
+		cm["住宅街:0"] = {"area": "住宅街", "block": 0, "since": 0, "store": 10.0, "water": 10.0, "garden": 0.5, "wall": 0.0, "trust": {}, "ended": false, "leader": [0], "last_out": 0}
+		var stages: Array = []
+		for gdn in [0.5, 2.0, 6.0]:
+			cm["住宅街:0"].garden = gdn
+			stages.append(Communities.life_photo(w, "住宅街").get_file())
+		check(stages == ["community_houses_1.jpg", "community_houses_2.jpg", "community_houses_3.jpg"], "the street's life in three stages: %s" % str(stages))
+		cm["団地:0"] = cm["住宅街:0"].duplicate(true)
+		cm["団地:0"].area = "団地"
+		check(Communities.life_photo(w, "団地").get_file().begins_with("community_danchi_"), "the estate has its own pictures, not the street of houses")
+	else:
+		check(false, "residents ready")
+	# Planters.
+	var AP = load("res://scripts/action_photos.gd")
+	w.s.weather = "clear"
+	w.s.plots = [{"growth": 0.1, "water": 1.0, "crop": "komatsuna"}]
+	check(AP.planter_stage(w) == "sprout" and AP.path(w, "planter").ends_with("act_planter_sprout.jpg"), "a sprouting planter")
+	w.s.plots[0].growth = 0.6
+	check(AP.planter_stage(w) == "growing", "a growing planter")
+	w.s.plots[0].growth = 1.0
+	check(AP.planter_stage(w) == "ready", "a planter ready to pick")
+	w.s.plots = [{"growth": 0.5, "water": 0.0, "crop": "komatsuna", "dry": 2.99}]
+	w.s.weather = "clear"
+	for m in 20:
+		w.s.weather = "clear"
+		w.step(false)
+	check(bool(w.s.plots[0].get("dead", false)) and AP.planter_stage(w) == "withered", "three dry days, and it withers")
+	var planters := int(w.s.inventory.planter)
+	g.location = "台所"
+	g._sync_player_position()
+	await g._on_command("収穫")
+	check(w.s.plots.is_empty() and int(w.s.inventory.planter) == planters + 1 and g.log_entries.slice(-6).any(func(e): return str(e).contains("枯れた株を抜いた")), "the dead plants are pulled and the planter is free")
+	check(AP.detect("枯れた株を抜いた。").get("kind", "") == "planter", "pulling them shows the withered planter")
+	# The living room after dark; the estate's life from bare to settled.
+	var Cold = load("res://scripts/cold.gd")
+	w.s.minute = (int(w.s.minute) / 1440) * 1440 + 1440 + int((22.0 - float(w.s.start_hour)) * 60.0)
+	w.s.lights_off = false
+	var lit: String = Cold.season_photo(w, "居間", "一戸建て")
+	w.s.lights_off = true
+	var dark: String = Cold.season_photo(w, "居間", "一戸建て")
+	w.s.lights_off = false
+	check((lit == "living_night" or not w.has_home_power()) and dark == "living_night_dark", "the living room at night: %s / %s" % [lit, dark])
+	if Residents.ready(w):
+		var cm2: Dictionary = Communities.all(w)
+		var seen: Array = []
+		for gdn in [0.1, 0.5, 2.0, 6.0]:
+			cm2["団地:0"].garden = gdn
+			seen.append(Communities.life_photo(w, "団地").get_file())
+		cm2["駅前のマンション:0"] = cm2["団地:0"].duplicate(true)
+		cm2["駅前のマンション:0"].area = "駅前のマンション"
+		var tower: Array = []
+		for gdn in [0.5, 2.0, 6.0]:
+			cm2["駅前のマンション:0"].garden = gdn
+			tower.append(Communities.life_photo(w, "駅前のマンション").get_file())
+		check(tower == ["community_tower_1.jpg", "community_tower_2.jpg", "community_tower_3.jpg"], "the tower's rooftop in three stages: %s" % str(tower))
+		check(seen == ["community_danchi_0.jpg", "community_danchi_1.jpg", "community_danchi_2.jpg", "community_danchi_3.jpg"], "the estate's courtyard in four stages: %s" % str(seen))
+	check(AP.detect("台所で、ガスコンロで温かい食事を作って食べた（30分）。").get("kind", "") == "cook_home" and AP.path(w, "cook_home").ends_with("act_cook_home.jpg"), "a meal on the gas stove")
+	check(AP.detect("台所で、カセットコンロで温かい食事を作って食べた（30分）。").get("kind", "") == "cook", "a meal on the camping stove keeps its own picture")
+	w.s.food = 20.0
+	check(AP.path(w, "pack_home").ends_with("act_pack_stocked.jpg"), "a full stock room")
+	w.s.food = 1.0
+	check(AP.path(w, "pack_home").ends_with("act_pack_bare.jpg"), "a bare stock room")
+	w.s.food = 10.0
+	w.s.water = 30.0
+	await g._on_command("洗濯する")
+	var line: String = str(g.log_entries[-1])
+	check((line.begins_with("洗濯機を回し") or line.begins_with("たらいに水を張って")) and AP.detect(line).get("kind", "") == "laundry", "doing the laundry: " + line.left(40))
+	g.queue_free()
+	print("RESULT %s" % ("PASS" if failures == 0 else "FAIL"))
+	quit(1 if failures else 0)
