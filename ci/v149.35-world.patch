diff --git a/qa/chip_fuzz.gd b/qa/chip_fuzz.gd
new file mode 100644
index 0000000..f468d55
--- /dev/null
+++ b/qa/chip_fuzz.gd
@@ -0,0 +1,100 @@
+extends SceneTree
+## Presses every suggested chip, everywhere, in each period of the outbreak,
+## and reports chips the game does not understand or answers oddly.
+## (State is restored after each press.)  DCJ_SEED.
+const Main = preload("res://main.tscn")
+const TownMap = preload("res://scripts/town_map.gd")
+const BAD := ["処理できない", "正確に解釈できません", "正確に処理できない", "何も実行していません", "SCRIPT ERROR"]
+var issues := {}
+var pressed := 0
+func _initialize() -> void:
+	call_deferred("run")
+func live(w, days: int) -> void:
+	for d in days:
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 10.0; w.s.health = 100.0
+			w.s.walkers.encounter = {}
+			w.advance_safe(60)
+func press_all(g, label: String) -> void:
+	var w = g.world
+	var chips: Array = g._suggestions()
+	if OS.get_environment("DCJ_SELFTEST") == "1":
+		chips = ["ほげほげをふがふがする"] + chips.slice(0, 1)
+	for chip in chips:
+		var keep: Dictionary = w.s.duplicate(true)
+		var keep_loc: String = g.location
+		g.log_entries.clear()
+		w.s.walkers.notices = []
+		var n: int = 0
+		await g._on_command(str(chip))
+		while g.advancing:
+			await process_frame
+		pressed += 1
+		var said := "\n".join(g.log_entries.slice(n))
+		if OS.get_environment("DCJ_DUMP") == "1" and str(chip) in ["ノックする", "食料を分ける", "集まりを訪ねる", "手伝う", "仲間に入れてもらう", "話を聞く", "避難所の様子を聞く", "掲示板を見る", "周囲を見る", "ドアをこじ開ける", "台所を調べる", "居間を調べる", "寝室を調べる", "押し入れを調べる", "風呂場を調べる", "子ども部屋を調べる", "物置を調べる", "次の部屋を探す"]:
+			print("SAID ", label, " | ", chip, " => ", said.replace("\n", " / "))
+		for b in BAD:
+			if said.contains(b):
+				var key := "%s | %s" % [label, chip]
+				if not issues.has(key):
+					issues[key] = said.replace("\n", " / ").left(160)
+		if said.strip_edges().is_empty() or said.strip_edges() == "▶ " + str(chip):
+			issues["%s | %s" % [label, chip]] = "(no answer)"
+		w.s = keep
+		g.location = keep_loc
+		g._sync_player_position()
+		g.dialogue = load("res://scripts/household_dialogue.gd").new()
+		g.survivor_partner = ""
+func visit_all(g, period: String) -> void:
+	var w = g.world
+	var places: Array = ["寝室", "居間", "台所", "玄関", "屋外", "住宅街", "商店通り", "コンビニ", "食品店", "金物店", "薬局", "駅前", "避難所"] + TownMap.PLACES.keys()
+	for p in places:
+		w.s.walkers.places = {}
+		w.s.walkers.encounter = {}
+		w.s.inside = {}
+		g.location = p
+		g._sync_player_position()
+		w.set_meta("player_at_home", load("res://scripts/navigation.gd").indoor(p))
+		w.set_meta("player_place", p)
+		await press_all(g, "%s@%s" % [period, p])
+		# At a door / inside a flat, in the residential areas.
+		if load("res://scripts/district.gd").is_houses(p) and period != "normal":
+			var D = load("res://scripts/dwellings.gd")
+			for k in 3:
+				var i: int = D.next_index(w, p)
+				if i < 0:
+					break
+				g._enter_home(p, i + k * 7)
+				w.s.walkers.encounter = {}
+				await press_all(g, "%s@%s/home%d%s" % [period, p, i + k * 7, "(door)" if bool(w.s.get("inside", {}).get("at_door", false)) else ""])
+				w.s.inside = {}
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED"))
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	await visit_all(g, "normal")
+	if OS.get_environment("DCJ_SELFTEST") == "1":
+		print("ISSUES ", issues.size(), " sample: ", issues.values().slice(0, 2))
+		quit()
+		return
+	while str(w.s.society) in ["normal"] and int(w.s.minute) < 30 * 1440:
+		live(w, 1)
+	await visit_all(g, str(w.s.society))
+	while str(w.s.society) != "emergency" and int(w.s.minute) < 40 * 1440:
+		live(w, 1)
+	live(w, 3)
+	await visit_all(g, "emergency-early")
+	live(w, 45)
+	w.s.walkers.notices = []
+	await visit_all(g, "emergency-late")
+	print("PRESSED ", pressed)
+	for k in issues:
+		print("ISSUE ", k, " => ", issues[k])
+	print("ISSUES ", issues.size())
+	quit()
