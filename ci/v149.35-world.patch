diff --git a/qa/residents_invariants.gd b/qa/residents_invariants.gd
new file mode 100644
index 0000000..3292cf3
--- /dev/null
+++ b/qa/residents_invariants.gd
@@ -0,0 +1,105 @@
+extends SceneTree
+## Lives the town for DCJ_DAYS days (seed DCJ_SEED) and checks, every day,
+## that nothing has got into a state that cannot be: households, the shelter,
+## communities, gangs, wanderers, the town's stores, and save/load.
+const Main = preload("res://main.tscn")
+const R = preload("res://scripts/residents.gd")
+const C = preload("res://scripts/communities.gd")
+const Gg = preload("res://scripts/gangs.gd")
+const Sh = preload("res://scripts/shelter.gd")
+var problems := {}
+func _initialize() -> void:
+	call_deferred("run")
+func bad(day: int, what: String) -> void:
+	if not problems.has(what):
+		problems[what] = day
+		print("PROBLEM day %d: %s" % [day, what])
+func check_world(w, day: int) -> void:
+	var st: Dictionary = w.s.residents
+	var looters := {}
+	var gangs: Dictionary = st.get("gangs", {})
+	for gid in gangs:
+		var g: Dictionary = gangs[gid]
+		for h in g.homes:
+			var key := "%s:%d" % [h[0], int(h[1])]
+			if looters.has(key):
+				bad(day, "household in two gangs %s" % key)
+			looters[key] = gid
+		if float(g.store) < -0.01: bad(day, "gang store negative")
+		if not bool(g.ended):
+			for h in g.homes:
+				var hr: Array = R.row(w, str(h[0]), int(h[1]))
+				if not str(hr[0]) in ["looter", "dead", "gone", "wander"]:
+					bad(day, "gang member household path %s" % hr[0])
+	var cms: Dictionary = st.get("cm", {})
+	for area in st.hh:
+		var rows: Array = st.hh[area]
+		for i in rows.size():
+			var r: Array = rows[i]
+			var who: Dictionary = R.who(w, area, i)
+			var n: int = who.people.size()
+			var full := (1 << n) - 1
+			var path := str(r[0])
+			if int(r[R.P_ALIVE]) & ~full: bad(day, "alive bits beyond family size")
+			if int(r[R.P_TURNED]) & ~full: bad(day, "turned bits beyond family size")
+			if int(r[R.P_ALIVE]) & int(r[R.P_TURNED]): bad(day, "someone both alive and turned")
+			if float(r[R.P_FOOD]) < -0.01: bad(day, "household food negative (%s)" % path)
+			if float(r[R.P_WATER]) < -0.01: bad(day, "household water negative")
+			if path == "dead" and R.living(r) > 0: bad(day, "dead household with living people")
+			if path == "turned" and int(r[R.P_TURNED]) == 0: bad(day, "turned household with nobody turned")
+			if path in ["home", "holed", "shelter", "looter", "wander"] and R.living(r) == 0:
+				bad(day, "%s household with nobody alive" % path)
+			if int(r[R.P_FLAGS]) & C.F_COMM:
+				if path != "holed": bad(day, "community member not holed (%s)" % path)
+				var ck := "%s:%d" % [area, C.block_of(area, i)]
+				if not cms.has(ck) or bool(cms[ck].ended): bad(day, "community member of no living community")
+			if path == "looter" and not looters.has("%s:%d" % [area, i]): bad(day, "looter in no gang")
+			if path == "wander":
+				var p: Dictionary = w.s.survivors.people.get("res_%s_%d" % [area, i], {})
+				if p.is_empty(): bad(day, "wanderer with no survivor record")
+	for key in cms:
+		var c: Dictionary = cms[key]
+		if float(c.store) < -0.01: bad(day, "community store negative")
+		if not bool(c.ended) and C.members(w, c).is_empty(): bad(day, "living community with no members")
+	# The shelter's count.
+	var sh: Dictionary = w.s.get("shelter", {})
+	if str(sh.get("status", "")) == "open":
+		var ours: int = R.in_shelter(w)
+		if int(sh.pop) != int(sh.get("outsiders", 0)) + ours:
+			bad(day, "shelter pop %d != outsiders %d + residents %d" % [int(sh.pop), int(sh.get("outsiders", 0)), ours])
+		if int(sh.pop) > Sh.capacity(w) + 5: bad(day, "shelter over capacity %d" % int(sh.pop))
+	elif R.in_shelter(w) > 0:
+		bad(day, "residents in a shelter that is %s" % sh.get("status", "?"))
+	# The town's stores.
+	for a in w.s.district.get("houses_by", {}):
+		var pool: Dictionary = w.s.district.houses_by[a]
+		if float(pool.food) < -0.01 or float(pool.water) < -0.01: bad(day, "house pool negative in %s" % a)
+	for site in w.s.district.sites:
+		if float(w.s.district.sites[site].food) < -0.01: bad(day, "site food negative %s" % site)
+	if float(st.get("beyond", 0.0)) < -0.01: bad(day, "beyond negative")
+	if not R.valid(st): bad(day, "residents state invalid")
+	if not w.validate_state(w.s.duplicate(true)): bad(day, "whole state fails validation")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED"))
+	g._start_new_game(p)
+	g._finish_intro()
+	var w = g.world
+	var days := int(OS.get_environment("DCJ_DAYS"))
+	for day in days:
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.s.walkers.encounter = {}
+			w.advance_safe(60)
+		check_world(w, day + 1)
+		# Save and load mid-run: the same town comes back.
+		if day == days / 2:
+			var saved := JSON.stringify(w.s)
+			var parsed = JSON.parse_string(saved)
+			if not w.validate_state(parsed): bad(day + 1, "saved game does not load")
+	var c: Dictionary = R.census(w)
+	print("END day %d %s problems=%d" % [days, c, problems.size()])
+	quit()
