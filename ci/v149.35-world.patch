+## v149.35: washing the towels and clothes. The machine while there is power
+## and tap water; by hand in a tub after that (10 L of stored water).
+## Clean things lift the spirits — most after a few days without.
+static func _laundry(game) -> bool:
+	var world = game.world
+	if not Navigation.indoor(game.location):
+		return _done(game, "洗濯は家でする。何も実行していません。")
+	var machine: bool = world.has_home_power() and bool(world.s.get("water_online", true))
+	var minutes := 40 if machine else 60
+	if not machine:
+		var stored := float(world.s.get("rain_water", 0.0)) + float(world.s.get("water", 0.0))
+		if stored < 10.0:
+			return _done(game, "手で洗うにも、ためた水が10Lは要る。（雨水と飲み水を合わせて%.0fL）" % stored)
+	world.advance_safe(minutes)
+	var used := 0.0
+	if not machine:
+		used = minf(10.0, float(world.s.get("rain_water", 0.0)))
+		world.s.rain_water = float(world.s.get("rain_water", 0.0)) - used
+		var rest := 10.0 - used
+		if rest > 0.0:
+			world.s.water = float(world.s.water) - rest
+			world.s.water_used = float(world.s.get("water_used", 0.0)) + rest
+	var day := int(world.s.minute) / 1440
+	var since := day - int(world.s.get("laundry_day", -99))
+	world.s.laundry_day = day
+	Mood.ensure(world)
+	Mood.change(world.s, 4.0 if since >= 3 else 1.0)
+	var lead := "洗濯機を回し、タオルと服を脱衣所の物干しに干した（40分）。" if machine else "たらいに水を張って手で洗い、固く絞って、タオルと服を物干しに干した（60分、水10L）。"
+	var feel := "洗いたてのタオルのにおいに、少しだけ気持ちが軽くなった。" if since >= 3 else "これで、しばらくは着替えに困らない。"
+	return _done(game, lead + feel)
