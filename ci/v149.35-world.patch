@@ -0,0 +1,312 @@
+extends RefCounted
+## v149.35 world stage 1: survivors live on their own. Once the town is coming
+## apart, each one decides every few hours from their own state — hunger,
+## thirst, danger where they stand, the night, their nerve — whether to stay
+## hidden, move away from the dead, go for supplies, or make for the shelter.
+## They walk the same streets as the player, one place at a time, take from
+## the same shelves (what they take is gone), and meet one another. Nothing
+## is decided when the player arrives: it has already happened.
+##
+## Kept in each person: place (as before), goods (trade.gd), plan, acq
+## {other_id: {first, last, n}}. A short log of what happened lives in
+## s.survivors.events (bounded) for the world's history.
+
+const Navigation = preload("res://scripts/navigation.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const District = preload("res://scripts/district.gd")
+const Trade = preload("res://scripts/trade.gd")
+const NpcBonds = preload("res://scripts/npc_bonds.gd")
+const NpcGroups = preload("res://scripts/npc_groups.gd")
+
+## Where survivors go. Home rooms and the player's doorstep are not theirs.
+const TownMap = preload("res://scripts/town_map.gd")
+const OLD_PLACES := ["屋外", "商店通り", "住宅街", "駅前", "デパート正面", "デパート", "デパート地下", "コンビニ", "食品店", "金物店", "薬局", "近所の空き家", "避難所"]
+const OLD_SUPPLY := {"コンビニ": "コンビニ", "食品店": "食品店", "金物店": "金物店", "薬局": "薬局", "近所の空き家": "近所の空き家", "デパート": "デパート", "デパート地下": "デパート"}
+## v149.36: and the wider town.
+static var PLACES: Array = OLD_PLACES + TownMap.PLACES.keys()
+static var SUPPLY_SITES: Dictionary = _supply()
+static func _supply() -> Dictionary:
+	var out: Dictionary = OLD_SUPPLY.duplicate()
+	for place in TownMap.buildings():
+		out[place] = place
+	return out
+const LOG_CAP := 60
+
+static func _graph(world) -> Dictionary:
+	var g: Dictionary = Navigation.graph(str(world.s.profile.get("housing", "一戸建て")))
+	var out := {}
+	for place in PLACES:
+		out[place] = g.get(place, []).filter(func(n): return n in PLACES)
+	return out
+
+static func _roamer(id: String, p: Dictionary) -> bool:
+	return str(p.get("status", "")) == "alive" and not bool(p.get("neighbor", false)) and not id.begins_with("shelter") and str(p.get("place", "")) in PLACES
+
+static func _danger(world, place: String) -> int:
+	return Walkers.count(world, place) + Walkers.horde_at(world, place)
+
+static func _site_left(world, place: String, cash: int = 0) -> float:
+	if District.is_houses(place):
+		return float(District.houses(world, place).food) + float(District.houses(world, place).water) / 2.0 if District.houses_open(world) else 0.0
+	var site_name: String = SUPPLY_SITES.get(place, "")
+	if site_name.is_empty():
+		return 0.0
+	var site: Dictionary = world.s.district.sites.get(site_name, {})
+	if site.is_empty():
+		return 0.0
+	# v149.35: a shop still open sells to those with the money.
+	if not bool(site.get("vacant", false)):
+		if cash < 600 or not District.can_enter(world, site_name) or District.is_shop(site_name):
+			return 0.0
+	return float(site.get("food", 0.0)) + float(site.get("water", 0.0)) / 2.0
+
+static func _note(world, text: String, who: String = "") -> void:
+	var st: Dictionary = world.s.survivors
+	var log: Array = st.get("events", [])
+	log.append({"at": int(world.s.minute), "text": text, "who": who})
+	while log.size() > LOG_CAP:
+		log.pop_front()
+	st.events = log
+
+## One step toward a goal along the streets ("" if already there or no way).
+static func _toward(world, from: String, goal: String) -> String:
+	if from == goal:
+		return ""
+	var g := _graph(world)
+	var seen := {from: ""}
+	var queue: Array = [from]
+	while not queue.is_empty():
+		var at: String = queue.pop_front()
+		if at == goal:
+			break
+		for n in g.get(at, []):
+			if not seen.has(n):
+				seen[n] = at
+				queue.append(n)
+	if not seen.has(goal):
+		return ""
+	var step := goal
+	while str(seen[step]) != from:
+		step = str(seen[step])
+	return step
+
+## Hourly, for everyone out there.
+static func hourly(world) -> void:
+	if not world.s.get("survivors") is Dictionary:
+		return
+	var society := str(world.s.get("society", "normal"))
+	if not society in ["disrupted", "emergency"]:
+		return
+	var minute := int(world.s.minute)
+	var hour := int(world.hour_of_day())
+	var night := hour < 6 or hour >= 20
+	var people: Dictionary = world.s.survivors.people
+	var g := _graph(world)
+	var moved := false
+	var arrivals: Array = []
+	for id in people:
+		var p: Dictionary = people[id]
+		if not _roamer(str(id), p):
+			continue
+		# Each person thinks it over every three hours, not all at once.
+		if (hour + absi(hash(str(id))) % 3) % 3 != 0:
+			continue
+		var here := str(p.place)
+		# Walls at a group's home keep the dead off (stage 3).
+		var danger := int(round(float(_danger(world, here)) * NpcGroups.shelter_factor(world, str(id))))
+		var courage := float(p.get("traits", {}).get("courage", 50))
+		var roll: int = world.draw(minute, absi(hash(str(id))) % 9973, "npc-life", 100)
+		var goods := Trade.goods(world, str(id))
+		var hungry := float(goods.get("food", 0.0)) < Trade.reserve(world, str(id), "food") * 0.5
+		var thirsty := float(goods.get("water", 0.0)) < Trade.reserve(world, str(id), "water") * 0.5
+		var goal := ""
+		var plan := "stay"
+		var group_goal: Array = NpcGroups.goal(world, str(id), plan)
+		if not group_goal.is_empty() and str(group_goal[0]) == "forage_for_group":
+			hungry = true
+		# How many of the dead a person will slip past depends on their nerve.
+		# Hunger makes people take chances they would not take fed.
+		var bear := 3 + int(courage / 25.0) + 2 * int(p.get("short_days", 0))
+		if danger >= bear and roll < 70:
+			# Away from the dead: the quietest place next door.
+			plan = "flee"
+			var best := here
+			for n in g.get(here, []):
+				if _danger(world, n) < _danger(world, best):
+					best = n
+			goal = best
+		elif not group_goal.is_empty() and str(group_goal[0]) == "home" and here != str(group_goal[1]):
+			plan = "go_home"
+			goal = str(group_goal[1])
+		elif not group_goal.is_empty() and str(group_goal[0]) == "home":
+			plan = "home"
+		elif night:
+			plan = "hide"
+		elif here == "避難所" and load("res://scripts/shelter.gd").is_open(world):
+			plan = "sheltered"
+		elif (hungry or thirsty) and _site_left(world, here, int(p.get("cash", 0))) > 0.0:
+			plan = "forage"
+		elif (hungry or thirsty or danger > 0) and load("res://scripts/shelter.gd").is_open(world) and float(p.get("traits", {}).get("suspicion", 50)) < 65:
+			plan = "to_shelter"
+			goal = "避難所"
+		elif hungry or thirsty:
+			# The nearest place that still has something, braver ones farther.
+			plan = "to_supplies"
+			var reach := 2 + int(courage / 30.0)
+			var best_d := 99
+			for place in SUPPLY_SITES.keys() + ["住宅街"] + TownMap.houses():
+				if _site_left(world, place, int(p.get("cash", 0))) <= 0.0 or _danger(world, place) >= bear + 2:
+					continue
+				var d := _distance(g, here, place)
+				if d <= reach and d < best_d:
+					best_d = d
+					goal = place
+		elif not _rival_here(world, str(id), here).is_empty():
+			# v149.35 stage 2: away from someone they cannot stand.
+			plan = "avoid"
+			var options_away: Array = g.get(here, [])
+			if not options_away.is_empty():
+				goal = options_away[roll % options_away.size()]
+		elif not NpcBonds.companion(world, str(id)).is_empty() and str(people[NpcBonds.companion(world, str(id))].place) != here and str(people[NpcBonds.companion(world, str(id))].place) in PLACES:
+			# Keeping company with the one they trust most.
+			plan = "with_friend"
+			goal = str(people[NpcBonds.companion(world, str(id))].place)
+		elif roll < 8:
+			# Now and then they look around nearby (and so meet others).
+			plan = "wander"
+			var options: Array = g.get(here, [])
+			if not options.is_empty():
+				goal = options[roll % options.size()]
+		p.plan = plan
+		p.goal = goal
+		if plan == "forage":
+			_forage(world, str(id), p, here)
+		elif not goal.is_empty() and goal != here:
+			var next := _toward(world, here, goal) if not plan in ["flee", "wander", "avoid"] else goal
+			if not next.is_empty():
+				p.place = next
+				moved = true
+				# Someone walking up to where the player stands is noticed
+				# (not at the shelter, where people come and go all day).
+				if world.has_meta("player_place") and str(world.get_meta("player_place")) == next and next != "避難所":
+					arrivals.append(str(p.get("label", "誰か")))
+				if next == "避難所":
+					_note(world, "%sが、避難所に入った。" % str(p.get("name", "")), str(id))
+	if not arrivals.is_empty() and world.s.has("walkers"):
+		world.s.walkers.notices.append("【出会い】%sが、こちらへ歩いてきた。" % "と".join(arrivals.slice(0, 3)))
+	_meetings(world)
+	NpcGroups.hourly(world, func(text, who): _note(world, text, who))
+
+static func _distance(g: Dictionary, from: String, to: String) -> int:
+	if from == to:
+		return 0
+	var seen := {from: 0}
+	var queue: Array = [from]
+	while not queue.is_empty():
+		var at: String = queue.pop_front()
+		for n in g.get(at, []):
+			if not seen.has(n):
+				seen[n] = int(seen[at]) + 1
+				if n == to:
+					return int(seen[n])
+				queue.append(n)
+	return 99
+
+## Taking from the shelves: what is taken is gone for everyone after.
+static func _forage(world, id: String, p: Dictionary, place: String) -> void:
+	if District.is_houses(place):
+		var got := District.search_houses(world, 2.0, 4.0, place)
+		var mine := Trade.goods(world, id)
+		mine.food = float(mine.get("food", 0.0)) + got.x
+		mine.water = float(mine.get("water", 0.0)) + got.y
+		return
+	var site: Dictionary = world.s.district.sites[SUPPLY_SITES[place]]
+	var goods := Trade.goods(world, id)
+	var food := minf(float(site.food), 2.0)
+	var water := minf(float(site.water), 4.0)
+	if not bool(site.get("vacant", false)):
+		# Bought, not taken: as much as the money covers.
+		var cash := int(p.get("cash", 0))
+		food = minf(food, floorf(float(cash) / 600.0))
+		cash -= int(food) * 600
+		water = minf(water, floorf(float(cash) / 120.0) * 2.0)
+		cash -= int(water / 2.0) * 120
+		p.cash = cash
+		if food + water > 0.0:
+			_note(world, "%sが、%sで買い物をしていった。" % [str(p.get("name", "")), place], id)
+	site.food = float(site.food) - food
+	site.water = float(site.water) - water
+	goods.food = float(goods.get("food", 0.0)) + food
+	goods.water = float(goods.get("water", 0.0)) + water
+	if food + water > 0.0 and bool(site.get("vacant", false)):
+		_note(world, "%sが、%sの棚から物資を持ち出した。" % [str(p.get("name", "")), place], id)
+
+## Those in the same place meet, and remember it.
+static func _meetings(world) -> void:
+	var people: Dictionary = world.s.survivors.people
+	var by_place := {}
+	for id in people:
+		var p: Dictionary = people[id]
+		if str(p.get("status", "")) != "alive" or not str(p.get("place", "")) in PLACES:
+			continue
+		if not by_place.has(p.place):
+			by_place[p.place] = []
+		by_place[p.place].append(str(id))
+	var minute := int(world.s.minute)
+	for place in by_place:
+		var here: Array = by_place[place]
+		if here.size() < 2:
+			continue
+		for a in here:
+			for b in here:
+				if a == b:
+					continue
+				var acq: Dictionary = people[a].get("acq", {})
+				var known: Dictionary = acq.get(b, {})
+				if known.is_empty():
+					known = {"first": minute, "last": minute, "n": 0}
+					if a < b:
+						_note(world, "%sと%sが、%sで出会った。" % [str(people[a].get("name", "")), str(people[b].get("name", "")), place], a)
+				if minute - int(known.get("last", 0)) >= 60 or int(known.n) == 0:
+					known.n = int(known.n) + 1
+				known.last = minute
+				acq[b] = known
+				people[a].acq = acq
+		# v149.35 stage 2: those together act toward one another, now and then.
+		var hour := int(world.hour_of_day())
+		for a in here:
+			for b in here:
+				if a == b:
+					continue
+				if (hour + absi(hash([a, b])) % 3) % 3 != 0:
+					continue
+				if str(people[a].get("status", "")) != "alive" or str(people[b].get("status", "")) != "alive":
+					continue
+				NpcBonds.together(world, a, b, func(text, who): _note(world, text, who))
+
+## Someone here this person cannot stand ("" if none).
+static func _rival_here(world, id: String, place: String) -> String:
+	var p: Dictionary = world.s.survivors.people[id]
+	for other in p.get("acq", {}):
+		var k: Dictionary = p.acq[other]
+		var q: Dictionary = world.s.survivors.people.get(other, {})
+		if str(q.get("status", "")) == "alive" and str(q.get("place", "")) == place and int(k.get("like", 0)) + int(k.get("trust", 0)) <= -60:
+			return str(other)
+	return ""
+
+## What can be seen of passers-by from the window (or the doorstep).
+static func passing(world) -> String:
+	if not world.s.get("survivors") is Dictionary:
+		return ""
+	var seen: Array = []
+	for id in world.s.survivors.people:
+		var p: Dictionary = world.s.survivors.people[id]
+		if _roamer(str(id), p) and str(p.place) == "屋外":
+			seen.append(p)
+	if seen.is_empty():
+		return ""
+	if seen.size() == 1:
+		var p: Dictionary = seen[0]
+		var how := "足早に歩いていく" if str(p.get("plan", "")) in ["to_supplies", "to_shelter", "flee"] else "あたりをうかがいながら立っている"
+		return "通りを、%sが%s。" % [str(p.get("label", "誰か")), how]
+	return "通りに、生きている人が%d人いる。何か話しているようだ。" % seen.size()
