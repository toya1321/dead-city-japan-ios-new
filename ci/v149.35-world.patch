diff --git a/scripts/action_photos.gd b/scripts/action_photos.gd
index 35febbb..008680d 100644
--- a/scripts/action_photos.gd
+++ b/scripts/action_photos.gd
@@ -16,7 +16,11 @@ const KINDS := [
 	["fight_miss", "^打ちかかった", "空を切った。"],
 	["eat", "^(しっかり)?食事を取った", "食事をした。"],
 	["eat", "^軽くつまんだ", "少しだけ口にした。"],
+	["cook_home", "^台所で、(ガスコンロ|電気のコンロ)で.*温かい食事を作って食べた", "温かい食事を作った。"],
 	["cook", "^台所で、.*温かい食事を作って食べた", "温かい食事を作った。"],
+	["reversi", "^[^【「（\\n]{1,12}とリバーシを打った（", "リバーシを打った。"],
