+extends SceneTree
+## Watches the survivors live on their own for DCJ_DAYS days (nobody acts).
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Trade = preload("res://scripts/trade.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED"))
+	g._start_new_game(p)
+	g._finish_intro()
+	var w = g.world
+	var seen_events := 0
+	for day in int(OS.get_environment("DCJ_DAYS")):
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.advance_safe(60)
+		var st: Dictionary = Survivors.ensure(w)
+		var line: Array = []
+		for id in st.people:
+			var q: Dictionary = st.people[id]
+			if str(q.status) == "alive" and not bool(q.get("neighbor", false)) and not str(id).begins_with("shelter"):
+				var gd: Dictionary = Trade.goods(w, str(id))
+				line.append("%s@%s(%s>%s f%.0f w%.0f)" % [q.name, q.place, q.get("plan", "-"), q.get("goal", ""), float(gd.get("food", 0)), float(gd.get("water", 0))])
+		print("DAY %d %s | %s" % [day + 1, w.s.society, " ".join(line)])
+		var events: Array = st.get("events", [])
+		for e in events.slice(maxi(0, events.size() - (events.size() - seen_events))):
+			pass
+		for i in range(seen_events, events.size()):
+			print("   * ", events[i].text)
+		seen_events = events.size()
+	var sites := {}
+	for k in w.s.district.sites:
+		sites[k] = "%.0f/%.0f" % [float(w.s.district.sites[k].food), float(w.s.district.sites[k].water)]
+	print("SITES ", sites)
+	var causes := {}
+	for id in Survivors.ensure(w).people:
+		var q: Dictionary = Survivors.ensure(w).people[id]
+		if str(q.status) == "dead":
+			var k := "%s@d%d" % [str(q.get("cause", "?")), int(q.get("died", 0)) / 1440 + 1]
+			causes[k] = int(causes.get(k, 0)) + 1
+	print("DEATHS ", causes)
+	print("HOUSES ", w.s.district.get("houses", {}))
+	print("GROUPS ", JSON.stringify(Survivors.ensure(w).get("groups", {})).left(600))
+	quit()
