@@ -0,0 +1,110 @@
+extends SceneTree
+## v149.35: the general hospital can be walked room by room — lobby, exam
+## room, ward, store room — each with its own picture at every stage of the
+## town, and the back rooms are off limits while the staff are there.
+const Main = preload("res://main.tscn")
+const SiteRooms = preload("res://scripts/site_rooms.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 9
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var all_photos := true
+	for r in SiteRooms.rooms("総合病院"):
+		for ph in ["", "_alert", "_collapse", "_overgrown"]:
+			if not ResourceLoader.exists("res://assets/photos/hospital_%s%s.jpg" % [r.key, ph]):
+				all_photos = false
+	check(all_photos, "every room has a picture for every stage")
+	g.location = "総合病院"
+	g._sync_player_position()
+	check(SiteRooms.current(w, "総合病院").is_empty(), "arriving, you are at the entrance")
+	await g._on_command("ロビーに行く")
+	check(SiteRooms.current(w, "総合病院") == "ロビー", "into the lobby")
+	check(SiteRooms.photo(w, "総合病院", "normal").ends_with("hospital_lobby.jpg"), "the lobby's own picture")
+	await g._on_command("薬品庫に行く")
+	check(SiteRooms.current(w, "総合病院") == "ロビー" and g.log_entries[-1].contains("立ち入り禁止"), "on an ordinary day the store room is off limits")
+	w.s.society = "emergency"
+	w.s.regional_cases = 500
+	await g._on_command("薬品庫に行く")
+	check(SiteRooms.current(w, "総合病院") == "薬品庫", "once it falls apart, anyone can go in")
+	check(SiteRooms.photo(w, "総合病院", "collapse").ends_with("hospital_store_collapse.jpg"), "the store room as it is now")
+	check(SiteRooms.bandage_take(w, "総合病院") > 5, "the store room is where the bandages are")
+	# The ward: a bed to rest in, and someone left behind.
+	w.s.health = 60.0
+	await g._on_command("病室に行く")
+	var seen: String = g.log_entries[-1]
+	print(seen)
+	var Survivors = load("res://scripts/survivors.gd")
+	var left: Array = Survivors.ensure(w).people.keys().filter(func(id): return str(id).begins_with("ward_"))
+	check(left.size() == 1 and g.log_entries.slice(-4).any(func(e): return str(e).contains("奥のベッド")), "in the emptied hospital, a patient was left behind in the ward")
+	if left.size() == 1:
+		var pt: Dictionary = w.s.survivors.people[left[0]]
+		check(int(pt.age) >= 70 and not str(pt.get("face", "")).is_empty(), "one of the town's old people, with their own face")
+	await g._on_command("ベッドで休む")
+	check(float(w.s.health) > 60.0 and g.log_entries.slice(-15).any(func(e): return str(e).contains("体力 +")), "resting in a ward bed heals (%.0f)" % float(w.s.health))
+	g._move_to("大通り")
+	check(SiteRooms.current(w, "総合病院").is_empty(), "leaving, you come back in at the entrance")
+	# The supermarket works the same way, and its back room holds the drinks.
+	var sm_ok := true
+	for r in SiteRooms.rooms("スーパー"):
+		for ph in ["", "_alert", "_collapse", "_overgrown"]:
+			if not ResourceLoader.exists("res://assets/photos/supermarket_%s%s.jpg" % [r.key, ph]):
+				sm_ok = false
+	check(sm_ok and SiteRooms.rooms("スーパー").size() == 3, "the supermarket's three rooms have their pictures")
+	w.s.site_room = {"place": "スーパー", "room": "バックヤード"}
+	var back: float = SiteRooms.share(w, "スーパー", "water")
+	w.s.site_room = {"place": "スーパー", "room": "冷蔵売り場"}
+	check(back > SiteRooms.share(w, "スーパー", "water"), "more water in the back room than in the chilled aisle")
+	# Drawing and boiling water have their own pictures.
+	var AP = load("res://scripts/action_photos.gd")
+	var kinds := {}
+	for line in ["川べりにしゃがみ、空のポリタンクに水を8L汲んだ。", "池のほとりにかがみ、空のポリタンクに水を8L汲んだ。", "ためておいた水4Lを鍋で煮沸し、冷まして飲み水にした（30分）。"]:
+		for k in AP.KINDS:
+			var re := RegEx.new()
+			re.compile(str(k[1]))
+			if re.search(line) != null:
+				kinds[str(k[0])] = true
+				break
+	check(kinds.has("draw_river") and kinds.has("draw_pond") and kinds.has("boil"), "river, pond and boiling each show their picture")
+	# The lower secondary school and the station gates work the same way.
+	var more_ok := true
+	for site in [["中学校", "junior_high"], ["駅のホーム", "station_platform"]]:
+		for r in SiteRooms.rooms(site[0]):
+			for ph in ["", "_alert", "_collapse", "_overgrown"]:
+				if not ResourceLoader.exists("res://assets/photos/%s_%s%s.jpg" % [site[1], r.key, ph]):
+					more_ok = false
+	check(more_ok and SiteRooms.rooms("中学校").size() == 3 and SiteRooms.rooms("駅のホーム").size() == 3, "school rooms and station gates have their pictures")
+	w.s.society = "normal"
+	w.s.regional_cases = 0
+	g._move_to("北の住宅街")
+	g.location = "中学校"
+	g._sync_player_position()
+	await g._on_command("職員室に行く")
+	check(SiteRooms.current(w, "中学校").is_empty() and g.log_entries[-1].contains("先生"), "teachers keep you out of the staff room")
+	await g._on_command("教室に行く")
+	check(SiteRooms.current(w, "中学校") == "教室" and SiteRooms.photo(w, "中学校", "normal").ends_with("junior_high_classroom.jpg"), "the classroom is open, with its picture")
+	w.s.society = "emergency"
+	w.s.regional_cases = 500
+	await g._on_command("保健室に行く")
+	check(SiteRooms.current(w, "中学校") == "保健室" and SiteRooms.chips(w, "中学校").has("ベッドで休む"), "the nurse's office has beds to rest on")
+	check(SiteRooms.photo(w, "中学校", SiteRooms.phase(w)).ends_with("junior_high_nurse_collapse.jpg"), "the nurse's office after the collapse")
+	g._move_to("駅前")
+	g.location = "駅のホーム"
+	g._sync_player_position()
+	await g._on_command("改札口に行く")
+	check(SiteRooms.current(w, "駅のホーム") == "改札口" and SiteRooms.photo(w, "駅のホーム", "overgrown").ends_with("station_platform_gate_overgrown.jpg"), "through the station's ticket gates")
+	g.queue_free()
+	print("RESULT %s" % ("PASS" if failures == 0 else "FAIL"))
+	quit(1 if failures else 0)
