+		"aliases": ["南の住宅地", "線路の南の住宅街"], "households": 120, "text": {"normal": "商店街の裏手から続く、細い路地の多い住宅街。", "alert": "路地に人の気配がない。", "collapse": "路地の奥で、割れたガラスが日に光っている。"}},
+	"公園": {"kind": "land", "area": "南の住宅地", "links": ["南の住宅街"], "minutes": 3, "pos": Vector2(40, -60), "photo": "park",
+		"aliases": ["大きな公園", "区立公園", "管理棟"], "farmland": true, "water_source": true, "text": {"normal": "芝生広場と池のある区立公園。管理棟と公衆トイレがある。", "alert": "芝生広場に人がいない。管理棟が閉まっている。", "collapse": "芝生が伸びて、池のまわりの柵が倒れている。"}},
