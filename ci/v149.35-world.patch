diff --git a/tests/test_roster149_35.gd b/tests/test_roster149_35.gd
new file mode 100644
index 0000000..19bed11
--- /dev/null
+++ b/tests/test_roster149_35.gd
@@ -0,0 +1,135 @@
+extends SceneTree
+## v149.35: the town's people are fixed. data/residents.json names everyone in
+## all 790 homes — their own face, name, age, family and temperament — and the
+## game reads them from it whatever the seed; what becomes of them still
+## differs from game to game.
+const Main = preload("res://main.tscn")
+const Residents = preload("res://scripts/residents.gd")
+const Dwellings = preload("res://scripts/dwellings.gd")
+const District = preload("res://scripts/district.gd")
+const Portraits = preload("res://scripts/portraits.gd")
+const Wanderers = preload("res://scripts/wanderers.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func new_game(seed: int):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+func run() -> void:
+	var roster := Residents.roster()
+	var homes := 0
+	var people := 0
+	var ids := {}
+	var faces_ok := true
+	for area in Residents.AREAS:
+		var rows: Array = roster.get(area, [])
+		check(rows.size() == District.homes_in(area), "%s: the roster has every home (%d)" % [area, rows.size()])
+		homes += rows.size()
+		for h in rows:
+			for p in h.people:
+				people += 1
+				ids[str(p.id)] = true
+				if Portraits.resident_path(str(p.id)).is_empty():
+					faces_ok = false
+	check(homes == 790, "790 homes in the roster")
+	check(people == ids.size() and people > 1300, "every resident is someone different (%d people)" % people)
+	check(faces_ok, "every resident has their own face picture")
+	var g = await new_game(5)
+	var w = g.world
+	var g2 = await new_game(77)
+	var w2 = g2.world
+	var same := true
+	for i in [0, 47, 199, 299]:
+		var a: Dictionary = Residents.who(w, "団地", i)
+		var b: Dictionary = Residents.who(w2, "団地", i)
+		var entry: Dictionary = roster["団地"][i]
+		if str(a.surname) != str(entry.surname) or str(a.people[0].name) != str(entry.people[0].name) or str(a.people[0].id) != str(entry.people[0].id):
+			same = false
+		if JSON.stringify(a) != JSON.stringify(b):
+			same = false
+		if str(Dwellings.home(w, "団地", i).family) != str(entry.family):
+			same = false
+	check(same, "who lives where is the same in every game, and the home shows that family")
+	var p0: Dictionary = Residents.who(w, "北の住宅街", 3).people[0]
+	check(p0.has("age") and p0.has("trait") and p0.has("story") and p0.has("id"), "each person has an age, a trait and a story")
+	var kids_ok := true
+	for area in Residents.AREAS:
+		for h in roster[area]:
+			var has_kid: bool = h.people.any(func(p): return str(p.band) == "child")
+			if has_kid and str(h.family) != "子どものいる家族":
+				kids_ok = false
+	check(kids_ok, "children live only in the homes of families with children")
+	# Someone who leaves home and stays in town keeps their own face.
+	var mate := {"name": "x", "face": str(roster["団地"][0].people[0].id)}
+	check(Portraits.survivor_face(mate) != null, "a resident met outside shows their own face")
+	# Everyone met outside is one of the residents, and is not also at home.
+	var Survivors = load("res://scripts/survivors.gd")
+	var all_bound := true
+	var detached := true
+	for id in Survivors.ensure(w).people:
+		var sp: Dictionary = w.s.survivors.people[id]
+		var res: Variant = sp.get("resident")
+		if not res is Array or res.size() < 3 or str(sp.get("face", "")).is_empty():
+			all_bound = false
+			continue
+		var rr: Array = Residents.row(w, str(res[0]), int(res[1]))
+		if not rr.is_empty() and int(rr[Residents.P_ALIVE]) & (1 << int(res[2])) != 0:
+			detached = false
+	check(all_bound, "every survivor met is a resident with their own face (%d)" % w.s.survivors.people.size())
+	check(detached, "someone met outside is not also counted at home")
+	# Families at the shelter can be met there.
+	var Shelter = load("res://scripts/shelter.gd")
+	var st: Dictionary = Residents.state(w)
+	var put := 0
+	for i in st.hh["団地"].size():
+		var r: Array = st.hh["団地"][i]
+		if Residents.living(r) >= 2 and put < 6:
+			r[Residents.P_PATH] = "shelter"
+			put += 1
+	Shelter.state(w).status = "open"
+	if Shelter.is_open(w):
+		for id in w.s.survivors.people.keys():
+			if str(w.s.survivors.people[id].place) == "避難所":
+				w.s.survivors.people.erase(id)
+		Survivors.evacuees(w, 3)
+		var evac := 0
+		for id in w.s.survivors.people:
+			if str(id).begins_with("evac_"):
+				evac += 1
+		check(evac >= 1, "families at the shelter are there to be met (%d)" % evac)
+	else:
+		print("SKIP shelter not open in this world")
+	# Whether a household turns to looting is down to its own people.
+	var Gangs = load("res://scripts/gangs.gd")
+	w.s.society = "emergency"
+	var soft := 0
+	var hard := 0
+	for i in 300:
+		var ww: Dictionary = Residents.who(w, "団地", i)
+		var r: Array = st.hh["団地"][i].duplicate()
+		r[Residents.P_PATH] = "holed"
+		var kindest := 100
+		for k in ww.people.size():
+			if bool(ww.people[k].able) and int(r[Residents.P_ALIVE]) & (1 << k):
+				kindest = mini(kindest, int(ww.people[k].kindness))
+		if kindest >= 60 and int(r[Residents.P_FLAGS]) & (Residents.F_ROBBED | Residents.F_HOSTILE) == 0:
+			for d in 5:
+				if Gangs.recruit(w, "団地", i, r, 30 + d):
+					soft += 1
+					break
+	check(soft == 0, "kind people do not turn to looting unless wronged (%d did)" % soft)
+	g.queue_free()
+	g2.queue_free()
+	print("RESULT %s" % ("PASS" if failures == 0 else "FAIL"))
+	quit(1 if failures else 0)
