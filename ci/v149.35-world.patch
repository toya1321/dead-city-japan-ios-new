+	var n := fighters(world, g)
+	if armed and absi(hash([int(world.s.seed), int(world.s.minute), "lair"])) % 100 < 45:
+		return "【危険】%sの奥から、男が%s出てきた。こちらの手の武器を見て、「……さっさと消えな」と吐き捨てた。" % [place, "何人か" if n >= 3 else "二人"]
+	var food := float(bag.food)
+	var water := float(bag.water)
+	bag.food = 0.0
+	bag.water = 0.0
+	var cash := mini(int(world.s.cash), 5000)
+	world.s.cash = int(world.s.cash) - cash
+	g.store = float(g.store) + food
+	return "【危険】%sの奥から、男たちが%s出てきて取り囲んだ。「荷物を置いていけ」　逆らえる人数ではなかった。持ち出し袋の食料と水%sを取り上げられ、突き飛ばされた。" % [place, "何人も" if n >= 4 else "二、三人", "、現金%d円" % cash if cash > 0 else ""]
+
+static func signs(world, place: String) -> String:
+	var g := at(world, place)
+	if g.is_empty():
+		return ""
+	return "奥にドラム缶の焚き火の跡があり、鉄パイプが立てかけてある。誰かがこちらを見張っている気配がする。……住みついた連中の縄張りだ。"
+
+static func street_signs(world, area: String) -> String:
+	var hour := int(world.hour_of_day())
+	for o in world.s.residents.get("gang_out", []):
+		if str(o[0]) == area and hour >= int(o[1]) and hour < int(o[2]):
