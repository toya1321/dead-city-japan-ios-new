+static func _h(world, area: String, i: int, salt: String) -> int:
+	return absi(hash([int(world.s.seed), area, i, salt]))
+
+## What this home was, worked out the same way every time.
+static func home(world, area: String, i: int) -> Dictionary:
+	var total := 0
+	for f in FAMILIES:
+		total += int(f[1])
