diff --git a/tests/test_npc_groups149_35.gd b/tests/test_npc_groups149_35.gd
new file mode 100644
index 0000000..7ca4784
--- /dev/null
+++ b/tests/test_npc_groups149_35.gd
@@ -0,0 +1,174 @@
+extends SceneTree
+## v149.35 world stage 4: the player and a settled group — trading with
+## their store, giving, helping, asking to live there, sleeping and eating
+## there, leaving; each group with its own rule about cash.
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Trade = preload("res://scripts/trade.gd")
+const NpcGroups = preload("res://scripts/npc_groups.gd")
+const NpcBonds = preload("res://scripts/npc_bonds.gd")
+const NpcLife = preload("res://scripts/npc_life.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 12
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.society = "emergency"
+	w.s.minute = 6 * 1440 + 4 * 60
+	w.s.district.sites["近所の空き家"].vacant = true
+	var people: Dictionary = Survivors.ensure(w).people
+	var two: Array = []
+	for id in people:
+		if NpcLife._roamer(str(id), people[id]) and two.size() < 2:
+			two.append(str(id))
+	var a: String = two[0]
+	var b: String = two[1]
+	for id in two:
+		people[id].place = "近所の空き家"
+		people[id].trust = 30
+		people[id].dependents = 0
+	for pair in [[a, b], [b, a]]:
+		var k: Dictionary = NpcBonds.bond(people, pair[0], pair[1], int(w.s.minute))
+		k.trust = 60
+		k.like = 40
+	NpcGroups.hourly(w, func(t, who): pass)
+	var grp: Dictionary = NpcGroups.of(w, a)
+	check(not grp.is_empty(), "a group has settled in the empty house")
+	grp.store.food = 6.0
+	grp.store.water = 10.0
+	g.location = "近所の空き家"
+	g._sync_player_position()
+	w.set_meta("player_place", "近所の空き家")
+	check(g._suggestions().has("手伝う") and g._suggestions().has("仲間に入れてもらう"), "at their home, helping and asking to join are offered")
+
+	# Not yet trusted: they say no, and why.
+	await g._on_command("仲間に入れてもらう")
+	check(str(g.log_entries.slice(-4)).contains("信頼がまだ足りない") and str(w.s.get("npc_group", "")) == "", "strangers are not taken in")
+	# Giving and helping win them over.
+	w.s.district.bag.food = 4.0
+	var store_before := float(grp.store.food)
+	await g._on_command("食料を寄付する")
+	check(float(grp.store.food) == store_before + 1.0 and float(w.s.district.bag.food) == 3.0, "what is given goes into their store, from the player's bag")
+	var walls_before := float(grp.walls)
+	for i in 4:
+		await g._on_command("手伝う")
+	check(float(grp.walls) > walls_before and NpcGroups.opinion(w, grp) >= 45, "working with them raises the walls and their opinion (%d)" % NpcGroups.opinion(w, grp))
+	await g._on_command("仲間に入れてもらう")
+	check(str(w.s.get("npc_group", "")) == str(grp.id), "then they take the player in: " + g.log_entries[-1])
+	# Living there: sleeping and eating from the store.
+	w.s.district.bag.food = 0.0
+	w.s.hunger = 60.0
+	var store_food := float(grp.store.food)
+	await g._on_command("食事する")
+	check(float(grp.store.food) < store_food and float(w.s.hunger) < 60.0, "a member eats from the store")
+	w.s.fatigue = 80.0
+	await g._on_command("寝る")
+	check(float(w.s.fatigue) < 80.0 and not g.log_entries[-1].contains("移動する必要がある"), "and sleeps there")
+
+	# Trading with a member at home draws on the group's store.
+	var spare: Dictionary = Trade.spare(w, a)
+	check(spare.has("water"), "what the group can spare is the store's (%s)" % str(spare))
+
+	# Each group has its own rule about money.
+	w.s.society = "emergency"   # (the test world's own simulation had moved it)
+	w.s.district.sites["コンビニ"].vacant = true
+	w.s.district.sites["デパート"].vacant = true
+	for m in grp.members:
+		people[m].traits.suspicion = 95
+		people[m].role = "student"
+	var rule := NpcGroups.cash_policy(w, grp)
+	check(rule == "goods" and Trade.cash_trust(w, a) < 0.05, "a wary group will not take cash at home (%s, %.2f)" % [rule, Trade.cash_trust(w, a)])
+	for m in grp.members:
+		people[m].traits.suspicion = 5
+		people[m].role = "office"
+	w.s.society = "disrupted"
+	check(NpcGroups.cash_policy(w, grp) != "goods", "another, more trusting, still does")
+
+	# Leaving.
+	await g._on_command("ここを出る")
+	check(str(w.s.get("npc_group", "")) == "", "the player can leave")
+	g._save()
+	g._load()
+	check(str(g.world.s.get("npc_group", "")) == "" and NpcGroups.at(g.world, "近所の空き家").size() > 0, "the group and its home survive a reload")
+	# Stage 5: the town's history reaches the player only through a channel.
+	var TownNews = load("res://scripts/town_news.gd")
+	w = g.world
+	people = Survivors.ensure(w).people
+	w.s.society = "emergency"
+	check(TownNews.known_text(w).contains("まだ何も耳に入っていない"), "nothing is known that was not learned")
+	# A second group along the street: its smoke is seen from the window.
+	var three: Array = []
+	for id in people:
+		if NpcLife._roamer(str(id), people[id]) and str(people[id].get("group", "")) == "" and three.size() < 2:
+			three.append(str(id))
+	w.s.district.sites["金物店"].vacant = true
+	for id in three:
+		people[id].place = "金物店"
+	for pair in [[three[0], three[1]], [three[1], three[0]]]:
+		var k: Dictionary = NpcBonds.bond(people, pair[0], pair[1], int(w.s.minute))
+		k.trust = 60
+		k.like = 40
+	NpcGroups.hourly(w, func(t, who): pass)
+	var smoke: String = TownNews.from_window(w)
+	check(smoke.contains("金物店の方から、煮炊きの煙"), "a group along the street is seen by its smoke")
+	check(TownNews.known_text(w).contains("金物店で、何人かが一緒に暮らし始めた") and TownNews.known_text(w).contains("窓から見た"), "and is remembered, with how it was learned")
+	check(not TownNews.known_text(w).contains("近所の空き家で、何人か"), "the group out of sight is still unknown")
+	# The radio carries it a day or more later, sometimes.
+	w.s.radio = true
+	w.s.minute += 2 * 1440
+	var heard := false
+	for i in 12:
+		w.s.minute += 60
+		var word: String = TownNews.from_air(w, "radio")
+		if word.contains("近所の空き家"):
+			heard = true
+			break
+	check(heard and TownNews.known_text(w).contains("ラジオで聞いた"), "word of the other group comes over the radio")
+	# Stage 6: the player's own settlement, by the same rules.
+	w.s.society = "emergency"
+	w.s.npc_group = ""
+	w.s.district.sites["薬局"].vacant = true
+	w.s.district.sites["薬局"].level = 1
+	g.location = "薬局"
+	g._sync_player_position()
+	w.set_meta("player_place", "薬局")
+	check(g._suggestions().has("ここを集落にする"), "at the player's base, founding a settlement is offered")
+	await g._on_command("ここを集落にする")
+	var mine: Dictionary = NpcGroups.player_group(w)
+	check(not mine.is_empty() and str(mine.home) == "薬局" and bool(mine.player_led), "the player founds a settlement at the base")
+	# Someone who trusts the player comes to live there; a stranger does not.
+	var newcomer := ""
+	for id in people:
+		if NpcLife._roamer(str(id), people[id]) and str(people[id].get("group", "")) == "" and bool(people[id].get("joinable", false)):
+			newcomer = str(id)
+			break
+	people[newcomer].trust = 20
+	check(NpcGroups.invite_to(w, newcomer).contains("もう少し知ってから") and str(people[newcomer].get("group", "")) == "", "a stranger will not come yet")
+	people[newcomer].trust = 70
+	check(NpcGroups.invite_to(w, newcomer).contains("向かうことにした") and str(people[newcomer].group) == str(mine.id), "one who trusts the player comes")
+	# They walk there by themselves, as any member goes home.
+	people[newcomer].place = "屋外"
+	w.s.minute = (int(w.s.minute) / 1440) * 1440 + 13 * 60
+	for h in 6:
+		w.s.minute += 60
+		NpcLife.hourly(w)
+	check(str(people[newcomer].place) == "薬局", "and makes their way to it")
+	# A settlement of the player and one other does not end on its own.
+	w.s.minute = (int(w.s.minute) / 1440 + 1) * 1440
+	NpcGroups.daily(w, func(t, who): pass)
+	check(not bool(mine.ended), "the player's settlement holds while the player belongs")
+	check(NpcGroups.status_text(w).contains("暮らしている人：あなた、"), "and its state can be read")
+	print("v149.35 group checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
