+extends SceneTree
+## v149.35: reversi with a housemate — the rules, how personalities play,
+## a game played through the table to its end, and what it leaves behind.
+const Main = preload("res://main.tscn")
+const Reversi = preload("res://scripts/reversi.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	# Rules.
+	var b := Reversi.new_board()
+	check(Reversi.moves(b, Reversi.BLACK).size() == 4 and Reversi.count(b, Reversi.BLACK) == 2, "the opening: four moves for black")
+	var after := Reversi.play(b, 19, Reversi.BLACK)
+	check(Reversi.count(after, Reversi.BLACK) == 4 and Reversi.count(after, Reversi.WHITE) == 1, "a move turns the discs between")
+	check(Reversi.flips(b, 0, Reversi.BLACK).is_empty(), "a move that turns nothing is not allowed")
+	# Personalities.
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	p.cohabitants = 1
+	p.companion_names = ["詩音"]
+	p.companion_genders = ["女性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var kid := Reversi.profile(w, {"name": "結人", "age": 8, "job": "小学生"})
+	var teacher := Reversi.profile(w, {"name": "佐伯", "age": 45, "job": "教師"})
+	check(str(kid.style) == "child" and float(kid.skill) < 0.3, "a child plays loosely: %s" % str(kid))
+	check(float(teacher.skill) > float(kid.skill) + 0.3, "a teacher reads ahead")
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 3
+	# Greedy grabs discs; careful takes a corner over a big capture.
+	var greedy := {"style": "greedy", "skill": 0.95, "honest": 50, "temper": 50, "kind": 50, "polite": false, "child": false, "first_person": "俺"}
+	var careful := {"style": "careful", "skill": 0.95, "honest": 50, "temper": 50, "kind": 50, "polite": true, "child": false, "first_person": "私"}
+	# A position where white may take the corner (0) or a long row.
+	var pos: Array = []
+	pos.resize(64)
+	pos.fill(0)
+	pos[9] = Reversi.BLACK
+	pos[18] = Reversi.WHITE
+	for c in [33, 34, 35, 36, 37, 38]:
+		pos[c] = Reversi.BLACK
+	pos[39] = Reversi.WHITE
+	pos[27] = Reversi.WHITE
+	check(Reversi.choose(pos, Reversi.WHITE, careful, rng) == 0, "the careful take the corner")
+	check(Reversi.choose(pos, Reversi.WHITE, greedy, rng) == 32, "the greedy take the long row")
+	# Full games between styles always end properly.
+	var ends := true
+	for style in ["greedy", "careful", "gentle", "child", "steady"]:
+		var pr := {"style": style, "skill": 0.5, "honest": 50, "temper": 50, "kind": 80, "polite": false, "child": style == "child", "first_person": "私"}
+		var bd := Reversi.new_board()
+		var side := Reversi.BLACK
+		for t in 130:
+			if Reversi.over(bd):
+				break
+			var m := Reversi.choose(bd, side, pr, rng)
+			if m >= 0:
+				bd = Reversi.play(bd, m, side)
+			side = Reversi.other(side)
+		ends = ends and Reversi.over(bd)
+	check(ends, "games between every style run to the end")
+	# Playing at the table.
+	g.location = "居間"
+	g._sync_player_position()
+	var mate: Dictionary = w.s.household_members[0]
+	mate.location = "居間"
+	mate.activity = "在宅"
+	var minute := int(w.s.minute)
+	await g._on_command("%sとリバーシをする" % mate.name)
+	var table = g.reversi_layer
+	check(table != null and is_instance_valid(table), "the board comes out")
+	table.think = 0.0
+	var guard := 0
+	while not table.done and guard < 80:
+		guard += 1
+		var options := Reversi.moves(table.board, Reversi.BLACK)
+		if table.wait_pending:
+			table._refuse_wait()
+			continue
+		if options.is_empty():
+			break
+		table.place(int(options[0]))
+		await process_frame
+	check(table.done and Reversi.over(table.board), "a whole game played through (%d moves)" % table.moves_played)
+	check(int(w.s.minute) == minute or int(w.s.minute) - minute < 5, "time stands still at the table")
+	var mood_before: float = float(w.s.household_members[0].get("mood", 50.0))
+	table._close("楽しかった")
+	await process_frame
+	var line: String = str(g.log_entries[-1])
+	check(line.begins_with("%sとリバーシを打った（35分）" % mate.name) and line.contains("通算"), "it goes in the chronicle: " + line.left(90))
+	check(int(w.s.minute) - minute >= 35, "the game took its time")
+	check(float(w.s.household_members[0].mood) > mood_before - 0.01, "they enjoyed it")
+	check(load("res://scripts/action_photos.gd").detect(line).get("kind", "") == "reversi", "with its picture")
+	# A take-back, asked by someone not so honest.
+	await g._on_command("リバーシしよう")
+	table = g.reversi_layer
+	table.think = 0.0
+	table.prof.honest = 10
+	var bd2: Array = []
+	bd2.resize(64)
+	bd2.fill(0)
+	bd2[9] = Reversi.WHITE
+	bd2[18] = Reversi.BLACK
+	bd2[27] = Reversi.WHITE
+	bd2[36] = Reversi.BLACK
+	table.board = bd2
+	table.before_their_move = bd2.duplicate()
+	table.their_last = 27
+	table.rng.seed = 1
+	var asked := false
+	for s in 20:
+		table.board = bd2.duplicate()
+		table.turn = Reversi.BLACK
+		table.wait_used = false
+		table.rng.seed = s
+		table.place(0)
+		if table.wait_pending:
+			asked = true
+			break
+	check(asked and table.speech.text.contains("待った") or asked and table.speech.text.contains("まった"), "after you take a corner, they ask for a take-back")
+	table._grant_wait()
+	await process_frame
+	check(not table.wait_pending and table.wait_asked == 1, "you let them")
+	table._quit()
+	await process_frame
+	check(str(g.log_entries[-1]).contains("途中で盤を片づけた"), "putting it away half-way")
+	g.queue_free()
+	print("RESULT %s" % ("PASS" if failures == 0 else "FAIL"))
+	quit(1 if failures else 0)
