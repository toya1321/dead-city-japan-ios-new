diff --git a/scripts/residents.gd b/scripts/residents.gd
new file mode 100644
index 0000000..a9048ef
--- /dev/null
+++ b/scripts/residents.gd
@@ -0,0 +1,950 @@
+extends RefCounted
+## v149.38: the people who live in the town's homes — every household in the
+## estate, the tower block and the three streets of houses (790 homes). Who
+## they are (family, names, temperament, how well stocked) is worked out from
+## the world's seed; what happens to them is kept, and it happens whether or
+## not the player is anywhere near.
+##
+## Each morning every household decides for itself, from its own state and
+## what the town is like: carry on as usual, stock up, leave town for family
+## elsewhere, go to the shelter, or lock the door and hole up. Holed-up homes
+## eat and drink what they have; when it runs low someone has to go out —
+## through the empty homes of the area, or to the shops left open — and the
+## streets decide whether they come back, and whether they come back bitten.
+## People starve, fall ill, turn at home and take their families with them;
+## those left run. A shelter that falls takes its people with it.
+##
+## The player meets all this at the doors (knocking, giving, breaking in), in
+## the signs on the street (lit windows at night, curtains, someone hurrying
+## home with a rucksack), and in what people say.
+##
+## s.residents = {day, out: [[area, place, from_hour, to_hour]],
+##   hh: {area: [[path, food, water, alive, bitten, turned, hungry, flags, since, dry], ...]}}
+## path: home | holed | shelter | away | gone | dead | turned
+
+const TownMap = preload("res://scripts/town_map.gd")
+const District = preload("res://scripts/district.gd")
+const Parts = preload("res://scripts/survivor_parts.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const WorldTraits = preload("res://scripts/world_traits.gd")
+
+const PATHS := ["home", "holed", "shelter", "away", "gone", "dead", "turned", "looter", "wander"]
+const P_PATH := 0
+const P_FOOD := 1
+const P_WATER := 2
+const P_ALIVE := 3
+const P_BITTEN := 4
+const P_TURNED := 5
+const P_HUNGRY := 6
+const P_FLAGS := 7
+const P_SINCE := 8
+const P_DRY := 9
+## flags
+const F_STOCKED := 1
+const F_KNOCKED := 2
+const F_FRIEND := 4
+const F_HOSTILE := 8
+const F_ROBBED := 16
+const F_INSIDE := 32      # the turned are still shut inside
+const F_DIED_HOME := 64
+const F_GAVE := 128       # gave the player something today (reset daily)
+
+const FAMILIES := {
+	"一人暮らしの高齢者": [["senior", ""]],
+	"老夫婦": [["senior", "m"], ["senior", "f"]],
+	"子どものいる家族": [["adult", "m"], ["adult", "f"], ["child", ""], ["child?", ""]],
+	"共働きの夫婦": [["adult", "m"], ["adult", "f"]],
+	"学生の一人暮らし": [["young", ""]],
+	"単身の会社員": [["adult", ""]],
+}
+## Food to be found beyond the bridge, for everyone in town together.
+const BEYOND := 12000.0
+const AREAS := ["団地", "駅前のマンション", "北の住宅街", "南の住宅街", "住宅街"]
+
+static func areas() -> Array:
+	return AREAS.filter(func(a): return District.homes_in(a) > 0)
+
+static func _h(world, area: String, i: int, salt: String) -> int:
+	return absi(hash([int(world.s.seed), area, i, salt]))
+
+static func _roll(world, area: String, i: int, day: int, salt: String, n: int) -> int:
+	return absi(hash([int(world.s.seed), area, i, day, salt])) % maxi(1, n)
+
+static func _day(world) -> int:
+	return (int(float(world.s.get("start_hour", 0)) * 60.0) + int(world.s.minute)) / 1440
+
+# ---------------------------------------------------------------- who they are
+
+## The household's family (the same one the home shows), its people and
+## temperament: [{name, sex, band, able}], caution, kindness, courage, prepared.
+static func who(world, area: String, i: int) -> Dictionary:
+	var family := str(load("res://scripts/dwellings.gd").home(world, area, i).family)
+	var surname: String = Parts.SURNAMES[_h(world, area, i, "surname") % Parts.SURNAMES.size()]
+	var people: Array = []
+	var k := 0
+	for spec in FAMILIES.get(family, [["adult", ""]]):
+		var band := str(spec[0])
+		if band == "child?":
+			if _h(world, area, i, "second-child") % 2 == 0:
+				continue
+			band = "child"
+		var sex := str(spec[1])
+		if sex.is_empty():
+			sex = "m" if _h(world, area, i, "sex%d" % k) % 2 == 0 else "f"
+		var names: Array = Parts.GIVEN_MALE if sex == "m" else Parts.GIVEN_FEMALE
+		people.append({"name": names[_h(world, area, i, "given%d" % k) % names.size()], "sex": sex, "band": band,
+			"able": band in ["adult", "young"]})
+		k += 1
+	return {"family": family, "surname": surname, "people": people,
+		"caution": _h(world, area, i, "caution") % 101, "kindness": _h(world, area, i, "kindness") % 101,
+		"courage": _h(world, area, i, "courage") % 101, "prepared": _h(world, area, i, "prepared") % 101}
+
+static func _bits(n: int) -> int:
+	return (1 << n) - 1
+
+static func _count(mask: int) -> int:
+	var c := 0
+	while mask > 0:
+		c += mask & 1
+		mask >>= 1
+	return c
+
+# ---------------------------------------------------------------- state
+
+static func ready(world) -> bool:
+	return world.s.get("residents") is Dictionary and world.s.residents.get("hh") is Dictionary
+
+static func state(world) -> Dictionary:
+	if not ready(world):
+		world.s.residents = {"day": -1, "out": [], "hh": {}}
+	var st: Dictionary = world.s.residents
+	for area in areas():
+		if not st.hh.has(area):
+			var rows: Array = []
+			for i in District.homes_in(area):
+				rows.append(_fresh(world, area, i))
+			st.hh[area] = rows
+	return st
+
+static func _fresh(world, area: String, i: int) -> Array:
+	var w := who(world, area, i)
+	var n: int = w.people.size()
+	# A bag of rice and a few days' worth in the cupboards; the careful keep
+	# two weeks or more.
+	var days := 4.0 + float(_h(world, area, i, "pantry") % 5) + float(w.prepared) / 12.0
+	return ["home", snappedf(days * n, 0.1), float(4 * n), _bits(n), 0, 0, 0, 0, 0, 0]
+
+static func row(world, area: String, i: int) -> Array:
+	if not ready(world):
+		return []
+	var rows: Array = world.s.residents.hh.get(area, [])
+	return rows[i] if i >= 0 and i < rows.size() else []
+
+static func valid(value: Variant) -> bool:
+	if not value is Dictionary or not value.get("hh") is Dictionary or not value.get("out") is Array:
+		return false
+	for area in value.hh:
+		if not value.hh[area] is Array or value.hh[area].size() > 2000:
+			return false
+		for r in value.hh[area]:
+			if not r is Array or r.size() != 10 or not str(r[0]) in PATHS:
+				return false
+	return true
+
+## Living people in the household (not turned).
+static func living(r: Array) -> int:
+	return _count(int(r[P_ALIVE]))
+
+static func occupied(world, area: String, i: int) -> bool:
+	var r := row(world, area, i)
+	return not r.is_empty() and str(r[P_PATH]) in ["home", "holed"] and living(r) > 0
+
+# ---------------------------------------------------------------- the day
+
+static func hourly(world) -> void:
+	if OS.get_environment("DCJ_NO_RESIDENTS") == "1":
+		return   # QA only: the town as it was before the residents
+	if not world.s.get("survivors") is Dictionary and not ready(world):
+		return
+	# The town's households are there from the first hour (they first decide
+	# anything the next morning).
+	var st := state(world)
+	if int(world.hour_of_day()) != 6:
+		return
+	var day := _day(world)
+	if int(st.day) == day:
+		return
+	st.day = day
+	st.out = []
+	st.gang_out = []
+	daily(world, day)
+
+static func daily(world, day: int) -> void:
+	var st := state(world)
+	var society := str(world.s.get("society", "normal"))
+	var Shelter = load("res://scripts/shelter.gd")
+	var sh: Dictionary = Shelter.state(world) if world.s.get("shelter") is Dictionary else {}
+	var shelter_room := 0
+	if Shelter.is_open(world):
+		shelter_room = maxi(0, Shelter.capacity(world) - int(sh.get("pop", 0)) - int(sh.get("res_in", 0)))
+	var tap := bool(world.s.get("water_online", true))
+	for area in st.hh:
+		var rows: Array = st.hh[area]
+		for i in rows.size():
+			var r: Array = rows[i]
+			r[P_FLAGS] = int(r[P_FLAGS]) & ~F_GAVE
+			var path := str(r[P_PATH])
+			if path in ["away", "gone", "looter", "wander"]:
+				continue   # (looters live with their gang: gangs.gd)
+			if path in ["dead", "turned"]:
+				_shut_in(world, area, i, r)
+				continue
+			_turn(world, area, i, r, day)
+			path = str(r[P_PATH])
+			if path in ["dead", "turned", "gone"]:
+				continue
+			match society:
+				"normal":
+					_normal(world, area, i, r)
+				"alert":
+					_alert(world, area, i, r, day)
+				_:
+					if path == "home":
+						path = _choose(world, area, i, r, day, shelter_room)
+						if path == "shelter":
+							shelter_room -= living(r)
+					if path == "holed" and int(r[P_FLAGS]) & 256 != 0:
+						pass   # lives from the block's common store (communities.gd)
+					elif path == "holed":
+						_holed(world, area, i, r, day, tap)
+						if str(r[P_PATH]) == "shelter":
+							shelter_room -= living(r)
+			_deaths(world, area, i, r, day, society)
+	load("res://scripts/communities.gd").daily(world, day)
+	load("res://scripts/gangs.gd").daily(world, day)
+	load("res://scripts/wanderers.gd").sync(world)
+	_settle(world)
+
+## Bookkeeping after a day: a household no longer holed up is no longer in its
+## block's community, and a household with nobody left alive has ended.
+static func _settle(world) -> void:
+	var day := _day(world)
+	for area in world.s.residents.hh:
+		for r in world.s.residents.hh[area]:
+			var path := str(r[P_PATH])
+			if path != "holed":
+				r[P_FLAGS] = int(r[P_FLAGS]) & ~256
+			if path in ["home", "holed", "shelter"] and living(r) == 0:
+				r[P_PATH] = "turned" if int(r[P_TURNED]) != 0 and int(r[P_FLAGS]) & F_INSIDE else "dead"
+				r[P_FLAGS] = int(r[P_FLAGS]) & ~256
+				r[P_SINCE] = day
+
+static func _normal(world, area: String, i: int, r: Array) -> void:
+	var n := living(r)
+	r[P_PATH] = "home"
+	var w := who(world, area, i)
+	var keep := (4.0 + float(w.prepared) / 12.0) * n
+	r[P_FOOD] = maxf(float(r[P_FOOD]), keep)
+	r[P_WATER] = maxf(float(r[P_WATER]), 4.0 * n)
+
+## Word of the outbreak: some fill the cupboards (from the town's own shelves),
+## some load the car and go to family in the country.
+static func _alert(world, area: String, i: int, r: Array, day: int) -> void:
+	var w := who(world, area, i)
+	var n := living(r)
+	if int(r[P_FLAGS]) & F_STOCKED == 0 and _roll(world, area, i, day, "stock", 100) < 25 + (int(w.caution) + int(w.prepared)) / 4:
+		r[P_FLAGS] = int(r[P_FLAGS]) | F_STOCKED
+		var want := 4.0 * n
+		var got := 0.0
+		for place in ["スーパー", "コンビニ"]:
+			if not world.s.district.sites.has(place):
+				continue
+			var site: Dictionary = world.s.district.sites[place]
+			if bool(site.get("vacant", false)):
+				continue
+			var take := minf(want - got, float(site.food))
+			site.food = float(site.food) - take
+			got += take
+			var wtake := minf(2.0 * n, float(site.water))
+			site.water = float(site.water) - wtake
+			r[P_WATER] = float(r[P_WATER]) + wtake
+			if got >= want:
+				break
+		r[P_FOOD] = float(r[P_FOOD]) + got
+	var leave := 2
+	match w.family:
+		"子どものいる家族": leave = 7
+		"学生の一人暮らし": leave = 12
+		"共働きの夫婦": leave = 4
+		"一人暮らしの高齢者", "老夫婦": leave = 1
+	if _roll(world, area, i, day, "away", 100) < leave:
+		_leave_home(world, area, r, "away", 0.3)
+		r[P_SINCE] = day
+
+## Once things break down, a household still at home decides once: the shelter,
+## or stay. Who goes: those who cannot manage alone, families with children,
+## the trusting; who stays: the careful and the well stocked.
+static func _choose(world, area: String, i: int, r: Array, day: int, shelter_room: int) -> String:
+	var w := who(world, area, i)
+	var n := living(r)
+	var lean := 30 - int(w.caution) / 3
+	match w.family:
+		"一人暮らしの高齢者": lean += 25
+		"老夫婦": lean += 15
+		"子どものいる家族": lean += 20
+	if float(r[P_FOOD]) < 3.0 * n:
+		lean += 20
+	r[P_SINCE] = day
+	if shelter_room >= n and _roll(world, area, i, day, "shelter", 100) < clampi(lean, 5, 85):
+		_go_to_shelter(world, area, r)
+		return "shelter"
+	# A few still try to get out of town while the roads are open.
+	if str(world.s.society) == "disrupted" and _roll(world, area, i, day, "flee", 100) < 4:
+		_leave_home(world, area, r, "away", 0.3)
+		return "away"
+	r[P_PATH] = "holed"
+	return "holed"
+
+static func garden(world, area: String, i: int) -> bool:
+	return area in ["北の住宅街", "南の住宅街", "住宅街"] and _h(world, area, i, "garden") % 4 == 0
+
+static func _go_to_shelter(world, area: String, r: Array) -> void:
+	var sh: Dictionary = load("res://scripts/shelter.gd").state(world)
+	sh.res_in = int(sh.get("res_in", 0)) + living(r)
+	sh.pop = int(sh.get("pop", 0)) + living(r)
+	# Two days' food goes with them, into the shelter's store.
+	var carried := minf(float(r[P_FOOD]), 2.0 * living(r))
+	sh.stock = float(sh.get("stock", 0.0)) + carried
+	r[P_FOOD] = float(r[P_FOOD]) - carried
+	_leave_home(world, area, r, "shelter", 0.0)
+
+## v149.38 stage 5: leaving home for good — out of town, or (for some) to
+## wander the town (wanderers.gd). True if they stayed to wander.
+static func _gone(world, area: String, i: int, r: Array, day: int, why: String) -> bool:
+	r[P_SINCE] = day
+	if load("res://scripts/wanderers.gd").maybe(world, area, i, r, day, why):
+		var pool := District.houses(world, area)
+		pool.food = float(pool.food) + float(r[P_FOOD])
+		r[P_FOOD] = 0.0
+		return true
+	_leave_home(world, area, r, "gone", 1.0)
+	return false
+
+## Leaving: what is not carried stays in the cupboards for whoever comes.
+static func _leave_home(world, area: String, r: Array, path: String, carry: float) -> void:
+	var pool := District.houses(world, area)
+	pool.food = float(pool.food) + float(r[P_FOOD]) * (1.0 - carry)
+	pool.water = float(pool.water) + minf(float(r[P_WATER]) * (1.0 - carry), 12.0)
+	r[P_FOOD] = 0.0
+	r[P_WATER] = 0.0
+	r[P_PATH] = path
+
+## A holed-up day: eat and drink what there is, and go out when it runs low.
+static func _holed(world, area: String, i: int, r: Array, day: int, tap: bool) -> void:
+	var n := living(r)
+	# Meals are cut as the cupboards empty: two a day, then one.
+	var ration := 1.0 if float(r[P_FOOD]) >= 10.0 * n else (0.7 if float(r[P_FOOD]) >= 4.0 * n else 0.5)
+	var need := ration * n
+	if float(r[P_FOOD]) >= need * 0.5:
+		r[P_HUNGRY] = 0
+	else:
+		r[P_HUNGRY] = int(r[P_HUNGRY]) + 1
+	r[P_FOOD] = maxf(0.0, float(r[P_FOOD]) - need)
+	# Some houses have a vegetable patch out the back: little, but it grows.
+	if garden(world, area, i):
+		r[P_FOOD] = float(r[P_FOOD]) + 0.4 * load("res://scripts/crops.gd").garden_season(world)
+	if tap:
+		r[P_DRY] = 0
+	else:
+		var drink := 2.0 * n
+		r[P_DRY] = 0 if float(r[P_WATER]) >= drink * 0.5 else int(r[P_DRY]) + 1
+		r[P_WATER] = maxf(0.0, float(r[P_WATER]) - drink)
+	var short := float(r[P_FOOD]) < 1.5 * n or (not tap and float(r[P_WATER]) < 2.0 * n)
+	if short:
+		_outing(world, area, i, r, day, tap)
+	if living(r) == 0 or not str(r[P_PATH]) == "holed":
+		return
+	# With nothing left: the shelter if it takes them; if not, those who can
+	# walk set out for somewhere that still has food. The rest wait.
+	var Shelter = load("res://scripts/shelter.gd")
+	if float(r[P_FOOD]) < 0.5 * n and int(r[P_HUNGRY]) >= 2:
+		# Some stop asking and start taking (gangs.gd).
+		if load("res://scripts/gangs.gd").recruit(world, area, i, r, day):
+			return
+	if float(r[P_FOOD]) < 0.5 * n and int(r[P_HUNGRY]) >= 3:
+		if Shelter.is_open(world):
+			var sh: Dictionary = Shelter.state(world)
+			if int(sh.pop) + int(sh.get("res_in", 0)) + n <= Shelter.capacity(world):
+				_go_to_shelter(world, area, r)
+				r[P_SINCE] = day
+				return
+		var w := who(world, area, i)
+		var can_walk := false
+		for k in w.people.size():
+			if int(r[P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+				can_walk = true
+		if can_walk and int(r[P_HUNGRY]) >= 5 and _roll(world, area, i, day, "set-out", 100) < 15 + int(w.courage) / 4:
+			if _gone(world, area, i, r, day, "robbed" if int(r[P_FLAGS]) & F_ROBBED else "hunger"):
+				return
+			_news(world, "left", area, "%sの%sさん一家が、荷物をまとめて町を出ていったらしい。" % [_where(area, i), w.surname])
+
+## Someone goes out for food or water. Who: the most able. Where: the empty
+## homes nearby first, then whatever shop still has something.
+static func _outing(world, area: String, i: int, r: Array, day: int, tap: bool) -> void:
+	var w := who(world, area, i)
+	var goer := -1
+	for k in w.people.size():
+		if int(r[P_ALIVE]) & (1 << k) and bool(w.people[k].able) and not int(r[P_BITTEN]) & (1 << k):
+			goer = k
+			break
+	if goer < 0:
+		# Old people alone go themselves, when they must.
+		for k in w.people.size():
+			if int(r[P_ALIVE]) & (1 << k) and str(w.people[k].band) == "senior":
+				goer = k
+				break
+	if goer < 0:
+		return
+	var place := area
+	var got := District.search_houses(world, 6.0, 8.0, area)
+	if got.x < 1.0:
+		var sites: Array = []
+		for p in ["スーパー", "コンビニ", "食品店", "倉庫街", "ホームセンター", "ガソリンスタンド"]:
+			if world.s.district.sites.has(p) and float(world.s.district.sites[p].food) >= 1.0:
+				sites.append(p)
+		if not sites.is_empty():
+			place = sites[_roll(world, area, i, day, "where", sites.size())]
+			var site: Dictionary = world.s.district.sites[place]
+			var food := minf(float(site.food), 6.0)
+			var water := minf(float(site.water), 6.0)
+			if not bool(site.get("vacant", false)):
+				food = minf(food, 2.0)   # bought, at the queue's ration
+			site.food = float(site.food) - food
+			site.water = float(site.water) - water
+			got += Vector2(food, water)
+	if got.x < 1.0:
+		# Nothing left in town: across the bridge to the next town, a long and
+		# dangerous day. What is there runs out too, as everyone goes.
+		var st: Dictionary = world.s.residents
+		var beyond := float(st.get("beyond", BEYOND))
+		var food := minf(beyond, roundf(8.0 * sqrt(beyond / BEYOND)))
+		st.beyond = beyond - food
+		got.x += food
+		place = "橋"
+	if not tap and float(r[P_WATER]) < 2.0 * living(r) and got.y < 2.0:
+		# The river or the park pond, then.
+		for p in TownMap.PLACES:
+			if bool(TownMap.PLACES[p].get("water_source", false)):
+				got.y += 8.0
+				if place == area:
+					place = p
+				break
+	r[P_FOOD] = float(r[P_FOOD]) + got.x
+	r[P_WATER] = float(r[P_WATER]) + got.y
+	var from := 8 + _roll(world, area, i, day, "hour", 8)
+	var out: Array = world.s.residents.out
+	if out.size() < 120:
+		out.append([area, place, from, from + 1 + _roll(world, area, i, day, "long", 2)])
+	# The streets decide whether they come back, and how.
+	var walkers := Walkers.count(world, place) if world.s.has("walkers") else 0
+	if place == "橋":
+		walkers += 10   # the next town's streets, and the walk there and back
+	var risk := clampf(0.003 + 0.004 * float(walkers), 0.0, 0.25) * (1.3 - float(w.courage) / 100.0)
+	var roll := float(_roll(world, area, i, day, "risk", 10000)) / 10000.0
+	if roll < risk * 0.35:
+		r[P_ALIVE] = int(r[P_ALIVE]) & ~(1 << goer)
+		if living(r) == 0:
+			r[P_PATH] = "dead"
+			r[P_SINCE] = day
+		_news(world, "death", area, "%sの%sさんの家の人が、%sへ出かけたまま戻らなかったらしい。" % [_where(area, i), w.surname, place])
+	elif roll < risk:
+		r[P_BITTEN] = int(r[P_BITTEN]) | (1 << goer)
+
+## A bite hidden from the family: by morning they have turned, and those
+## nearest are bitten in turn. The rest run, if they can.
+static func _turn(world, area: String, i: int, r: Array, day: int) -> void:
+	var bitten := int(r[P_BITTEN])
+	if bitten == 0:
+		return
+	r[P_BITTEN] = 0
+	var turned_now := bitten & int(r[P_ALIVE])
+	if turned_now == 0:
+		return
+	r[P_ALIVE] = int(r[P_ALIVE]) & ~turned_now
+	r[P_TURNED] = int(r[P_TURNED]) | turned_now
+	var path := str(r[P_PATH])
+	if path == "shelter":
+		# The shelter's own watch deals with it (counted as a hidden bite there).
+		var sh: Dictionary = load("res://scripts/shelter.gd").state(world)
+		sh.sick = int(sh.get("sick", 0)) + _count(turned_now)
+		if living(r) == 0:
+			r[P_PATH] = "dead"
+			r[P_SINCE] = day
+		return
+	var w := who(world, area, i)
+	# Living with others: the night watch may stop it before it spreads.
+	if int(r[P_FLAGS]) & 256 != 0 and load("res://scripts/communities.gd").caught_in_time(world, area, i, day):
+		r[P_TURNED] = int(r[P_TURNED]) & ~turned_now
+		if living(r) == 0:
+			r[P_PATH] = "dead"
+			r[P_SINCE] = day
+		_news(world, "death", area, "%sで、発症しかけた人を見張りが止めたらしい。" % load("res://scripts/communities.gd").block_name(area, load("res://scripts/communities.gd").block_of(area, i)))
+		return
+	for k in w.people.size():
+		if int(r[P_ALIVE]) & (1 << k) and _roll(world, area, i, day, "caught%d" % k, 100) < 40:
+			r[P_ALIVE] = int(r[P_ALIVE]) & ~(1 << k)
+			r[P_TURNED] = int(r[P_TURNED]) | (1 << k)
+	r[P_FLAGS] = int(r[P_FLAGS]) | F_INSIDE
+	r[P_SINCE] = day
+	if living(r) > 0:
+		# The living run from what their family has become.
+		_gone(world, area, i, r, day, "turned")
+		_news(world, "turned", area, "%sの%sさんの家で、家族が感染者になったらしい。残りの人は逃げ出したそうだ。" % [_where(area, i), w.surname])
+	else:
+		r[P_PATH] = "turned"
+		_news(world, "turned", area, "%sの%sさんの家から、夜通し物音がしていたらしい。誰も出てこない。" % [_where(area, i), w.surname])
+
+## Hunger, thirst and illness: the weakest first.
+static func _deaths(world, area: String, i: int, r: Array, day: int, society: String) -> void:
+	if not str(r[P_PATH]) in ["home", "holed"]:
+		return
+	var w := who(world, area, i)
+	var order: Array = []
+	for band in ["senior", "child", "young", "adult"]:
+		for k in w.people.size():
+			if str(w.people[k].band) == band and int(r[P_ALIVE]) & (1 << k):
+				order.append(k)
+	if order.is_empty():
+		return
+	var cause := ""
+	if int(r[P_DRY]) >= 3:
+		cause = "dry"
+	elif int(r[P_HUNGRY]) >= 9 and (int(r[P_HUNGRY]) - 9) % 2 == 0:
+		cause = "hunger"
+	elif society == "emergency" and str(w.people[order[0]].band) == "senior" and _roll(world, area, i, day, "ill", 1000) < 4:
+		cause = "ill"
+	if cause.is_empty():
+		return
+	r[P_ALIVE] = int(r[P_ALIVE]) & ~(1 << int(order[0]))
+	if living(r) == 0:
+		r[P_PATH] = "dead"
+		r[P_FLAGS] = int(r[P_FLAGS]) | F_DIED_HOME
+		r[P_SINCE] = day
+		_news(world, "death", area, "%sの%sさんの家は、もうずっと静かなままらしい。" % [_where(area, i), w.surname])
+
+## The turned shut in a home: one day a door or a window gives.
+static func _shut_in(world, area: String, i: int, r: Array) -> void:
+	if int(r[P_FLAGS]) & F_INSIDE == 0 or int(r[P_TURNED]) == 0:
+		return
+	if _roll(world, area, i, _day(world), "breakout", 100) < 8:
+		r[P_FLAGS] = int(r[P_FLAGS]) & ~F_INSIDE
+		if world.s.has("walkers"):
+			Walkers._add(world, area, _count(int(r[P_TURNED])))
+
+## v149.38 stage 2: the shelter's people who are the town's own.
+static func in_shelter(world) -> int:
+	var n := 0
+	if not ready(world):
+		return 0
+	for area in world.s.residents.hh:
+		for r in world.s.residents.hh[area]:
+			if str(r[P_PATH]) == "shelter":
+				n += living(r)
+	return n
+
+static func _shelter_rows(world) -> Array:
+	var out: Array = []
+	if not ready(world):
+		return out
+	for area in world.s.residents.hh:
+		var rows: Array = world.s.residents.hh[area]
+		for i in rows.size():
+			if str(rows[i][P_PATH]) == "shelter" and living(rows[i]) > 0:
+				out.append([area, i])
+	return out
+
+## When food runs short (or it gets too crowded), some go home to try their
+## luck: each household decides for itself.
+static func leave_shelter(world, percent: int) -> int:
+	var gone := 0
+	var day := _day(world)
+	for at in _shelter_rows(world):
+		var r := row(world, str(at[0]), int(at[1]))
+		if _roll(world, str(at[0]), int(at[1]), day, "leave-shelter", 100) < percent:
+			gone += living(r)
+			r[P_PATH] = "holed"
+			r[P_SINCE] = day
+	return gone
+
+## Those bitten in the night and taken out of the gym: how many of them were
+## the town's own (the rest came from elsewhere). Returns the count.
+static func shelter_casualties(world, n: int, outsiders: int, salt: int) -> int:
+	var rows := _shelter_rows(world)
+	var ours := 0
+	var day := _day(world)
+	for k in n:
+		var pool := in_shelter(world)
+		if pool <= 0 or rows.is_empty():
+			break
+		if absi(hash([int(world.s.seed), day, salt, k, "who"])) % (pool + maxi(0, outsiders)) >= pool:
+			continue
+		var at: Array = rows[absi(hash([int(world.s.seed), day, salt, k, "row"])) % rows.size()]
+		var r := row(world, str(at[0]), int(at[1]))
+		var w := who(world, str(at[0]), int(at[1]))
+		for b in w.people.size():
+			if int(r[P_ALIVE]) & (1 << b):
+				r[P_ALIVE] = int(r[P_ALIVE]) & ~(1 << b)
+				ours += 1
+				break
+		if living(r) == 0:
+			r[P_PATH] = "dead"
+			r[P_SINCE] = day
+			rows.erase(at)
+	return ours
+
+## Faces in the gym: a few households by name, and anyone the player helped.
+static func shelter_faces(world) -> String:
+	var rows := _shelter_rows(world)
+	if rows.is_empty():
+		return ""
+	var day := _day(world)
+	var names: Array = []
+	var friend := ""
+	for k in rows.size():
+		var at: Array = rows[k]
+		var r := row(world, str(at[0]), int(at[1]))
+		var w := who(world, str(at[0]), int(at[1]))
+		if int(r[P_FLAGS]) & F_FRIEND and friend.is_empty():
+			friend = "前にドア越しに食料を分けた%sさんが、こちらに気づいて深く頭を下げた。" % w.surname
+		elif names.size() < 2 and absi(hash([int(world.s.seed), day, k, "face"])) % maxi(1, rows.size() / 3) == 0:
+			var n := living(r)
+			names.append("%sの%sさん%s" % [str(at[0]), w.surname, "一家" if n >= 3 else ("夫婦" if str(w.family) in ["老夫婦", "共働きの夫婦"] and n == 2 else "")])
+	var line := ""
+	if not names.is_empty():
+		line = "近所の人たちの顔もある。%sも、ここに来ていた。" % "、".join(names)
+	return line + friend
+
+## Notes on the board from the town's families.
+static func board_notes(world) -> Array:
+	var out: Array = []
+	var rows := _shelter_rows(world)
+	for k in mini(3, rows.size()):
+		var at: Array = rows[(k * 7) % rows.size()]
+		var w := who(world, str(at[0]), int(at[1]))
+		out.append("「%s（%s）の%sです。家族は体育館にいます」" % [str(at[0]), load("res://scripts/dwellings.gd").address(str(at[0]), int(at[1])), w.surname])
+	return out
+
+## The shelter fell: most of those inside with it.
+static func shelter_fell(world) -> void:
+	if not ready(world):
+		return
+	var day := _day(world)
+	for area in world.s.residents.hh:
+		var rows: Array = world.s.residents.hh[area]
+		for i in rows.size():
+			var r: Array = rows[i]
+			if str(r[P_PATH]) != "shelter":
+				continue
+			var w := who(world, area, i)
+			for k in w.people.size():
+				if int(r[P_ALIVE]) & (1 << k) and _roll(world, area, i, day, "fall%d" % k, 100) < 55:
+					r[P_ALIVE] = int(r[P_ALIVE]) & ~(1 << k)
+			r[P_SINCE] = day
+			r[P_PATH] = "holed" if living(r) > 0 else "dead"
+
+## The shelter emptied: everyone goes home.
+static func shelter_left(world) -> void:
+	if not ready(world):
+		return
+	for area in world.s.residents.hh:
+		for r in world.s.residents.hh[area]:
+			if str(r[P_PATH]) == "shelter":
+				r[P_PATH] = "holed"
+				r[P_SINCE] = _day(world)
+
+static func _where(area: String, i: int) -> String:
+	return "%s（%s）" % [area, load("res://scripts/dwellings.gd").address(area, i)]
+
+## What happens to households becomes talk, but only so much a day reaches
+## anyone (the rest is the town going quiet).
+static func _news(world, kind: String, place: String, text: String) -> void:
+	if not world.s.get("survivors") is Dictionary or not ready(world):
+		return
+	var st: Dictionary = world.s.residents
+	var today := _day(world)
+	if int(st.get("news_day", -1)) != today:
+		st.news_day = today
+		st.news_n = 0
+		st.news_today = []
+	st.news_n = int(st.get("news_n", 0)) + 1
+	var seen: Array = st.get("news_today", []) if int(st.get("news_day", -1)) == today else []
+	if text in seen:
+		return
+	seen.append(text)
+	st.news_today = seen.slice(maxi(0, seen.size() - 30))
+	if int(st.news_n) <= 3 or kind in ["robbery", "kindness", "raid", "gang", "gang_end", "group_found", "group_end"]:
+		load("res://scripts/town_news.gd").record(world, kind, place, text)
