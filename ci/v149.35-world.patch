+extends SceneTree
+## v149.35: cards with the people at home — ババ抜き, 大富豪, 七並べ, 神経衰弱:
+## the rules, personalities at the table, whole games played through the
+## table, and what they leave behind.
+const Main = preload("res://main.tscn")
+const Cards = preload("res://scripts/cards.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func prof(style: String, extra: Dictionary = {}) -> Dictionary:
+	var p := {"style": style, "skill": 0.9, "honest": 50, "temper": 50, "kind": 60, "polite": false, "child": style == "child", "memory": 0.7, "mean": false}
+	p.merge(extra, true)
+	return p
+func run() -> void:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = 7
+	var B = load("res://scripts/cards_babanuki.gd")
+	var D = load("res://scripts/cards_daifugo.gd")
+	var S = load("res://scripts/cards_shichinarabe.gd")
+	var K = load("res://scripts/cards_shinkei.gd")
+	# ババ抜き: pairs go, the joker stays, tells by character.
+	var b: Dictionary = B.start(3, rng)
+	var all_cards := 0
+	var no_pairs := true
+	for h in b.hands:
+		all_cards += h.size()
+		var seen := {}
+		for c in h:
+			if not Cards.joker(c):
+				no_pairs = no_pairs and not seen.has(Cards.rank(c))
+				seen[Cards.rank(c)] = true
+	check(no_pairs and all_cards % 2 == 1, "babanuki: pairs thrown out at the deal, the joker left odd")
+	var holder := -1
+	for i in 3:
+		if B.holds_joker(b, i):
+			holder = i
+	b.hands[1] = ["X1", "S3", "H9"]
+	var honest_tell: Dictionary = B.tell(b, 1, prof("steady", {"honest": 90}), "A", rng)
+	var kid_tell: Dictionary = B.tell(b, 1, prof("child"), "B", rng)
+	check(int(kid_tell.pos) == 0 and str(kid_tell.text).contains("飛び出"), "a child's joker sticks out of their hand")
+	var sly_wrong := 0
+	for t in 30:
+		var tl: Dictionary = B.tell(b, 1, prof("steady", {"honest": 10}), "C", rng)
+		if int(tl.pos) > 0:
+			sly_wrong += 1
+	check(sly_wrong > 5, "a sly one looks at the wrong card (%d/30)" % sly_wrong)
+	# 大富豪: order, sets, 8切り, 革命.
+	var d: Dictionary = D.start(3, rng)
+	d.hands = [["S3", "H3", "C8", "D5"], ["S4", "H4", "SK"], ["SA", "HA", "S2", "D2", "C2", "H2"]]
+	d.turn = 0
+	d.pile = []
+	check(D.can_play(d, ["S3", "H3"]) and not D.can_play(d, ["S3", "D5"]), "daifugo: one rank at a time")
+	D.play(d, 0, ["S3", "H3"])
+	check(int(d.turn) == 1 and D.can_play(d, ["S4", "H4"]) and not D.can_play(d, ["SK"]), "the next must match the count, stronger")
+	D.play(d, 1, ["S4", "H4"])
+	D.pass_turn(d, 2)
+	D.pass_turn(d, 0)
+	check(d.pile.is_empty() and int(d.turn) == 1, "when all others pass, the last to play leads")
+	d.turn = 0
+	D.play(d, 0, ["C8"])
+	check(d.pile.is_empty() and int(d.turn) == 0, "an 8 clears the pile (8切り)")
+	d.turn = 2
+	D.play(d, 2, ["S2", "D2", "C2", "H2"])
+	check(bool(d.rev) and D.strength("S3", true) > D.strength("SA", true), "four of a kind: revolution")
+	# 七並べ.
+	var s7: Dictionary = S.start(3, rng)
+	check(s7.table.values().all(func(r): return 7 in r) and s7.hands.all(func(h): return not h.any(func(c): return Cards.rank(c) == "7")), "shichinarabe: the 7s go down first")
+	check(S.playable(s7, "H6") and S.playable(s7, "H8") and not S.playable(s7, "H5"), "next to the row only")
+	# Mean vs kind with the same choice: a 6 that opens nothing for themselves.
+	var s2: Dictionary = S.start(2, rng)
+	s2.hands = [["C2"], ["H6", "C3", "D9", "S10", "S11"]]
+	s2.hands[1] = ["H6", "C3"]
+	s2.turn = 1
+	s2.passes = [0, 0]
+	var r2 := RandomNumberGenerator.new()
+	r2.seed = 2
+	var blocks := 0
+	for t in 20:
+		var trial := s2.duplicate(true)
+		S.ai(trial, 1, [{}, prof("careful", {"mean": true, "kind": 20})], r2)
+		if bool(trial.last.pass):
+			blocks += 1
+	var opens := 0
+	for t in 20:
+		var trial := s2.duplicate(true)
+		S.ai(trial, 1, [{}, prof("gentle", {"kind": 90})], r2)
+		if not bool(trial.last.pass):
+			opens += 1
+	check(blocks >= 10 and opens == 20, "the mean sit on it (%d/20), the kind open the way (%d/20)" % [blocks, opens])
+	# 神経衰弱: memory by age.
+	var w0 := {"s": {}}
+	var kid := Cards.profile(null if false else _fake_world(), {"name": "結人", "age": 8, "job": "小学生"})
+	var old := Cards.profile(_fake_world(), {"name": "トメ", "age": 78, "job": "無職"})
+	check(float(kid.memory) > float(old.memory) + 0.3, "children remember best at 神経衰弱 (%.2f vs %.2f)" % [kid.memory, old.memory])
+	var k4: Dictionary = K.start(2, rng)
+	k4.memory[1] = {}
+	var a := -1
+	var bb := -1
+	for i in k4.grid.size():
+		for j in range(i + 1, k4.grid.size()):
+			if Cards.rank(k4.grid[i]) == Cards.rank(k4.grid[j]) and a < 0:
+				a = i
+				bb = j
+	k4.memory[1][a] = Cards.rank(k4.grid[a])
+	k4.memory[1][bb] = Cards.rank(k4.grid[bb])
+	k4.turn = 1
+	K.ai_flip(k4, 1, [{}, prof("steady")], rng)
+	K.ai_flip(k4, 1, [{}, prof("steady")], rng)
+	check(int(k4.score[1]) == 1 and int(k4.owner[a]) == 1, "a remembered pair is taken")
+	# At the table: whole games of each through the screen.
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	p.cohabitants = 2
+	p.companion_names = ["詩音", "蒼"]
+	p.companion_genders = ["女性", "男性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	g.location = "居間"
+	g._sync_player_position()
+	for m in w.s.household_members:
+		m.location = "居間"
+		m.activity = "在宅"
+	var minute := int(w.s.minute)
+	await g._on_command("トランプをする")
+	var table = g.cards_layer
+	check(table != null and table.state.is_empty() and table.buttons.get_child_count() == 4, "the cards come out, with a choice of four games")
+	table.delay = 0.0
+	for kind in ["babanuki", "daifugo", "shichinarabe", "shinkei"]:
+		table.begin(kind)
+		var guard := 0
+		while not bool(table.state.done) and guard < 400:
+			guard += 1
+			if int(table.state.turn) != 0 or table.running:
+				await process_frame
+				continue
+			match kind:
+				"babanuki":
+					table.draw_card(0)
+				"daifugo":
+					var o: Array = D.options(table.state, 0)
+					if o.is_empty():
+						table.pass_turn()
+					else:
+						table.selected = o[0]
+						table.play_selected()
+				"shichinarabe":
+					var o: Array = S.options(table.state, 0)
+					if o.is_empty():
+						table.pass_turn()
+					else:
+						table.lay(str(o[0]))
+				"shinkei":
+					var open: Array = K.open_cells(table.state).filter(func(c): return c != int(table.state.first))
+					table.flip(int(open[0]))
+			await process_frame
+		check(bool(table.state.done) and table.state.ranking.size() == 3, "%s played to the end with everyone (%d steps)" % [kind, guard])
+	check(int(w.s.minute) == minute, "time stands still at the table")
+	var before: float = float(w.s.household_members[0].get("mood", 50.0))
+	table._leave()
+	await process_frame
+	var line: String = str(g.log_entries[-1])
+	check(line.begins_with("詩音・蒼とトランプをした（95分）") and line.contains("ババ抜き") and line.contains("大富豪"), "it goes in the chronicle: " + line.left(120))
+	check(int(w.s.minute) - minute >= 95 and float(w.s.household_members[0].mood) > before, "time passes and they enjoyed it")
+	check(load("res://scripts/action_photos.gd").detect(line).get("kind", "") == "cards", "with its picture")
+	for m in w.s.household_members:
+		m.location = "居間"
+		m.activity = "在宅"
+	g.location = "居間"
+	await g._on_command("蒼と神経衰弱をする")
+	table = g.cards_layer
+	check(table.kind == "shinkei" and table.names == ["あなた", "蒼"], "named game, named player")
+	table._leave()
+	await process_frame
+	g.queue_free()
+	print("RESULT %s" % ("PASS" if failures == 0 else "FAIL"))
+	quit(1 if failures else 0)
+
+func _fake_world():
+	return FakeWorld.new()
+
+class FakeWorld:
+	var s := {}
