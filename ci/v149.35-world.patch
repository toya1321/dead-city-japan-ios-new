@@ -0,0 +1,321 @@
+extends RefCounted
+## v149.38 stage 4: looters. Nobody is born one. A household holed up alone,
+## out of food, with someone able-bodied and not much given to kindness — or
+## one that was itself robbed — may stop asking and start taking. They find
+## others like them and set up somewhere defensible (the warehouses, the home
+## centre, the petrol station, the police box), and live off what they take:
+## lone households first (the ones that have food and nobody to fight), then
+## the neighbourhoods behind barricades when they are strong enough, and the
+## player's home when a light shows at night (raiders.gd answers at the door).
+## Every raid can cost them too; hunger breaks them up; success draws more.
+##
+## s.residents.gangs = {id: {lair, since, store, hungry, ended, last_raid,
+##   leader: [area, i], homes: [[area, i], ...]}}   household path "looter"
+
+const Residents = preload("res://scripts/residents.gd")
+const Communities = preload("res://scripts/communities.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const LAIRS := ["倉庫街", "ホームセンター", "ガソリンスタンド", "交番"]
+const MAX_SIZE := 24
+
+static func all(world) -> Dictionary:
+	if not Residents.ready(world):
+		return {}
+	if not world.s.residents.get("gangs") is Dictionary:
+		world.s.residents.gangs = {}
+	return world.s.residents.gangs
+
+static func _peek(world) -> Dictionary:
+	var st = world.s.get("residents")
+	return st.get("gangs", {}) if st is Dictionary and st.get("gangs") is Dictionary else {}
+
+static func active(world) -> Array:
+	return _peek(world).values().filter(func(g): return not bool(g.ended))
+
+static func people(world, g: Dictionary) -> int:
+	var n := 0
+	for h in g.homes:
+		var r := Residents.row(world, str(h[0]), int(h[1]))
+		if str(r[Residents.P_PATH]) == "looter":
+			n += Residents.living(r)
+	return n
+
+static func fighters(world, g: Dictionary) -> int:
+	var n := 0
+	for h in g.homes:
+		var r := Residents.row(world, str(h[0]), int(h[1]))
+		if str(r[Residents.P_PATH]) != "looter":
+			continue
+		var w := Residents.who(world, str(h[0]), int(h[1]))
+		for k in w.people.size():
+			if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+				n += 1
+	return n
+
+static func at(world, place: String) -> Dictionary:
+	for g in active(world):
+		if str(g.lair) == place:
+			return g
+	return {}
+
+## A desperate household turns to taking: called by residents.gd when one is
+## about to give up. True if they did.
+static func recruit(world, area: String, i: int, r: Array, day: int) -> bool:
+	if str(world.s.get("society", "normal")) != "emergency":
+		return false
+	var w := Residents.who(world, area, i)
+	var able := false
+	for k in w.people.size():
+		if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+			able = true
+	if not able:
+		return false
+	var wronged := int(r[Residents.P_FLAGS]) & (Residents.F_ROBBED | Residents.F_HOSTILE) != 0
+	var hard := int(w.kindness) < 35 or (wronged and int(w.kindness) < 60)
+	if not hard or Residents._roll(world, area, i, day, "turn-looter", 100) >= 25 + int(w.courage) / 4:
+		return false
+	var gangs := all(world)
+	var join: Dictionary = {}
+	for g in active(world):
+		if people(world, g) + Residents.living(r) <= MAX_SIZE and (join.is_empty() or people(world, g) > people(world, join)):
+			join = g
+	if join.is_empty() or (people(world, join) >= 10 and Residents._roll(world, area, i, day, "own-gang", 100) < 30):
+		var taken: Array = active(world).map(func(g): return str(g.lair))
+		var free: Array = LAIRS.filter(func(p): return not p in taken)
+		if free.is_empty():
+			if join.is_empty():
+				return false
+		else:
+			var id := "gang_%d_%s_%d" % [day, area, i]
+			join = {"id": id, "lair": free[Residents._roll(world, area, i, day, "lair", free.size())], "since": day,
+				"store": 0.0, "hungry": 0, "ended": false, "last_raid": -1, "leader": [area, i], "homes": []}
+			gangs[id] = join
+			Residents._news(world, "gang", str(join.lair), "%sに、物騒な連中が住みついたらしい。夜になると、焚き火のまわりに男たちが集まっているという。" % join.lair)
+	join.homes.append([area, i])
+	join.store = float(join.store) + float(r[Residents.P_FOOD])
+	r[Residents.P_FOOD] = 0.0
+	r[Residents.P_PATH] = "looter"
+	r[Residents.P_SINCE] = day
+	if int(r[Residents.P_FLAGS]) & Communities.F_COMM:
+		r[Residents.P_FLAGS] = int(r[Residents.P_FLAGS]) & ~Communities.F_COMM
+	return true
+
+# ------------------------------------------------------------------ each day
+
+static func daily(world, day: int) -> void:
+	for g in active(world):
+		var n := people(world, g)
+		if n == 0:
+			_end(world, g, day, "gone")
+			continue
+		# A raid when the store runs low.
+		if float(g.store) < 6.0 * n and int(g.last_raid) < day:
+			_raid(world, g, day)
+		n = people(world, g)
+		if n == 0:
+			_end(world, g, day, "gone")
+			continue
+		var need := 0.8 * float(n)
+		g.hungry = 0 if float(g.store) >= need * 0.6 else int(g.hungry) + 1
+		g.store = maxf(0.0, float(g.store) - need)
+		if int(g.hungry) >= 5:
+			_end(world, g, day, "hunger")
+
+## Who to hit: what they have against what it will cost.
+static func _raid(world, g: Dictionary, day: int) -> void:
+	g.last_raid = day
+	var power := fighters(world, g)
+	if power == 0:
+		return
+	var salt := absi(hash([int(world.s.seed), str(g.id), day]))
+	# A neighbourhood behind a barricade: worth it only in numbers.
+	var best: Dictionary = {}
+	for key in Communities.all(world):
+		var c: Dictionary = Communities.all(world)[key]
+		if bool(c.ended) or float(c.store) < 15.0:
+			continue
+		if best.is_empty() or float(c.store) > float(best.store):
+			best = c
+	var desperate := int(g.hungry) >= 2
+	if not best.is_empty() and (float(power) * 2.0 > _defense(world, best) * 0.8 or desperate) and salt % 100 < (70 if desperate else 40):
+		_hit_community(world, g, best, day, salt)
+		return
+	# A lone household that still has food and nobody much to fight.
+	var target: Array = []
+	var most := 2.0
+	var tries := 0
+	while tries < 40:
+		tries += 1
+		var areas: Array = Residents.areas()
+		var area: String = areas[(salt + tries * 7) % areas.size()]
+		var rows: Array = world.s.residents.hh[area]
+		var i := (salt / 13 + tries * 31) % rows.size()
+		var r: Array = rows[i]
+		if str(r[Residents.P_PATH]) == "holed" and not Communities.member(r) and float(r[Residents.P_FOOD]) > most:
+			most = float(r[Residents.P_FOOD])
+			target = [area, i]
+	if not target.is_empty():
+		_hit_home(world, g, str(target[0]), int(target[1]), day, salt)
+	elif not best.is_empty():
+		# Nobody alone has anything left: the barricades, then.
+		_hit_community(world, g, best, day, salt)
+
+static func _defense(world, c: Dictionary) -> float:
+	var able := 0
+	for i in Communities.members(world, c):
+		var r := Residents.row(world, str(c.area), i)
+		var w := Residents.who(world, str(c.area), i)
+		for k in w.people.size():
+			if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+				able += 1
+	return float(c.wall) / 10.0 + float(able) * 1.5
+
+static func _hit_home(world, g: Dictionary, area: String, i: int, day: int, salt: int) -> void:
+	var r := Residents.row(world, area, i)
+	var w := Residents.who(world, area, i)
+	_seen(world, area, salt)
+	var fighter := -1
+	for k in w.people.size():
+		if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able) and int(w.courage) >= 55:
+			fighter = k
+	if fighter >= 0 and (salt / 7) % 100 < 35:
+		# Driven off at the door; it costs one of them.
+		if (salt / 11) % 100 < 40:
+			_lose(world, g, day, salt)
+		Residents._news(world, "raid", area, "%sの%sさんの家に略奪者が押し入ろうとして、追い返されたらしい。" % [Residents._where(area, i), w.surname])
+		return
+	var take := float(r[Residents.P_FOOD])
+	r[Residents.P_FOOD] = 0.0
+	g.store = float(g.store) + take
+	r[Residents.P_FLAGS] = int(r[Residents.P_FLAGS]) | Residents.F_ROBBED
+	if fighter >= 0 and (salt / 17) % 100 < 30:
+		r[Residents.P_ALIVE] = int(r[Residents.P_ALIVE]) & ~(1 << fighter)
+		if Residents.living(r) == 0:
+			r[Residents.P_PATH] = "dead"
+			r[Residents.P_FLAGS] = int(r[Residents.P_FLAGS]) | Residents.F_DIED_HOME
+		Residents._news(world, "raid", area, "%sの%sさんの家が略奪者に襲われ、抵抗した人が殺されたらしい。" % [Residents._where(area, i), w.surname])
+	else:
+		Residents._news(world, "raid", area, "%sの%sさんの家が略奪者に襲われ、食べ物を根こそぎ持っていかれたらしい。" % [Residents._where(area, i), w.surname])
+
+static func _hit_community(world, g: Dictionary, c: Dictionary, day: int, salt: int) -> void:
+	var area := str(c.area)
+	_seen(world, area, salt)
+	var attack := float(fighters(world, g)) * 2.0 * (0.6 + float(salt % 80) / 100.0)
+	var name: String = Communities.block_name(area, int(c.block))
+	if attack > _defense(world, c):
+		var take := float(c.store) * 0.6
+		c.store = float(c.store) - take
+		g.store = float(g.store) + take
+		c.wall = maxf(0.0, float(c.wall) - 25.0)
+		var mem: Array = Communities.members(world, c)
+		if not mem.is_empty() and (salt / 3) % 100 < 50:
+			var i: int = mem[(salt / 5) % mem.size()]
+			var r := Residents.row(world, area, i)
+			var w := Residents.who(world, area, i)
+			for k in w.people.size():
+				if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+					r[Residents.P_ALIVE] = int(r[Residents.P_ALIVE]) & ~(1 << k)
+					break
+		Residents._news(world, "raid", area, "%sのバリケードが略奪者に破られ、蓄えの多くを奪われたらしい。" % name)
+	else:
+		_lose(world, g, day, salt)
+		c.wall = maxf(0.0, float(c.wall) - 8.0)
+		Residents._news(world, "raid", area, "%sに略奪者が押し寄せたが、住人たちが追い返したらしい。" % name)
+
+## One of them does not come back.
+static func _lose(world, g: Dictionary, day: int, salt: int) -> void:
+	for h in g.homes:
+		var r := Residents.row(world, str(h[0]), int(h[1]))
+		if str(r[Residents.P_PATH]) != "looter":
+			continue
+		var w := Residents.who(world, str(h[0]), int(h[1]))
+		for k in w.people.size():
+			if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+				r[Residents.P_ALIVE] = int(r[Residents.P_ALIVE]) & ~(1 << k)
+				if Residents.living(r) == 0:
+					r[Residents.P_PATH] = "dead"
+				return
+
+## They are seen going about it.
+static func _seen(world, area: String, salt: int) -> void:
+	var raided: Dictionary = world.s.residents.get("raided", {})
+	raided[area] = Residents._day(world)
+	world.s.residents.raided = raided
+	var out: Array = world.s.residents.get("gang_out", [])
+	var from := 18 + salt % 5
+	out.append([area, from, from + 2])
+	world.s.residents.gang_out = out.slice(maxi(0, out.size() - 20))
+
+static func _end(world, g: Dictionary, day: int, why: String) -> void:
+	g.ended = true
+	g.ended_day = day
+	for h in g.homes:
+		var r := Residents.row(world, str(h[0]), int(h[1]))
+		if str(r[Residents.P_PATH]) == "looter":
+			if Residents.living(r) > 0:
+				Residents._gone(world, str(h[0]), int(h[1]), r, day, "gang")
+			else:
+				r[Residents.P_PATH] = "dead"
+			r[Residents.P_SINCE] = day
+	Residents._news(world, "gang_end", str(g.lair), "%sにいた連中は、%s" % [g.lair, "食べる物にも困って、町を出ていったらしい。" if why == "hunger" else "もういないらしい。"])
+
+# ------------------------------------------------------------------ the player
+
+## The player's home, when a light shows at night: the strongest of them
