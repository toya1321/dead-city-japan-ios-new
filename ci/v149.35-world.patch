+	check(bool(pb.treated) and float(Trade.goods(w, a).bandage) == 0.0, "a wound is bandaged with a real bandage")
+	# Theft at night, by the desperate and dishonest, is remembered.
+	w.s.minute += 1440
+	w.s.minute = (int(w.s.minute) / 1440) * 1440 + 15 * 60   # 23:00
+	pa.traits.honesty = 10
+	Trade.goods(w, a).food = 0.0
+	Trade.goods(w, b).food = 5.0
+	var stolen := false
+	for i in 12:
+		w.s.minute += 1441
+		NpcBonds.together(w, a, b, func(t, who): pass)
+		if float(Trade.goods(w, a).food) > 0.0:
+			stolen = true
+			break
+	check(stolen and float(Trade.goods(w, a).food) + float(Trade.goods(w, b).food) == 5.0, "the desperate may steal in the night (nothing made or lost)")
+	# What a trusted friend says of the player changes minds.
+	pa.met = true
+	pa.trust = 90
+	pb.trust = 20
+	pb.acq[a].trust = 80
+	pb.acq[a].act_at = -100000
+	pa.acq[b].act_at = -100000
+	w.s.minute += 1440
+	NpcBonds.together(w, a, b, func(t, who): pass)
+	check(int(pb.trust) > 20 and bool(pb.get("heard_of_player", false)), "a friend's good word about the player travels")
+
+	# Stage 3: those who trust one another settle together.
+	var NpcGroups = load("res://scripts/npc_groups.gd")
+	w.s.district.sites["近所の空き家"].vacant = true
+	pa.place = "近所の空き家"
+	pb.place = "近所の空き家"
+	pa.status = "alive"
+	pb.status = "alive"
+	pa.erase("group")
+	pb.erase("group")
+	NpcBonds.bond(people, a, b, int(w.s.minute)).trust = 60
+	NpcBonds.bond(people, a, b, int(w.s.minute)).like = 40
+	NpcBonds.bond(people, b, a, int(w.s.minute)).trust = 60
+	NpcBonds.bond(people, b, a, int(w.s.minute)).like = 40
