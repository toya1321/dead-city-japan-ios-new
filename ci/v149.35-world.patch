@@ -0,0 +1,407 @@
+extends RefCounted
+## v149.35 world stage 3: survivors who trust one another settle together.
+## A group has a home (an empty shop or house that is quiet enough), a shared
+## store, roles (those with nerve go out for supplies, the rest keep the
+## place), defences that grow with work, and, once settled, a small garden
+## and rain barrels. It takes in others its members trust; it loses people
+## to hunger, quarrels and the dead; it ends when fewer than two remain, and
+## what it had stays where it was. Nobody makes these happen: they follow
+## from bonds, supplies and danger.
+##
+## s.survivors.groups = {gid: {id, home, members[], store{}, founded, walls,
+## garden, hungry_days, name, ended}}; each member has p.group = gid.
+
+const Trade = preload("res://scripts/trade.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+
+## Places a group may settle in.
+const TownMap = preload("res://scripts/town_map.gd")
+const OLD_HOMES := ["近所の空き家", "金物店", "食品店", "薬局", "コンビニ", "デパート", "デパート地下"]
+## v149.36: and the wider town's empty buildings and open ground.
+static var HOMES: Array = OLD_HOMES + TownMap.buildings() + TownMap.PLACES.keys().filter(func(p): return bool(TownMap.PLACES[p].get("farmland", false)))
+const FORM_BOND := 70
+const JOIN_BOND := 50
+
+static func groups(world) -> Dictionary:
+	var st: Dictionary = world.s.survivors
+	if not st.get("groups") is Dictionary:
+		st.groups = {}
+	return st.groups
+
+## Reading only (looking must not change the saved world).
+static func _peek(world) -> Dictionary:
+	var st = world.s.get("survivors")
+	return st.get("groups", {}) if st is Dictionary and st.get("groups") is Dictionary else {}
+
+static func of(world, id: String) -> Dictionary:
+	var p: Dictionary = world.s.survivors.people.get(id, {})
+	var gid := str(p.get("group", ""))
+	if gid.is_empty():
+		return {}
+	return _peek(world).get(gid, {})
+
+static func _bond(people: Dictionary, a: String, b: String) -> int:
+	var k: Dictionary = people[a].get("acq", {}).get(b, {})
+	return int(k.get("trust", 0)) + int(k.get("like", 0))
+
+static func _home_ok(world, place: String) -> bool:
+	if not place in HOMES:
+		return false
+	# Open ground (a park, the riverside) is always there to be taken.
+	if bool(TownMap.PLACES.get(place, {}).get("farmland", false)):
+		return true
+	var site_name := "デパート" if place == "デパート地下" else place
+	var site: Dictionary = world.s.district.sites.get(site_name, {})
+	return not site.is_empty() and bool(site.get("vacant", false))
+
+## Hourly, after people have met: groups form or take people in.
+static func hourly(world, note: Callable) -> void:
+	var people: Dictionary = world.s.survivors.people
+	var by_place := {}
+	for id in people:
+		var p: Dictionary = people[id]
+		if str(p.get("status", "")) == "alive" and p.has("acq"):
+			if not by_place.has(p.place):
+				by_place[p.place] = []
+			by_place[p.place].append(str(id))
+	var minute := int(world.s.minute)
+	for place in by_place:
+		var here: Array = by_place[place]
+		if here.size() < 2:
+			continue
+		for a in here:
+			for b in here:
+				if a >= b:
+					continue
+				var ga := str(people[a].get("group", ""))
+				var gb := str(people[b].get("group", ""))
+				var mutual := mini(_bond(people, a, b), _bond(people, b, a))
+				if ga.is_empty() and gb.is_empty() and mutual >= FORM_BOND:
+					_found(world, [a, b], place, note)
+				elif not ga.is_empty() and gb.is_empty() and _bond(people, b, a) >= JOIN_BOND and _bond(people, a, b) >= JOIN_BOND:
+					_join(world, ga, b, note)
+				elif ga.is_empty() and not gb.is_empty() and _bond(people, a, b) >= JOIN_BOND and _bond(people, b, a) >= JOIN_BOND:
+					_join(world, gb, a, note)
+
+static func _found(world, ids: Array, place: String, note: Callable) -> void:
+	# Home: here if it will do, otherwise the quietest empty place nearby.
+	var home := place if _home_ok(world, place) else ""
+	if home.is_empty():
+		var best := 999
+		for h in HOMES:
+			if _home_ok(world, h):
+				var d := Walkers.count(world, h)
+				if d < best:
+					best = d
+					home = h
+	if home.is_empty():
+		return
+	var all := groups(world)
+	var gid := "g%d" % (all.size() + 1)
+	var people: Dictionary = world.s.survivors.people
+	var g := {"id": gid, "home": home, "members": [], "store": {"food": 0.0, "water": 0.0}, "founded": int(world.s.minute), "walls": 0.0, "garden": 0.0, "hungry_days": 0, "ended": false}
+	all[gid] = g
+	for id in ids:
+		people[id].group = gid
+		g.members.append(id)
+	note.call("%sと%sが、%sに住みつき、一緒に暮らし始めた。" % [str(people[ids[0]].name), str(people[ids[1]].name), home], str(ids[0]))
+	load("res://scripts/town_news.gd").record(world, "group_found", home, "%sで、何人かが一緒に暮らし始めた。" % home, gid)
+
+static func _join(world, gid: String, id: String, note: Callable) -> void:
+	var g: Dictionary = groups(world)[gid]
+	if bool(g.get("ended", false)) or g.members.size() >= 8:
+		return
+	var p: Dictionary = world.s.survivors.people[id]
+	p.group = gid
+	g.members.append(id)
+	note.call("%sが、%sで暮らす人たちに加わった。" % [str(p.name), str(g.home)], id)
+
+## Where a member means to be now ("" = decide as anyone would).
+static func goal(world, id: String, plan_in: String) -> Array:
+	var g := of(world, id)
+	if g.is_empty() or bool(g.get("ended", false)):
+		return []
+	var p: Dictionary = world.s.survivors.people[id]
+	var hour := int(world.hour_of_day())
+	var home := str(g.home)
+	var nerve := float(p.get("traits", {}).get("courage", 50))
+	var low := float(g.store.get("food", 0.0)) < float(g.members.size()) * 2.0
+	# By day, the bold go out when the store runs low; everyone sleeps home.
+	if hour >= 7 and hour < 17 and low and nerve >= 45:
+		return ["forage_for_group", ""]
+	return ["home", home]
+
+## Daily: pooling, eating, the garden, walls, quarrels, endings.
+static func daily(world, note: Callable) -> void:
+	var people: Dictionary = world.s.survivors.people
+	var day := int(world.s.minute) / 1440
+	for gid in groups(world):
+		var g: Dictionary = groups(world)[gid]
+		if bool(g.get("ended", false)):
+			continue
+		g.members = g.members.filter(func(m): return people.has(m) and str(people[m].status) == "alive" and str(people[m].get("group", "")) == gid)
+		var player_in := str(world.s.get("npc_group", "")) == str(gid)
+		if g.members.size() + (1 if player_in else 0) < 2 and not (bool(g.get("player_led", false)) and player_in):
+			_end(world, g, note, "残った人も、どこかへ去っていった。")
+			continue
+		var at_home: Array = g.members.filter(func(m): return str(people[m].place) == str(g.home))
+		# What members brought back above their own needs goes into the store.
+		for m in at_home:
+			var mine := Trade.goods(world, m)
+			for item in ["food", "water", "bandage", "wood", "parts"]:
+				var keep := Trade.reserve(world, m, item)
+				var extra := floorf(float(mine.get(item, 0.0)) - keep)
+				if extra > 0.0:
+					mine[item] = float(mine[item]) - extra
+					g.store[item] = float(g.store.get(item, 0.0)) + extra
+		# The player, living with them and there, is another pair of hands.
+		var hands := at_home.size()
+		if str(world.s.get("npc_group", "")) == str(gid) and str(world.get_meta("player_place", "")) == str(g.home):
+			hands += 1
+		# Settled long enough: a garden and rain barrels, worked by those home.
+		var settled := day - int(g.founded) / 1440
+		if settled >= 3:
+			# Planters, then beds: more hands, more ground worked.
+			g.garden = minf(1.0, float(g.garden) + 0.06 * float(hands))
+			if settled >= 5:
+				var ground := 2.0 if bool(TownMap.PLACES.get(str(g.home), {}).get("farmland", false)) else 1.0
+				# v149.36: gardens follow the seasons too.
+				var season: float = load("res://scripts/crops.gd").garden_season(world)
+				g.store.food = float(g.store.get("food", 0.0)) + float(g.garden) * 0.6 * float(hands) * ground * season
+			g.store.water = float(g.store.get("water", 0.0)) + 2.0 + float(hands) + (4.0 if bool(TownMap.PLACES.get(str(g.home), {}).get("water_source", false)) else 0.0)
+		# Walls go up with work (and wood, if there is any).
+		var wood := minf(float(g.store.get("wood", 0.0)), 1.0)
+		g.store.wood = float(g.store.get("wood", 0.0)) - wood
+		g.walls = minf(100.0, float(g.walls) + 2.0 * float(hands) + 10.0 * wood)
+		# Each member short of their day's food and water takes it from the store.
+		var short := false
+		for m in g.members:
+			var mine := Trade.goods(world, m)
+			for item in Trade.DAILY:
+				var need := float(Trade.DAILY[item]) * (1.0 + float(people[m].get("dependents", 0)))
+				var lack := maxf(0.0, need - float(mine.get(item, 0.0)))
+				var take := minf(lack, float(g.store.get(item, 0.0)))
+				g.store[item] = float(g.store.get(item, 0.0)) - take
+				mine[item] = float(mine.get(item, 0.0)) + take
+				short = short or take < lack
+		g.hungry_days = int(g.hungry_days) + 1 if short else 0
+		# Hunger and dislike drive people out.
+		for m in g.members.duplicate():
+			var p: Dictionary = people[m]
+			var liked := 0
+			for other in g.members:
+				if other != m:
+					liked += _bond(people, m, other)
+			liked /= maxi(1, g.members.size() - 1)
+			var roll: int = world.draw(int(world.s.minute), absi(hash([gid, m])) % 9973, "group-leave", 100)
+			if (int(g.hungry_days) >= 3 and roll < 25 + int(float(p.traits.get("loyalty", 50)) < 40) * 25) or (liked < -20 and roll < 30):
+				p.erase("group")
+				g.members.erase(m)
+				note.call("%sが、%sでの暮らしに見切りをつけて出ていった。" % [str(p.name), str(g.home)], m)
+		if g.members.size() + (1 if player_in else 0) < 2 and not (bool(g.get("player_led", false)) and player_in):
+			_end(world, g, note, "最後まで残っていた人も、出ていった。")
+
+static func _end(world, g: Dictionary, note: Callable, why: String) -> void:
+	g.ended = true
+	g.ended_at = int(world.s.minute)
+	for m in g.members:
+		var p: Dictionary = world.s.survivors.people.get(m, {})
+		if not p.is_empty():
+			p.erase("group")
+	# What was left stays where it was, for whoever comes.
+	var site_name := "デパート" if str(g.home) == "デパート地下" else str(g.home)
+	var site: Dictionary = world.s.district.sites.get(site_name, {})
+	if not site.is_empty():
+		site.food = float(site.get("food", 0.0)) + float(g.store.get("food", 0.0))
+		site.water = float(site.get("water", 0.0)) + float(g.store.get("water", 0.0))
+	g.store = {"food": 0.0, "water": 0.0}
+	note.call("%sでの暮らしは終わった。%s" % [str(g.home), why], "")
+	load("res://scripts/town_news.gd").record(world, "group_end", str(g.home), "%sで暮らしていた人たちが、いなくなった。" % str(g.home), str(g.id))
+
+## Walls keep the dead off those at home (used for danger and the daily risk).
+static func shelter_factor(world, id: String) -> float:
+	var g := of(world, id)
+	if g.is_empty() or bool(g.get("ended", false)):
+		return 1.0
+	var p: Dictionary = world.s.survivors.people[id]
+	if str(p.place) != str(g.home):
+		return 1.0
+	return clampf(1.0 - float(g.walls) / 120.0, 0.2, 1.0)
+
+## What the player sees on arriving at a group's home.
+static func describe(world, place: String) -> String:
+	for gid in _peek(world):
+		var g: Dictionary = _peek(world)[gid]
+		if bool(g.get("ended", false)):
+			if str(g.home) == place and int(world.s.minute) - int(g.get("ended_at", 0)) < 30 * 1440:
+				return "入口の板が外れかけている。中には、誰かが暮らしていた跡だけが残っていた。"
+			continue
+		if str(g.home) != place:
+			continue
+		var n: int = g.members.size()
+		var walls := "入口は板と棚でしっかりふさがれている。" if float(g.walls) >= 50.0 else ("入口に板が打ちつけてある。" if float(g.walls) >= 15.0 else "")
+		var garden := "裏手のプランターに、青い芽が並んでいる。" if float(g.garden) >= 0.3 else ""
+		return "ここには、%d人が身を寄せ合って暮らしている。%s%s" % [n, walls, garden]
+	return ""
+
+# ---------------------------------------------------------------------------
+# Stage 4: the player and a group.
+
+## The active group living at this place, or {}.
+static func at(world, place: String) -> Dictionary:
+	for gid in _peek(world):
+		var g: Dictionary = _peek(world)[gid]
+		if not bool(g.get("ended", false)) and str(g.home) == place:
+			return g
+	return {}
+
+static func player_group(world) -> Dictionary:
+	var gid := str(world.s.get("npc_group", ""))
+	if gid.is_empty() or not world.s.get("survivors") is Dictionary:
+		return {}
+	var g: Dictionary = _peek(world).get(gid, {})
+	if g.is_empty() or bool(g.get("ended", false)):
+		return {}
+	return g
+
+## What the group as a whole thinks of the player (their members' trust).
+static func opinion(world, g: Dictionary) -> int:
+	var people: Dictionary = world.s.survivors.people
+	var total := 0
+	var n := 0
+	for m in g.members:
+		if people.has(m):
+			total += int(people[m].get("trust", 30))
+			n += 1
+	return total / maxi(1, n)
+
+static func _warm(world, g: Dictionary, amount: int) -> void:
+	for m in g.members:
+		var p: Dictionary = world.s.survivors.people.get(m, {})
+		if not p.is_empty():
+			p.trust = clampi(int(p.get("trust", 30)) + amount, 0, 100)
+			p.met = true
+
+## How the group stands on cash, from what its members believe (re-judged as
+## people come and go): "cash" (they take it), "goods" (they will not), "mixed".
+static func cash_policy(world, g: Dictionary) -> String:
+	var Trade2 = load("res://scripts/trade.gd")
+	var total := 0.0
+	for m in g.members:
+		total += Trade2.cash_trust(world, str(m), true)
+	var avg := total / maxf(1.0, float(g.members.size()))
+	if avg >= 0.5:
+		return "cash"
+	if avg < 0.3:
+		return "goods"
+	return "mixed"
+
+## Giving to the store: it is theirs now, and they remember who gave.
+static func donate(world, g: Dictionary, item: String, qty: float) -> String:
+	var Trade2 = load("res://scripts/trade.gd")
+	if Trade2.held(world, item) < qty:
+		return "持ち歩いている%sが足りない。" % Trade2.ITEMS[item].label
+	Trade2._add_player(world, item, -qty)
+	g.store[item] = float(g.store.get(item, 0.0)) + qty
+	_warm(world, g, mini(20, 3 + int(Trade2.ITEMS[item].base) * int(qty) / 400))
+	world.advance_safe(5)
+	return "%sを、%sの人たちの蓄えに預けた。「……ありがたい」という声が返ってきた。" % [Trade2.amount_text(item, qty), str(g.home)]
+
+## Working with them: three hours on the walls and the garden.
+static func help(world, g: Dictionary) -> String:
+	var minutes: int = world.advance_safe(180)
+	if minutes < 180:
+		return "作業は途中で止まった。"
+	g.walls = minf(100.0, float(g.walls) + 6.0)
+	g.garden = minf(1.0, float(g.garden) + 0.05)
+	world.s.walkers.noise = world.s.walkers.get("noise", {})
+	_warm(world, g, 4)
+	world.s.fatigue = minf(100.0, float(world.s.fatigue) + 12.0)
+	return "%sの人たちと3時間、入口の補強と畑の手入れをした。汗をぬぐうと、誰かが水を回してくれた。" % str(g.home)
+
+## Asking to live with them. They decide from what they think of the player
+## and whether there is food to go round.
+static func ask_join(world, g: Dictionary) -> String:
+	if not player_group(world).is_empty():
+		return "すでに、%sの人たちと暮らしている。" % str(player_group(world).home)
+	var view := opinion(world, g)
+	var mouths := float(g.members.size() + 1)
+	if g.members.size() >= 8:
+		return "「悪いけど、もうこれ以上は寝る場所がない」"
+	if view < 45:
+		return "顔を見合わせたあと、首を横に振られた。「あんたのことは、まだよく知らない」（信頼がまだ足りない）"
+	if float(g.store.get("food", 0.0)) < mouths and view < 70:
+		return "「食べ物が、今いる人の分で精一杯なんだ」（食料を預ければ、考えてくれるかもしれない）"
+	world.s.npc_group = str(g.id)
+	world.advance_safe(10)
+	return "「……いいよ。ここで一緒にやろう」%sで、寝泊まりできるようになった。蓄えから食事もできる。（「ここを出る」で離れられる）" % str(g.home)
+
+static func leave(world) -> String:
+	var g := player_group(world)
+	if g.is_empty():
+		return "どこの集まりにも加わっていない。"
+	world.s.npc_group = ""
+	_warm(world, g, -5)
+	return "%sの人たちに別れを告げた。" % str(g.home)
+
+## A meal from the store for a member at home (moved to the bag and eaten).
+static func feed_player(world) -> bool:
+	var g := player_group(world)
+	if g.is_empty() or str(world.get_meta("player_place", "")) != str(g.home):
+		return false
+	var bag: Dictionary = world.s.district.bag
+	var moved := false
+	for item in ["food", "water"]:
+		var portion := minf(0.75 if item == "food" else 1.5, float(g.store.get(item, 0.0)))
+		if portion > 0.0:
+			g.store[item] = float(g.store[item]) - portion
+			bag[item] = float(bag[item]) + portion
+			moved = true
+	return moved
+
+# ---------------------------------------------------------------------------
+# Stage 6: the player's own settlement — the same group, with the player as
+# one of its members. People join by trust; the rest (foraging, walls,
+# garden, the store, quarrels, leaving) follows the same rules as any group.
+
+static func found_by_player(world, place: String) -> String:
+	if not player_group(world).is_empty():
+		return "すでに、%sの人たちと暮らしている。（「ここを出る」で離れられる）" % str(player_group(world).home)
+	if not at(world, place).is_empty():
+		return "ここには、もう別の人たちが暮らしている。"
+	var all := groups(world)
+	var gid := "g%d" % (all.size() + 1)
+	all[gid] = {"id": gid, "home": place, "members": [], "store": {"food": 0.0, "water": 0.0}, "founded": int(world.s.minute), "walls": 0.0, "garden": 0.0, "hungry_days": 0, "ended": false, "player_led": true}
+	world.s.npc_group = gid
+	load("res://scripts/town_news.gd").record(world, "group_found", place, "%sに、人が集まり始めた。" % place, gid)
+	return "%sを、人が集まって暮らせる場所にすると決めた。信頼できる人を誘えば、ここに来てくれる。（「食料を寄付する」で蓄えを作れる）" % place
+
+## Asking someone to come and live at the player's settlement.
+static func invite_to(world, id: String) -> String:
+	var g := player_group(world)
+	if g.is_empty():
+		return ""
+	var p: Dictionary = world.s.survivors.people.get(id, {})
+	if str(p.get("group", "")) == str(g.id):
+		return "%sは、もう%sで一緒に暮らしている。" % [str(p.name), str(g.home)]
+	if not bool(p.get("joinable", false)) or bool(p.get("neighbor", false)):
+		return "%sは首を横に振った。「ここを離れる気はないんだ」" % str(p.name)
+	if int(p.get("trust", 0)) < 50:
+		return "%sは少し考えてから、首を横に振った。「あんたのことを、もう少し知ってからにする」" % str(p.name)
+	if not str(p.get("group", "")).is_empty():
+		var old: Dictionary = groups(world).get(str(p.group), {})
+		if not old.is_empty():
+			old.members.erase(id)
+	p.group = str(g.id)
+	g.members.append(id)
+	load("res://scripts/npc_life.gd")._note(world, "%sが、%sで暮らす人たちに加わった。" % [str(p.name), str(g.home)], id)
+	return "「……わかった。そっちへ行く」%sは、%sに向かうことにした。" % [str(p.name), str(g.home)]
+
+## How the player's settlement is doing.
+static func status_text(world) -> String:
+	var g := player_group(world)
+	if g.is_empty():
+		return "どこの集まりにも加わっていない。"
+	var people: Dictionary = world.s.survivors.people
+	var names: Array = g.members.map(func(m): return str(people[m].name) if people.has(m) else "?")
+	return "%sの暮らし\n暮らしている人：%s\n蓄え：食料 %.0f人日・水 %.0f L\n守り：%s ・ 畑：%s" % [str(g.home), "あなた" + ("、" + "、".join(names) if not names.is_empty() else ""), float(g.store.get("food", 0.0)), float(g.store.get("water", 0.0)), "しっかりしている" if float(g.walls) >= 50.0 else ("板を打ちつけた程度" if float(g.walls) >= 15.0 else "ほとんどない"), "実り始めている" if float(g.garden) >= 0.5 else ("芽が出た" if float(g.garden) > 0.0 else "まだない")]
