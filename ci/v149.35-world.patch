@@ -0,0 +1,272 @@
+extends SceneTree
+## Playthrough soak: an automated player who looks after themselves and
+## otherwise follows the game's own suggestions (and sometimes types free
+## text), across several kinds of household. Reports anything wrong.
+## Usage: godot --headless --script tests/_soak.gd -- <scenario> <steps>
+
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+
+var issues: Array = []
+var counts := {}
+
+func note(kind: String, text: String) -> void:
+	counts[kind] = int(counts.get(kind, 0)) + 1
+	if int(counts[kind]) <= 6:
+		issues.append("[%s] %s" % [kind, text])
+
+const FREE := ["周囲を見る", "物資を探索する", "街を歩く", "ニュースを見る", "トランプをする", "リバーシをする", "洗濯する", "温かい料理を作る",
+	"スーパーへ行く", "総合病院へ行く", "中学校へ行く", "駅のホームへ行く", "売り場に行く", "バックヤードに行く", "病室に行く", "保健室に行く",
+	"待合室に行く", "入口に戻る", "家に戻る", "水を汲む", "種を植える", "水やり", "収穫", "プランターを作る", "本を読む", "状態", "持ち物",
+	"集まりを訪ねる", "ノックする", "一緒に来ないか誘う", "ここを拠点にする", "物資を持っていく", "1時間休息", "町のうわさ", "空き家を探す",
+	"玄関を補強", "鍵を閉める", "避難所へ行く", "配給を受け取る", "川沿いの土手へ行く", "団地へ行く", "北の住宅街へ行く"]
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func run() -> void:
+	var args := OS.get_cmdline_user_args()
+	var scenario := args[0] if args.size() > 0 else "solo"
+	var steps := int(args[1]) if args.size() > 1 else 300
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = hash(scenario) % 100000
+	match scenario:
+		"solo":
+			p.cohabitants = 0
+		"family":
+			p.cohabitants = 3
+			p.companion_names = ["詩音", "蒼", "結衣"]
+			p.companion_genders = ["女性", "男性", "女性"]
+		"flat":
+			p.housing = "集合住宅"
+			p.cohabitants = 1
+			p.companion_names = ["詩音"]
+			p.companion_genders = ["女性"]
+		"flat_solo":
+			p.housing = "集合住宅"
+			p.cohabitants = 0
+		"pair":
+			p.cohabitants = 1
+			p.companion_names = ["蒼"]
+			p.companion_genders = ["男性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var dump := FileAccess.open("/tmp/w/text_%s.txt" % scenario, FileAccess.WRITE)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = p.seed
+	var still := 0
+	var last_minute := int(w.s.minute)
+	var chip_fail := 0
+	var free_fail := 0
+	var used_chips := 0
+	var slow: Array = []
+	var day_reached := 0
+	var died_day := -1
+	var seen_lines := {}
+	var repeats := 0
+	var jump := int(args[2]) if args.size() > 2 else 0
+	for step in steps:
+		if jump > 0 and step > 0 and step % jump == 0 and Walkers_none(g) and float(w.s.health) > 0:
+			# Fast mode: a day goes by off-screen (eating and drinking as needed).
+			var tj := Time.get_ticks_msec()
+			for h in 24:
+				w.advance(60, h < 8)
+				if float(w.s.hunger) > 50.0 and float(w.s.food) >= 0.25: await g._on_command("食事する")
+				if float(w.s.thirst) > 50.0 and float(w.s.water) >= 0.5: await g._on_command("水を飲む")
+				if float(w.s.health) <= 0.0 or not Walkers_none(g): break
+			g._refresh()
+		# Survival assist (counted): keep the house fed so later days get played.
+		if float(w.s.food) < 1.5 + w.s.household_members.size():
+			w.s.food = float(w.s.food) + 6.0 + 3.0 * w.s.household_members.size()
+			counts["assist-food"] = int(counts.get("assist-food", 0)) + 1
+		if float(w.s.water) < 3.0:
+			w.s.water = float(w.s.water) + 12.0
+			counts["assist-water"] = int(counts.get("assist-water", 0)) + 1
+		if float(w.s.health) <= 0.0:
+			died_day = int(w.s.minute) / 1440
+			break
+		var ts := Time.get_ticks_msec()
+		var chips: Array = g._suggestions()
+		if Time.get_ticks_msec() - ts > 300: print("SUGG ms ", Time.get_ticks_msec() - ts)
+		var ti := Time.get_ticks_msec()
+		var cmd := ""
+		var from_chip := true
+		# Look after yourself first (going home for it when carrying nothing).
+		var nav = load("res://scripts/navigation.gd")
+		var away: bool = not nav.indoor(g.location)
+		var bag: Dictionary = w.s.district.get("bag", {})
+		if away and Walkers_none(g) and ((float(w.s.thirst) > 55.0 and float(bag.get("water", 0.0)) < 0.5) or (float(w.s.hunger) > 55.0 and float(bag.get("food", 0.0)) < 0.25)) and step % 3 == 0:
+			cmd = "家に帰る"
+			from_chip = false
+		elif float(w.s.thirst) > 55.0 and float(w.s.water) >= 0.5 and Walkers_none(g):
+			cmd = "水を飲む"
+			from_chip = false
+		elif float(w.s.hunger) > 55.0 and float(w.s.food) >= 0.25 and Walkers_none(g):
+			cmd = "食事する"
+			from_chip = false
+		elif (float(w.s.fatigue) > 75.0 or (w.hour_of_day() >= 23.0 or w.hour_of_day() < 5.0)) and Walkers_none(g) and float(w.s.health) > 0:
+			cmd = "寝る"
+			from_chip = false
+		elif not chips.is_empty() and rng.randf() < 0.8:
+			cmd = str(chips[rng.randi_range(0, chips.size() - 1)])
+		else:
+			cmd = FREE[rng.randi_range(0, FREE.size() - 1)]
+			from_chip = false
+		var before_lines: int = g.log_entries.size()
+		var t0 := Time.get_ticks_msec()
+		print("CMD %d day%d %s @%s: %s" % [step, int(w.s.minute) / 1440, scenario, g.location, cmd])
+		await g._on_command(cmd)
+		var guard := 0
+		while g.advancing and guard < 600:
+			guard += 1
+			await process_frame
+		# A game table opened: play it out and put it away.
+		if g.get("reversi_layer") != null and is_instance_valid(g.reversi_layer):
+			await _play_reversi(g)
+		if g.get("cards_layer") != null and is_instance_valid(g.cards_layer):
+			await _play_cards(g, rng)
+		var ms := Time.get_ticks_msec() - t0
+		if ms > 1500: print("MS %d %s" % [ms, cmd])
+		if ms > 4000:
+			slow.append("%s (%dms)" % [cmd, ms])
+		var fresh: Array = []
+		var mark := -1
+		for k in range(g.log_entries.size() - 1, -1, -1):
+			if str(g.log_entries[k]).begins_with("▶ ") and str(g.log_entries[k]).contains(cmd):
+				mark = k
+				break
+		fresh = g.log_entries.slice(mark + 1) if mark >= 0 else []
+		var text := "\n".join(fresh)
+		dump.store_line("▶ [d%d %s] %s" % [int(w.s.minute) / 1440, g.location, cmd])
+		for l in fresh:
+			dump.store_line(str(l))
+		if from_chip:
+			used_chips += 1
+			if text.contains("解釈できません") or text.contains("解釈できませんでした"):
+				chip_fail += 1
+				note("chip-not-understood", "%s @%s → %s" % [cmd, g.location, text.left(160)])
+			elif text.contains("何も実行していません"):
+				chip_fail += 1
+				note("chip-did-nothing", "%s @%s → %s" % [cmd, g.location, text.replace("\n", " ").left(160)])
+		elif text.contains("解釈できません"):
+			free_fail += 1
+			note("free-not-understood", "%s @%s" % [cmd, g.location])
+		if fresh.is_empty() and not cmd in ["状態", "持ち物"]:
+			note("no-output", "%s @%s" % [cmd, g.location])
+		for l in fresh:
+			var key := str(l)
+			if key.length() > 40 and not key.begins_with("▶"):
+				if seen_lines.get(key, -100) == step - 1:
+					repeats += 1
+					note("same-line-twice", key.left(100))
+				seen_lines[key] = step
+		# Invariants.
+		for k in ["food", "water", "health", "hunger", "thirst", "fatigue"]:
+			var v := float(w.s.get(k, 0.0))
+			if is_nan(v) or v < -0.001:
+				note("bad-value", "%s=%s after %s" % [k, v, cmd])
+		for k in ["health", "hunger", "thirst", "fatigue"]:
+			if float(w.s.get(k, 0.0)) > 100.5:
+				note("over-100", "%s=%s after %s" % [k, w.s[k], cmd])
+		for item in w.s.inventory:
+			if float(w.s.inventory[item]) < 0.0:
+				note("negative-item", "%s=%s after %s" % [item, w.s.inventory[item], cmd])
+		for m in w.s.household_members:
+			if is_nan(float(m.get("health", 0.0))) or float(m.get("mood", 50.0)) > 100.5 or float(m.get("mood", 50.0)) < -0.5:
+				note("member-value", "%s health %s mood %s" % [m.name, m.get("health"), m.get("mood")])
+		if w.s.get("survivors") is Dictionary:
+			for pid in w.s.survivors.get("people", {}):
+				var st := str(w.s.survivors.people[pid].get("status", ""))
+				if not st in ["alive", "dead", "joined", "left", "looter", "turned", "gone", "moved", "housemate", "evacuated", "away"]:
+					note("odd-status", "%s %s" % [pid, st])
+		if int(w.s.minute) < last_minute:
+			note("time-backwards", "%d → %d after %s" % [last_minute, w.s.minute, cmd])
+		if int(w.s.minute) == last_minute:
+			still += 1
+			if still == 25:
+				note("time-stuck", "25 commands without time passing, last: %s @%s" % [cmd, g.location])
+		else:
+			still = 0
+		last_minute = int(w.s.minute)
+		day_reached = int(w.s.minute) / 1440
+	print("SUMMARY %s steps=%d day=%d died=%d society=%s cases=%d food=%.1f water=%.1f health=%.0f mates=%d chips=%d chip_fail=%d free_fail=%d repeats=%d" % [scenario, steps, day_reached, died_day, w.s.society, int(w.s.regional_cases), float(w.s.food), float(w.s.water), float(w.s.health), w.s.household_members.size(), used_chips, chip_fail, free_fail, repeats])
+	print("COUNTS ", counts)
+	var Ch = load("res://scripts/chronicle.gd")
+	print("DEATH ended=", Ch.state(w).get("ended", false), " cause=", Ch.cause(w), " hunger=", w.s.hunger, " thirst=", w.s.thirst, " bitten=", w.s.get("bitten", false), " injuries=", w.s.injuries, " fatigue=", w.s.fatigue, " mood=", w.s.get("mood"))
+	var has_end := false
+	for e in g.log_entries:
+		if str(e).begins_with("【最期】"): has_end = true
+	print("DEATH logged=", has_end)
+	for i in issues:
+		print("ISSUE ", i)
+	for s in slow.slice(0, 8):
+		print("SLOW ", s)
+	print("LASTLOG ", "\n".join(g.log_entries.slice(-6)).left(1200))
+	quit()
+
+func Walkers_none(g) -> bool:
+	return load("res://scripts/walkers.gd").ensure(g.world).encounter.is_empty()
+
+func _play_reversi(g) -> void:
+	var t = g.reversi_layer
+	t.think = 0.0
+	var R = load("res://scripts/reversi.gd")
+	var guard := 0
+	while not t.done and guard < 80:
+		guard += 1
+		if t.wait_pending:
+			t._grant_wait()
+			continue
+		var o: Array = R.moves(t.board, 1)
+		if o.is_empty():
+			break
+		t.place(int(o[0]))
+		await process_frame
+	if not t.done:
+		note("reversi-stuck", "not finished after %d" % guard)
+	t._close("また")
+	await process_frame
+
+func _play_cards(g, rng) -> void:
+	var t = g.cards_layer
+	t.delay = 0.0
+	var kinds := ["babanuki", "daifugo", "shichinarabe", "shinkei"]
+	t.begin(kinds[rng.randi_range(0, 3)])
+	var D = load("res://scripts/cards_daifugo.gd")
+	var S = load("res://scripts/cards_shichinarabe.gd")
+	var K = load("res://scripts/cards_shinkei.gd")
+	var guard := 0
+	while not bool(t.state.done) and guard < 500:
+		guard += 1
+		if int(t.state.turn) != 0 or t.running:
+			await process_frame
+			continue
+		match t.kind:
+			"babanuki":
+				t.draw_card(0)
+			"daifugo":
+				var o: Array = D.options(t.state, 0)
+				if o.is_empty():
+					t.pass_turn()
+				else:
+					t.selected = o[0]
+					t.play_selected()
+			"shichinarabe":
+				var o: Array = S.options(t.state, 0)
+				if o.is_empty():
+					t.pass_turn()
+				else:
+					t.lay(str(o[0]))
+			"shinkei":
+				var open: Array = K.open_cells(t.state).filter(func(c): return c != int(t.state.first))
+				t.flip(int(open[0]))
+		await process_frame
+	if not bool(t.state.done):
+		note("cards-stuck", "%s not finished" % t.kind)
+	t._leave()
+	await process_frame
