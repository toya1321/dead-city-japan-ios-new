index 0000000..c763043
--- /dev/null
+++ b/scripts/npc_bonds.gd
@@ -0,0 +1,160 @@
+extends RefCounted
+## v149.35 world stage 2: what survivors become to one another. Each pair who
+## have met keep a bond in acq[other]: trust and liking (-100..100), how often
+## they met, and what passed between them. When they are together, what they
+## do comes from who they are (honesty, loyalty, temper, suspicion, courage)
+## and what they have: sharing food, a fair swap (both sides judge with the
+## same trade engine as with the player), bandaging a wound, stealing in the
+## night, quarrelling, keeping company — and what they say of the player.
+## Every act moves real goods, and every act is remembered.
+
+const Trade = preload("res://scripts/trade.gd")
+
+const MEMORY_CAP := 6
+
+static func _t(p: Dictionary, key: String) -> float:
+	return float(p.get("traits", {}).get(key, 50))
+
+## The bond a has with b (made on first meeting from their natures).
+static func bond(people: Dictionary, a: String, b: String, minute: int) -> Dictionary:
+	var pa: Dictionary = people[a]
+	var acq: Dictionary = pa.get("acq", {})
+	var known: Dictionary = acq.get(b, {})
+	if not known.has("trust"):
+		var pb: Dictionary = people[b]
+		known.trust = int(40 - _t(pa, "suspicion") * 0.4 + _t(pb, "honesty") * 0.2)
+		# Like temper clashes; like honesty attracts.
+		known.like = int(10 - absf(_t(pa, "temper") - _t(pb, "temper")) * 0.3 + (_t(pb, "honesty") - 50.0) * 0.2)
+		known.mem = known.get("mem", [])
+		if not known.has("first"):
+			known.first = minute
+			known.last = minute
+			known.n = 0
+	acq[b] = known
+	pa.acq = acq
+	return known
+
+static func _remember(known: Dictionary, minute: int, what: String) -> void:
+	var mem: Array = known.get("mem", [])
+	mem.append({"at": minute, "what": what})
+	while mem.size() > MEMORY_CAP:
+		mem.pop_front()
+	known.mem = mem
+
+static func _shift(known: Dictionary, trust: int, like: int) -> void:
+	known.trust = clampi(int(known.get("trust", 0)) + trust, -100, 100)
+	known.like = clampi(int(known.get("like", 0)) + like, -100, 100)
+
+## One turn of two people together (called every few hours they share).
+static func together(world, a: String, b: String, note: Callable) -> void:
+	var people: Dictionary = world.s.survivors.people
+	var pa: Dictionary = people[a]
+	var pb: Dictionary = people[b]
+	var minute := int(world.s.minute)
+	var ab := bond(people, a, b, minute)
+	var ba := bond(people, b, a, minute)
+	var roll: int = world.draw(minute, absi(hash([a, b])) % 9973, "bond", 100)
+	var ga := Trade.goods(world, a)
+	var gb := Trade.goods(world, b)
+	var hour := int(world.hour_of_day())
+	var name_a := str(pa.get("name", ""))
+	var name_b := str(pb.get("name", ""))
+	# Time together, without trouble, builds a little trust.
+	_shift(ab, 1, 0)
+	_shift(ba, 1, 0)
+	# Something happens between the same two at most once a day.
+	if minute - int(ab.get("act_at", -100000)) < 1440 or minute - int(ba.get("act_at", -100000)) < 1440:
+		return
+	ab.act_at = minute
+	# A wound bandaged: the one who has a bandage and cares, for one who bleeds.
+	if str(pb.get("tag", "")) == "injured" and not bool(pb.get("treated", false)) and float(ga.get("bandage", 0.0)) >= 1.0 and int(ab.like) + _t(pa, "loyalty") * 0.5 >= 30:
+		ga.bandage = float(ga.bandage) - 1.0
+		pb.treated = true
+		_shift(ba, 25, 20)
+		_shift(ab, 5, 10)
+		_remember(ba, minute, "%sが傷の手当てをしてくれた" % name_a)
+		_remember(ab, minute, "%sの傷を手当てした" % name_b)
+		note.call("%sが、%sの傷に包帯を巻いた。" % [name_a, name_b], a)
+		return
+	var a_short_food := float(ga.get("food", 0.0)) < Trade.reserve(world, a, "food")
+	var b_short_food := float(gb.get("food", 0.0)) < Trade.reserve(world, b, "food")
+	# Sharing: one with plenty, one with nothing, someone kind or a friend.
+	var spare_a := float(ga.get("food", 0.0)) - Trade.reserve(world, a, "food")
+	if b_short_food and spare_a >= 1.0 and _t(pa, "honesty") * 0.5 + _t(pa, "loyalty") * 0.3 + float(ab.like) > 55.0 + float(roll) * 0.3:
+		ga.food = float(ga.food) - 1.0
+		gb.food = float(gb.get("food", 0.0)) + 1.0
+		_shift(ba, 20, 15)
+		_shift(ab, 3, 5)
+		_remember(ba, minute, "%sが食べ物を分けてくれた" % name_a)
+		_remember(ab, minute, "%sに食べ物を分けた" % name_b)
+		note.call("%sが、%sに食料を分けた。" % [name_a, name_b], a)
+		return
+	# Stealing: at night, from someone asleep, by the desperate and dishonest.
+	if (hour < 5 or hour >= 22) and a_short_food and float(gb.get("food", 0.0)) >= 1.0 and _t(pa, "honesty") < 40.0 and roll < 30:
+		gb.food = float(gb.food) - 1.0
+		ga.food = float(ga.get("food", 0.0)) + 1.0
+		# It is noticed more often than not.
+		if roll < 20:
+			_shift(ba, -60, -50)
+			_remember(ba, minute, "%sに食べ物を盗まれた" % name_a)
+			note.call("夜のうちに、%sが%sの食料を盗んだ。気づかれて、ひどい言い争いになった。" % [name_a, name_b], a)
+		return
+	# A fair swap: each gives what they can spare for what they lack, judged
+	# by the same rules as any trade.
+	var swap := _swap(world, a, b)
+	if not swap.is_empty() and int(ab.trust) >= 0 and int(ba.trust) >= 0:
+		ga[swap.give] = float(ga.get(swap.give, 0.0)) - float(swap.give_n)
+		gb[swap.give] = float(gb.get(swap.give, 0.0)) + float(swap.give_n)
+		gb[swap.get] = float(gb.get(swap.get, 0.0)) - float(swap.get_n)
+		ga[swap.get] = float(ga.get(swap.get, 0.0)) + float(swap.get_n)
+		_shift(ab, 6, 3)
+		_shift(ba, 6, 3)
+		_remember(ab, minute, "%sと物を交換した" % name_b)
+		_remember(ba, minute, "%sと物を交換した" % name_a)
+		note.call("%sと%sが、%sと%sを交換した。" % [name_a, name_b, Trade.amount_text(swap.give, swap.give_n), Trade.amount_text(swap.get, swap.get_n)], a)
+		return
+	# Quarrels: short tempers and short supplies.
+	if (_t(pa, "temper") + _t(pb, "temper")) / 2.0 + (20.0 if a_short_food or b_short_food else 0.0) - float(ab.get("like", 0)) * 0.2 > 80.0 + float(roll) * 0.5:
+		_shift(ab, -5, -15)
+		_shift(ba, -5, -15)
+		_remember(ab, minute, "%sと口論になった" % name_b)
+		_remember(ba, minute, "%sと口論になった" % name_a)
+		note.call("%sと%sが、言い争いをしていた。" % [name_a, name_b], a)
+	# What they say of the player: a trusted friend's word moves opinion.
+	var pt := int(pa.get("trust", 30))
+	var qt := int(pb.get("trust", 30))
+	if bool(pa.get("met", false)) and int(ba.trust) >= 40 and absi(pt - qt) >= 15:
+		pb.trust = clampi(qt + (pt - qt) / 4, 0, 100)
+		pb.heard_of_player = true
+
+## What a could give b for something b can give a, fair to both.
+static func _swap(world, a: String, b: String) -> Dictionary:
+	var spare_a := Trade.spare(world, a)
+	var spare_b := Trade.spare(world, b)
+	for give in spare_a:
+		for take in spare_b:
+			if give == take:
+				continue
+			var give_n := float(Trade.ITEMS[give].step)
+			var take_n := float(Trade.ITEMS[take].step)
+			# Worth more to each than what they part with.
+			# Clearly worth more to each than what they part with.
+			if Trade.receive_value(world, a, take, take_n) > Trade.give_cost(world, a, give, give_n) * 1.3 and Trade.receive_value(world, b, give, give_n) > Trade.give_cost(world, b, take, take_n) * 1.3:
+				return {"give": give, "give_n": give_n, "get": take, "get_n": take_n}
+	return {}
+
+## The one they trust and like most, if strongly enough to keep company.
+static func companion(world, id: String) -> String:
+	var p: Dictionary = world.s.survivors.people.get(id, {})
+	var best := ""
+	var best_score := 120
+	for other in p.get("acq", {}):
+		var k: Dictionary = p.acq[other]
+		var q: Dictionary = world.s.survivors.people.get(other, {})
+		if str(q.get("status", "")) != "alive":
+			continue
+		var score := int(k.get("trust", 0)) + int(k.get("like", 0))
+		if score >= best_score:
+			best_score = score
+			best = str(other)
+	return best
