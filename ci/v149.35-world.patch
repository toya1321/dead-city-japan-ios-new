diff --git a/tests/test_npc_life149_35.gd b/tests/test_npc_life149_35.gd
new file mode 100644
index 0000000..87d7cb2
--- /dev/null
+++ b/tests/test_npc_life149_35.gd
@@ -0,0 +1,173 @@
+extends SceneTree
+## v149.35 world stage 1: survivors live on their own — they move, take from
+## the same shelves as the player, go to the shelter, meet one another, and
+## the same world gives the same history, reloaded or not.
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Trade = preload("res://scripts/trade.gd")
+const NpcLife = preload("res://scripts/npc_life.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func fresh(g, seed: int) -> void:
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+
+func days(w, n: int) -> void:
+	for d in n:
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.advance_safe(60)
+
+func places(w) -> Dictionary:
+	var out := {}
+	var people: Dictionary = Survivors.ensure(w).people
+	for id in people:
+		out[id] = "%s:%s" % [people[id].status, people[id].place]
+	return out
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	fresh(g, 12)
+	var w = g.world
+	var start := places(w)
+	days(w, 2)
+	check(places(w) == start, "while life is ordinary, nobody wanders")
+	# Into the breakdown.
+	days(w, 14)
+	var people: Dictionary = Survivors.ensure(w).people
+	var moved := 0
+	var met := 0
+	for id in people:
+		if start.has(id) and str(places(w)[id]).get_slice(":", 1) != str(start[id]).get_slice(":", 1):
+			moved += 1
+		met += people[id].get("acq", {}).size()
+	check(moved >= 3, "once the town comes apart, people move on their own (%d)" % moved)
+	check(met >= 4, "and meet one another, and remember it (%d)" % met)
+	var log: Array = Survivors.ensure(w).get("events", [])
+	check(log.any(func(e): return str(e.text).contains("避難所に入った")), "some make for the shelter")
+	check(log.any(func(e): return str(e.text).contains("棚から物資を持ち出した")), "some take from the shelves")
+
+	# What they take is gone from the shelf, and is theirs.
+	w.s.society = "emergency"
+	var site: Dictionary = w.s.district.sites["近所の空き家"]
+	site.vacant = true
+	site.food = 3.0
+	site.water = 4.0
+	var someone := ""
+	for id in people:
+		if NpcLife._roamer(str(id), people[id]):
+			someone = str(id)
+			break
+	var their: Dictionary = Trade.goods(w, someone)
+	var before_total := float(site.food) + float(their.get("food", 0.0))
+	NpcLife._forage(w, someone, people[someone], "近所の空き家")
+	check(float(site.food) + float(their.food) == before_total and float(site.food) < 3.0, "taking from a shelf moves food, it does not make it")
+
+	# Starving for ten days ends a life.
+	var q: Dictionary = people[someone]
+	var tg: Dictionary = Trade.goods(w, someone)
+	q.place = "住宅街"
+	for i in 10:
+		tg.food = 0.0
+		tg.water = 0.0
+		if str(q.status) == "alive":
+			Trade.daily(w, someone)
+		w.s.minute = int(w.s.minute) + 1440
+	check(str(q.status) == "dead" and str(q.cause) == "hunger", "ten days without food or water and they do not get up")
+
+	# Passers-by can be seen from the window.
+	for id in people:
+		if NpcLife._roamer(str(id), people[id]):
+			people[id].place = "屋外"
+			break
+	check(NpcLife.passing(w).begins_with("通り"), "someone on the street is seen from the window")
+
+	# Stage 2: what people do to one another moves real goods and is remembered.
+	var NpcBonds = load("res://scripts/npc_bonds.gd")
+	fresh(g, 12)
+	w = g.world
+	w.s.society = "emergency"
+	people = Survivors.ensure(w).people
+	var two: Array = []
+	for id in people:
+		if NpcLife._roamer(str(id), people[id]) and two.size() < 2:
+			two.append(str(id))
+	var a: String = two[0]
+	var b: String = two[1]
+	var pa: Dictionary = people[a]
+	var pb: Dictionary = people[b]
+	pa.place = "住宅街"
+	pb.place = "住宅街"
+	pa.traits.honesty = 90
+	pa.traits.loyalty = 90
+	pa.dependents = 0
+	pb.dependents = 0
+	Trade.goods(w, a).food = 9.0
+	Trade.goods(w, b).food = 0.0
+	w.s.minute = 4 * 1440 + 6 * 60   # 14:00
+	pb.tag = ""
+	NpcBonds.bond(people, a, b, int(w.s.minute)).like = 60   # friends already
+	var sum_before := float(Trade.goods(w, a).food) + float(Trade.goods(w, b).food)
+	NpcBonds.together(w, a, b, func(t, who): pass)
+	check(float(Trade.goods(w, b).food) == 1.0 and float(Trade.goods(w, a).food) + float(Trade.goods(w, b).food) == sum_before, "someone kind shares food with one who has none; nothing is made")
+	var kb: Dictionary = pb.acq[a]
+	check(int(kb.trust) > 20 and str(kb.mem[-1].what).contains("分けてくれた"), "and it is remembered, and trusted")
+	NpcBonds.together(w, a, b, func(t, who): pass)
+	check(float(Trade.goods(w, b).food) == 1.0, "one act between the same two a day")
+	# A wound bandaged by someone who cares.
+	w.s.minute += 1440
+	pb.tag = "injured"
+	pb.treated = false
+	Trade.goods(w, a).bandage = 1.0
+	NpcBonds.together(w, a, b, func(t, who): pass)
+	check(bool(pb.treated) and float(Trade.goods(w, a).bandage) == 0.0, "a wound is bandaged with a real bandage")
+	# Theft at night, by the desperate and dishonest, is remembered.
+	w.s.minute += 1440
+	w.s.minute = (int(w.s.minute) / 1440) * 1440 + 15 * 60   # 23:00
+	pa.traits.honesty = 10
+	Trade.goods(w, a).food = 0.0
+	Trade.goods(w, b).food = 5.0
+	var stolen := false
+	for i in 12:
+		w.s.minute += 1441
+		NpcBonds.together(w, a, b, func(t, who): pass)
+		if float(Trade.goods(w, a).food) > 0.0:
+			stolen = true
+			break
+	check(stolen and float(Trade.goods(w, a).food) + float(Trade.goods(w, b).food) == 5.0, "the desperate may steal in the night (nothing made or lost)")
+	# What a trusted friend says of the player changes minds.
+	pa.met = true
+	pa.trust = 90
+	pb.trust = 20
+	pb.acq[a].trust = 80
+	pb.acq[a].act_at = -100000
+	pa.acq[b].act_at = -100000
+	w.s.minute += 1440
+	NpcBonds.together(w, a, b, func(t, who): pass)
+	check(int(pb.trust) > 20 and bool(pb.get("heard_of_player", false)), "a friend's good word about the player travels")
+
+	# The same seed makes the same history; a save in the middle changes nothing.
+	fresh(g, 21)
+	days(g.world, 12)
+	var straight := places(g.world)
+	var straight_log := JSON.stringify(Survivors.ensure(g.world).get("events", []))
+	fresh(g, 21)
+	days(g.world, 6)
+	g._save()
+	g._load()
+	days(g.world, 6)
+	check(places(g.world) == straight, "a world reloaded midway goes on exactly as one left running")
+	check(JSON.stringify(Survivors.ensure(g.world).get("events", [])) == straight_log, "and its history is the same")
+	print("v149.35 npc life checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
