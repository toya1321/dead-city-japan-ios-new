+	var hist_n: int = w.s.survivors.history.size()
+	Residents._news(w, "raid", ta, "同じうわさ")
+	Residents._news(w, "raid", ta, "同じうわさ")
+	check(w.s.survivors.history.size() == hist_n + 1, "the same rumour is not repeated the same day")
+	# A wanderer from the town knows what became of their street.
+	var wid: String = Wand.id_of("南の住宅街", lone)
+	w.s.survivors.people[wid].status = "alive"
+	w.s.survivors.history.append({"day": 1, "at": 0, "kind": "death", "place": "南の住宅街", "text": "南の住宅街のうわさ", "ref": "", "known": false})
+	check(load("res://scripts/town_news.gd").from_person(w, wid).contains("南の住宅街のうわさ"), "a wanderer tells what became of their old street")
+	# Saved and loaded.
+	check(Residents.valid(w.s.residents) and w.validate_state(w.s.duplicate(true)), "the residents' state saves and loads")
+	print("TOTAL FAILURES ", failures)
+	quit(1 if failures > 0 else 0)
