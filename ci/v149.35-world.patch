+	elif share > 0.4:
+		lines.append("どの家も雨戸やカーテンを閉め切っている。それでも、中に人の気配がする。")
+	else:
+		lines.append("空き家になった家が増えた。ところどころ、閉め切った窓の奥に人の気配がする。")
+	for o in world.s.residents.get("out", []):
+		if str(o[1]) == place and hour >= int(o[2]) and hour < int(o[3]):
+			lines.append("リュックを背負った住人が、あたりをうかがいながら足早に通り過ぎていった。")
+			break
+	return " ".join(lines)
+
+# ---------------------------------------------------------------- at the door
+
+static func door_text(world, area: String, i: int) -> String:
+	var r := row(world, area, i)
+	var w := who(world, area, i)
+	var hour := int(world.hour_of_day())
+	var lines: Array = ["表札に「%s」とある。" % w.surname]
+	match str(r[P_PATH]):
+		"home":
+			lines.append("中からテレビの音がする。")
+		"holed":
+			if hour < 6 or hour >= 18:
+				lines.append("ドアの下の隙間から、かすかに明かりが漏れている。")
+			else:
+				lines.append("ドアの向こうで、人が動く気配がした。")
+	lines.append("（「ノックする」で声をかけられる。「ドアをこじ開ける」で押し入ることもできる）")
+	return " ".join(lines)
+
+## A knock. What answers depends on who they are, how they are doing, and
+## what they know of the player.
+static func knock(world, area: String, i: int) -> String:
+	var said := _knock(world, area, i)
+	if world.s.get("inside") is Dictionary and not world.s.inside.is_empty():
+		world.s.inside.answered = not (said.contains("返事はない") or said.contains("帰れ") or said.contains("開けない方がいい"))
+	return said
+
+static func _knock(world, area: String, i: int) -> String:
+	var r := row(world, area, i)
+	world.advance_safe(2)
+	if r.is_empty():
+		return "返事はない。"
+	match str(r[P_PATH]):
+		"turned":
+			return "ノックすると、ドアの向こうで何かが重くぶつかる音がした。うめくような声。……開けない方がいい。" if int(r[P_FLAGS]) & F_INSIDE else "返事はない。"
+		"dead", "away", "gone", "shelter", "wander", "looter":
+			return "何度かノックしたが、返事はない。"
+	var w := who(world, area, i)
+	var n := living(r)
+	var flags := int(r[P_FLAGS])
+	r[P_FLAGS] = flags | F_KNOCKED
+	var lead: Dictionary = {}
+	for k in w.people.size():
+		if int(r[P_ALIVE]) & (1 << k) and str(w.people[k].band) != "child":
+			lead = w.people[k]
+			break
+	if lead.is_empty():
+		return "ドアの向こうで、子どもの小さな声がした。「……だれ？」　それきり、何も言わない。"
+	var name := "%sさん" % w.surname
+	if flags & F_HOSTILE:
+		return "ドアの向こうから怒鳴り声がした。「帰れ！　次に来たら容赦しない！」"
+	if flags & F_ROBBED:
+		return "ノックの音に、中で誰かが息をのむ気配がした。……返事はない。"
+	var society := str(world.s.get("society", "normal"))
+	if str(r[P_PATH]) == "home":
+		match society:
+			"normal":
+				return "%s（%s）がドアを開けた。「はい？　……何か御用ですか」　ごく普通の、平日の顔だった。" % [name, w.family]
+			"alert":
+				return "%sがチェーンをかけたまま、ドアを少しだけ開けた。「物騒ですね。うちはしばらく家にこもるつもりです。……お互い気をつけましょう」" % name
+	# Holed up: whether they answer at all.
+	var trust := int(w.kindness) - int(w.caution) / 2 + (30 if flags & F_FRIEND else 0)
+	if trust < 0 and not flags & F_FRIEND:
+		return "ノックしたが、返事はない。中で誰かが息をひそめている気配がする。"
+	var food := float(r[P_FOOD])
+	if food < 2.0 * n:
+		var kids: bool = w.people.filter(func(p): return str(p.band) == "child").size() > 0
+		return "ドア越しに、%sのかすれた声がした。「すみません……食べる物、少しでも分けてもらえませんか。%s」（「食料を分ける」で渡せる）" % [name, "子どもがいるんです" if kids else "もう何日も、ろくに食べていなくて"]
+	if int(w.kindness) >= 65 and food >= 6.0 * n and not flags & F_GAVE:
+		var bag: Dictionary = world.s.district.bag
+		if float(bag.food) + 1.0 <= District.FOOD_LIMIT:
+			r[P_FOOD] = food - 1.0
+			r[P_FLAGS] = int(r[P_FLAGS]) | F_GAVE
+			bag.food = float(bag.food) + 1.0
+			return "ドアの向こうで%sが少し迷ってから、隙間から缶詰をひとつ差し出してくれた。「これくらいしかできませんけど……気をつけて」（食料1人日分）" % name
+	var Shelter = load("res://scripts/shelter.gd")
+	var news := "「外はどうなってますか。うちはまだ、なんとかやってます」"
+	if Shelter.is_open(world):
+		var full: bool = int(Shelter.state(world).get("pop", 0)) >= Shelter.capacity(world) - 10
+		news = "「避難所は人でいっぱいだって聞きました。うちはここで頑張ります」" if full else "「避難所に行こうか迷ったんですけど……うちは、ここで頑張ります」"
+	elif str(Shelter.state(world).get("status", "school")) in ["overrun", "abandoned"]:
+		news = "「避難所、もうだめになったって本当ですか。……うちは、ここにいるしかないんです」"
+	return "ドアの向こうから%sの声がした。%s" % [name, news]
+
+## Food handed through the door: remembered.
+static func give_food(world, area: String, i: int) -> String:
+	var r := row(world, area, i)
+	if r.is_empty() or not str(r[P_PATH]) in ["home", "holed"] or living(r) == 0:
+		return "渡す相手がいない。"
+	var bag: Dictionary = world.s.district.bag
+	if float(bag.food) < 1.0:
+		return "持ち歩いている食料がない。"
+	var answered: bool = world.s.get("inside") is Dictionary and bool(world.s.inside.get("answered", false))
+	if int(r[P_FLAGS]) & F_HOSTILE:
+		return "このドアの向こうの人は、もうこちらから何も受け取らないだろう。"
+	bag.food = float(bag.food) - 1.0
+	r[P_FOOD] = float(r[P_FOOD]) + 1.0
+	r[P_HUNGRY] = 0
+	r[P_FLAGS] = int(r[P_FLAGS]) | F_FRIEND
+	world.advance_safe(2)
+	var w := who(world, area, i)
+	_news(world, "kindness", area, "%sの%sさんの家に、誰かが食べ物を分けてくれたらしい。" % [_where(area, i), w.surname])
+	if not answered:
+		return "ドアの前に食料を置いて、少し離れた。しばらくして、ドアが細く開き、誰かの手が食料を引き込んだ。……小さく「ありがとう」と聞こえた気がした。"
+	return "ドアの隙間から食料を渡した。%sさんが、何度も頭を下げた。「ありがとうございます……このご恩は忘れません」" % w.surname
+
+## Breaking into a lived-in home. While the police still answer calls, no;
+## after that, it depends on who is behind the door.
+static func break_in(world, area: String, i: int) -> String:
+	var society := str(world.s.get("society", "normal"))
+	if society in ["normal", "alert"]:
+		return "中に人がいる。今押し入れば、すぐに通報されるだけだ。"
+	var r := row(world, area, i)
+	var w := who(world, area, i)
+	var name := "%sさん" % w.surname
+	Walkers.make_noise(world, area, 60)
+	world.advance_safe(5)
+	var fighter := false
+	var kids := false
+	for k in w.people.size():
+		if int(r[P_ALIVE]) & (1 << k):
+			if bool(w.people[k].able) and (int(w.courage) >= 55 or w.people.any(func(p): return str(p.band) == "child")):
+				fighter = true
+			if str(w.people[k].band) == "child":
+				kids = true
+	if fighter:
+		r[P_FLAGS] = int(r[P_FLAGS]) | F_HOSTILE
+		var hurt := 8.0 + float(_roll(world, area, i, int(world.s.minute), "hurt", 15))
+		world.s.health = maxf(1.0, float(world.s.health) - hurt)
+		_news(world, "robbery", area, "%sの%sさんの家に、誰かが押し入ろうとして追い返されたらしい。" % [_where(area, i), w.surname])
+		world.s.inside = {}
+		return "錠が外れた瞬間、中から%sが飛び出してきた。%s 振り回された何かが肩に当たり、階段まで押し戻された。ドアがまた閉ざされ、内側から何かを積み上げる音がする。" % [name, "「子どもに手を出すな！」" if kids else "「出ていけ！」"]
+	var bag: Dictionary = world.s.district.bag
+	var take := minf(float(r[P_FOOD]), District.FOOD_LIMIT - float(bag.food))
+	r[P_FOOD] = float(r[P_FOOD]) - take
+	bag.food = float(bag.food) + take
+	r[P_FLAGS] = int(r[P_FLAGS]) | F_ROBBED
+	_news(world, "robbery", area, "%sの%sさんの家に強盗が入り、食べ物を奪っていったらしい。" % [_where(area, i), w.surname])
+	world.s.inside = {}
+	var plea := "奥で子どもが泣いている。" if kids else ("「お願いです、これしかないんです……」と、%sが震える声で言った。" % name)
+	if take <= 0.0:
+		return "ドアを押し開けると、部屋の隅に%sがうずくまっていた。%s 台所の戸棚は、もう空っぽだった。" % [name, plea]
+	return "ドアを押し開けると、部屋の隅に%sがうずくまっていた。%s 台所の戸棚から、食料を%.0f人日分持ち出した。" % [name, plea, take]
