diff --git a/scripts/cards_shichinarabe.gd b/scripts/cards_shichinarabe.gd
new file mode 100644
index 0000000..a2ae487
--- /dev/null
+++ b/scripts/cards_shichinarabe.gd
@@ -0,0 +1,148 @@
+extends RefCounted
+## v149.35: 七並べ. 52 cards, all dealt; the 7s go down first. In turn, play
+## a card next to the row of its suit (6, then 5… or 8, then 9…). You may
+## pass three times; the fourth is ドボン — your cards go on the table and you
+## are out. First to empty their hand wins.
+## How they play: the mean (not kind, wary or quick-tempered) sit on cards
+## that would open the way for others and pass on purpose; the kind open the
+## way; a child plays anything. Seat 0 is you.
+
+const Cards = preload("res://scripts/cards.gd")
+const PASSES := 3
+
+static func start(seats: int, rng: RandomNumberGenerator) -> Dictionary:
+	var state := Cards.base_state("shichinarabe", seats)
+	var deck := Cards.shuffled(Cards.deck(0), rng)
+	for k in deck.size():
+		state.hands[k % seats].append(deck[k])
+	state.table = {}
+	for s in Cards.SUITS:
+		state.table[s] = []
+	state.passes = []
+	state.busted = []
+	for i in seats:
+		state.passes.append(0)
+	for i in seats:
+		for c in state.hands[i].duplicate():
+			if Cards.rank(c) == "7":
+				state.hands[i].erase(c)
+				state.table[Cards.suit(c)].append(7)
+				if c == "D7":
+					state.turn = i
+		_sort(state.hands[i])
+	for i in seats:
+		if state.hands[i].is_empty():
+			Cards.finish_seat(state, i)
+	if bool(state.out[int(state.turn)]):
+		state.turn = Cards.next_seat(state, int(state.turn))
+	return state
+
+static func _sort(hand: Array) -> void:
+	hand.sort_custom(func(a, b): return Cards.SUITS.find(Cards.suit(a)) * 20 + Cards.number(a) < Cards.SUITS.find(Cards.suit(b)) * 20 + Cards.number(b))
+
+static func placed(state: Dictionary, card: String) -> bool:
+	return Cards.number(card) in state.table[Cards.suit(card)]
+
+static func playable(state: Dictionary, card: String) -> bool:
+	if placed(state, card):
+		return false
+	var n := Cards.number(card)
+	var row: Array = state.table[Cards.suit(card)]
+	return (n < 7 and (n + 1) in row) or (n > 7 and (n - 1) in row)
+
+static func options(state: Dictionary, i: int) -> Array:
+	return state.hands[i].filter(func(c): return playable(state, c))
+
+static func play(state: Dictionary, i: int, card: String) -> bool:
+	if bool(state.done) or int(state.turn) != i or not card in state.hands[i] or not playable(state, card):
+		return false
+	state.hands[i].erase(card)
+	state.table[Cards.suit(card)].append(Cards.number(card))
+	state.last = {"by": i, "card": card, "pass": false}
+	if state.hands[i].is_empty():
+		Cards.finish_seat(state, i)
+	_after(state, i)
+	return true
+
+## Pass (the fourth time: ドボン).
+static func pass_turn(state: Dictionary, i: int) -> bool:
+	if bool(state.done) or int(state.turn) != i:
+		return false
+	state.passes[i] = int(state.passes[i]) + 1
+	state.last = {"by": i, "card": "", "pass": true}
+	if int(state.passes[i]) > PASSES:
+		for c in state.hands[i]:
+			state.table[Cards.suit(c)].append(Cards.number(c))
+		state.hands[i] = []
+		state.out[i] = true
+		state.busted.append(i)
+		state.say.append([i, "bust"])
+	_after(state, i)
+	return true
+
+static func _after(state: Dictionary, i: int) -> void:
+	var left := Cards.active(state)
+	if left.size() <= 1:
+		if left.size() == 1:
+			state.out[left[0]] = true
+			state.ranking.append(left[0])
+		# The busted come last, the first to go down at the very bottom.
+		for k in range(state.busted.size() - 1, -1, -1):
+			state.ranking.append(state.busted[k])
+		state.done = true
+		return
+	state.turn = Cards.next_seat(state, i)
+
+## How many of seat i's own cards a play opens up behind it (in that direction).
+static func _own_follow(state: Dictionary, i: int, card: String) -> int:
+	var n := Cards.number(card)
+	var s := Cards.suit(card)
+	var step := -1 if n < 7 else 1
+	var count := 0
+	var k := n + step
+	while k >= 1 and k <= 13:
+		if (s + Cards.RANKS[k - 1]) in state.hands[i]:
+			count += 1
+		k += step
+	return count
+
+static func ai(state: Dictionary, i: int, profs: Array, rng: RandomNumberGenerator) -> void:
+	var prof: Dictionary = profs[i]
+	var opts := options(state, i)
+	if opts.is_empty():
+		var busting: bool = int(state.passes[i]) >= PASSES
+		pass_turn(state, i)
+		if not busting and rng.randf() < 0.4:
+			state.say.append([i, "forced_pass"])
+		return
+	if str(prof.style) == "child":
+		play(state, i, opts[rng.randi_range(0, opts.size() - 1)])
+		return
+	var scored: Array = []
+	for c in opts:
+		var mine := _own_follow(state, i, c)
+		# An end card (A or K) opens nothing for anyone.
+		var opens := 0 if Cards.number(c) in [1, 13] else 1
+		var v := float(mine) * 2.0
+		if bool(prof.mean):
+			v -= float(opens) * (3.0 if mine == 0 else 0.5)
+		elif str(prof.style) == "gentle":
+			v += float(opens) * 2.0
+		v += rng.randf_range(-1.0, 1.0) * (1.0 - float(prof.skill)) * 3.0
+		scored.append([v, c])
+	scored.sort_custom(func(a, b): return a[0] > b[0])
+	# The mean hold on and pass, while they can afford to.
+	if bool(prof.mean) and float(scored[0][0]) < 0.0 and int(state.passes[i]) < PASSES - 1 and rng.randf() < 0.75:
+		pass_turn(state, i)
+		state.say.append([i, "block"])
+		return
+	play(state, i, str(scored[0][1]))
+	if str(prof.style) == "gentle" and rng.randf() < 0.2:
+		state.say.append([i, "open"])
+
+static func summary(state: Dictionary, names: Array) -> String:
+	var first: int = state.ranking[0]
+	var bust := ""
+	if not state.busted.is_empty():
+		bust = "、%sはドボンした" % "と".join(state.busted.map(func(b): return names[b]))
+	return "一番に出し切ったのは%s%s" % [names[first], bust]
