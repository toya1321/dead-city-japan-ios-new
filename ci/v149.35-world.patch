+extends RefCounted
+## v149.35: reversi with a housemate. The rules, and how each housemate plays:
+## the way they play comes from who they are.
+##   bold / quick-tempered → grabs as many discs as it can (greedy)
+##   wary                   → corners, edges, leaves you few moves (careful)
+##   kind (and ahead)       → eases off so you can catch up (gentle)
+##   a child                → plays for the fun of flipping lots, often loosely
+##   otherwise              → plain positional play
+## How strong they are comes from age and work (a child is loose, a teacher
+## or an office worker reads ahead). A housemate who is not very honest may
+## ask for a take-back once, after you seize a corner ("待った"); one with a
+## temper sulks when losing and wants a rematch.
+## board: Array of 64 ints — 0 empty, 1 black (you, first), 2 white (them).
+
+const EMPTY := 0
+const BLACK := 1
+const WHITE := 2
+const DIRS := [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1), Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)]
+const CORNERS := [0, 7, 56, 63]
+## Classic square weights: corners prized, the squares next to them feared.
+const WEIGHTS := [
+	100, -20, 10, 5, 5, 10, -20, 100,
+	-20, -40, -2, -2, -2, -2, -40, -20,
+	10, -2, 1, 1, 1, 1, -2, 10,
+	5, -2, 1, 0, 0, 1, -2, 5,
+	5, -2, 1, 0, 0, 1, -2, 5,
+	10, -2, 1, 1, 1, 1, -2, 10,
+	-20, -40, -2, -2, -2, -2, -40, -20,
+	100, -20, 10, 5, 5, 10, -20, 100,
+]
+
+static func new_board() -> Array:
+	var b: Array = []
+	b.resize(64)
+	b.fill(EMPTY)
+	b[27] = WHITE
+	b[28] = BLACK
+	b[35] = BLACK
+	b[36] = WHITE
+	return b
+
+static func other(side: int) -> int:
+	return WHITE if side == BLACK else BLACK
+
+## The discs this move would turn (empty if the move is not allowed).
+static func flips(board: Array, cell: int, side: int) -> Array:
+	var out: Array = []
+	if cell < 0 or cell > 63 or int(board[cell]) != EMPTY:
+		return out
+	var x := cell % 8
+	var y := cell / 8
+	for d in DIRS:
+		var run: Array = []
+		var cx: int = x + d.x
+		var cy: int = y + d.y
+		while cx >= 0 and cx < 8 and cy >= 0 and cy < 8 and int(board[cy * 8 + cx]) == other(side):
+			run.append(cy * 8 + cx)
+			cx += d.x
+			cy += d.y
+		if not run.is_empty() and cx >= 0 and cx < 8 and cy >= 0 and cy < 8 and int(board[cy * 8 + cx]) == side:
+			out.append_array(run)
+	return out
+
+static func moves(board: Array, side: int) -> Array:
+	var out: Array = []
+	for cell in 64:
+		if int(board[cell]) == EMPTY and not flips(board, cell, side).is_empty():
+			out.append(cell)
+	return out
+
+## A new board with the move played (the original is left as it was).
+static func play(board: Array, cell: int, side: int) -> Array:
+	var b := board.duplicate()
+	var turned := flips(board, cell, side)
+	if turned.is_empty():
+		return b
+	b[cell] = side
+	for c in turned:
+		b[c] = side
+	return b
+
+static func count(board: Array, side: int) -> int:
+	var n := 0
+	for v in board:
+		if int(v) == side:
+			n += 1
+	return n
+
+static func over(board: Array) -> bool:
+	return moves(board, BLACK).is_empty() and moves(board, WHITE).is_empty()
+
+# --- Who they are at the board -------------------------------------------
+
+## How a housemate plays: {style, skill (0..1), honest, temper, kind, polite,
+## first_person, child}. From the survivor they were, or (a housemate from the
+## start) from a stable roll on their name.
+static func profile(world, mate: Dictionary) -> Dictionary:
+	var t: Dictionary = {}
+	var kind := -1
+	var survivors: Variant = world.s.get("survivors")
+	var sid := str(mate.get("survivor", ""))
+	if survivors is Dictionary and survivors.get("people", {}).has(sid):
+		var p: Dictionary = survivors.people[sid]
+		t = p.get("traits", {})
+		kind = int(p.get("kindness", -1))
+	var rng := RandomNumberGenerator.new()
+	rng.seed = hash([str(mate.get("name", "")), "reversi"])
+	for key in ["courage", "temper", "loyalty", "suspicion", "honesty"]:
+		if not t.has(key):
+			t[key] = rng.randi_range(20, 80)
+	if mate.has("honesty"):
+		t.honesty = int(mate.honesty)
+	if kind < 0:
+		kind = int(t.get("loyalty", 50))
+	var age := int(mate.get("age", 30))
+	var job := str(mate.get("job", ""))
+	var skill := 0.5 + rng.randf_range(-0.1, 0.1)
+	if age < 10:
+		skill = 0.12
+	elif age < 15:
+		skill = 0.32
+	elif job in ["教師", "会社員", "薬剤師", "看護師", "医師", "エンジニア", "大学生", "公務員"]:
+		skill += 0.2
+	elif age >= 65:
+		skill += 0.12
+	var style := "steady"
+	if age < 13:
+		style = "child"
+	elif int(t.courage) >= 65 or int(t.temper) >= 65:
+		style = "greedy"
+	elif int(t.suspicion) >= 60:
+		style = "careful"
+	elif kind >= 70:
+		style = "gentle"
+	var speech: Dictionary = mate.get("speech", {}) if mate.get("speech") is Dictionary else {}
+	return {"style": style, "skill": clampf(skill, 0.05, 0.95), "honest": int(t.honesty), "temper": int(t.temper),
+		"kind": kind, "polite": bool(speech.get("polite", false)), "child": age < 13,
+		"first_person": str(speech.get("first_person", "私" if age >= 13 else "ぼく"))}
+
+## A rough worth of a board for `side` in this player's eyes.
+static func _value(board: Array, side: int, prof: Dictionary) -> float:
+	var style := str(prof.style)
+	var mine := 0.0
+	var theirs := 0.0
+	for cell in 64:
+		var v := int(board[cell])
+		if v == side:
+			mine += WEIGHTS[cell]
+		elif v == other(side):
+			theirs += WEIGHTS[cell]
+	var pos := mine - theirs
+	var discs := float(count(board, side) - count(board, other(side)))
+	var mob := float(moves(board, side).size() - moves(board, other(side)).size())
+	match style:
+		"greedy":
+			return discs * 4.0 + pos * 0.4 + mob * 1.0
+		"careful":
+			return pos * 1.2 + mob * 6.0 + discs * 0.3
+		"child":
+			return discs * 3.0 + pos * 0.1
+	return pos * 1.0 + mob * 3.0 + discs * 0.6
+
+## Their move (or -1 to pass). `rng` decides how loosely they play.
+static func choose(board: Array, side: int, prof: Dictionary, rng: RandomNumberGenerator, exclude: int = -1) -> int:
+	var options := moves(board, side)
+	if exclude >= 0 and options.size() > 1:
+		options.erase(exclude)
+	if options.is_empty():
+		return -1
+	var skill := float(prof.skill)
+	var scored: Array = []
+	for cell in options:
+		var after := play(board, cell, side)
+		var v := _value(after, side, prof)
+		# Reading ahead: the strong expect your best answer.
+		if skill >= 0.6:
+			var replies := moves(after, other(side))
+			if not replies.is_empty():
+				var worst := INF
+				for r in replies:
+					worst = minf(worst, _value(play(after, r, other(side)), side, prof))
+				v = worst
+		v += rng.randf_range(-1.0, 1.0) * (1.0 - skill) * 60.0
+		scored.append([v, cell])
+	scored.sort_custom(func(a, b): return a[0] > b[0])
+	# The kind, when well ahead, take a modest move and let you back in.
+	if str(prof.style) == "gentle" and count(board, side) - count(board, other(side)) >= 8 and scored.size() >= 3:
+		return int(scored[scored.size() / 2][1])
+	return int(scored[0][1])
+
+# --- What they say --------------------------------------------------------
+
+const LINES := {
+	"start": {"casual": ["よし、やろうか。手加減しないよ", "リバーシか、久しぶりだな", "先に打っていいよ"], "polite": ["よろしくお願いします。先にどうぞ", "久しぶりです、こういうの", "お手柔らかにお願いしますね"], "child": ["やったー！ ぼく、白ね！", "負けないもんね！"]},
+	"they_corner": {"casual": ["角、もらった", "ここはいただき", "へへ、角だ"], "polite": ["角、いただきますね", "失礼して、ここに"], "child": ["かどー！ ぼくの！"]},
+	"you_corner": {"casual": ["あっ、そこか……", "うわ、角取られた", "やるなあ"], "polite": ["あっ……そこでしたか", "さすがですね"], "child": ["あー！ ずるい！"]},
+	"they_ahead": {"casual": ["いい流れだな", "このまま行けそうだ"], "polite": ["今日は調子がいいみたいです"], "child": ["ぼくのほうが多い！"]},
+	"they_behind": {"casual": ["うーん、まずいな", "ちょっと考えさせて"], "polite": ["困りましたね……", "うーん、どうしましょう"], "child": ["むー……"]},
+	"sulk": {"casual": ["……今のなし、とは言わないけどさ", "くそっ、もう一回だ、もう一回"], "polite": ["……ちょっと、悔しいですね"], "child": ["もうやだ！……うそ、もう一回！"]},
+	"gentle": {"casual": ["ほら、そこ空いてるよ", "急がなくていいからね"], "polite": ["ゆっくり考えてくださいね"], "child": ["ここ、置けるよ"]},
+	"they_pass": {"casual": ["置くとこないや。パス"], "polite": ["打てる所がありません。パスです"], "child": ["おけないー。パス！"]},
+	"you_pass": {"casual": ["そっちは置けないね。もう一回打つよ"], "polite": ["打てる所がないようですね。続けて打ちます"], "child": ["おけないの？ じゃあぼくね！"]},
+	"wait_ask": {"casual": ["あっ、待った！ 今のなし、なしで！", "ちょ、待った！ さっきの手、打ち直させて"], "polite": ["あの……待った、していいですか。さっきの手、間違えました"], "child": ["まったー！ いまのなし！"]},
+	"wait_yes": {"casual": ["悪いな、助かる", "へへ、ありがと"], "polite": ["すみません、ありがとうございます"], "child": ["やったー！"]},
+	"wait_no": {"casual": ["ちぇっ。わかったよ", "ケチだなあ"], "polite": ["……そうですよね。失礼しました"], "child": ["ぶー"]},
+	"they_win": {"casual": ["よし、勝ち！ またやろう", "ふう、勝った。いい勝負だった"], "polite": ["勝たせてもらいました。楽しかったです", "ありがとうございました。またぜひ"], "child": ["かったー！ もう一回やろ！"]},
+	"they_lose": {"casual": ["負けた！ 強いな", "参った。次は負けないぞ"], "polite": ["負けました。お強いですね", "参りました。楽しかったです"], "child": ["まけたー……。でもたのしかった！"]},
+	"they_lose_sore": {"casual": ["……もう一回だ。今のは調子が悪かっただけだ", "くそっ。次は絶対勝つ"], "polite": ["……次は、負けませんから"], "child": ["もう一回！ もう一回やる！"]},
+	"draw": {"casual": ["引き分けか。そんなこともあるな"], "polite": ["引き分けですね。いい勝負でした"], "child": ["おんなじ！ すごい！"]},
+}
+
+static func line(prof: Dictionary, situation: String, rng: RandomNumberGenerator) -> String:
+	var set: Dictionary = LINES.get(situation, {})
+	var voice := "child" if bool(prof.child) else ("polite" if bool(prof.polite) else "casual")
+	var pool: Array = set.get(voice, set.get("casual", []))
+	if pool.is_empty():
+		return ""
+	return str(pool[rng.randi_range(0, pool.size() - 1)])
+
+## A short word on how they play, for the narration.
+static func manner(prof: Dictionary) -> String:
+	match str(prof.style):
+		"greedy":
+			return "一度にたくさん返せる手ばかり選んで、盤面をにぎやかにした"
+		"careful":
+			return "角と端をじっくり狙い、こちらの打てる所を少しずつ減らしてきた"
+		"gentle":
+			return "差がつくと、わざと緩い手を打ってくれているようだった"
+		"child":
+			return "石がひっくり返るたびに声を上げて喜んだ"
+	return "落ち着いて、堅実に打ってきた"
