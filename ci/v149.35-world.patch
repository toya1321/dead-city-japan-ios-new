+const WATER_PER_HOME := 4.0
+
+static func kind(place: String) -> String:
+	return str(PLACES.get(place, {}).get("kind", ""))
+
+static func links() -> Dictionary:
+	var out := {}
+	for place in PLACES:
+		for other in PLACES[place].links:
+			if not out.has(place):
+				out[place] = []
+			if not out.has(other):
+				out[other] = []
+			if not other in out[place]:
+				out[place].append(other)
+			if not place in out[other]:
+				out[other].append(place)
+	return out
+
+static func outdoor() -> Array:
+	return PLACES.keys().filter(func(p): return str(PLACES[p].kind) in ["street", "houses", "land"])
+
+static func buildings() -> Array:
+	return PLACES.keys().filter(func(p): return str(PLACES[p].kind) == "site")
+
+static func houses() -> Array:
+	return PLACES.keys().filter(func(p): return str(PLACES[p].kind) == "houses")
+
+## District entries for the buildings here (merged into District.SITES).
+static func sites() -> Dictionary:
+	var out := {}
+	for place in buildings():
+		var d: Dictionary = PLACES[place]
+		out[place] = {"food": float(d.get("food", 0.0)), "water": float(d.get("water", 0.0)), "vacant": bool(d.get("vacant", true)), "opens": int(d.get("opens", 0)), "closes": int(d.get("closes", 24)), "position": d.pos}
+	return out
+
+static func aliases() -> Dictionary:
+	var out := {}
+	for place in PLACES:
+		out[place] = place
+		for a in PLACES[place].get("aliases", []):
+			out[str(a)] = place
+	return out
+
+static func text(place: String, phase: String) -> String:
+	var t: Dictionary = PLACES.get(place, {}).get("text", {})
+	return str(t.get(phase, t.get("normal", "")))
