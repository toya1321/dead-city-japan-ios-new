diff --git a/tests/test_residents149_38.gd b/tests/test_residents149_38.gd
new file mode 100644
index 0000000..5a14580
--- /dev/null
+++ b/tests/test_residents149_38.gd
@@ -0,0 +1,146 @@
+extends SceneTree
+## v149.38: the town's households live their own lives — every home has its
+## family from the seed; each morning they decide (stay, stock up, leave town,
+## the shelter, hole up); holed-up homes eat, go out, are bitten, starve; the
+## player meets them at the door (knock, give, break in) and in the signs on
+## the street. The same seed gives the same town.
+const Main = preload("res://main.tscn")
+const Residents = preload("res://scripts/residents.gd")
+const Dwellings = preload("res://scripts/dwellings.gd")
+const District = preload("res://scripts/district.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func new_game(seed: int):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+func days(w, n: int) -> void:
+	for d in n:
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.advance_safe(60)
+func run() -> void:
+	var g = await new_game(11)
+	var w = g.world
+	days(w, 1)
+	var c: Dictionary = Residents.census(w)
+	check(Residents.ready(w) and c.home == 790, "every one of the town's 790 homes has its household: %s" % c)
+	check(int(c.people) > 1000, "well over a thousand people live in them (%d)" % int(c.people))
+	var who: Dictionary = Residents.who(w, "団地", 47)
+	check(who.people.size() >= 1 and str(who.family) == str(Dwellings.home(w, "団地", 47).family), "the household is the family the home shows")
+	# Same seed, same town.
+	var g2 = await new_game(11)
+	days(g2.world, 1)
+	check(JSON.stringify(w.s.residents.hh) == JSON.stringify(g2.world.s.residents.hh), "the same seed gives the same households")
+	g2.queue_free()
+	# The outbreak: some leave town while they can; then the shelter or the door locked.
+	while str(w.s.society) in ["normal", "alert"] and int(w.s.minute) < 20 * 1440:
+		days(w, 1)
+	days(w, 2)
+	c = Residents.census(w)
+	check(int(c.away) > 0, "some families left town for relatives (%d)" % int(c.away))
+	check(int(c.holed) > 300 and int(c.shelter) > 0 and int(c.home) == 0, "once it breaks down, they hole up or go to the shelter: %s" % c)
+	check(int(w.s.shelter.get("pop", 0)) > 0, "the shelter fills with the town's own people")
+	# Stage 2: the shelter is the town's own people and those from elsewhere.
+	var sh: Dictionary = w.s.shelter
+	var ours: int = Residents.in_shelter(w)
+	check(ours > 0 and int(sh.pop) == int(sh.outsiders) + ours, "the shelter's count is its residents and outsiders together (%d = %d + %d)" % [int(sh.pop), int(sh.outsiders), ours])
+	g.location = "避難所"
+	g._sync_player_position()
+	var report: String = load("res://scripts/shelter.gd").report(w)
+	check(report.contains("さん"), "the town's families are seen there by name: " + report.right(80))
+	check(load("res://scripts/shelter.gd").board(w).contains("家族は体育館にいます"), "and leave notes on the board")
+	w.s.survivors.history.append({"day": 1, "at": 0, "kind": "death", "place": "団地", "text": "テストのうわさ", "ref": "", "known": false})
+	var n_log: int = g.log_entries.size()
+	await g._on_command("話を聞く")
+	var said := "\n".join(g.log_entries.slice(n_log))
+	check(said.contains("テストのうわさ") and bool(w.s.survivors.history[-1].known), "the shelter is where the news is heard: " + said.left(200))
+	var before_ours: int = Residents.in_shelter(w)
+	sh.sick = 0
+	var out_before := int(sh.outsiders)
+	var lost: int = Residents.shelter_casualties(w, 200, 0, 1)
+	check(lost > 0 and Residents.in_shelter(w) == before_ours - lost, "those taken out of the gym in the night may be the town's own")
+	load("res://scripts/shelter.gd")._leave(w, sh, 100)
+	check(Residents.in_shelter(w) == 0 and int(sh.pop) == 0, "when people leave, the households go home")
+	# At an occupied door.
+	g.location = "団地"
+	g._sync_player_position()
+	var occ := -1
+	for i in Dwellings.count("団地"):
+		if Residents.occupied(w, "団地", i):
+			occ = i
+			break
+	check(occ >= 0, "someone still lives in the estate")
+	var text: String = g._enter_home("団地", occ)
+	check(Dwellings.inside(w) and bool(w.s.inside.get("occupied", false)) and text.contains("表札"), "an occupied home is a door, not a home to search: " + text.left(80))
+	check(g._suggestions().has("ノックする"), "you can knock")
+	await g._on_command("ノックする")
+	check(not g.log_entries[-1].is_empty(), "the knock is answered (or not): " + str(g.log_entries[-1]).left(80))
+	var r: Array = Residents.row(w, "団地", occ)
+	r[Residents.P_FOOD] = 0.5
+	w.s.district.bag.food = 2.0
+	await g._on_command("ノックする")
+	check(str(g.log_entries[-1]).contains("分けて") or str(g.log_entries[-1]).contains("返事はない") or str(g.log_entries[-1]).contains("息をひそめ"), "a hungry home asks for food (if it answers)")
+	await g._on_command("食料を分ける")
+	check(float(w.s.district.bag.food) == 1.0 and float(r[Residents.P_FOOD]) == 1.5 and int(r[Residents.P_FLAGS]) & Residents.F_FRIEND, "food handed through the door is remembered")
+	# Breaking in: they hand it over, or they fight back.
+	w.s.society = "emergency"
+	w.s.weapons = w.s.get("weapons", {})
+	r[Residents.P_FOOD] = 6.0
+	w.s.district.bag.food = 0.0
+	var before := float(w.s.health)
+	var robbed: String = Residents.break_in(w, "団地", occ)
+	check(robbed.contains("持ち出した") or robbed.contains("押し戻された"), "a break-in ends one way or the other: " + robbed.left(80))
+	check((float(w.s.district.bag.food) > 0.0 and int(r[Residents.P_FLAGS]) & Residents.F_ROBBED) or (float(w.s.health) < before and int(r[Residents.P_FLAGS]) & Residents.F_HOSTILE), "and is remembered")
+	check(not Residents.knock(w, "団地", occ).contains("缶詰"), "nobody gives to the one who broke in")
+	# What became of a household is what the home shows.
+	var t := -1
+	for i in Dwellings.count("南の住宅街"):
+		if not Residents.occupied(w, "南の住宅街", i):
+			continue
+		t = i
+		break
+	var tr: Array = Residents.row(w, "南の住宅街", t)
+	tr[Residents.P_TURNED] = tr[Residents.P_ALIVE]
+	tr[Residents.P_ALIVE] = 0
+	tr[Residents.P_PATH] = "turned"
+	tr[Residents.P_FLAGS] = int(tr[Residents.P_FLAGS]) | Residents.F_INSIDE
+	check(bool(Dwellings.home(w, "南の住宅街", t).walker), "a family that turned at home is still in there")
+	check(Residents.knock(w, "南の住宅街", t).contains("ぶつかる"), "and a knock tells you so")
+	# Hunger and leaving, over time.
+	var hungry: Array = []
+	for i in 10:
+		hungry.append(Residents.row(w, "北の住宅街", i))
+	for hr in hungry:
+		if str(hr[Residents.P_PATH]) == "holed":
+			hr[Residents.P_FOOD] = 0.0
+	w.s.district.houses_by["北の住宅街"] = {"food": 0.0, "water": 0.0}
+	w.s.residents.beyond = 0.0
+	for s in ["スーパー", "コンビニ", "食品店", "倉庫街", "ホームセンター", "ガソリンスタンド"]:
+		if w.s.district.sites.has(s):
+			w.s.district.sites[s].food = 0.0
+	for d in 16:
+		Residents.daily(w, 100 + d)
+	var fates := {}
+	for hr in hungry:
+		fates[str(hr[Residents.P_PATH])] = int(fates.get(str(hr[Residents.P_PATH]), 0)) + 1
+	check(int(fates.get("holed", 0)) < 10 and (int(fates.get("dead", 0)) + int(fates.get("gone", 0)) + int(fates.get("shelter", 0))) > 0, "with nothing to eat, people die, leave or go to the shelter: %s" % fates)
+	# The street shows it.
+	w.s.minute = (int(w.s.minute) / 1440) * 1440 + 21 * 60
+	var signs := Residents.signs(w, "団地")
+	check(not signs.is_empty(), "the street shows its people: " + signs.left(60))
+	# Saved and loaded.
+	check(Residents.valid(w.s.residents) and w.validate_state(w.s.duplicate(true)), "the residents' state saves and loads")
+	print("TOTAL FAILURES ", failures)
+	quit(1 if failures > 0 else 0)
