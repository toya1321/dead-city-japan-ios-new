diff --git a/scripts/communities.gd b/scripts/communities.gd
new file mode 100644
index 0000000..9ef7f24
--- /dev/null
+++ b/scripts/communities.gd
@@ -0,0 +1,434 @@
+extends RefCounted
+## v149.38 stage 3: neighbours who band together. Once the town has broken
+## down, the households still holed up in one block of the estate, one band
+## of floors in the tower, or one corner of a street of houses may come
+## together around someone who takes the lead: the stairs barricaded, the
+## food put in one store, meals cooked together, a vegetable patch dug in the
+## yard or on the roof, rain caught in buckets, a watch kept at night, and
+## the trips out made in pairs. It is how people last longer than their
+## cupboards — while it holds. Hunger, a hidden bite, or too few hands, and
+## it comes apart; the families go back to their own doors.
+##
+## The player can call on one (from the street), help, give, and — if they
+## are trusted, and have not robbed anyone there — be taken in: eat from the
+## store and sleep behind the barricade.
+##
+## s.residents.cm = {key: {area, block, since, store, water, garden, wall,
+##   trust, ended, leader: [i], last_out}}   key = "area:block"
+## A household's membership is its flag F_COMM, its community its block.
+
+const Residents = preload("res://scripts/residents.gd")
+const District = preload("res://scripts/district.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const TownMap = preload("res://scripts/town_map.gd")
+const F_COMM := 256
+
+## How a residential area divides into neighbourhoods.
+static func block_of(area: String, i: int) -> int:
+	match area:
+		"団地":
+			return i / 20
+		"駅前のマンション":
+			return i / 40
+	return i / 12
+
+static func block_name(area: String, block: int) -> String:
+	match area:
+		"団地":
+			return "団地%d号棟" % (block + 1)
+		"駅前のマンション":
+			return "駅前のマンションの%s" % ["低層階", "中層階", "高層階"][clampi(block, 0, 2)]
+	return "%s（%d〜%d番の家のあたり）" % [area, block * 12 + 1, block * 12 + 12]
+
+## How much a neighbourhood can grow: yards and gardens, the estate's open
+## ground, a tower's roof and balconies.
+static func ground(area: String) -> float:
+	match area:
+		"団地":
+			return 0.8
+		"駅前のマンション":
+			return 0.4
+	return 1.0
+
+static func all(world) -> Dictionary:
+	if not Residents.ready(world):
+		return {}
+	if not world.s.residents.get("cm") is Dictionary:
+		world.s.residents.cm = {}
+	return world.s.residents.cm
+
+static func _peek(world) -> Dictionary:
+	var st = world.s.get("residents")
+	return st.get("cm", {}) if st is Dictionary and st.get("cm") is Dictionary else {}
+
+static func of(world, area: String, i: int) -> Dictionary:
+	var r := Residents.row(world, area, i)
+	if r.is_empty() or int(r[Residents.P_FLAGS]) & F_COMM == 0:
+		return {}
+	return _peek(world).get("%s:%d" % [area, block_of(area, i)], {})
+
+static func member(r: Array) -> bool:
+	return int(r[Residents.P_FLAGS]) & F_COMM != 0
+
+static func _rows(world, area: String, block: int) -> Array:
+	var out: Array = []
+	var rows: Array = world.s.residents.hh.get(area, [])
+	var size := 20 if area == "団地" else (40 if area == "駅前のマンション" else 12)
+	for i in range(block * size, mini(rows.size(), (block + 1) * size)):
+		out.append(i)
+	return out
+
+static func members(world, c: Dictionary) -> Array:
+	var out: Array = []
+	for i in _rows(world, str(c.area), int(c.block)):
+		var r := Residents.row(world, str(c.area), i)
+		if member(r) and Residents.living(r) > 0 and str(r[Residents.P_PATH]) == "holed":
+			out.append(i)
+	return out
+
+static func mouths(world, c: Dictionary) -> int:
+	var n := 0
+	for i in members(world, c):
+		n += Residents.living(Residents.row(world, str(c.area), i))
+	if str(world.s.residents.get("player_cm", "")) == "%s:%d" % [c.area, c.block]:
+		n += 1
+	return n
+
+# ------------------------------------------------------------------ each day
+
+static func daily(world, day: int) -> void:
+	if not str(world.s.get("society", "normal")) == "emergency":
+		return
+	var cm := all(world)
+	for area in world.s.residents.hh:
+		var rows: Array = world.s.residents.hh[area]
+		var blocks := {}
+		for i in rows.size():
+			blocks[block_of(area, i)] = true
+		for block in blocks:
+			var key := "%s:%d" % [area, block]
+			var c: Dictionary = cm.get(key, {})
+			if c.is_empty() or bool(c.get("ended", false)):
+				_maybe_form(world, area, int(block), day)
+			else:
+				_join(world, c, day)
+				_live(world, c, day)
+
+## Someone with the heart for it, and enough doors still locked from inside.
+static func _maybe_form(world, area: String, block: int, day: int) -> void:
+	var holed: Array = []
+	var leader := -1
+	for i in _rows(world, area, block):
+		var r := Residents.row(world, area, i)
+		if str(r[Residents.P_PATH]) != "holed" or Residents.living(r) == 0 or int(r[Residents.P_FLAGS]) & Residents.F_HOSTILE:
+			continue
+		holed.append(i)
+		var w := Residents.who(world, area, i)
+		var able := false
+		for k in w.people.size():
+			if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+				able = true
+		if able and int(w.kindness) + int(w.courage) >= 110 and (leader < 0 or int(w.kindness) + int(w.courage) > _lead_score(world, area, leader)):
+			leader = i
+	if holed.size() < 3 or leader < 0:
+		return
+	var cm := all(world)
+	var key := "%s:%d" % [area, block]
+	var old: Dictionary = cm.get(key, {})
+	# Not straight away after the last one fell apart.
+	if not old.is_empty() and day - int(old.get("ended_day", day)) < 14:
+		return
+	if Residents._roll(world, area, leader, day, "form", 100) >= 12:
+		return
+	var c := {"area": area, "block": block, "since": day, "store": 0.0, "water": 0.0, "garden": 0.0,
+		"wall": 10.0, "trust": 0.0, "ended": false, "leader": leader, "last_out": -1, "hungry": 0}
+	cm[key] = c
+	_join(world, c, day)
+	var lw := Residents.who(world, area, leader)
+	Residents._news(world, "group_found", area, "%sで、%sさんを中心に住人たちがまとまり、一緒に暮らし始めたらしい。" % [block_name(area, block), lw.surname])
+
+static func _lead_score(world, area: String, i: int) -> int:
+	var w := Residents.who(world, area, i)
+	return int(w.kindness) + int(w.courage)
+
+## Holed-up households of the block come in; the very wary keep to themselves.
+static func _join(world, c: Dictionary, day: int) -> void:
+	var area := str(c.area)
+	for i in _rows(world, area, int(c.block)):
+		var r := Residents.row(world, area, i)
+		if member(r) or str(r[Residents.P_PATH]) != "holed" or Residents.living(r) == 0:
+			continue
+		var w := Residents.who(world, area, i)
+		if int(w.caution) >= 85 and float(r[Residents.P_FOOD]) >= 8.0 * Residents.living(r):
+			continue
+		# A family that left when food ran short does not come straight back.
+		if day - int(c.get("left", {}).get(str(i), -100)) < 14:
+			continue
+		r[Residents.P_FLAGS] = int(r[Residents.P_FLAGS]) | F_COMM
+		c.store = float(c.store) + float(r[Residents.P_FOOD])
+		c.water = float(c.water) + float(r[Residents.P_WATER])
+		r[Residents.P_FOOD] = 0.0
+		r[Residents.P_WATER] = 0.0
+
+## A day together: the garden, the rain, the wall, a trip out if the store is
+## low, then meals for all from one pot.
+static func _live(world, c: Dictionary, day: int) -> void:
+	var area := str(c.area)
+	var mem := members(world, c)
+	var n := mouths(world, c)
+	if mem.is_empty():
+		_end(world, c, day, "empty")
+		return
+	var able := 0
+	for i in mem:
+		var r := Residents.row(world, area, i)
+		var w := Residents.who(world, area, i)
+		for k in w.people.size():
+			if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+				able += 1
+	# The patch grows as hands are put to it (a few weeks to amount to much).
+	if day - int(c.since) >= 3:
+		var cap := 0.35 * float(n) * ground(area)
+		# (a patch already dug stays dug when people leave)
+		c.garden = maxf(float(c.garden), minf(cap, float(c.garden) + 0.04 * float(able) * ground(area)))
+	if day - int(c.since) >= 10:
+		# Greens do not keep: what is grown beyond a month's eating goes to waste.
+		var grown: float = float(c.garden) * load("res://scripts/crops.gd").garden_season(world)
+		c.store = maxf(float(c.store), minf(float(c.store) + grown, 30.0 * float(n)))
+	# Rain caught on the roofs and balconies; the river when it does not rain.
+	var tap := bool(world.s.get("water_online", true))
+	if not tap:
+		c.water = float(c.water) + (12.0 if str(world.s.get("weather", "")) == "rain" else 0.0)
+		if float(c.water) < 2.0 * n and able > 0:
+			c.water = float(c.water) + 16.0
+	# The barricade goes up as long as there are hands.
+	c.wall = minf(100.0, float(c.wall) + 1.5 * float(able))
+	# Supplies run out: a pair goes out together.
+	if float(c.store) < 4.0 * n and able >= 2:
+		_trip(world, c, mem, day)
+	# One pot for everyone.
+	var ration := 0.8 if float(c.store) >= 6.0 * n else 0.6
+	var need := ration * float(n)
+	var fed := float(c.store) >= need * 0.6
+	c.store = maxf(0.0, float(c.store) - need)
+	if not tap:
+		c.water = maxf(0.0, float(c.water) - 2.0 * n)
+	c.hungry = 0 if fed else int(c.get("hungry", 0)) + 1
+	for i in mem:
+		var r := Residents.row(world, area, i)
+		r[Residents.P_HUNGRY] = int(c.hungry)
+		r[Residents.P_DRY] = 0
+	# Too many mouths: some families go their own way, until the rest can be fed.
+	if int(c.hungry) >= 3 and mem.size() > 2:
+		var leaving: int = mem[Residents._roll(world, area, int(c.block), day, "cm-leave", mem.size())]
+		if leaving != int(c.leader):
+			var lr := Residents.row(world, area, leaving)
+			lr[Residents.P_FLAGS] = int(lr[Residents.P_FLAGS]) & ~F_COMM
+			lr[Residents.P_FOOD] = 0.0
+			var left: Dictionary = c.get("left", {})
+			left[str(leaving)] = day
+			c.left = left
+	if int(c.hungry) >= 10 or able == 0 and float(c.store) <= 0.0:
+		_end(world, c, day, "hunger")
+	elif mem.size() < 2 and day - int(c.since) >= 7:
+		_end(world, c, day, "few")
+
+## Two go out together: more carried home, and each watches the other's back.
+static func _trip(world, c: Dictionary, mem: Array, day: int) -> void:
+	var area := str(c.area)
+	c.last_out = day
+	var got := District.search_houses(world, 10.0, 0.0, area)
+	var place := area
+	if got.x < 2.0:
+		for p in ["スーパー", "コンビニ", "食品店", "倉庫街", "ホームセンター", "ガソリンスタンド"]:
+			if world.s.district.sites.has(p) and float(world.s.district.sites[p].food) >= 1.0:
+				var site: Dictionary = world.s.district.sites[p]
+				var take := minf(float(site.food), 10.0)
+				site.food = float(site.food) - take
+				got.x += take
+				place = p
+				break
+	if got.x < 2.0:
+		var st: Dictionary = world.s.residents
+		var beyond := float(st.get("beyond", Residents.BEYOND))
+		var take := minf(beyond, roundf(12.0 * sqrt(beyond / Residents.BEYOND)))
+		st.beyond = beyond - take
+		got.x += take
+		place = "橋"
+	c.store = float(c.store) + got.x
+	var out: Array = world.s.residents.out
+	if out.size() < 120:
+		var from := 8 + Residents._roll(world, area, int(c.block), day, "cm-hour", 6)
+		out.append([area, place, from, from + 2])
+	var walkers := Walkers.count(world, place) if world.s.has("walkers") else 0
+	if place == "橋":
+		walkers += 10
+	var risk := clampf(0.003 + 0.004 * float(walkers), 0.0, 0.25) * 0.6
+	if float(Residents._roll(world, area, int(c.block), day, "cm-risk", 10000)) / 10000.0 < risk:
+		var i: int = mem[Residents._roll(world, area, int(c.block), day, "cm-who", mem.size())]
+		var r := Residents.row(world, area, i)
+		var w := Residents.who(world, area, i)
+		for k in w.people.size():
+			if int(r[Residents.P_ALIVE]) & (1 << k) and bool(w.people[k].able):
+				r[Residents.P_BITTEN] = int(r[Residents.P_BITTEN]) | (1 << k)
+				break
+
+## A bite hidden in a household that lives with others: the night watch may
+## see it coming (residents.gd turns it; here, whether the block holds).
+static func caught_in_time(world, area: String, i: int, day: int) -> bool:
+	var c := of(world, area, i)
+	if c.is_empty():
+		return false
+	var watch := 20.0 + float(c.wall) * 0.4 + float(members(world, c).size()) * 3.0
+	return Residents._roll(world, area, i, day, "cm-watch", 100) < int(minf(watch, 85.0))
+
+static func _end(world, c: Dictionary, day: int, why: String) -> void:
+	c.ended = true
+	c.ended_day = day
+	var area := str(c.area)
+	var share := float(c.store)
+	var mem := members(world, c)
+	for i in _rows(world, area, int(c.block)):
+		var r := Residents.row(world, area, i)
+		if member(r):
+			r[Residents.P_FLAGS] = int(r[Residents.P_FLAGS]) & ~F_COMM
+			if Residents.living(r) > 0 and not mem.is_empty():
+				r[Residents.P_FOOD] = share / float(mem.size())
+	c.store = 0.0
+	var key := "%s:%d" % [c.area, c.block]
+	if str(world.s.residents.get("player_cm", "")) == key:
+		world.s.residents.player_cm = ""
+	Residents._news(world, "group_end", area, "%sで一緒に暮らしていた人たちは、%s" % [block_name(area, int(c.block)), {"hunger": "食べる物が尽きて、ばらばらになったらしい。", "few": "人が減って、それぞれの家に戻ったらしい。"}.get(why, "もう誰も残っていないらしい。")])
+
+# ------------------------------------------------------------------ the player
+
+## The strongest still standing in this area.
+static func here(world, area: String) -> Dictionary:
+	var best: Dictionary = {}
+	for key in _peek(world):
+		var c: Dictionary = _peek(world)[key]
+		if str(c.area) != area or bool(c.get("ended", false)):
+			continue
+		if best.is_empty() or members(world, c).size() > members(world, best).size():
+			best = c
+	return best
+
+## What the street shows of it.
+static func signs(world, area: String) -> String:
+	var c := here(world, area)
+	if c.is_empty():
+		return ""
+	var wall := "机や自転車、板を積んだバリケードでふさがれている" if float(c.wall) >= 50.0 else "段ボールや家具で、入口が半分ふさがれている"
+	var garden := "" if float(c.garden) < 1.0 else ("。空き地に、耕したばかりの畝が並んでいる" if float(c.garden) < 4.0 else "。空き地いっぱいに畝が広がり、青菜が育っている")
+	var where := "階段" if str(c.area) in ["団地", "駅前のマンション"] else "路地の入口"
+	return "%sの%sが%s%s。上の方から、煮炊きの煙が細く上がっている。（「集まりを訪ねる」で声をかけられる）" % [block_name(str(c.area), int(c.block)), where, wall, garden]
+
+## Whether they let the player near: what they know of them.
+static func _opinion(world, c: Dictionary) -> float:
+	var o := float(c.get("trust", 0.0))
+	for i in _rows(world, str(c.area), int(c.block)):
+		var flags := int(Residents.row(world, str(c.area), i)[Residents.P_FLAGS])
+		if flags & (Residents.F_ROBBED | Residents.F_HOSTILE):
+			o -= 60.0
+		elif flags & Residents.F_FRIEND:
+			o += 20.0
+	return o
+
+static func visit(world, area: String) -> String:
+	var c := here(world, area)
+	if c.is_empty():
+		return "このあたりに、まとまって暮らしている人たちはいない。"
+	world.advance_safe(10)
+	world.s.residents.called_on = [area, int(world.s.minute)]
+	var o := _opinion(world, c)
+	var lw := Residents.who(world, area, int(c.leader))
+	if o <= -30.0:
+		return "バリケードの上から、誰かが鉄パイプを突き出した。「お前のことは知ってる。二度と近づくな」"
+	var n := mouths(world, c)
+	var days := float(c.store) / maxf(1.0, 0.7 * float(n))
+	var food := "食料はまだ何とかなっている" if days >= 7.0 else ("食料は、あと数日分しかないらしい" if days >= 2.0 else "食料はほとんど尽きかけている")
+	var garden := "畑の青菜が育ち始めていて、" if float(c.garden) >= 2.0 else ""
+	var line := "バリケード越しに、%sさんが顔を出した。%sの住人%d人ほどで、一緒に暮らしているという。%s%s。" % [lw.surname, block_name(area, int(c.block)), n, garden, food]
+	if str(world.s.residents.get("player_cm", "")) == "%s:%d" % [c.area, c.block]:
+		return "バリケードの隙間から中に入った。%sさんが「おかえり」と声をかけてきた。%s。" % [lw.surname, food]
+	return line + "（「手伝う」「食料を寄付する」「仲間に入れてもらう」）"
+
+## The barricade photo, while the player is at it (an hour after calling on them).
+static func photo(world, area: String) -> String:
+	var at = world.s.get("residents", {}).get("called_on", []) if world.s.get("residents") is Dictionary else []
+	if not at is Array or at.size() != 2 or str(at[0]) != area or int(world.s.minute) - int(at[1]) > 60 or here(world, area).is_empty():
+		return ""
+	var name := "community_stairs" if area in ["団地", "駅前のマンション"] else "community_street"
+	var path := "res://assets/photos/%s.jpg" % name
+	return path if ResourceLoader.exists(path) else ""
+
+static func help(world, area: String) -> String:
+	var c := here(world, area)
+	if c.is_empty():
+		return "手伝う相手がいない。"
+	if _opinion(world, c) <= -30.0:
+		return "誰もバリケードを開けてくれない。"
+	world.advance_safe(180)
+	world.s.residents.called_on = [area, int(world.s.minute)]
+	world.s.fatigue = minf(100.0, float(world.s.fatigue) + 15.0)
+	c.trust = float(c.get("trust", 0.0)) + 12.0
+	c.wall = minf(100.0, float(c.wall) + 6.0)
+	c.garden = float(c.garden) + 0.3 * ground(area)
+	return "3時間、バリケードの補強と畑の土起こしを手伝った。何人かが、少しだけ表情をゆるめた。"
+
+static func donate(world, area: String) -> String:
+	var c := here(world, area)
+	if c.is_empty():
+		return "受け取る人がいない。"
+	if _opinion(world, c) <= -30.0:
+		return "誰もバリケードを開けてくれない。"
+	var bag: Dictionary = world.s.district.bag
+	var food := minf(2.0, float(bag.food))
+	if food < 0.5:
+		return "渡せる食料を持っていない。"
+	bag.food = float(bag.food) - food
+	c.store = float(c.store) + food
+	c.trust = float(c.get("trust", 0.0)) + 8.0 * food
+	world.advance_safe(5)
+	return "食料%.1f人日分を、バリケード越しに手渡した。「助かります……子どもたちに回します」" % food
+
+static func ask_join(world, area: String) -> String:
+	var c := here(world, area)
+	if c.is_empty():
+		return "加わる集まりがない。"
+	var o := _opinion(world, c)
+	var lw := Residents.who(world, area, int(c.leader))
+	if str(world.s.residents.get("player_cm", "")) == "%s:%d" % [c.area, c.block]:
+		return "もう、ここの一員だ。"
+	world.advance_safe(10)
+	if o < 25.0:
+		return "%sさんは首を横に振った。「悪いけど、知らない人を入れる余裕はないんです。……何度か手を貸してくれたら、考えます」" % lw.surname
+	# One more mouth: a few days' food in the store, or a patch that feeds them.
+	if float(c.store) < 3.0 and float(c.garden) < 1.0:
+		return "%sさんは申し訳なさそうに言った。「今は、自分たちの分も足りないんです」" % lw.surname
+	world.s.residents.player_cm = "%s:%d" % [c.area, c.block]
+	return "%sさんがうなずいた。「わかりました。ここで一緒に。そのかわり、見張りと畑は手伝ってもらいますよ」（ここで食事と寝泊まりができる）" % lw.surname
+
+static func player_here(world, area: String) -> bool:
+	var key := str(world.s.get("residents", {}).get("player_cm", "")) if world.s.get("residents") is Dictionary else ""
+	return not key.is_empty() and key.begins_with(area + ":")
+
+## A meal from the common pot, for a member at home.
+static func feed_player(world, area: String) -> bool:
+	if not player_here(world, area):
+		return false
+	var c: Dictionary = _peek(world).get(str(world.s.residents.player_cm), {})
+	if c.is_empty() or float(c.store) < 0.6:
+		return false
+	c.store = float(c.store) - 0.6
+	world.s.district.bag.food = float(world.s.district.bag.food) + 0.6
+	if float(c.water) >= 1.5:
+		c.water = float(c.water) - 1.5
+		world.s.district.bag.water = float(world.s.district.bag.water) + 1.5
+	return true
+
+static func leave(world) -> String:
+	if str(world.s.residents.get("player_cm", "")).is_empty():
+		return ""
+	world.s.residents.player_cm = ""
+	return "荷物をまとめて、バリケードの内側を後にした。何人かが黙って見送った。"
