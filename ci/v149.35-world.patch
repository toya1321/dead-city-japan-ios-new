+extends SceneTree
+## A readable transcript of a scripted session: each command, what the game
+## said, and the suggestions it offered. For a human to read and judge.
+const Main = preload("res://main.tscn")
+var g
+var w
+
+func _initialize() -> void:
+	call_deferred("run")
+
+var calm := false
+
+func say(cmd: String) -> void:
+	if calm:
+		var W = load("res://scripts/walkers.gd")
+		W.ensure(w).places = {}
+		W.ensure(w).encounter = {}
+	var n: int = g.log_entries.size()
+	var last := str(g.log_entries[-1]) if n > 0 else ""
+	await g._on_command(cmd)
+	var guard := 0
+	while g.advancing and guard < 300:
+		guard += 1
+		await process_frame
+	var mark := -1
+	for k in range(g.log_entries.size() - 1, -1, -1):
+		if str(g.log_entries[k]) == "▶ " + cmd:
+			mark = k
+			break
+	var out: Array = g.log_entries.slice(mark + 1) if mark >= 0 else []
+	var t := "%d日目 %02d:%02d" % [int(w.s.minute) / 1440 + 1, int(w.hour_of_day()), int(w.s.minute + int(float(w.s.start_hour) * 60)) % 60]
+	print("\n▶ %s  [%s @%s 体力%.0f 空腹%.0f 渇き%.0f 食料%.1f 水%.1f 社会=%s]" % [cmd, t, g.location, w.s.health, w.s.hunger, w.s.thirst, w.s.food, w.s.water, w.s.society])
+	for l in out:
+		print("  " + str(l).replace("\n", "\n  "))
+	print("  ［候補］ " + " / ".join(g._suggestions().map(func(c): return str(c))))
+
+func days(n: int) -> void:
+	for d in n:
+		for h in 24:
+			w.advance(60, h < 8)
+			if float(w.s.hunger) > 50.0 and w.eat(): pass
+			if float(w.s.thirst) > 50.0 and w.drink(): pass
+			if float(w.s.food) < 3.0: w.s.food = 10.0
+			if float(w.s.water) < 5.0: w.s.water = 15.0
+			w.s.health = maxf(float(w.s.health), 60.0)
+			var enc: Dictionary = load("res://scripts/walkers.gd").ensure(w).encounter
+			if not enc.is_empty():
+				w.s.walkers.encounter = {}
+	print("\n……（%d日が過ぎた）……" % n)
+
+func run() -> void:
+	g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var args := OS.get_cmdline_user_args()
+	var part := args[0] if args.size() > 0 else "early"
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 4242
+	p.cohabitants = 1
+	p.companion_names = ["詩音"]
+	p.companion_genders = ["女性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	w = g.world
+	match part:
+		"early":
+			for c in ["周囲を見る", "ニュースを見る", "詩音に話しかける", "冷蔵庫に何がある？", "スーパーへ行く", "売り場に行く", "バックヤードに行く", "冷蔵売り場に行く", "買い物する", "入口に戻る", "家に帰る", "詩音とリバーシをする"]:
+				await say(c)
+				if g.reversi_layer != null and is_instance_valid(g.reversi_layer):
+					g.reversi_layer._quit()
+					await process_frame
+		"mid":
+			await days(6)
+			for c in ["周囲を見る", "ニュースを見る", "浴槽に水をためる", "物資を持っていく", "団地へ行く", "次の部屋を探す", "ノックする", "声をかける", "次の部屋を探す", "ノックする", "食料を分ける", "一緒に来ないか誘う", "家に帰る", "洗濯する", "みんなでトランプをする"]:
+				await say(c)
+				if g.cards_layer != null and is_instance_valid(g.cards_layer):
+					g.cards_layer._leave()
+					await process_frame
+		"late":
+			await days(14)
+			calm = true
+			for c in ["周囲を見る", "総合病院へ行く", "ロビーに行く", "病室に行く", "ベッドで休む", "薬品庫に行く", "物資を探索する", "入口に戻る", "大通りへ行く", "中学校へ行く", "保健室に行く", "物資を探索する", "家に帰る", "種を植える", "水やり", "寝る"]:
+				await say(c)
+	quit()
