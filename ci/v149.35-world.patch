+const Walkers = preload("res://scripts/walkers.gd")
+
+const FAMILIES := [
+	["一人暮らしの高齢者", 22, ["写真立ての中で、着物姿の夫婦が笑っている。", "カレンダーに、病院の予約の丸印が並んでいる。"]],
