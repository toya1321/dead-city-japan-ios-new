+extends RefCounted
+## v149.36: what grows, and how fast — real crops on their real timetables,
+## slowed by the cold (Tokyo winters are mild, but not for summer crops).
+## Cress on the kitchen windowsill is ready in a week but feeds little;
+## komatsuna and radish take a month or so; potatoes and sweet potatoes take
+## three or four months and feed a household. Nothing is hurried for the
+## game's sake: choosing what to sow, and when, is the decision.
+
+const Cold = preload("res://scripts/cold.gd")
+
+## days: to harvest in good weather; yield: food (person-days) per planter;
+## seed: what is used to sow it; kind: how it takes the cold.
+const CROPS := {
+	"kaiware": {"label": "かいわれ大根", "days": 7, "yield": 0.15, "seed": "seeds", "kind": "indoor", "words": ["かいわれ", "カイワレ", "豆苗", "スプラウト"]},
+	"komatsuna": {"label": "小松菜", "days": 35, "yield": 0.8, "seed": "seeds", "kind": "hardy", "words": ["小松菜", "青菜", "葉物"]},
+	"radish": {"label": "ラディッシュ", "days": 30, "yield": 0.6, "seed": "seeds", "kind": "hardy", "words": ["ラディッシュ", "二十日大根", "はつか大根"]},
+	"potato": {"label": "じゃがいも", "days": 100, "yield": 3.0, "seed": "food", "kind": "cool", "words": ["じゃがいも", "ジャガイモ", "馬鈴薯", "芋"]},
+	"sweetpotato": {"label": "さつまいも", "days": 120, "yield": 4.0, "seed": "food", "kind": "warm", "words": ["さつまいも", "サツマイモ", "さつま芋"]},
+}
+const DEFAULT := "komatsuna"
+
+## Which crop a line names ("" if none).
+static func named(text: String) -> String:
+	for id in CROPS:
+		for word in CROPS[id].words:
+			if text.contains(word):
+				return id
+	return ""
+
+## How fast a crop grows now, from the season (1.0 = its normal pace).
+static func season(world, crop: String) -> float:
+	var kind := str(CROPS.get(crop, CROPS[DEFAULT]).kind)
+	if kind == "indoor":
+		return 1.0 if Cold.indoor(world) >= 10.0 else 0.5
+	# The day's mean temperature (not the hour's), a little warmer by a window
+	# or on a balcony than in the street.
+	var hour: float = world.hour_of_day()
+	var t: float = Cold.outdoor(world) - 4.0 * cos((hour - 14.0) / 24.0 * TAU) + 3.0
+	match kind:
+		"hardy":
+			if t < 5.0: return 0.3
+			if t < 10.0: return 0.6
+			if t > 30.0: return 0.6
+			return 1.0
+		"cool":
+			if t < 8.0: return 0.2
+			if t < 12.0: return 0.5
+			if t > 28.0: return 0.5
+			return 1.0
+		"warm":
+			if t < 16.0: return 0.05
+			if t < 21.0: return 0.5
+			return 1.0
+	return 1.0
+
+static func label(crop: String) -> String:
+	return str(CROPS.get(crop, CROPS[DEFAULT]).label)
+
+## What a group's garden makes in a day, against good-weather output
+## (a mix of greens and roots).
+static func garden_season(world) -> float:
+	return (season(world, "komatsuna") + season(world, "potato")) / 2.0
