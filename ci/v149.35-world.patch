+extends SceneTree
+## v149.35: anyone can end up a looter. Someone met out in town who goes
+## hungry long enough throws in with a gang if they are hard enough; a kind
+## one does not.
+const Main = preload("res://main.tscn")
+const Residents = preload("res://scripts/residents.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const Gangs = preload("res://scripts/gangs.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 33
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.society = "emergency"
+	Residents.state(w)
+	var gangs: Dictionary = Gangs.all(w)
+	gangs["gang_test"] = {"id": "gang_test", "lair": "倉庫街", "since": 0, "store": 5.0, "hungry": 0, "ended": false, "last_raid": -1, "leader": ["団地", 0], "homes": []}
+	var people: Dictionary = Survivors.ensure(w).people
+	var ids: Array = people.keys().filter(func(id): return not str(people[id].role) in ["child", "elder"] and not bool(people[id].get("neighbor", false)))
+	check(ids.size() >= 2, "there are grown-ups out in town")
+	var hard: Dictionary = people[ids[0]]
+	var kind: Dictionary = people[ids[1]]
+	for q in [hard, kind]:
+		q.tag = "hungry"
+		q.given = 0
+		q.hunger_day = 0
+		q.erase("arrived")
+	hard.kindness = 10
+	hard.traits.honesty = 15
+	kind.kindness = 90
+	kind.traits.honesty = 90
+	Survivors.daily(w, func(_place): return 0)
+	check(str(hard.status) == "looter" and Gangs.people(w, gangs["gang_test"]) >= 1, "a hard one, starving, joins the looters (%s)" % hard.status)
+	check(str(kind.status) != "looter", "a kind one does not (%s)" % kind.status)
+	Gangs._end(w, gangs["gang_test"], 30, "hunger")
+	check(str(hard.status) == "left", "when the gang breaks up, they are gone too")
+	g.queue_free()
+	print("RESULT %s" % ("PASS" if failures == 0 else "FAIL"))
+	quit(1 if failures else 0)
