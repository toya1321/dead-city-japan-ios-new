+## v149.35: the houses of the residential streets. Once people have fled or
+## died, what is left in their kitchens is there for whoever searches — the
+## player and every survivor alike. Plenty at first, harder to find as the
+## houses are emptied one by one.
+const HOUSES_FOOD := 160.0
+const HOUSES_WATER := 220.0
+static func houses(world) -> Dictionary:
+	var d: Dictionary = world.s.district
+	if not d.get("houses") is Dictionary:
+		d.houses = {"food": HOUSES_FOOD, "water": HOUSES_WATER}
+	return d.houses
+
+static func houses_open(world) -> bool:
+	return str(world.s.get("society", "normal")) in ["disrupted", "emergency"]
+
+## What one search of the houses turns up (food, water), taken from the pool.
+static func search_houses(world, food_cap: float, water_cap: float) -> Vector2:
+	var h := houses(world)
+	var left := float(h.food) / HOUSES_FOOD
+	var food := minf(float(h.food), roundf(food_cap * left))
+	var water := minf(float(h.water), roundf(water_cap * float(h.water) / HOUSES_WATER / 2.0) * 2.0)
+	h.food = float(h.food) - food
+	h.water = float(h.water) - water
+	return Vector2(food, water)
+
