+extends SceneTree
+## v149.38: getting about a town full of the dead.
+## 1. Walkers that have not noticed you can be slipped past (and you carry on).
+## 2. Hiding depends on the few close by, not on everyone down the street.
+## 3. A street only passed through stops you only when one is close.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Combat = preload("res://scripts/combat.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func new_game():
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 9
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+func run() -> void:
+	var g = await new_game()
+	var w = g.world
+	w.s.society = "emergency"
+	w.s.mood = 60.0
+	# 1. Slipping past: offered while unnoticed, and it can work.
+	var slipped := 0
+	var tries := 0
+	for t in 40:
+		g.location = "屋外"
+		g._sync_player_position()
+		w.s.walkers.places = {"商店通り": 2}
+		w.s.walkers.encounter = {}
+		w.s.walkers.erase("passed")
+		w.s.minute = int(w.s.minute) + 37
+		await g._on_command("商店通りへ行く")
+		if not Combat.active(w) or bool(w.s.walkers.encounter.get("near", false)) or Combat.noticed(w):
+			continue
+		tries += 1
+		if t == 0 or tries == 1:
+			check(g._suggestions().has("そっと通り過ぎる"), "slipping past is offered while they have not noticed")
+		g.log_entries.clear()
+		await g._on_command("そっと通り過ぎる")
+		if OS.get_environment("DBG") == "1":
+			print("DBG ", str(g.log_entries).left(200))
+		if not Combat.active(w):
+			slipped += 1
+			if slipped == 1:
+				check(Walkers.check(w, "商店通り").is_empty(), "having slipped past, the same ones do not stop you again at once")
+	check(tries > 5 and slipped >= tries / 2, "slipping past unnoticed walkers mostly works (%d of %d)" % [slipped, tries])
+	# 2. Hiding: twenty down the street are not twenty behind the wall.
+	var hid_few := 0
+	var hid_many := 0
+	for t in 60:
+		for n in [3, 20]:
+			w.s.walkers.places = {"商店通り": n}
+			w.s.walkers.erase("passed")
+			w.s.walkers.encounter = {"place": "商店通り", "count": n, "near": false, "since": int(w.s.minute), "from": ""}
+			w.s.minute = int(w.s.minute) + 13
+			var r: Dictionary = Walkers.resolve(w, "hide")
+			if bool(r.ended):
+				if n == 3: hid_few += 1
+				else: hid_many += 1
+	check(absi(hid_few - hid_many) <= 15, "hiding depends on those close by (3 down the street: %d/60, 20: %d/60)" % [hid_few, hid_many])
+	# 3. Passing through: a street on the way stops you only sometimes; the porch always.
+	var stopped := 0
+	for t in 60:
+		w.s.minute = int(w.s.minute) + 61
+		w.s.walkers.erase("passed")
+		w.s.walkers.places = {"商店通り": 2}
+		if Walkers.blocks_passing(w, "商店通り"):
+			stopped += 1
+	check(stopped > 0 and stopped < 40, "two far down a street on the way stop you only sometimes (%d/60)" % stopped)
+	w.s.walkers.places = {"建物前": 1}
+	check(Walkers.blocks_passing(w, "建物前"), "one at your own porch always stops you")
+	# A walk through a street with walkers far down it carries on to the end.
+	var through := 0
+	for t in 30:
+		g.location = "屋外"
+		g._sync_player_position()
+		w.s.walkers.places = {"商店通り": 1}
+		w.s.walkers.encounter = {}
+		w.s.walkers.erase("passed")
+		w.s.minute = int(w.s.minute) + 61
+		await g._on_command("南の住宅街へ行く")
+		if g.location == "南の住宅街":
+			through += 1
+			if through == 1:
+				check(str(g.log_entries.slice(-4)).contains("道の反対側を通って"), "skirting them is said")
+	check(through >= 15, "most walks past one far down a street get through (%d/30)" % through)
+	print("TOTAL FAILURES ", failures)
+	quit(1 if failures > 0 else 0)
diff --git a/tests/test_residents149_38.gd b/tests/test_residents149_38.gd
