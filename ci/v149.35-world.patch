+## Make `made` one of the residents with its occupation (and sex if possible),
+## preferring a household of more than one and the given area. False if the
+## roster has nobody for it.
+static func bind(made: Dictionary, rng: RandomNumberGenerator, people: Dictionary, used_names: Dictionary, prefer_area: String = "") -> bool:
+	var roster: Dictionary = Residents.roster()
+	if roster.is_empty():
+		return true
+	var role_id := str(made.role)
+	var male := str(made.gender) == "男性"
+	var taken := _bound_keys(people)
+	var best: Array = []
+	var best_score := -1
+	for area in roster:
+		var rows: Array = roster[area]
+		for i in rows.size():
+			var h: Dictionary = rows[i]
+			if used_names.has(str(h.surname)) and not str(made.get("surname_ok", "")) == "1":
+				continue
+			for k in h.people.size():
+				var p: Dictionary = h.people[k]
+				if str(p.get("role", "")) != role_id or taken.has("%s/%d/%d" % [area, i, k]):
+					continue
+				var score := 0
+				score += 4 if (str(p.sex) == "m") == male else 0
+				score += 2 if h.people.size() > 1 else 0
+				score += 1 if (prefer_area.is_empty() or area == prefer_area) else 0
+				if score > best_score:
+					best_score = score
+					best = []
+				if score == best_score:
+					best.append([area, i, k])
+	if best.is_empty():
+		return false
+	var pick: Array = best[rng.randi_range(0, best.size() - 1)]
+	adopt(made, str(pick[0]), int(pick[1]), int(pick[2]))
+	used_names[str(made.name)] = true
+	return true
