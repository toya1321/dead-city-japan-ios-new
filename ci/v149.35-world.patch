+
+static func has(place: String) -> bool:
+	return SITES.has(place)
+
+static func rooms(place: String) -> Array:
+	return SITES.get(place, {}).get("rooms", [])
+
+static func _room_def(place: String, room: String) -> Dictionary:
+	for r in rooms(place):
+		if str(r.name) == room:
+			return r
+	return {}
+
+## The room the player is in at `place` ("" = at the entrance).
+static func current(world, place: String) -> String:
+	var at: Variant = world.s.get("site_room")
+	if at is Dictionary and str(at.get("place", "")) == place:
+		return str(at.get("room", ""))
+	return ""
+
+static func _put(world, place: String, room: String) -> void:
+	world.s.site_room = {"place": place, "room": room}
+
+## Staff still keep people out of the back rooms while the hospital runs.
+static func _open_to_all(world) -> bool:
+	return str(world.s.get("society", "normal")) in ["disrupted", "emergency"]
+
+## v149.35: the ward is where you can lie down properly — a bed, out of the
+## street — and where, once the hospital empties, someone too weak to leave
+## may still be lying.
+const WARD := "病室"
+
+static func rest(world, place: String) -> String:
+	if not bool(_room_def(place, current(world, place)).get("bed", false)):
+		return "ここには横になれるベッドがない。"
+	if float(world.s.health) <= 0.0:
+		return "死亡しているため行動できない。"
+	var before := float(world.s.health)
+	world.advance(180, true)
+	world.s.health = minf(100.0, float(world.s.health) + 15.0)
+	if world.s.get("longplay") is Dictionary:
+		world.s.longplay.morale = minf(100.0, float(world.s.longplay.get("morale", 50.0)) + 1.0)
+	var healed := float(world.s.health) - before
+	var stage := phase(world)
+	var lead := "%sのベッドに横になり、カーテンを引いて3時間眠った。" % current(world, place)
+	if stage == "overgrown":
+		lead = "湿ったマットレスに横になり、雨の音を聞きながら3時間眠った。"
+	var rng := RandomNumberGenerator.new()
+	rng.seed = hash([int(world.s.seed), int(world.s.minute), "ward-rest"])
+	var risk := ""
+	if stage in ["collapse", "overgrown"] and rng.randf() < 0.25:
+		load("res://scripts/walkers.gd").make_noise(world, place, 40)
+		risk = "目を覚ますと、廊下の奥で何かが倒れる音がした。"
+	var felt := ("体が少し楽になった（体力 +%d）。" % int(round(healed))) if healed >= 1.0 else "ぐっすり眠れた。"
+	return "%s%s%s" % [lead, felt, risk]
+
+## Once the hospital has emptied, the first time you look into the ward there
+## may be a patient left behind: one of the town's old people, too weak to go.
+## They need food to last; help them, take them home, or leave them.
+static func patient(world, place: String) -> String:
+	if place != "総合病院" or phase(world) != "collapse" or bool(world.s.get("ward_patient", false)):
+		return ""
+	world.s.ward_patient = true
+	var Survivors = load("res://scripts/survivors.gd")
+	var Residents = load("res://scripts/residents.gd")
+	if Residents.roster().is_empty() or not Residents.ready(world):
+		return ""
+	var people: Dictionary = Survivors.ensure(world).people
+	var taken: Dictionary = Survivors._bound_keys(people)
+	var rng := RandomNumberGenerator.new()
+	rng.seed = hash([int(world.s.seed), "ward-patient"])
+	var options: Array = []
+	for area in world.s.residents.hh:
+		var rows: Array = world.s.residents.hh[area]
+		for i in rows.size():
+			var r: Array = rows[i]
+			if not str(r[Residents.P_PATH]) in ["home", "holed", "away"]:
+				continue
+			var h: Dictionary = Residents.listed(area, i)
+			for k in h.get("people", []).size():
+				var q: Dictionary = h.people[k]
+				if int(q.age) >= 70 and int(r[Residents.P_ALIVE]) & (1 << k) and not taken.has("%s/%d/%d" % [area, i, k]):
+					options.append([area, i, k])
+	if options.is_empty():
+		return ""
+	var pick: Array = options[rng.randi_range(0, options.size() - 1)]
+	var area := str(pick[0])
+	var i := int(pick[1])
+	var k := int(pick[2])
+	var q: Dictionary = Residents.listed(area, i).people[k]
+	var made: Dictionary = Survivors._make(rng, "elder", Survivors.Parts.ROLES["elder"], str(q.sex) == "m", place, {})
+	if made.is_empty():
+		return ""
+	Survivors.adopt(made, area, i, k)
+	var day := int(world.s.minute) / 1440
+	made.id = "ward_%s_%d_%d" % [area, i, k]
+	made.place = place
+	made.tag = "hungry"
+	made.secret = ""
+	made.situation = "hungry"
+	made.needs = ["food", "water"]
+	made.given = 0
+	made.hunger_day = day + 3
+	made.background = "%s 入院していたが、職員がいなくなっても、体が弱くて自分では帰れなかった。" % str(made.home_text)
+	made.intro = "奥のベッドに、%sが横になっていた。痩せた手でこちらを手招きする。「……誰か、来てくれたの。もう何日も、誰も来なくて」" % str(made.label)
+	people[made.id] = made
+	var r: Array = Residents.row(world, area, i)
+	r[Residents.P_ALIVE] = int(r[Residents.P_ALIVE]) & ~(1 << k)
+	return " " + str(made.intro)
+
+## "<room>に行く" / "<room>に入る". Returns "" if it is not a room of this place.
+static func go(world, place: String, command: String) -> String:
+	if not has(place):
+		return ""
+	for r in rooms(place):
+		var name := str(r.name)
+		if command in ["%sに行く" % name, "%sに入る" % name, "%sへ行く" % name, "%sを見る" % name]:
+			if current(world, place) == name:
+				return "すでに%sにいる。" % name
+			if not bool(r.public) and not _open_to_all(world):
+				return "「関係者以外立ち入り禁止」の札がかかっている。%sに止められ、%sには入れなかった。" % [str(SITES[place].get("staff", "職員" if place == "総合病院" else "店員")), name]
+			world.advance_safe(2)
+			_put(world, place, name)
+			var seen := describe(world, place, phase(world))
+			if name == WARD:
+				# (they are met through the usual encounter line, not told twice)
+				patient(world, place)
+			return seen
+	if command in ["ベッドで休む", "ベッドで眠る", "ベッドで寝る", "病室で休む", "保健室で休む"]:
+		return rest(world, place)
+	if command in ["入口に戻る", "外に出る", "建物を出る"] and not current(world, place).is_empty():
+		_put(world, place, "")
+		return "%sの入口に戻った。" % place
+	return ""
+
+static func phase(world) -> String:
+	var society := str(world.s.get("society", "normal"))
+	var day := int(world.s.minute) / 1440
+	if society == "normal" and int(world.s.get("regional_cases", 0)) < 10:
+		return "normal"
+	if day >= 365 and society != "normal":
+		return "overgrown"
+	if society in ["normal", "alert"] or int(world.s.get("regional_cases", 0)) < 200:
+		return "alert"
+	return "collapse"
+
+static func describe(world, place: String, stage: String) -> String:
+	var r := _room_def(place, current(world, place))
+	if r.is_empty():
+		return ""
+	return str(r.text.get(stage, r.text.normal))
+
+## The room's picture for this stage, falling back to an earlier stage.
+static func photo(world, place: String, stage: String) -> String:
+	var r := _room_def(place, current(world, place))
+	if r.is_empty():
+		return ""
+	var base := "%s_%s" % [str(SITES[place].photo), str(r.key)]
+	var phases := ["normal", "alert", "collapse", "overgrown"]
+	var k := phases.find(stage)
+	while k > 0:
+		var path := "res://assets/photos/%s_%s.jpg" % [base, phases[k]]
+		if ResourceLoader.exists(path):
+			return path
+		k -= 1
+	var plain := "res://assets/photos/%s.jpg" % base
+	return plain if ResourceLoader.exists(plain) else ""
+
+## How many bandages one search finds in this room (the store room most).
+static func bandage_take(world, place: String) -> int:
+	var r := _room_def(place, current(world, place))
+	return int(r.get("bandage", 3)) if not r.is_empty() else 3
+
+## How much of the food and water a search turns up in this room (1.0 = as usual).
+static func share(world, place: String, item: String) -> float:
+	var r := _room_def(place, current(world, place))
+	return float(r.get(item, 1.0)) if not r.is_empty() else 1.0
+
+## The rooms to offer as next moves.
+static func chips(world, place: String) -> Array:
+	var out: Array = []
+	var here := current(world, place)
+	for r in rooms(place):
+		if str(r.name) != here and (bool(r.public) or _open_to_all(world)):
+			out.append("%sに行く" % r.name)
+	if bool(_room_def(place, here).get("bed", false)):
+		out.push_front("ベッドで休む")
+	if not here.is_empty():
+		out.append("入口に戻る")
+	return out
