+## v149.38: where the town's news gathers. Half an hour among the people in
+## the gym: what has happened out there, as they tell it.
+static func listen(world) -> String:
+	if not is_open(world):
+		return "話を聞ける人が、もういない。" if str(state(world).status) != "school" else "まだ避難所は開いていない。"
+	world.advance_safe(30)
+	if not world.s.get("survivors") is Dictionary:
+		return "誰もが自分のことで手一杯で、話はあまり聞けなかった。"
+	var history: Array = world.s.survivors.get("history", [])
+	var now := int(world.s.minute)
+	var told: Array = []
+	for k in range(history.size() - 1, -1, -1):
+		var e: Dictionary = history[k]
+		if bool(e.get("known", false)) or now - int(e.at) < 360:
+			continue
+		e.known = true
+		e.how = "避難所で聞いた"
+		told.append(str(e.text))
+		if told.size() >= 3:
+			break
+	if told.is_empty():
+		return "毛布の間を回って話を聞いた。みんな、知っているのは同じ話ばかりだった。"
+	return "毛布の間を回って、話を聞いた。\n" + "\n".join(told.map(func(t): return "・" + t))
 
 ## Four hours at the gate and the entrance: newcomers are checked, the gate
 ## is looked after, and the watch is stronger tonight.
