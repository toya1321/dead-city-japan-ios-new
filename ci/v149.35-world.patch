--- /dev/null
+++ b/scripts/card_table.gd
@@ -0,0 +1,619 @@
+extends Control
+## v149.35: the card table — a full-screen layer where you play ババ抜き,
+## 大富豪, 七並べ or 神経衰弱 with the people at home (scripts/cards*.gd).
+## Seat 0 is you; the others are housemates, each playing the way they are.
+## Game time stands still while you play; main._cards_finished() writes it
+## down afterwards.
+
+const Cards = preload("res://scripts/cards.gd")
+const UI = preload("res://scripts/ui_kit.gd")
+const Portraits = preload("res://scripts/portraits.gd")
+const MODULES := {
+	"babanuki": preload("res://scripts/cards_babanuki.gd"),
+	"daifugo": preload("res://scripts/cards_daifugo.gd"),
+	"shichinarabe": preload("res://scripts/cards_shichinarabe.gd"),
+	"shinkei": preload("res://scripts/cards_shinkei.gd"),
+}
+
+var game                      # main.gd
+var mates: Array = []         # household indices at the table (seat k+1)
+var everyone: Array = []      # all who sat down (a smaller game seats fewer)
+var names: Array = ["あなた"]
+var profs: Array = [{}]
+var kind := ""
+var state: Dictionary = {}
+var rng := RandomNumberGenerator.new()
+var delay := 0.6              # seconds between their moves (tests: 0)
+var running := false
+var selected: Array = []      # 大富豪: cards picked to play
+var tell: Dictionary = {}     # ババ抜き: what you read off the one you draw from
+var results: Array = []
+var last_said := ""
+var bubbles: Dictionary = {}  # seat -> [text, age]
+var note := ""
+
+var column: VBoxContainer
+var title: Label
+var seats_row: HBoxContainer
+var center: Control
+var status: Label
+var hand_box: Control
+var buttons: HFlowContainer
+var textures := {}
+
+func setup(main_game, game_kind: String, mate_indices: Array) -> void:
+	game = main_game
+	everyone = mate_indices.duplicate()
+	_seat(everyone)
+	rng.seed = hash([int(game.world.s.seed), int(game.world.s.minute), "cards", game_kind])
+	_build()
+	if MODULES.has(game_kind):
+		begin(game_kind)
+	else:
+		_picker()
+
+func _seat(list: Array) -> void:
+	mates = list.duplicate()
+	names = ["あなた"]
+	profs = [{}]
+	for i in mates:
+		var m: Dictionary = game.world.s.household_members[i]
+		names.append(str(m.name))
+		profs.append(Cards.profile(game.world, m))
+
+func _tex(card: String) -> Texture2D:
+	if not textures.has(card):
+		textures[card] = load(Cards.texture_path(card))
+	return textures[card]
+
+# --- Layout ---------------------------------------------------------------
+
+func _build() -> void:
+	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	mouse_filter = Control.MOUSE_FILTER_STOP
+	var shade := ColorRect.new()
+	shade.color = Color("#1b2a22")
+	shade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(shade)
+	# v149.35: the green felt of the UI kit.
+	if ResourceLoader.exists("res://assets/ui/dcj_ui/table_felt.jpg"):
+		var felt := TextureRect.new()
+		felt.texture = load("res://assets/ui/dcj_ui/table_felt.jpg")
+		felt.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		felt.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
+		felt.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		felt.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+		add_child(felt)
+	var margin := MarginContainer.new()
+	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	for side in ["left", "right", "top", "bottom"]:
+		margin.add_theme_constant_override("margin_" + side, 10)
+	add_child(margin)
+	column = VBoxContainer.new()
+	column.add_theme_constant_override("separation", 8)
+	margin.add_child(column)
+	var top := HBoxContainer.new()
+	column.add_child(top)
+	title = Label.new()
+	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	title.add_theme_font_size_override("font_size", 20)
+	title.add_theme_color_override("font_color", Color("#e9dcc0"))
+	top.add_child(title)
+	var quit := UI.button("やめる", false, 38, 15)
+	quit.custom_minimum_size = Vector2(88, 38)
+	quit.pressed.connect(_leave)
+	top.add_child(quit)
+	seats_row = HBoxContainer.new()
+	seats_row.alignment = BoxContainer.ALIGNMENT_CENTER
+	seats_row.add_theme_constant_override("separation", 6)
+	column.add_child(seats_row)
+	center = Control.new()
+	center.size_flags_vertical = Control.SIZE_EXPAND_FILL
+	center.custom_minimum_size.y = 200
+	center.resized.connect(_on_resized)
+	column.add_child(center)
+	status = Label.new()
+	status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	status.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	status.add_theme_font_size_override("font_size", 15)
+	status.add_theme_color_override("font_color", Color("#e6edf3"))
+	column.add_child(status)
+	hand_box = Control.new()
+	hand_box.custom_minimum_size.y = 120
+	hand_box.resized.connect(_on_resized)
+	column.add_child(hand_box)
+	buttons = HFlowContainer.new()
+	buttons.alignment = FlowContainer.ALIGNMENT_CENTER
+	buttons.add_theme_constant_override("h_separation", 10)
+	buttons.add_theme_constant_override("v_separation", 8)
+	buttons.custom_minimum_size.y = 46
+	column.add_child(buttons)
+
+## Redraw when the space really changed (not on every relayout).
+var _sizes := ""
+var _queued := false
+
+func _on_resized() -> void:
+	if center == null or hand_box == null:
+		return
+	var now := "%s|%s" % [center.size, hand_box.size]
+	if now == _sizes or _queued:
+		return
+	_sizes = now
+	_queued = true
+	call_deferred("_redraw")
+
+func _redraw() -> void:
+	_queued = false
+	_update()
+
+var _button_sig := ""
+
+func _buttons(list: Array) -> void:
+	var sig := str(list.map(func(item): return [item[0], item.size() > 2 and not bool(item[2])]))
+	if sig == _button_sig:
+		return
+	_button_sig = sig
+	for child in buttons.get_children():
+		child.queue_free()
+	for item in list:
+		var b := UI.button(str(item[0]), str(item[0]) in ["出す", "もう一回", "いいよ"], 44, 17)
+		b.custom_minimum_size = Vector2(118, 44)
+		b.add_theme_font_size_override("font_size", 17)
+		b.disabled = item.size() > 2 and not bool(item[2])
+		b.pressed.connect(item[1])
+		buttons.add_child(b)
+
+func _picker() -> void:
+	_seat(everyone)
+	state = {}
+	_clear(center)
+	_clear(hand_box)
+	title.text = "トランプ"
+	status.text = "何をして遊ぶ？"
+	var list: Array = []
+	for k in Cards.GAMES:
+		list.append([Cards.GAMES[k], begin.bind(k)])
+	_buttons(list)
+	_seats()
+
+func begin(game_kind: String) -> void:
+	kind = game_kind
+	_seat(everyone.slice(0, int(Cards.SEATS[kind])))
+	var seats := mates.size() + 1
+	state = MODULES[kind].start(seats, rng)
+	selected = []
+	tell = {}
+	note = ""
+	bubbles = {}
+	title.text = Cards.GAMES[kind]
+	if seats > 1:
+		_bubble(1 + rng.randi_range(0, seats - 2), Cards.line(profs[1], "start", rng))
+	_speak()
+	_update()
+	_run()
+
+# --- The flow -------------------------------------------------------------
+
+## Their turns, one after another, until it is yours (or the game ends).
+func _run() -> void:
+	if running:
+		return
+	running = true
+	if kind == "shinkei" and not state.shown.is_empty() and int(state.turn) != 0:
+		_update()
+		if delay > 0.0 and is_inside_tree():
+			await get_tree().create_timer(delay * 1.5).timeout
+		state.shown = []
+	while not bool(state.get("done", true)) and int(state.turn) != 0:
+		if delay > 0.0 and is_inside_tree():
+			await get_tree().create_timer(delay if not bool(state.out[0]) else delay * 0.4).timeout
+		if not is_inside_tree() and delay > 0.0:
+			running = false
+			return
+		_their_move(int(state.turn))
+		_speak()
+		_update()
+		# 神経衰弱: a miss stays face up for a moment.
+		if kind == "shinkei" and not state.shown.is_empty():
+			if delay > 0.0 and is_inside_tree():
+				await get_tree().create_timer(delay * 1.5).timeout
+			state.shown = []
+			_update()
+	running = false
+	if bool(state.get("done", false)):
+		_end()
+	else:
+		_your_turn()
+		_update()
+
+func _their_move(i: int) -> void:
+	for k in bubbles:
+		bubbles[k][1] = int(bubbles[k][1]) + 1
+	match kind:
+		"babanuki":
+			MODULES.babanuki.ai(state, i, profs, rng)
+			var l: Dictionary = state.get("last", {})
+			note = "%sが%sから1枚引いた。%s" % [names[i], names[int(l.get("from", 0))], "ペアがそろった。" if not str(l.get("paired", "")).is_empty() else ""]
+			if int(l.get("from", -1)) == 0:
+				note = "%sがあなたの%sを引いた。%s" % [names[i], Cards.label(str(l.card)), "ペアがそろった。" if not str(l.get("paired", "")).is_empty() else ""]
+		"daifugo":
+			MODULES.daifugo.ai(state, i, profs, rng)
+			var l: Dictionary = state.get("last", {})
+			note = "%sはパスした。" % names[i] if bool(l.get("pass", false)) else "%sが%sを出した。" % [names[i], "・".join(l.get("cards", []).map(func(c): return Cards.label(c)))]
+		"shichinarabe":
+			MODULES.shichinarabe.ai(state, i, profs, rng)
+			var l: Dictionary = state.get("last", {})
+			note = ("%sはパスした（%d回目）。" % [names[i], int(state.passes[i])]) if bool(l.get("pass", false)) else "%sが%sを置いた。" % [names[i], Cards.label(str(l.card))]
+		"shinkei":
+			MODULES.shinkei.ai_flip(state, i, profs, rng)
+			var l: Dictionary = state.get("last", {})
+			if not l.is_empty() and int(l.by) == i:
+				note = "%sが%s。" % [names[i], "1組そろえた" if bool(l.match) else "めくったが、そろわなかった"]
+
+func _your_turn() -> void:
+	selected = []
+	tell = {}
+	if kind == "babanuki":
+		var j: int = MODULES.babanuki.target(state, 0)
+		if j > 0:
+			tell = MODULES.babanuki.tell(state, j, profs[j], names[j], rng)
+
+## Lines the game wants said: into the speakers' bubbles.
+func _speak() -> void:
+	for item in state.get("say", []):
+		var seat := int(item[0])
+		if seat <= 0 or seat >= profs.size():
+			continue
+		_bubble(seat, Cards.line(profs[seat], str(item[1]), rng))
+	state.say = []
+
+func _bubble(seat: int, text: String) -> void:
+	if not text.is_empty():
+		bubbles[seat] = [text, 0]
+		last_said = "%sは「%s」と言った。" % [names[seat], text]
+
+# --- Your moves -------------------------------------------------------------
+
+## ババ抜き: draw the card at `pos` from the one you draw from.
+func draw_card(pos: int) -> void:
+	if kind != "babanuki" or running or int(state.turn) != 0 or bool(state.done):
+		return
+	var j: int = MODULES.babanuki.target(state, 0)
+	var card: String = MODULES.babanuki.draw(state, 0, pos, profs, rng)
+	if card.is_empty():
+		return
+	var l: Dictionary = state.last
+	note = "%sから%sを引いた。%s" % [names[j], Cards.label(card), "ペアがそろったので捨てた。" if not str(l.get("paired", "")).is_empty() else ("……ジョーカーだ。" if Cards.joker(card) else "")]
+	_after_you()
+
+## 大富豪: pick / unpick a card.
+func toggle(card: String) -> void:
+	if running or int(state.turn) != 0:
+		return
+	if card in selected:
+		selected.erase(card)
+	else:
+		# Only one rank at a time.
+		if not selected.is_empty() and (Cards.joker(card) or Cards.joker(selected[0]) or Cards.rank(card) != Cards.rank(selected[0])):
+			selected = []
+		selected.append(card)
+	_update()
+
+func play_selected() -> void:
+	if kind != "daifugo" or running or int(state.turn) != 0:
+		return
+	if MODULES.daifugo.play(state, 0, selected.duplicate()):
+		note = "%sを出した。" % "・".join(selected.map(func(c): return Cards.label(c)))
+		selected = []
+		_after_you()
+
+func pass_turn() -> void:
+	if running or int(state.turn) != 0 or bool(state.done):
+		return
+	match kind:
+		"daifugo":
+			if MODULES.daifugo.pass_turn(state, 0):
+				note = "パスした。"
+				_after_you()
+		"shichinarabe":
+			if MODULES.shichinarabe.pass_turn(state, 0):
+				note = "ドボン……手札を全部場に出した。" if bool(state.out[0]) and 0 in state.busted else "パスした（%d回目）。" % int(state.passes[0])
+				_after_you()
+
+## 七並べ: put a card down.
+func lay(card: String) -> void:
+	if kind != "shichinarabe" or running or int(state.turn) != 0:
+		return
+	if MODULES.shichinarabe.play(state, 0, card):
+		note = "%sを置いた。" % Cards.label(card)
+		_after_you()
+
+## 神経衰弱: turn a card over.
+func flip(cell: int) -> void:
+	if kind != "shinkei" or running or int(state.turn) != 0 or bool(state.done):
+		return
+	if not state.shown.is_empty():
+		state.shown = []
+	var before := int(state.first)
+	MODULES.shinkei.flip(state, 0, cell, profs, rng)
+	if int(state.first) == before:
+		return
+	if before >= 0:
+		var l: Dictionary = state.last
+		note = "そろった！" if bool(l.match) else "そろわなかった。"
+	_speak()
+	_update()
+	if int(state.turn) != 0 or bool(state.done):
+		_after_you()
+
+func _after_you() -> void:
+	_speak()
+	_update()
+	if bool(state.done):
+		_end()
+	else:
+		_run()
+
+# --- The end ----------------------------------------------------------------
+
+func _end() -> void:
+	var place: int = state.ranking.find(0)
+	var seats: int = state.hands.size()
+	var loser: int = state.ranking[-1]
+	var winner: int = state.ranking[0]
+	if winner > 0:
+		_bubble(winner, Cards.line(profs[winner], "first", rng))
+	if loser > 0 and loser != winner:
+		_bubble(loser, Cards.line(profs[loser], "last_sore" if int(profs[loser].temper) >= 60 else "last", rng))
+	var you := "あなたは%d位" % (place + 1)
+	if kind == "daifugo":
+		you = "あなたは%s" % MODULES.daifugo.title(place, seats)
+	note = "%s。%s。" % [MODULES[kind].summary(state, names), you]
+	results.append({"kind": kind, "ranking": state.ranking.duplicate(), "seats": seats, "summary": MODULES[kind].summary(state, names), "place": place})
+	_update()
+	_buttons([["もう一回", begin.bind(kind)], ["別のゲーム", _picker], ["終わる", _leave]])
+
+var closing := false
+
+func _leave() -> void:
+	if closing:
+		return
+	closing = true
+	if not state.is_empty():
+		state.done = true
+	running = false
+	if game != null and game.has_method("_cards_finished"):
+		game._cards_finished(mates, profs, names, results, last_said)
+	queue_free()
+
+# --- Drawing ----------------------------------------------------------------
+
+func _card(code: String, rect: Rect2, parent: Control, on_tap: Callable = Callable(), dim: bool = false) -> TextureRect:
+	var t := TextureRect.new()
+	t.texture = _tex(code)
+	t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+	t.stretch_mode = TextureRect.STRETCH_SCALE
+	t.position = rect.position
+	t.size = rect.size
+	t.mouse_filter = Control.MOUSE_FILTER_STOP if on_tap.is_valid() else Control.MOUSE_FILTER_IGNORE
+	if dim:
+		t.modulate = Color(0.55, 0.55, 0.55)
+	if on_tap.is_valid():
+		t.gui_input.connect(func(e):
+			if (e is InputEventMouseButton and e.pressed and e.button_index == MOUSE_BUTTON_LEFT) or (e is InputEventScreenTouch and e.pressed):
+				on_tap.call())
+	parent.add_child(t)
+	return t
+
+func _clear(node: Control) -> void:
+	for child in node.get_children():
+		node.remove_child(child)
+		child.queue_free()
+
+func _seats() -> void:
+	_clear(seats_row)
+	for k in range(1, names.size()):
+		var box := PanelContainer.new()
+		var current: bool = not state.is_empty() and not bool(state.get("done", true)) and int(state.turn) == k
+		var flat := UI.box(Color(0, 0, 0, 0.25), Color("#e9c46a") if current else Color(1, 1, 1, 0.12), 10, 6, 5)
+		box.add_theme_stylebox_override("panel", UI.skin_or("seat_active" if current else "seat", flat, Vector4(10, 10, 10, 10), Vector4(8, 6, 8, 6)))
+		box.custom_minimum_size.x = 92
+		seats_row.add_child(box)
+		var v := VBoxContainer.new()
+		v.add_theme_constant_override("separation", 2)
+		box.add_child(v)
+		var top := HBoxContainer.new()
+		v.add_child(top)
+		top.add_child(Portraits.avatar(Portraits.housemate_face(game.world, mates[k - 1]), names[k].left(1), 30, UI.PANEL_2, UI.TEXT))
+		var who := Label.new()
+		who.text = names[k]
+		who.clip_text = true
+		who.custom_minimum_size.x = 50
+		who.add_theme_font_size_override("font_size", 13)
+		top.add_child(who)
+		var info := Label.new()
+		info.add_theme_font_size_override("font_size", 12)
+		info.add_theme_color_override("font_color", Color("#c9d6c2"))
+		info.text = _seat_info(k)
+		v.add_child(info)
+		if bubbles.has(k) and int(bubbles[k][1]) <= 2:
+			var say := Label.new()
+			say.text = "「%s」" % bubbles[k][0]
+			say.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+			say.custom_minimum_size.x = 80
+			say.add_theme_font_size_override("font_size", 12)
+			say.add_theme_color_override("font_color", Color("#ffe7b3"))
+			v.add_child(say)
+
+func _seat_info(k: int) -> String:
+	if state.is_empty() or not state.has("hands"):
+		return ""
+	if kind == "shinkei":
+		return "%d組" % int(state.score[k])
+	if bool(state.out[k]):
+		var place: int = state.ranking.find(k)
+		if kind == "shichinarabe" and k in state.busted:
+			return "ドボン"
+		return ("%d位" % (place + 1)) if place >= 0 else "上がり"
+	var s := "%d枚" % state.hands[k].size()
+	if kind == "shichinarabe":
+		s += "・パス%d" % int(state.passes[k])
+	if kind == "daifugo" and bool(state.passed[k]):
+		s += "・パス"
+	return s
+
+func _update() -> void:
+	if center == null or hand_box == null or buttons == null or closing:
+		return
+	_seats()
+	_clear(center)
+	_clear(hand_box)
+	if state.is_empty():
+		return
+	match kind:
+		"babanuki":
+			_draw_babanuki()
+		"daifugo":
+			_draw_daifugo()
+		"shichinarabe":
+			_draw_shichinarabe()
+		"shinkei":
+			_draw_shinkei()
+	var turn_text := ""
+	if not bool(state.done):
+		turn_text = "あなたの番。" if int(state.turn) == 0 else "%sの番。" % names[int(state.turn)]
+	status.text = (note + "\n" if not note.is_empty() else "") + turn_text + _hint()
+	if not bool(state.done):
+		_buttons(_turn_buttons())
+
+func _hint() -> String:
+	if bool(state.done) or int(state.turn) != 0:
+		return ""
+	match kind:
+		"babanuki":
+			var t := str(tell.get("text", ""))
+			if int(tell.get("pos", -1)) >= 0 and not bool(profs[MODULES.babanuki.target(state, 0)].get("child", false)):
+				t += "（左から%d枚目）" % (int(tell.pos) + 1)
+			return "引く札を選ぶ。" + t
+		"daifugo":
+			return "出す札を選んで「出す」。" + ("（革命中）" if bool(state.rev) else "")
+		"shichinarabe":
+			return "明るい札が置ける。"
+		"shinkei":
+			return "札を2枚めくる。（あなた %d組）" % int(state.score[0])
+	return ""
+
+func _turn_buttons() -> Array:
+	var mine: bool = int(state.turn) == 0 and not running
+	match kind:
+		"daifugo":
+			return [["出す", play_selected, mine and MODULES.daifugo.can_play(state, selected)], ["パス", pass_turn, mine and not state.pile.is_empty()]]
+		"shichinarabe":
+			var left := MODULES.shichinarabe.PASSES - int(state.passes[0])
+			return [["パス（あと%d回）" % maxi(0, left) if left > 0 else "パス（ドボン）", pass_turn, mine]]
+	return []
+
+## Your hand along the bottom (overlapping when it is long).
+func _layout_hand(cards: Array, on_tap: Callable, dim_of: Callable, raised_of: Callable) -> void:
+	var w := hand_box.size.x
+	var h := hand_box.size.y - 14.0
+	var cw := minf(h / 1.4, 72.0)
+	var ch := cw * 1.4
+	var n := cards.size()
+	if n == 0:
+		return
+	var step := minf(cw * 0.95, (w - cw) / maxf(1.0, float(n - 1)))
+	var total := step * float(n - 1) + cw
+	var x0 := (w - total) / 2.0
+	for k in n:
+		var c: String = cards[k]
+		var y := 14.0 - (12.0 if bool(raised_of.call(c)) else 0.0)
+		_card(c, Rect2(x0 + step * k, y, cw, ch), hand_box, on_tap.bind(c) if on_tap.is_valid() else Callable(), bool(dim_of.call(c)))
+
+func _draw_babanuki() -> void:
+	var j: int = MODULES.babanuki.target(state, 0) if not bool(state.out[0]) else -1
+	if j > 0 and not bool(state.done):
+		var backs: Array = state.hands[j]
+		var w := center.size.x
+		var cw := minf(64.0, w / 6.0)
+		var ch := cw * 1.4
+		var n := backs.size()
+		var step := minf(cw * 0.9, (w - cw) / maxf(1.0, float(n - 1)))
+		var x0 := (w - (step * float(n - 1) + cw)) / 2.0
+		var y0 := center.size.y / 2.0 - ch / 2.0
+		var lbl := Label.new()
+		lbl.text = "%sの手札" % names[j]
+		lbl.position = Vector2(0, maxf(0.0, y0 - 30.0))
+		lbl.size = Vector2(w, 24)
+		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		center.add_child(lbl)
+		var mine: bool = int(state.turn) == 0 and not running
+		var sticks: bool = bool(profs[j].get("child", false)) and int(tell.get("pos", -1)) >= 0
+		for k in n:
+			var up := 14.0 if sticks and k == int(tell.pos) else 0.0
+			_card("back", Rect2(x0 + step * k, y0 - up, cw, ch), center, draw_card.bind(k) if mine else Callable())
+	_layout_hand(state.hands[0], Callable(), func(_c): return false, func(_c): return false)
+
+func _draw_daifugo() -> void:
+	var pile: Array = state.pile
+	var w := center.size.x
+	var cw := minf(76.0, w / 5.0)
+	var ch := cw * 1.4
+	var x0 := (w - (cw * 0.6 * float(maxi(0, pile.size() - 1)) + cw)) / 2.0
+	var y0 := center.size.y / 2.0 - ch / 2.0
+	for k in pile.size():
+		_card(pile[k], Rect2(x0 + cw * 0.6 * k, y0, cw, ch), center)
+	var lbl := Label.new()
+	lbl.text = ("場は空（親：%s）" % names[int(state.turn)] if pile.is_empty() and not bool(state.done) else "") + ("　革命中" if bool(state.rev) else "")
+	lbl.position = Vector2(0, maxf(0.0, y0 - 28.0))
+	lbl.size = Vector2(w, 24)
+	lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	center.add_child(lbl)
+	var mine: bool = int(state.turn) == 0 and not running and not bool(state.done)
+	var playable := {}
+	if mine:
+		for o in MODULES.daifugo.options(state, 0):
+			for c in o:
+				playable[c] = true
+	_layout_hand(state.hands[0], toggle if mine else Callable(), func(c): return mine and not playable.has(c), func(c): return c in selected)
+
+func _draw_shichinarabe() -> void:
+	var w := center.size.x
+	var cw := minf(w / 13.5, (center.size.y - 10.0) / 4.0 / 1.4)
+	var ch := cw * 1.4
+	var x0 := (w - cw * 13.0) / 2.0
+	var y0 := (center.size.y - ch * 4.0 - 9.0) / 2.0
+	for row in 4:
+		var s: String = Cards.SUITS[row]
+		for n in range(1, 14):
+			var rect := Rect2(x0 + cw * float(n - 1), y0 + (ch + 3.0) * row, cw - 1.0, ch)
+			if n in state.table[s]:
+				_card(s + Cards.RANKS[n - 1], rect, center)
+			else:
+				var slot := ColorRect.new()
+				slot.color = Color(0, 0, 0, 0.18)
+				slot.position = rect.position
+				slot.size = rect.size
+				slot.mouse_filter = Control.MOUSE_FILTER_IGNORE
+				center.add_child(slot)
+	var mine: bool = int(state.turn) == 0 and not running and not bool(state.done)
+	_layout_hand(state.hands[0], lay if mine else Callable(), func(c): return not MODULES.shichinarabe.playable(state, c), func(c): return mine and MODULES.shichinarabe.playable(state, c))
+
+func _draw_shinkei() -> void:
+	var cols: int = MODULES.shinkei.COLS
+	var rows: int = MODULES.shinkei.ROWS
+	var w := center.size.x
+	var cw := minf((w - 5.0 * cols) / float(cols), (center.size.y - 6.0 * rows) / float(rows) / 1.4)
+	var ch := cw * 1.4
+	var x0 := (w - (cw + 5.0) * cols) / 2.0
+	var y0 := (center.size.y - (ch + 6.0) * rows) / 2.0
+	var mine: bool = int(state.turn) == 0 and not running and not bool(state.done)
+	for k in state.grid.size():
+		var rect := Rect2(x0 + (cw + 5.0) * (k % cols), y0 + (ch + 6.0) * (k / cols), cw, ch)
+		if int(state.owner[k]) >= 0:
+			var gone := _card(state.grid[k], rect, center)
+			gone.modulate = Color(1, 1, 1, 0.25)
+			continue
+		var up: bool = k == int(state.first) or k in state.shown
+		_card(state.grid[k] if up else "back", rect, center, flip.bind(k) if mine and not up else Callable())
