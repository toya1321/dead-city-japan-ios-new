+		failures += 1
+func days_until_ripe(w, crop: String, start_minute: int) -> int:
+	w.s.plots = [{"growth": 0.0, "water": 500.0, "crop": crop}]
+	w.s.minute = start_minute
+	for h in 400 * 24:
+		w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.health = 100.0; w.s.fatigue = 0.0
+		w.s.walkers.places = {}
+		w.advance(60)
+		if float(w.s.plots[0].growth) >= 1.0:
+			return (int(w.s.minute) - start_minute) / 1440 + 1
+	return 999
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	check(Crops.named("小松菜を植える") == "komatsuna" and Crops.named("じゃがいもを育てる") == "potato" and Crops.named("かいわれを育てる") == "kaiware", "crops are known by name")
+	# Sowing uses a planter and seeds (or seed potatoes from the food store).
+	g.location = "台所"
+	g._sync_player_position()
+	w.s.inventory.planter = 3
+	w.s.inventory.seeds = 2
+	w.s.food = 5.0
+	await g._on_command("小松菜を植える")
+	check(w.s.plots.size() == 1 and str(w.s.plots[0].crop) == "komatsuna" and int(w.s.inventory.seeds) == 1 and g.log_entries[-1].contains("日ほどで収穫"), "komatsuna sown, with how long it will take: " + g.log_entries[-1])
+	await g._on_command("じゃがいもを植える")
+	check(w.s.plots.size() == 2 and float(w.s.food) == 4.5, "potatoes are sown from the food store")
+	# Real timetables: cress in a week indoors, potatoes in months, and winter slows them.
+	var cress := days_until_ripe(w, "kaiware", 0)
+	check(cress >= 7 and cress <= 9, "cress on the windowsill is ready in about a week (%d days)" % cress)
+	# 10 November start: greens in late autumn take longer than their 35 days.
+	var greens := days_until_ripe(w, "komatsuna", 0)
+	check(greens > 35 and greens < 90, "komatsuna sown in November takes longer than in spring (%d days)" % greens)
+	w.s.minute = 30 * 1440   # December
+	check(Crops.season(w, "sweetpotato") < 0.5, "sweet potatoes barely grow in the cold")
+	# Harvest gives the crop's own yield and frees the planter.
+	w.s.plots = [{"growth": 1.0, "water": 1.0, "crop": "potato"}]
+	var food := float(w.s.food)
+	var planters := int(w.s.inventory.planter)
+	await g._on_command("収穫する")
+	check(float(w.s.food) == food + 3.0 and int(w.s.inventory.planter) == planters + 1 and w.s.plots.is_empty(), "potatoes feed for days, and the planter is free again")
+	# River water: drawn, carried home, boiled.
+	w.s.society = "emergency"
+	w.s.minute = 6 * 1440 + 4 * 60
+	w.s.district.bag.water = 0.0
+	g.location = "川沿いの土手"
+	g._sync_player_position()
+	check(g._suggestions().has("水を汲む"), "at the river, drawing water is offered")
+	await g._on_command("水を汲む")
+	check(float(w.s.get("raw_carry", 0.0)) == 8.0, "eight litres drawn, not yet drinkable")
+	w.s.walkers.places = {}
+	w.s.walkers.encounter = {}
+	var rain := float(w.s.rain_water)
+	await g._on_command("家に帰る")
+	check(float(w.s.rain_water) == rain + 8.0 and float(w.s.get("raw_carry", 0.0)) == 0.0, "carried home into the untreated store")
+	await g._on_command("台所へ行く")
+	var water := float(w.s.water)
+	w.s.gas_cans = 2.0
+	await g._on_command("水を煮沸する")
+	check(float(w.s.water) == water + 4.0, "boiled, it is drinking water: " + g.log_entries[-1])
+	print("v149.36 crop checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
diff --git a/tests/test_dwellings149_37.gd b/tests/test_dwellings149_37.gd
new file mode 100644
index 0000000..4a6de1a
--- /dev/null
+++ b/tests/test_dwellings149_37.gd
@@ -0,0 +1,90 @@
+extends SceneTree
+## v149.37: homes searched one at a time — the same home is the same every
+## time, only what changed is saved, locked doors can be forced (noisily),
+## something may be inside, survivors' combing leaves homes ransacked, and
+## the old all-at-once search is gone.
+const Main = preload("res://main.tscn")
+const Dwellings = preload("res://scripts/dwellings.gd")
+const District = preload("res://scripts/district.gd")
+const Combat = preload("res://scripts/combat.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func find(w, area: String, test: Callable) -> int:
+	for i in Dwellings.count(area):
+		if test.call(Dwellings.home(w, area, i)):
+			return i
+	return -1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.society = "emergency"
+	w.s.minute = 6 * 1440 + 3 * 60
+	w.s.walkers.places = {}
+	g.location = "団地"
+	g._sync_player_position()
+	# Addresses read both ways; a home is the same every time.
+	check(Dwellings.address("団地", 47) == "3号棟204号室" and Dwellings.index_of("団地", "3号棟204号室に入る") == 47, "estate flats have block, floor and number")
+	check(Dwellings.address("駅前のマンション", 103) == "1204号室" and Dwellings.index_of("駅前のマンション", "1204号室") == 103, "tower flats have floor and number")
+	check(JSON.stringify(Dwellings.home(w, "団地", 47)) == JSON.stringify(Dwellings.home(w, "団地", 47)), "a home is worked out the same every time")
+	var size_before := JSON.stringify(w.s).length()
+	check(not w.s.district.has("units") or w.s.district.units.is_empty(), "nothing is saved for homes nobody entered")
+	# The old all-at-once search is gone: it now goes in through one door.
+	check(g._suggestions().has("次の部屋を探す") and not g._suggestions().has("空き家を探す"), "the way to search is home by home")
+	var open_i := find(w, "団地", func(h): return not bool(h.locked) and not bool(h.walker))
+	await g._on_command("%sに入る" % Dwellings.address("団地", open_i))
+	check(Dwellings.inside(w) and g.log_entries[-1].contains("暮らしていたらしい") and g.log_entries[-1].contains("調べられる場所"), "going in tells who lived there and what can be searched: " + g.log_entries[-1].left(120))
+	check(g._suggestions().has("台所を調べる") and g._suggestions().has("部屋を出る"), "the rooms are offered")
+	var food := float(w.s.district.bag.food)
+	var pool := float(District.houses(w, "団地").food)
+	await g._on_command("台所を調べる")
+	var got := float(w.s.district.bag.food) - food
+	check(got > 0.0 and float(District.houses(w, "団地").food) == pool - got, "the kitchen gives food, taken from the area's store (shared with survivors)")
+	await g._on_command("台所を調べる")
+	check(g.log_entries[-1].contains("もう調べた"), "a room searched stays searched")
+	await g._on_command("部屋を出る")
+	check(not Dwellings.inside(w), "leaving the flat")
+	# A locked door: forced with a tool, loudly.
+	var locked_i := find(w, "団地", func(h): return bool(h.locked) and not bool(h.walker))
+	await g._on_command("%sに入る" % Dwellings.address("団地", locked_i))
+	check(g.log_entries[-1].contains("鍵がかかっている") and g._suggestions().has("ドアをこじ開ける"), "a locked door stops you at it")
+	load("res://scripts/weapons.gd").state(w).weapons.append({"type": "bar", "wear": 80})
+	await g._on_command("ドアをこじ開ける")
+	check(g.log_entries[-1].contains("錠が外れた") and int(w.s.walkers.noise.get("団地", -1)) >= int(w.s.minute), "a bar opens it, with a noise that carries")
+	await g._on_command("%sに入る" % Dwellings.address("団地", locked_i))
+	check(Dwellings.inside(w) and not g.log_entries[-1].contains("鍵がかかっている"), "and the door stays open")
+	# Something inside: the fight is in a room.
+	var walker_i := find(w, "団地", func(h): return bool(h.walker) and not bool(h.locked))
+	w.s.walkers.places = {}
+	await g._on_command("%sに入る" % Dwellings.address("団地", walker_i))
+	check(Combat.active(w) and Combat.terrain(w) == "room", "something inside means a fight in a room")
+	w.s.walkers.encounter = {}
+	w.s.walkers.places = {}
+	await g._on_command("台所を調べる")
+	check(bool(Dwellings.state(w, "団地", walker_i).cleared), "once it is dealt with, the flat can be searched")
+	# Survivors combing the estate leave homes ransacked.
+	var store: Dictionary = District.houses(w, "団地")
+	store.food = 0.0
+	var later := find(w, "団地", func(h): return not bool(h.locked) and not bool(h.walker) and not bool(h.body))
+	var j := later
+	while Dwellings._peek_state(w, "団地", j).size() > 0:
+		j += 1
+	await g._on_command("%sに入る" % Dwellings.address("団地", j))
+	check(g.log_entries[-1].contains("あさっていった"), "with the estate combed through, a flat is found ransacked")
+	# Only what changed is saved; it survives a reload.
+	g._save()
+	g._load()
+	check(bool(Dwellings._peek_state(g.world, "団地", open_i).get("rooms_done", []).has("台所")) and JSON.stringify(g.world.s).length() - size_before < 4000, "what changed is saved, and little else")
+	print("v149.37 dwelling checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
