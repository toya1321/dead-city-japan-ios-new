--- /dev/null
+++ b/scripts/dwellings.gd
@@ -0,0 +1,307 @@
+extends RefCounted
+## v149.37: homes searched one at a time. Every home in a residential area
+## (a block of the estate, a flat in the tower, a house on the street) is
+## worked out from the world's seed when someone first goes in — who lived
+## there, how it is laid out, what was left in each room, whether the door
+## is locked, whether something is still inside — and only what changes is
+## saved. Survivors who comb an area empty homes too (the area's store in
+## district.gd counts what they took); a home they have been through is
+## found ransacked. Nothing is decided at the door for the player's sake.
+##
+## s.district.units = {area: {index: {rooms_done[], opened, cleared, taken}}}
+## s.inside = {area, index} while the player is in a home.
+
+const TownMap = preload("res://scripts/town_map.gd")
+const District = preload("res://scripts/district.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+
+const FAMILIES := [
+	["一人暮らしの高齢者", 22, ["写真立ての中で、着物姿の夫婦が笑っている。", "カレンダーに、病院の予約の丸印が並んでいる。"]],
+	["老夫婦", 18, ["食卓に、湯のみが二つ並んだまま。", "仏壇の前に、線香の灰が落ちている。"]],
+	["子どものいる家族", 22, ["冷蔵庫に、子どもの描いた絵が貼られている。", "玄関に、小さな運動靴がそろえて置いてある。"]],
+	["共働きの夫婦", 14, ["ソファの上に、ノートパソコンが開いたまま。", "壁のホワイトボードに「帰りに牛乳」と書いてある。"]],
+	["学生の一人暮らし", 12, ["床に、教科書とカップ麺の容器が散らばっている。", "壁に、バンドのポスターが貼ってある。"]],
+	["単身の会社員", 12, ["玄関に、スーツが一着、かけたまま。", "机の上に、出張用の小さなスーツケースがある。"]],
+]
+const NOTES := [
+	"台所のテーブルに書き置きがあった。「先に避難所へ行きます。あとで来て」",
+	"冷蔵庫に貼られたメモ。「〇〇ちゃんの実家（千葉）に向かいます」",
+	"居間の床に、走り書きの紙。「噛まれた。もう出られない。ごめん」",
+	"玄関のドアの内側に、テープで留めた紙。「生きています。食べ物を分けてください」",
+	"テレビの前に、家族全員の名前を書いた避難先のメモが残っている。",
+]
+
+## The rooms a home has, by kind of building.
+static func rooms_of(area: String, family: String) -> Array:
+	var rooms: Array = ["台所", "居間", "寝室", "押し入れ", "風呂場"]
+	if family == "子どものいる家族":
+		rooms.insert(3, "子ども部屋")
+	if area in ["住宅街", "北の住宅街", "南の住宅街"]:
+		rooms.append("物置")
+	return rooms
+
+static func count(area: String) -> int:
+	return District.homes_in(area)
+
+## Where home number i is: "3号棟204号室", "1205号室", "12番の家".
+static func address(area: String, i: int) -> String:
+	match area:
+		"団地":
+			var per_block := 20
+			var block := i / per_block + 1
+			var floor := (i % per_block) / 4 + 1
+			return "%d号棟%d%02d号室" % [block, floor, i % 4 + 1]
+		"駅前のマンション":
+			return "%d%02d号室" % [i / 10 + 2, i % 10 + 1]
+	return "%d番の家" % (i + 1)
+
+static func floor_of(area: String, i: int) -> int:
+	match area:
+		"団地": return (i % 20) / 4 + 1
+		"駅前のマンション": return i / 10 + 2
+	return 1
+
+static func _h(world, area: String, i: int, salt: String) -> int:
+	return absi(hash([int(world.s.seed), area, i, salt]))
+
+## What this home was, worked out the same way every time.
+static func home(world, area: String, i: int) -> Dictionary:
+	var total := 0
+	for f in FAMILIES:
+		total += int(f[1])
+	var roll := _h(world, area, i, "family") % total
+	var family: Array = FAMILIES[0]
+	for f in FAMILIES:
+		roll -= int(f[1])
+		if roll < 0:
+			family = f
+			break
+	var lock := _h(world, area, i, "lock") % 100
+	var inside := _h(world, area, i, "inside") % 100
+	return {"family": str(family[0]), "detail": str(family[2][_h(world, area, i, "detail") % family[2].size()]),
+		"locked": lock < 40, "walker": inside < 9, "body": inside >= 9 and inside < 15,
+		"note": NOTES[_h(world, area, i, "note") % NOTES.size()] if _h(world, area, i, "has-note") % 100 < 25 else "",
+		"rooms": rooms_of(area, str(family[0]))}
+
+## Whether the survivors combing this area got here first.
+static func ransacked(world, area: String, i: int) -> bool:
+	var pool: Dictionary = District.houses(world, area)
+	var n := float(maxi(1, count(area)))
+	var taken := clampf(1.0 - float(pool.food) / (n * TownMap.FOOD_PER_HOME), 0.0, 1.0)
+	return float(_h(world, area, i, "order") % 1000) / 1000.0 < taken
+
+static func state(world, area: String, i: int) -> Dictionary:
+	var d: Dictionary = world.s.district
+	if not d.get("units") is Dictionary:
+		d.units = {}
+	if not d.units.has(area):
+		d.units[area] = {}
+	var key := str(i)
+	if not d.units[area].has(key):
+		d.units[area][key] = {"rooms_done": [], "opened": false, "cleared": false}
+	return d.units[area][key]
+
+static func _peek_state(world, area: String, i: int) -> Dictionary:
+	var units = world.s.district.get("units", {})
+	return units.get(area, {}).get(str(i), {}) if units is Dictionary else {}
+
+## The next home along that has not been looked into yet.
+static func next_index(world, area: String) -> int:
+	var units = world.s.district.get("units", {})
+	var seen: Dictionary = units.get(area, {}) if units is Dictionary else {}
+	for i in count(area):
+		if not seen.has(str(i)):
+			return i
+	return -1
+
+## Reads "3号棟204号室" / "1205号室" / "12番の家" back to an index (-1 if not one).
+static func index_of(area: String, text: String) -> int:
+	var re := RegEx.new()
+	match area:
+		"団地":
+			re.compile("([0-9]+)号棟\\s*([0-9])([0-9]{2})号室")
+			var m := re.search(text)
+			if m == null:
+				return -1
+			var i := (int(m.get_string(1)) - 1) * 20 + (int(m.get_string(2)) - 1) * 4 + int(m.get_string(3)) - 1
+			return i if i >= 0 and i < count(area) else -1
+		"駅前のマンション":
+			re.compile("([0-9]{1,2})([0-9]{2})号室")
+			var m := re.search(text)
+			if m == null:
+				return -1
+			var i := (int(m.get_string(1)) - 2) * 10 + int(m.get_string(2)) - 1
+			return i if i >= 0 and i < count(area) else -1
+	re.compile("([0-9]+)番の家")
+	var m := re.search(text)
+	if m == null:
+		return -1
+	var i := int(m.get_string(1)) - 1
+	return i if i >= 0 and i < count(area) else -1
+
+## Going to the door (and in, if it opens). Returns {text, walker}.
+static func enter(world, area: String, i: int) -> Dictionary:
+	var h := home(world, area, i)
+	var st := state(world, area, i)
+	var addr := address(area, i)
+	# Stairs (and a lift only while the power is on).
+	var floor := floor_of(area, i)
+	var climb := 1 if floor <= 1 else (2 if area == "駅前のマンション" and world.has_home_power() else floor)
+	world.advance_safe(2 + climb)
+	var lines: Array = []
+	if floor >= 3:
+		lines.append("%s階まで%s。" % [floor, "エレベーターで上がった" if area == "駅前のマンション" and world.has_home_power() else "階段を上がった"])
+	if bool(h.locked) and not bool(st.opened) and not ransacked(world, area, i):
+		world.s.inside = {"area": area, "index": i, "at_door": true}
+		lines.append("%sの前に立った。表札は外されている。ドアには鍵がかかっている。（「ドアをこじ開ける」で開けられるが、音が出る）" % addr)
+		return {"text": " ".join(lines), "walker": false}
+	st.opened = true
+	world.s.inside = {"area": area, "index": i}
+	if ransacked(world, area, i) and st.rooms_done.is_empty():
+		lines.append("%sに入った。ドアは壊され、引き出しという引き出しが開けられている。誰かが先に来て、あさっていったようだ。" % addr)
+	else:
+		lines.append("%sに入った。%sが暮らしていたらしい。%s" % [addr, h.family, h.detail])
+	if not str(h.note).is_empty() and not st.rooms_done.has("note"):
+		lines.append(str(h.note))
+		st.rooms_done.append("note")
+	if bool(h.body) and not bool(st.cleared):
+		lines.append("寝室の前に、住人だった人が倒れている。もう動かない。")
+	var walker := bool(h.walker) and not bool(st.cleared) and str(world.s.get("society", "normal")) in ["disrupted", "emergency"]
+	if walker:
+		st.walker_pending = true
+		lines.append("【危険】奥の部屋で、何かがゆっくりと起き上がった。")
+	lines.append("調べられる場所：%s" % "、".join(rooms_left(world, area, i)))
+	return {"text": " ".join(lines), "walker": walker}
+
+static func force_door(world) -> String:
+	var at: Dictionary = world.s.get("inside", {})
+	if at.is_empty() or not bool(at.get("at_door", false)):
+		return "こじ開ける扉が前にない。"
+	var Weapons = load("res://scripts/weapons.gd")
+	var tool := ""
+	for t in ["bar", "pipe", "nailbat", "bat"]:
+		if Weapons.owns(world, t):
+			tool = t
+			break
+	if tool.is_empty():
+		return "こじ開けられる道具がない。（バールや鉄パイプがあれば開けられる）"
+	world.advance_safe(5)
+	Walkers.make_noise(world, str(at.area), 60)
+	state(world, str(at.area), int(at.index)).opened = true
+	world.s.inside = {}
+	return "%sをドアの隙間にねじ込み、力をこめた。金属がきしむ大きな音がして、錠が外れた。" % Weapons.name_of(tool)
+
+static func rooms_left(world, area: String, i: int) -> Array:
+	var st := _peek_state(world, area, i)
+	var done: Array = st.get("rooms_done", [])
+	return home(world, area, i).rooms.filter(func(r): return not r in done)
+
+## What one room holds (the same every time it is first opened).
+static func _room_goods(world, area: String, i: int, room: String) -> Dictionary:
+	var r := func(salt: String, n: int) -> int: return _h(world, area, i, room + salt) % n
+	match room:
+		"台所":
+			return {"food": float(2 + r.call("f", 4)), "water": float(2 * r.call("w", 3))}
+		"押し入れ":
+			# The emergency kit the city told everyone to keep.
+			var kit: bool = r.call("kit", 100) < 45
+			return {"food": 2.0 if kit else 0.0, "water": 6.0 if kit else 0.0, "bandage": 2 if kit else 0, "blanket": 1 if r.call("b", 100) < 70 else 0}
+		"居間":
+			return {"cigarettes": 20 * (1 if r.call("c", 100) < 25 else 0), "cash": 1000 * r.call("cash", 6)}
+		"寝室":
+			return {"cash": 1000 * r.call("cash", 15), "blanket": 1 if r.call("b", 100) < 50 else 0}
+		"子ども部屋":
+			return {"weapon": "bat" if r.call("bat", 100) < 30 else ""}
+		"風呂場":
+			return {"water": float(4 * (1 if r.call("w", 100) < 30 else 0))}
+		"物置":
+			return {"wood": r.call("wd", 3), "parts": r.call("pt", 2), "seeds": 1 if r.call("s", 100) < 40 else 0, "weapon": "golf" if r.call("g", 100) < 15 else ""}
+	return {}
+
+## Searching a room: ten minutes, and what is there is taken (what can be
+## carried); a ransacked home has little left but what nobody wanted.
+static func search(world, room: String) -> String:
+	var at: Dictionary = world.s.get("inside", {})
+	if at.is_empty() or bool(at.get("at_door", false)):
