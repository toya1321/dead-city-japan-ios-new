diff --git a/scripts/cards_shinkei.gd b/scripts/cards_shinkei.gd
new file mode 100644
index 0000000..1741313
--- /dev/null
+++ b/scripts/cards_shinkei.gd
@@ -0,0 +1,132 @@
+extends RefCounted
+## v149.35: 神経衰弱 — 24 cards (twelve pairs) face down in a 6×4 grid. Turn
+## two over; a pair is yours and you go again; otherwise they go back.
+## Everyone remembers what they have seen as well as they can: children
+## best, the old least; the kind "forget" a pair now and then when well
+## ahead. Seat 0 is you.
+
+const Cards = preload("res://scripts/cards.gd")
+const COLS := 6
+const ROWS := 4
+
+static func start(seats: int, rng: RandomNumberGenerator) -> Dictionary:
+	var state := Cards.base_state("shinkei", seats)
+	var cards: Array = []
+	for r in Cards.RANKS.slice(0, 12):
+		var suits := Cards.shuffled(Cards.SUITS, rng)
+		cards.append(suits[0] + r)
+		cards.append(suits[1] + r)
+	state.grid = Cards.shuffled(cards, rng)
+	state.owner = []
+	for k in state.grid.size():
+		state.owner.append(-1)
+	state.score = []
+	state.memory = []
+	for i in seats:
+		state.score.append(0)
+		state.memory.append({})
+	state.first = -1
+	state.shown = []        # the two cards just turned (a miss, to be turned back)
+	return state
+
+static func open_cells(state: Dictionary) -> Array:
+	var out: Array = []
+	for k in state.grid.size():
+		if int(state.owner[k]) < 0:
+			out.append(k)
+	return out
+
+## Everyone at the table sees a card turned over; each remembers it as well
+## as they can.
+static func _seen(state: Dictionary, cell: int, profs: Array, rng: RandomNumberGenerator) -> void:
+	for i in state.hands.size():
+		if i == 0:
+			continue
+		if rng.randf() < float(profs[i].get("memory", 0.6)):
+			state.memory[i][cell] = Cards.rank(state.grid[cell])
+
+## Seat i turns over `cell`. Returns true when the turn goes on.
+static func flip(state: Dictionary, i: int, cell: int, profs: Array, rng: RandomNumberGenerator) -> bool:
+	if bool(state.done) or int(state.turn) != i or cell < 0 or cell >= state.grid.size() or int(state.owner[cell]) >= 0 or cell == int(state.first):
+		return false
+	state.shown = []
+	_seen(state, cell, profs, rng)
+	if int(state.first) < 0:
+		state.first = cell
+		return true
+	var a := int(state.first)
+	state.first = -1
+	if Cards.rank(state.grid[a]) == Cards.rank(state.grid[cell]):
+		state.owner[a] = i
+		state.owner[cell] = i
+		state.score[i] = int(state.score[i]) + 1
+		for m in state.memory:
+			m.erase(a)
+			m.erase(cell)
+		state.last = {"by": i, "cells": [a, cell], "match": true}
+		if i > 0 and rng.randf() < 0.5:
+			state.say.append([i, "match"])
+		if open_cells(state).is_empty():
+			_end(state)
+		return true
+	state.shown = [a, cell]
+	state.last = {"by": i, "cells": [a, cell], "match": false}
+	if i > 0 and rng.randf() < 0.25:
+		state.say.append([i, "miss"])
+	# Memories fade a little each turn.
+	for k in state.memory.size():
+		if k == 0:
+			continue
+		for c in state.memory[k].keys():
+			if rng.randf() < (1.0 - float(profs[k].get("memory", 0.6))) * 0.25:
+				state.memory[k].erase(c)
+	state.turn = (i + 1) % state.hands.size()
+	return false
+
+static func _end(state: Dictionary) -> void:
+	state.done = true
+	var order: Array = range(state.hands.size())
+	order.sort_custom(func(a, b): return int(state.score[a]) > int(state.score[b]) or (int(state.score[a]) == int(state.score[b]) and a < b))
+	state.ranking = order
+
+## A housemate's two turns-over (repeating while they find pairs).
+static func ai_flip(state: Dictionary, i: int, profs: Array, rng: RandomNumberGenerator) -> void:
+	var prof: Dictionary = profs[i]
+	var mem: Dictionary = state.memory[i]
+	var open := open_cells(state)
+	if open.is_empty():
+		return
+	if int(state.first) >= 0:
+		var r := Cards.rank(state.grid[int(state.first)])
+		for c in mem:
+			if c != int(state.first) and str(mem[c]) == r and int(state.owner[c]) < 0:
+				flip(state, i, c, profs, rng)
+				return
+		flip(state, i, _unknown(state, mem, open, rng), profs, rng)
+		return
+	# A pair they remember.
+	var lead := int(state.score[i]) - int(state.score[0])
+	var easy: bool = str(prof.style) == "gentle" and lead >= 3 and rng.randf() < 0.5
+	if not easy:
+		var by_rank := {}
+		for c in mem:
+			if int(state.owner[c]) >= 0:
+				continue
+			var r: String = mem[c]
+			if by_rank.has(r):
+				flip(state, i, int(by_rank[r]), profs, rng)
+				return
+			by_rank[r] = c
+	flip(state, i, _unknown(state, mem, open, rng), profs, rng)
+
+static func _unknown(state: Dictionary, mem: Dictionary, open: Array, rng: RandomNumberGenerator) -> int:
+	var fresh := open.filter(func(c): return not mem.has(c) and c != int(state.first))
+	if fresh.is_empty():
+		fresh = open.filter(func(c): return c != int(state.first))
+	return int(fresh[rng.randi_range(0, fresh.size() - 1)])
+
+static func summary(state: Dictionary, names: Array) -> String:
+	var parts: Array = []
+	for i in state.ranking:
+		parts.append("%s %d組" % [names[i], int(state.score[i])])
+	return "・".join(parts)
