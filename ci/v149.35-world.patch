+extends SceneTree
+## v149.36: the wider town — reachable on foot, its shops and buildings work
+## like the old ones, its houses can be searched, its walkers and survivors
+## move through it, old saves gain it, and every place has a picture.
+const Main = preload("res://main.tscn")
+const TownMap = preload("res://scripts/town_map.gd")
+const District = preload("res://scripts/district.gd")
+const Navigation = preload("res://scripts/navigation.gd")
+const ShopWindow = preload("res://scripts/shop_window.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const NpcLife = preload("res://scripts/npc_life.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	# Every new place can be walked to from the house.
+	var unreachable: Array = []
+	for place in TownMap.PLACES:
+		if Navigation.route("寝室", place, "一戸建て").is_empty():
+			unreachable.append(place)
+	check(unreachable.is_empty(), "every place in the wider town can be reached on foot %s" % str(unreachable))
+	check(TownMap.PLACES.size() >= 18, "the town has grown by %d places" % TownMap.PLACES.size())
+	check(Navigation.destination("スーパーへ行く") == "スーパー" and Navigation.destination("団地に行く") == "団地" and Navigation.destination("土手へ行く") == "川沿いの土手", "places are known by everyday names")
+	# A trip takes the time the town's size makes it.
+	var start := int(w.s.minute)
+	w.s.minute = 2 * 60
+	await g._on_command("団地へ行く")
+	check(g.location == "団地" and int(w.s.minute) - 2 * 60 >= 15, "walking to the estate takes a while (%d min)" % (int(w.s.minute) - 2 * 60))
+	check(g._look().contains("団地"), "and it is described")
+	# v149.37: its own photo once made; never another place's photo standing in.
+	check(g.scene_view.location_texture("団地", "", "normal").resource_path.ends_with("danchi.jpg") and not g.district_card.visible, "the estate shows its own photo")
+	check(g.scene_view.location_texture("どこでもない場所", "no_such_photo", "normal") == null, "a place without a photo borrows none (the frame shows its name)")
+	# The supermarket sells; the home centre sells timber and fittings.
+	await g._on_command("スーパーへ行く")
+	var names: Array = ShopWindow.offers(g).map(func(o): return str(o.name))
+	check(g.location == "スーパー" and names.has("食料") and names.has("包帯"), "the supermarket sells food, water and more: %s" % str(names))
+	var cash := int(w.s.cash)
+	await g._on_command("包帯を2個買う")
+	check(int(w.s.cash) == cash - 600 and int(w.s.inventory.bandage) >= 2, "and buying works")
+	await g._on_command("ホームセンターへ行く")
+	names = ShopWindow.offers(g).map(func(o): return str(o.name))
+	check(names.has("木材") and names.has("部品") and names.has("カセットボンベ"), "the home centre sells timber, fittings and gas: %s" % str(names))
+	# When it falls, what is left can be carried off.
+	w.s.society = "emergency"
+
+	# (v149.38: these tests are about searching empty homes; the families are gone)
+	for area_e in w.s.residents.hh:
+		for r_e in w.s.residents.hh[area_e]:
+			r_e[0] = "away"
+	w.s.district.sites["ホームセンター"].vacant = true
+	var wood := int(w.s.inventory.wood)
+	await g._on_command("物資を探索する")
+	check(int(w.s.inventory.wood) > wood and g.log_entries[-1].contains("ほかにも見つけた"), "an abandoned home centre gives up timber: " + g.log_entries[-1].get_slice("\n", 1))
+	# The estate's homes are a store of their own, larger than the old street's.
+	var estate: Dictionary = District.houses(w, "団地")
+	var street: Dictionary = District.houses(w, "住宅街")
+	check(float(estate.food) > float(street.food), "the estate holds more than the old street (%.0f vs %.0f)" % [float(estate.food), float(street.food)])
+	await g._on_command("団地へ行く")
+	# v149.37: homes are searched one at a time (see test_dwellings149_37).
+	var Dwellings = load("res://scripts/dwellings.gd")
+	var pick := 0
+	while bool(Dwellings.home(w, "団地", pick).locked) or bool(Dwellings.home(w, "団地", pick).walker):
+		pick += 1
+	await g._on_command("%sに入る" % Dwellings.address("団地", pick))
+	var bag := float(w.s.district.bag.food)
+	await g._on_command("台所を調べる")
+	check(float(w.s.district.bag.food) > bag, "searching a kitchen in the estate turns up food")
+	# The dead and the living reach the new places.
+	check("団地" in Walkers.OUTDOOR and "ホームセンター" in Walkers.BUILDINGS and "大通り" in NpcLife.PLACES, "walkers and survivors move through the new places")
+	# An old save gains the new buildings and keeps its own houses store.
+	var old: Dictionary = w.s.district.duplicate(true)
+	for place in TownMap.buildings():
+		old.sites.erase(place)
+	old.erase("houses_by")
+	old.houses = {"food": 33.0, "water": 44.0}
+	District.upgrade(old)
+	check(District.valid(old), "an older district is brought up to date")
+	w.s.district = old
+	check(float(District.houses(w, "住宅街").food) == 33.0, "and its old street keeps what was left")
+	print("v149.36 town checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
