+extends RefCounted
+## v149.35: ババ抜き. 52 cards and one joker, all dealt; pairs of a rank are
+## thrown out; in turn each draws a card from the next player still in. The
+## one left holding the joker loses.
+## Who they are shows: an honest housemate's face gives away the joker when
+## they draw it (and their eyes stray to it when you are about to draw); a
+## not-so-honest one glances at the wrong card on purpose; a child's joker
+## sticks up out of their hand; the wary keep a straight face.
+## Seat 0 is you.
+
+const Cards = preload("res://scripts/cards.gd")
+
+static func start(seats: int, rng: RandomNumberGenerator) -> Dictionary:
+	var state := Cards.base_state("babanuki", seats)
+	var deck := Cards.shuffled(Cards.deck(1), rng)
+	for k in deck.size():
+		state.hands[k % seats].append(deck[k])
+	for i in seats:
+		_throw_pairs(state.hands[i])
+		state.hands[i] = Cards.shuffled(state.hands[i], rng)
+	for i in seats:
+		if state.hands[i].is_empty():
+			Cards.finish_seat(state, i)
+	state.turn = 0 if not bool(state.out[0]) else Cards.next_seat(state, 0)
+	_check_end(state)
+	return state
+
+static func _throw_pairs(hand: Array) -> void:
+	var by_rank := {}
+	for c in hand:
+		if not Cards.joker(c):
+			by_rank[Cards.rank(c)] = by_rank.get(Cards.rank(c), 0) + 1
+	for r in by_rank:
+		var pairs: int = by_rank[r] / 2
+		for p in pairs * 2:
+			for c in hand:
+				if not Cards.joker(c) and Cards.rank(c) == r:
+					hand.erase(c)
+					break
+
+## Whose hand seat `i` draws from.
+static func target(state: Dictionary, i: int) -> int:
+	return Cards.next_seat(state, i)
+
+static func holds_joker(state: Dictionary, i: int) -> bool:
+	for c in state.hands[i]:
+		if Cards.joker(c):
+			return true
+	return false
+
+## Seat `i` draws card `pos` from their target.
+static func draw(state: Dictionary, i: int, pos: int, profs: Array, rng: RandomNumberGenerator) -> String:
+	if bool(state.done) or int(state.turn) != i:
+		return ""
+	var j := target(state, i)
+	if j < 0:
+		return ""
+	var from: Array = state.hands[j]
+	pos = clampi(pos, 0, from.size() - 1)
+	var card: String = from[pos]
+	from.remove_at(pos)
+	var mine: Array = state.hands[i]
+	var paired := ""
+	if not Cards.joker(card):
+		for c in mine:
+			if not Cards.joker(c) and Cards.rank(c) == Cards.rank(card):
+				paired = c
+				break
+	if paired.is_empty():
+		mine.append(card)
+	else:
+		mine.erase(paired)
+	# Faces: the honest (and children) show it when the joker comes or goes.
+	if Cards.joker(card):
+		if i > 0 and _shows(profs[i]):
+			state.say.append([i, "got_joker"])
+		if j > 0 and _shows(profs[j]):
+			state.say.append([j, "joker_gone"])
+	elif not paired.is_empty() and i > 0 and rng.randf() < 0.3:
+		state.say.append([i, "pair"])
+	if i > 0:
+		state.hands[i] = Cards.shuffled(mine, rng)
+	state.last = {"by": i, "from": j, "card": card, "paired": paired}
+	if from.is_empty():
+		Cards.finish_seat(state, j)
+	if mine.is_empty() and not paired.is_empty():
+		Cards.finish_seat(state, i)
+	elif state.hands[i].is_empty():
+		Cards.finish_seat(state, i)
+	_check_end(state)
+	if not bool(state.done):
+		state.turn = Cards.next_seat(state, i)
+	return card
+
+static func _shows(prof: Dictionary) -> bool:
+	return bool(prof.get("child", false)) or int(prof.get("honest", 50)) >= 60
+
+static func _check_end(state: Dictionary) -> void:
+	var left := Cards.active(state)
+	if left.size() <= 1:
+		if left.size() == 1:
+			state.out[left[0]] = true
+			state.ranking.append(left[0])
+		state.done = true
+
+## A housemate's turn: they draw at random (nobody can see your cards).
+static func ai(state: Dictionary, i: int, profs: Array, rng: RandomNumberGenerator) -> void:
+	var j := target(state, i)
+	if j < 0:
+		return
+	draw(state, i, rng.randi_range(0, state.hands[j].size() - 1), profs, rng)
+
+## As you are about to draw from seat `j`: what you can read off them.
+## {pos: card index or -1, text}. Truthful for children and the honest; a
+## sly one looks at the wrong card; the wary give nothing away.
+static func tell(state: Dictionary, j: int, prof: Dictionary, name: String, rng: RandomNumberGenerator) -> Dictionary:
+	var hand: Array = state.hands[j]
+	var at := -1
+	for k in hand.size():
+		if Cards.joker(hand[k]):
+			at = k
+	if at < 0 or hand.size() < 2:
+		return {"pos": -1, "text": ""}
+	if bool(prof.get("child", false)):
+		return {"pos": at, "text": "%sの手札の1枚だけ、少し飛び出している。" % name}
+	var honest := int(prof.get("honest", 50))
+	if honest >= 60 and rng.randf() < 0.6:
+		return {"pos": at, "text": "%sの目が、一瞬だけ手札の一枚に動いた。" % name}
+	if honest < 30 and rng.randf() < 0.6:
+		var wrong := at
+		while wrong == at:
+			wrong = rng.randi_range(0, hand.size() - 1)
+		return {"pos": wrong, "text": "%sの目が、一瞬だけ手札の一枚に動いた。" % name}
+	return {"pos": -1, "text": "%sは、表情ひとつ変えない。" % name if str(prof.get("style", "")) == "careful" else ""}
+
+static func summary(state: Dictionary, names: Array) -> String:
+	var loser: int = state.ranking[-1] if not state.ranking.is_empty() else -1
+	var first: int = state.ranking[0] if not state.ranking.is_empty() else -1
+	return "最初に上がったのは%s、最後までジョーカーを持っていたのは%sだった" % [names[first], names[loser]]
