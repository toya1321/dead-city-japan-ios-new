@@ -0,0 +1,110 @@
+extends RefCounted
+## v149.38 stage 5: wanderers. Not everyone who loses their home leaves the
+## town. Someone whose family turned, whose home was robbed bare, whose block
+## came apart or whose gang broke up may stay — moving from place to place,
+## searching empty buildings, sleeping where they can. They become one of the
+## town's survivors (survivors.gd / npc_life.gd): living hour by hour where the
+## player can meet them, talk, trade, travel together, and settle with others
+## (npc_groups.gd). People from other towns still drift in as before.
+##
+## The household's row keeps path "wander" and the one member who stays;
+## the survivor's id is "res_<area>_<i>".
+
+const Residents = preload("res://scripts/residents.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const Parts = preload("res://scripts/survivor_parts.gd")
+const MAX_WANDERING := 10
+
+static func id_of(area: String, i: int) -> String:
+	return "res_%s_%d" % [area, i]
+
+static func wandering(world) -> int:
+	if not world.s.get("survivors") is Dictionary:
+		return 0
+	var n := 0
+	for id in world.s.survivors.people:
+		var p: Dictionary = world.s.survivors.people[id]
+		if str(id).begins_with("res_") and str(p.status) == "alive":
+			n += 1
+	return n
+
+const WHY := {
+	"turned": "家族が感染者になり、家を飛び出した。",
+	"hunger": "家の食べ物が尽きて、町をさまよっている。",
+	"robbed": "家を略奪者に襲われ、何もかも持っていかれた。",
+	"apart": "一緒に暮らしていた近所の集まりが、ばらばらになった。",
+	"gang": "仲間とつるんでいたが、もう一人だ。",
+}
+
+## Someone from a household just leaving their home stays in town instead.
+static func maybe(world, area: String, i: int, r: Array, day: int, why: String) -> bool:
+	if not world.s.get("survivors") is Dictionary or wandering(world) >= MAX_WANDERING:
+		return false
+	var w := Residents.who(world, area, i)
+	var k := -1
+	for b in w.people.size():
+		if int(r[Residents.P_ALIVE]) & (1 << b) and bool(w.people[b].able):
+			k = b
+			break
+	if k < 0:
+		return false
+	# Families with children go together, and go; those alone more often stay.
+	var alone := Residents.living(r) <= 1
+	if Residents._roll(world, area, i, day, "wander", 100) >= (45 if alone else 15):
+		return false
+	var people: Dictionary = Survivors.ensure(world).people
+	var used := {}
+	for id in people:
+		used[str(people[id].name)] = true
+	var name := str(w.surname)
+	if used.has(name):
+		return false
+	var person: Dictionary = w.people[k]
+	var role_id := "office"
+	if str(person.band) == "young":
+		role_id = "clerk"
+	elif str(person.sex) == "f" and str(w.family) == "子どものいる家族":
+		role_id = "homemaker"
+	var rng := RandomNumberGenerator.new()
+	rng.seed = hash([int(world.s.seed), area, i, "wanderer"])
+	var made: Dictionary = Survivors._make(rng, role_id, Parts.ROLES[role_id], str(person.sex) == "m", area, {})
+	if made.is_empty():
+		return false
+	var id := id_of(area, i)
+	made.name = name
+	made.id = id
+	made.arrived = day
+	made.resident = [area, i]
+	made.tag = ""
+	made.secret = ""
+	made.situation = "lost"
+	for key in ["deadline_day", "hunger_day", "turn_day"]:
+		made.erase(key)
+	made.background = "%s（%s）に住んでいた%s。%s" % [area, load("res://scripts/dwellings.gd").address(area, i), str(Parts.ROLES[role_id].job), WHY.get(why, WHY.hunger)]
+	made.intro = "%sが、物陰からこちらをうかがっている。近所で見かけたことのある顔だ。" % str(made.label)
+	people[id] = made
+	var goods: Dictionary = load("res://scripts/trade.gd").goods(world, id)
+	goods.food = minf(2.0, float(r[Residents.P_FOOD]) + 1.0)
+	r[Residents.P_ALIVE] = 1 << k
+	r[Residents.P_PATH] = "wander"
+	r[Residents.P_SINCE] = day
+	Residents._news(world, "wander", area, "%sの%sさんが、家を出て町をさまよっているらしい。" % [Residents._where(area, i), name])
+	return true
+
+## Each day: those of the town's own who were wandering and are no more.
+static func sync(world) -> void:
+	if not world.s.get("survivors") is Dictionary:
+		return
+	var people: Dictionary = world.s.survivors.people
+	for area in world.s.residents.hh:
+		var rows: Array = world.s.residents.hh[area]
+		for i in rows.size():
+			var r: Array = rows[i]
+			if str(r[Residents.P_PATH]) != "wander":
+				continue
+			var p: Dictionary = people.get(id_of(area, i), {})
+			if p.is_empty() or str(p.status) == "dead":
+				r[Residents.P_PATH] = "dead"
+				r[Residents.P_ALIVE] = 0
+			elif str(p.status) == "joined":
+				r[Residents.P_PATH] = "gone"   # went with the player's household
