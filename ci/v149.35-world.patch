+extends SceneTree
+## Watches the town's households live on their own for DCJ_DAYS days.
+const Main = preload("res://main.tscn")
+const Residents = preload("res://scripts/residents.gd")
+const Shelter = preload("res://scripts/shelter.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED"))
+	g._start_new_game(p)
+	g._finish_intro()
+	var w = g.world
+	var t0 := Time.get_ticks_msec()
+	for day in int(OS.get_environment("DCJ_DAYS")):
+		for h in 24:
+			w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0; w.s.health = 100.0
+			w.advance_safe(60)
+		var c: Dictionary = Residents.census(w)
+		var sh: Dictionary = w.s.get("shelter", {})
+		print("DAY %3d %-9s people %4d | home %3d holed %3d shelter %3d away %3d gone %3d dead %3d turned %3d looter %3d wander %2d/npc %2d | shelter %s pop %s | cm %d gangs %s | walkers %d" % [day + 1, w.s.society, c.people, c.home, c.holed, c.shelter, c.away, c.gone, c.dead, c.turned, c.looter, c.wander, w.s.survivors.people.values().filter(func(q): return str(q.status) == "alive" and not bool(q.get("neighbor", false))).size(), sh.get("status", "-"), "%s(o%s cap%s st%.0f ord%.0f)" % [sh.get("pop", "-"), sh.get("outsiders", "-"), sh.get("capacity", "-"), float(sh.get("stock", 0)), float(sh.get("order", 0))], load("res://scripts/communities.gd").all(w).values().filter(func(c): return not bool(c.ended)).size(), str(load("res://scripts/gangs.gd").active(w).map(func(gg): return "%s:%d/%.0f" % [gg.lair, load("res://scripts/gangs.gd").people(w, gg), float(gg.store)])), load("res://scripts/walkers.gd").total(w)])
+	var cm = w.s.residents.get("cm", {})
+	for k in cm:
+		var c = cm[k]
+		print("CM %s since %d ended %s store %.0f garden %.1f wall %.0f members %d" % [k, int(c.since), str(c.ended), float(c.store), float(c.garden), float(c.wall), load("res://scripts/communities.gd").members(w, c).size()])
+	var sites := {}
+	for k in w.s.district.sites:
+		sites[k] = "%.0f%s" % [float(w.s.district.sites[k].food), "v" if bool(w.s.district.sites[k].vacant) else ""]
+	print("SITES ", sites)
+	print("MS ", Time.get_ticks_msec() - t0, " SAVE ", JSON.stringify(w.s).length(), " RES ", JSON.stringify(w.s.residents).length())
+	for a in w.s.district.houses_by:
+		print("POOL ", a, " ", w.s.district.houses_by[a])
+	for e in w.s.survivors.get("history", []).filter(func(e): return str(e.kind) in ["wander", "gang", "gang_end"]).slice(-14):
+		print("  * d", e.day, " ", e.text)
+	print("SIGNS ", Residents.signs(w, "団地"))
+	quit()
