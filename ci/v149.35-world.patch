+## Residents already met as someone outside, as "area/i/k".
+static func _bound_keys(people: Dictionary) -> Dictionary:
+	var out := {}
+	for p in people.values():
+		var r: Variant = p.get("resident")
+		if r is Array and r.size() >= 3:
+			out["%s/%d/%d" % [str(r[0]), int(r[1]), int(r[2])]] = true
