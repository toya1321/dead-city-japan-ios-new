+extends SceneTree
+## v149.35: anyone in town can end up living with the player. Through the door
+## of a home people are still holed up in, the player can ask them to come;
+## whether they do is down to them, and a family comes together.
+const Main = preload("res://main.tscn")
+const Residents = preload("res://scripts/residents.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 21
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.society = "emergency"
+	var st: Dictionary = Residents.state(w)
+	# A small family, holed up, short of food, who were once given food.
+	var area := "団地"
+	var pick := -1
+	for i in st.hh[area].size():
+		var who: Dictionary = Residents.who(w, area, i)
+		var r: Array = st.hh[area][i]
+		if Residents.living(r) == 2 and who.people.size() == 2 and who.people.all(func(x): return str(x.band) != "child"):
+			pick = i
+			break
+	check(pick >= 0, "found a household of two")
+	var r: Array = st.hh[area][pick]
+	r[Residents.P_PATH] = "holed"
+	r[Residents.P_FOOD] = 1.0
+	r[Residents.P_FLAGS] = Residents.F_FRIEND
+	w.s.inside = {"area": area, "index": pick, "occupied": true}
+	var before := int(w.s.profile.cohabitants)
+	await g._on_command("一緒に来ないか誘う")
+	print(g.log_entries[-1])
+	check(int(w.s.profile.cohabitants) == before + 2, "the family comes to live with the player together (%d → %d)" % [before, int(w.s.profile.cohabitants)])
+	check(Residents.living(r) == 0 and str(r[Residents.P_PATH]) == "away", "and their home is left empty")
+	var faces: Array = w.s.household_members.filter(func(m): return not str(m.get("face", "")).is_empty())
+	check(faces.size() >= 2, "they keep their own faces in the house")
+	# Strangers who were robbed by the player will not come.
+	var other := -1
+	for i in st.hh[area].size():
+		if i != pick and Residents.living(st.hh[area][i]) >= 1:
+			other = i
+			break
+	var r2: Array = st.hh[area][other]
+	r2[Residents.P_PATH] = "holed"
+	r2[Residents.P_FLAGS] = Residents.F_ROBBED
+	w.s.inside = {"area": area, "index": other, "occupied": true}
+	var c2 := int(w.s.profile.cohabitants)
+	await g._on_command("一緒に来ないか誘う")
+	check(int(w.s.profile.cohabitants) == c2, "people the player robbed do not come")
+	g.queue_free()
+	print("RESULT %s" % ("PASS" if failures == 0 else "FAIL"))
+	quit(1 if failures else 0)
