+## v149.35: asking through the door whether they would come and live with the
+## player. Whether they will is down to them: how much they trust the player
+## (kindness, caution, food once shared), how bad things are inside, and who
+## they would leave behind. A family comes together or not at all; a grown-up
+## with no one depending on them may come alone.
+const HOUSE_LIMIT := 6
+static func invite(world, area: String, i: int) -> String:
+	var r := row(world, area, i)
+	if r.is_empty() or not str(r[P_PATH]) in ["home", "holed"] or living(r) == 0:
+		return "誘う相手がいない。"
+	world.advance_safe(5)
+	var Survivors = load("res://scripts/survivors.gd")
+	var w := who(world, area, i)
+	var name := "%sさん" % w.surname
+	var flags := int(r[P_FLAGS])
+	if not Survivors.active(world):
+		return "ドア越しに声をかけたが、%sは笑って言った。「一緒に？　……まだ、そこまでのことじゃないでしょう」" % name
+	if flags & (F_HOSTILE | F_ROBBED):
+		return "ドアの向こうは、しんと静まり返ったままだ。この家の人が、こちらを信じることはもうないだろう。"
+	if flags & F_ASKED:
+		return "ドアの向こうから%sの声がした。「今日はもう、そっとしておいてください」" % name
+	r[P_FLAGS] = flags | F_ASKED
+	var here: Array = []
+	var kids := 0
+	var careful := 0
+	for k in w.people.size():
+		if int(r[P_ALIVE]) & (1 << k):
+			here.append(k)
+			kids += 1 if str(w.people[k].band) == "child" else 0
+			careful = maxi(careful, int(w.caution))
+	var lead := -1
+	for k in here:
+		if str(w.people[k].band) != "child":
+			lead = k
+			break
+	if lead < 0:
+		return "ドアの向こうで、子どもの小さな声がした。「……だれ？　おとなの人がいないと、あけちゃだめって」"
+	var p: Dictionary = w.people[lead]
+	var n := here.size()
+	var hungry := float(r[P_FOOD]) < 2.0 * n
+	var trust := int(p.get("kindness", w.kindness)) / 2 - careful / 3 + (40 if flags & F_FRIEND else 0) + (25 if hungry else 0) \
+		+ (15 if str(r[P_PATH]) == "holed" else 0) + _roll(world, area, i, _day(world), "invite", 20)
+	if trust < 45:
+		var no := "「……ごめんなさい。顔も知らない人と一緒には暮らせません」" if not flags & F_FRIEND else "「ありがたいけど……もう少し、ここで頑張ってみます」"
+		return "ドア越しに声をかけた。少し間があって、%sの声がした。%s" % [name, no]
+	var room := HOUSE_LIMIT - int(world.s.profile.cohabitants)
+	var going: Array = []
+	if n <= room:
+		going = here
+	elif kids == 0 and room >= 1:
+		going = [lead]
+	else:
+		return "ドアの向こうで%sが言った。「一緒に行けたら……。でも、家族みんなは無理ですよね。この子たちを置いては行けません」" % name if kids else "家にはもう、これ以上の人数を迎える余裕がない。"
+	var rng := RandomNumberGenerator.new()
+	rng.seed = hash([int(world.s.seed), area, i, "door-join"])
+	var lines: Array = []
+	var people: Dictionary = Survivors.ensure(world).people
+	for k in going:
+		var q: Dictionary = w.people[k]
+		var role_id := str(q.get("role", ""))
+		if not Survivors.Parts.ROLES.has(role_id) or role_id in Survivors.NOT_RESIDENTS:
+			role_id = "elder" if int(q.age) >= 65 else ("child" if int(q.age) < 12 else ("student" if int(q.age) < 19 else "office"))
+		var made: Dictionary = Survivors._make(rng, role_id, Survivors.Parts.ROLES[role_id], str(q.sex) == "m", area, {})
+		if made.is_empty():
+			continue
+		Survivors.adopt(made, area, i, k)
+		made.id = "door_%s_%d_%d" % [area, i, k]
+		if going.size() > 1:
+			made.name = str(q.name)   # a family under one roof: called by first name
+		made.tag = ""
+		made.secret = ""
+		made.situation = "family"
+		made.met = true
+		made.known_name = true
+		made.trust = maxi(int(made.trust), Survivors.JOIN_TRUST)
+		made.goods = {}
+		for key in ["deadline_day", "hunger_day", "turn_day"]:
+			made.erase(key)
+		people[made.id] = made
+		Survivors._join(world, made.id)
+		r[P_ALIVE] = int(r[P_ALIVE]) & ~(1 << k)
+		lines.append("%s%s（%d）" % [str(w.surname), str(q.name), int(q.age)])
+	# What food they had comes with them.
+	if living(r) == 0:
+		world.s.food = float(world.s.food) + maxf(0.0, float(r[P_FOOD]))
+		world.s.water = float(world.s.water) + maxf(0.0, float(r[P_WATER]))
+		r[P_FOOD] = 0.0
+		r[P_WATER] = 0.0
+		r[P_PATH] = "away"
+	_news(world, "kindness", area, "%sの%sさん%sが、誰かの家に身を寄せたらしい。" % [_where(area, i), w.surname, "一家" if lines.size() > 1 else ""])
+	world.s.inside = {}
+	var left := "" if living(r) == 0 else "家族は家に残ると言った。"
+	return "長い沈黙のあと、鍵の外れる音がした。%sが、荷物をまとめて出てきた。「……お世話になります」%s（%sが同居人になった）" % [name, left, "、".join(lines)]
+
+## Food handed through the door: remembered.
+static func give_food(world, area: String, i: int) -> String:
+	var r := row(world, area, i)
+	if r.is_empty() or not str(r[P_PATH]) in ["home", "holed"] or living(r) == 0:
+		return "渡す相手がいない。"
+	var bag: Dictionary = world.s.district.bag
+	if float(bag.food) < 1.0:
+		return "持ち歩いている食料がない。"
+	var answered: bool = world.s.get("inside") is Dictionary and bool(world.s.inside.get("answered", false))
+	if int(r[P_FLAGS]) & F_HOSTILE:
+		return "このドアの向こうの人は、もうこちらから何も受け取らないだろう。"
+	bag.food = float(bag.food) - 1.0
+	r[P_FOOD] = float(r[P_FOOD]) + 1.0
+	r[P_HUNGRY] = 0
+	r[P_FLAGS] = int(r[P_FLAGS]) | F_FRIEND
+	world.advance_safe(2)
+	var w := who(world, area, i)
+	_news(world, "kindness", area, "%sの%sさんの家に、誰かが食べ物を分けてくれたらしい。" % [_where(area, i), w.surname])
+	if not answered:
+		return "ドアの前に食料を置いて、少し離れた。しばらくして、ドアが細く開き、誰かの手が食料を引き込んだ。……小さく「ありがとう」と聞こえた気がした。"
+	return "ドアの隙間から食料を渡した。%sさんが、何度も頭を下げた。「ありがとうございます……このご恩は忘れません」" % w.surname
+
+## Breaking into a lived-in home. While the police still answer calls, no;
+## after that, it depends on who is behind the door.
+static func break_in(world, area: String, i: int) -> String:
+	var society := str(world.s.get("society", "normal"))
+	if society in ["normal", "alert"]:
+		return "中に人がいる。今押し入れば、すぐに通報されるだけだ。"
+	var r := row(world, area, i)
+	var w := who(world, area, i)
+	var name := "%sさん" % w.surname
+	Walkers.make_noise(world, area, 60)
+	world.advance_safe(5)
+	var fighter := false
+	var kids := false
+	for k in w.people.size():
+		if int(r[P_ALIVE]) & (1 << k):
+			if bool(w.people[k].able) and (int(w.courage) >= 55 or w.people.any(func(p): return str(p.band) == "child")):
+				fighter = true
+			if str(w.people[k].band) == "child":
+				kids = true
+	if fighter:
+		r[P_FLAGS] = int(r[P_FLAGS]) | F_HOSTILE
+		var hurt := 8.0 + float(_roll(world, area, i, int(world.s.minute), "hurt", 15))
+		world.s.health = maxf(1.0, float(world.s.health) - hurt)
+		_news(world, "robbery", area, "%sの%sさんの家に、誰かが押し入ろうとして追い返されたらしい。" % [_where(area, i), w.surname])
+		world.s.inside = {}
+		return "錠が外れた瞬間、中から%sが飛び出してきた。%s 振り回された何かが肩に当たり、階段まで押し戻された。ドアがまた閉ざされ、内側から何かを積み上げる音がする。" % [name, "「子どもに手を出すな！」" if kids else "「出ていけ！」"]
+	var bag: Dictionary = world.s.district.bag
+	var take := minf(float(r[P_FOOD]), District.FOOD_LIMIT - float(bag.food))
+	r[P_FOOD] = float(r[P_FOOD]) - take
+	bag.food = float(bag.food) + take
+	r[P_FLAGS] = int(r[P_FLAGS]) | F_ROBBED
+	_news(world, "robbery", area, "%sの%sさんの家に強盗が入り、食べ物を奪っていったらしい。" % [_where(area, i), w.surname])
+	world.s.inside = {}
+	var plea := "奥で子どもが泣いている。" if kids else ("「お願いです、これしかないんです……」と、%sが震える声で言った。" % name)
+	if take <= 0.0:
