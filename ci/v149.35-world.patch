+## v149.38: a home whose people live with their neighbours behind a barricade
+## cannot be reached from the street (unless the player lives there too).
+static func behind_barricade(world, area: String, i: int) -> bool:
+	# The whole block is behind it: the stairwell, or the corner of the street.
+	var C = load("res://scripts/communities.gd")
