--- /dev/null
+++ b/scripts/reversi_game.gd
@@ -0,0 +1,355 @@
+extends Control
+## v149.35: the reversi table — a full-screen layer over the game. You play
+## black and go first; the housemate plays white the way they are
+## (scripts/reversi.gd). Game time stands still while you play; when the game
+## ends (or you put it away) main._reversi_finished() writes it down.
+
+const Reversi = preload("res://scripts/reversi.gd")
+const UI = preload("res://scripts/ui_kit.gd")
+const Portraits = preload("res://scripts/portraits.gd")
+const DIR := "res://assets/reversi/"
+## board.png: 1152 px square, the 8×8 grid from 64 px with 128 px cells.
+const GRID_FROM := 64.0 / 1152.0
+const CELL := 128.0 / 1152.0
+
+var game                       # main.gd
+var index := -1                # which housemate
+var mate: Dictionary = {}
+var prof: Dictionary = {}
+var rng := RandomNumberGenerator.new()
+var board: Array = []
+var turn := Reversi.BLACK
+var last := -1
+var before_their_move: Array = []   # for a take-back ("待った")
+var their_last := -1
+var wait_used := false
+var wait_pending := false
+var wait_asked := 0            # 0 none, 1 granted, -1 refused
+var done := false
+var think := 0.7               # seconds they take over a move (tests: 0)
+var moves_played := 0
+var said_ahead := false
+var said_behind := false
+
+var view: Control
+var speech: Label
+var score: Label
+var status: Label
+var buttons: HBoxContainer
+var column: VBoxContainer
+
+var tex_board: Texture2D
+var tex_black: Texture2D
+var tex_white: Texture2D
+var tex_legal: Texture2D
+var tex_last: Texture2D
+
+func setup(main_game, mate_index: int) -> void:
+	game = main_game
+	index = mate_index
+	mate = game.world.s.household_members[index]
+	prof = Reversi.profile(game.world, mate)
+	rng.seed = hash([int(game.world.s.seed), int(game.world.s.minute), "reversi", str(mate.name)])
+	board = Reversi.new_board()
+	tex_board = load(DIR + "board.png")
+	tex_black = load(DIR + "black.png")
+	tex_white = load(DIR + "white.png")
+	tex_legal = load(DIR + "legal_move.png")
+	tex_last = load(DIR + "last_move.png")
+	_build()
+	_say(Reversi.line(prof, "start", rng))
+	_update()
+
+func _build() -> void:
+	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	mouse_filter = Control.MOUSE_FILTER_STOP
+	var shade := ColorRect.new()
+	shade.color = UI.BG
+	shade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(shade)
+	# v149.35: the board sits on the old wooden table of the UI kit.
+	if ResourceLoader.exists("res://assets/ui/dcj_ui/table_wood.jpg"):
+		var wood := TextureRect.new()
+		wood.texture = load("res://assets/ui/dcj_ui/table_wood.jpg")
+		wood.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		wood.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
+		wood.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		wood.modulate = Color(0.75, 0.75, 0.75)
+		wood.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+		add_child(wood)
+	var center := CenterContainer.new()
+	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(center)
+	column = VBoxContainer.new()
+	column.add_theme_constant_override("separation", 10)
+	center.add_child(column)
+	# Who you are playing, and what they just said.
+	var head := HBoxContainer.new()
+	head.add_theme_constant_override("separation", 10)
+	column.add_child(head)
+	head.add_child(Portraits.avatar(Portraits.housemate_face(game.world, index), str(mate.name).left(1), 52, UI.PANEL_2, UI.TEXT))
+	var bubble := PanelContainer.new()
+	bubble.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	bubble.add_theme_stylebox_override("panel", UI.skin_or("dialogue", UI.box(UI.NPC, UI.EDGE, 12, 12, 8), Vector4(12, 12, 12, 12), Vector4(18, 8, 14, 8)))
+	head.add_child(bubble)
+	var inner := VBoxContainer.new()
+	bubble.add_child(inner)
+	var who := Label.new()
+	who.text = "%s（白）" % str(mate.name)
+	who.add_theme_font_size_override("font_size", 14)
+	who.add_theme_color_override("font_color", UI.ACCENT)
+	inner.add_child(who)
+	speech = Label.new()
+	speech.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	speech.add_theme_font_size_override("font_size", 18)
+	speech.add_theme_color_override("font_color", UI.TEXT)
+	inner.add_child(speech)
+	view = Control.new()
+	view.mouse_filter = Control.MOUSE_FILTER_STOP
+	view.draw.connect(_draw_board)
+	view.gui_input.connect(_on_board_input)
+	column.add_child(view)
+	score = Label.new()
+	score.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	score.add_theme_font_size_override("font_size", 18)
+	score.add_theme_color_override("font_color", UI.BODY)
+	column.add_child(score)
+	status = Label.new()
+	status.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	status.add_theme_font_size_override("font_size", 15)
+	status.add_theme_color_override("font_color", UI.MUTED)
+	column.add_child(status)
+	buttons = HBoxContainer.new()
+	buttons.alignment = BoxContainer.ALIGNMENT_CENTER
+	buttons.add_theme_constant_override("separation", 10)
+	column.add_child(buttons)
+	_buttons([["やめる", _quit]])
+	resized.connect(_fit)
+	_fit()
+
+func _fit() -> void:
+	var w := (size.x if size.x > 0 else 400.0) - 24.0
+	var h := (size.y if size.y > 0 else 800.0) - 260.0
+	var side := clampf(minf(w, h), 200.0, 640.0)
+	view.custom_minimum_size = Vector2(side, side)
+	column.custom_minimum_size.x = side
+	view.queue_redraw()
+
+func _buttons(list: Array) -> void:
+	for child in buttons.get_children():
+		child.queue_free()
+	for item in list:
+		var b := UI.button(str(item[0]), str(item[0]) in ["出す", "もう一回", "いいよ"], 44, 17)
+		b.custom_minimum_size = Vector2(120, 44)
+		b.add_theme_font_size_override("font_size", 17)
+		b.pressed.connect(item[1])
+		buttons.add_child(b)
+
+func _say(text: String) -> void:
+	if not text.is_empty() and speech != null:
+		speech.text = "「%s」" % text
+
+# --- Drawing --------------------------------------------------------------
+
+func _cell_rect(cell: int) -> Rect2:
+	var s := view.size.x
+	var c := s * CELL
+	var o := s * GRID_FROM
+	return Rect2(Vector2(o + (cell % 8) * c, o + (cell / 8) * c), Vector2(c, c))
+
+func _draw_board() -> void:
+	var s := view.size.x
+	view.draw_texture_rect(tex_board, Rect2(Vector2.ZERO, Vector2(s, s)), false)
+	var legal: Array = Reversi.moves(board, Reversi.BLACK) if turn == Reversi.BLACK and not done and not wait_pending else []
+	for cell in 64:
+		var r := _cell_rect(cell)
+		var v := int(board[cell])
+		if v == Reversi.BLACK:
+			view.draw_texture_rect(tex_black, r, false)
+		elif v == Reversi.WHITE:
+			view.draw_texture_rect(tex_white, r, false)
+		elif cell in legal:
+			view.draw_texture_rect(tex_legal, r, false)
+		if cell == last:
+			view.draw_texture_rect(tex_last, r, false)
+
+func _update() -> void:
+	var b := Reversi.count(board, Reversi.BLACK)
+	var w := Reversi.count(board, Reversi.WHITE)
+	score.text = "あなた（黒）%d　―　%d %s（白）" % [b, w, str(mate.name)]
+	if done:
+		pass
+	elif wait_pending:
+		status.text = "%sが「待った」と言っている。" % str(mate.name)
+	elif turn == Reversi.BLACK:
+		status.text = "あなたの番（黒）。光っている所に置ける。"
+	else:
+		status.text = "%sが考えている……" % str(mate.name)
+	if view != null:
+		view.queue_redraw()
+
+# --- Your move ------------------------------------------------------------
+
+func _on_board_input(event: InputEvent) -> void:
+	var at := Vector2(-1, -1)
+	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
+		at = event.position
+	elif event is InputEventScreenTouch and event.pressed:
+		at = event.position
+	if at.x < 0:
+		return
+	var s := view.size.x
+	var o := s * GRID_FROM
+	var c := s * CELL
+	var x := int(floor((at.x - o) / c))
+	var y := int(floor((at.y - o) / c))
+	if x < 0 or x > 7 or y < 0 or y > 7:
+		return
+	place(y * 8 + x)
+
+## You put a black disc on `cell`. Returns whether it was allowed.
+func place(cell: int) -> bool:
+	if done or wait_pending or turn != Reversi.BLACK:
+		return false
+	if Reversi.flips(board, cell, Reversi.BLACK).is_empty():
+		return false
+	board = Reversi.play(board, cell, Reversi.BLACK)
+	last = cell
+	moves_played += 1
+	turn = Reversi.WHITE
+	if cell in Reversi.CORNERS:
+		_say(Reversi.line(prof, "you_corner", rng))
+		# Not so honest: once a game, they ask to take back the move that gave it away.
+		if int(prof.honest) < 30 and not wait_used and their_last >= 0 and rng.randf() < 0.75:
+			wait_used = true
+			wait_pending = true
+			_say(Reversi.line(prof, "wait_ask", rng))
+			_buttons([["いいよ", _grant_wait], ["だめ", _refuse_wait]])
+			_update()
+			return true
+	_update()
+	_their_turn()
+	return true
+
+func _grant_wait() -> void:
+	wait_pending = false
+	wait_asked = 1
+	_say(Reversi.line(prof, "wait_yes", rng))
+	board = before_their_move.duplicate()
+	var avoid := their_last
+	last = -1
+	turn = Reversi.WHITE
+	moves_played = maxi(0, moves_played - 2)
+	_buttons([["やめる", _quit]])
+	_update()
+	_their_turn(avoid)
+
+func _refuse_wait() -> void:
+	wait_pending = false
+	wait_asked = -1
+	_say(Reversi.line(prof, "wait_no", rng))
+	_buttons([["やめる", _quit]])
+	_update()
+	_their_turn()
+
+# --- Their move -----------------------------------------------------------
+
+func _their_turn(avoid: int = -1) -> void:
+	if done:
+		return
+	if think > 0.0 and is_inside_tree():
+		await get_tree().create_timer(think).timeout
+	if done or not is_inside_tree() and think > 0.0:
+		return
+	var options := Reversi.moves(board, Reversi.WHITE)
+	if options.is_empty():
+		if Reversi.over(board):
+			_finish()
+			return
+		_say(Reversi.line(prof, "they_pass", rng))
+		turn = Reversi.BLACK
+		_update()
+		return
+	var cell := Reversi.choose(board, Reversi.WHITE, prof, rng, avoid)
+	before_their_move = board.duplicate()
+	their_last = cell
+	board = Reversi.play(board, cell, Reversi.WHITE)
+	last = cell
+	moves_played += 1
+	_comment(cell)
+	if Reversi.over(board):
+		_finish()
+		return
+	if Reversi.moves(board, Reversi.BLACK).is_empty():
+		_say(Reversi.line(prof, "you_pass", rng))
+		_update()
+		_their_turn()
+		return
+	turn = Reversi.BLACK
+	_update()
+
+func _comment(cell: int) -> void:
+	var diff := Reversi.count(board, Reversi.WHITE) - Reversi.count(board, Reversi.BLACK)
+	if cell in Reversi.CORNERS:
+		_say(Reversi.line(prof, "they_corner", rng))
+	elif moves_played > 20 and diff >= 10 and not said_ahead:
+		said_ahead = true
+		_say(Reversi.line(prof, "gentle" if str(prof.style) == "gentle" else "they_ahead", rng))
+	elif moves_played > 20 and diff <= -10 and not said_behind:
+		said_behind = true
+		_say(Reversi.line(prof, "sulk" if int(prof.temper) >= 60 else "they_behind", rng))
+
+# --- The end --------------------------------------------------------------
+
+func _finish() -> void:
+	done = true
+	turn = 0
+	var b := Reversi.count(board, Reversi.BLACK)
+	var w := Reversi.count(board, Reversi.WHITE)
+	var situation := "draw"
+	if w > b:
+		situation = "they_win"
+	elif b > w:
+		situation = "they_lose_sore" if int(prof.temper) >= 60 else "they_lose"
+	var said := Reversi.line(prof, situation, rng)
+	_say(said)
+	status.text = "%s（黒%d・白%d）" % ["あなたの勝ち" if b > w else ("%sの勝ち" % str(mate.name) if w > b else "引き分け"), b, w]
+	_update()
+	_buttons([["もう一回", _again], ["終わる", _close.bind(said)]])
+
+func _again() -> void:
+	_record()
+	board = Reversi.new_board()
+	turn = Reversi.BLACK
+	last = -1
+	their_last = -1
+	wait_used = false
+	wait_pending = false
+	wait_asked = 0
+	done = false
+	moves_played = 0
+	said_ahead = false
+	said_behind = false
+	_buttons([["やめる", _quit]])
+	_say(Reversi.line(prof, "start", rng))
+	_update()
+
+## A finished game counts for the record and the mood (several in a sitting).
+var results: Array = []
+
+func _record() -> void:
+	results.append({"black": Reversi.count(board, Reversi.BLACK), "white": Reversi.count(board, Reversi.WHITE), "wait": wait_asked})
+
+func _close(said: String) -> void:
+	_record()
+	_leave(said)
+
+func _quit() -> void:
+	_leave("")
+
+func _leave(said: String) -> void:
+	done = true
+	if game != null and game.has_method("_reversi_finished"):
+		game._reversi_finished(index, prof, results, said, moves_played)
+	queue_free()
