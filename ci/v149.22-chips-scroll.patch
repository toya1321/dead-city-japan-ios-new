diff --git a/tests/test_chips_touch149_21.gd b/tests/test_chips_touch149_21.gd
new file mode 100644
index 0000000..6dca2c6
--- /dev/null
+++ b/tests/test_chips_touch149_21.gd
@@ -0,0 +1,54 @@
+extends SceneTree
+## v149.21 (iPhone feedback): a sideways swipe on the suggestion strip scrolls
+## it without pressing a suggestion; a tap still runs the suggestion.
+const Main=preload("res://main.tscn")
+var failures:Array[String]=[]
+func check(ok:bool,label:String)->void:
+	print(("PASS " if ok else "FAIL ")+label)
+	if not ok:failures.append(label)
+func _initialize()->void:call_deferred("run")
+func point(c:Control)->Vector2:return root.get_screen_transform()*c.get_global_transform_with_canvas()*(c.size*0.5)
+func touch(down:bool,p:Vector2)->void:
+	var e:=InputEventScreenTouch.new();e.index=0;e.position=p;e.pressed=down;Input.parse_input_event(e)
+func drag(p:Vector2,d:Vector2)->void:
+	var e:=InputEventScreenDrag.new();e.index=0;e.position=p;e.relative=d;Input.parse_input_event(e)
+func settle()->void:
+	Input.flush_buffered_events()
+	for i in range(5):await process_frame
+func run()->void:
+	Input.emulate_mouse_from_touch=true
+	root.size=Vector2i(390,844)
+	var g=Main.instantiate();root.add_child(g);await process_frame
+	var profile:Dictionary=g.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants=1;profile.companion_names=["詩音"]
+	g._start_new_game(profile);g._finish_intro();g.local_model.enabled=false;await settle()
+	await g._on_command("居間へ行く");await settle()
+	await g._on_command("詩音、おはよう");await settle()
+	check(g.chips_scroll.get_h_scroll_bar().max_value>g.chips_scroll.size.x,"the suggestions are wider than the screen")
+	var entries:int=g.log_entries.size()
+	var minute:int=g.world.s.minute
+	var first:Button=g.chips_row.get_child(0)
+	var p:=point(first)
+	# Finger lands on a suggestion and moves left.
+	touch(true,p)
+	for step in range(1,7):
+		drag(p-Vector2(20*step,2),Vector2(-20,0))
+		await process_frame
+	touch(false,p-Vector2(120,2));await settle()
+	check(g.chips_scroll.scroll_horizontal>60,"a sideways swipe scrolls the strip")
+	check(g.log_entries.size()==entries and g.world.s.minute==minute,"the swipe does not press a suggestion")
+	# A short wobble is still a tap.
+	g.chips_scroll.scroll_horizontal=0;g.chips_scroll.velocity=0.0;await settle()
+	var target:Button=g.chips_row.get_child(0)
+	var label:String=target.text
+	p=point(target)
+	touch(true,p);drag(p+Vector2(4,1),Vector2(4,1));touch(false,p+Vector2(4,1));await settle()
+	await settle()
+	check(g.log_entries.size()>entries and g.log_entries.has("▶ "+label),"a tap runs the suggestion: "+label)
+	# Behind the open menu the strip ignores touches.
+	g._open_tool("menu");await settle()
+	check(not g.chips_scroll.interaction_enabled,"the strip ignores touches behind the menu")
+	g._close_drawer();await settle()
+	check(g.chips_scroll.interaction_enabled,"the strip works again after the menu closes")
+	print("chip touch checks failed: %d"%failures.size())
+	quit(1 if not failures.is_empty() else 0)
