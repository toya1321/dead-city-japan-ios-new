-	if Memory._mentions(question, ["何色", "英語で何", "英語でなん", "首都はどこ", "の反対は", "何曜日"]):
-		return true
+	return Memory._mentions(text, ["何色", "どんな色", "英語で何", "英語でなん", "英語に訳", "英訳", "首都は", "首都を", "の反対は", "何曜日"]) or not grounded_knowledge(text).is_empty()
+
+static func grounded_knowledge(speech: String) -> String:
+	var text := normalize(speech)
+	for i in 10:
+		text = text.replace("０１２３４５６７８９"[i], str(i))
 	var arithmetic := RegEx.new()
-	arithmetic.compile("^[0-9０-９]+(?:足す|引く|かける|割る)[0-9０-９]+(?:は)?(?:いくつ|何)$")
-	return arithmetic.search(question) != null
+	arithmetic.compile("^(-?[0-9]{1,8})(足す|引く|かける|割る|[+＋−－×＊*÷／/-])(-?[0-9]{1,8})(?:は)?(?:いくつ|何|計算して)?$")
+	var parsed := arithmetic.search(text)
+	if parsed != null:
+		var left := parsed.get_string(1).to_int()
+		var right := parsed.get_string(3).to_int()
+		match parsed.get_string(2):
+			"足す", "+", "＋": return "%dだよ。" % (left + right)
+			"引く", "-", "−", "－": return "%dだよ。" % (left - right)
+			"かける", "×", "*", "＊": return "%dだよ。" % (left * right)
+			"割る", "÷", "/", "／":
+				if right == 0:
+					return "0では割れないよ。"
+				if left % right == 0:
+					return "%dだよ。" % (left / right)
+				return "約%sだよ。" % String.num(float(left) / right, 8)
+	# A small reference for the reproduced color-mixing case. Scope it to generic questions.
+	var color := RegEx.new()
+	color.compile("^(?:青と紫|紫と青)(?:が混ざった色って|が混ざると|を混ぜると|を混ぜたら|を混ぜた色は)(?:何色|どんな色)(?:になる|になるの|ですか)?$")
+	if color.search(text) != null:
+		return "青紫系だよ。絵の具なら、混ぜる割合や使う絵の具で色味は変わるよ。"
+	return ""
+
+static func relevant_turns(speech: String, turns: Array) -> Array:
+	if turns.is_empty():
+		return []
+	if refers_to_previous_turn(speech):
+		return [turns.back()]
+	# Match topic words only. Common conversational endings would leak the old topic.
+	var topic := RegEx.new()
+	topic.compile("[一-龯]{2,}|[ァ-ヶー]{2,}|[a-zA-Z]{3,}")
+	var unrelated_words := ["一緒", "気分", "本当", "質問", "今日", "昨日", "最近", "意味"]
+	var selected: Array = []
+	for turn in turns:
+		var previous := str(turn.player)
+		for word in topic.search_all(speech):
+			var token := word.get_string()
+			if token not in unrelated_words and previous.contains(token):
+				selected.append(turn)
+				break
+	return selected
 
 static func query_intent(speech: String) -> String:
 	var text := normalize(speech)
