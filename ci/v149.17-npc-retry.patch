diff --git a/scripts/npc_mind.gd b/scripts/npc_mind.gd
index 0d3f36f..1a90b3b 100644
--- a/scripts/npc_mind.gd
+++ b/scripts/npc_mind.gd
@@ -343,6 +343,24 @@ static func similarity(a: String, b: String) -> float:
 			shared += 1
 	return float(shared) / float(mini(x.size(), y.size()))
 
+## Similarity of two replies after removing the words the player just used.
+## Answers to a follow-up on the same topic naturally restate it ("青と紫が
+## 混ざった色は…"); only the rest shows whether the reply was copied.
+static func similarity_beyond(a: String, b: String, topic: String) -> float:
+	var x := Memory.bigrams(a)
+	var y := Memory.bigrams(b)
+	var said := Memory.bigrams(topic)
+	for gram in said:
+		x.erase(gram)
+		y.erase(gram)
+	if x.size() < 3 or y.size() < 3:
+		return similarity(a, b) if a.strip_edges() == b.strip_edges() else 0.0
+	var shared := 0
+	for gram in x:
+		if y.has(gram):
+			shared += 1
+	return float(shared) / float(mini(x.size(), y.size()))
+
 static func reject_reason(line: String, speech: String, evidence: Dictionary) -> String:
 	var own_name := str(evidence.get("name", ""))
 	if not own_name.is_empty() and (line.begins_with(own_name + "は") or line.begins_with(own_name + "が")):
@@ -350,7 +368,7 @@ static func reject_reason(line: String, speech: String, evidence: Dictionary) ->
 	if similarity(line, speech) >= 0.8 and line.length() <= speech.length() + 6:
 		return "echoed_question"
 	for previous in evidence.get("own_replies", []):
-		if similarity(line, str(previous)) >= 0.8:
+		if similarity_beyond(line, str(previous), speech) >= 0.8:
 			return "repeated_reply"
 	if line.contains("<") or line.contains(">") or line.contains("://") or line.contains("▶") or line.contains("{"):
 		return "markup"
diff --git a/tests/test_npc_mind149_17.gd b/tests/test_npc_mind149_17.gd
new file mode 100644
index 0000000..bb01ba5
--- /dev/null
+++ b/tests/test_npc_mind149_17.gd
@@ -0,0 +1,92 @@
+extends SceneTree
+## v149.17: a reply that copies the model's own earlier line is retried without
+## quoting it and without the copied assistant turn; follow-ups that restate
+## the topic are not mistaken for repetition.
+const Main = preload("res://main.tscn")
+const Mind = preload("res://scripts/npc_mind.gd")
+const Model = preload("res://scripts/local_npc_model.gd")
+
+class ScriptedModel extends RefCounted:
+	var queue: Array = []
+	var payload := {}
+	var requests := 0
+	func model_available() -> bool:
+		return true
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, _instructions: String, input: String) -> bool:
+		requests += 1
+		payload = Model.decode_request(input)
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		pass
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func say(model: ScriptedModel, line: String) -> void:
+	model.queue.append(JSON.stringify({"kind":"chat", "value":line}))
+
+func run() -> void:
+	# --- Guard: restating the player's topic is not a copied reply.
+	var previous := "青と紫が混ざった色は、落ち着きがあって心地よい気分になるね。"
+	var follow_up := "青と紫が混ざった色は、青紫とかすみれ色って呼ばれるよ。"
+	check(Mind.reject_reason(follow_up, "青と紫が混ざった色って何色？", {"own_replies": [previous]}).is_empty(), "a follow-up answer that restates the topic is accepted")
+	check(Mind.reject_reason(previous, "青と紫が混ざった色って何色？", {"own_replies": [previous]}) == "repeated_reply", "an identical earlier reply is still rejected")
+	check(Mind.reject_reason("青と紫が混ざった色は、落ち着きがあって心地よい気分になるよ。", "それってどういう意味？", {"own_replies": [previous]}) == "repeated_reply", "a near copy is still rejected")
+	check(Mind.reject_reason("うん。", "そう？", {"own_replies": ["うん。"]}) == "repeated_reply", "a short identical reply is rejected")
+
+	var game = Main.instantiate()
+	root.add_child(game)
+	await process_frame
+	var profile: Dictionary = game.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = 1
+	profile.companion_names = ["詩音"]
+	game._start_new_game(profile)
+	game._finish_intro()
+	game.location = "居間"
+	game._sync_player_position()
+	game.world.s.minute = 120
+	game.world.s.society = "disrupted"
+	game.world._household_hour()
+	var fake := ScriptedModel.new()
+	game.local_model.backend = fake
+	game.local_model.generation_timeout_ms = 300
+
+	say(fake, previous)
+	await game._on_command("詩音、青と紫が混ざった色って、見てるとどんな気分になる？")
+	check(game.last_npc_reply_source.source == "ai", "first answer is shown")
+
+	# --- The model copies itself; the retry must neither quote the line nor
+	# keep it as an assistant turn, but keep what the player said.
+	say(fake, previous)
+	say(fake, follow_up)
+	await game._on_command("青と紫が混ざった色って何色？")
+	var note := str(fake.payload.get("注意", ""))
+	check(fake.requests == 3, "a copied reply triggers one retry")
+	check(note.contains("繰り返し") and not note.contains(previous.left(10)), "the retry names the problem without quoting the copied line")
+	check((fake.payload.get("_history", []) as Array).is_empty(), "the copied assistant turn is removed from the retry")
+	var said: Array = fake.payload.get("直前のプレイヤーの発言", [])
+	check(said.size() == 1 and str(said[0]).contains("気分"), "the retry still carries the player's earlier line")
+	check(game.last_npc_reply_source.reason == "generated_chat_after_retry" and game.log_entries[-1].contains("すみれ色"), "the corrected line is shown")
+	check(game.last_npc_rejected.get("reason", "") == "repeated_reply" and str(game.last_npc_rejected.get("line", "")) == previous, "the rejected line is kept for diagnostics")
+
+	# --- Other rejections still quote the line so the model knows what to fix.
+	say(fake, "約束したよね、明日一緒に出かけるって。")
+	say(fake, "今日はのんびりしようか。")
+	await game._on_command("明日どうする？")
+	check(str(fake.payload.get("注意", "")).contains("約束したよね") and not (fake.payload.get("_history", []) as Array).is_empty(), "a factual rejection keeps the quote and the conversation turns")
+
+	print("v149.17 NPC retry checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
