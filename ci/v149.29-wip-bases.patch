 			Survivors.change_trust(world, "neighbor_0", 8)
 			Mood.change(world.s, 2.0)
 			return "小皿に醤油を分けて渡した。%s「助かりました！　今度、何かお返ししますね」" % name if polite else "小皿に醤油を分けて渡した。%s「助かった。この借りは返す」" % name
 		"help":
+			Chronicle.deed(world, "neighborly")
 			world.advance_safe(40)
 			world.s.fatigue = minf(100.0, float(world.s.fatigue) + 6.0)
 			world.s.food = float(world.s.food) + 1.0
