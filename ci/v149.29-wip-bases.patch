diff --git a/scripts/chronicle.gd b/scripts/chronicle.gd
new file mode 100644
index 0000000..f703d4b
--- /dev/null
+++ b/scripts/chronicle.gd
@@ -0,0 +1,157 @@
+extends RefCounted
+## v149.29: the story of a life. Turning points are written down as they
+## happen (who was met, who came to live, who left or died, what happened to
+## the neighbour and the shelter, nights at the door); when the player dies
+## with nobody left to carry on, it is told back as one story. A housemate who
+## carries on gets the previous life summed up in a few lines.
+## State: `s.chronicle = {"moments": [{day, text, kind, who}], "people": {name: {kind, fate}}, "lives": [...], "society": ""}`.
+
+const MAX_MOMENTS := 80
+const Mood = preload("res://scripts/mood.gd")
+
+static func state(world) -> Dictionary:
+	if not world.s.has("chronicle") or not world.s.chronicle is Dictionary:
+		world.s.chronicle = {"moments": [], "people": {}, "lives": [], "society": str(world.s.get("society", "normal")), "milestone": 0, "life_from": 0}
+		for m in world.s.household_members:
+			world.s.chronicle.people[str(m.name)] = {"kind": "housemate", "fate": ""}
+	return world.s.chronicle
+
+static func valid(value: Variant) -> bool:
+	return value is Dictionary and value.get("moments", []) is Array and value.get("people", {}) is Dictionary
+
+static func day(world) -> int:
+	return (int(float(world.s.get("start_hour", 0)) * 60.0) + int(world.s.minute)) / 1440 + 1
+
+## A turning point. kind: met, joined, left, died, neighbor, shelter, raid, bitten, society, milestone, life.
+static func note(world, text: String, kind: String = "", who: String = "") -> void:
+	var st := state(world)
+	if kind in ["joined", "left", "died", "raid", "bitten"]:
+		deed(world, kind)
+	var moments: Array = st.moments
+	moments.append({"day": day(world), "text": text, "kind": kind, "who": who})
+	if moments.size() > MAX_MOMENTS:
+		# Keep the first days and the most recent ones.
+		moments.remove_at(10)
+
+## v149.29: what kind of person the player was, counted as it happens.
+## gave (to survivors), rescued, refused, ignored, shelter (watch, runs,
+## donations), repelled, robbed, joined, left, died.
+static func deed(world, kind: String, amount: int = 1) -> void:
+	var deeds: Dictionary = state(world).get("deeds", {})
+	deeds[kind] = int(deeds.get(kind, 0)) + amount
+	state(world).deeds = deeds
+
+static func deeds(world) -> Dictionary:
+	return state(world).get("deeds", {})
+
+static func person(world, name: String, kind: String, fate: String) -> void:
+	var people: Dictionary = state(world).people
+	var p: Dictionary = people.get(name, {"kind": kind, "fate": ""})
+	if not kind.is_empty():
+		p.kind = kind if str(p.kind) != "housemate" or kind == "housemate" else p.kind
+	if not fate.is_empty():
+		p.fate = fate
+	people[name] = p
+
+const SOCIETY_TEXT := {
+	"alert": "街に、噛みつき事件の噂が広がった。",
+	"disrupted": "店が閉まり、街の暮らしが崩れ始めた。",
+	"emergency": "緊急事態が宣言された。街は感染者のものになりつつあった。",
+}
+
+static func hourly(world) -> void:
+	var st := state(world)
+	var society := str(world.s.society)
+	if society != str(st.society):
+		st.society = society
+		if SOCIETY_TEXT.has(society):
+			note(world, str(SOCIETY_TEXT[society]), "society")
+	var d := day(world) - int(st.get("life_from", 0))
+	for mark in [7, 30, 100, 365]:
+		if d >= mark and int(st.get("milestone", 0)) < mark:
+			st.milestone = mark
+			note(world, "%sが生き延びて、%d日が過ぎた。" % [world.s.profile.name, mark], "milestone")
+
+## How the life ended, in a few words.
+static func cause(world) -> String:
+	if not str(state(world).get("cause_text", "")).is_empty():
+		return str(state(world).cause_text)
+	if bool(world.s.get("bitten", false)) or bool(world.s.get("symptomatic", false)):
+		return "噛まれた傷の熱にうなされた末に、息を引き取った。"
+	if float(world.s.get("hunger", 0)) >= 100.0 or float(world.s.get("thirst", 0)) >= 100.0:
+		return "飢えと渇きの中で、静かに力尽きた。"
+	if world.s.has("walkers") and not world.s.walkers.get("encounter", {}).is_empty():
+		return "感染者に追いつかれ、逃げきれなかった。"
+	return "力尽きて、もう起き上がらなかった。"
+
+## A short line for a life that a housemate carries on from.
+static func life_ended(world, name: String, heir: String) -> void:
+	var st := state(world)
+	var days := day(world) - int(st.get("life_from", 0))
+	st.lives.append({"name": name, "days": days, "to": day(world)})
+	note(world, "%sが亡くなった。あとを、%sが継いだ。" % [name, heir], "life", name)
+	st.life_from = day(world) - 1
+	st.milestone = 0
+
+## The whole story, told when the life ends (v149.29: pieces from epilogue.gd).
+static func epilogue(world) -> String:
+	var E = load("res://scripts/epilogue.gd")
+	var st := state(world)
+	var name := str(world.s.profile.name)
+	var total := day(world)
+	var lines: Array = ["―― %sの記録 ――" % name, E.opening(world, name, total)]
+	lines.append_array(E.character(world, name))
+	# The people.
+	var people: Dictionary = st.people
+	var housemates: Array = []
+	var met: Array = []
+	for who in people:
+		var p: Dictionary = people[who]
+		if who == name:
+			continue
+		if str(p.kind) == "housemate":
+			var alive: bool = world.s.household_members.any(func(m): return str(m.name) == who and float(m.health) > 0)
+			housemates.append("%s（%s）" % [who, p.fate if not str(p.fate).is_empty() else ("あとに残った" if alive else "最後まで一緒だった")])
+		elif str(p.kind) in ["met", "neighbor"]:
+			met.append(who)
+	if not housemates.is_empty():
+		lines.append("共に暮らした人：" + "、".join(housemates))
+	if not met.is_empty():
+		lines.append("出会った人：" + "、".join(met.slice(0, 8)) + ("ほか" if met.size() > 8 else ""))
+	# The turning points.
+	var picked: Array = []
+	for m in st.moments:
+		if str(m.kind) in ["joined", "left", "died", "neighbor", "shelter", "raid", "bitten", "society", "milestone"]:
+			picked.append(m)
+	if picked.size() > 12:
+		picked = picked.slice(0, 4) + picked.slice(picked.size() - 8)
+	if not picked.is_empty():
+		lines.append("")
+		for m in picked:
+			lines.append("%d日目　%s" % [int(m.day), m.text])
+	lines.append("")
+	lines.append(E.death(world, name, total))
+	var left: Array = E.aftermath(world, name)
+	var met_line: String = E.met_line(world, name)
+	if not met_line.is_empty():
+		left.append(met_line)
+	left.append_array(E.town(world, name))
+	if not left.is_empty():
+		lines.append("")
+		lines.append_array(left)
+	lines.append("")
+	lines.append(E.closing(world, name, total))
+	var text := "\n".join(lines)
+	st.photo = E.photo(world, text, total)
+	return text
+
+## The record so far, for the player to read back.
+static func read_back(world) -> String:
+	var st := state(world)
+	var lines: Array = ["%sの記録（%d日目）" % [world.s.profile.name, day(world)]]
+	var moments: Array = st.moments
+	if moments.is_empty():
+		lines.append("まだ、書き残すような出来事はない。")
+	for m in moments.slice(maxi(0, moments.size() - 15)):
+		lines.append("%d日目　%s" % [int(m.day), m.text])
+	return "\n".join(lines)
