+++ b/scripts/epilogue.gd
@@ -0,0 +1,271 @@
+extends RefCounted
+## v149.29: the ending, told from how the life went. Many small pieces, each
+## chosen by what happened (how long, what kind of person, how it ended, who
+## was left and in what state, who was met, what became of the town), with
+## several wordings each so two lives rarely read alike. Deterministic for a
+## given world and day.
+
+const Mood = preload("res://scripts/mood.gd")
+
+static func _pick(world, options: Array, salt: String) -> String:
+	if options.is_empty():
+		return ""
+	return str(options[world.draw(int(world.s.minute) / 1440, absi(hash(salt)) % 997, "ending-" + salt, options.size())])
+
+static func _place(world) -> String:
+	return "東京の住宅街" if str(world.s.profile.get("address", "東京")) == "東京" else str(world.s.profile.address)
+
+# ---------------------------------------------------------------------------
+# How long.
+
+static func opening(world, name: String, days: int) -> String:
+	var place := _place(world)
+	if days < 3:
+		return _pick(world, [
+			"%sの記録は、わずか%d日で途切れている。" % [name, days],
+			"%sが生きたのは、崩れ始めた街の、ほんの%d日だった。" % [name, days],
+			"%d日。%sの物語は、始まったばかりで終わった。" % [days, name],
+		], "open0")
+	if days < 14:
+		return _pick(world, [
+			"%sは、%sで%d日を生き延びた。" % [name, place, days],
+			"%d日。%sが%sで過ごした日々は、それだけだった。" % [days, name, place],
+			"%sは%d日のあいだ、%sで息をひそめて生きた。" % [name, days, place],
+		], "open1")
+	if days < 60:
+		return _pick(world, [
+			"%sは%sで%d日を生き抜き、街が崩れていくのを最後まで見届けた。" % [name, place, days],
+			"%d日。電気が消え、水が止まり、隣人がいなくなっても、%sは生きていた。" % [days, name],
+			"%sの%d日は、%sが少しずつ死んでいく日々でもあった。" % [name, days, place],
+		], "open2")
+	if days < 365:
+		return _pick(world, [
+			"%d日。%sは、崩れ落ちた%sで、季節が変わるほど長く生き延びた。" % [days, name, place],
+			"%sは%d日を生きた。この街で、それより長く生きた者は多くない。" % [name, days],
+			"%d日目の朝まで、%sは%sの片隅で暮らし続けた。" % [days, name, place],
+		], "open3")
+	return _pick(world, [
+		"%d日。一年を越えて、%sは%sを生き抜いた。" % [days, name, place],
+		"%sの記録は%d日分ある。最初のページの日常は、もう誰も覚えていない。" % [name, days],
+	], "open4")
+
+# ---------------------------------------------------------------------------
+# What kind of person they were (at most two lines).
+
+static func character(world, name: String) -> Array:
+	var d: Dictionary = world.s.get("chronicle", {}).get("deeds", {})
+	var out: Array = []
+	var bases := 0
+	for place in world.s.district.sites:
+		if int(world.s.district.sites[place].level) >= 1:
+			bases += 1
+	var met := int(world.s.get("chronicle", {}).get("people", {}).size())
+	if int(d.get("rescued", 0)) > 0:
+		out.append(_pick(world, ["隣の悲鳴に、迷わず駆けつける人だった。", "危険だと分かっていても、%sは隣の家へ走った。" % name], "c-rescue"))
+	if int(d.get("gave", 0)) >= 3:
+		out.append(_pick(world, ["自分の食べ物を削ってでも、出会った人に分け与えた。", "%sに水を分けてもらった人は、一人や二人ではない。" % name], "c-gave"))
+	elif int(d.get("gave", 0)) >= 1:
+		out.append(_pick(world, ["わずかな物資を、見知らぬ人に分けたこともあった。"], "c-gave1"))
+	if int(d.get("shelter", 0)) >= 3:
+		out.append(_pick(world, ["避難所の人々にとって、%sは頼れる顔の一つだった。" % name, "%sは、何度も避難所の見張りに立った。" % name], "c-shelter"))
+	if int(d.get("neighborly", 0)) >= 2:
+		out.append(_pick(world, ["隣人の頼みを断らない人だった。", "醤油を分け、棚を運んだ。そんな小さな手助けを、%sは惜しまなかった。" % name], "c-neigh"))
+	if int(d.get("repelled", 0)) >= 2:
+		out.append(_pick(world, ["夜の玄関に立つ略奪者に、一度も屈しなかった。", "扉の向こうの怒鳴り声にも、%sは怯まなかった。" % name], "c-repel"))
+	if int(d.get("joined", 0)) >= 3:
+		out.append(_pick(world, ["%sの家には、行き場をなくした人が集まった。" % name, "一人で始めた暮らしは、いつの間にか大所帯になっていた。"], "c-join"))
+	if bases >= 2:
+		out.append(_pick(world, ["街のあちこちに、%sが整えた隠れ家が残っている。" % name, "%sは、街に%dつの拠点を作った。" % [name, bases]], "c-bases"))
+	if int(d.get("refused", 0)) > 0 or int(d.get("ignored", 0)) > 0:
+		out.append(_pick(world, ["扉を叩く手を、%sは開けなかったこともある。生き延びるための選択だった。" % name, "助けを求める声に、背を向けた夜もあった。%sは、それを誰にも話さなかった。" % name], "c-refuse"))
+	var ever_housemates: bool = world.s.get("chronicle", {}).get("people", {}).values().any(func(p): return str(p.get("kind", "")) == "housemate") or not world.s.household_members.is_empty()
+	if int(d.get("joined", 0)) == 0 and met <= 1 and not ever_housemates:
+		out.append(_pick(world, ["最後まで、誰とも暮らさなかった。一人の静けさを選んだ。", "%sは、誰にも頼らず、誰にも頼られずに生きた。" % name], "c-alone"))
+	if out.size() > 2:
+		out = [out[0], out[out.size() - 1]] if int(d.get("refused", 0)) + int(d.get("ignored", 0)) > 0 else out.slice(0, 2)
+	return out
+
+# ---------------------------------------------------------------------------
+# How it ended.
+
+static func death(world, name: String, days: int) -> String:
+	var st: Dictionary = world.s.get("chronicle", {})
+	if not str(st.get("cause_text", "")).is_empty():
+		return "%d日目、%sは%s" % [days, name, st.cause_text]
+	var place := str(st.get("death_place", ""))
+	var outside := not place.is_empty() and not place in ["寝室", "居間", "台所", "廊下", "玄関"]
+	if bool(world.s.get("bitten", false)) or bool(world.s.get("symptomatic", false)):
+		return _pick(world, [
+			"%d日目、%sは噛まれた傷の熱にうなされた末に、息を引き取った。" % [days, name],
+			"%d日目、熱に浮かされながら、%sは最後に誰かの名前をつぶやいた。" % [days, name],
+			"%d日目、%sは噛まれた腕を押さえたまま、静かに目を閉じた。" % [days, name],
+		], "d-bite")
+	if float(world.s.get("hunger", 0)) >= 100.0 or float(world.s.get("thirst", 0)) >= 100.0:
+		return _pick(world, [
+			"%d日目、%sは飢えと渇きの中で、静かに力尽きた。" % [days, name],
+			"最後の缶詰を開けた数日後、%d日目に、%sは起き上がらなくなった。" % [days, name],
+			"%d日目。空の水筒を握ったまま、%sは眠るように息を引き取った。" % [days, name],
+		], "d-starve")
+	if world.s.has("walkers") and not world.s.walkers.get("encounter", {}).is_empty() or outside:
+		var where := place if outside else "家の近く"
+		return _pick(world, [
+			"%d日目、%sは%sで感染者に追いつかれ、逃げきれなかった。" % [days, name, where],
+			"%d日目、%sの路上で、%sは感染者の群れに囲まれた。" % [days, where, name],
+			"%d日目、%sに出かけた%sは、そのまま戻らなかった。" % [days, where, name],
+		], "d-out")
+	return _pick(world, [
+		"%d日目、%sは力尽きて、もう起き上がらなかった。" % [days, name],
+		"%d日目の夜、%sは静かに息を引き取った。" % [days, name],
+	], "d-other")
+
+# ---------------------------------------------------------------------------
+# Those left behind.
+
+static func aftermath(world, name: String) -> Array:
+	var living: Array = world.s.household_members.filter(func(m): return float(m.health) > 0)
+	var lines: Array = []
+	if living.is_empty():
+		return lines
+	var stay: Array = []
+	for m in living:
+		var who := str(m.name)
+		var job := str(m.get("job", ""))
+		if bool(m.get("bitten", false)) or m.has("hidden_bite_at"):
+			lines.append(_pick(world, [
+				"%sも、数日後に高い熱を出した。最後まで、%sの名前を呼んでいたという。" % [who, name],
+				"噛まれていた%sは、%sの後を追うように、数日で息を引き取った。" % [who, name],
+				"%sは熱が出る前に、自分で寝室の扉に鍵をかけた。" % who,
+			], "a-bite-" + who))
+			continue
+		if not str(m.get("station", "")).is_empty():
+			lines.append(_pick(world, [
+				"%sは、%sの拠点にとどまった。窓の板の隙間から、今も明かりが漏れることがある。" % [who, m.station],
+				"%sに残った%sは、%sが戻らないことを、しばらく知らなかった。" % [m.station, who, name],
+			], "a-station-" + who))
+			continue
+		if job in ["看護師", "薬剤師"]:
+			lines.append(_pick(world, [
+				"%sだった%sは、のちに避難所で、けが人の手当てを続けたという。" % [job, who],
+				"%sは、%sの傷を手当てできなかったことを、ずっと悔やんでいた。" % [who, name],
+			], "a-med-" + who))
+			continue
+		if job == "元自衛官":
+			lines.append(_pick(world, [
+				"%sは、残った人を連れて、街の外を目指した。" % who,
+				"%sは、%sの家の扉を内側から補強し直し、そこを守り続けた。" % [who, name],
+			], "a-vet-" + who))
+			continue
+		if int(m.get("age", 30)) < 13:
+			lines.append(_pick(world, [
+				"%sは、避難所の先生に預けられた。毎朝、校門の外を見ていたという。" % who,
+				"%sは、%sがくれたものを、ずっと大事に持っていた。" % [who, name],
+			], "a-child-" + who))
+			continue
+		stay.append(m)
+	if stay.is_empty():
+		return lines
+	var names: Array = stay.map(func(m): return str(m.name))
+	var together := "と".join(names)
+	var who_all: String = names[0] if names.size() == 1 else ("二人" if names.size() == 2 else "みんな")
+	var days_food := float(world.s.food) / maxf(1.0, float(stay.size()))
+	var weeks := clampi(int(days_food / 7.0), 0, 8)
+	if weeks >= 2:
+		lines.append(_pick(world, [
+			"%sは、それから%d週間ほど、あの家を守り続けた。" % [together, weeks],
+			"%sが残した備蓄で、%sはそれから%d週間を生き延びた。" % [name, together, weeks],
+			"%sは、%sの決めた見張りの順番を、%d週間守り続けた。" % [together, name, weeks],
+		], "a-stay"))
+	else:
+		lines.append(_pick(world, [
+			"%sは、%sを失ったあと、残りわずかな食料を分け合った。" % [together, name],
+			"%sを失った家に、食べ物はほとんど残っていなかった。%sは、明かりを消した部屋で黙って座っていた。" % [name, together],
+		], "a-short"))
+	var shelter := str(world.s.get("shelter", {}).get("status", "")) if world.s.get("shelter") is Dictionary else ""
+	var options: Array = [
+		"食料が尽きる前に、駅の向こうの救助拠点の噂を頼りに家を出た。その後の%sを知る者はいない。" % who_all,
+		"家の柱には、%sが刻んだ日付の傷が、今も残っている。" % name,
+		"ある朝、%sは家を出た。玄関には、%sの靴だけが残されていた。" % [who_all, name],
+	]
+	if shelter == "open":
+		options.append("やがて家を出て、小学校の避難所に身を寄せた。掲示板には、%sの名前を探す紙が貼られた。" % name)
+	lines.append(_pick(world, options, "a-then"))
+	for m in stay:
+		if Mood.of(m) < 30.0:
+			lines.append(_pick(world, ["%sは、あの日のことを最後まで口にしなかった。" % m.name, "%sは、夜になると、%sの寝ていた部屋の前に座っていた。" % [m.name, name]], "a-grief-" + str(m.name)))
+			break
+		if Mood.of(m) >= 60.0:
+			lines.append(_pick(world, ["%sは、%sのことを話す時、少しだけ笑った。" % [m.name, name], "%sは、%sに教わった料理を、何度も作った。" % [m.name, name]], "a-warm-" + str(m.name)))
+			break
+	return lines
+
+# ---------------------------------------------------------------------------
+# Someone met along the way.
+
+static func met_line(world, name: String) -> String:
+	var people: Dictionary = world.s.get("survivors", {}).get("people", {}) if world.s.get("survivors") is Dictionary else {}
+	var helped: Array = []
+	var lost: Array = []
+	for id in people:
+		var p: Dictionary = people[id]
+		if not bool(p.get("met", false)) or str(p.status) == "joined" or bool(p.get("neighbor", false)):
+			continue
+		if str(p.status) == "alive" and int(p.get("given", 0)) > 0:
+			helped.append(p)
+		elif str(p.status) == "dead":
+			lost.append(p)
+	if not helped.is_empty():
+		var p: Dictionary = helped[0]
+		return _pick(world, [
+			"%sは、生き延びた。あの日%sにもらった物のことを、ずっと覚えていた。" % [p.name, name],
+			"%sは、%sの名前を、生き延びた人たちに伝え続けた。" % [p.name, name],
+		], "m-help")
+	if not lost.is_empty():
+		var p: Dictionary = lost[0]
+		return _pick(world, ["%sの消息は、それきり分からない。" % str(p.label if not bool(p.get("known_name", false)) else p.name), "%sが最後に見た%sは、まだ笑っていた。" % [name, str(p.name)]], "m-lost")
+	return ""
+
+# ---------------------------------------------------------------------------
+# The town afterwards.
+
+static func town(world, name: String) -> Array:
+	var out: Array = []
+	var nfate := str(world.s.get("neighbor_fate", {}).get("stage", "")) if world.s.get("neighbor_fate") is Dictionary else ""
+	if nfate == "turned":
+		out.append(_pick(world, ["隣の家の前を、見覚えのある影が今もさまよっている。", "隣の家の窓は、割れたままだ。"], "t-neigh"))
+	var shelter := str(world.s.get("shelter", {}).get("status", "")) if world.s.get("shelter") is Dictionary else ""
+	if shelter == "open":
+		out.append(_pick(world, ["小学校の避難所には、まだ明かりが灯っていた。", "小学校の体育館では、今夜も誰かが見張りに立っている。"], "t-shel"))
+	elif shelter == "overrun":
+		out.append(_pick(world, ["避難所だった小学校からは、今もうめき声が聞こえる。", "倒れた校門の前を通る者は、もういない。"], "t-over"))
+	elif shelter == "abandoned":
+		out.append("空になった体育館には、毛布と段ボールが散らばったままだ。")
+	var traits: Dictionary = world.s.get("world_traits", {}) if world.s.get("world_traits") is Dictionary else {}
+	if "rescue_rumor" in traits.get("done_events", []):
+		out.append(_pick(world, ["駅の向こうの救助拠点の噂は、本当だったのかもしれない。誰も確かめた者はいない。", "救助のヘリの音を聞いたという人が、何人かいた。"], "t-rescue"))
+	var day := int(world.s.minute) / 1440
+	if day >= 35 and day < 130:
+		out.append(_pick(world, ["その年の冬は、ひどく寒かった。", "街に、初雪が降った。"], "t-winter"))
+	return out
+
+## The picture shown with the ending, chosen from what the text tells.
+static func photo(world, text: String, days: int) -> String:
+	if text.contains("避難所に身を寄せた"):
+		return "ending_shelter"
+	if text.contains("家を出た") and not text.contains("一人で家を出ていった"):
+		return "ending_departure"
+	if world.s.household_members.any(func(m): return float(m.health) > 0):
+		return "ending_left_behind"
+	if text.contains("初雪") or text.contains("冬は、ひどく寒かった"):
+		return "ending_winter"
+	if days >= 60:
+		return "ending_tally"
+	return "ending_alone"
+
+static func closing(world, name: String, days: int) -> String:
+	if world.s.household_members.any(func(m): return float(m.health) > 0):
+		return _pick(world, ["%sの物語は、ここで終わる。残された者たちの物語は、まだ続いている。" % name, "%sがいなくなっても、あの家の明かりは、もう少しだけ灯っていた。" % name], "close-left")
+	return _pick(world, [
+		"家には、%sの書き残した日々の記録だけが残された。" % name,
+		"誰も読むことのない日誌の最後のページは、白いままだった。",
+		"%sが柱に刻んだ日付の傷は、%d本で止まっている。" % [name, days],
+	], "close-alone")
