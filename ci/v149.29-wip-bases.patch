new file mode 100644
index 0000000..2fd0a43
--- /dev/null
+++ b/scripts/outposts.gd
@@ -0,0 +1,135 @@
+extends RefCounted
+## v149.29: a housemate can live at one of the player's other bases. They keep
+## it, eat from what is stored there, and look around nearby for leftovers.
+## A base with more of the dead around is more dangerous; a reinforced one
+## less so. Hungry with nothing stored, they come home.
+## State: `person.station = "<base place>"` (location is that place, activity 外出).
+
+const District = preload("res://scripts/district.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+
+const STAY_WORDS := ["住ませ", "住んで", "暮らして", "任せ", "守って", "移って", "残って", "詰めて"]
+const CALL_WORDS := ["呼び戻", "帰ってきて", "家に戻って", "一緒に帰ろう", "家に帰ろう", "引き上げ"]
+
+static func stationed(person: Dictionary) -> bool:
+	return not str(person.get("station", "")).is_empty()
+
+static func at(world, place: String) -> Array:
+	return world.s.household_members.filter(func(m): return str(m.get("station", "")) == place and float(m.health) > 0)
+
+## "詩音を食品店に住ませる" → [index, place], or [] when the line is not that.
+static func parse_stay(world, text: String) -> Array:
+	if not _has(text, STAY_WORDS):
+		return []
+	for i in world.s.household_members.size():
+		if not text.contains(str(world.s.household_members[i].name)):
+			continue
+		for place in District.SITES:
+			if text.contains(place) or (place == "近所の空き家" and text.contains("空き家")):
+				return [i, place]
+	return []
+
+static func parse_call(world, text: String) -> int:
+	if not _has(text, CALL_WORDS):
+		return -1
+	for i in world.s.household_members.size():
+		if text.contains(str(world.s.household_members[i].name)) and stationed(world.s.household_members[i]):
+			return i
+	return -1
+
+static func _has(text: String, words: Array) -> bool:
+	for w in words:
+		if text.contains(w):
+			return true
+	return false
+
+static func send(world, index: int, place: String) -> String:
+	var person: Dictionary = world.s.household_members[index]
+	var name := str(person.name)
+	var site: Dictionary = world.s.district.sites.get(place, {})
+	if site.is_empty() or int(site.get("level", 0)) < 1:
+		return "%sはまだ寝泊まりできる拠点になっていない。先に「ここを拠点にする」で整えよう。" % place
+	if float(person.health) < 50.0 or bool(person.get("bitten", false)):
+		return "%sは体が弱っている。今は外の拠点に一人で置けない。" % name
+	if Mood.of(person) < 20.0:
+		return "%s「……ごめん。今は、一人になりたくない」" % name
+	if int(person.get("age", 30)) < 13:
+		return "%sはまだ子どもだ。一人で外の拠点には置けない。" % name
+	world.advance_safe(5)
+	person.station = place
+	person.location = place
+	person.activity = "外出"
+	person.erase("role")
+	return "%s「分かった。%sは、私が守っておく。食べ物と水は、置いてある分を使うね」%sは荷物をまとめて、%sへ向かった。" % [name, place, name, place]
+
+static func recall(world, index: int) -> String:
+	var person: Dictionary = world.s.household_members[index]
+	var name := str(person.name)
+	var place := str(person.station)
+	person.erase("station")
+	person.location = "居間"
+	person.activity = "在宅"
+	world.advance_safe(5)
+	return "%s「うん、帰ろう」%sは%sを引き払って、家に戻った。" % [name, name, place]
+
+## Hourly, for each stationed housemate (from world._household_hour).
+static func hourly(world, person: Dictionary) -> void:
+	var place := str(person.station)
+	var site: Dictionary = world.s.district.sites.get(place, {})
+	var notices: Array = world.s.walkers.notices if world.s.has("walkers") else []
+	if site.is_empty() or int(site.get("level", 0)) < 1:
+		notices.append("%sが戻ってきた。「%sには、もういられなくなった」" % [person.name, place])
+		_home(person)
+		return
+	person.location = place
+	person.activity = "外出"
+	var hour := int(world.hour_of_day())
+	var cache: Dictionary = site.cache
+	var night := hour >= 23 or hour < 6
+	person.fatigue = clampf(float(person.fatigue) + (-12.5 if night else 100.0 / 24.0), 0.0, 100.0)
+	if float(person.hunger) >= 35.0 and float(cache.food) >= 0.25:
+		cache.food = float(cache.food) - 0.25
+		person.food_used = float(person.get("food_used", 0.0)) + 0.25
+		person.hunger = maxf(0.0, float(person.hunger) - 25.0)
+	if float(person.thirst) >= 25.0 and float(cache.water) >= 0.75:
+		cache.water = float(cache.water) - 0.75
+		person.water_used = float(person.get("water_used", 0.0)) + 0.75
+		person.thirst = maxf(0.0, float(person.thirst) - 25.0)
+	if float(person.hunger) >= 80.0 or float(person.thirst) >= 80.0:
+		notices.append("%sが、ふらふらになって戻ってきた。「%sには、もう食べ物も水も残ってない……」" % [person.name, place])
+		_home(person)
+		return
+	if hour != 10:
+		return
+	var minute := int(world.s.minute)
+	# The danger of the place: the dead around it, less behind boards.
+	var walkers := Walkers.count(world, place) + Walkers.count(world, "屋外") / 2
+	var risk := clampi(3 + walkers * 4, 0, 30)
+	if int(site.level) >= 2:
+		risk = risk / 2
+	var roll: int = world.draw(minute, int(person.id) + 61, "outpost-risk", 100)
+	if roll < risk:
+		person.health = maxf(1.0, float(person.health) - 30.0)
+		if roll < risk / 4:
+			person.hidden_bite_at = minute + 12 * 60
+		notices.append("【危険】%sが、%sから逃げ帰ってきた。腕に深い引っかき傷がある。「囲まれた……もう、あそこには戻れない」" % [person.name, place])
+		_home(person)
+		return
+	# A morning round of the empty buildings nearby.
+	var found := 0.0
+	for other in world.s.district.sites:
+		var s: Dictionary = world.s.district.sites[other]
+		if other == place or not bool(s.vacant) or float(s.food) <= 0.0:
+			continue
+		var take := minf(0.5, float(s.food))
+		s.food = float(s.food) - take
+		found += take
+		break
+	if found > 0.0:
+		cache.food = minf(100.0, float(cache.food) + found)
+
+static func _home(person: Dictionary) -> void:
+	person.erase("station")
+	person.location = "居間"
+	person.activity = "在宅"
