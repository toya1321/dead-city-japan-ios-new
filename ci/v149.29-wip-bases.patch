@@ -0,0 +1,56 @@
+extends SceneTree
+## Prints endings for varied lives (check wording and variety).
+const Main = preload("res://main.tscn")
+const Chronicle = preload("res://scripts/chronicle.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var specs := [
+		{"days": 2, "mates": 0, "cause": "out", "deeds": {}},
+		{"days": 12, "mates": 0, "cause": "bite", "deeds": {"gave": 3, "neighborly": 2}},
+		{"days": 40, "mates": 2, "cause": "starve", "deeds": {"rescued": 1, "joined": 3, "repelled": 2}, "food": 30.0},
+		{"days": 90, "mates": 1, "cause": "out", "deeds": {"refused": 1, "shelter": 4}, "food": 2.0, "mood": 10.0},
+		{"days": 400, "mates": 2, "cause": "other", "deeds": {"joined": 1}, "food": 40.0, "mood": 70.0},
+	]
+	var k := 0
+	for spec in specs:
+		var g = Main.instantiate()
+		root.add_child(g)
+		for i in 3: await process_frame
+		var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+		p.address = "東京"
+		p.seed = 900 + k
+		p.cohabitants = int(spec.mates)
+		p.companion_names = ["詩音", "蒼"].slice(0, int(spec.mates))
+		p.companion_genders = ["女性", "男性"].slice(0, int(spec.mates))
+		g._start_new_game(p)
+		g._finish_intro()
+		g.local_model.enabled = false
+		var w = g.world
+		Survivors.ensure(w)
+		w.s.society = "emergency"
+		w.s.minute = int(spec.days) * 1440 - 600
+		load("res://scripts/shelter.gd").hourly(w)
+		for key in spec.deeds:
+			Chronicle.deed(w, key, int(spec.deeds[key]))
+		Chronicle.hourly(w)
+		w.s.food = float(spec.get("food", 5.0))
+		for m in w.s.household_members:
+			m.mood = float(spec.get("mood", 50.0))
+		match str(spec.cause):
+			"bite": w.s.bitten = true
+			"starve": w.s.hunger = 100.0
+			"out":
+				g.location = "商店通り"
+		w.s.health = 0.0
+		g._refresh()
+		print("STORY<<", g.log_entries[-1], ">>\n")
+		print("PHOTO ", g.picture.texture.resource_path.get_file())
+		if OS.get_environment("DCJ_SHOT") != "":
+			for i in 6: await process_frame
+			root.get_viewport().get_texture().get_image().save_png("/tmp/claude-0/w/shots28/end_%d.png" % k)
+		g.queue_free()
+		k += 1
+	quit()
