+extends SceneTree
+## v149.29: the story of a life: turning points are written down, a housemate
+## who carries on gets the previous life summed up, and when nobody is left
+## the whole life is told back.
+const Main = preload("res://main.tscn")
+const Chronicle = preload("res://scripts/chronicle.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const Raiders = preload("res://scripts/raiders.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.address = "東京"
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	Survivors.ensure(w)
+	# Meeting the neighbour.
+	g.location = "屋外"
+	await g._on_command("住宅街へ行く")
+	var nb: Dictionary = Survivors.person(w, "neighbor_0")
+	check(str(Chronicle.state(w).moments).contains("出会った"), "meeting someone is written down")
+	# The city coming apart is written down once.
+	w.s.society = "disrupted"
+	Chronicle.hourly(w)
+	Chronicle.hourly(w)
+	var society_notes: Array = Chronicle.state(w).moments.filter(func(m): return str(m.kind) == "society")
+	check(society_notes.size() == 1, "a change in the city is written once")
+	# Someone joins, a raid is fought off.
+	nb.trust = 90
+	await g._on_command("お隣さん、一緒に住みませんか")
+	check(str(Chronicle.state(w).moments).contains("家に加わった"), "someone coming to live is written down")
+	w.s.raid = {"at": int(w.s.minute), "size": 2}
+	w.s.food = 3.0
+	Raiders.answer(w, "give")
+	w.s.raid = {"at": int(w.s.minute), "size": 2}
+	w.s.door_locked = false
+	w.s.barricade = 0
+	w.s.lights_off = false
+	w.s.grid_online = true
+	w.s.minute = int(w.s.raid.at) + 60
+	while not (w.hour_of_day() < 6.0 or w.hour_of_day() >= 18.0):
+		w.s.minute += 60
+		w.s.raid.at = int(w.s.minute) - 60
+	Raiders.hourly(w)
+	check(str(Chronicle.state(w).moments).contains("略奪者に押し入られ"), "a robbery is written down")
+	# Milestones.
+	w.s.minute += 8 * 1440
+	Chronicle.hourly(w)
+	check(str(Chronicle.state(w).moments).contains("7日が過ぎた"), "a week survived is marked")
+	g.location = "居間"
+	await g._on_command("生存記録")
+	check(str(g.log_entries.slice(-3)).contains("トウヤの記録") and str(g.log_entries.slice(-3)).contains("7日が過ぎた"), "the record can be read back")
+	# The player dies: no succession; the story is told, with the housemate's after.
+	var first := str(w.s.profile.name)
+	var mate := str(w.s.household_members[0].name)
+	w.s.bitten = true
+	w.s.health = 0.0
+	g._refresh()
+	var story: String = g.log_entries[-1]
+	check(str(w.s.profile.name) == first and float(w.s.health) <= 0.0, "a death ends the story; nobody takes over")
+	check(story.begins_with("―― %sの記録 ――" % first) and (story.contains("噛まれ") or story.contains("熱")), "the whole story is told: " + story.left(60))
+	check(story.contains(mate) and (story.contains("守り続けた") or story.contains("分け合った") or story.contains("熱を出した")), "with what became of the housemate")
+	check(story.contains("略奪者") and story.contains("日目"), "the turning points are in it")
+	check(g._suggestions() == ["記録を読み返す", "新しい世界で始める"], "after the end: read it again, or a new world")
+	await g._on_command("記録を読み返す")
+	check(g.log_entries[-1].begins_with("――"), "the story can be read again")
+	check(w.validate_state(w.s), "valid")
+	await g._on_command("新しい世界で始める")
+	check(is_instance_valid(g.title_screen), "a new world starts from the title")
+	# Endings differ between lives.
+	var E = load("res://scripts/epilogue.gd")
+	var openings := {}
+	for k in 12:
+		w.s.minute = (5 + k * 9) * 1440 + 300
+		openings[E.opening(w, "トウヤ", 5 + k * 9)] = true
+	check(openings.size() >= 6, "openings vary with how long and the day (%d kinds)" % openings.size())
+	Chronicle.deed(w, "rescued")
+	check(str(E.character(w, "トウヤ")).contains("隣"), "what the player did shapes the ending")
+	print("v149.29 chronicle checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
