+extends SceneTree
+## v149.29: the small shops become bases once abandoned; a housemate can live
+## at another base.
+const Main = preload("res://main.tscn")
+const District = preload("res://scripts/district.gd")
+const Outposts = preload("res://scripts/outposts.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func to_hour(w, hour: int) -> void:
+	w.s.minute = int(w.s.minute) / 60 * 60 + 60
+	while int(w.hour_of_day()) != hour:
+		w.s.minute += 60
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.cohabitants = 1
+	p.companion_names = ["詩音"]
+	p.companion_genders = ["女性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	# Open shops keep their own trade.
+	g.location = "屋外"
+	await g._on_command("食品店へ行く")
+	var cash := int(w.s.cash)
+	await g._on_command("食料を2個買う")
+	check(int(w.s.cash) < cash, "an open grocer still sells as before")
+	await g._on_command("ここを拠点にする")
+	check(int(w.s.district.sites["食品店"].level) == 0, "an open shop cannot be taken as a base")
+	# Once it is all over, the shops are empty and can be bases.
+	w.s.society = "emergency"
+	District.tick(w)
+	check(bool(w.s.district.sites["薬局"].vacant) and bool(w.s.shops.pharmacy.abandoned), "in the emergency the small shops are abandoned")
+	g.location = "屋外"
+	await g._on_command("薬局へ行く")
+	await g._on_command("物資を探索する")
+	await g._on_command("ここを拠点にする")
+	check(int(w.s.district.sites["薬局"].level) == 1, "the pharmacy becomes a base")
+	g._refresh()
+	check(str(g.picture.texture.resource_path).ends_with("pharmacy_base.jpg"), "and shows its base photo")
+	w.s.district.bag.food = 4.0
+	w.s.district.bag.water = 8.0
+	await g._on_command("物資を置く")
+	var site: Dictionary = w.s.district.sites["薬局"]
+	check(float(site.cache.food) >= 4.0, "supplies stored there")
+	# A housemate goes to live there.
+	await g._on_command("家に帰る")
+	await g._on_command("居間へ行く")
+	var shion: Dictionary = w.s.household_members[0]
+	shion.location = "居間"
+	shion.activity = "在宅"
+	await g._on_command("詩音を薬局に住ませる")
+	check(Outposts.stationed(shion) and str(shion.location) == "薬局", "a housemate goes to live at the base")
+	var cache_food := float(site.cache.food)
+	shion.hunger = 50.0
+	to_hour(w, 9)
+	w._household_hour()
+	check(float(site.cache.food) < cache_food and str(shion.location) == "薬局", "they eat from the base's own store")
+	w.s.district.sites["近所の空き家"].vacant = true
+	w.s.district.sites["近所の空き家"].food = 1.5
+	w.s.walkers.places = {}
+	var before := float(site.cache.food)
+	to_hour(w, 10)
+	w._household_hour()
+	check(float(site.cache.food) > before, "a morning round brings leftovers back from empty buildings")
+	g._refresh()
+	# Visiting them at the base.
+	g.location = "屋外"
+	await g._on_command("薬局へ行く")
+	check("詩音を家に呼び戻す" in g._suggestions(), "bringing them home is suggested at the base")
+	await g._on_command("詩音に話しかける")
+	check(g.dialogue.partner == 0, "they can be talked to at the base")
+	await g._on_command("会話を終える")
+	await g._on_command("詩音を家に呼び戻す")
+	check(not Outposts.stationed(shion) and str(shion.location) == "居間", "and they come home")
+	# Hungry with nothing stored, they come back by themselves.
+	Outposts.send(w, 0, "薬局")
+	site.cache.food = 0.0
+	site.cache.water = 0.0
+	shion.hunger = 85.0
+	w.s.walkers.notices = []
+	w._household_hour()
+	check(not Outposts.stationed(shion) and str(w.s.walkers.notices).contains("戻ってきた"), "with nothing left there, they come home")
+	# A dangerous base.
+	Outposts.send(w, 0, "薬局")
+	site.cache.food = 20.0
+	site.cache.water = 40.0
+	shion.hunger = 0.0
+	shion.thirst = 0.0
+	w.s.walkers.places = {"薬局": 6, "屋外": 6}
+	var hurt := false
+	for day in 12:
+		to_hour(w, 10)
+		w._household_hour()
+		if not Outposts.stationed(shion):
+			hurt = float(shion.health) < 100.0
+			break
+	check(hurt, "with the dead all around, they are hurt and flee home")
+	# Old saves gain the new sites.
+	var old: Dictionary = w.s.district.duplicate(true)
+	for place in ["食品店", "金物店", "薬局"]:
+		old.sites.erase(place)
+	check(not District.valid(old), "an old district lacks the shops")
+	District.upgrade(old)
+	check(District.valid(old), "and is upgraded")
+	check(w.validate_state(w.s) and g._save().begins_with("保存") and g._load() == "保存データを読み込んだ。", "save and load")
+	print("v149.29 base checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
