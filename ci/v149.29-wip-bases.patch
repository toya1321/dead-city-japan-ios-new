 		world.s.district.sites["コンビニ"].vacant = true
 	if world.s.society == "emergency":
 		world.s.district.sites["デパート"].vacant = true
+	# The small shops: empty once their staff are gone, or when it is all over.
+	for place in SITES:
+		if not is_shop(place) or not world.s.district.sites.has(place):
+			continue
+		var shop: Dictionary = world.s.get("shops", {}).get(str(SITES[place].shop), {})
+		if world.s.society == "emergency" or bool(shop.get("abandoned", false)):
+			world.s.district.sites[place].vacant = true
+			if not shop.is_empty():
+				shop.abandoned = true
+				shop.open = false
 
 static func can_enter(world, place: String) -> bool:
 	var site: Dictionary = world.s.district.sites[place]
@@ -63,6 +91,8 @@ static func fortified(world) -> bool:
 
 static func describe(world, place: String) -> String:
 	var site: Dictionary = world.s.district.sites[place]
+	if not site.vacant and is_shop(place):
+		return "まだ営業している。放棄されたあとに拠点として使えます。"
 	if not site.vacant:
 		if not can_enter(world, place):
 			return "営業時間外。中には入れません。"
