+
+## A small shop with its own trade while open.
+static func is_shop(place: String) -> bool:
+	return SITES.has(place) and SITES[place].has("shop")
+
+## v149.29: saves from before the small shops were bases get them added.
+static func upgrade(value: Variant) -> void:
