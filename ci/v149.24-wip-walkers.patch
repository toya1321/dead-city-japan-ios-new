+## v149.24 (D): when the player dies and a housemate is alive, the story goes
+## on as that housemate. The household, base and supplies carry over.
+func _succeed_to_housemate(farewell: String = "") -> void:
+	var heir := -1
+	# Prefer someone who was not bitten.
+	for i in world.s.household_members.size():
+		var candidate: Dictionary = world.s.household_members[i]
+		if float(candidate.health) > 0 and (heir < 0 or (bool(world.s.household_members[heir].get("bitten", false)) and not bool(candidate.get("bitten", false)))):
+			heir = i
+	if heir < 0:
+		return
+	succession_running = true
+	var person: Dictionary = world.s.household_members[heir]
+	var previous := str(world.s.profile.name)
+	if farewell.is_empty():
+		_append("【記録】%sは%s、息を引き取った。" % [previous, "噛まれた傷の熱にうなされた末に" if bool(world.s.get("bitten", false)) else "力尽きて"])
+	else:
+		_append(farewell)
+	world.s.profile.name = str(person.name)
+	world.s.profile.cohabitants = maxi(0, int(world.s.profile.cohabitants) - 1)
+	for key in ["companion_names", "companion_genders"]:
+		var values: Array = world.s.profile.get(key, [])
+		if heir < values.size():
+			values.remove_at(heir)
+		world.s.profile[key] = values
+	world.s.health = maxf(1.0, float(person.health))
+	for key in ["hunger", "thirst", "fatigue"]:
+		world.s[key] = float(person.get(key, 0.0))
+	world.s.injuries = 0
+	var heir_bitten := bool(person.get("bitten", false))
+	world.s.exposure = int(person.get("bitten_at", 0)) if heir_bitten else -1
+	world.s.symptoms_due = int(world.s.minute) if heir_bitten else -1
+	world.s.symptomatic = heir_bitten
+	world.s.bitten = heir_bitten
+	Walkers.ensure(world).encounter = {}
+	location = str(person.location) if Navigation.indoor(str(person.location)) or District.SITES.has(str(person.location)) or str(person.location) in Navigation.STREETS else location
+	world.s.household_members.remove_at(heir)
+	for i in world.s.household_members.size():
+		world.s.household_members[i].id = i
+	dialogue = HouseholdDialogue.new()
+	_sync_player_position()
+	_append("ここからは%sとして生きていく。%sが残した家と物資は、そのまま引き継がれる。" % [person.name, previous])
+	succession_running = false
+	_refresh()
+
+## Hourly events from the walker simulation that the player witnesses:
+## a housemate's death, and their rising in the same room.
+func _drain_walker_notices() -> void:
+	if log_box == null:
+		return
+	var w := Walkers.ensure(world)
+	var notices: Array = w.notices
+	w.notices = []
+	for line in notices:
+		_append(str(line) if str(line).begins_with("【") else "【記録】" + str(line))
+	if w.places.has("玄関") and Navigation.indoor(location) and location != "玄関" and w.encounter.is_empty() and not notices.is_empty():
+		_append("玄関の方で、何かが動いている気配がする。")
+	var mates: Array = w.risen_mates
+	w.risen_mates = []
+	for mate in mates:
+		if str(mate.place) == location:
+			w.encounter = {"place": location, "count": Walkers.count(world, location), "near": true, "since": int(world.s.minute), "from": ""}
+			_append("【危険】%sの体が、ぎこちなく起き上がった。濁った目が、こちらを向いている。" % mate.name)
+		elif Navigation.indoor(str(mate.place)):
+			_append("【危険】%sの方から、何かがぶつかるような音と、うめき声が聞こえてくる。" % mate.place)
+
+const LEAVE_WORDS := ["去る", "出ていく", "出て行く", "出ていこう", "出て行こう", "二度と戻らない", "一人で行く", "ひとりで行く", "別れを告げ"]
+
+## A bitten player leaves so as not to endanger the household; the story
+## goes on as a housemate. The one who left rises somewhere on the streets
+## days later.
+## "明かりを消す" / "明かりをつける": light at night draws walkers to the house.
+func _lights_command(cmd: String) -> bool:
+	if not cmd.contains("明かり") and not cmd.contains("電気") and not cmd.contains("照明"):
+		return false
+	var off := NPCMemory._mentions(cmd, ["消す", "消して", "落とす", "消そう"])
+	var on := NPCMemory._mentions(cmd, ["つける", "つけて", "点ける", "灯す"])
+	if off == on or not Navigation.indoor(location):
+		return false
+	world.s.lights_off = off
+	world.advance_safe(1)
+	_append("家の明かりを消した。外からは、人がいるようには見えないはずだ。" if off else "家の明かりをつけた。")
+	_refresh()
+	return true
+
+func _leave_home(cmd: String) -> bool:
+	if not bool(world.s.get("bitten", false)) or float(world.s.health) <= 0 or not NPCMemory._mentions(cmd, LEAVE_WORDS):
+		return false
+	var heirs: Array = world.s.household_members.filter(func(p): return float(p.health) > 0)
+	var w := Walkers.ensure(world)
+	var hours := maxi(6, int(float(world.s.health) / 0.022 / 60.0))
+	w.pending.append({"id": -2000 - int(world.s.minute) % 1000, "at": int(world.s.minute) + hours * 60, "place": ["駅前", "商店通り", "住宅街"][world.draw(int(world.s.minute), 5, "leaver", 3)]})
+	if heirs.is_empty():
+		location = "屋外"
+		_sync_player_position()
+		world.advance_safe(10)
+		_append("誰もいない家に背を向けて、通りへ出た。残された時間を、どこで過ごすか。")
+		_refresh()
+		return true
+	var heir: Dictionary = heirs[0]
+	world.s.health = 0.0
+	_succeed_to_housemate("【記録】%sは、熱で震える手で荷物をまとめた。「もう、ここにはいられない。%sを危ない目にあわせたくないから」。止める声を背に、%sは一人で家を出ていった。" % [world.s.profile.name, heir.name, world.s.profile.name])
+	return true
+
+## "詩音を寝室に隔離する" / "詩音を看病する" / "詩音を見送る" for a bitten housemate.
+func _care_command(cmd: String) -> bool:
+	if _leave_home(cmd) or _lights_command(cmd):
+		return true
+	for index in world.s.household_members.size():
+		var person: Dictionary = world.s.household_members[index]
+		if not cmd.contains(str(person.name)) or not bool(person.get("bitten", false)) or float(person.health) <= 0:
+			continue
+		if NPCMemory._mentions(cmd, ["隔離", "閉じ込", "部屋に入れ", "鍵をかけ"]):
+			var room := "寝室"
+			for candidate in ["寝室", "台所", "廊下"]:
+				if cmd.contains(candidate):
+					room = candidate
+			person.isolated = room
+			person.location = room
+			person.activity = "隔離"
+			if dialogue.partner == index:
+				dialogue.partner = -1
+			world.advance_safe(10)
+			_append("%sを%sに移し、扉を閉めた。中から「ありがとう。……ごめんね」と、かすれた声がした。" % [person.name, room])
+			_refresh()
+			return true
+		if NPCMemory._mentions(cmd, ["見送", "行かせ", "出ていかせ", "出て行かせ", "送り出"]):
+			var w := Walkers.ensure(world)
+			var hours := maxi(6, int(float(person.health) / (100.0 / 72.0)))
+			w.pending.append({"id": -1000 - int(person.id), "at": int(world.s.minute) + hours * 60, "place": ["駅前", "商店通り", "住宅街"][world.draw(int(world.s.minute), int(person.id), "leaver", 3)]})
+			world.advance_safe(15)
+			_append("%sは小さな荷物を背負って、玄関で振り返った。「みんなを危ない目にあわせたくないから。……今まで、ありがとう」。扉が閉まり、足音が遠ざかっていった。" % person.name)
+			world.s.household_members.remove_at(index)
+			world.s.profile.cohabitants = maxi(0, int(world.s.profile.cohabitants) - 1)
+			for key in ["companion_names", "companion_genders"]:
+				var values: Array = world.s.profile.get(key, [])
+				if index < values.size():
+					values.remove_at(index)
+				world.s.profile[key] = values
+			for i in world.s.household_members.size():
+				world.s.household_members[i].id = i
+			dialogue = HouseholdDialogue.new()
+			_refresh()
+			return true
+		if NPCMemory._mentions(cmd, ["看病", "そばにいる", "付き添", "手当て"]):
+			person.erase("isolated")
+			world.advance_safe(30)
+			_append("%sの額を冷やし、水を飲ませた。熱は下がらない。それでも%sは、少しだけ笑った。" % [person.name, person.name])
+			_refresh()
+			return true
+	return false
+
+## The player sees walkers where they are; returns true when an encounter began.
+func _check_walkers(previous: String) -> bool:
+	if world.s.health <= 0:
+		return false
+	var w := Walkers.ensure(world)
+	if not w.encounter.is_empty():
+		return true
+	var enc := Walkers.check(world, location, false, previous if previous != location else "")
+	if enc.is_empty():
+		return false
+	_append("【危険】" + Walkers.describe(enc))
+	_refresh()
+	return true
+
+## One turn while walkers are in sight: hide, flee, fight or look.
+func _encounter_turn(cmd: String) -> void:
+	var w := Walkers.ensure(world)
+	var enc: Dictionary = w.encounter
+	var kind := Walkers.intent(cmd)
+	if kind.is_empty():
+		_append("近くに感染者がいる。今は「隠れる」「逃げる」「戦う」「様子を見る」のどれかを選んでほしい。何も実行していません。")
+		_refresh()
+		return
+	var present: Array = []
+	for i in world.s.household_members.size():
+		var person: Dictionary = world.s.household_members[i]
+		if str(person.location) == location and float(person.health) > 0 and str(person.get("isolated", "")).is_empty():
+			present.append(i)
+	var back := str(enc.get("from", ""))
+	var result := Walkers.resolve(world, kind, Walkers.weapon_bonus(world.s.inventory), present.size(), present)
+	world.advance_safe(int(result.minutes))
+	_append(("【危険】" if bool(result.bitten) else "") + str(result.text))
+	if kind == "flee" and bool(result.ended) and not bool(result.bitten):
+		var destination := back if not back.is_empty() and back != location else ("屋外" if location != "屋外" else "建物前")
+		var path := Navigation.route(location, destination, str(world.s.profile.housing))
+		if path.size() >= 2:
+			location = destination
+			_sync_player_position()
+			for i in present:
+				world.s.household_members[i].location = destination
+				world.s.household_members[i].activity = "在宅" if Navigation.indoor(destination) else "外出"
+			world.advance_safe(Navigation.duration(path[0], path[1]))
+			_append("%sまで戻った。" % (location if present.is_empty() else location + "まで、一緒に"))
+	if result.has("mate_bitten"):
+		var mate: Dictionary = world.s.household_members[int(result.mate_bitten)]
+		_append("%sの腕に、くっきりと歯の跡が残っている。数日のうちに熱が出て、助からない。%sを看病するか、部屋に隔離するか、本人の望むように見送るか、決めなければならない。" % [mate.name, mate.name])
+	if bool(result.bitten):
+		var heirs: Array = world.s.household_members.filter(func(p): return float(p.health) > 0)
+		_append("噛まれた傷から、じわじわと熱が広がっていく気がする。この傷は治らない。動けるのは、あと数日。" + ("残された時間で、%sに物資や拠点を託すことも、巻き込まないように一人で出ていくこともできる。" % heirs[0].name if not heirs.is_empty() else "残された時間で、何をするか決めなければならない。"))
+	_refresh()
+
