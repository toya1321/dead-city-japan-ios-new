+extends SceneTree
+## v149.24: the dead rise and walk; the player sees them, can be noticed, and
+## chooses to hide, flee, fight or look. A bite is fatal over days.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func new_game():
+	var game = Main.instantiate()
+	root.add_child(game)
+	await process_frame
+	var profile: Dictionary = game.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = 1
+	profile.companion_names = ["詩音"]
+	game._start_new_game(profile)
+	game._finish_intro()
+	game.local_model.enabled = false
+	return game
+
+func run() -> void:
+	var game = await new_game()
+	var world = game.world
+	check(Walkers.valid(world.s.walkers) and world.validate_state(world.s), "a new game has a valid walker state")
+	var zero: Dictionary = world.s.agents[world.PATIENT_ZERO]
+	check(int(zero.exposure) == 0 and int(zero.symptoms_due) >= 36 * 60, "the first local infection starts at the beginning")
+
+	# --- The dead rise once, a few hours after death, near where they fell.
+	var a: Dictionary = world.s.agents[3]
+	a.dead = true
+	a.x = 10.0
+	a.z = 38.0
+	Walkers.hourly(world)
+	check(Walkers.count(world, "住宅街") == 0 and world.s.walkers.pending.size() >= 1, "a death is scheduled to rise later")
+	world.s.minute += 7 * 60
+	Walkers.hourly(world)
+	Walkers.hourly(world)
+	var risen: Array = world.s.walkers.risen
+	check(3 in risen and risen.count(3) == 1, "the resident rose exactly once")
+	var total := 0
+	for place in world.s.walkers.places:
+		total += int(world.s.walkers.places[place])
+	check(total >= 1, "the risen walker is somewhere on the map")
+
+	# --- Meeting them outside.
+	world.s.walkers.places = {"商店通り": 2}
+	world.s.walkers.encounter = {}
+	await game._on_command("商店通りへ行く")
+	var enc: Dictionary = world.s.walkers.encounter
+	check(not enc.is_empty() and str(enc.place) == "商店通り" and game.log_entries[-1].begins_with("【危険】"), "arriving where walkers are shows them")
+	check(game.danger_label.text == "感染者 2", "the header shows how many are here")
+	check(game._suggestions() == ["隠れる", "逃げる", "戦う", "様子を見る"], "the suggestions turn into encounter choices")
+	var minute: int = world.s.minute
+	await game._on_command("ニュースを見る")
+	check(world.s.minute == minute and game.log_entries[-1].contains("何も実行していません"), "other actions wait while walkers are in sight")
+	await game._on_command("物陰に隠れてやり過ごす")
+	check(world.s.minute > minute, "hiding takes time")
+	check(Walkers.intent("走って家に戻る") == "flee" and Walkers.intent("木材で殴る") == "fight" and Walkers.intent("少し様子を見る") == "look", "free text maps to encounter actions")
+
+	# --- Fleeing returns to where the player came from.
+	world.s.walkers.encounter = {"place": "商店通り", "count": 2, "near": false, "since": world.s.minute, "from": "屋外"}
+	game.location = "商店通り"
+	await game._on_command("逃げる")
+	check(world.s.walkers.encounter.is_empty() and game.location == "屋外", "fleeing from afar gets back to the previous place")
+
+	# --- Fighting: a hit removes one; noise spreads; repeated fights resolve.
+	world.s.walkers.places = {"商店通り": 1}
+	world.s.walkers.encounter = {"place": "商店通り", "count": 1, "near": true, "since": world.s.minute, "from": "屋外"}
+	game.location = "商店通り"
+	world.s.inventory.parts = 1
+	var outcome := ""
+	for i in 8:
+		if world.s.walkers.encounter.is_empty() or float(world.s.health) <= 0:
+			break
+		world.s.minute += 1
+		await game._on_command("戦う")
+		outcome = game.log_entries[-1]
+	check(world.s.walkers.encounter.is_empty(), "a fight ends one way or another: " + outcome)
+	check(int(world.s.walkers.noise.get("商店通り", -1)) > 0, "fighting makes noise that carries")
+
+	# --- A bite infects and is fatal over days.
+	var bitten = await new_game()
+	var bw = bitten.world
+	bw.s.walkers.places = {"屋外": 5}
+	bw.s.walkers.encounter = {"place": "屋外", "count": 5, "near": true, "since": 0, "from": "建物前"}
+	bitten.location = "屋外"
+	var result := {}
+	for i in 30:
+		bw.s.minute += 1
+		bw.s.walkers.encounter = {"place": "屋外", "count": 5, "near": true, "since": 0, "from": "建物前"}
+		result = Walkers.resolve(bw, "flee")
+		if bool(result.bitten):
+			break
+	check(bool(result.bitten) and bool(bw.s.bitten) and int(bw.s.exposure) >= 0, "being caught by many leads to a bite and infection")
+	check(bitten.Vitals.warning(bw.s).contains("噛まれた"), "the status warns about the bite")
+	var start: int = bw.s.minute
+	for h in 24 * 6:
+		bw.s.hunger = 0.0
+		bw.s.thirst = 0.0
+		bw.s.fatigue = 0.0
+		bw.advance_safe(60)
+		if float(bw.s.health) <= 0:
+			break
+	var days := float(int(bw.s.minute) - start) / 1440.0
+	check(float(bw.s.health) <= 0 and days >= 1.5 and days <= 6.0, "a bite is fatal after %.1f days" % days)
+
+	# --- (B) Failing while they are still at a distance is a scratch, never a bite.
+	var careful = await new_game()
+	var cw = careful.world
+	var scratches := 0
+	for i in 40:
+		cw.s.minute += 1
+		cw.s.walkers.places = {"屋外": 4}
+		cw.s.walkers.encounter = {"place": "屋外", "count": 4, "near": false, "since": 0, "from": "建物前"}
+		var r := Walkers._caught(cw, cw.s.walkers.encounter, 4, false, "")
+		scratches += 1 if not bool(r.bitten) else 0
+	check(scratches == 40 and not bool(cw.s.get("bitten", false)) and int(cw.s.exposure) < 0, "being grabbed at a distance only scratches")
+	var bites := 0
+	for i in 200:
+		cw.s.minute += 1
+		cw.s.bitten = false
+		cw.s.exposure = -1
+		var r := Walkers._caught(cw, {"place": "屋外", "count": 1, "near": true}, 1, true, "")
+		bites += 1 if bool(r.bitten) else 0
+	check(bites > 0 and bites < 40, "one walker up close rarely bites (%d / 200)" % bites)
+	cw.s.protection = 80
+	var guarded := 0
+	for i in 200:
+		cw.s.minute += 1
+		cw.s.bitten = false
+		var r := Walkers._caught(cw, {"place": "屋外", "count": 5, "near": true}, 5, true, "")
+		guarded += 1 if bool(r.bitten) else 0
+	check(guarded < 40, "protection lowers bites when surrounded (%d / 200)" % guarded)
+
+	# --- (D) After death the story continues as a living housemate.
+	var heir = await new_game()
+	var hw = heir.world
+	hw.s.bitten = true
+	hw.s.exposure = 10
+	hw.s.health = 0.0
+	heir._refresh()
+	check(str(hw.s.profile.name) == "詩音" and hw.s.household_members.is_empty() and float(hw.s.health) > 0 and not bool(hw.s.bitten) and int(hw.s.exposure) < 0, "the housemate takes over with their own health")
+	check(heir.log_entries[-2].contains("息を引き取った") and heir.log_entries[-1].contains("詩音として"), "the chronicle records the death and the handover")
+	check(hw.validate_state(hw.s), "the state after the handover is valid")
+	hw.s.health = 0.0
+	heir._refresh()
+	check(float(hw.s.health) <= 0, "with nobody left the game ends")
+
+	# --- With a housemate alongside, the one grabbed may be them.
+	var pair = await new_game()
+	var pw = pair.world
+	var shion: Dictionary = pw.s.household_members[0]
+	var mate_hit := false
+	for i in 300:
+		pw.s.minute += 1
+		shion.health = 100.0
+		shion.erase("bitten")
+		var r := Walkers._caught(pw, {"place": "屋外", "count": 5, "near": true}, 5, true, "", [0])
+		if r.has("mate_bitten"):
+			mate_hit = true
+			break
+	check(mate_hit and bool(shion.bitten), "a housemate can be the one bitten")
+	check(pair.NPCMind._condition(shion).contains("噛まれた"), "the housemate's condition tells the model about the bite")
+
+	# --- Isolating, the fever, death, and rising inside the room.
+	pair.location = "居間"
+	shion.location = "居間"
+	shion.health = 100.0
+	pair._refresh()
+	check("詩音を寝室に隔離する" in pair._suggestions() and "詩音を看病する" in pair._suggestions(), "the suggestions offer to isolate or nurse")
+	await pair._on_command("詩音を寝室に隔離する")
+	check(str(shion.isolated) == "寝室" and str(shion.location) == "寝室" and pair.log_entries[-1].contains("扉を閉めた"), "isolating moves them behind a closed door")
+	for h in 24 * 4:
+		pw.s.hunger = 0.0
+		pw.s.thirst = 0.0
+		pw.s.fatigue = 0.0
+		pw.advance_safe(60)
+		pair._refresh()
+		if Walkers.count(pw, "寝室") > 0:
+			break
+	check(float(shion.health) <= 0, "the bitten housemate dies within days")
+	check(Walkers.count(pw, "寝室") == 1 and Walkers.count(pw, "居間") == 0, "they rise inside the isolated room")
+	var heard := false
+	for line in pair.log_entries:
+		heard = heard or line.contains("息を引き取った") or line.contains("うめき声")
+	check(heard, "the chronicle records the death and the sounds")
+	pw.s.walkers.encounter = {}
+	await pair._on_command("寝室へ行く")
+	check(not pw.s.walkers.encounter.is_empty() and str(pw.s.walkers.encounter.place) == "寝室", "opening the room means facing them")
+
+	# --- Fleeing together takes the housemate along.
+	var duo = await new_game()
+	var dw = duo.world
+	dw.s.walkers.places = {"商店通り": 1}
+	dw.s.walkers.encounter = {"place": "商店通り", "count": 1, "near": false, "since": 0, "from": "屋外"}
+	duo.location = "商店通り"
+	dw.s.household_members[0].location = "商店通り"
+	await duo._on_command("逃げる")
+	check(duo.location == "屋外" and str(dw.s.household_members[0].location) == "屋外", "the housemate flees with the player")
+
+	# --- A bitten player can leave so the housemate is not endangered.
+	var leaver = await new_game()
+	var lw = leaver.world
+	lw.s.bitten = true
+	lw.s.exposure = int(lw.s.minute)
+	lw.s.health = 80.0
+	leaver.location = "居間"
+	leaver._refresh()
+	check("みんなのために、一人で出ていく" in leaver._suggestions(), "a bitten player is offered to leave")
+	await leaver._on_command("みんなのために、一人で出ていく")
+	check(str(lw.s.profile.name) == "詩音" and lw.s.household_members.is_empty() and not bool(lw.s.bitten) and float(lw.s.health) > 0, "leaving hands the story to the housemate")
+	check(leaver.log_entries[-2].contains("一人で家を出ていった") and lw.validate_state(lw.s), "the chronicle records the departure")
+	var later := false
+	for p in lw.s.walkers.pending:
+		later = later or int(p.at) > int(lw.s.minute) + 6 * 60
+	check(later, "the one who left will rise on the streets days later")
+	var plain = await new_game()
+	plain.location = "玄関"
+	await plain._on_command("家を出る")
+	check(str(plain.world.s.profile.name) != "詩音", "an ordinary trip out does not end the story")
+
+	# --- Seeing a bitten housemate off.
+	var farewell = await new_game()
+	var fw = farewell.world
+	Walkers.bite_housemate(fw, 0)
+	farewell.location = "居間"
+	farewell._refresh()
+	check("詩音を見送る" in farewell._suggestions(), "seeing them off is offered")
+	await farewell._on_command("詩音を見送る")
+	check(fw.s.household_members.is_empty() and int(fw.s.profile.cohabitants) == 0 and farewell.log_entries[-1].contains("今まで、ありがとう") and fw.validate_state(fw.s), "the housemate leaves of their own will")
+
+	# --- Random events at home: drawn by light, knocking, getting in.
+	var home = await new_game()
+	var hw2 = home.world
+	home.location = "居間"
+	hw2.s.minute = 13 * 60 + 1440   # 21:00 on day 2
+	hw2.s.walkers.places = {"屋外": 3}
+	var lit_pulls := 0
+	var dark_pulls := 0
+	for i in 200:
+		hw2.s.minute += 60
+		hw2.s.walkers.places = {"屋外": 3}
+		hw2.s.lights_off = false
+		Walkers.home_events(hw2)
+		lit_pulls += 1 if Walkers.count(hw2, "建物前") > 0 else 0
+		hw2.s.walkers.places = {"屋外": 3}
+		hw2.s.lights_off = true
+		Walkers.home_events(hw2)
+		dark_pulls += 1 if Walkers.count(hw2, "建物前") > 0 else 0
+	check(lit_pulls > dark_pulls, "lights draw walkers to the house (%d lit / %d dark)" % [lit_pulls, dark_pulls])
+	hw2.s.walkers.notices = []
+	hw2.s.door_locked = true
+	hw2.s.barricade = 0
+	var knocked := false
+	for i in 100:
+		hw2.s.minute += 60
+		hw2.s.walkers.places = {"建物前": 2}
+		Walkers.home_events(hw2)
+		knocked = knocked or str(hw2.s.walkers.notices).contains("叩く音")
+	check(knocked and Walkers.count(hw2, "玄関") == 0, "a locked door is knocked on but holds")
+	hw2.s.door_locked = false
+	var entered := false
+	for i in 100:
+		hw2.s.minute += 60
+		hw2.s.walkers.places = {"建物前": 2}
+		Walkers.home_events(hw2)
+		if Walkers.count(hw2, "玄関") > 0:
+			entered = true
+			break
+	check(entered and str(hw2.s.walkers.notices).contains("家の中に入ってきた"), "an unlocked door lets one in")
+	home._refresh()
+	check(home.log_entries[-1].contains("玄関の方で") or home.log_entries[-2].contains("家の中に入ってきた"), "the player hears it from another room")
+	await home._on_command("玄関へ行く")
+	check(not hw2.s.walkers.encounter.is_empty() and str(hw2.s.walkers.encounter.place) == "玄関", "going to the entrance means facing it")
+	hw2.s.walkers.encounter = {}
+	hw2.s.walkers.places = {"建物前": 1}
+	hw2.s.lights_off = false
+	home.location = "居間"
+	home._refresh()
+	check("明かりを消す" in home._suggestions(), "the suggestions offer to turn the lights off")
+	await home._on_command("明かりを消す")
+	check(bool(hw2.s.lights_off), "the lights can be turned off")
+	hw2.s.walkers.alarm = true
+	hw2.s.food = 20.0
+	hw2.s.water = 40.0
+	await home._on_command("3時間待つ")
+	check(int(home.active_wait.elapsed) < 180 and str(home.active_wait.reason).contains("物音"), "a sound at the door interrupts a wait")
+
+	# --- Save and load keep the walkers.
+	var saver = await new_game()
+	saver.world.s.walkers.places = {"駅前": 4}
+	check(saver._save().begins_with("保存") and saver._load() == "保存データを読み込んだ。" and Walkers.count(saver.world, "駅前") == 4, "walkers survive save and load")
+
+	print("v149.24 walker checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
