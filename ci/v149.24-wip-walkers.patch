@@ -0,0 +1,335 @@
+extends RefCounted
+## v149.24: the risen dead, counted per place (see ZOMBIE_DESIGN.md).
+## Slow walkers; a bite infects and kills over days; fighting is possible but
+## risky. All randomness goes through world.draw so results are reproducible.
+const Navigation = preload("res://scripts/navigation.gd")
+
+const OUTDOOR := ["屋外", "商店通り", "住宅街", "駅前", "建物前"]
+const BUILDINGS := ["コンビニ", "近所の空き家", "デパート", "食品店", "金物店", "薬局"]
+const RISE_MIN_HOURS := 2
+const RISE_MAX_HOURS := 6
+const WEAPONS := {"バール": 25, "金づち": 25, "ハンマー": 25, "包丁": 10, "木刀": 20, "傘": 0}
+
+static func fresh() -> Dictionary:
+	return {"places": {}, "risen": [], "pending": [], "noise": {}, "encounter": {}, "killed": 0, "last_day": -1, "risen_mates": [], "notices": [], "alarm": false}
+
+static func ensure(world) -> Dictionary:
+	if not world.s.has("walkers") or not world.s.walkers is Dictionary:
+		world.s.walkers = fresh()
+	var w: Dictionary = world.s.walkers
+	for key in fresh():
+		if not w.has(key):
+			w[key] = fresh()[key]
+	return w
+
+static func valid(value: Variant) -> bool:
+	if not value is Dictionary:
+		return false
+	for key in ["places", "noise", "encounter"]:
+		if not value.get(key) is Dictionary:
+			return false
+	for key in ["risen", "pending"]:
+		if not value.get(key) is Array:
+			return false
+	for place in value.places:
+		var n = value.places[place]
+		if not (n is int or n is float) or int(n) < 0 or int(n) > 500:
+			return false
+	return true
+
+static func count(world, place: String) -> int:
+	return int(ensure(world).places.get(place, 0))
+
+static func _add(world, place: String, amount: int) -> void:
+	var w := ensure(world)
+	w.places[place] = maxi(0, int(w.places.get(place, 0)) + amount)
+	if int(w.places[place]) == 0:
+		w.places.erase(place)
+
+## Place nearest to a resident's street position.
+static func place_for(x: float, z: float) -> String:
+	if x >= 45.0:
+		return "駅前"
+	if z >= 30.0:
+		return "住宅街"
+	if z >= 12.0:
+		return "商店通り"
+	return "屋外"
+
+## Hourly: the dead rise after a few hours, walkers drift, newcomers arrive.
+static func hourly(world) -> void:
+	var w := ensure(world)
+	var minute := int(world.s.minute)
+	# Residents who died are scheduled to rise once.
+	for a in world.s.agents:
+		if not bool(a.get("dead", false)) or int(a.id) in w.risen:
+			continue
+		var queued := false
+		for p in w.pending:
+			queued = queued or int(p.id) == int(a.id)
+		if not queued:
+			var delay: int = (RISE_MIN_HOURS + world.draw(minute, int(a.id), "rise-delay", RISE_MAX_HOURS - RISE_MIN_HOURS + 1)) * 60
+			w.pending.append({"id": int(a.id), "at": minute + delay, "place": place_for(float(a.x), float(a.z))})
+	var still: Array = []
+	for p in w.pending:
+		if minute >= int(p.at):
+			w.risen.append(int(p.id))
+			_add(world, str(p.place), 1)
+			if p.has("name"):
+				w.risen_mates.append({"name": str(p.name), "place": str(p.place), "minute": minute})
+		else:
+			still.append(p)
+	w.pending = still
+	# Newcomers from outside the map once the region is affected.
+	var day := minute / 1440
+	if minute % 1440 == 0 and day != int(w.last_day):
+		w.last_day = day
+		var arriving: int = {"normal": 0, "alert": world.draw(minute, 0, "walker-arrival", 2), "disrupted": 1 + world.draw(minute, 0, "walker-arrival", 2), "emergency": 2 + world.draw(minute, 0, "walker-arrival", 3)}.get(str(world.s.society), 0)
+		for i in arriving:
+			_add(world, ["駅前", "商店通り"][world.draw(minute, i, "walker-entry", 2)], 1)
+		# Long after the collapse the dead slowly fall apart.
+		if day >= 60:
+			for place in w.places.keys():
+				if world.draw(minute, place.hash(), "walker-decay", 100) < 1 * int(w.places[place]):
+					_add(world, place, -1)
+	# Drift between neighbouring outdoor places, toward recent noise.
+	var graph: Dictionary = Navigation.graph(str(world.s.profile.housing))
+	var moves: Array = []
+	for place in w.places.keys():
+		var n := int(w.places[place])
+		var chance := 25 if place in OUTDOOR else 10
+		for i in n:
+			if world.draw(minute, place.hash() + i, "walker-move", 100) >= chance:
+				continue
+			var options: Array = []
+			for next in graph.get(place, []):
+				if next in OUTDOOR or next in BUILDINGS:
+					options.append(next)
+			if options.is_empty():
+				continue
+			var target: String = options[world.draw(minute, place.hash() + i, "walker-dir", options.size())]
+			for next in options:
+				if int(w.noise.get(next, -1)) >= minute:
+					target = next
+			moves.append([place, target])
+	for m in moves:
+		_add(world, m[0], -1)
+		_add(world, m[1], 1)
+	for place in w.noise.keys():
+		if int(w.noise[place]) < minute:
+			w.noise.erase(place)
+
+## v149.24: random events at the player's home. Walkers outside are drawn by
+## light at night (power on and lights not turned off) and by noise; at the
+## door they knock, and an unlocked, unbarricaded door lets one in.
+const HOME_OUTSIDE := ["屋外", "建物前"]
+
+static func home_events(world) -> void:
+	var w := ensure(world)
+	var minute := int(world.s.minute)
+	var hour: float = world.hour_of_day()
+	var night := hour < 6.0 or hour >= 18.0
+	var lit: bool = night and world.has_home_power() and not bool(world.s.get("lights_off", false))
+	var street := count(world, "屋外")
+	var porch := count(world, "建物前")
+	# Drawn to the house from the street.
+	if street > 0:
+		var pull := 4 + (12 if lit else 0) + (15 if int(w.noise.get("玄関", -1)) >= minute or int(w.noise.get("居間", -1)) >= minute else 0)
+		if world.draw(minute, street, "home-pull", 100) < pull:
+			_add(world, "屋外", -1)
+			_add(world, "建物前", 1)
+			porch += 1
+			if night and world.draw(minute, 3, "home-shadow", 100) < 50:
+				w.notices.append("【危険】窓の外を、ふらつく人影が横切った。家の前で立ち止まったように見える。")
+	if porch <= 0:
+		return
+	var roll: int = world.draw(minute, porch * 7, "home-door", 100)
+	var open_door: bool = not bool(world.s.door_locked) and int(world.s.barricade) <= 0
+	if open_door and roll < 25:
+		_add(world, "建物前", -1)
+		_add(world, "玄関", 1)
+		w.alarm = true
+		w.notices.append("【危険】玄関の扉が、きしみながら開く音がした。誰かが家の中に入ってきた。")
+	elif roll < 30:
+		# Knocking on a locked door is recorded; only an unlocked one is an alarm.
+		w.alarm = open_door
+		if int(world.s.barricade) > 0:
+			w.notices.append("【危険】玄関の補強板が、外から叩かれている。うめき声が聞こえる。板はまだ持ちこたえている。")
+		else:
+			world.s.longplay.shelter_integrity = maxf(0.0, float(world.s.longplay.shelter_integrity) - 1.0)
+			w.notices.append("【危険】玄関の扉を、どん、どんと叩く音がする。鍵はかかっている。音はなかなかやまない。")
+	elif roll >= 85:
+		_add(world, "建物前", -1)
+		_add(world, "屋外", 1)
+
+static func make_noise(world, place: String, minutes: int = 60) -> void:
+	var w := ensure(world)
+	w.noise[place] = int(world.s.minute) + minutes
+	var graph: Dictionary = Navigation.graph(str(world.s.profile.housing))
+	for next in graph.get(place, []):
+		w.noise[next] = maxi(int(w.noise.get(next, -1)), int(world.s.minute) + minutes / 2)
+
+## At a place with walkers the player sees them; whether they notice the
+## player depends on light, noise and numbers. Returns the encounter or {}.
+static func check(world, place: String, loud: bool = false, from: String = "") -> Dictionary:
+	var w := ensure(world)
+	var n := count(world, place)
+	if n <= 0:
+		return {}
+	if not w.encounter.is_empty() and str(w.encounter.place) == place:
+		return w.encounter
+	var hour: float = world.hour_of_day()
+	var night := hour < 6.0 or hour >= 18.0
+	var per := (20 if night else 10) + (30 if loud else 0)
+	var chance := 100 - int(100.0 * pow(1.0 - per / 100.0, n))
+	var noticed: bool = world.draw(int(world.s.minute), place.hash(), "walker-notice", 100) < chance
+	w.encounter = {"place": place, "count": n, "near": noticed, "since": int(world.s.minute), "from": from}
+	return w.encounter
+
+static func describe(enc: Dictionary) -> String:
+	var n := int(enc.count)
+	var who := "様子のおかしい人" if n == 1 else "様子のおかしい人たち（%d人）" % n
+	if bool(enc.near):
+		return "%sが、ふらつきながらこちらへ近づいてくる。目が濁り、うめき声が聞こえる。" % who
+	return "少し先に%sがいる。ゆっくりと歩き回っている。まだこちらには気づいていないようだ。" % who
+
+## Only things the player actually carries help: wood as a club, metal parts
+## as a bar. Named weapons the player does not own give nothing.
+static func weapon_bonus(inventory: Dictionary) -> int:
+	if int(inventory.get("parts", 0)) > 0:
+		return 20
+	if int(inventory.get("wood", 0)) > 0:
+		return 15
+	return 0
+
+## Which encounter action a line asks for ("" when it is something else).
+static func intent(text: String) -> String:
+	for spec in [["hide", ["隠れ", "潜", "やり過ご", "息を殺", "身を伏せ", "物陰"]], ["flee", ["逃げ", "引き返", "戻る", "戻ろう", "走って", "離れ", "家に帰"]], ["fight", ["戦", "殴", "倒す", "倒そ", "攻撃", "叩", "刺", "やっつけ", "撃退"]], ["look", ["様子", "観察", "数え", "見張", "うかが"]]]:
+		for word in spec[1]:
+			if text.contains(word):
+				return spec[0]
+	return ""
+
+## Resolves one action during an encounter. kind: hide / flee / fight / look.
+## Returns {"text", "bitten": bool, "ended": bool, "minutes": int}.
+## `present`: indexes of housemates standing with the player. They help in a
+## fight, and when someone is grabbed it may be one of them.
+static func resolve(world, kind: String, weapon: int = 0, allies: int = 0, present: Array = []) -> Dictionary:
+	var w := ensure(world)
+	var enc: Dictionary = w.encounter
+	if enc.is_empty():
+		return {"text": "近くに感染者はいない。", "bitten": false, "ended": true, "minutes": 0}
+	var minute := int(world.s.minute)
+	var n := maxi(1, count(world, str(enc.place)))
+	enc.count = n
+	var near := bool(enc.near)
+	var roll: int = world.draw(minute, n * 31 + (7 if near else 0), "walker-" + kind, 100)
+	match kind:
+		"look":
+			enc.near = true if roll < 30 else near
+			return {"text": describe(enc) + ("　気づかれた。" if not near and bool(enc.near) else ""), "bitten": false, "ended": false, "minutes": 3}
+		"hide":
+			var chance := (80 if not near else 45) - 6 * (n - 1)
+			if roll < chance:
+				w.encounter = {}
+				return {"text": "物陰に身を潜めて息を殺した。足音とうめき声が、やがて遠ざかっていった。", "bitten": false, "ended": true, "minutes": 20}
+			enc.near = true
+			return {"text": "隠れようとしたが、物音を立ててしまった。こちらに向かってくる。", "bitten": false, "ended": false, "minutes": 5}
+		"flee":
+			var chance := (95 if not near else 75) - 5 * (n - 1)
+			if roll < chance:
+				w.encounter = {}
+				return {"text": "背を向けて、来た道を足早に引き返した。追ってくる気配は遠ざかった。", "bitten": false, "ended": true, "minutes": 5}
+			return _caught(world, enc, n, near, "逃げようとしたところで、腕をつかまれた。", present)
+		"fight":
+			make_noise(world, str(enc.place))
+			var chance := clampi(30 + weapon + 15 * allies, 5, 90)
+			var text := ""
+			if roll < chance:
+				_add(world, str(enc.place), -1)
+				w.killed = int(w.killed) + 1
+				text = "力いっぱい打ちつけた。相手は崩れ落ち、動かなくなった。"
+				if count(world, str(enc.place)) <= 0:
+					w.encounter = {}
+					return {"text": text + "　あたりに、ほかの姿はない。物音が響いたので、長居はしない方がいい。", "bitten": false, "ended": true, "minutes": 5}
+				enc.count = count(world, str(enc.place))
+				enc.near = true
+				return {"text": text + "　まだ%d人いる。" % int(enc.count), "bitten": false, "ended": false, "minutes": 5}
+			if near and world.draw(minute, n, "walker-grab", 100) < 50:
+				var caught := _caught(world, enc, n, near, "打ちかかったが、かわされた。もつれ合ったはずみに、", present)
+				if not bool(caught.bitten):
+					caught.ended = false
+					w.encounter = enc
+				return caught
+			enc.near = true
+			return {"text": "打ちかかったが、うまく当たらなかった。相手はまだ迫ってくる。", "bitten": false, "ended": false, "minutes": 5}
+	return {"text": "", "bitten": false, "ended": false, "minutes": 0}
+
+## v149.24 (B): most failures end in a scratch or a bruise. A bite needs a
+## grab at close range, and is likelier when surrounded. Protection (thick
+## clothes, guards; `s.protection`, 0-80) lowers it.
+static func _caught(world, enc: Dictionary, n: int, near: bool, lead: String, present: Array = []) -> Dictionary:
+	var minute := int(world.s.minute)
+	# With housemates alongside, the one grabbed may be one of them.
+	if not present.is_empty() and world.draw(minute, n * 17, "walker-victim", present.size() + 1) > 0:
+		var index: int = present[world.draw(minute, n * 19, "walker-who", present.size())]
+		return _caught_housemate(world, enc, n, near, index)
+	var chance := 0
+	if near:
+		chance = 8 + 12 * (mini(n, 5) - 1)
+	chance = maxi(0, chance - int(world.s.get("protection", 0)) * chance / 100)
+	if world.draw(minute, n * 13, "walker-bite", 100) < chance:
+		return _bite(world, enc, lead)
+	world.s.health = maxf(0.0, float(world.s.health) - 6.0)
+	world.s.injuries = int(world.s.injuries) + 1
+	ensure(world).encounter = {}
+	return {"text": lead + "爪が服を裂き、腕に引っかき傷ができた。歯は届かなかった。振りほどいて距離をとった。", "bitten": false, "ended": true, "minutes": 5}
+
+static func _caught_housemate(world, enc: Dictionary, n: int, near: bool, index: int) -> Dictionary:
+	var minute := int(world.s.minute)
+	var person: Dictionary = world.s.household_members[index]
+	var chance := 0
+	if near:
+		chance = 8 + 12 * (mini(n, 5) - 1)
+	ensure(world).encounter = {}
+	if world.draw(minute, n * 23, "walker-bite-mate", 100) < chance:
+		bite_housemate(world, index)
+		return {"text": "%sの悲鳴が上がった。腕をつかまれ、噛まれていた。二人で必死に振りほどき、その場を離れた。" % person.name, "bitten": false, "mate_bitten": index, "ended": true, "minutes": 5}
+	person.health = maxf(1.0, float(person.health) - 6.0)
+	return {"text": "%sが腕をつかまれた。爪が服を裂いたが、歯は届かなかった。二人で振りほどいて距離をとった。" % person.name, "bitten": false, "ended": true, "minutes": 5}
+
+## A bitten housemate runs a fever and dies within about three days, then
+## rises where they are. Keeping them apart (`isolated`) contains that.
+static func bite_housemate(world, index: int) -> void:
+	var person: Dictionary = world.s.household_members[index]
+	person.bitten = true
+	person.bitten_at = int(world.s.minute)
+
+## Hourly course of a bitten housemate; returns lines for the chronicle.
+static func housemates_hourly(world) -> Array:
+	var lines: Array = []
+	var w := ensure(world)
+	for person in world.s.household_members:
+		if not bool(person.get("bitten", false)) or float(person.health) <= 0:
+			continue
+		person.health = maxf(0.0, float(person.health) - 100.0 / 72.0)
+		if float(person.health) <= 0:
+			var place := str(person.get("isolated", "")) if not str(person.get("isolated", "")).is_empty() else str(person.location)
+			person.location = place
+			person.activity = "死亡"
+			w.pending.append({"id": -1000 - int(person.id), "at": int(world.s.minute) + 60 * (1 + world.draw(int(world.s.minute), int(person.id), "mate-rise", 3)), "place": place, "name": str(person.name)})
+			lines.append("%sが、静かに息を引き取った。" % person.name)
+	for line in lines:
+		w.notices.append(line)
+	return lines
+
+static func _bite(world, enc: Dictionary, lead: String) -> Dictionary:
+	var minute := int(world.s.minute)
+	world.s.health = maxf(0.0, float(world.s.health) - 15.0)
+	world.s.injuries = int(world.s.injuries) + 1
+	if int(world.s.exposure) < 0:
+		world.s.exposure = minute
+		world.s.symptoms_due = minute + (6 + world.draw(minute, 1, "bite-fever", 19)) * 60
+	world.s.bitten = true
+	ensure(world).encounter = {}
+	return {"text": lead + "腕に鋭い痛みが走った。噛まれた。必死に振りほどいて、その場を離れた。", "bitten": true, "ended": true, "minutes": 5}
