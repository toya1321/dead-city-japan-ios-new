diff --git a/scripts/walkers.gd b/scripts/walkers.gd
new file mode 100644
index 0000000..0267fbc
--- /dev/null
+++ b/scripts/walkers.gd
@@ -0,0 +1,626 @@
+extends RefCounted
+## v149.24: the risen dead, counted per place (see ZOMBIE_DESIGN.md).
+## Slow walkers; a bite infects and kills over days; fighting is possible but
+## risky. All randomness goes through world.draw so results are reproducible.
+const Navigation = preload("res://scripts/navigation.gd")
+const Mood = preload("res://scripts/mood.gd")
+
+const OUTDOOR := ["屋外", "商店通り", "住宅街", "駅前", "建物前"]
+const BUILDINGS := ["コンビニ", "近所の空き家", "デパート", "食品店", "金物店", "薬局"]
+const RISE_MIN_HOURS := 2
+const RISE_MAX_HOURS := 6
+const WEAPONS := {"バール": 25, "金づち": 25, "ハンマー": 25, "包丁": 10, "木刀": 20, "傘": 0}
+
+static func fresh() -> Dictionary:
+	return {"places": {}, "risen": [], "pending": [], "noise": {}, "encounter": {}, "killed": 0, "last_day": -1, "risen_mates": [], "notices": [], "alarm": false}
+
+static func ensure(world) -> Dictionary:
+	if not world.s.has("walkers") or not world.s.walkers is Dictionary:
+		world.s.walkers = fresh()
+	var w: Dictionary = world.s.walkers
+	for key in fresh():
+		if not w.has(key):
+			w[key] = fresh()[key]
+	return w
+
+static func valid(value: Variant) -> bool:
+	if not value is Dictionary:
+		return false
+	for key in ["places", "noise", "encounter"]:
+		if not value.get(key) is Dictionary:
+			return false
+	for key in ["risen", "pending"]:
+		if not value.get(key) is Array:
+			return false
+	for place in value.places:
+		var n = value.places[place]
+		if not (n is int or n is float) or int(n) < 0 or int(n) > 500:
+			return false
+	return true
+
+static func count(world, place: String) -> int:
+	var w := ensure(world)
+	return int(w.places.get(place, 0)) + horde_at(world, place)
+
+## Size of a passing horde at a place (0 when none is there).
+static func horde_at(world, place: String) -> int:
+	var horde: Dictionary = ensure(world).get("horde", {})
+	if horde.is_empty() or str(horde.place) != place:
+		return 0
+	return int(horde.size)
+
+static func _add(world, place: String, amount: int) -> void:
+	var w := ensure(world)
+	var base := int(w.places.get(place, 0))
+	if amount < 0 and base + amount < 0 and horde_at(world, place) > 0:
+		# Taken from the passing horde (one breaks off, or is killed).
+		w.horde.size = maxi(0, int(w.horde.size) + base + amount)
+		amount = -base
+	w.places[place] = maxi(0, base + amount)
+	if int(w.places[place]) == 0:
+		w.places.erase(place)
+
+## Place nearest to a resident's street position.
+static func place_for(x: float, z: float) -> String:
+	if x >= 45.0:
+		return "駅前"
+	if z >= 30.0:
+		return "住宅街"
+	if z >= 12.0:
+		return "商店通り"
+	return "屋外"
+
+## Hourly: the dead rise after a few hours, walkers drift, newcomers arrive.
+static func hourly(world) -> void:
+	var w := ensure(world)
+	var minute := int(world.s.minute)
+	# Residents who died are scheduled to rise once.
+	for a in world.s.agents:
+		if not bool(a.get("dead", false)) or int(a.id) in w.risen:
+			continue
+		var queued := false
+		for p in w.pending:
+			queued = queued or int(p.id) == int(a.id)
+		if not queued:
+			var delay: int = (RISE_MIN_HOURS + world.draw(minute, int(a.id), "rise-delay", RISE_MAX_HOURS - RISE_MIN_HOURS + 1)) * 60
+			w.pending.append({"id": int(a.id), "at": minute + delay, "place": place_for(float(a.x), float(a.z))})
+	var still: Array = []
+	for p in w.pending:
+		if minute >= int(p.at):
+			w.risen.append(int(p.id))
+			_add(world, str(p.place), 1)
+			if p.has("name"):
+				w.risen_mates.append({"name": str(p.name), "place": str(p.place), "minute": minute})
+		else:
+			still.append(p)
+	w.pending = still
+	# Newcomers from outside the map once the region is affected.
+	var day := minute / 1440
+	if minute % 1440 == 0 and day != int(w.last_day):
+		w.last_day = day
+		var arriving: int = {"normal": 0, "alert": world.draw(minute, 0, "walker-arrival", 2), "disrupted": 1 + world.draw(minute, 0, "walker-arrival", 2), "emergency": 2 + world.draw(minute, 0, "walker-arrival", 3)}.get(str(world.s.society), 0)
+		for i in arriving:
+			_add(world, ["駅前", "商店通り"][world.draw(minute, i, "walker-entry", 2)], 1)
+		# Long after the collapse the dead slowly fall apart.
+		if day >= 60:
+			for place in w.places.keys():
+				if world.draw(minute, place.hash(), "walker-decay", 100) < 1 * int(w.places[place]):
+					_add(world, place, -1)
+	# Drift between neighbouring outdoor places, toward recent noise.
+	var graph: Dictionary = Navigation.graph(str(world.s.profile.housing))
+	var moves: Array = []
+	for place in w.places.keys():
+		var n := int(w.places[place])
+		var chance := 25 if place in OUTDOOR else 10
+		for i in n:
+			if world.draw(minute, place.hash() + i, "walker-move", 100) >= chance:
+				continue
+			var options: Array = []
+			for next in graph.get(place, []):
+				# The house's doorstep is reached only for a reason (home_events).
+				if (next in OUTDOOR or next in BUILDINGS) and next != "建物前":
+					options.append(next)
+			if options.is_empty():
+				continue
+			var target: String = options[world.draw(minute, place.hash() + i, "walker-dir", options.size())]
+			for next in options:
+				if int(w.noise.get(next, -1)) >= minute:
+					target = next
+			moves.append([place, target])
+	for m in moves:
+		_add(world, m[0], -1)
+		_add(world, m[1], 1)
+	for place in w.noise.keys():
+		if int(w.noise[place]) < minute:
+			w.noise.erase(place)
+
+## v149.24: random events at the player's home. Walkers outside are drawn by
+## light at night (power on and lights not turned off) and by noise; at the
+## door they knock, and an unlocked, unbarricaded door lets one in.
+const HOME_OUTSIDE := ["屋外", "建物前"]
+
+## Why walkers would come to the house right now. Nothing comes without a
+## reason: a light showing at night, noise at home, or being followed back.
+## Careful players (lights off at night, quiet, losing pursuers) are left alone.
+static func home_reasons(world) -> Array:
+	var w := ensure(world)
+	var minute := int(world.s.minute)
+	var hour: float = world.hour_of_day()
+	var night := hour < 6.0 or hour >= 18.0
+	var out: Array = []
+	if night and world.has_home_power() and not bool(world.s.get("lights_off", false)) and not bool(world.s.get("blackout", false)):
+		out.append("light")
+	if int(w.get("smell_until", -1)) >= minute:
+		out.append("smell")
+	if int(w.get("sound_until", -1)) >= minute:
+		out.append("sound")
+	for room in ["玄関", "居間", "台所", "寝室", "廊下"]:
+		if int(w.noise.get(room, -1)) >= minute:
+			out.append("noise")
+			break
+	var followed: Dictionary = w.get("followed", {})
+	if not followed.is_empty() and minute <= int(followed.until) and bool(world.get_meta("player_at_home", false)):
+		out.append("followed")
+	return out
+
+const STREET_REASONS := ["light", "noise"]
+const REASON_TEXT := {"light": "窓から漏れる明かり", "noise": "家の中の物音", "smell": "料理のにおい", "sound": "テレビや話し声", "followed": "さっき逃げてきた時に、後をつけられていた"}
+
+## Hourly, at the house. Every step is announced so the player can react:
+## 1) a figure on the street turns toward the house (warning),
+## 2) an hour later, if the reason remains, it comes to the door,
+## 3) at the door it knocks while drawn, and leaves once nothing draws it,
+## 4) it only gets in through an unlocked, unbarricaded door.
+static func home_events(world) -> void:
+	var w := ensure(world)
+	var minute := int(world.s.minute)
+	var reasons := home_reasons(world)
+	var followed: Dictionary = w.get("followed", {})
+	if not followed.is_empty() and minute > int(followed.until):
+		w.erase("followed")
+	var porch := count(world, "建物前")
+	if "followed" in reasons:
+		w.erase("followed")
+		var from := str(followed.place)
+		if count(world, from) > 0:
+			_add(world, from, -1)
+		_add(world, "建物前", 1)
+		porch += 1
+		w.notices.append("【危険】玄関の外で、引きずるような足音が止まった。逃げてきた時に、後をつけられていたらしい。")
+	var drawn := reasons.filter(func(r): return r != "followed")
+	if "followed" in reasons:
+		# A pursuer stays at the door for an hour before giving up.
+		drawn.append("followed")
+	var street := count(world, "屋外")
+	# Only light and loud noise reach the street; ordinary sounds and smells
+	# carry just past the door, to anything already standing there.
+	var pulls := drawn.filter(func(r): return r in STREET_REASONS)
+	var passing := horde_at(world, "屋外")
+	if passing > 0:
+		# The horde shuffles right past the door: any sound, smell or light is noticed.
+		pulls = drawn.filter(func(r): return r != "followed")
+		if not pulls.is_empty():
+			var come: int = mini(passing, 3 + world.draw(minute, passing, "horde-pull", 4))
+			_add(world, "屋外", -come)
+			_add(world, "建物前", come)
+			porch += come
+			w.erase("drawn_at")
+			w.alarm = true
+			Mood.everyone(world, -5.0)
+			w.notices.append("【危険】群れの一部が、%sに気づいた。何体もが、家の前に押し寄せてきた。" % REASON_TEXT[pulls[0]])
+			pulls = []
+	if street > 0 and not pulls.is_empty():
+		if int(w.get("drawn_at", -1)) >= 0 and minute - int(w.drawn_at) >= 60:
+			w.erase("drawn_at")
+			_add(world, "屋外", -1)
+			_add(world, "建物前", 1)
+			porch += 1
+			w.notices.append("【危険】%sに引き寄せられたのか、人影が家の前まで来て立ち止まった。" % REASON_TEXT[pulls[0]])
+			Mood.everyone(world, -3.0)
+		elif not w.has("drawn_at"):
+			w.drawn_at = minute
+			w.alarm = true
+			Mood.everyone(world, -2.0)
+			w.notices.append("【警告】家の前の通りにいた人影が、こちらを向いて立ち止まった。%sに気づいたのかもしれない。" % REASON_TEXT[pulls[0]])
+	elif w.has("drawn_at"):
+		w.erase("drawn_at")
+	if porch <= 0:
+		w.erase("knocking")
+		return
+	var broken: bool = bool(world.s.get("door_broken", false)) and int(world.s.barricade) <= 0
+	var open_door: bool = (not bool(world.s.door_locked) and int(world.s.barricade) <= 0) or broken
+	if open_door:
+		var come := mini(porch, 2 if broken else 1)
+		_add(world, "建物前", -come)
+		_add(world, "玄関", come)
+		w.alarm = true
+		Mood.everyone(world, -8.0)
+		w.notices.append("【危険】壊れた玄関から、感染者がなだれ込んできた。" if broken else "【危険】鍵のかかっていない玄関の扉が、きしみながら開いた。誰かが家の中に入ってきた。")
+	elif not drawn.is_empty():
+		w.alarm = true
+		var first := not w.has("knocking")
+		if first:
+			w.knocking = true
+			Mood.everyone(world, -3.0)
+			if int(world.s.barricade) > 0:
+				w.notices.append("【危険】玄関の補強板が、外から叩かれている。うめき声が聞こえる。")
+			else:
+				w.notices.append("【危険】玄関の扉を、どん、どんと叩く音がする。鍵はかかっている。" + ("静かにしていれば、そのうち離れていくかもしれない。" if drawn[0] == "followed" else "%sがある限り、離れそうにない。" % REASON_TEXT[drawn[0]]))
+		var damage_note := batter_door(world, 1.5 * porch)
+		if not damage_note.is_empty():
+			w.notices.append(damage_note)
+	else:
+		w.erase("knocking")
+		_add(world, "建物前", -1)
+		_add(world, "屋外", 1)
+		w.notices.append("家の前にいた足音が、ゆっくりと遠ざかっていった。")
+
+## The front door: `door_hp` 0-100 behind `barricade` layers of boards, each
+## worth BOARD_HP (`board_damage` on the outermost). Knocking wears the boards
+## first, then the door; at 0 the door is broken and no longer locks.
+const BOARD_HP := 50.0
+
+static func door_hp(world) -> float:
+	return float(world.s.get("door_hp", 100.0))
+
+static func batter_door(world, damage: float) -> String:
+	if int(world.s.barricade) > 0:
+		world.s.board_damage = float(world.s.get("board_damage", 0.0)) + damage
+		if float(world.s.board_damage) >= BOARD_HP:
+			world.s.board_damage = 0.0
+			world.s.barricade = int(world.s.barricade) - 1
+			Mood.everyone(world, -3.0)
+			if int(world.s.barricade) > 0:
+				return "【危険】めりめりと音がして、補強の板が一枚はがれ落ちた。残りは%d段。" % int(world.s.barricade)
+			return "【危険】最後の補強板がはがれ落ちた。あとは扉だけだ。"
+		return ""
+	if bool(world.s.get("door_broken", false)):
+		return ""
+	var before := door_hp(world)
+	var after := maxf(0.0, before - damage)
+	world.s.door_hp = after
+	world.s.longplay.shelter_integrity = maxf(0.0, float(world.s.longplay.shelter_integrity) - damage * 0.2)
+	if after <= 0.0:
+		world.s.door_broken = true
+		world.s.door_locked = false
+		Mood.everyone(world, -10.0)
+		return "【危険】大きな音を立てて、玄関の扉が破られた！　鍵はもう役に立たない。"
+	for mark in [[20.0, "【危険】扉の板が割れ、隙間から腕が差し込まれてくる。もう長くはもたない。"], [50.0, "【危険】蝶番がゆるみ、扉が叩かれるたびに大きく揺れる。"], [75.0, "【警告】叩かれ続けて、扉がきしみ始めた。"]]:
+		if before > float(mark[0]) and after <= float(mark[0]):
+			return str(mark[1])
+	return ""
+
+## Mending the door: wood and parts, an hour, and loud hammering.
+static func repair_door(world) -> String:
+	if door_hp(world) >= 100.0 and not bool(world.s.get("door_broken", false)):
+		return "玄関の扉は傷んでいない。"
+	if int(world.s.inventory.wood) < 1 or int(world.s.inventory.parts) < 1:
+		return "扉の修理には木材1と部品1が必要。"
+	if count(world, "玄関") > 0:
+		return "玄関に感染者がいる。今は修理できない。"
+	world.s.inventory.wood = int(world.s.inventory.wood) - 1
+	world.s.inventory.parts = int(world.s.inventory.parts) - 1
+	world.advance_safe(60)
+	world.s.door_hp = 100.0
+	world.s.door_broken = false
+	make_noise(world, "玄関", 60)
+	return "60分かけて、玄関の扉を板と金具で直した。また鍵がかかる。金づちの音が外に響いた。"
+
+## What the door looks like from the inside.
+static func door_text(world) -> String:
+	if bool(world.s.get("door_broken", false)):
+		return "壊れている（鍵がかからない）"
+	var hp := door_hp(world)
+	if hp >= 100.0:
+		return "無傷"
+	if hp > 75.0:
+		return "少し傷んでいる"
+	if hp > 50.0:
+		return "きしんでいる"
+	if hp > 20.0:
+		return "蝶番がゆるんでいる"
+	return "今にも破られそう"
+
+const HORDE_ROUTE := ["駅前", "駅前", "住宅街", "住宅街", "屋外", "屋外", "屋外", "商店通り", "商店通り"]
+
+static func total(world) -> int:
+	var n := 0
+	for place in ensure(world).places:
+		n += int(ensure(world).places[place])
+	return n
+
+## Hourly: once the town is overrun, a horde forms every week or so at the
+## station and walks past the house. The town's emergency radio announces it
+## hours ahead; its noise is heard an hour before it reaches the street.
+static func horde_hourly(world) -> void:
+	var w := ensure(world)
+	var minute := int(world.s.minute)
+	var horde: Dictionary = w.get("horde", {})
+	if horde.is_empty():
+		if not w.has("horde_next"):
+			if total(world) >= 12:
+				w.horde_next = minute + (36 + world.draw(minute, 11, "horde-first", 72)) * 60
+			return
+		if minute < int(w.horde_next):
+			return
+		# A horde is made of the town's dead: it grows as the town empties.
+		var size: int = clampi(total(world) / 2 + 8 + world.draw(minute, 12, "horde-size", 8), 12, 60)
+		w.horde = {"place": HORDE_ROUTE[0], "step": 0, "size": size}
+		w.horde_next = minute + (5 * 24 + world.draw(minute, 13, "horde-gap", 4 * 24)) * 60
+		if minute < 60 * 1440:
+			w.notices.append("【防災無線】こちらは、防災無線です。駅前付近に多数の感染者が集まり、住宅街の方向へ移動しています。付近の方は外出を控え、屋内で明かりを消し、物音を立てずに過ごしてください。")
+		else:
+			w.notices.append("【警告】駅の方角から、風に乗って、大勢のうめき声がかすかに聞こえる。")
+		Mood.everyone(world, -2.0)
+		return
+	var step := int(horde.step) + 1
+	if step >= HORDE_ROUTE.size():
+		# It breaks up: a few stay behind on the shopping street.
+		_add(world, "商店通り", int(horde.size) / 3)
+		w.erase("horde")
+		if bool(world.get_meta("player_at_home", true)):
+			w.notices.append("群れの足音が遠ざかり、やがて聞こえなくなった。張りつめていた息を、ようやく吐いた。")
+			Mood.everyone(world, 3.0)
+		return
+	horde.step = step
+	horde.place = HORDE_ROUTE[step]
+	if step + 1 < HORDE_ROUTE.size() and HORDE_ROUTE[step + 1] == "屋外" and str(horde.place) != "屋外":
+		w.alarm = true
+		Mood.everyone(world, -3.0)
+		w.notices.append("【危険】遠くから、大勢の引きずるような足音とうめき声が近づいてくる。群れが、もうすぐこの通りに来る。")
+	elif str(horde.place) == "屋外" and HORDE_ROUTE[step - 1] != "屋外":
+		Mood.everyone(world, -5.0)
+		w.notices.append("【危険】家の前の通りを、感染者の群れがぞろぞろと通り過ぎていく。数えきれない。物音ひとつ立てられない。")
+
+## Ordinary household sound (a film at normal volume, voices): heard only
+## by something already standing at the door.
+static func make_sound(world, minutes: int = 60) -> void:
+	var w := ensure(world)
+	w.sound_until = maxi(int(w.get("sound_until", -1)), int(world.s.minute) + minutes)
+
+## Cooking sends a smell out through the vent for a while.
+static func make_smell(world, minutes: int = 60) -> void:
+	var w := ensure(world)
+	w.smell_until = maxi(int(w.get("smell_until", -1)), int(world.s.minute) + minutes)
+
+## Rough words for a number seen from a distance; exact counts need a look.
+static func vague(n: int) -> String:
+	if n <= 0:
+		return "誰もいない"
+	if n == 1:
+		return "人影が一つ"
+	if n <= 4:
+		return "人影がいくつか"
+	return "大勢の人影が"
+
+## What can be seen of the street and the door from a window at home.
+static func window_view(world) -> String:
+	var w := ensure(world)
+	var street := count(world, "屋外")
+	var porch := count(world, "建物前")
+	if street <= 0 and porch <= 0:
+		return "家の前の通りに、ふらついて歩く人影は見当たらない。"
+	var parts: Array = []
+	if horde_at(world, "屋外") > 0:
+		parts.append("家の前の通りを、感染者の群れが列をなして、のろのろと通り過ぎていく。数えきれない。")
+	elif street > 0:
+		parts.append("家の前の通りに%s見える。ゆっくりと、ふらつくように歩いている。" % vague(street))
+		if w.has("drawn_at"):
+			parts.append("そのうちの一つが、こちらの家の方を向いて立ち止まっている。")
+	if porch > 0:
+		parts.append("玄関のすぐ前にも、%s立っている。" % vague(porch))
+	var reasons := home_reasons(world).filter(func(r): return r != "followed")
+	if not reasons.is_empty():
+		parts.append("（%sが、外に伝わっているかもしれない。）" % "、".join(reasons.map(func(r): return REASON_TEXT[r])))
+	return "".join(parts)
+
+static func make_noise(world, place: String, minutes: int = 60) -> void:
+	var w := ensure(world)
+	w.noise[place] = int(world.s.minute) + minutes
+	var graph: Dictionary = Navigation.graph(str(world.s.profile.housing))
+	for next in graph.get(place, []):
+		w.noise[next] = maxi(int(w.noise.get(next, -1)), int(world.s.minute) + minutes / 2)
+
+## At a place with walkers the player sees them; whether they notice the
+## player depends on light, noise and numbers. Returns the encounter or {}.
+static func check(world, place: String, loud: bool = false, from: String = "") -> Dictionary:
+	var w := ensure(world)
+	var n := count(world, place)
+	if n <= 0:
+		return {}
+	if not w.encounter.is_empty() and str(w.encounter.place) == place:
+		return w.encounter
+	var hour: float = world.hour_of_day()
+	var night := hour < 6.0 or hour >= 18.0
+	var per := (20 if night else 10) + (30 if loud else 0)
+	var chance := 100 - int(100.0 * pow(1.0 - per / 100.0, n))
+	var noticed: bool = world.draw(int(world.s.minute), place.hash(), "walker-notice", 100) < chance
+	w.encounter = {"place": place, "count": n, "near": noticed, "since": int(world.s.minute), "from": from}
+	return w.encounter
+
+## A glance does not give a number: one, a few, many, a horde. An exact
+## count needs a careful look (`counted`, valid while the number holds).
+static func estimate(n: int, counted: int = -1) -> String:
+	if n <= 0:
+		return "いない"
+	if n == 1:
+		return "1人"
+	if counted == n and n < 10:
+		return "%d人" % n
+	if n <= 4:
+		return "数人"
+	if n <= 9:
+		return "大勢"
+	return "群れ"
+
+static func describe(enc: Dictionary) -> String:
+	var n := int(enc.count)
+	var counted := int(enc.get("counted", -1))
+	var who := "様子のおかしい人"
+	if n >= 10:
+		who = "数えきれないほどの感染者の群れ"
+	elif n > 1 and counted == n:
+		who = "様子のおかしい人たち（%d人）" % n
+	elif n > 4:
+		who = "様子のおかしい人たち（大勢）"
+	elif n > 1:
+		who = "様子のおかしい人たち（何人か）"
+	if bool(enc.near):
+		return "%sが、ふらつきながらこちらへ近づいてくる。目が濁り、うめき声が聞こえる。" % who
+	return "少し先に%sがいる。ゆっくりと歩き回っている。まだこちらには気づいていないようだ。" % who
+
+## Only things the player actually carries help: wood as a club, metal parts
+## as a bar. Named weapons the player does not own give nothing.
+static func weapon_bonus(inventory: Dictionary) -> int:
+	if int(inventory.get("parts", 0)) > 0:
+		return 20
+	if int(inventory.get("wood", 0)) > 0:
+		return 15
+	return 0
+
+## Which encounter action a line asks for ("" when it is something else).
+static func intent(text: String) -> String:
+	for spec in [["hide", ["隠れ", "潜", "やり過ご", "息を殺", "身を伏せ", "物陰"]], ["flee", ["逃げ", "引き返", "戻る", "戻ろう", "走って", "離れ", "家に帰"]], ["fight", ["戦", "殴", "倒す", "倒そ", "攻撃", "叩", "刺", "やっつけ", "撃退"]], ["look", ["様子", "観察", "数え", "見張", "うかが"]]]:
+		for word in spec[1]:
+			if text.contains(word):
+				return spec[0]
+	return ""
+
+## Resolves one action during an encounter. kind: hide / flee / fight / look.
+## Returns {"text", "bitten": bool, "ended": bool, "minutes": int}.
+## `present`: indexes of housemates standing with the player. They help in a
+## fight, and when someone is grabbed it may be one of them.
+static func resolve(world, kind: String, weapon: int = 0, allies: int = 0, present: Array = []) -> Dictionary:
+	var w := ensure(world)
+	var enc: Dictionary = w.encounter
+	if enc.is_empty():
+		return {"text": "近くに感染者はいない。", "bitten": false, "ended": true, "minutes": 0}
+	var minute := int(world.s.minute)
+	var n := maxi(1, count(world, str(enc.place)))
+	enc.count = n
+	var near := bool(enc.near)
+	var roll: int = world.draw(minute, n * 31 + (7 if near else 0), "walker-" + kind, 100)
+	match kind:
+		"look":
+			enc.near = true if roll < 30 else near
+			var tally := ""
+			if n >= 10:
+				tally = "　目を凝らしたが、数えきれない。ざっと見て、%d人以上はいる。" % (n / 10 * 10)
+			elif n > 1:
+				enc.counted = n
+				tally = "　物陰から目を凝らして数えた。%d人いる。" % n
+			return {"text": describe(enc) + tally + ("　気づかれた。" if not near and bool(enc.near) else ""), "bitten": false, "ended": false, "minutes": 3}
+		"hide":
+			var chance := (80 if not near else 45) - 6 * (mini(n, 6) - 1) - Mood.nerve_penalty(world.s)
+			if roll < chance:
+				w.encounter = {}
+				return {"text": "物陰に身を潜めて息を殺した。足音とうめき声が、やがて遠ざかっていった。", "bitten": false, "ended": true, "minutes": 20}
+			enc.near = true
+			return {"text": "隠れようとしたが、物音を立ててしまった。こちらに向かってくる。", "bitten": false, "ended": false, "minutes": 5}
+		"flee":
+			var chance := (95 if not near else 75) - 5 * (mini(n, 6) - 1) - Mood.nerve_penalty(world.s)
+			if roll < chance:
+				w.encounter = {}
+				if near:
+					# Seen while running: it may follow the player home.
+					w.followed = {"place": str(enc.place), "until": minute + 180}
+					return {"text": "背を向けて、来た道を足早に引き返した。うめき声が、まだ後ろから聞こえる。気づかれたまま家に戻ると、ついてくるかもしれない。", "bitten": false, "ended": true, "minutes": 5}
+				return {"text": "背を向けて、来た道を足早に引き返した。追ってくる気配は遠ざかった。", "bitten": false, "ended": true, "minutes": 5}
+			return _caught(world, enc, n, near, "逃げようとしたところで、腕をつかまれた。", present)
+		"fight":
+			make_noise(world, str(enc.place))
+			var chance := clampi(30 + weapon + 15 * allies - Mood.nerve_penalty(world.s), 5, 90)
+			var text := ""
+			if roll < chance:
+				_add(world, str(enc.place), -1)
+				w.killed = int(w.killed) + 1
+				text = "力いっぱい打ちつけた。相手は崩れ落ち、動かなくなった。"
+				if count(world, str(enc.place)) <= 0:
+					w.encounter = {}
+					return {"text": text + "　あたりに、ほかの姿はない。物音が響いたので、長居はしない方がいい。", "bitten": false, "ended": true, "minutes": 5}
+				enc.count = count(world, str(enc.place))
+				enc.near = true
+				var left := int(enc.count)
+				return {"text": text + ("　すぐそばに、まだ%d人いる。" % left if left <= 3 else "　まだ何人もいる。"), "bitten": false, "ended": false, "minutes": 5}
+			if near and world.draw(minute, n, "walker-grab", 100) < 50:
+				var caught := _caught(world, enc, n, near, "打ちかかったが、かわされた。もつれ合ったはずみに、", present)
+				if not bool(caught.bitten):
+					caught.ended = false
+					w.encounter = enc
+				return caught
+			enc.near = true
+			return {"text": "打ちかかったが、うまく当たらなかった。相手はまだ迫ってくる。", "bitten": false, "ended": false, "minutes": 5}
+	return {"text": "", "bitten": false, "ended": false, "minutes": 0}
+
+## v149.24 (B): most failures end in a scratch or a bruise. A bite needs a
+## grab at close range, and is likelier when surrounded. Protection (thick
+## clothes, guards; `s.protection`, 0-80) lowers it.
+static func _caught(world, enc: Dictionary, n: int, near: bool, lead: String, present: Array = []) -> Dictionary:
+	var minute := int(world.s.minute)
+	# With housemates alongside, the one grabbed may be one of them.
+	if not present.is_empty() and world.draw(minute, n * 17, "walker-victim", present.size() + 1) > 0:
+		var index: int = present[world.draw(minute, n * 19, "walker-who", present.size())]
+		return _caught_housemate(world, enc, n, near, index)
+	var chance := 0
+	if near:
+		chance = 8 + 12 * (mini(n, 5) - 1)
+	chance = maxi(0, chance - int(world.s.get("protection", 0)) * chance / 100)
+	if world.draw(minute, n * 13, "walker-bite", 100) < chance:
+		return _bite(world, enc, lead)
+	world.s.health = maxf(0.0, float(world.s.health) - 6.0)
+	world.s.injuries = int(world.s.injuries) + 1
+	ensure(world).encounter = {}
+	return {"text": lead + "爪が服を裂き、腕に引っかき傷ができた。歯は届かなかった。振りほどいて距離をとった。", "bitten": false, "ended": true, "minutes": 5}
+
+static func _caught_housemate(world, enc: Dictionary, n: int, near: bool, index: int) -> Dictionary:
+	var minute := int(world.s.minute)
+	var person: Dictionary = world.s.household_members[index]
+	var chance := 0
+	if near:
+		chance = 8 + 12 * (mini(n, 5) - 1)
+	ensure(world).encounter = {}
+	if world.draw(minute, n * 23, "walker-bite-mate", 100) < chance:
+		bite_housemate(world, index)
+		return {"text": "%sの悲鳴が上がった。腕をつかまれ、噛まれていた。二人で必死に振りほどき、その場を離れた。" % person.name, "bitten": false, "mate_bitten": index, "ended": true, "minutes": 5}
+	person.health = maxf(1.0, float(person.health) - 6.0)
+	return {"text": "%sが腕をつかまれた。爪が服を裂いたが、歯は届かなかった。二人で振りほどいて距離をとった。" % person.name, "bitten": false, "ended": true, "minutes": 5}
+
+## A bitten housemate runs a fever and dies within about three days, then
+## rises where they are. Keeping them apart (`isolated`) contains that.
+static func bite_housemate(world, index: int) -> void:
+	var person: Dictionary = world.s.household_members[index]
+	person.bitten = true
+	person.bitten_at = int(world.s.minute)
+	Mood.everyone(world, -15.0)
+
+## Hourly course of a bitten housemate; returns lines for the chronicle.
+static func housemates_hourly(world) -> Array:
+	var lines: Array = []
+	var w := ensure(world)
+	for person in world.s.household_members:
+		if not bool(person.get("bitten", false)) or float(person.health) <= 0:
+			continue
+		person.health = maxf(0.0, float(person.health) - 100.0 / 72.0)
+		if float(person.health) <= 0:
+			var place := str(person.get("isolated", "")) if not str(person.get("isolated", "")).is_empty() else str(person.location)
+			person.location = place
+			person.activity = "死亡"
+			w.pending.append({"id": -1000 - int(person.id), "at": int(world.s.minute) + 60 * (1 + world.draw(int(world.s.minute), int(person.id), "mate-rise", 3)), "place": place, "name": str(person.name)})
+			lines.append("%sが、静かに息を引き取った。" % person.name)
+			Mood.everyone(world, -25.0)
+	for line in lines:
+		w.notices.append(line)
+	return lines
+
+static func _bite(world, enc: Dictionary, lead: String) -> Dictionary:
+	var minute := int(world.s.minute)
+	world.s.health = maxf(0.0, float(world.s.health) - 15.0)
+	world.s.injuries = int(world.s.injuries) + 1
+	if int(world.s.exposure) < 0:
+		world.s.exposure = minute
+		world.s.symptoms_due = minute + (6 + world.draw(minute, 1, "bite-fever", 19)) * 60
+	world.s.bitten = true
+	Mood.everyone(world, -15.0)
+	Mood.change(world.s, -10.0)
+	ensure(world).encounter = {}
+	return {"text": lead + "腕に鋭い痛みが走った。噛まれた。必死に振りほどいて、その場を離れた。", "bitten": true, "ended": true, "minutes": 5}
