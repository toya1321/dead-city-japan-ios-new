+extends RefCounted
+## v149.24: state of mind (心). 0-100, higher is better; starts at 70.
+## Shut-in life wears it down (dark covered rooms by day, hunger, exhaustion,
+## the dead at the door, a collapsing society, being alone, shocks), and it is
+## restored by films, warm meals, talk, daylight and fresh air. A low state of
+## mind costs sleep and steady hands. Housemates keep their own `mood`.
+
+const START := 70.0
+const REST_POINT := 60.0
+
+static func ensure(world) -> void:
+	if not world.s.has("mood"):
+		world.s.mood = START
+	for person in world.s.household_members:
+		if not person.has("mood"):
+			person.mood = START
+
+static func of(target: Dictionary) -> float:
+	return float(target.get("mood", START))
+
+static func change(target: Dictionary, delta: float) -> void:
+	target.mood = clampf(of(target) + delta, 0.0, 100.0)
+
+## A shock or a comfort shared by everyone at home (and the player).
+static func everyone(world, delta: float, include_player: bool = true) -> void:
+	ensure(world)
+	if include_player:
+		change(world.s, delta)
+	for person in world.s.household_members:
+		if float(person.health) > 0:
+			change(person, delta)
+
+static func word(value: float) -> String:
+	if value >= 70.0:
+		return "落ち着いている"
+	if value >= 45.0:
+		return "少し気が滅入っている"
+	if value >= 25.0:
+		return "気が滅入っている"
+	return "心が限界に近い"
+
+static func _walkers_at_door(world) -> bool:
+	var places: Dictionary = world.s.get("walkers", {}).get("places", {})
+	return int(places.get("建物前", 0)) > 0 or int(places.get("玄関", 0)) > 0
+
+## One hour of ordinary life for one person.
+static func _hour_delta(world, target: Dictionary, at_home: bool, asleep: bool, alone: bool) -> float:
+	var hour: float = world.hour_of_day()
+	var day := hour >= 6.0 and hour < 18.0
+	var d := 0.0
+	if day and not asleep:
+		if at_home and bool(world.s.get("blackout", false)):
+			d -= 0.4   # covered windows: a dim room all day
+	if float(target.get("hunger", 0.0)) >= 70.0 or float(target.get("thirst", 0.0)) >= 70.0:
+		d -= 0.6
+	if float(target.get("fatigue", 0.0)) >= 85.0:
+		d -= 0.4
+	if alone:
+		d -= 0.1
+	if at_home and _walkers_at_door(world):
+		d -= 0.5
+	# Comforts add up alongside the strains, up to a contented 75.
+	if of(target) < 75.0 and day and not asleep:
+		if not at_home:
+			d += 0.4   # fresh air and daylight
+		elif not bool(world.s.get("blackout", false)):
+			d += 0.3   # daylight through the window
+	# The mind drifts toward where it settles; lower as society falls apart.
+	# The further from it, the stronger the pull (people adapt, slowly).
+	d += 0.02 * (rest_point(world) - of(target))
+	return d
+
+## Where an untroubled mind settles: lower as society falls apart.
+static func rest_point(world) -> float:
+	match str(world.s.get("society", "normal")):
+		"disrupted": return 50.0
+		"emergency": return 40.0
+	return REST_POINT
+
+static func hourly(world, sleeping: bool) -> void:
+	ensure(world)
+	var at_home: bool = bool(world.get_meta("player_at_home", true))
+	var living: Array = world.s.household_members.filter(func(p): return float(p.health) > 0)
+	if float(world.s.health) > 0:
+		change(world.s, _hour_delta(world, world.s, at_home, sleeping, living.is_empty()))
+	for person in living:
+		var home: bool = str(person.get("activity", "")) != "外出"
+		change(person, _hour_delta(world, person, home, str(person.get("activity", "")) == "睡眠", false))
+		# A housemate at the end of their tether says so, twice a day at most.
+		if of(person) < 15.0 and int(world.s.minute) - int(person.get("mood_said_at", -100000)) >= 720:
+			person.mood_said_at = int(world.s.minute)
+			if world.s.has("walkers"):
+				world.s.walkers.notices.append("%sが、暗い顔で黙り込んでいる。「……もう、こんな暮らしは耐えられない」" % person.name)
+
+## Talking lifts both a little, at most once every half hour per person.
+static func talked(world, person: Dictionary) -> void:
+	ensure(world)
+	if int(world.s.minute) - int(person.get("mood_talk_at", -100000)) < 30:
+		return
+	person.mood_talk_at = int(world.s.minute)
+	change(person, 1.5)
+	change(world.s, 1.0)
+
+## Sleep is shallow when the mind is near its limit.
+static func sleep_factor(state: Dictionary) -> float:
+	return 0.6 if of(state) < 25.0 else 1.0
+
+## Shaking hands: a penalty to escape and fighting chances.
+static func nerve_penalty(state: Dictionary) -> int:
+	var value := of(state)
+	if value < 15.0:
+		return 15
+	if value < 30.0:
+		return 8
+	return 0
