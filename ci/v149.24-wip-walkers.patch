+## v149.24 (D): when the player dies and a housemate is alive, the story goes
+## on as that housemate. The household, base and supplies carry over.
+func _succeed_to_housemate(farewell: String = "") -> void:
+	var heir := -1
+	# Prefer someone who was not bitten.
+	for i in world.s.household_members.size():
+		var candidate: Dictionary = world.s.household_members[i]
+		if float(candidate.health) > 0 and (heir < 0 or (bool(world.s.household_members[heir].get("bitten", false)) and not bool(candidate.get("bitten", false)))):
+			heir = i
+	if heir < 0:
+		return
+	succession_running = true
+	var person: Dictionary = world.s.household_members[heir]
+	var previous := str(world.s.profile.name)
+	if farewell.is_empty():
+		_append("【記録】%sは%s、息を引き取った。" % [previous, "噛まれた傷の熱にうなされた末に" if bool(world.s.get("bitten", false)) else "力尽きて"])
+	else:
+		_append(farewell)
+	world.s.profile.name = str(person.name)
+	world.s.profile.cohabitants = maxi(0, int(world.s.profile.cohabitants) - 1)
+	for key in ["companion_names", "companion_genders"]:
+		var values: Array = world.s.profile.get(key, [])
+		if heir < values.size():
+			values.remove_at(heir)
+		world.s.profile[key] = values
+	world.s.health = maxf(1.0, float(person.health))
+	for key in ["hunger", "thirst", "fatigue"]:
+		world.s[key] = float(person.get(key, 0.0))
+	world.s.mood = maxf(0.0, Mood.of(person) - 25.0)
+	world.s.injuries = 0
+	var heir_bitten := bool(person.get("bitten", false))
+	world.s.exposure = int(person.get("bitten_at", 0)) if heir_bitten else -1
+	world.s.symptoms_due = int(world.s.minute) if heir_bitten else -1
+	world.s.symptomatic = heir_bitten
+	world.s.bitten = heir_bitten
+	Walkers.ensure(world).encounter = {}
+	location = str(person.location) if Navigation.indoor(str(person.location)) or District.SITES.has(str(person.location)) or str(person.location) in Navigation.STREETS else location
+	world.s.household_members.remove_at(heir)
+	for i in world.s.household_members.size():
+		world.s.household_members[i].id = i
+	dialogue = HouseholdDialogue.new()
+	_sync_player_position()
+	_append("ここからは%sとして生きていく。%sが残した家と物資は、そのまま引き継がれる。" % [person.name, previous])
+	succession_running = false
+	_refresh()
