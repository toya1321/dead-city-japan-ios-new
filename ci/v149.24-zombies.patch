+	world.s.inventory.wood = int(world.s.inventory.wood) - 1
+	world.s.inventory.parts = int(world.s.inventory.parts) - 1
+	world.advance_safe(60)
+	world.s.door_hp = 100.0
+	world.s.door_broken = false
+	make_noise(world, "玄関", 60)
