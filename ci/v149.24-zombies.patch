+## Mending the door: wood and parts, an hour, and loud hammering.
+static func repair_door(world) -> String:
+	if door_hp(world) >= 100.0 and not bool(world.s.get("door_broken", false)):
+		return "玄関の扉は傷んでいない。"
+	if int(world.s.inventory.wood) < 1 or int(world.s.inventory.parts) < 1:
