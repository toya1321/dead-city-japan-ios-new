diff --git a/qa/play.gd b/qa/play.gd
new file mode 100644
index 0000000..b4400ac
--- /dev/null
+++ b/qa/play.gd
@@ -0,0 +1,47 @@
+extends SceneTree
+## Playtest driver: DCJ_NEW=1 starts fresh; DCJ_CMDS=file with one command per line.
+const Main = preload("res://main.tscn")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	if OS.get_environment("DCJ_NEW") == "1":
+		var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+		if OS.get_environment("DCJ_SOLO") != "1":
+			profile.cohabitants = 1
+			profile.companion_names = ["詩音"]
+			profile.companion_genders = ["女性"] if "女性" in g.HouseholdDialogue.GENDERS else []
+		g._start_new_game(profile)
+		g._finish_intro()
+	else:
+		g._continue_from_title()
+		for i in 3: await process_frame
+		print(g.log_entries[-1])
+	g.local_model.enabled = false
+	var lines := FileAccess.get_file_as_string(OS.get_environment("DCJ_CMDS")).split("\n")
+	for line in lines:
+		var cmd := line.strip_edges()
+		if cmd.is_empty(): continue
+		if cmd.begins_with("#food"):
+			g.world.s.food = float(cmd.split(" ")[1]); print("   (cheat) food=", g.world.s.food); continue
+		var tail: String = g.log_entries[-1] if not g.log_entries.is_empty() else ""
+		var tail_count: int = g.log_entries.count(tail)
+		await g._on_command(cmd)
+		while g.advancing:
+			await process_frame
+		var start := 0
+		var seen := 0
+		for i in g.log_entries.size():
+			if g.log_entries[i] == tail:
+				seen += 1
+				start = i + 1
+		for i in range(start, g.log_entries.size()):
+			print(g.log_entries[i].replace("\n", " / "))
+		var s = g.world.s
+		print("   [%s %s %s | 体%.0f 満%.0f 水%.0f 休%.0f 心%.0f | 食%.1f 水%.1f | 感染者:%s 群れ:%s 扉%.0f 補強%d | 街:%s]" % [g.day_label.text, g.clock_label.text, g.location, s.health, 100-s.hunger, 100-s.thirst, 100-s.fatigue, float(s.get("mood",70)), s.food, s.water, s.walkers.places, s.walkers.get("horde",{}).get("place","-"), float(s.get("door_hp",100)), int(s.barricade), s.society])
+		print("   chips: ", g._suggestions())
+	print(g._save())
+	quit()
