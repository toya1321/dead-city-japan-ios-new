new file mode 100644
index 0000000..0fabadc
--- /dev/null
+++ b/tests/test_life149_24.gd
@@ -0,0 +1,193 @@
+extends SceneTree
+## v149.24: the outbreak in the news, ways out of a tight spot (distraction,
+## waiting for the street to clear, bath water), a horde lived through hour by
+## hour, and comforts for someone alone (film, cigarettes, cooking).
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const OutbreakNews = preload("res://scripts/outbreak_news.gd")
+const Mood = preload("res://scripts/mood.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func fresh(cohabitants: int = 0):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = cohabitants
+	if cohabitants > 0:
+		profile.companion_names = ["詩音"]
+	g._start_new_game(profile)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	# --- The outbreak in the news, one stage at a time.
+	var g = await fresh()
+	var w = g.world
+	OutbreakNews.hourly(w)
+	check(OutbreakNews.ensure(w).done.is_empty(), "nothing to report on an ordinary morning")
+	w.s.agents[0].kind = "symptomatic"
+	w.s.walkers.notices = []
+	OutbreakNews.hourly(w)
+	check(str(w.s.walkers.notices).contains("原因不明の高熱") and str(w.s.walkers.notices).contains("スマホに届いた通知"), "the first fevers reach the phone")
+	w.s.walkers.risen = [7]
+	w.s.walkers.notices = []
+	OutbreakNews.hourly(w)
+	check(str(w.s.walkers.notices).contains("かみつく事件") and str(w.s.walkers.notices).contains("笹塚"), "the first attack is reported, in the player's own town")
+	w.s.walkers.risen = [7, 8, 9]
+	w.s.walkers.notices = []
+	OutbreakNews.hourly(w)
+	check(str(w.s.walkers.notices).contains("【防災無線】") and str(w.s.walkers.notices).contains("110番"), "the town radio warns about them")
+	w.s.society = "disrupted"
+	OutbreakNews.hourly(w)
+	w.s.walkers.notices = []
+	OutbreakNews.hourly(w)
+	check(str(w.s.walkers.notices).contains("浴槽などに水をためて"), "the radio tells people to fill their baths")
+	g.location = "居間"
+	await g._on_command("ニュースを見る")
+	check(str(g.log_entries.slice(-3)).contains("救急病院") or str(g.log_entries.slice(-3)).contains("買いだめ"), "the television leads with the outbreak: " + g.log_entries[-1].left(80))
+	# --- Bath water.
+	g._refresh()
+	check("浴槽に水をためる" in g._suggestions(), "filling the bath is suggested once the radio asks")
+	await g._on_command("浴槽に水をためる")
+	check(float(w.s.bath_water) >= 150.0, "the bath is filled")
+	w.s.water = 1.0
+	w.s.water_online = false
+	g._refresh()
+	check("浴槽の水を汲む" in g._suggestions(), "drawing from it is suggested when water runs low")
+	await g._on_command("浴槽の水を汲む")
+	check(float(w.s.water) >= 10.0 and g.log_entries[-1].contains("煮沸"), "bath water is boiled into drinking water")
+	# --- Waiting until the street is clear.
+	w.s.walkers.places = {"屋外": 1}
+	w.s.walkers.risen = [7]
+	g._refresh()
+	check("通りが空くまで待つ" in g._suggestions(), "waiting for the street to clear is suggested")
+	await g._on_command("通りが空くまで待つ")
+	check(g.log_entries[-1].contains("時間"), "it waits hour by hour: " + g.log_entries[-1].left(60))
+	w.s.walkers.places = {}
+	await g._on_command("窓から外を見る")
+	check(g.log_entries[-1].contains("今なら、外に出られそうだ"), "the window says when the way is clear")
+	# --- Distraction: in the street and from a window.
+	w.s.walkers.places = {"商店通り": 3}
+	w.s.walkers.encounter = {"place": "商店通り", "count": 3, "near": false, "since": w.s.minute, "from": "屋外"}
+	g.location = "商店通り"
+	var drew := false
+	for i in 12:
+		w.s.walkers.places = {"商店通り": 3}
+		w.s.walkers.encounter = {"place": "商店通り", "count": 3, "near": false, "since": w.s.minute, "from": "屋外"}
+		w.s.minute += 11
+		var r := Walkers.resolve(w, "distract")
+		if bool(r.ended):
+			drew = Walkers.count(w, "商店通り") == 0 and str(r.text).contains("投げ")
+			break
+	check(drew, "a thrown stone draws them away")
+	check(Walkers.intent("石を投げて気をそらす") == "distract", "free text asks for a distraction")
+	g.location = "居間"
+	w.s.walkers.encounter = {}
+	var cleared := false
+	for i in 10:
+		w.s.walkers.places = {"建物前": 2}
+		w.s.minute += 13
+		await g._on_command("窓から物を投げて気をそらす")
+		if Walkers.count(w, "建物前") == 0:
+			cleared = true
+			break
+	check(cleared and g.log_entries[-1].contains("向かっていく"), "something thrown from a window draws them from the door")
+	# --- A horde is lived through hour by hour.
+	w.s.walkers.places = {}
+	w.s.walkers.horde = {"place": "屋外", "step": 4, "size": 20}
+	w.s.walkers.alarm = false
+	w.s.walkers.notices = []
+	Walkers.horde_hourly(w)
+	check(bool(w.s.walkers.alarm) and str(w.s.walkers.notices).contains("【危険】"), "every hour it passes stops the wait and says so")
+	g._refresh()
+	check("息をひそめる" in g._suggestions(), "holding one's breath is suggested")
+	var t0: int = w.s.minute
+	await g._on_command("息をひそめる")
+	check(int(w.s.minute) - t0 == 60 and bool(w.s.lights_off) and str(g.log_entries.slice(-3)).contains("息をひそめた"), "holding one's breath passes an hour in the dark")
+	w.s.walkers.erase("horde")
+	# --- Alone: a film, a warm meal, a cigarette.
+	w.s.walkers.places = {}
+	w.s.lights_off = false
+	w.s.water_online = true
+	w.s.grid_online = true
+	w.s.society = "alert"
+	w.s.mood = 40.0
+	g._refresh()
+	var chips: Array = g._suggestions()
+	check("温かい料理を作る" in chips and "映画を観る" in chips, "low spirits suggest comforts: " + str(chips))
+	w.s.food = 3.0
+	w.s.hunger = 50.0
+	await g._on_command("温かい料理を作る")
+	check(g.location == "台所" and absf(float(w.s.food) - 2.75) < 0.01 and float(w.s.mood) > 45.0 and "smell" in Walkers.home_reasons(w), "cooking alone: food, a lift, and a smell")
+	w.s.walkers.erase("smell_until")
+	var m0: float = w.s.mood
+	await g._on_command("音を小さくして映画を観る")
+	check(g.location == "居間" and float(w.s.mood) > m0 + 6.0 and not ("sound" in Walkers.home_reasons(w)) and g.log_entries[-1].contains("一人で"), "a film alone, turned down, is not heard outside")
+	await g._on_command("映画を観る")
+	check("sound" in Walkers.home_reasons(w), "at normal volume it is")
+	await g._on_command("タバコを吸う")
+	check(g.log_entries[-1].contains("タバコがない"), "no cigarettes without getting some")
+	w.s.minute = 2 * 60
+	g.location = "コンビニ"
+	g._refresh()
+	check("タバコを買う" in g._suggestions(), "the konbini offers cigarettes")
+	await g._on_command("タバコを2箱買う")
+	check(int(w.s.cigarettes) == 40, "two packs bought")
+	g.location = "居間"
+	var m1: float = w.s.mood
+	await g._on_command("タバコを吸う")
+	check(int(w.s.cigarettes) == 39 and float(w.s.mood) > m1 + 5.0 and "smell" in Walkers.home_reasons(w), "a cigarette lifts the mood; the smoke goes out the vent")
+	var m2: float = w.s.mood
+	await g._on_command("一服する")
+	check(float(w.s.mood) - m2 < 3.0, "another straight away does little")
+	w.s.smoke_habit = 6
+	w.s.last_smoke = int(w.s.minute) - 13 * 60
+	check(Mood.craving(w) < 0.0, "a habit left unfed brings craving")
+	# Power cut: gas until the collapse, then the cassette stove; a film on the phone; a book by day.
+	w.s.grid_online = false
+	w.s.equipment.battery = false
+	w.s.society = "emergency"
+	w.s.gas_cans = 1.0
+	w.s.hunger = 40.0
+	w.s.walkers.erase("smell_until")
+	await g._on_command("温かい料理を作る")
+	check(str(g.log_entries.slice(-2)).contains("カセットコンロ") and absf(float(w.s.gas_cans) - 0.75) < 0.01, "after the collapse the cassette stove cooks, using gas")
+	w.s.gas_cans = 0.0
+	await g._on_command("温かい料理を作る")
+	check(g.log_entries[-1].contains("ボンベもない"), "and without cans there is no hot meal")
+	g.location = "居間"
+	OutbreakNews.ensure(w).done = ["fever", "first_attack", "pattern", "alert", "disrupted", "emergency", "silence"]
+	w.s.mood = 50.0
+	w.s.walkers.erase("sound_until")
+	w.s.sim.phone_charge = 80.0
+	var m3: float = w.s.mood
+	await g._on_command("映画を観る")
+	check(g.log_entries[-1].contains("スマホ") and float(w.s.sim.phone_charge) < 70.0 and float(w.s.mood) > m3 + 5.0 and not ("sound" in Walkers.home_reasons(w)), "a film on the phone, quietly, for battery")
+	w.s.blackout = false
+	w.s.minute = 4 * 60 + 20 * 1440   # noon
+	w.s.mood = 50.0
+	var m4: float = w.s.mood
+	await g._on_command("本を読む")
+	check(float(w.s.mood) > m4 + 3.0, "a book by daylight lifts the mood")
+	w.s.minute = 13 * 60 + 20 * 1440   # 21:00
+	w.s.grid_online = false
+	await g._on_command("本を読む")
+	check(g.log_entries[-1].contains("暗くて"), "but not in the dark without power")
+	w.s.district.sites["コンビニ"].vacant = true
+	g.location = "コンビニ"
+	await g._on_command("タバコを探す")
+	check(int(w.s.cigarettes) > 39 and g.log_entries[-1].contains("見つけた"), "an abandoned konbini still has some")
+	print("v149.24 life checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
