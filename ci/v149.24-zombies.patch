+## What the door looks like from the inside.
+static func door_text(world) -> String:
+	if bool(world.s.get("door_broken", false)):
+		return "壊れている（鍵がかからない）"
+	var hp := door_hp(world)
+	if hp >= 100.0:
+		return "無傷"
+	if hp > 75.0:
+		return "少し傷んでいる"
+	if hp > 50.0:
+		return "きしんでいる"
+	if hp > 20.0:
+		return "蝶番がゆるんでいる"
