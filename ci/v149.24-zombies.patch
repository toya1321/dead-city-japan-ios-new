diff --git a/scripts/outbreak_news.gd b/scripts/outbreak_news.gd
new file mode 100644
index 0000000..560f398
--- /dev/null
+++ b/scripts/outbreak_news.gd
@@ -0,0 +1,99 @@
+extends RefCounted
+## v149.24: the outbreak as the news tells it. Each stage is reported once,
+## when the world reaches it: phone alerts (ニュース速報), television items and
+## the town's emergency radio (防災無線). Television and phone headlines are
+## kept so that "ニュースを見る" shows them; radio and alerts reach the chronicle
+## by themselves. State: `s.outbreak_news = {"done": [...], "items": [...]}`.
+
+const Mood = preload("res://scripts/mood.gd")
+
+static func ensure(world) -> Dictionary:
+	if not world.s.has("outbreak_news") or not world.s.outbreak_news is Dictionary:
+		world.s.outbreak_news = {"done": [], "items": []}
+	return world.s.outbreak_news
+
+static func _town(world) -> String:
+	var address := str(world.s.profile.get("address", ""))
+	var ward := address.find("区")
+	return address.substr(ward + 1) if ward >= 0 and ward + 1 < address.length() else "近く"
+
+static func _ward(world) -> String:
+	var address := str(world.s.profile.get("address", ""))
+	var start := address.find("都")
+	var ward := address.find("区")
+	if start >= 0 and ward > start:
+		return address.substr(start + 1, ward - start - 1)
+	return "市"
+
+static func _symptomatic(world) -> bool:
+	for a in world.s.agents:
+		if str(a.get("kind", "")) == "symptomatic" or bool(a.get("dead", false)):
+			return true
+	return false
+
+## Stages in order: id, condition, lines [kind, text]. kind: alert (phone),
+## tv (headline only), radio (防災無線).
+static func stages(world) -> Array:
+	var walkers: Dictionary = world.s.get("walkers", {})
+	var risen: int = walkers.get("risen", []).size()
+	var society := str(world.s.get("society", "normal"))
+	var town := _town(world)
+	var ward := _ward(world)
+	return [
+		["fever", _symptomatic(world), [
+			["alert", "【ニュース速報】都内の病院に、原因不明の高熱を訴える患者が相次いで搬送。保健所が調べている。"]]],
+		["first_attack", risen >= 1, [
+			["alert", "【ニュース速報】%sの路上で、男性が通行人にかみつく事件。かまれた人がけが。男は警察官の制止を振り切り、ふらつきながら立ち去った。" % town],
+			["tv", "かみつき事件の男、数日前に高熱で受診していたことが判明。警察は行方を捜している。"]]],
+		["pattern", risen >= 3 or society in ["alert", "disrupted", "emergency"], [
+			["tv", "同じようなかみつき事件が都内で相次ぐ。かまれた人が数日後に死亡し、その後動き出したとの情報がSNSで広がるが、政府は「根拠のない情報」と否定。"],
+			["radio", "【防災無線】こちらは、防災%sです。現在、区内で人にかみつく事件が相次いでいます。様子のおかしい人には近づかず、すぐに110番通報してください。" % ward]]],
+		["alert", society in ["alert", "disrupted", "emergency"], [
+			["alert", "【ニュース速報】政府が緊急会見。原因不明の感染症について、不要不急の外出の自粛を要請。"],
+			["tv", "スーパーやコンビニで買いだめの動き。一部の店では販売数を制限。"]]],
+		["disrupted", society in ["disrupted", "emergency"], [
+			["alert", "【ニュース速報】都内の救急病院が、相次いで受け入れを停止。"],
+			["radio", "【防災無線】こちらは、防災%sです。区立小学校を避難所として開設しました。今後、断水のおそれがあります。浴槽などに水をためておいてください。" % ward]]],
+		["emergency", society == "emergency", [
+			["alert", "【ニュース速報】政府、緊急事態を宣言。自衛隊に災害派遣を要請。"],
+			["radio", "【防災無線】こちらは、防災%sです。外出は、しないでください。戸締まりをし、夜は明かりを外にもらさないでください。音を立てないでください。" % ward]]],
+		["silence", society == "emergency" and int(world.s.minute) >= 30 * 1440, [
+			["tv", "（どのチャンネルも、同じ静止画と「しばらくお待ちください」の文字を映している。）"]]],
+	]
+
+## Hourly: report each newly reached stage once.
+static func hourly(world) -> void:
+	var state := ensure(world)
+	var notices: Array = world.s.walkers.notices if world.s.has("walkers") else []
+	for stage in stages(world):
+		var id := str(stage[0])
+		if id in state.done or not bool(stage[1]):
+			continue
+		state.done.append(id)
+		for line in stage[2]:
+			var kind := str(line[0])
+			var text := str(line[1])
+			if kind in ["alert", "tv"]:
+				state.items.append({"minute": int(world.s.minute), "text": text.trim_prefix("【ニュース速報】")})
+				if state.items.size() > 12:
+					state.items.pop_front()
+			if kind == "alert" and _phone_works(world):
+				notices.append(text + "（スマホに届いた通知）")
+			elif kind == "radio" and int(world.s.minute) < 60 * 1440:
+				notices.append(text)
+		Mood.everyone(world, -2.0)
+		if id == "emergency" and world.s.has("walkers"):
+			world.s.walkers.alarm = true
+		break   # one stage per hour, so they arrive as separate moments
+
+static func _phone_works(world) -> bool:
+	var sim: Dictionary = world.s.get("sim", {})
+	return float(sim.get("communications", 100.0)) >= 30.0 and float(sim.get("phone_charge", 100.0)) > 0.0
+
+## The newest headlines for the news screen.
+static func headlines(world, count: int = 3) -> Array:
+	var items: Array = ensure(world).items
+	var out: Array = []
+	for i in range(items.size() - 1, maxi(-1, items.size() - 1 - count), -1):
+		out.append(str(items[i].text))
+	return out
