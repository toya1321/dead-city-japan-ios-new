diff --git a/scripts/home_life.gd b/scripts/home_life.gd
new file mode 100644
index 0000000..ddb9f82
--- /dev/null
+++ b/scripts/home_life.gd
@@ -0,0 +1,370 @@
+extends RefCounted
+## v149.24: things a person does at home to get through it, alone or not.
+## - a film alone (power; normal volume is heard at the door, turned down is not)
+## - a cigarette (bought at the konbini while it is open, found in empty
+##   buildings later; a habit brings craving; smoke goes out through the vent)
+## - cooking a warm meal (power; smell; lifts everyone who eats)
+## - filling the bath before the water stops, and drawing from it later
+## - waiting until the street is clear; holding one's breath while a horde passes
+## - throwing something from a window to draw the dead away from the door
+## Each returns true when it handled the command (and wrote to the chronicle).
+
+const Navigation = preload("res://scripts/navigation.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+const Smalltalk = preload("res://scripts/household_smalltalk.gd")
+
+const TOBACCO_START := {"コンビニ": 40, "デパート": 10, "近所の空き家": 1}
+const BOX := 20
+const BATH_LITRES := 180.0
+
+static func _has(cmd: String, words: Array) -> bool:
+	for word in words:
+		if cmd.contains(word):
+			return true
+	return false
+
+static func _names_anyone(game, cmd: String) -> bool:
+	for person in game.world.s.household_members:
+		if cmd.contains(str(person.name)):
+			return true
+	return false
+
+static func handle(game, cmd: String) -> bool:
+	if _names_anyone(game, cmd):
+		return false
+	if _has(cmd, ["タバコ", "煙草", "たばこ"]) and _has(cmd, ["買"]):
+		return _buy_tobacco(game, cmd)
+	if _has(cmd, ["タバコ", "煙草", "たばこ"]) and _has(cmd, ["探", "集め", "あさ", "漁"]):
+		return _find_tobacco(game)
+	if _has(cmd, ["タバコを吸", "煙草を吸", "たばこを吸", "一服"]):
+		return _smoke(game)
+	if _has(cmd, ["浴槽", "風呂", "湯船", "バスタブ"]) and _has(cmd, ["ため", "溜め", "張"]):
+		return _fill_bath(game)
+	if _has(cmd, ["浴槽", "風呂", "湯船", "バスタブ"]) and _has(cmd, ["汲", "くむ", "使う", "飲"]):
+		return _draw_bath(game)
+	if _has(cmd, ["通りが空く", "人影が消える", "いなくなるまで", "いなくなったら", "空くまで", "去るまで"]) and _has(cmd, ["待"]):
+		return _wait_clear(game)
+	if _has(cmd, ["息をひそめ", "息を潜め", "息を殺", "じっとして", "身を潜め"]) and Navigation.indoor(game.location):
+		return _hold_breath(game)
+	if Navigation.indoor(game.location) and _has(cmd, ["投げ", "気をそら", "注意をそら", "おとり", "囮", "引きつけ"]):
+		return _distract_from_home(game)
+	if _has(cmd, ["ボンベ"]) and _has(cmd, ["買"]):
+		return _buy_gas(game, cmd)
+	if _has(cmd, ["本を読", "読書", "小説を読", "漫画を読", "マンガを読"]):
+		return _read(game)
+	if _has(cmd, ["料理", "自炊", "ご飯を作", "ごはんを作", "温かい食事", "温かいご飯", "食事を作"]) and game.dialogue.partner < 0:
+		return _cook(game, cmd)
+	if _has(cmd, ["映画"]) and _has(cmd, ["観", "見"]) and game.dialogue.partner < 0 and (cmd.contains("一人") or cmd.contains("ひとり") or _nobody_awake_home(game)):
+		return _movie_alone(game, cmd)
+	return false
+
+static func _nobody_awake_home(game) -> bool:
+	for person in game.world.s.household_members:
+		if float(person.health) > 0 and Navigation.indoor(str(person.location)) and str(person.get("activity", "")) == "在宅":
+			return false
+	return true
+
+static func _done(game, text: String) -> bool:
+	game._append(text)
+	game._refresh()
+	return true
+
+# --- Tobacco --------------------------------------------------------------
+
+static func tobacco_stock(world) -> Dictionary:
+	if not world.s.has("tobacco_stock") or not world.s.tobacco_stock is Dictionary:
+		world.s.tobacco_stock = TOBACCO_START.duplicate()
+	return world.s.tobacco_stock
+
+static func _buy_tobacco(game, cmd: String) -> bool:
+	var world = game.world
+	if game.location != "コンビニ":
+		return _done(game, "タバコはコンビニで買える。何も実行していません。")
+	var site: Dictionary = world.s.district.sites["コンビニ"]
+	if bool(site.vacant):
+		return _done(game, "店員はもういない。棚に残っているなら「タバコを探す」。")
+	if not game.District.can_enter(world, "コンビニ"):
+		return _done(game, "営業時間外。")
+	var boxes := 1
+	var number := RegEx.new()
+	number.compile("([0-9]{1,2})\\s*(箱|個|つ)")
+	var found := number.search(cmd)
+	if found != null:
+		boxes = clampi(int(found.get_string(1)), 1, 10)
+	var stock := tobacco_stock(world)
+	if int(stock.get("コンビニ", 0)) < boxes:
+		return _done(game, "タバコの在庫が足りない（残り%d箱）。" % int(stock.get("コンビニ", 0)))
+	var price := 600 * boxes
+	if int(world.s.cash) < price:
+		return _done(game, "現金が足りない（%d円必要）。" % price)
+	world.s.cash = int(world.s.cash) - price
+	stock["コンビニ"] = int(stock["コンビニ"]) - boxes
+	world.s.cigarettes = int(world.s.get("cigarettes", 0)) + boxes * BOX
+	world.advance_safe(3)
+	return _done(game, "タバコを%d箱買った（%d円）。手持ちは%d本。" % [boxes, price, int(world.s.cigarettes)])
+
+static func _find_tobacco(game) -> bool:
+	var world = game.world
+	var place: String = game.location
+	var stock := tobacco_stock(world)
+	if not stock.has(place):
+		return _done(game, "ここにタバコがありそうな場所はない。何も実行していません。")
+	if not world.s.district.sites.has(place) or not bool(world.s.district.sites[place].vacant):
+		return _done(game, "まだ営業している。買うなら「タバコを買う」。")
+	world.advance_safe(10)
+	var take := mini(3, int(stock[place]))
+	if take <= 0:
+		return _done(game, "棚も引き出しも探したが、タバコはもう一箱も残っていなかった（10分）。")
+	stock[place] = int(stock[place]) - take
+	world.s.cigarettes = int(world.s.get("cigarettes", 0)) + take * BOX
+	return _done(game, "荒らされた棚の奥から、タバコを%d箱見つけた（10分）。手持ちは%d本。" % [take, int(world.s.cigarettes)])
+
+static func _smoke(game) -> bool:
+	var world = game.world
+	if int(world.s.get("cigarettes", 0)) <= 0:
+		return _done(game, "タバコがない。コンビニで買うか、空いた建物で探すしかない。")
+	var minute := int(world.s.minute)
+	var recent := minute - int(world.s.get("last_smoke", -100000)) < 60
+	world.s.cigarettes = int(world.s.cigarettes) - 1
+	world.s.last_smoke = minute
+	world.s.smoke_habit = mini(10, int(world.s.get("smoke_habit", 0)) + 1)
+	world.advance_safe(7)
+	Mood.ensure(world)
+	Mood.change(world.s, 2.0 if recent else 6.0)
+	var where := ""
+	if Navigation.indoor(game.location):
+		# The vent carries the smoke out to the door.
+		Walkers.make_smell(world, 30)
+		where = "換気扇の下で"
+	return _done(game, "%sタバコに火をつけ、ゆっくり煙を吐いた（7分）。%s残り%d本。" % [where, "続けて吸っても、もうあまり落ち着かない。" if recent else "少しだけ、気持ちが落ち着いた。", int(world.s.cigarettes)])
+
+
+# --- Cooking ---------------------------------------------------------------
+
+static func _cook(game, cmd: String) -> bool:
+	var world = game.world
+	if not Navigation.indoor(game.location):
+		return _done(game, "料理は家の台所でする。何も実行していません。")
+	var heat := heat_source(world)
+	if heat.is_empty():
+		return _done(game, "ガスも電気も止まり、カセットボンベもない。温かい料理は作れない。ボンベはコンビニや金物店で買える。")
+	var eaters: Array = []
+	if _has(cmd, ["みんな", "全員", "二人分", "2人分", "家族", "皆"]):
+		for person in world.s.household_members:
+			if float(person.health) > 0 and Navigation.indoor(str(person.location)) and str(person.get("activity", "")) != "睡眠":
+				eaters.append(person)
+	var portions := 1 + eaters.size()
+	if float(world.s.food) < 0.25 * portions:
+		return _done(game, "食料が足りない（%d人分で%.2f人日必要）。" % [portions, 0.25 * portions])
+	if game.location != "台所":
+		game._append(game._move_to("台所"))
+		if game.location != "台所":
+			game._refresh()
+			return true
+	world.advance_safe(30)
+	if heat == "cassette":
+		world.s.gas_cans = maxf(0.0, float(world.s.get("gas_cans", 0.0)) - 0.25)
+	world.s.food = float(world.s.food) - 0.25 * portions
+	world.s.hunger = maxf(0.0, float(world.s.hunger) - 30.0)
+	Mood.ensure(world)
+	Mood.change(world.s, 6.0)
+	for person in eaters:
+		person.hunger = maxf(0.0, float(person.hunger) - 30.0)
+		Mood.change(person, 6.0)
+	Walkers.make_smell(world, 80)
+	var names := "、".join(eaters.map(func(p): return str(p.name)))
+	var how: String = {"gas": "ガスコンロで", "power": "電気のコンロで", "cassette": "カセットコンロで"}[heat]
+	var left := ("ボンベは残り%.2f本分。" % float(world.s.gas_cans)) if heat == "cassette" else ""
+	return _done(game, "台所で、%s温かい食事を作って食べた（30分、食料%.2f人日）。%s湯気の立つ食事に、少しほっとした。換気扇から、においが外に流れていく。%s" % [how, 0.25 * portions, ("%sと一緒に食べた。" % names) if not names.is_empty() else "", left])
+
+## City gas runs until the collapse; then the cassette stove (most homes keep
+## one with a few cans for hot-pot evenings) until the cans run out.
+static func heat_source(world) -> String:
+	if str(world.s.get("society", "normal")) != "emergency":
+		return "gas"
+	if world.has_home_power():
+		return "power"
+	if float(world.s.get("gas_cans", 3.0)) >= 0.25:
+		if not world.s.has("gas_cans"):
+			world.s.gas_cans = 3.0
+		return "cassette"
+	return ""
+
+static func _buy_gas(game, cmd: String) -> bool:
+	var world = game.world
+	if not game.location in ["コンビニ", "金物店"]:
+		return _done(game, "カセットボンベはコンビニか金物店で買える。何も実行していません。")
+	if game.location == "コンビニ" and (bool(world.s.district.sites["コンビニ"].vacant) or not game.District.can_enter(world, "コンビニ")):
+		return _done(game, "今は買えない。")
+	var cans := 3
+	var number := RegEx.new()
+	number.compile("([0-9]{1,2})\\s*(本|個|つ)")
+	var found := number.search(cmd)
+	if found != null:
+		cans = clampi(int(found.get_string(1)), 1, 12)
+	var price := 150 * cans
+	if int(world.s.cash) < price:
+		return _done(game, "現金が足りない（%d円必要）。" % price)
+	world.s.cash = int(world.s.cash) - price
+	world.s.gas_cans = float(world.s.get("gas_cans", 3.0)) + cans
+	world.advance_safe(3)
+	return _done(game, "カセットボンベを%d本買った（%d円）。家には%.2f本分ある。" % [cans, price, float(world.s.gas_cans)])
+
+# --- Reading ------------------------------------------------------------------
+
+static func _read(game) -> bool:
+	var world = game.world
+	if not Navigation.indoor(game.location):
+		return _done(game, "本は家で読める。何も実行していません。")
+	var hour: float = world.hour_of_day()
+	var day := hour >= 6.0 and hour < 18.0
+	var dim := bool(world.s.get("blackout", false)) or not day
+	if dim and not world.has_home_power():
+		return _done(game, "暗くて文字が読めない。昼間に、目張りのない窓のそばでなら読める。")
+	var minute := int(world.s.minute)
+	var recent := minute - int(world.s.get("last_read", -100000)) < 180
+	world.s.last_read = minute
+	world.advance_safe(60)
+	Mood.ensure(world)
+	Mood.change(world.s, 1.0 if recent else 4.0)
+	return _done(game, "棚から本を一冊取って読んだ（1時間）。%s" % ("さっきから読み続けて、少し目が疲れた。" if recent else "物語の中にいる間は、外のことを考えずにすんだ。"))
+
+# --- Film alone ------------------------------------------------------------
+
+static func _movie_alone(game, cmd: String) -> bool:
+	var world = game.world
+	if not Navigation.indoor(game.location):
+		return _done(game, "映画は家の居間で観られる。何も実行していません。")
+	var phone: bool = not world.has_home_power()
+	if phone:
+		var charge := float(world.s.sim.get("phone_charge", 0.0))
+		if charge < 20.0:
+			return _done(game, "電気が来ていない。スマホの電池も残り少なく、映画を観る余裕はない。")
+		return _phone_film(game, cmd)
+	if game.location != "居間":
+		game._append(game._move_to("居間"))
+		if game.location != "居間":
+			game._refresh()
+			return true
+	var film: Dictionary = Smalltalk._movie(world.draw(int(world.s.minute), 77, "solo-film", Smalltalk.FILM_RECOMMENDATIONS.size()))
+	var quiet: bool = game.NPCMemory._mentions(cmd, game.QUIET_WORDS)
+	if not quiet:
+		Walkers.make_sound(world, int(film.minutes))
+	var w := Walkers.ensure(world)
+	w.alarm = false
+	var elapsed := 0
+	while elapsed < int(film.minutes):
+		var step := mini(10, int(film.minutes) - elapsed)
+		if world.advance_safe(step) < step:
+			break
+		elapsed += step
+		if bool(w.alarm) or not world.has_home_power():
+			break
+	var full := 8.0 if quiet else 12.0
+	Mood.ensure(world)
+	Mood.change(world.s, full * float(elapsed) / float(film.minutes))
+	if elapsed < int(film.minutes):
+		w.alarm = false
+		return _done(game, "一人で『%s』を観ていたが、%d分で止めた。%s" % [film.title, elapsed, "外の気配が気になった。" if world.has_home_power() else "電気が途切れた。"])
+	return _done(game, "一人で『%s』を観た（%d分）。%s少しの間、外のことを忘れられた。" % [film.title, elapsed, "音を小さくしていたので物足りなかったが、" if quiet else ""])
+
+## Without power: a film saved on the phone, on a small screen, for battery.
+static func _phone_film(game, cmd: String) -> bool:
+	var world = game.world
+	var film: Dictionary = Smalltalk._movie(world.draw(int(world.s.minute), 78, "phone-film", Smalltalk.FILM_RECOMMENDATIONS.size()))
+	var w := Walkers.ensure(world)
+	w.alarm = false
+	var elapsed := 0
+	while elapsed < int(film.minutes):
+		var step := mini(10, int(film.minutes) - elapsed)
+		if world.advance_safe(step) < step:
+			break
+		elapsed += step
+		if bool(w.alarm):
+			break
+	world.s.sim.phone_charge = maxf(0.0, float(world.s.sim.phone_charge) - 15.0 * float(elapsed) / float(film.minutes))
+	Mood.ensure(world)
+	Mood.change(world.s, 8.0 * float(elapsed) / float(film.minutes))
+	w.alarm = false
+	return _done(game, "電気が来ないので、スマホに保存してあった『%s』をイヤホンで観た（%d分）。小さな画面でも、少し気が紛れた。電池は残り%.0f%%。" % [film.title, elapsed, float(world.s.sim.phone_charge)])
+
+# --- Bath water --------------------------------------------------------------
+
+static func _fill_bath(game) -> bool:
+	var world = game.world
+	if not Navigation.indoor(game.location):
+		return _done(game, "家の中でできる。何も実行していません。")
+	if not bool(world.s.water_online):
+		return _done(game, "もう水道から水が出ない。")
+	if float(world.s.get("bath_water", 0.0)) >= BATH_LITRES - 1.0:
+		return _done(game, "浴槽はもう水でいっぱいだ。")
+	world.advance_safe(20)
+	world.s.bath_water = BATH_LITRES
+	return _done(game, "浴槽に水をためた（20分、約%dリットル）。断水しても、煮沸すれば飲み水に使える。" % int(BATH_LITRES))
+
+static func _draw_bath(game) -> bool:
+	var world = game.world
+	if not Navigation.indoor(game.location):
+		return _done(game, "家の中でできる。何も実行していません。")
+	var bath := float(world.s.get("bath_water", 0.0))
+	if bath <= 0.0:
+		return _done(game, "浴槽に水はない。")
+	if not world.has_home_power() and not bool(world.s.equipment.get("filter", false)):
+		return _done(game, "浴槽の水はそのままでは飲めない。煮沸するための電気も、浄水器もない。")
+	var amount := minf(10.0, bath)
+	world.advance_safe(20)
+	world.s.bath_water = bath - amount
+	world.s.water = float(world.s.water) + amount
+	return _done(game, "浴槽から水を汲んで%sし、飲み水にした（20分、%.0fリットル）。浴槽の残りは約%.0fリットル。" % ["煮沸" if world.has_home_power() else "浄水器でろ過", amount, float(world.s.bath_water)])
+
+# --- Waiting it out ------------------------------------------------------------
+
+static func _wait_clear(game) -> bool:
+	var world = game.world
+	if not Navigation.indoor(game.location):
+		return _done(game, "家の中で待つ。何も実行していません。")
+	var w := Walkers.ensure(world)
+	if Walkers.count(world, "屋外") <= 0 and Walkers.count(world, "建物前") <= 0:
+		return _done(game, "窓から見る限り、家の前の通りに人影はない。今なら出られそうだ。")
+	w.alarm = false
+	var hours := 0
+	while hours < 12 and (Walkers.count(world, "屋外") > 0 or Walkers.count(world, "建物前") > 0):
+		if world.advance_safe(60) < 60:
+			break
+		hours += 1
+		if bool(w.alarm) or float(world.s.hunger) >= 85.0 or float(world.s.thirst) >= 85.0:
+			break
+	if Walkers.count(world, "屋外") <= 0 and Walkers.count(world, "建物前") <= 0:
+		return _done(game, "窓の隙間から、ときどき通りをうかがった（%d時間）。人影が見えなくなった。今なら出られそうだ。" % hours)
+	w.alarm = false
+	return _done(game, "窓の隙間から通りをうかがい続けた（%d時間）。まだ%s見える。" % [hours, Walkers.vague(Walkers.count(world, "屋外") + Walkers.count(world, "建物前"))])
+
+static func _hold_breath(game) -> bool:
+	var world = game.world
+	world.s.lights_off = true
+	var w := Walkers.ensure(world)
+	w.alarm = false
+	world.advance_safe(60)
+	w.alarm = false
+	var horde: Dictionary = w.get("horde", {})
+	if not horde.is_empty() and str(horde.place) == "屋外":
+		return _done(game, "明かりを消し、床に身を伏せて息をひそめた（1時間）。壁一枚向こうを、足音とうめき声が途切れなく流れていく。")
+	return _done(game, "明かりを消し、物音を立てないようにじっとしていた（1時間）。")
+
+static func _distract_from_home(game) -> bool:
+	var world = game.world
+	var porch := Walkers.count(world, "建物前") + Walkers.count(world, "玄関")
+	if Walkers.count(world, "建物前") <= 0:
+		return _done(game, "家の前に感染者はいない。物を投げる必要はない。何も実行していません。")
+	var minute := int(world.s.minute)
+	world.advance_safe(3)
+	if world.draw(minute, porch, "home-distract", 100) < 70:
+		var moved := Walkers.count(world, "建物前")
+		Walkers._add(world, "建物前", -moved)
+		Walkers._add(world, "住宅街", moved)
+		Walkers.make_noise(world, "住宅街", 60)
+		var w := Walkers.ensure(world)
+		w.erase("knocking")
+		return _done(game, "二階の窓をそっと開け、空き瓶を隣の通りの方へ思い切り投げた。ガラスの割れる音が響き、玄関の前の足音がそちらへ向かっていく。")
+	return _done(game, "窓から空き缶を投げたが、すぐ近くに落ちた。玄関の前の連中は、かえって窓の方を見上げている。")
