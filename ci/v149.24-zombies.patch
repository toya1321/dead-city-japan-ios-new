+## Which encounter action a line asks for ("" when it is something else).
+static func intent(text: String) -> String:
+	for spec in [["distract", ["投げ", "気をそら", "注意をそら", "おとり", "囮", "引きつけ"]], ["hide", ["隠れ", "潜", "やり過ご", "息を殺", "身を伏せ", "物陰"]], ["flee", ["逃げ", "引き返", "戻る", "戻ろう", "走って", "離れ", "家に帰"]], ["fight", ["戦", "殴", "倒す", "倒そ", "攻撃", "叩", "刺", "やっつけ", "撃退"]], ["look", ["様子", "観察", "数え", "見張", "うかが"]]]:
+		for word in spec[1]:
+			if text.contains(word):
+				return spec[0]
+	return ""
