diff --git a/tests/test_survivors149_26.gd b/tests/test_survivors149_26.gd
new file mode 100644
index 0000000..1b31737
--- /dev/null
+++ b/tests/test_survivors149_26.gd
@@ -0,0 +1,211 @@
+extends SceneTree
+## v149.26: survivors made anew for every world from parts; met once the city
+## breaks down; trust from gifts and talk; trade, information, joining; a
+## hidden bite and a thief show signs first; danger when left alone.
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Parts = preload("res://scripts/survivor_parts.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+const PLACES := ["デパート", "デパート正面", "デパート地下", "薬局", "コンビニ", "住宅街", "近所の空き家", "駅前", "商店通り", "食品店", "金物店"]
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func names_of(people: Dictionary) -> Array:
+	var out: Array = []
+	for id in people:
+		out.append(str(people[id].name))
+	out.sort()
+	return out
+
+func run() -> void:
+	# --- Generation.
+	var a := Survivors.generate(481516, PLACES)
+	var b := Survivors.generate(481516, PLACES)
+	check(var_to_bytes(a) == var_to_bytes(b), "the same world makes the same people")
+	var distinct := {}
+	var all_ok := true
+	for seed in range(1, 41):
+		var people := Survivors.generate(seed * 7919, PLACES)
+		distinct[str(names_of(people))] = true
+		all_ok = all_ok and people.size() >= 5 and people.size() <= 7
+		var labels := {}
+		var kids := 0
+		for id in people:
+			var p: Dictionary = people[id]
+			all_ok = all_ok and p.place in PLACES and not labels.has(p.place + p.label)
+			labels[p.place + p.label] = true
+			kids += 1 if p.role == "child" else 0
+			all_ok = all_ok and not ("bandage" in p.needs and "bandages" in p.offers)
+			all_ok = all_ok and not (p.gender == "男性" and p.background.contains("夫を")) and not (p.gender == "女性" and p.background.contains("妻を"))
+		all_ok = all_ok and kids <= 1
+	check(distinct.size() >= 35, "new worlds bring new people (%d different casts of 40)" % distinct.size())
+	check(all_ok, "5 to 7 people, places that exist, distinct descriptions, at most one child, no contradictions")
+
+	# --- A world.
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	g._start_new_game(profile)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var people: Dictionary = Survivors.ensure(w).people
+	var target := ""
+	for id in people:
+		if bool(people[id].joinable) and not people[id].offers.is_empty() and people[id].tag != "hidden_bite":
+			target = id
+	check(not target.is_empty(), "someone to befriend")
+	var p: Dictionary = people[target]
+	p.tag = ""
+	p.secret = ""
+	var place := str(p.place)
+	check(Survivors.here(w, place).is_empty(), "nobody to meet while life is ordinary")
+	w.s.society = "disrupted"
+	w.s.minute = 4 * 60 + 14 * 1440
+	for other in people:
+		if other != target and people[other].place == place:
+			people[other].status = "dead"
+			people[other].found = true
+	g.location = place
+	g._check_walkers(place)
+	check(str(g.log_entries.slice(-3)).contains("【出会い】") and str(g.log_entries.slice(-3)).contains(p.label), "arriving meets them")
+	check(("%sに話しかける" % p.label) in g._suggestions(), "talking is suggested")
+	await g._on_command("%sに話しかける" % p.label)
+	check(g.survivor_partner == target and g.convo_bar.visible, "talking opens a conversation")
+	var need := str(p.needs[0])
+	var item_word: String = Survivors.ITEM_LABEL[need]
+	check(("%sを渡す" % item_word) in g._suggestions(), "the conversation offers what they need")
+	w.s.district.bag.water = 8.0
+	w.s.district.bag.food = 4.0
+	w.s.inventory.bandage = 3
+	var trust0 := int(p.trust)
+	await g._on_command("%sを渡す" % item_word)
+	check(int(p.trust) == mini(100, trust0 + 20) and bool(p.known_name), "what they need wins real trust, and their name")
+	p.trust = 55
+	await g._on_command("交換できるものを聞く")
+	check(g.log_entries[-1].begins_with("交換できるもの："), "they say what they will trade")
+	var offer: Dictionary = Parts.OFFERS[p.offers[0]]
+	await g._on_command("%sと交換する" % str(offer.label).get_slice("（", 0))
+	check(p.traded.size() == 1, "a trade happens: " + g.log_entries[-1])
+	await g._on_command("何か知っていることはないか聞く")
+	check(g.log_entries[-1].contains(p.info.left(6)), "with trust, they share what they know")
+	p.trust = 70
+	p.join_trust = 60
+	await g._on_command("一緒に来ないか誘う")
+	var mate: Dictionary = w.s.household_members[-1]
+	check(p.status == "joined" and mate.name == p.name and mate.has("background") and int(w.s.profile.cohabitants) == 1, "with trust they join the household")
+	check(w.validate_state(w.s) and g.survivor_partner == "", "the household stays valid and the talk ends")
+	# --- A hidden bite surfaces after joining.
+	var g2 = Main.instantiate()
+	root.add_child(g2)
+	for i in 3: await process_frame
+	profile.seed = 2024
+	g2._start_new_game(profile)
+	g2._finish_intro()
+	var w2 = g2.world
+	w2.s.society = "disrupted"
+	var p2: Dictionary = Survivors.ensure(w2).people.values()[0]
+	p2.tag = "hidden_bite"
+	p2.secret = "誰にも言っていないが、腕を噛まれている。"
+	p2.background += p2.secret
+	p2.joinable = true
+	p2.trust = 80
+	p2.join_trust = 60
+	Survivors.invite(w2, str(p2.id))
+	var m2: Dictionary = w2.s.household_members[-1]
+	check(m2.has("hidden_bite_at") and not str(m2.background).contains("噛まれ"), "the bite stays hidden when they join")
+	w2.s.minute = int(m2.hidden_bite_at)
+	var bitten: Array = Survivors.household_hourly(w2)
+	for index in bitten:
+		Walkers.bite_housemate(w2, index)
+	check(bitten.size() == 1 and bool(m2.get("bitten", false)), "a day or two later it surfaces")
+	# --- A thief shows signs first.
+	m2.erase("bitten")
+	m2.honesty = 20
+	m2.activity = "在宅"
+	w2.s.food = 10.0
+	w2.s.water = 20.0
+	w2.set_meta("player_at_home", true)
+	var signed := false
+	for i in 40:
+		w2.s.minute += 60
+		m2.mood = 10.0
+		m2.activity = "在宅"
+		w2.s.walkers.notices = []
+		Mood.hourly(w2, false)
+		signed = signed or str(w2.s.walkers.notices).contains("備蓄をじっと数えていた")
+		if bool(m2.get("leaving", false)):
+			break
+	check(signed and bool(m2.get("theft", false)), "a dishonest housemate eyes the stores, then decides to go")
+	g2.location = "居間"
+	g2._refresh()
+	check(float(w2.s.food) < 10.0 and str(g2.log_entries.slice(-3)).contains("書き置きは、なかった"), "and slips away with food")
+	# --- Danger.
+	var ww: Dictionary = {}
+	var g3 = Main.instantiate()
+	root.add_child(g3)
+	for i in 3: await process_frame
+	profile.seed = 99
+	g3._start_new_game(profile)
+	g3._finish_intro()
+	var w3 = g3.world
+	w3.s.society = "emergency"
+	var ppl: Dictionary = Survivors.ensure(w3).people
+	var ids: Array = ppl.keys()
+	ppl[ids[0]].tag = "injured"
+	ppl[ids[0]].deadline_day = 20
+	ppl[ids[1]].tag = "hungry"
+	ppl[ids[1]].hunger_day = 20
+	ppl[ids[1]].given = 0
+	for day in range(20, 23):
+		w3.s.minute = day * 1440
+		Survivors.daily(w3, func(place): return 0)
+	check(ppl[ids[0]].status == "dead" and ppl[ids[0]].cause == "wound", "an untreated wound kills in the end")
+	check(ppl[ids[1]].status == "dead" and ppl[ids[1]].cause == "hunger", "hunger kills someone nobody fed")
+	ppl[ids[0]].met = true
+	ppl[ids[0]].found = false
+	check(str(Survivors.remains(w3, ppl[ids[0]].place)).contains("冷たくなっていた"), "what is found where they were")
+	# --- Common questions are answered from the person's facts, in their voice.
+	var talk: Dictionary = Survivors.generate(5, PLACES)
+	var probe_id: String = talk.keys()[0]
+	var w4 = w3
+	w4.s.survivors = {"people": talk}
+	var tp: Dictionary = talk[probe_id]
+	for spec in [["", "けが"], ["injured", "切り"], ["hidden_bite", "なんでも"]]:
+		tp.tag = spec[0]
+		tp.voice = "calm"
+		tp.gender = "女性"
+		tp.detail = "腕"
+		var line: String = Survivors.topic_reply(w4, probe_id, "その傷、どうしたの？")
+		var ok := (line.contains("していません") if spec[0] == "" else (line.contains("切りました") if spec[0] == "injured" else line.contains("擦り傷")))
+		check(ok, "a wound question fits the facts (%s): %s" % [spec[0], line])
+	tp.tag = ""
