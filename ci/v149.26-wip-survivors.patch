+		"ookawa": {"警戒": "あんた、どこの子だい。", "様子見": "足がねえ、痛くてかなわないよ。", "打ち解けた": "あんたの顔を見ると、元気が出るよ。", "信頼": "気をつけてお帰りよ。"},
+		"toda": {"警戒": "近づくな。何が目的だ。", "様子見": "……で、何が欲しいんだ。", "打ち解けた": "あんた、変なやつだな。", "信頼": "借りは、ちゃんと返す。"},
+		"nakamura": {"警戒": "用件を言って。", "様子見": "噛まれていないなら、話は聞くわ。", "打ち解けた": "あなたは、冷静ね。", "信頼": "困ったら、また来て。"},
