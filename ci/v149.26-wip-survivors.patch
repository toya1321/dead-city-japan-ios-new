+	elif not negated and NPCMemory._mentions(text, ["交換できる", "何と交換", "何がある", "持ってるもの", "持っているもの"]):
+		result = Survivors.offers_text(world, id)
+	elif not negated and NPCMemory._mentions(text, ["交換", "取引", "と換え", "トレード"]):
+		result = Survivors.trade(world, id, text)
+	elif not negated and NPCMemory._mentions(text, ["知ってる", "知って", "情報", "噂", "教えて"]):
+		result = Survivors.ask(world, id)
+		Survivors.talked(world, id)
+	elif not negated and NPCMemory._mentions(text, ["仲間", "一緒に来", "うちに来", "家に来", "一緒に行こう", "来ないか", "誘", "一緒に暮らそう"]):
+		var answer: Array = Survivors.invite(world, id)
+		result = str(answer[0])
+		if bool(answer[1]):
+			survivor_partner = ""
+	elif Survivors.addressed(world, location, text) == id and NPCMemory._mentions(text, ["話しかけ", "声をかけ"]) and text.length() <= 20:
+		# Just opening the conversation: a greeting that fits the trust so far.
+		Survivors.talked(world, id)
+		world.advance_safe(1)
+		result = "%s「%s」" % [Survivors.call_name(world, id), Survivors.offline_reply(world, id)]
+	else:
