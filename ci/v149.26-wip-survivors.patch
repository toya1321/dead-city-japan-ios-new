+extends SceneTree
+## Real-model check of survivor conversation (DCJ_LLAMA_PROBE, DCJ_GGUF).
+const Main = preload("res://main.tscn")
+const Real = preload("res://qa/real_npc_scenarios.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const TALKS := [
+	["デパート", "警備員の男", 70, ["ここで何があったんですか", "奥さんとは連絡ついた？", "外はどうなってると思う？"]],
+	["駅前", "スーツの男", 20, ["何してるんだ？", "食べ物ならある。何が欲しい？", "家族はいるのか？"]],
+	["薬局", "白衣の女性", 55, ["大丈夫ですか？", "噛まれたらどうなるんですか？", "ここに一人でいるの？"]],
+	["近所の空き家", "男の子", 30, ["大丈夫だよ、怖くないよ", "お母さんは？", "お腹すいてない？"]],
+	["デパート", "警備員の男", 70, ["ここで何があったんですか", "奥さんとは連絡ついた？", "一緒に来ない？"]],
+	["駅前", "スーツの男", 40, ["横浜まで行くのは無理だよ", "あんた、何か知ってる？"]],
+]
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var only_first := OS.get_environment("DCJ_FIRST") == "1"
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	g._start_new_game(g.world.DEFAULT_PROFILE.duplicate(true))
+	g._finish_intro()
+	var backend = Real.RealModel.new()
+	g.local_model.backend = backend
+	g.local_model.load_timeout_ms = 400000
+	g.local_model.generation_timeout_ms = 400000
+	var w = g.world
+	w.s.society = "disrupted"
+	w.s.minute = 4 * 60 + 14 * 1440
+	for talk in (TALKS.slice(0, 1) if only_first else TALKS):
+		g.location = talk[0]
+		g.survivor_partner = ""
+		var id := Survivors.addressed(w, talk[0], talk[1])
+		Survivors.ensure(w).people[id].trust = talk[2]
+		await g._on_command(talk[1] + "に話しかける")
+		print("== %s (trust %d)" % [talk[1], talk[2]])
+		print("   > (話しかける) ", g.log_entries[-1])
+		for line in talk[3]:
+			var t0 := Time.get_ticks_msec()
+			await g._on_command(line)
+			print("   > %s  →  %s  [%ds]" % [line, g.log_entries[-1], (Time.get_ticks_msec() - t0) / 1000])
+		await g._on_command("会話を終える")
+	quit()
