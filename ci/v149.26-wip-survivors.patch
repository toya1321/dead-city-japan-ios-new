@@ -0,0 +1,43 @@
+extends SceneTree
+## Real-model check of conversation with generated survivors (DCJ_LLAMA_PROBE, DCJ_GGUF, DCJ_SEED).
+const Main = preload("res://main.tscn")
+const Real = preload("res://qa/real_npc_scenarios.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const LINES := ["こんにちは。大丈夫ですか？", "ここで何があったんですか", "何か必要なものはある？", "その腕、どうしたの？"]
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	profile.seed = int(OS.get_environment("DCJ_SEED")) if not OS.get_environment("DCJ_SEED").is_empty() else 481516
+	g._start_new_game(profile)
+	g._finish_intro()
+	var backend = Real.RealModel.new()
+	g.local_model.backend = backend
+	g.local_model.load_timeout_ms = 400000
+	g.local_model.generation_timeout_ms = 400000
+	var w = g.world
+	w.s.society = "disrupted"
+	w.s.minute = 4 * 60 + 14 * 1440
+	var people: Dictionary = Survivors.ensure(w).people
+	var count := 0
+	var order: Array = people.keys()
+	order.sort_custom(func(x, y): return str(people[x].secret).length() > str(people[y].secret).length())
+	for id in order:
+		if count >= int(OS.get_environment("DCJ_COUNT") if not OS.get_environment("DCJ_COUNT").is_empty() else "3"):
+			break
+		count += 1
+		var p: Dictionary = people[id]
+		g.location = p.place
+		g.survivor_partner = ""
+		print("== %s（%s・%d・%s）信頼%d 性格:%s %s" % [p.name, p.job, p.age, p.gender, p.trust, p.trait, ("秘密:" + p.secret) if not p.secret.is_empty() else ""])
+		await g._on_command(p.label + "に話しかける")
+		print("   > (話しかける) ", g.log_entries[-1])
+		for line in LINES:
+			var t0 := Time.get_ticks_msec()
+			await g._on_command(line)
+			print("   > %s  →  %s  [%ds]" % [line, g.log_entries[-1], (Time.get_ticks_msec() - t0) / 1000])
+		await g._on_command("会話を終える")
+	quit()
