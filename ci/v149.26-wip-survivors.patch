diff --git a/tests/test_survivors149_26.gd b/tests/test_survivors149_26.gd
new file mode 100644
index 0000000..294c825
--- /dev/null
+++ b/tests/test_survivors149_26.gd
@@ -0,0 +1,106 @@
+extends SceneTree
+## v149.26: survivors outside. Met once the city breaks down; trust from
+## gifts and talk; trade, information, joining the household; danger when
+## left alone; old saves without survivors still load.
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = 1
+	profile.companion_names = ["詩音"]
+	g._start_new_game(profile)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	# --- Not before the breakdown.
+	g.location = "薬局"
+	check(Survivors.here(w, "薬局").is_empty() and Survivors.meet(w, "薬局").is_empty(), "nobody to meet while life is ordinary")
+	w.s.society = "disrupted"
+	w.s.minute = 4 * 60 + 14 * 1440
+	g.location = "屋外"
+	await g._on_command("薬局へ行く")
+	check(str(g.log_entries.slice(-3)).contains("【出会い】") and str(g.log_entries.slice(-3)).contains("白衣の女性"), "arriving meets the pharmacist")
+	check("白衣の女性に話しかける" in g._suggestions(), "talking to her is suggested")
+	# --- Talk, give, trust.
+	await g._on_command("白衣の女性に話しかける")
+	check(g.survivor_partner == "nakamura" and g.convo_bar.visible and (g.log_entries[-1].begins_with("白衣の女性「") or g.log_entries[-1].begins_with("中村「")), "talking opens a conversation, in a speech bubble")
+	check("水を渡す" in g._suggestions() and "一緒に来ないか誘う" in g._suggestions(), "the conversation offers gifts, trade and an invitation")
+	var trust0: int = Survivors.ensure(w).people.nakamura.trust
+	await g._on_command("水を渡す")
+	check(g.log_entries[-1].contains("足りない"), "a gift needs something carried")
+	w.s.district.bag.water = 8.0
+	w.s.district.bag.food = 4.0
+	await g._on_command("水を渡す")
+	check(int(Survivors.ensure(w).people.nakamura.trust) == trust0 + 20 and float(w.s.district.bag.water) == 6.0 and g.log_entries[-1].contains("水が一番つらかった"), "what they need wins real trust")
+	check(Survivors.call_name(w, "nakamura") == "中村", "she gives her name")
+	await g._on_command("交換できるものを聞く")
+	check(g.log_entries[-1].contains("包帯3つ") and g.log_entries[-1].contains("水2L"), "she says what she will trade")
+	var bandages: int = int(w.s.inventory.bandage)
+	await g._on_command("包帯と交換する")
+	check(int(w.s.inventory.bandage) == bandages + 3 and float(w.s.district.bag.water) == 4.0, "a trade happens at the agreed price")
+	await g._on_command("何か知っていることはないか聞く")
+	check(g.log_entries[-1].contains("噛まれた人は"), "with trust, she shares what she knows")
+	await g._on_command("一緒に来ないか誘う")
+	check(Survivors.ensure(w).people.nakamura.status == "joined" and w.s.household_members.size() == 2 and str(w.s.household_members[1].name) == "中村" and int(w.s.profile.cohabitants) == 2, "with enough trust she joins the household")
+	check(w.validate_state(w.s) and w.s.household_members[1].has("background"), "the household stays valid and she keeps her story")
+	check(g.survivor_partner == "", "the conversation ends")
+	# --- Low trust refuses, the old woman never leaves home.
+	g.location = "駅前"
+	await g._on_command("スーツの男に話しかける")
+	await g._on_command("一緒に来ないか誘う")
+	check(g.log_entries[-1].contains("まだ") and Survivors.ensure(w).people.toda.status == "alive", "a wary stranger turns the invitation down")
+	await g._on_command("何か知っていることはないか聞く")
+	check(g.log_entries[-1].contains("信用してもらう"), "and keeps what he knows")
+	await g._on_command("会話を終える")
+	g.location = "住宅街"
+	Survivors.ensure(w).people.ookawa.met = true
+	await g._on_command("おばあさんに話しかける")
+	w.s.inventory.bandage = 2
+	await g._on_command("包帯で手当てをする")
+	check(bool(Survivors.ensure(w).people.ookawa.get("treated", false)), "the old woman's wound can be dressed")
+	Survivors.ensure(w).people.ookawa.trust = 90
+	await g._on_command("一緒に来ないか誘う")
+	check(g.log_entries[-1].contains("この家で死ぬ") and Survivors.ensure(w).people.ookawa.status == "alive", "she will not leave her home")
+	await g._on_command("会話を終える")
+	# --- Danger: untreated wound, the child unfed, the dead in crowded places.
+	var w2 = Main.instantiate()
+	root.add_child(w2)
+	for i in 3: await process_frame
+	w2._start_new_game(profile)
+	w2._finish_intro()
+	var ww = w2.world
+	ww.s.society = "emergency"
+	ww.s.minute = 26 * 1440
+	ww.s.walkers.places = {"駅前": 10}
+	for day in 6:
+		ww.s.minute = (26 + day) * 1440
+		Survivors.daily(ww, func(place): return Walkers.count(ww, place))
+	var people: Dictionary = Survivors.ensure(ww).people
+	check(people.ookawa.status == "dead" and people.ookawa.cause == "wound", "an untreated wound kills in the end")
+	check(people.yota.status == "dead", "a child alone does not last")
+	check(people.toda.status == "dead" and int(ww.s.walkers.places.get("駅前", 0)) >= 10, "in a crowded place a survivor can die and rise")
+	people.toda.met = true
+	var found: Array = Survivors.remains(ww, "駅前")
+	check(str(found).contains("血の跡"), "what is found where they were")
+	# --- Old saves without survivors.
+	var old: Dictionary = w.s.duplicate(true)
+	old.erase("survivors")
+	check(w.validate_state(old), "an old save without survivors is valid")
+	print("v149.26 survivor checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
