+		survivor_partner = ""
+		_append("%sとの話を終えた。" % name)
+		_update_dialogue_input()
+		_refresh()
+		return true
+	var negated := PlayerIntents.negated(text)
+	var result := ""
+	if not negated and NPCMemory._mentions(text, ["渡", "あげ", "分け", "やる", "どうぞ", "差し出", "手当て"]):
+		for item in GIVE_ITEMS:
+			if NPCMemory._mentions(text, GIVE_ITEMS[item]):
