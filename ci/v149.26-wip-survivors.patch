+## v149.26: talking with a survivor met outside. Returns true when handled.
+func _survivor_command(cmd: String) -> bool:
+	if not survivor_partner.is_empty() and Survivors.here(world, location).find(survivor_partner) < 0:
+		survivor_partner = ""
+	var id := survivor_partner
+	if id.is_empty():
