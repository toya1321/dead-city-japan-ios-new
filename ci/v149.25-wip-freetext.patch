+	"lights_off": ["暗", "明かり", "電気", "照明", "灯", "ライト"],
+	"lights_on": ["明かり", "電気", "照明", "灯", "ライト", "明るく"],
+	"blackout": ["窓", "遮光", "目張り", "光", "漏れ"],
+	"wait_clear": ["待", "まで", "静かになる", "いなくな", "去る", "どっか行"],
+	"hold": ["息", "静か", "音を立て", "物音", "じっと", "動かな", "伏せ", "潜", "かぶ"],
+	"fill_bath": ["風呂", "浴槽", "湯船", "バスタブ", "断水", "ため", "溜め"],
