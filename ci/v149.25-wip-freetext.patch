@@ -0,0 +1,97 @@
+extends SceneTree
+## v149.24: the player's own actions in free wording. Fixed words first; what
+## they miss goes to the local model, which only names the action. The game
+## refuses negated lines and lines without a related word, says how it read
+## the line, and runs the fixed command. A scripted model stands in for Qwen.
+const Main = preload("res://main.tscn")
+const Model = preload("res://scripts/local_npc_model.gd")
+const Intents = preload("res://scripts/player_intents.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+
+class ScriptedModel extends RefCounted:
+	var queue: Array = []
+	var requests := 0
+	var instructions := ""
+	func model_available() -> bool:
+		return true
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, text: String, _input: String) -> bool:
+		requests += 1
+		instructions = text
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		pass
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func verdict(model: ScriptedModel, key: String) -> void:
+	model.queue.append(JSON.stringify({"kind": "player", "value": key}))
+
+func run() -> void:
+	# --- Rules alone.
+	check(Intents.negated("タバコは吸わない") and Intents.negated("映画は観なくていいや") and Intents.negated("料理はやめとく"), "declining lines are negated")
+	check(not Intents.negated("床に伏せて動かない") and not Intents.negated("音を立てないようにする") and not Intents.negated("光が漏れないように窓を覆う"), "how-to phrases are not negations")
+	check(Intents.command({"kind": "player", "value": "flee"}, "一目散に駆け出す", true) == "逃げる", "a verdict with a related word runs")
+	check(Intents.command({"kind": "player", "value": "fight"}, "様子を見る", true) == "", "a verdict without a related word does not")
+	check(Intents.command({"kind": "player", "value": "smoke"}, "タバコは吸わない", false) == "", "a negated line never runs")
+	check(Intents.command({"kind": "player", "value": "hide"}, "隠れる", false) == "", "encounter keys are not used outside an encounter")
+	check(Model.parse(JSON.stringify({"kind": "player", "value": "distract"})).get("value") == "distract" and Model.parse(JSON.stringify({"kind": "player", "value": "fly"})).is_empty(), "the reply parser accepts only known keys")
+
+	var game = Main.instantiate()
+	root.add_child(game)
+	await process_frame
+	game._start_new_game(game.world.DEFAULT_PROFILE.duplicate(true))
+	game._finish_intro()
+	var fake := ScriptedModel.new()
+	game.local_model.backend = fake
+	var w = game.world
+	w.s.walkers.risen = [7]
+	w.s.society = "disrupted"
+	w.s.grid_online = true
+	w.s.food = 5.0
+	w.s.hunger = 40.0
+
+	# --- Fixed words need no model.
+	game.location = "居間"
+	await game._on_command("タバコ吸う")
+	check(fake.requests == 0 and game.log_entries[-1].contains("タバコがない"), "common wording is caught without the model")
+	await game._on_command("タバコは吸わない")
