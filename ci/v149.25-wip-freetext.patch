+extends RefCounted
+## v149.24: the player's own free-worded actions, read by the local model when
+## the fixed phrases do not match. As with NPC requests (v149.18) the model only
+## names the intent; the game requires a related word in the player's line,
+## refuses negated lines, and runs the canonical command through its own rules.
+
+const ENCOUNTER := {
+	"hide": "隠れる", "flee": "逃げる", "distract": "物を投げて気をそらす", "fight": "戦う", "look": "様子を見る",
+}
+const GENERAL := {
+	"lights_off": "明かりを消す", "lights_on": "明かりをつける", "blackout": "窓を目張りする",
+	"wait_clear": "通りが空くまで待つ", "hold": "息をひそめる",
