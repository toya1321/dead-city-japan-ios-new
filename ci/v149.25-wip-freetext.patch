+	"back_out": ["裏", "勝手口", "ベランダ", "はしご"],
+	"back_in": ["裏", "勝手口", "ベランダ", "はしご"],
+	"distract_home": ["投", "放", "そら", "引きつけ", "気を引", "音を立て", "追い払"],
