+	"sleep": "寝る", "drink": "水を飲む", "eat": "食事する", "news": "ニュースを見る", "look_window": "窓から外を見る",
+}
+## A line must contain one of these for the key to run.
+const EVIDENCE := {
+	"hide": ["隠", "潜", "伏", "陰", "影", "やり過ご", "しゃが", "息", "低く", "身を"],
+	"flee": ["逃", "戻", "引き返", "引き上げ", "離", "走", "駆", "ダッシュ", "帰", "退", "下が", "距離", "撤", "去", "ずさ", "避難", "脱"],
