+	"fight": ["戦", "殴", "叩", "倒", "刺", "攻撃", "殺", "仕留", "割", "蹴", "ぶん", "やる", "やっつけ", "突", "当たり", "押し", "斬", "切", "撃", "絞", "振り"],
