diff --git a/qa/freetext_check.gd b/qa/freetext_check.gd
new file mode 100644
index 0000000..22530e4
--- /dev/null
+++ b/qa/freetext_check.gd
@@ -0,0 +1,115 @@
+extends SceneTree
+## Runs qa/freetext_cases.gd against the game (keyword rules only, or with the
+## real model when DCJ_LLAMA_PROBE/DCJ_GGUF are set) and prints JSON lines.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Real = preload("res://qa/real_npc_scenarios.gd")
+var Cases = preload("res://qa/freetext_cases.gd")
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func setup(g, state: String) -> void:
+	var w = g.world
+	g._start_new_game(g.world.DEFAULT_PROFILE.duplicate(true))
+	g._finish_intro()
+	w.s.minute = 12 * 60 + 15 * 1440
+	w.s.walkers.risen = [7]
+	w.s.food = 10.0
+	w.s.hunger = 40.0
+	w.s.mood = 40.0
+	w.s.cigarettes = 10
+	w.s.society = "disrupted"
+	w.s.grid_online = true
+	w.s.water_online = true
+	w.s.inventory.parts = 1
+	g.location = "居間"
+	match state:
+		"encounter":
+			g.location = "商店通り"
+			w.s.walkers.places = {"商店通り": 3}
+			w.s.walkers.encounter = {"place": "商店通り", "count": 3, "near": false, "since": w.s.minute, "from": "屋外"}
+		"home":
+			w.s.walkers.places = {"屋外": 2}
+		"home_door":
+			w.s.walkers.places = {"建物前": 2}
+			g.location = "居間"
+		"horde":
+			w.s.walkers.horde = {"place": "屋外", "step": 4, "size": 20}
+		"konbini":
+			w.s.minute = 2 * 60 + 15 * 1440
+			w.s.society = "alert"
+			g.location = "コンビニ"
+		"outside":
+			g.location = "屋外"
+	g._refresh()
+
+func detect(g, before: Dictionary, expected: String, enc_before: Dictionary) -> String:
+	var w = g.world
+	var tail := str(g.log_entries.slice(-4))
+	var enc_text := tail
+	match expected:
+		"hide": return "ok" if tail.contains("身を潜め") or tail.contains("隠れようと") else ""
+		"flee": return "ok" if tail.contains("引き返") or tail.contains("逃げようと") else ""
+		"distract": return "ok" if tail.contains("向かっていく") or tail.contains("すぐ近くに落ちた") else ""
+		"fight": return "ok" if tail.contains("打ちつけ") or tail.contains("打ちかか") or tail.contains("かわされ") else ""
+		"look": return "ok" if tail.contains("数えた") or tail.contains("歩き回って") or tail.contains("近づいてくる") else ""
+		"lights_off": return "ok" if bool(w.s.get("lights_off", false)) else ""
+		"blackout": return "ok" if bool(w.s.get("blackout", false)) else ""
+		"wait_clear": return "ok" if tail.contains("うかが") or tail.contains("出られそう") else ""
+		"fill_bath": return "ok" if float(w.s.get("bath_water", 0.0)) > 0.0 else ""
+		"cook": return "ok" if tail.contains("温かい食事") else ""
+		"movie": return "ok" if tail.contains("一人で『") else ""
+		"smoke": return "ok" if tail.contains("タバコに火") else ""
+		"read": return "ok" if tail.contains("本を一冊") else ""
+		"back_out": return "ok" if g.location == "屋外" and tail.contains("勝手口") else ""
+		"back_in": return "ok" if g.location == "台所" else ""
+		"distract_home": return "ok" if tail.contains("向かっていく") or tail.contains("見上げて") else ""
+		"lock": return "ok" if bool(w.s.door_locked) and tail.contains("施錠") else ""
+		"hold": return "ok" if tail.contains("息をひそめ") or tail.contains("じっとしていた") else ""
+		"buy_tobacco": return "ok" if int(w.s.get("cigarettes", 0)) > 10 else ""
+		"buy_gas": return "ok" if tail.contains("ボンベを") else ""
+		"none_enc": return "ok" if not (tail.contains("打ちつけ") or tail.contains("打ちかか") or tail.contains("かわされ")) else ""
+		"none": return "ok" if not (tail.contains("タバコに火") or tail.contains("温かい食事") or tail.contains("一人で『") or tail.contains("本を一冊") or bool(w.s.get("lights_off", false))) else ""
+		"buy_water": return "ok" if tail.contains("購入") or tail.contains("買った") or tail.contains("持って帰れる") else ""
+	return ""
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	if OS.get_environment("DCJ_SET") in ["2", "3"]:
+		Cases = load("res://qa/freetext_cases%s.gd" % OS.get_environment("DCJ_SET"))
+	var use_model := not OS.get_environment("DCJ_GGUF").is_empty()
+	var only := OS.get_environment("DCJ_ONLY")
+	var backend = null
+	if use_model:
+		backend = Real.RealModel.new()
+		g.local_model.backend = backend
+		g.local_model.load_timeout_ms = 400000
+		g.local_model.generation_timeout_ms = 400000
+	var ok := 0
+	var total := 0
+	for case in Cases.CASES:
+		if not only.is_empty() and not str(case[1]) in only.split("|"):
+			continue
+		setup(g, str(case[0]))
+		g.local_model.enabled = use_model
+		if g.world.s.door_locked and case[2] == "lock":
+			g.world.s.door_locked = false
+			g.location = "玄関"
+		var enc: Dictionary = g.world.s.walkers.encounter.duplicate()
+		var started := Time.get_ticks_msec()
+		await g._on_command(str(case[1]))
+		while g.advancing:
+			await process_frame
+		if not g.pending_local_action.is_empty():
+			# A suggestion waits for confirmation: count it as found but note it.
+			await g._on_command("提案を実行")
+		var got := detect(g, {}, str(case[2]), enc)
+		total += 1
+		ok += 1 if got == "ok" else 0
+		print(JSON.stringify({"state": case[0], "text": case[1], "want": case[2], "ok": got == "ok", "ms": Time.get_ticks_msec() - started, "log": str(g.log_entries.slice(-2)).left(160), "raw": backend.raw if backend != null else ""}))
+	print("FREETEXT %d / %d" % [ok, total])
+	quit()
