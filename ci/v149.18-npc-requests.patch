diff --git a/qa/real_npc_scenarios.gd b/qa/real_npc_scenarios.gd
new file mode 100644
index 0000000..e0b2336
--- /dev/null
+++ b/qa/real_npc_scenarios.gd
@@ -0,0 +1,144 @@
+extends SceneTree
+## Real-model conversation scenarios: general chat and in-game requests.
+## Each scenario starts a fresh household game at its start time (08:0x on the
+## first day, the state the iPhone test used) and plays the lines in order. One JSON line per
+## turn records the NPC line, reply provenance, rejected model output, the raw
+## model reply and the world-state change the request should have caused.
+## Usage: DCJ_LLAMA_PROBE=... DCJ_GGUF=... [DCJ_SCENARIOS=a,b] godot --headless --script res://qa/real_npc_scenarios.gd
+const Main = preload("res://main.tscn")
+
+class RealModel extends RefCounted:
+	var executable := OS.get_environment("DCJ_LLAMA_PROBE")
+	var model := OS.get_environment("DCJ_GGUF")
+	var process := -1
+	var raw := ""
+	var calls := 0
+	var work := ProjectSettings.globalize_path("user://local-llm-scenarios")
+
+	func model_available() -> bool:
+		return FileAccess.file_exists(executable) and FileAccess.file_exists(model)
+
+	func model_name() -> String:
+		return model.get_file()
+
+	func is_warm() -> bool:
+		return false
+
+	func begin(_id: int, instructions: String, input: String) -> bool:
+		DirAccess.make_dir_recursive_absolute(work)
+		for pair in [["system.txt", instructions], ["input.json", input]]:
+			var file := FileAccess.open(work.path_join(pair[0]), FileAccess.WRITE)
+			if file == null:
+				return false
+			file.store_string(pair[1])
+			file.close()
+		var output := work.path_join("result.json")
+		if FileAccess.file_exists(output):
+			DirAccess.remove_absolute(output)
+		calls += 1
+		raw = ""
+		process = OS.create_process(executable, [model, work.path_join("system.txt"), "--request", work.path_join("input.json"), output])
+		return process > 0
+
+	func take_result(_id: int) -> String:
+		if process < 0 or OS.is_process_running(process):
+			return ""
+		raw = FileAccess.get_file_as_string(work.path_join("result.json")) if FileAccess.file_exists(work.path_join("result.json")) else "{}"
+		process = -1
+		return raw
+
+	func cancel(_id: int) -> void:
+		if process > 0 and OS.is_process_running(process):
+			OS.kill(process)
+		process = -1
+
+# [name, [lines...]]; expectations are judged by reading the log.
+const SCENARIOS := [
+	["chat", ["おはよう", "今日の予定は？", "今日は何するの？", "最近どう？", "好きな映画ある？", "それってどんな話？", "疲れてない？", "ありがとう、助かるよ"]],
+	["shopping_vague", ["買い物行ってきてくれない？", "水", "3本で", "ありがとう"]],
+	["shopping_direct", ["帰りに水を3本買ってきてもらえる？", "やっぱり買わなくていいよ"]],
+	["shopping_food", ["食べ物が少ないから何か買ってきてくれない？", "2個お願い"]],
+	["cooking", ["お腹すいたな、何か作ってくれない？"]],
+	["sleep", ["もう遅いし、そろそろ寝たら？"]],
+	["sleep_negative", ["まだ寝なくていいよ"]],
+	["movie", ["暇だし映画でも観ない？"]],
+	["joint", ["コンビニまで一緒に来てくれない？"]],
+	["door", ["玄関の鍵閉めといてくれる？"]],
+	["news", ["ちょっとニュース見てくれない？"]],
+	["drink", ["喉乾いてない？水飲んだら？"]],
+	["variety", ["ご飯お願いしてもいい？", "一緒に映画観ようよ", "ちょっと休んだら？"]],
+	["variety2", ["今日の晩ご飯、みんなの分作ってくれる？", "帰りに包帯2個買ってきてくれる？", "今日は買い物行かなくていいからね"]],
+	["variety3", ["鍵開けといてくれる？", "駅前まで一緒に行かない？"]],
+	["chat2", ["昨日はよく眠れた？", "最近ハマってることある？", "それいいね、今度教えてよ"]],
+]
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func snapshot(game, index: int) -> Dictionary:
+	var person: Dictionary = game.world.s.household_members[index]
+	return {
+		"location": str(person.location), "activity": str(person.activity),
+		"errand": person.get("water_errand", {}).duplicate(true),
+		"door_locked": game.world.s.get("door_locked", null), "minute": int(game.world.s.minute),
+		"food": snappedf(float(game.world.s.food), 0.01), "water": snappedf(float(game.world.s.water), 0.1),
+		"awaiting_meal": game.world.s.get("player_meal_pending", null),
+		"pending_action": game.pending_local_action.duplicate(),
+	}
+
+func changes(before: Dictionary, after: Dictionary) -> Dictionary:
+	var diff := {}
+	for key in after:
+		if key == "minute":
+			continue
+		if str(before.get(key)) != str(after[key]):
+			diff[key] = [before.get(key), after[key]]
+	diff["minutes_passed"] = int(after.minute) - int(before.minute)
+	return diff
+
+func run() -> void:
+	var backend := RealModel.new()
+	if not backend.model_available():
+		printerr("DCJ_LLAMA_PROBE and DCJ_GGUF must point to the executable and real model")
+		quit(2)
+		return
+	var only := OS.get_environment("DCJ_SCENARIOS").split(",", false)
+	for scenario in SCENARIOS:
+		if not only.is_empty() and str(scenario[0]) not in only:
+			continue
+		var game = Main.instantiate()
+		root.add_child(game)
+		await process_frame
+		var profile: Dictionary = game.world.DEFAULT_PROFILE.duplicate(true)
+		profile.cohabitants = 1
+		profile.companion_names = ["詩音"]
+		game._start_new_game(profile)
+		game._finish_intro()
+		game.location = "居間"
+		game._sync_player_position()
+		# New game starts at 08:0x on the first day, like the iPhone test.
+		game.world.s.household_members[0].location = "居間"
+		game.local_model.backend = backend
+		game.local_model.load_timeout_ms = 400000
+		var first := true
+		for line in scenario[1]:
+			var before := snapshot(game, 0)
+			var shown: int = game.log_entries.size()
+			game.last_npc_rejected = {}
+			var calls: int = backend.calls
+			var started := Time.get_ticks_msec()
+			await game._on_command(("詩音、" if first else "") + str(line))
+			first = false
+			var after := snapshot(game, 0)
+			var output: Array = []
+			for i in range(shown, game.log_entries.size()):
+				output.append(str(game.log_entries[i]))
+			print(JSON.stringify({
+				"scenario": scenario[0], "player": line, "shown": output,
+				"source": game.last_npc_reply_source, "rejected": game.last_npc_rejected,
+				"model_calls": backend.calls - calls, "raw_model": backend.raw if backend.calls > calls else "",
+				"changes": changes(before, after), "seconds": (Time.get_ticks_msec() - started) / 1000,
+			}))
+		game.queue_free()
+		await process_frame
+	quit(0)
