index 0000000..5d19738
--- /dev/null
+++ b/tests/test_npc_requests149_18.gd
@@ -0,0 +1,149 @@
+extends SceneTree
+## v149.18: requests the local model recognised in free wording run the same
+## deterministic game actions as their canonical phrases; negated requests do
+## not; today's schedule separates finished and upcoming steps.
+const Main = preload("res://main.tscn")
+const Model = preload("res://scripts/local_npc_model.gd")
+const Requests = preload("res://scripts/npc_requests.gd")
+const Mind = preload("res://scripts/npc_mind.gd")
+
+class ScriptedModel extends RefCounted:
+	var queue: Array = []
+	var payload := {}
+	var requests := 0
+	func model_available() -> bool:
+		return true
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, _instructions: String, input: String) -> bool:
+		requests += 1
+		payload = Model.decode_request(input)
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		pass
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func npc(model: ScriptedModel, value: String) -> void:
+	model.queue.append(JSON.stringify({"kind":"npc", "value":value}))
+
+func new_game():
+	var game = Main.instantiate()
+	root.add_child(game)
+	await process_frame
+	var profile: Dictionary = game.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = 1
+	profile.companion_names = ["詩音"]
+	game._start_new_game(profile)
+	game._finish_intro()
+	game.location = "居間"
+	game._sync_player_position()
+	game.world.s.household_members[0].location = "居間"
+	var fake := ScriptedModel.new()
+	game.local_model.backend = fake
+	game.local_model.generation_timeout_ms = 300
+	return [game, fake]
+
+func run() -> void:
+	# --- Validation of model task values.
+	for value in ["sleep", "cook", "movie", "buy", "buy:water", "buy:food:2", "go:コンビニ", "cancel_shopping", "eat"]:
+		check(Requests.valid(value), "valid task " + value)
+	for value in ["buy:gold", "buy:water:0", "buy:water:99", "go:月", "fly", ""]:
+		check(not Requests.valid(value), "invalid task rejected: " + value)
+	check(Model.parse('{"kind":"npc","value":"buy:water:3"}').get("value") == "buy:water:3", "parser accepts a validated request")
+	check(Model.parse('{"kind":"npc","value":"buy:gold"}').is_empty(), "parser rejects an unknown item")
+	var long_story := "『リング』は呪いのビデオの話。観た人に一週間後に電話がかかってくる。主人公がその謎を追う。最後まで目が離せないんだ。"
+	var shortened := str(Model.parse(JSON.stringify({"kind":"chat","value":long_story})).get("value", ""))
+	check(shortened == "『リング』は呪いのビデオの話。観た人に一週間後に電話がかかってくる。主人公がその謎を追う。", "long chat keeps the first three whole sentences")
+	check(Model.parse(JSON.stringify({"kind":"chat","value":"あ".repeat(130) + "。"})).is_empty(), "a single over-long sentence is still rejected")
+	check(Requests.canonical("buy:water:3") == "水を3本買ってきて" and Requests.canonical("go:コンビニ") == "一緒にコンビニに行こう", "canonical phrases")
+	check(Requests.shopping_answer("水を3本") == "水を3本買ってきて" and Requests.shopping_answer("食べ物かな") == "食料を買ってきて" and Requests.shopping_answer("なんでもいい").is_empty(), "shopping answer reads item and count")
+	for line in ["買い物行ってきてくれない？", "そろそろ寝たら？", "映画でも観ない？", "水飲んだら？", "コンビニまで一緒に来て", "鍵閉めといてくれる？", "何か作ってくれない？", "ご飯お願い"]:
+		check(Requests.looks_like_request(line), "request wording passes the pre-check: " + line)
+	for line in ["何か甘いものない？", "今夜は何しようか", "話せてよかった", "疲れてない？", "好きな映画ある？", "おはよう", "今日の予定は？"]:
+		check(not Requests.looks_like_request(line), "conversation skips the request call: " + line)
+	check(Requests.negated("まだ寝なくていいよ") and Requests.negated("買い物は行かなくていいよ") and not Requests.negated("そろそろ寝たら？"), "negation guard keeps suggestions as requests")
+
+	# --- Quoted titles must be grounded in the profile, record or player's words.
+	var context := {"人物": {"一番好きな映画": "『リング』が好き。"}}
+	check(Mind.reject_reason("『千と千尋の神隠し』が好き。", "好きな映画ある？", {"context": context}) == "unsupported_title", "invented favourite title is rejected")
+	check(Mind.reject_reason("『リング』かな。じわじわ怖いのがいい。", "好きな映画ある？", {"context": context}).is_empty(), "profile title is accepted")
+	check(Mind.reject_reason("『ローマの休日』、いいよね。", "『ローマの休日』って観た？", {"context": context}).is_empty(), "title the player named is accepted")
+
+	# --- Vague shopping request: the NPC asks what to buy, the answer becomes the order.
+	var pair: Array = await new_game()
+	var game = pair[0]
+	var fake: ScriptedModel = pair[1]
+	var shion: Dictionary = game.world.s.household_members[0]
+	npc(fake, "buy")
+	await game._on_command("詩音、買い物行ってきてくれない？")
+	check(game.log_entries[-1].contains("何を買って") and bool(shion.get("shopping_ask", false)) and game.last_npc_reply_source.source == "ai_request", "vague shopping request asks for the item")
+	await game._on_command("水を3本で")
+	var errand: Dictionary = shion.get("water_errand", {})
+	check(errand.get("phase") == "queued" and errand.get("item") == "water" and int(errand.get("quantity", 0)) == 3, "named item and count become a queued errand")
+	check(not shion.has("shopping_ask"), "the item question is answered once")
+
+	# --- Item without a count goes through the existing quantity question.
+	pair = await new_game()
+	game = pair[0]
+	fake = pair[1]
+	shion = game.world.s.household_members[0]
+	npc(fake, "buy:food")
+	await game._on_command("詩音、食べ物が少ないから何か買ってきてくれない？")
+	check(str(shion.get("water_errand", {}).get("phase", "")) == "quantity" and game.log_entries[-1].contains("何個"), "item without count asks how many")
+	await game._on_command("2個お願い")
+	check(int(shion.get("water_errand", {}).get("quantity", 0)) == 2, "count answer completes the errand")
+
+	# --- Negated request: no action, one corrective retry answered as chat.
+	pair = await new_game()
+	game = pair[0]
+	fake = pair[1]
+	shion = game.world.s.household_members[0]
+	npc(fake, "sleep")
+	fake.queue.append(JSON.stringify({"kind":"chat", "value":"うん、まだ起きてるね。"}))
+	await game._on_command("詩音、まだ寝なくていいよ")
+	check(str(shion.activity) != "睡眠" and game.log_entries[-1].contains("まだ起きてる") and fake.requests == 2, "negated request is not executed and is answered as chat")
+	check(str(fake.payload.get("注意", "")).contains("頼んでいない"), "retry explains that it was not a request")
+
+	# --- Cooking and sleep through free wording.
+	npc(fake, "cook_for_player")
+	await game._on_command("お腹すいたな、何か作ってくれない？")
+	check(game.last_npc_reply_source.source == "ai_request" and game.last_npc_reply_source.reason == "cook_for_player", "free-worded cooking request runs the cooking action")
+
+	check(Requests.mentioned("news", "ちょっとニュース見て") and not Requests.mentioned("news", "それいいね、今度教えてよ") and Requests.mentioned("cook_for_player", "お腹すいた") and Requests.mentioned("lock_door", "戸締まりお願い"), "a task must be mentioned in the player's words")
+	npc(fake, "news")
+	fake.queue.append(JSON.stringify({"kind":"chat", "value":"うん、今度一緒にやろう。"}))
+	await game._on_command("それいいね、今度教えてよ")
+	check(game.last_npc_reply_source.source == "ai" and game.log_entries[-1].contains("今度一緒"), "an unrelated task from the classifier is ignored")
+
+	# --- Cooking from the living room walks to the kitchen first.
+	shion.location = "居間"
+	shion.activity = "在宅"
+	npc(fake, "cook_for_player")
+	await game._on_command("ご飯お願いしてもいい？")
+	check(not game.log_entries[-1].contains("台所に行かないと") and str(shion.location) == "台所", "cooking request walks to the kitchen and cooks: " + game.log_entries[-1])
+
+	# --- "行かなくていい" while an errand is open cancels it.
+	shion.water_errand = {"phase":"queued", "item":"bandage", "quantity":2, "due":540, "failure":"", "reported":false}
+	shion.location = "居間"
+	await game._on_command("今日は買い物行かなくていいからね")
+	check(not shion.has("water_errand") and game.log_entries[-1].contains("取り消し"), "negated shopping cancels the open errand")
+
+	# --- Today's schedule separates finished and upcoming steps (08:00 start).
+	var plan := Mind.plan_today(game.world, 0)
+	check(plan.contains("済んだこと: 7時ごろ起きた") and plan.contains("これから: 9時ごろ出かける"), "plan separates finished wake-up from upcoming outing: " + plan)
+
+	print("v149.18 NPC request checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
