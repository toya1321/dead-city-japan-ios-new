+static func looks_like_request(speech: String) -> bool:
+	var text := speech.strip_edges()
+	# Questions about plans or facts ("今夜は何しようか", "どうする？") are conversation.
+	if Memory._mentions(text, ["何し", "何する", "何を", "何時", "何が", "どう", "どこ", "いつ", "誰", "どれ"]):
+		return false
+	var ending := RegEx.new()
+	ending.compile("(?:て|で)(?:くれ|もら|ほし|ちょうだい|お願い|おいて|おいで|きて|来て)|(?:て|で)(?:ね|よ|な)?[。！!？?]*$|(?:た|だ)ら[？?。]*$|(?:しない|観ない|見ない|行かない|来ない|食べない|飲まない|作らない|寝ない|休まない|買わない|閉めない|開けない)[？?]|(?:しよう|観よう|見よう|寝よう|食べよう|出かけよう|作ろう|行こう|飲もう|帰ろう|休もう|遊ぼう|ましょう)(?:よ|か)?[。！!？?]*$|お願い|頼(?:む|め|んで)")
+	return ending.search(text) != null
+
+static func valid(value: String) -> bool:
+	if TASKS.has(value) or value == "buy":
+		return true
+	var parts := value.split(":")
+	if parts.size() in [2, 3] and parts[0] == "buy":
+		return parts[1] in ITEM_KEYS and (parts.size() == 2 or (parts[2].is_valid_int() and int(parts[2]) >= 1 and int(parts[2]) <= Errands.MAX_QUANTITY))
+	if parts.size() == 2 and parts[0] == "go":
+		return not destination(parts[1]).is_empty()
+	return false
+
+static func destination(place: String) -> String:
+	return Navigation.destination(place.strip_edges() + "へ行く")
+
+## True when the player's words cancel, refuse or only suppose the task.
+static func negated(speech: String) -> bool:
+	return Memory._mentions(speech, NEGATIONS)
+
+## Canonical phrase for a validated task. "buy" without an item returns "".
+static func canonical(value: String) -> String:
+	if TASKS.has(value):
+		return TASKS[value]
+	var parts := value.split(":")
+	if parts[0] == "buy" and parts.size() >= 2:
+		var label: String = Errands.LABELS[parts[1]]
+		if parts.size() == 3:
+			return "%sを%d%s買ってきて" % [label, int(parts[2]), Errands.unit(parts[1])]
+		return "%sを買ってきて" % label
+	if parts[0] == "go" and parts.size() == 2:
+		return "一緒に%sに行こう" % destination(parts[1])
+	return ""
+
+## After the NPC asked what to buy: the item (and count) the player named.
+static func shopping_answer(speech: String) -> String:
+	var text := speech.strip_edges()
+	for i in range(10):
+		text = text.replace("０１２３４５６７８９"[i], str(i))
+	var found := ""
+	for word in Errands.ITEMS:
+		if text.contains(word) and (found.is_empty() or word.length() > found.length()):
+			found = word
+	if found.is_empty():
+		return ""
+	var item: String = Errands.ITEMS[found]
+	var count := RegEx.new()
+	count.compile("(%s)\\s*(?:%s)" % [Errands.COUNT, Errands.UNITS])
+	var matched := count.search(text)
+	if matched != null:
+		var amount := Errands._number(matched.get_string(1))
+		if amount >= 1:
+			return "%sを%d%s買ってきて" % [Errands.LABELS[item], amount, Errands.unit(item)]
+	return "%sを買ってきて" % Errands.LABELS[item]
