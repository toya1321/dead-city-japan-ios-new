+## The NPC tells what the broadcast said instead of showing the raw report.
+static func _news_line(report: String) -> String:
+	var lines: Array[String] = []
+	for line in report.split("\n", false):
+		if not line.begins_with("情報源："):
+			lines.append(line)
+	var body := " ".join(lines).strip_edges()
+	if body.is_empty() or body.contains("確認できない") or body.contains("確認できなかった"):
+		return "見てみたけど、新しいニュースはなかったよ。" if not body.contains("途絶え") else "見ようとしたけど、途中で受信できなくなったよ。"
+	if body.contains("受信できない") or body.contains("ない。自宅で"):
+		return body
+	return "見てみたよ。" + body.left(140)
+
 static func _report(game, person: Dictionary, cmd: String) -> Dictionary:
 	var world = game.world
 	var place := str(person.location)
