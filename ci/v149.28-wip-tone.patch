+		g.local_model.generation_timeout_ms = 400000
+		var p: Dictionary = Survivors.person(g.world, "neighbor_0")
+		g.location = "住宅街"
+		g.survivor_partner = ""
+		print("== seed %s %s（%s・%d・%s・%s）信頼%d" % [sd, p.label, p.job, p.age, p.gender, p.voice, p.trust])
+		for line in g.log_entries.slice(-1): pass
+		await g._on_command("お隣さんに話しかける")
+		print("   > (話しかける) ", g.log_entries[-1])
+		for line in LINES:
