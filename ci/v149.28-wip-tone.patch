+## can arrive a few files at a time.
+##
+## Faces (assets/faces/, square jpg or png):
+## - job_<job>_<f|m>.jpg        a survivor's occupation (JOBS below)
+## - person_<f|m>_<age>.jpg     anyone by gender and age group (AGE_GROUPS);
+##   person_<f|m>_<age>_2.jpg … _4 are variants, picked by name
+## Items (assets/items/, square png, transparent or plain background):
+##   <id>.png for each id in ITEMS.
+
+const FACES := "res://assets/faces/"
+const ITEMS_DIR := "res://assets/items/"
+const JOBS := {
+	"警備員": "guard", "コンビニの店員": "clerk", "薬剤師": "pharmacist", "看護師": "nurse",
+	"会社員": "office", "高校生": "student", "小学生": "child", "小学校の先生": "teacher",
+	"元自衛官": "soldier", "主婦": "homemaker", "年金暮らし": "retiree", "大工": "carpenter",
+	"居酒屋の店主": "izakaya", "旅行者": "traveler",
+}
+## [id, upper bound of the age]
+const AGE_GROUPS := [["child", 12], ["teen", 19], ["young", 39], ["middle", 59], ["senior", 200]]
+const ITEMS := {
+	"food": "食料", "water": "水", "wood": "木材", "parts": "部品", "seeds": "種", "bandage": "包帯",
+	"planter": "プランター", "harvest": "収穫した野菜", "solar": "ソーラーパネル", "battery": "蓄電池",
+	"camera": "カメラ", "filter": "浄水器", "key": "玄関の鍵", "cash": "現金", "cigarettes": "タバコ",
+	"gas_cans": "カセットボンベ", "backpack": "リュック",
+}
+
+static var _cache := {}
+static var _mask: Shader
+
+static func age_group(age: int) -> String:
+	for group in AGE_GROUPS:
+		if age <= int(group[1]):
+			return str(group[0])
+	return "senior"
+
+static func _sex(gender: String) -> String:
+	return "m" if gender == "男性" else ("f" if gender == "女性" else "")
+
+static func _find(base: String) -> String:
+	for ext in [".jpg", ".png", ".webp"]:
+		if ResourceLoader.exists(base + ext):
+			return base + ext
+	return ""
+
+## The face file for a person, or "" if none has been made yet.
+static func face_path(name: String, gender: String, age: int, job: String = "") -> String:
+	var sex := _sex(gender)
+	if sex.is_empty():
+		return ""
+	if JOBS.has(job):
+		var path := _find(FACES + "job_%s_%s" % [JOBS[job], sex])
+		if not path.is_empty():
+			return path
+	var base := FACES + "person_%s_%s" % [sex, age_group(age)]
+	var variants: Array = []
+	for n in range(1, 5):
+		var path := _find(base if n == 1 else "%s_%d" % [base, n])
+		if not path.is_empty():
+			variants.append(path)
+	if variants.is_empty():
+		return ""
+	return str(variants[absi(hash(name)) % variants.size()])
+
+static func _texture(path: String) -> Texture2D:
+	if path.is_empty():
+		return null
+	if not _cache.has(path):
+		_cache[path] = load(path)
+	return _cache[path]
+
+## A housemate: their own age if they have one (people who joined from
+## outside), otherwise about the player's age.
+static func housemate_face(world, index: int) -> Texture2D:
+	var person: Dictionary = world.s.household_members[index]
+	var gender := str(person.get("gender", ""))
+	if gender.is_empty():
+		var genders: Array = world.s.profile.get("companion_genders", [])
+		gender = str(genders[index]) if index < genders.size() else ""
+	var age := int(person.get("age", int(world.s.profile.get("age", 30))))
+	return _texture(face_path(str(person.name), gender, age, str(person.get("job", ""))))
+
+static func survivor_face(person: Dictionary) -> Texture2D:
+	return _texture(face_path(str(person.get("name", "")), str(person.get("gender", "")), int(person.get("age", 30)), str(person.get("job", ""))))
+
+## The face of whoever has this name: a housemate or a survivor met outside.
+static func face_for_name(world, name: String) -> Texture2D:
+	for i in world.s.household_members.size():
+		if str(world.s.household_members[i].name) == name:
+			return housemate_face(world, i)
+	var people: Dictionary = world.s.get("survivors", {}).get("people", {}) if world.s.get("survivors") is Dictionary else {}
+	for id in people:
+		var p: Dictionary = people[id]
+		if str(p.get("name", "")) == name or str(p.get("label", "")) == name:
+			return survivor_face(p)
+	return null
+
+static func item(id: String) -> Texture2D:
+	return _texture(_find(ITEMS_DIR + id))
+
+## A round face, or the initial in a circle when there is no picture.
+static func avatar(texture: Texture2D, initial: String, size: int, fill: Color, text_color: Color) -> Control:
+	if texture == null:
+		var label := Label.new()
+		label.text = initial.left(1)
+		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
+		label.custom_minimum_size = Vector2(size, size)
+		label.add_theme_color_override("font_color", text_color)
+		label.add_theme_font_size_override("font_size", int(size * 0.46))
+		var box := StyleBoxFlat.new()
+		box.bg_color = fill
+		box.set_corner_radius_all(size / 2)
+		label.add_theme_stylebox_override("normal", box)
+		label.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+		return label
+	var rect := TextureRect.new()
+	rect.texture = texture
+	rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+	rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
+	rect.custom_minimum_size = Vector2(size, size)
+	rect.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	rect.material = _circle()
+	return rect
+
+static func _circle() -> ShaderMaterial:
+	if _mask == null:
+		_mask = Shader.new()
+		_mask.code = "shader_type canvas_item;\nvoid fragment() {\n\tvec4 c = texture(TEXTURE, UV);\n\tfloat d = distance(UV, vec2(0.5));\n\tc.a *= 1.0 - smoothstep(0.47, 0.5, d);\n\tCOLOR = c;\n}\n"
+	var m := ShaderMaterial.new()
+	m.shader = _mask
+	return m
+
+## A small square item picture, or nothing.
+static func item_icon(id: String, size: int) -> Control:
+	var texture := item(id)
+	if texture == null:
+		return null
+	var rect := TextureRect.new()
+	rect.texture = texture
+	rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+	rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
+	rect.custom_minimum_size = Vector2(size, size)
+	rect.size_flags_vertical = Control.SIZE_SHRINK_CENTER
+	return rect
