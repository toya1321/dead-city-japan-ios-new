new file mode 100644
index 0000000..7f7557b
--- /dev/null
+++ b/qa/shots149_28.gd
@@ -0,0 +1,52 @@
+extends SceneTree
+## Screenshots of faces and item pictures (v149.28).
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const OUT := "/tmp/claude-0/w/shots28/"
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func shot(g, name: String) -> void:
+	g._refresh()
+	for i in 8: await process_frame
+	var bar: VScrollBar = g.log_scroll.get_v_scroll_bar()
+	bar.value = bar.max_value
+	for i in 4: await process_frame
+	root.get_viewport().get_texture().get_image().save_png(OUT + name + ".png")
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.cohabitants = 1
+	p.companion_names = ["詩音"]
+	p.companion_genders = ["女性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	await g._on_command("詩音に話しかける")
+	await g._on_command("しりとりしよう")
+	await g._on_command("りんご")
+	await shot(g, "1_talk")
+	# Met survivors: a nurse and a guard.
+	var people: Dictionary = Survivors.ensure(g.world).people
+	var n := 0
+	for id in people:
+		var q: Dictionary = people[id]
+		if n == 0:
+			q.job = "看護師"; q.gender = "女性"
+		elif n == 1:
+			q.job = "警備員"; q.gender = "男性"
+		q.met = true
+		n += 1
+		if n >= 3: break
+	g._open_tool("people")
+	await shot(g, "2_people")
+	g.world.s.district.bag.food = 2.0
+	g.world.s.district.bag.water = 4.0
+	g._open_tool("inventory")
+	await shot(g, "3_items")
+	quit()
