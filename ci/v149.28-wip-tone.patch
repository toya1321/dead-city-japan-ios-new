+extends SceneTree
+## v149.28: everyone starts alone with only a name; a neighbour is there from
+## the first day; the shelter always has people to talk to.
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const News = preload("res://scripts/outbreak_news.gd")
+const PlayerIntents = preload("res://scripts/player_intents.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var title = g.title_screen
+	title.save_exists = false
+	title.name_input.text = ""
+	title._request_start()
+	var w = g.world
+	check(str(w.s.profile.name) == "トウヤ" and str(w.s.profile.address) == "東京" and w.s.household_members.is_empty(), "an empty name starts as トウヤ, alone, in Tokyo")
+	g._finish_intro()
+	g.local_model.enabled = false
+	# Every world has a neighbour, around from the first day.
+	var people: Dictionary = Survivors.ensure(w).people
+	check(people.has("neighbor_0") and bool(people.neighbor_0.always) and str(people.neighbor_0.place) == "住宅街", "a neighbour lives on the street")
+	var at_shelter: Array = people.keys().filter(func(k): return str(people[k].place) == "避難所")
+	check(at_shelter.size() >= 2, "the shelter has people to talk to")
+	check(Survivors.here(w, "住宅街").has("neighbor_0") and not Survivors.here(w, "住宅街").any(func(k): return k != "neighbor_0" and not bool(people[k].get("always", false))), "on ordinary days only the neighbour is out")
+	g.location = "屋外"
+	await g._on_command("住宅街へ行く")
+	check(str(g.log_entries.slice(-2)).contains("【出会い】") and str(g.log_entries.slice(-2)).contains(str(people.neighbor_0.label)), "met on the street")
+	await g._on_command("お隣さん、こんにちは")
+	check(g.survivor_partner == "neighbor_0" and not g.log_entries[-1].contains("大変だった"), "お隣さん addresses the neighbour; ordinary small talk")
+	check(Survivors.topic_reply(w, "neighbor_0", "よく眠れてる？").is_empty(), "no post-collapse topic lines on ordinary days")
+	await g._on_command("一緒に住みませんか")
+	check(g.log_entries[-1].contains("そこまでのことじゃない") and w.s.household_members.is_empty(), "no moving in together on ordinary days")
+	check(not PlayerIntents.negated("一緒に住みませんか") and PlayerIntents.negated("住まない"), "a polite invitation is not a refusal")
+	check(Survivors.instructions(w, "neighbor_0").contains("普段の暮らし"), "ordinary-day instructions for the model")
+	# Once the city comes apart, the neighbour can join.
+	w.s.society = "disrupted"
+	people.neighbor_0.trust = 90
+	people.neighbor_0.joinable = true
+	await g._on_command("一緒に住みませんか")
+	check(w.s.household_members.size() == 1 and str(w.s.household_members[0].name) == str(people.neighbor_0.name), "after the breakdown, a trusted neighbour moves in")
+	check(Survivors.instructions(w, "x") == Survivors.INSTRUCTIONS, "survival instructions after the breakdown")
+	# Ward radio without a ward.
+	check(News._radio_head(w) == "こちらは、区の防災担当です。" and News._town(w) == "都内の住宅街", "news reads naturally with just 東京")
+	check(w.validate_state(w.s) and g._save().begins_with("保存") and g._load() == "保存データを読み込んだ。", "save and load")
+	# Playtest fixes.
+	var g2 = Main.instantiate()
+	root.add_child(g2)
+	for i in 3: await process_frame
+	var prof: Dictionary = g2.world.DEFAULT_PROFILE.duplicate(true)
+	prof.address = "東京"
+	g2._start_new_game(prof)
+	g2._finish_intro()
+	g2.local_model.enabled = false
+	var w2 = g2.world
+	await g2._on_command("物資を持っていく")
+	await g2._on_command("玄関へ行く")
+	check(float(w2.s.district.bag.food) > 0.0, "packing and walking indoors keeps the bag packed")
+	await g2._on_command("外に出る")
+	await g2._on_command("家に帰る")
+	check(float(w2.s.district.bag.food) == 0.0 and g2.log_entries[-1].contains("台所の備蓄にしまった"), "coming home puts the bag away")
+	w2.s.hunger = 60.0
+	g2.location = "寝室"
+	await g2._on_command("寝る")
+	check(str(g2.log_entries.slice(-4)).contains("寝る前に食事"), "eats before sleeping when hungry")
+	check(g2._routine_news("学校の授業。通学と授業が行われている。") and not g2._routine_news("都内の救急病院が、相次いで受け入れを停止。"), "routine life is not news")
+	w2.s.society = "disrupted"
+	w2.s.walkers.places["屋外"] = 1
+	g2.location = "住宅街"
+	await g2._on_command("家に帰る")
+	check(not str(g2.log_entries.slice(-3)).contains("玄関の鍵を閉めた"), "the door is not said to be locked when the walk stopped short")
+	check(load("res://scripts/shelter.gd").board(w) != "" , "board text exists")
+	var w3_people: Dictionary = Survivors.ensure(w2).people
+	var nb: Dictionary = w3_people.neighbor_0
+	nb.met = false
+	check(Survivors._intro_now(w2, nb).contains("外の様子をうかがっていた"), "a first meeting after the breakdown is not a casual hello")
+	w2.s.society = "normal"
+	w2.s.minute = 13 * 60
+	check(not Survivors._intro_now(w2, nb).contains("おはよう"), "no good-morning in the evening")
+	print("v149.28 solo checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
