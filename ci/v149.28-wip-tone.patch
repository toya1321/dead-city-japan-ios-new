new file mode 100644
index 0000000..335a0a1
--- /dev/null
+++ b/qa/shots_room.gd
@@ -0,0 +1,25 @@
+extends SceneTree
+## Photos of one room at each stage. DCJ_ROOM=寝室
+const Main = preload("res://main.tscn")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	g._start_new_game(g.world.DEFAULT_PROFILE.duplicate(true))
+	g._finish_intro()
+	g.local_model.enabled = false
+	g.location = OS.get_environment("DCJ_ROOM") if OS.get_environment("DCJ_ROOM") != "" else "寝室"
+	var n := 0
+	for spec in [["normal", 0, 0, true], ["alert", 50, 2, true], ["emergency", 900, 20, false], ["emergency", 900, 400, false]]:
+		g.world.s.society = spec[0]
+		g.world.s.regional_cases = spec[1]
+		g.world.s.minute = int(spec[2]) * 1440 + 120
+		g.world.s.grid_online = spec[3]
