diff --git a/tests/test_ui149_21.gd b/tests/test_ui149_21.gd
new file mode 100644
index 0000000..837f962
--- /dev/null
+++ b/tests/test_ui149_21.gd
@@ -0,0 +1,146 @@
+extends SceneTree
+## v149.21 UI: header, typed chronicle entries, conversation strip, context
+## suggestions, foldable picture, menu tabs with a map, settings, and the door
+## being unlocked on the way out.
+const Main = preload("res://main.tscn")
+const UI = preload("res://scripts/ui_kit.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func settle() -> void:
+	for i in 4:
+		await process_frame
+
+func chip_texts(game) -> Array:
+	var out: Array = []
+	for child in game.chips_row.get_children():
+		if not child.is_queued_for_deletion():
+			out.append(child.text)
+	return out
+
+func run() -> void:
+	# --- Classification of chronicle lines.
+	var names := ["詩音"]
+	check(UI.kind("▶ 外に出る", names).kind == "player", "player line")
+	check(UI.kind("詩音「おはよう。」", names).kind == "npc" and UI.kind("詩音「おはよう。」", names).text == "おはよう。", "NPC line with its name")
+	check(UI.kind("誰か「こんにちは」", names).kind == "text", "unknown speakers are narration")
+	check(UI.kind("この部分を正確に解釈できませんでした：「x」。何も実行していません。", names).kind == "fail", "failed input")
+	check(UI.kind("情報源：テレビ\n新しい報道は確認できない。", names).kind == "news", "news report")
+	check(UI.is_note("居間へ移動した（1分 / 寝室 → 居間）。") and UI.is_note("ここからは寝室、台所の方へ向かえる。") and not UI.is_note("ソファと低いテーブルがある。"), "movement summaries and hints are notes")
+
+	root.size = Vector2i(390, 844)
+	var game = Main.instantiate()
+	root.add_child(game)
+	await settle()
+	var profile: Dictionary = game.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = 1
+	profile.companion_names = ["詩音"]
+	game._start_new_game(profile)
+	game._finish_intro()
+	game.local_model.enabled = false
+	await settle()
+
+	# --- Header.
+	check(game.day_label.text == "1日目" and game.clock_label.text == game.world.clock().right(5) and game.place_label.text == "寝室", "header shows day, time and place")
+	check(game.subline_label.text.contains("11月10日") and game.danger_label.text == "街：平常", "header shows date, weather and the city's stage")
+	check(game.vitals_row.is_visible_in_tree() and game.vitals_values["体力"].text.begins_with("体力"), "vitals are always on screen")
+
+	# --- Chronicle entries are styled by kind.
+	await game._on_command("居間へ行く")
+	var count: int = game.log_box.get_child_count()
+	check(count == game.log_entries.size(), "one control per chronicle entry")
+	var player_row = game.log_box.get_child(count - 2)
+	check(player_row is HBoxContainer and player_row.get_child(0).size_flags_horizontal == Control.SIZE_EXPAND_FILL, "the player's line is a right-aligned bubble")
+	await game._on_command("詩音、おはよう")
+	var npc_entry = game.log_box.get_child(game.log_box.get_child_count() - 1)
+	check(npc_entry is VBoxContainer and npc_entry.get_child(0).text == "詩音", "the NPC's line carries its name")
+	await settle()
+	var bar: VScrollBar = game.log_scroll.get_v_scroll_bar()
+	check(bar.value + bar.page >= bar.max_value - 1, "the newest entry is visible")
+
+	# --- Conversation strip and suggestions.
+	check(game.convo_bar.visible and game.convo_label.text == "詩音と会話中", "the conversation strip names the partner")
+	check("会話を終える" in chip_texts(game), "talking offers a way out among the suggestions")
+	game.world.s.household_members[0].shopping_ask = true
+	game._refresh_suggestions()
+	check("水を3本" in chip_texts(game), "suggestions answer the NPC's question")
+	game.world.s.household_members[0].erase("shopping_ask")
+	game.convo_end_button.pressed.emit()
+	await settle()
+	check(game.dialogue.partner == -1 and not game.convo_bar.visible, "the strip's button ends the conversation")
+	var texts := chip_texts(game)
+	check("詩音に話しかける" in texts and "寝室へ行く" in texts, "suggestions list people and places nearby: " + str(texts))
+	var before: String = game.location
+	for child in game.chips_row.get_children():
+		if child.text == "寝室へ行く":
+			child.pressed.emit()
+	await settle()
+	check(game.location == "寝室" and before == "居間", "a suggestion runs like typed text")
+
+	# --- Failed input is a card that says nothing happened.
+	var minute: int = game.world.s.minute
+	await game._on_command("包丁を持って外に出る")
+	var card = game.log_box.get_child(game.log_box.get_child_count() - 1)
+	check(card is PanelContainer and game.world.s.minute == minute, "unrecognised input becomes a card and time does not pass")
+
+	# --- Picture folds into a one-line bar.
+	game._set_photo_folded(true)
+	await settle()
+	check(not game.picture.is_visible_in_tree() and game.scene_folded_bar.visible and game.log_scroll.size.y > 300, "folding the picture gives the log more room")
+	game.scene_folded_bar.pressed.emit()
+	await settle()
+	check(game.picture.is_visible_in_tree() and game.picture.size.y >= 135, "the folded bar shows the picture again")
+
+	# --- Going out unlocks the door on the way.
+	check(bool(game.world.s.door_locked), "the door starts locked")
+	await game._on_command("外に出る")
+	check(game.location == "屋外" and not bool(game.world.s.door_locked) and game.log_entries[-1].contains("自動で行った手順：玄関の鍵を開けた"), "going out unlocks the door and says so")
+
+	# --- Menu tabs and map.
+	game._open_tool("menu")
+	await settle()
+	check(game.drawer.visible and game.current_tab == "status" and game.tab_content.get_child_count() >= 3, "the menu opens on the status tab")
+	game._show_tab("map")
+	await settle()
+	var area = game.tab_content.get_child(0)
+	var names_on_map: Array = []
+	for child in area.get_children():
+		if child is Button:
+			names_on_map.append(child.text.get_slice("\n", 0))
+	check("コンビニ" in names_on_map and "家の前の通り" in names_on_map and "自宅" in names_on_map, "the map draws the places")
+	for child in area.get_children():
+		if child is Button and child.text.begins_with("コンビニ"):
+			child.pressed.emit()
+	await settle()
+	check(game.map_selected == "コンビニ", "tapping a place selects it")
+	var detail = game.tab_content.get_child(1)
+	var go: Button = null
+	for node in detail.find_children("*", "Button", true, false):
+		go = node
+	check(go != null and go.text == "ここへ行く", "the selected place offers to go there")
+	go.pressed.emit()
+	await settle()
+	await settle()
+	check(not game.drawer.visible and game.location == "コンビニ", "going from the map walks there")
+
+	# --- Settings: text size rebuilds the chronicle and is remembered.
+	game._open_tool("settings")
+	await settle()
+	game._set_log_font(19)
+	await settle()
+	var config := ConfigFile.new()
+	check(config.load(game.UI_SETTINGS_PATH) == OK and int(config.get_value("ui", "font_size", 0)) == 19 and game.log_box.get_child_count() == game.log_entries.size(), "text size is saved and the chronicle is rebuilt")
+	check(not game.dev_box.get_parent().visible, "developer settings are hidden by default")
+	game._set_log_font(17)
+	game._close_drawer()
+
+	print("v149.21 UI checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
