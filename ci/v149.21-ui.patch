diff --git a/scripts/ui_kit.gd b/scripts/ui_kit.gd
new file mode 100644
index 0000000..a2b3e56
--- /dev/null
+++ b/scripts/ui_kit.gd
@@ -0,0 +1,151 @@
+extends RefCounted
+## v149.21 UI: shared colours, cards and the typed chronicle entries
+## (player bubble, NPC bubble, narration, notes, notices, failed input).
+
+const BG := Color("#080e15")
+const HEADER := Color("#0c1520")
+const PANEL := Color("#0f1924")
+const PANEL_2 := Color("#13212f")
+const LINE := Color("#1d2f42")
+const EDGE := Color("#2a4258")
+const TEXT := Color("#e6edf3")
+const BODY := Color("#d7e0e8")
+const MUTED := Color("#9fb0c0")
+const FAINT := Color("#8597a8")
+const ACCENT := Color("#9fd0e6")
+const PLAYER := Color("#244357")
+const NPC := Color("#142231")
+const WARN_BG := Color("#2a1a10")
+const WARN_EDGE := Color("#7a4a2a")
+const WARN_TEXT := Color("#ffcfa8")
+const OK_BG := Color("#13281f")
+const OK_EDGE := Color("#2d5a42")
+const OK_TEXT := Color("#9fe3b9")
+const VITAL_COLORS := {"体力": Color("#7fd1a1"), "満腹度": Color("#ffb27a"), "水分状態": Color("#7cc0de"), "休息状態": Color("#b9a7f0")}
+const VITAL_SHORT := {"体力": "体力", "満腹度": "満腹", "水分状態": "水分", "休息状態": "休息"}
+const SOCIETY := {"normal": ["平常", 0], "alert": ["警戒", 1], "disrupted": ["混乱", 2], "emergency": ["緊急", 3]}
+const NOTICE_WORDS := ["危険", "警告", "防災", "死亡", "負傷", "襲", "噛", "避難", "緊急事態", "外出自粛", "通行止め"]
+const FAIL_WORDS := ["何も実行していません", "解釈できませんでした", "解釈できません"]
+
+static func box(bg: Color, edge: Color = Color(0, 0, 0, 0), radius: int = 12, pad_x: int = 12, pad_y: int = 10) -> StyleBoxFlat:
+	var st := StyleBoxFlat.new()
+	st.bg_color = bg
+	st.border_color = edge
+	st.set_border_width_all(1 if edge.a > 0.0 else 0)
+	st.set_corner_radius_all(radius)
+	st.content_margin_left = pad_x
+	st.content_margin_right = pad_x
+	st.content_margin_top = pad_y
+	st.content_margin_bottom = pad_y
+	return st
+
+static func label(text: String, size: int = 15, color: Color = TEXT, wrap: bool = true) -> Label:
+	var l := Label.new()
+	l.text = text
+	l.add_theme_font_size_override("font_size", size)
+	l.add_theme_color_override("font_color", color)
+	if wrap:
+		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	return l
+
+static func card(parent: Node, title: String = "", bg: Color = PANEL, edge: Color = LINE) -> VBoxContainer:
+	var panel := PanelContainer.new()
+	panel.add_theme_stylebox_override("panel", box(bg, edge, 12, 14, 12))
+	parent.add_child(panel)
+	var body := VBoxContainer.new()
+	body.add_theme_constant_override("separation", 8)
+	panel.add_child(body)
+	if not title.is_empty():
+		body.add_child(label(title, 14, MUTED))
+	return body
+
+static func button(text: String, primary: bool = false, height: int = 44, size: int = 15) -> Button:
+	var b := Button.new()
+	b.text = text
+	b.custom_minimum_size.y = height
+	b.add_theme_font_size_override("font_size", size)
+	var bg := Color("#2d5a74") if primary else PANEL_2
+	var edge := Color("#5b8aa5") if primary else EDGE
+	b.add_theme_stylebox_override("normal", box(bg, edge, 10, 12, 6))
+	b.add_theme_stylebox_override("hover", box(bg.lightened(0.08), edge.lightened(0.15), 10, 12, 6))
+	b.add_theme_stylebox_override("pressed", box(bg.lightened(0.15), edge.lightened(0.25), 10, 12, 6))
+	b.add_theme_stylebox_override("disabled", box(bg.darkened(0.3), LINE, 10, 12, 6))
+	b.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
+	b.add_theme_color_override("font_color", TEXT)
+	return b
+
+static func chip(text: String, color: Color = TEXT, bg: Color = PANEL_2, edge: Color = Color("#2f4b62")) -> Button:
+	var b := Button.new()
+	b.text = text
+	b.custom_minimum_size.y = 38
+	b.add_theme_font_size_override("font_size", 14)
+	b.add_theme_stylebox_override("normal", box(bg, edge, 19, 14, 4))
+	b.add_theme_stylebox_override("hover", box(bg.lightened(0.08), edge.lightened(0.2), 19, 14, 4))
+	b.add_theme_stylebox_override("pressed", box(bg.lightened(0.15), edge.lightened(0.3), 19, 14, 4))
+	b.add_theme_stylebox_override("focus", StyleBoxEmpty.new())
+	b.add_theme_color_override("font_color", color)
+	return b
+
+static func tag(text: String, good: bool) -> Label:
+	var l := label(text, 12, OK_TEXT if good else WARN_TEXT, false)
+	var st := box(OK_BG if good else WARN_BG, OK_EDGE if good else WARN_EDGE, 11, 10, 3)
+	l.add_theme_stylebox_override("normal", st)
+	return l
+
+static func bar(value: float, color: Color, height: int = 6) -> ProgressBar:
+	var b := ProgressBar.new()
+	b.show_percentage = false
+	b.custom_minimum_size.y = height
+	b.max_value = 100
+	b.step = 0.0
+	b.value = value
+	var back := StyleBoxFlat.new()
+	back.bg_color = LINE
+	back.set_corner_radius_all(3)
+	var fill := StyleBoxFlat.new()
+	fill.bg_color = color
+	fill.set_corner_radius_all(3)
+	b.add_theme_stylebox_override("background", back)
+	b.add_theme_stylebox_override("fill", fill)
+	return b
+
+## Kind of a chronicle line: player, npc, fail, notice, news, or text.
+static func kind(entry: String, names: Array) -> Dictionary:
+	if entry.begins_with("▶ "):
+		return {"kind": "player", "text": entry.substr(2)}
+	var said := RegEx.new()
+	said.compile("^([^「」\\n]{1,12})「([\\s\\S]*)」$")
+	var found := said.search(entry)
+	if found != null and found.get_string(1) in names:
+		return {"kind": "npc", "name": found.get_string(1), "text": found.get_string(2)}
+	for word in FAIL_WORDS:
+		if entry.contains(word):
+			return {"kind": "fail", "text": entry}
+	if entry.begins_with("情報源："):
+		return {"kind": "news", "text": entry}
+	for word in NOTICE_WORDS:
+		if entry.contains(word) and entry.length() <= 160:
+			return {"kind": "notice", "text": entry}
+	return {"kind": "text", "text": entry}
+
+## Movement summaries, waiting reports and how-to hints are secondary notes.
+static func is_note(line: String) -> bool:
+	var move := RegEx.new()
+	move.compile("^.+へ移動した（[0-9]+分")
+	if move.search(line) != null:
+		return true
+	for start in ["ここからは", "日常生活：", "自動で行った手順", "会話を終えた", "保存", "（"]:
+		if line.begins_with(start):
+			return true
+	var waited := RegEx.new()
+	waited.compile("^[0-9]+分が経過した")
+	if waited.search(line) != null:
+		return true
+	return line.contains("」と入力") or line.contains("」と入れる") or (line.begins_with("「") and (line.contains("できる") or line.contains("られる")))
+
+## Width a bubble needs for its text, capped so it wraps inside the log.
+static func bubble_width(text: String, font: Font, size: int, max_width: float) -> float:
+	var widest := 0.0
+	for line in text.split("\n"):
+		widest = maxf(widest, font.get_string_size(line, HORIZONTAL_ALIGNMENT_LEFT, -1, size).x)
+	return clampf(widest + 26.0, 48.0, max_width)
