+extends SceneTree
+## Screenshot of the action photo card (DCJ_OUT=dir, DCJ_SIZE=WxH, DCJ_FONT=15..19, DCJ_CMD).
+const Main = preload("res://main.tscn")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var dims := OS.get_environment("DCJ_SIZE").split("x")
+	root.size = Vector2i(int(dims[0]), int(dims[1]))
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	if OS.get_environment("DCJ_FONT") != "":
+		g.ui_font_size = int(OS.get_environment("DCJ_FONT"))
+		g._rebuild_log()
+	g.world.s.hunger = 70.0
+	g.world.s.cigarettes = 5
+	var cmd := OS.get_environment("DCJ_CMD")
+	await g._on_command(cmd if cmd != "" else "食事する")
+	while g.advancing: await process_frame
+	for i in 20: await process_frame
+	root.get_texture().get_image().save_png(OS.get_environment("DCJ_OUT"))
+	await create_timer(3.5).timeout
+	root.get_texture().get_image().save_png(OS.get_environment("DCJ_OUT").replace(".png", "_after.png"))
+	quit()
