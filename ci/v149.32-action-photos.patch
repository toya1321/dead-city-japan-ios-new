+## v149.32: a photo of what you just did, shown for a moment over the screen.
+func _action_card_for(line: String) -> void:
+	if not is_inside_tree() or world == null:
+		return
+	var hit: Dictionary = ActionPhotos.detect(line)
+	if hit.is_empty():
+		return
+	var path: String = ActionPhotos.path(world, str(hit.kind))
+	if path.is_empty():
+		return
+	_show_action_card(load(path), str(hit.caption))
+
+func _show_action_card(texture: Texture2D, caption: String) -> void:
+	if action_card == null:
+		action_card = PanelContainer.new()
+		action_card.add_theme_stylebox_override("panel", UI.box(UI.PANEL, UI.LINE, 16, 10, 10))
+		action_card.mouse_filter = Control.MOUSE_FILTER_STOP
+		action_card.gui_input.connect(func(event):
+			if (event is InputEventMouseButton or event is InputEventScreenTouch) and event.pressed:
+				_hide_action_card())
+		var column := VBoxContainer.new()
+		column.add_theme_constant_override("separation", 8)
+		column.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		action_card.add_child(column)
+		var photo := TextureRect.new()
+		photo.name = "Photo"
+		photo.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+		photo.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
+		photo.clip_contents = true
+		photo.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		column.add_child(photo)
+		var label := Label.new()
+		label.name = "Caption"
+		label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+		label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		label.add_theme_color_override("font_color", UI.BODY)
+		label.mouse_filter = Control.MOUSE_FILTER_IGNORE
+		column.add_child(label)
+		add_child(action_card)
+	var width: float = minf(360.0, size.x - 32.0)
+	var photo_rect: TextureRect = action_card.get_child(0).get_child(0)
+	var caption_label: Label = action_card.get_child(0).get_child(1)
+	photo_rect.texture = texture
+	photo_rect.custom_minimum_size = Vector2(width - 20.0, (width - 20.0) * 0.75)
+	caption_label.text = caption
+	caption_label.add_theme_font_size_override("font_size", ui_font_size)
+	caption_label.custom_minimum_size = Vector2(width - 20.0, 0)
+	action_card.size = Vector2(width, 0)
+	action_card.reset_size()
+	action_card.call_deferred("reset_size")
+	action_card.position = Vector2((size.x - width) / 2.0, size.y * 0.18)
+	action_card.visible = true
+	move_child(action_card, get_child_count() - 1)
+	if action_tween != null and action_tween.is_valid():
+		action_tween.kill()
+	action_card.modulate.a = 0.0
+	action_tween = create_tween()
+	action_tween.tween_property(action_card, "modulate:a", 1.0, 0.25)
+	action_tween.tween_interval(2.5)
+	action_tween.tween_property(action_card, "modulate:a", 0.0, 0.4)
+	action_tween.tween_callback(func(): action_card.visible = false)
+
+func _hide_action_card() -> void:
+	if action_card == null:
+		return
+	if action_tween != null and action_tween.is_valid():
+		action_tween.kill()
+	action_card.visible = false
+
 func _rebuild_log() -> void:
 	if log_box == null:
 		return
