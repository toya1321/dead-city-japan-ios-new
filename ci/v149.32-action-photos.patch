+extends SceneTree
+## v149.32: every action with a photo, played through the game: the card
+## appears with the right kind.
+const Main = preload("res://main.tscn")
+const Survivors = preload("res://scripts/survivors.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const Shelter = preload("res://scripts/shelter.gd")
+
+var failures := 0
+var verbose := OS.get_environment("DCJ_VERBOSE") == "1"
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func fresh(mates: int):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 31
+	p.cohabitants = mates
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	if mates == 0:
+		g.world.s.household_members = []
+	return g
+
+func play(g, place: String, cmd: String, kind: String) -> void:
+	g.action_card_kind = ""
+	g._hide_action_card()
+	g.location = place
+	g._sync_player_position()
+	await g._on_command(cmd)
+	while g.advancing:
+		await process_frame
+	var ok: bool = g.action_card_kind == kind and g.action_card.visible
+	if verbose or not ok:
+		print("   ", cmd, " → [", g.action_card_kind, "] ", str(g.log_entries.slice(-2)).left(260))
+	check(ok, "%s shows %s" % [cmd, kind])
+
+func run() -> void:
+	var g = await fresh(0)
+	var w = g.world
+	w.s.hunger = 70.0
+	await play(g, "台所", "食事する", "eat")
+	w.s.hunger = 70.0
+	await play(g, "台所", "温かい料理を作って食べる", "cook")
+	w.s.cigarettes = 10
+	await play(g, "居間", "タバコを吸う", "smoke")
+	w.s.thirst = 60.0
+	await play(g, "台所", "水を飲む", "drink")
+	await play(g, "寝室", "寝る", "sleep")
+	w.s.inventory.bandage = 2
+	w.s.injuries = 2
+	await play(g, "居間", "傷を手当てする", "bandage")
+	w.s.inventory.wood = 10
+	w.s.inventory.parts = 10
+	await play(g, "玄関", "玄関を補強する", "barricade")
+	w.s.gas_cans = 3.0
+	w.s.grid_online = false
+	w.s.battery = 0.0
+	await play(g, "居間", "ストーブをつける", "heater")
+	w.s.grid_online = true
+	w.s.plots = [{"growth": 0.2, "water": 0.0}]
+	w.s.rain_water = 5.0
+	await play(g, "台所", "水やり", "water_plants")
+	await play(g, "寝室", "窓から外を見る", "window")
+	await play(g, "居間", "ニュースを見る", "news")
+	await play(g, "居間", "本を読む", "read")
+	await play(g, "居間", "映画を観る", "movie")
+	await play(g, "台所", "浴槽に水をためる", "fill_bath")
+	await play(g, "台所", "浴槽の水を飲み水にする", "purify")
+	w.s.inventory.seeds = 5
+	w.s.inventory.planter = 2
+	await play(g, "台所", "種を植える", "plant")
+	w.s.plots[0].growth = 1.0
+	await play(g, "台所", "収穫", "harvest")
+	await play(g, "居間", "窓をふさぐ", "blackout")
+	w.s.door_locked = false
+	await play(g, "玄関", "鍵を閉める", "lock")
+	w.s.food = 10.0
+	w.s.water = 10.0
+	await play(g, "玄関", "物資を持っていく", "pack")
+	await play(g, "居間", "息をひそめる", "hide")
+	w.s.society = "emergency"
+	w.s.walkers.places["建物前"] = 3
+	await play(g, "居間", "窓から物を投げて気をそらす", "distract")
+	w.s.walkers.places["建物前"] = 0
+	# Outside: scavenging, giving, and the shelter.
+	w.s.district.sites["近所の空き家"].vacant = true
+	await play(g, "近所の空き家", "物資を探索する", "scavenge")
+	var sid := ""
+	for id in Survivors.ensure(w).people:
+		if not bool(Survivors.ensure(w).people[id].get("neighbor", false)) and str(Survivors.ensure(w).people[id].place) != "避難所":
+			sid = id
+			break
+	if not sid.is_empty():
+		var sp: Dictionary = Survivors.person(w, sid)
+		g.location = str(sp.place)
+		g.survivor_partner = sid
+		w.s.district.bag.water = 4.0
+		await play(g, str(sp.place), "水を渡す", "give")
+		g.survivor_partner = ""
+	w.s.society = "alert"
+	Shelter.state(w).status = "open"
+	Shelter.state(w).stock = 200.0
+	await play(g, "避難所", "配給を受け取る", "ration")
+	await play(g, "避難所", "見張りを手伝う", "watch")
+	g.queue_free()
+	# A housemate: comfort, care, farewell.
+	g = await fresh(1)
+	w = g.world
+	var mate: Dictionary = w.s.household_members[0]
+	mate.location = "居間"
+	mate.activity = "在宅"
+	await play(g, "居間", "%sの話を聞く" % mate.name, "comfort")
+	mate.bitten = true
+	await play(g, "居間", "%sを看病する" % mate.name, "care")
+	await play(g, "居間", "%sを見送る" % mate.name, "farewell")
+	print("v149.32 action play checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
