+extends SceneTree
+## v149.32: a photo card after eating, smoking, sleeping and the like.
+const Main = preload("res://main.tscn")
+const ActionPhotos = preload("res://scripts/action_photos.gd")
+var failures := 0
+func _initialize() -> void:
+	call_deferred("run")
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+func run() -> void:
+	var cases := {"しっかり食事を取った。": "eat", "軽くつまんだ。まだあまり": "eat", "480分眠った。目が覚めると": "sleep",
+		"（寝る前に食事をした）\n480分眠った。": "sleep", "水を飲んだ。": "drink", "居間でタバコに火をつけ": "", "タバコに火をつけ、ゆっくり": "smoke", "換気扇の下でタバコに火をつけ、": "smoke",
+		"傷を手当てした。": "bandage", "玄関を補強した（60分）。": "barricade", "カセットガスストーブに火をつけた。": "heater",
+		"最初の鉢に水1Lを与えた。": "water_plants", "通りを観察した。天候：晴れ。": "window", "情報源：テレビ\n": "news",
+		"詩音が水を飲んだ。": "", "【記録】あなたは眠った": "", "日常生活：食事2回": ""}
+	for line in cases:
+		check(str(ActionPhotos.detect(line).get("kind", "")) == cases[line], "detect %s → %s" % [line.get_slice("\n", 0), cases[line]])
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = 5
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.household_members = []
+	check(ActionPhotos.path(w, "eat").ends_with("act_eat.jpg"), "an ordinary meal")
+	w.s.society = "emergency"
+	check(ActionPhotos.path(w, "eat").ends_with("act_eat_crisis.jpg"), "a meal after the breakdown")
+	w.s.society = "normal"
+	check(ActionPhotos.path(w, "nothing_here").is_empty(), "no picture, no card")
+	w.s.hunger = 70.0
+	g.location = "台所"
+	await g._on_command("食事する")
+	check(g.action_card != null and g.action_card.visible, "eating shows the card")
+	g._hide_action_card()
+	check(not g.action_card.visible, "a tap hides it")
+	print("v149.32 action photo checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
