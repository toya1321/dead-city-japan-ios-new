diff --git a/qa/card_scan.gd b/qa/card_scan.gd
new file mode 100644
index 0000000..75c0ec3
--- /dev/null
+++ b/qa/card_scan.gd
@@ -0,0 +1,30 @@
+extends SceneTree
+## Feeds every line a long run writes through ActionPhotos.detect and prints the
+## ones that would show a card, to spot false matches.
+const Main = preload("res://main.tscn")
+const ActionPhotos = preload("res://scripts/action_photos.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var seen := {}
+	for sd in [3, 4]:
+		var g = Main.instantiate()
+		root.add_child(g)
+		for i in 3: await process_frame
+		var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+		p.seed = sd
+		p.cohabitants = 2
+		g._start_new_game(p)
+		g._finish_intro()
+		g.local_model.enabled = false
+		for cmd in ["窓から外を見る", "ニュースを見る", "同居人1と話す", "今日はどうする？", "食事する", "寝る", "外に出る", "商店通りへ行く", "コンビニへ行く", "家に帰る", "24時間待つ", "24時間待つ", "24時間待つ", "寝る", "同居人2の様子を見る", "48時間待つ"]:
+			await g._on_command(cmd)
+			while g.advancing: await process_frame
+		for line in g.log_entries:
+			var hit: Dictionary = ActionPhotos.detect(line)
+			if not hit.is_empty():
+				var key := "%s | %s" % [hit.kind, line.get_slice("\n", 0).left(60)]
+				seen[key] = true
+		g.queue_free()
+	for k in seen: print(k)
+	quit()
diff --git a/scripts/action_photos.gd b/scripts/action_photos.gd
new file mode 100644
index 0000000..d93f385
--- /dev/null
+++ b/scripts/action_photos.gd
@@ -0,0 +1,87 @@
+extends RefCounted
+## v149.32: a small card with a photo of what you just did (eating, smoking,
+## sleeping...). Pictures live in assets/actions/act_<kind>.jpg; after the
+## breakdown act_<kind>_crisis.jpg is used when it exists, and a meal with
+## housemates uses act_eat_together.jpg. A kind with no picture shows nothing.
+
+const DIR := "res://assets/actions/"
+
+## [kind, pattern the player's result line starts with, caption]
+const KINDS := [
+	["eat", "^(しっかり)?食事を取った", "食事をした。"],
+	["eat", "^軽くつまんだ", "少しだけ口にした。"],
+	["cook", "^台所で、.*温かい食事を作って食べた", "温かい食事を作った。"],
+	["smoke", "^(換気扇の下で)?タバコに火をつけ", "一服した。"],
+	["drink", "^水を飲んだ", "水を飲んだ。"],
+	["bandage", "^傷を手当てした", "傷に包帯を巻いた。"],
+	["barricade", "^玄関を補強した", "玄関に板を打ちつけた。"],
+	["heater", "^カセットガスストーブに火をつけた", "ストーブに手をかざした。"],
+	["water_plants", "^最初の鉢に水", "プランターに水をやった。"],
+	["window", "^通りを観察した", "カーテンの隙間から外を見た。"],
+	["news", "^情報源：", "画面に目を落とした。"],
+	["scavenge", "^(残っていた物資を回収した|荒らされた棚の奥から)", "棚の奥を探った。"],
+	["hide", "^(物陰に身を潜めて息を殺した|明かりを消し、(床に身を伏せて息をひそめた|物音を立てないようにじっとしていた))", "息をひそめた。"],
+	["distract", "^(二階の窓をそっと開け、空き瓶|足元の石を拾い)", "物を投げて、気をそらした。"],
+	["comfort", "^[^【「（\\n]{1,12}(の隣に座|の話を、急かさずに聞いた|とゆっくり話した)", "そばにいた。"],
+	["care", "^[^【「（\\n]{1,12}(の額を冷やし|を[^、]{1,6}に移し、扉を閉めた)", "看病した。"],
+	["farewell", "^[^【「（\\n]{1,12}は小さな荷物を背負って", "見送った。"],
+	["read", "^棚から本を一冊取って読んだ", "本を読んだ。"],
+	["movie", "^(一人で|電気が来ないので、スマホに保存してあった)『", "映画を観た。"],
+	["fill_bath", "^浴槽に水をためた", "浴槽に水をためた。"],
+	["purify", "^(雨水1Lを処理し|浴槽から水を汲んで)", "水をきれいにした。"],
+	["plant", "^植え付けた", "種をまいた。"],
+	["harvest", "^収穫した", "収穫した。"],
+	["blackout", "^家じゅうの窓を、毛布と段ボールでふさいで", "窓をふさいだ。"],
+	["lock", "^玄関を閉めて施錠した", "鍵を閉めた。"],
+	["pack", "^(自宅から持ち出した|拠点の備蓄から持ち出した)", "荷物を詰めた。"],
+	["give", "^[^【「（\\n]{1,20}を渡した。", "手渡した。"],
+	["ration", "^体育館の長い列に1時間並び、配給を受け取った", "配給を受け取った。"],
+	["watch", "^4時間、校門と受付の見張りに立った", "見張りに立った。"],
+]
+
+static var _compiled: Array = []
+
+## The kind of action a log line reports, or {}. Only the player's own result
+## lines count: they start with the action text ("480分眠った" starts with the
+## minutes, or with the meal eaten before bed).
+static func detect(line: String) -> Dictionary:
+	var text := line
+	if text.begins_with("（寝る前に"):
+		text = text.get_slice("\n", 1)
+	var digits := 0
+	while digits < text.length() and text[digits] in "0123456789":
+		digits += 1
+	if digits > 0 and text.substr(digits).begins_with("分眠った"):
+		return {"kind": "sleep", "caption": "眠りについた。"}
+	if _compiled.is_empty():
+		for row in KINDS:
+			var re := RegEx.new()
+			re.compile(str(row[1]))
+			_compiled.append(re)
+	for i in KINDS.size():
+		if _compiled[i].search(line) != null:
+			return {"kind": str(KINDS[i][0]), "caption": str(KINDS[i][2])}
+	return {}
+
+static func crisis(world) -> bool:
+	return str(world.s.society) in ["disrupted", "emergency"]
+
+static func _find(base: String) -> String:
+	for ext in [".jpg", ".png", ".webp"]:
+		if ResourceLoader.exists(DIR + base + ext):
+			return DIR + base + ext
+	return ""
+
+## The picture for this action now, or "" if none has been made yet.
+static func path(world, kind: String) -> String:
+	var options: Array = []
+	if kind == "eat" and not world.s.household_members.is_empty():
+		options.append("act_eat_together")
+	if crisis(world):
+		options.append("act_%s_crisis" % kind)
+	options.append("act_%s" % kind)
+	for base in options:
+		var found := _find(str(base))
+		if not found.is_empty():
+			return found
+	return ""
