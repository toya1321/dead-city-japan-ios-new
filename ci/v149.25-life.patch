+extends SceneTree
+## v149.25: the department store has a front, a ground floor and a food hall
+## below, each with photos for every stage of the city.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	g._start_new_game(g.world.DEFAULT_PROFILE.duplicate(true))
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	w.s.minute = 4 * 60   # 12:00, open
+	g.location = "駅前"
+	await g._on_command("デパートの前へ行く")
+	check(g.location == "デパート正面" and str(g.picture.texture.resource_path).ends_with("department_front.jpg"), "the front of the store has its own place and photo")
+	await g._on_command("デパートに入る")
+	check(g.location == "デパート" and str(g.log_entries.slice(-2)).contains("地下"), "the ground floor points to the food hall below")
+	var cash := int(w.s.cash)
+	await g._on_command("食料を買う")
+	check(g.log_entries[-1].contains("地下1階") and int(w.s.cash) == cash, "food is not sold on the ground floor")
+	var t0: int = w.s.minute
+	await g._on_command("デパ地下へ行く")
+	check(g.location == "デパート地下" and int(w.s.minute) - t0 == 2 and str(g.picture.texture.resource_path).ends_with("department_food.jpg"), "the escalator down to the food hall")
+	var food: float = w.s.district.sites["デパート"].food
+	await g._on_command("食料を2個買う")
+	check(float(w.s.district.sites["デパート"].food) == food - 2.0 and int(w.s.cash) < cash, "food is bought in the food hall from the store's stock")
+	for spec in [["alert", 15, "alert"], ["emergency", 500, "collapse"]]:
+		w.s.society = spec[0]
+		w.s.regional_cases = spec[1]
+		g._refresh()
+		check(str(g.picture.texture.resource_path).ends_with("department_food_%s.jpg" % spec[2]), "the food hall at stage %s" % spec[0])
+	w.s.minute = 366 * 1440
+	g._refresh()
+	check(str(g.picture.texture.resource_path).ends_with("department_food_overgrown.jpg"), "the food hall a year on")
+	g.location = "デパート正面"
+	g._refresh()
+	check(str(g.picture.texture.resource_path).ends_with("department_front_overgrown.jpg"), "the front a year on")
+	# Abandoned: search the food hall, not the ground floor.
+	w.s.minute = 20 * 1440
+	w.s.district.sites["デパート"].vacant = true
+	g.location = "デパート"
+	await g._on_command("物資を探索する")
+	check(g.log_entries[-1].contains("地下1階"), "the ground floor has little food to search")
+	g.location = "デパート地下"
+	g._refresh()
+	check("物資を探索する" in g._suggestions(), "the food hall offers a search")
+	await g._on_command("物資を探索する")
+	check(g.log_entries[-1].contains("回収"), "the food hall still has food after the collapse")
+	# Dark below without power.
+	w.s.grid_online = false
+	await g._on_command("周囲を見る")
+	check(str(g.log_entries.slice(-2)).contains("真っ暗"), "without power the basement is pitch dark")
+	# The dead wander the floors.
+	w.s.walkers.places = {"デパート地下": 2}
+	w.s.walkers.encounter = {}
+	g.location = "デパート"
+	await g._on_command("デパート地下へ行く")
+	check(not w.s.walkers.encounter.is_empty() and str(w.s.walkers.encounter.place) == "デパート地下", "walkers in the food hall are met there")
+	w.s.walkers.encounter = {}
+	w.s.walkers.places = {}
+	# Home from the basement goes back up and out.
+	await g._on_command("家に帰る")
+	check(g.location == "玄関", "the way home goes up and out")
+	print("v149.25 department checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
diff --git a/tests/test_freetext149_24.gd b/tests/test_freetext149_24.gd
new file mode 100644
index 0000000..3e861b9
--- /dev/null
+++ b/tests/test_freetext149_24.gd
@@ -0,0 +1,97 @@
+extends SceneTree
+## v149.24: the player's own actions in free wording. Fixed words first; what
+## they miss goes to the local model, which only names the action. The game
+## refuses negated lines and lines without a related word, says how it read
+## the line, and runs the fixed command. A scripted model stands in for Qwen.
+const Main = preload("res://main.tscn")
+const Model = preload("res://scripts/local_npc_model.gd")
+const Intents = preload("res://scripts/player_intents.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+
+class ScriptedModel extends RefCounted:
+	var queue: Array = []
+	var requests := 0
+	var instructions := ""
+	func model_available() -> bool:
+		return true
+	func model_name() -> String:
+		return "Scripted.gguf"
+	func is_warm() -> bool:
+		return true
+	func begin(_id: int, text: String, _input: String) -> bool:
+		requests += 1
+		instructions = text
+		return true
+	func take_result(_id: int) -> String:
+		return "" if queue.is_empty() else str(queue.pop_front())
+	func cancel(_id: int) -> void:
+		pass
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func verdict(model: ScriptedModel, key: String) -> void:
+	model.queue.append(JSON.stringify({"kind": "player", "value": key}))
+
+func run() -> void:
+	# --- Rules alone.
+	check(Intents.negated("タバコは吸わない") and Intents.negated("映画は観なくていいや") and Intents.negated("料理はやめとく"), "declining lines are negated")
+	check(not Intents.negated("床に伏せて動かない") and not Intents.negated("音を立てないようにする") and not Intents.negated("光が漏れないように窓を覆う"), "how-to phrases are not negations")
+	check(Intents.command({"kind": "player", "value": "flee"}, "一目散に駆け出す", true) == "逃げる", "a verdict with a related word runs")
+	check(Intents.command({"kind": "player", "value": "fight"}, "様子を見る", true) == "", "a verdict without a related word does not")
+	check(Intents.command({"kind": "player", "value": "smoke"}, "タバコは吸わない", false) == "", "a negated line never runs")
+	check(Intents.command({"kind": "player", "value": "hide"}, "隠れる", false) == "", "encounter keys are not used outside an encounter")
+	check(Model.parse(JSON.stringify({"kind": "player", "value": "distract"})).get("value") == "distract" and Model.parse(JSON.stringify({"kind": "player", "value": "fly"})).is_empty(), "the reply parser accepts only known keys")
+
+	var game = Main.instantiate()
+	root.add_child(game)
+	await process_frame
+	game._start_new_game(game.world.DEFAULT_PROFILE.duplicate(true))
+	game._finish_intro()
+	var fake := ScriptedModel.new()
+	game.local_model.backend = fake
+	var w = game.world
+	w.s.walkers.risen = [7]
+	w.s.society = "disrupted"
+	w.s.grid_online = true
+	w.s.food = 5.0
+	w.s.hunger = 40.0
+
+	# --- Fixed words need no model.
+	game.location = "居間"
+	await game._on_command("タバコ吸う")
+	check(fake.requests == 0 and game.log_entries[-1].contains("タバコがない"), "common wording is caught without the model")
+	await game._on_command("タバコは吸わない")
+	check(fake.requests == 0 and not game.log_entries[-1].contains("タバコに火"), "a declining line is not acted on or sent to the model")
+
+	# --- The model reads what the fixed words miss.
+	var asked: int = fake.requests
+	verdict(fake, "cook")
+	await game._on_command("目玉焼き焼いて食う")
+	check(fake.requests == asked + 1 and fake.instructions == Intents.GENERAL_INSTRUCTIONS, "unknown wording goes to the model with the action list")
+	check(str(game.log_entries.slice(-3)).contains("（「温かい料理を作る」として行動）") and str(game.log_entries.slice(-3)).contains("温かい食事"), "the game says how it read the line and runs the fixed command")
+	verdict(fake, "movie")
+	await game._on_command("外の様子が気になる")
+	check(not str(game.log_entries.slice(-2)).contains("として行動"), "a verdict that does not fit the line is refused")
+
+	# --- In an encounter.
+	game.location = "商店通り"
+	w.s.walkers.places = {"商店通り": 2}
+	w.s.walkers.encounter = {"place": "商店通り", "count": 2, "near": false, "since": w.s.minute, "from": "屋外"}
+	verdict(fake, "flee")
+	await game._on_command("一目散に駆け出す")
+	check(fake.instructions == Intents.ENCOUNTER_INSTRUCTIONS and str(game.log_entries.slice(-3)).contains("（「逃げる」として行動）") and w.s.walkers.encounter.is_empty(), "an encounter reads free wording too")
+	w.s.walkers.encounter = {"place": "商店通り", "count": 2, "near": false, "since": w.s.minute, "from": "屋外"}
+	game.location = "商店通り"
+	asked = fake.requests
+	await game._on_command("戦わない")
+	check(fake.requests == asked and game.log_entries[-1].contains("どれかを選んで"), "a declined action in an encounter asks again without the model")
+	print("v149.24 free-text checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
