+++ b/tests/test_strain149_25.gd
@@ -0,0 +1,107 @@
+extends SceneTree
+## v149.25: a worn-down housemate argues, shuts themself in, sleeps badly and
+## turns requests down; at the limit for two days they speak of the shelter,
+## and a day later they leave a note and go. Listening undoes it.
+const Main = preload("res://main.tscn")
+const Mood = preload("res://scripts/mood.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	profile.cohabitants = 1
+	profile.companion_names = ["詩音"]
+	g._start_new_game(profile)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var shion: Dictionary = w.s.household_members[0]
+	g.location = "居間"
+	shion.location = "居間"
+	shion.activity = "在宅"
+	w.set_meta("player_at_home", true)
+	Mood.ensure(w)
+	# --- Strain below 25.
+	shion.mood = 20.0
+	var seen := {}
+	for i in 60:
+		w.s.minute += 60
+		shion.activity = "在宅"
+		shion.mood = 20.0
+		w.s.walkers.notices = []
+		Mood.hourly(w, false)
+		var text := str(w.s.walkers.notices)
+		if text.contains("口論"): seen.argue = true
+		if text.contains("出てこない"): seen.closed = true
+		if text.contains("くま"): seen.sleepless = true
+	check(seen.size() >= 2, "strain shows as arguments, a closed door or sleepless nights: " + str(seen.keys()))
+	shion.withdrawn_until = int(w.s.minute) + 120
+	g._run_household_request(0, shion, "水を飲んで", "水を飲んで")
+	check(g.log_entries[-1].begins_with("詩音「") and (g.log_entries[-1].contains("何もしたくない") or g.log_entries[-1].contains("ひとりに") or g.log_entries[-1].contains("今は無理")), "a worn-down housemate turns requests down")
+	check(not Mood.refuses(w, shion, "映画を観よう"), "but a film is still welcome")
+	# --- Listening.
+	shion.mood = 18.0
+	g.dialogue.partner = -1
+	g._refresh()
+	check("詩音の話を聞く" in g._suggestions(), "listening is suggested")
+	var t0: int = w.s.minute
+	await g._on_command("詩音の話を聞く")
+	check(float(shion.mood) >= 27.0 and int(w.s.minute) - t0 >= 30 and not shion.has("withdrawn_until") and g.log_entries[-1].contains("（30分）"), "listening lifts them and opens the door")
+	var m1: float = shion.mood
+	await g._on_command("詩音を励ます")
+	check(float(shion.mood) - m1 < 5.0, "again so soon, it helps less")
+	# --- At the limit: a warning, then a note.
+	g.location = "台所"
+	var warned := false
+	for i in 80:
+		w.s.minute += 60
+		shion.activity = "在宅"
+		shion.mood = 10.0
+		w.s.walkers.notices = []
+		Mood.hourly(w, false)
+		warned = warned or str(w.s.walkers.notices).contains("避難所に行けば")
+		if bool(shion.get("leaving", false)):
+			break
+	check(warned and bool(shion.get("leaving", false)), "two days at the limit bring a warning, a day later they decide to go")
+	g._refresh()
+	check(w.s.household_members.is_empty() and str(g.log_entries.slice(-3)).contains("書き置き") and int(w.s.profile.cohabitants) == 0, "they leave a note and are gone")
+	check(w.validate_state(w.s), "the household stays valid")
+	# --- Comfort in time stops it.
+	var g2 = Main.instantiate()
+	root.add_child(g2)
+	for i in 3: await process_frame
+	g2._start_new_game(profile)
+	g2._finish_intro()
+	g2.local_model.enabled = false
+	var w2 = g2.world
+	var mate: Dictionary = w2.s.household_members[0]
+	g2.location = "居間"
+	mate.location = "居間"
+	Mood.ensure(w2)
+	for i in 50:
+		w2.s.minute += 60
+		mate.activity = "在宅"
+		mate.mood = 10.0
+		Mood.hourly(w2, false)
+	check(mate.has("leave_warned_at"), "the warning comes")
+	await g2._on_command("詩音の話を聞く")
+	check(int(mate.get("low_hours", 0)) < Mood.LEAVE_WARN_HOURS, "listening after the warning buys time")
+	for i in 30:
+		w2.s.minute += 60
+		mate.activity = "在宅"
+		Mood.hourly(w2, false)
+	check(not bool(mate.get("leaving", false)) and w2.s.household_members.size() == 1, "and once they feel better they stay")
+	print("v149.25 strain checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
