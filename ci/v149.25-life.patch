+## v149.25: a housemate worn down. Below 25: every half day an argument, a
+## closed door or a sleepless night. Below 15 for two days: they say they are
+## thinking of the shelter. A day later, still there: they leave a note and go
+## (`leaving`, handled by the game). Listening and comfort undo it.
+const LEAVE_WARN_HOURS := 48
+const LEAVE_HOURS := 72
+
+static func _strain(world, person: Dictionary, player_home: bool) -> void:
+	var minute := int(world.s.minute)
+	var notices: Array = world.s.walkers.notices if world.s.has("walkers") else []
+	var value := of(person)
+	if value < 15.0:
+		person.low_hours = int(person.get("low_hours", 0)) + 1
+	elif value >= 20.0 and person.has("low_hours"):
+		person.erase("low_hours")
+		person.erase("leave_warned_at")
+	var awake: bool = not str(person.get("activity", "")) in ["睡眠", "外出"]
+	if value < 25.0 and awake and minute - int(person.get("mood_event_at", -100000)) >= 12 * 60:
+		person.mood_event_at = minute
+		var kind: int = world.draw(minute, int(person.id), "strain", 3)
+		if kind == 0 and player_home and float(world.s.health) > 0:
+			change(world.s, -3.0)
+			change(person, -1.0)
+			person.withdrawn_until = minute + 6 * 60
+			notices.append("%sと、ささいなことで口論になった。「……もういい」とだけ言って、%sは寝室にこもってしまった。" % [person.name, person.name])
+		elif kind == 1:
+			person.withdrawn_until = minute + 6 * 60
+			notices.append("%sが寝室から出てこない。ドア越しに声をかけても、返事は短い。" % person.name)
+		else:
+			person.fatigue = minf(100.0, float(person.get("fatigue", 0.0)) + 20.0)
+			notices.append("%sは夜中に何度も起きていたようだ。目の下に、濃いくまができている。" % person.name)
+	var low := int(person.get("low_hours", 0))
+	if low >= LEAVE_WARN_HOURS and not person.has("leave_warned_at"):
+		person.leave_warned_at = minute
+		notices.append("%s「……ねえ。避難所に行けば、ここよりはましなのかな。ここにいると、息が詰まりそう」" % person.name)
+	elif low >= LEAVE_HOURS and person.has("leave_warned_at") and minute - int(person.leave_warned_at) >= 24 * 60:
+		person.leaving = true
+
+## Whether a worn-down housemate turns a request down.
+static func refuses(world, person: Dictionary, request: String) -> bool:
+	if request.contains("映画"):
+		return false
+	return of(person) < 20.0 or int(person.get("withdrawn_until", -1)) > int(world.s.minute)
+
+## Sitting down and listening: a real lift, less if done again soon.
+static func comfort(world, person: Dictionary) -> String:
+	ensure(world)
+	var minute := int(world.s.minute)
+	var recent := minute - int(person.get("comforted_at", -100000)) < 6 * 60
+	var before := of(person)
+	person.comforted_at = minute
+	person.erase("withdrawn_until")
+	change(person, 3.0 if recent else 10.0)
+	change(world.s, 2.0)
+	if person.has("low_hours"):
+		person.low_hours = maxi(0, int(person.low_hours) - 24)
+	if recent:
+		return "%sの隣に座った。さっきも話したばかりで、今はただ黙ってそばにいた。" % person.name
+	if before < 15.0:
+		return "%sの隣に座り、何も言わずに待った。しばらくして、%sはぽつぽつと話し始めた。家族のこと、外のこと、眠れない夜のこと。最後に小さく「……聞いてくれて、ありがとう」と言った。" % [person.name, person.name]
+	if before < 35.0:
+		return "%sの話を、急かさずに聞いた。%sは少しだけ笑って、「なんか、ちょっと楽になった」と言った。" % [person.name, person.name]
+	return "%sとゆっくり話した。外のことを忘れて、昔の話で少し笑った。" % person.name
 
