diff --git a/tests/test_world_traits149_27.gd b/tests/test_world_traits149_27.gd
new file mode 100644
index 0000000..cb109b0
--- /dev/null
+++ b/tests/test_world_traits149_27.gd
@@ -0,0 +1,127 @@
+extends SceneTree
+## v149.27: every world has its own character: outbreak pace and first case,
+## outages, hordes, shop stock, and a few events of its own.
+const Main = preload("res://main.tscn")
+const WorldTraits = preload("res://scripts/world_traits.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func world_for(seed: int):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+
+func run() -> void:
+	# --- Generation.
+	check(var_to_bytes(WorldTraits.generate(77, 48)) == var_to_bytes(WorldTraits.generate(77, 48)), "the same seed gives the same world")
+	var routes := {}
+	var paces := {}
+	var zeros := {}
+	var events := {}
+	for seed in range(1, 61):
+		var t := WorldTraits.generate(seed * 31337, 48)
+		routes[t.horde_route] = true
+		paces[t.pace] = true
+		zeros[t.patient_zero] = true
+		for e in t.events:
+			events[e] = true
+		check(WorldTraits.valid(t) and t.events.size() == 3, "") if not WorldTraits.valid(t) else null
+	check(routes.size() == WorldTraits.HORDE_ROUTES.size() and paces.size() >= 8 and zeros.size() >= 20 and events.size() == WorldTraits.EVENTS.size(), "worlds differ: %d routes, %d paces, %d first cases, %d events" % [routes.size(), paces.size(), zeros.size(), events.size()])
+	# --- Applied in a world.
+	var g = await world_for(4242)
+	var w = g.world
+	var t: Dictionary = w.s.world_traits
+	var zero_agent: Dictionary = {}
+	for a in w.s.agents:
+		if int(a.id) == int(t.patient_zero):
+			zero_agent = a
+	check(int(zero_agent.get("exposure", -1)) == 0, "the first case is this world's own")
+	check(w.validate_state(w.s), "the world is valid")
+	# Stock follows the world.
+	var base_food: float = float(load("res://scripts/district.gd").SITES["デパート"].food)
+	check(absf(float(w.s.district.sites["デパート"].food) - snappedf(base_food * float(t.stock["デパート"]), 0.5)) < 0.01, "shop stock follows the world")
+	# Hordes walk this world's route.
+	t.horde_route = "reverse"
+	w.s.walkers.horde_next = int(w.s.minute)
+	w.s.walkers.places = {"駅前": 12}
+	w.s.walkers.notices = []
+	Walkers.horde_hourly(w)
+	check(str(w.s.walkers.horde.place) == "商店通り" and str(w.s.walkers.notices).contains("商店通り付近"), "a horde starts where this world's route does")
+	t.horde_route = "elsewhere"
+	w.s.walkers.erase("horde")
+	w.s.walkers.horde_next = int(w.s.minute)
+	Walkers.horde_hourly(w)
+	var passed_home := false
+	var told := false
+	for i in 10:
+		w.s.minute += 60
+		w.s.walkers.notices = []
+		Walkers.horde_hourly(w)
+		passed_home = passed_home or Walkers.horde_at(w, "屋外") > 0
+		told = told or str(w.s.walkers.notices).contains("この通りには来ない")
+	check(not passed_home and told, "a horde on another route never comes down the street, and says so")
+	# Events, each once, with effects.
+	t.events = ["looting", "rolling_blackout", "fire"]
+	t.done_events = []
+	w.s.society = "emergency"
+	var food_before: float = float(w.s.district.sites["コンビニ"].food)
+	w.s.walkers.notices = []
+	for i in 3:
+		WorldTraits.hourly(w)
+	check(float(w.s.district.sites["コンビニ"].food) <= food_before * 0.5 + 0.5 and str(w.s.walkers.notices).contains("略奪"), "looting strips the shops and is reported")
+	check(not bool(w.s.grid_online) and w.s.has("rolling_blackout_until"), "a rolling blackout cuts the power")
+	check(int(w.s.walkers.noise.get("住宅街", -1)) > int(w.s.minute), "a fire draws the dead with its noise")
+	WorldTraits.hourly(w)
+	check(t.done_events.size() == 3, "each event happens once")
+	w.s.society = "alert"
+	w.s.minute = int(w.s.rolling_blackout_until)
+	WorldTraits.restore(w)
+	check(bool(w.s.grid_online), "and the power comes back")
+	# The konbini may hold out.
+	t.konbini_holds = true
+	w.s.society = "disrupted"
+	w.s.sim.logistics = 40.0
+	w.s.district.sites["コンビニ"].vacant = false
+	load("res://scripts/district.gd").tick(w)
+	check(not bool(w.s.district.sites["コンビニ"].vacant), "in some worlds the konbini holds out through the disruption")
+	# Pace: a fast world falls sooner than a slow one.
+	var days := []
+	for pace in [0.7, 1.4]:
+		var gp = await world_for(999)
+		var wp = gp.world
+		wp.s.world_traits.pace = pace
+		var day := -1
+		for h in 24 * 40:
+			wp.s.food = 10.0
+			wp.s.water = 10.0
+			wp.s.hunger = 0.0
+			wp.s.thirst = 0.0
+			wp.s.health = 100.0
+			wp.advance_safe(60)
+			if str(wp.s.society) in ["disrupted", "emergency"]:
+				day = h / 24
+				break
+		days.append(day)
+		gp.queue_free()
+	check(days[1] >= 0 and (days[0] < 0 or days[1] < days[0]), "a fast world breaks down sooner (slow %d, fast %d)" % [days[0], days[1]])
+	# Old saves.
+	var old: Dictionary = w.s.duplicate(true)
