diff --git a/tests/test_shelter_raid149_27.gd b/tests/test_shelter_raid149_27.gd
new file mode 100644
index 0000000..7dd14f2
--- /dev/null
+++ b/tests/test_shelter_raid149_27.gd
@@ -0,0 +1,235 @@
+extends SceneTree
+## v149.27: the shelter (opening, ration, notice board, housemates who left,
+## falling) and looters (a reason to come, an hour to answer, rob or threaten).
+const Main = preload("res://main.tscn")
+const Shelter = preload("res://scripts/shelter.gd")
+const Raiders = preload("res://scripts/raiders.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+## Forward to the next time the clock reads `hour`:00.
+func next_hour(world, hour: int) -> void:
+	world.s.minute = int(world.s.minute) / 60 * 60 + 60
+	while int(world.hour_of_day()) != hour:
+		world.s.minute += 60
+
+func fresh(cohab: int):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.cohabitants = cohab
+	p.companion_names = ["詩音", "蒼"].slice(0, cohab)
+	p.companion_genders = ["女性", "男性"].slice(0, cohab)
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	# --- The shelter.
+	var g = await fresh(1)
+	var w = g.world
+	g.location = "住宅街"
+	await g._on_command("避難所へ行く")
+	check(g.location == "避難所" and str(g.log_entries.slice(-2)).contains("校門は閉まっている"), "before the breakdown it is just a closed school")
+	check(g.picture.texture != null, "a photo is shown even before the school has its own")
+	await g._on_command("配給を受け取る")
+	check(g.log_entries[-1].contains("開いていない"), "no ration before it opens")
+	w.s.society = "disrupted"
+	Shelter.hourly(w)
+	check(Shelter.is_open(w), "it opens when life breaks down")
+	g._refresh()
+	check("配給を受け取る" in g._suggestions() and "掲示板を見る" in g._suggestions(), "the ration and the notice board are suggested")
+	w.s.district.bag.water = 0.0
+	w.s.district.bag.food = 0.0
+	await g._on_command("配給を受け取る")
+	check(float(w.s.district.bag.water) == 2.0 and float(w.s.district.bag.food) == 1.0, "a ration once a day")
+	await g._on_command("配給を受け取る")
+	check(g.log_entries[-1].contains("もう受け取った"), "and only once")
+	# --- A housemate who left is found here.
+	var shion: Dictionary = w.s.household_members[0]
+	shion.leaving = true
+	g.location = "居間"
+	g._refresh()
+	check(w.s.household_members.is_empty(), "the housemate leaves a note")
+	g.location = "住宅街"
+	await g._on_command("避難所へ行く")
+	check(str(g.log_entries.slice(-4)).contains("体育館の隅に、詩音がいた"), "and is found again at the shelter")
+	await g._on_command("掲示板を見る")
+	check(g.log_entries[-1].contains("詩音、無事です"), "the notice board names them")
+	await g._on_command("詩音に話しかける")
+	await g._on_command("一緒に帰ろう、来ないか")
+	check(w.s.household_members.size() == 1 and str(w.s.household_members[0].name) == "詩音" and w.validate_state(w.s), "and can come home")
+	# --- Living there: with food, order and no hidden bites it lasts.
+	var g2 = await fresh(0)
+	var w2 = g2.world
+	w2.s.society = "emergency"
+	Shelter.hourly(w2)
+	var st: Dictionary = Shelter.state(w2)
+	check(Shelter.is_open(w2) and int(st.pop) >= 60, "the shelter opens with people in it")
+	g2.location = "避難所"
+	for day in 20:
+		st.supplied = true
+		st.supply_end = -1
+		st.sick = 0
+		st.outside = 0
+		w2.s.health = 100.0
+		w2.s.hunger = 0.0
+		w2.s.thirst = 0.0
+		await g2._on_command("配給を受け取る")
+		await g2._on_command("見張りを手伝う")
+		await g2._on_command("避難所で寝る")
+	check(Shelter.is_open(w2), "a player can live there for weeks; nothing is fixed to fall")
+	check(str(g2.log_entries.slice(-3)).contains("体育館の毛布の上で眠った"), "sleeping among the others")
+	await g2._on_command("避難所の様子を聞く")
+	check(g2.log_entries[-1].contains("体育館") and g2.log_entries[-1].contains("門"), "the place can be read: crowd, food, mood, gate")
+	# The supply trucks stop some days into the emergency.
+	st.supply_end = int(w2.s.minute) - 1
+	Shelter.hourly(w2)
+	check(not bool(st.supplied), "the city's supplies stop")
+	# Theft when order is poor.
+	st.order = 20.0
+	w2.s.district.bag.food = 2.0
+	var robbed := false
+	for i in 8:
+		w2.s.district.bag.food = 2.0
+		w2.s.minute += 1440
+		await g2._on_command("避難所で寝る")
+		robbed = robbed or g2.log_entries[-1].contains("持ち出し袋が開けられていた")
+		st.order = 20.0
+	check(robbed, "with order gone, things go missing at night")
+	# A bite turns at night: held down when order holds, the shelter falls when it does not.
+	st.order = 90.0
+	st.sick = 1
+	st.status = "open"
+	next_hour(w2, 2)
+	Shelter.hourly(w2)
+	check(Shelter.is_open(w2), "a turning held down by a good watch")
+	# Hunger: people leave, the shelter is abandoned, nobody dies.
+	var people: Dictionary = Survivors.ensure(w2).people
+	var shelter_ids: Array = people.keys().filter(func(k): return people[k].place == "避難所" and people[k].status == "alive")
+	st.supplied = false
+	st.stock = 0.0
+	st.order = 25.0
+	st.garden = 0.0
+	st.sick = 0
+	g2.location = "住宅街"
+	for day in 12:
+		next_hour(w2, 6)
+		Shelter.hourly(w2)
+	check(Shelter.status(w2) == "abandoned", "with no food left the shelter empties")
+	check(shelter_ids.filter(func(k): return people[k].status == "alive" and people[k].place == "住宅街").size() == shelter_ids.size(), "and the people in it scatter alive")
+	# The gate: walkers at the fence wear it down.
+	var g4 = await fresh(0)
+	var w4 = g4.world
+	w4.s.society = "emergency"
+	Shelter.hourly(w4)
+	var st4: Dictionary = Shelter.state(w4)
+	st4.outside = 20
+	st4.gate = 3.0
+	st4.order = 30.0
+	g4.location = "避難所"
+	w4.set_meta("player_place", "避難所")
+	w4.s.walkers.notices = []
+	next_hour(w4, 6)
+	Shelter.hourly(w4)
+	check(Shelter.status(w4) == "overrun" and Walkers.count(w4, "避難所") >= 12, "a broken gate with many at the fence lets them in")
+	check(str(w4.s.walkers.notices).contains("すぐにここを出なければ") and bool(w4.s.walkers.alarm), "a player inside is woken to run")
+	# A turning with no order inside.
+	var g5 = await fresh(0)
+	var w5 = g5.world
+	w5.s.society = "emergency"
+	Shelter.hourly(w5)
+	var st5: Dictionary = Shelter.state(w5)
+	st5.order = 0.0
+	st5.sick = 1
+	next_hour(w5, 2)
+	Shelter.hourly(w5)
+	check(Shelter.status(w5) == "overrun" and str(w5.s.walkers.notices).contains("発症した人を止められず"), "with no order, one turning is enough")
+	# This world's "shelter_closed" event stops supplies instead of ending it.
+	var g6 = await fresh(0)
+	var w6 = g6.world
+	w6.s.society = "disrupted"
+	Shelter.hourly(w6)
+	load("res://scripts/world_traits.gd").of(w6)["done_events"] = ["shelter_closed"]
+	Shelter.hourly(w6)
+	check(Shelter.is_open(w6) and not bool(Shelter.state(w6).supplied), "the officials leaving stops supplies; the shelter goes on")
+	check(w6.validate_state(w6.s) and g6._save().begins_with("保存") and g6._load() == "保存データを読み込んだ。", "a save at the shelter loads")
+	# --- Looters.
+	var g3 = await fresh(1)
+	var w3 = g3.world
+	g3.location = "居間"
+	w3.s.society = "disrupted"
+	w3.s.minute = 13 * 60 + 10 * 1440   # 21:00
+	w3.s.grid_online = true
+	w3.s.lights_off = true
+	var came := false
+	for i in 100:
+		w3.s.minute += 1440
+		Raiders.hourly(w3)
+		came = came or Raiders.active(w3)
+	check(not came, "no looters at a dark house")
+	w3.s.lights_off = false
+	for i in 200:
+		w3.s.minute += 61
+		if (w3.hour_of_day() < 6.0 or w3.hour_of_day() >= 18.0):
+			w3.s.walkers.notices = []
+			Raiders.hourly(w3)
+			if Raiders.active(w3):
+				break
+	check(Raiders.active(w3) and str(w3.s.walkers.notices).contains("人間だ"), "a light at night after the breakdown brings looters, who are heard first")
+	g3._refresh()
+	check("大声で追い払う" in g3._suggestions() and "明かりを消す" in g3._suggestions() and g3.danger_label.text == "玄関の外に人", "the answers are suggested")
+	# Light out: they decide they were wrong.
+	await g3._on_command("明かりを消す")
+	w3.s.minute = int(w3.s.raid.at) + 60
+	w3.s.walkers.notices = []
+	Raiders.hourly(w3)
+	check(not Raiders.active(w3) and str(w3.s.walkers.notices).contains("気のせいか"), "putting the light out sends them away")
+	# Left alone at an unlocked door: robbed.
+	w3.s.lights_off = false
+	w3.s.raid = {"at": int(w3.s.minute), "size": 3}
+	w3.s.door_locked = false
+	w3.s.barricade = 0
+	w3.s.food = 5.0
+	w3.s.minute += 60
+	w3.s.walkers.notices = []
+	Raiders.hourly(w3)
