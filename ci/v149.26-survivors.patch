diff --git a/scripts/world_traits.gd b/scripts/world_traits.gd
new file mode 100644
index 0000000..432401c
--- /dev/null
+++ b/scripts/world_traits.gd
@@ -0,0 +1,156 @@
+extends RefCounted
+## v149.27: what makes this world unlike the last one, drawn from the world
+## seed once at the start: how fast the outbreak spreads and who carries it
+## first, when the power and water fail, where the hordes walk and how often,
+## how well stocked the shops are and when they are abandoned, and which
+## events the news will carry. Old saves without traits behave as before
+## (`defaults()`).
+
+const HORDE_ROUTES := {
+	# Through the street outside the house (the original route).
+	"past_home": ["駅前", "駅前", "住宅街", "住宅街", "屋外", "屋外", "屋外", "商店通り", "商店通り"],
+	# Straight from the station down the house's street.
+	"direct": ["駅前", "駅前", "屋外", "屋外", "屋外", "商店通り", "商店通り"],
+	# From the shopping street, past the house, toward the station.
+	"reverse": ["商店通り", "商店通り", "屋外", "屋外", "屋外", "住宅街", "住宅街", "駅前"],
+	# Along the residential streets, never past the house.
+	"elsewhere": ["駅前", "駅前", "住宅街", "住宅街", "住宅街", "商店通り", "商店通り"],
+}
+
+## Events a world may carry: [id, stage at which it happens, weight].
+const EVENTS := {
+	"looting": {"stage": "disrupted", "weight": 30},
+	"fire": {"stage": "emergency", "weight": 20},
+	"rolling_blackout": {"stage": "alert", "weight": 20},
+	"curfew": {"stage": "disrupted", "weight": 20},
+	"rescue_rumor": {"stage": "emergency", "weight": 25},
+	"shelter_closed": {"stage": "emergency", "weight": 15},
+}
+
+static func defaults() -> Dictionary:
+	return {"pace": 1.0, "first_case_day": 3, "patient_zero": 7, "symptoms_hours": [36, 72],
+		"outage_grid": 1.0, "outage_water": 1.0, "horde_route": "past_home", "horde_gap": [5, 9], "horde_size": 1.0,
+		"stock": {}, "konbini_holds": false, "events": [], "done_events": []}
+
+static func generate(seed_value: int, residents: int) -> Dictionary:
+	var rng := RandomNumberGenerator.new()
+	rng.seed = hash([seed_value, "world-traits-v1"])
+	var t := defaults()
+	t.pace = snappedf(rng.randf_range(0.7, 1.4), 0.05)
+	t.first_case_day = rng.randi_range(2, 6)
+	t.patient_zero = rng.randi_range(0, maxi(0, residents - 1))
+	var onset := rng.randi_range(24, 96)
+	t.symptoms_hours = [onset, onset + rng.randi_range(12, 36)]
+	t.outage_grid = snappedf(rng.randf_range(0.4, 2.0), 0.1)
+	t.outage_water = snappedf(rng.randf_range(0.4, 2.0), 0.1)
+	var routes: Array = HORDE_ROUTES.keys()
+	t.horde_route = routes[rng.randi_range(0, routes.size() - 1)]
+	var gap_min := rng.randi_range(3, 7)
+	t.horde_gap = [gap_min, gap_min + rng.randi_range(2, 5)]
+	t.horde_size = snappedf(rng.randf_range(0.7, 1.4), 0.05)
+	var stock := {}
+	for site in ["コンビニ", "近所の空き家", "デパート"]:
+		stock[site] = snappedf(rng.randf_range(0.5, 1.5), 0.05)
+	t.stock = stock
+	t.konbini_holds = rng.randi_range(0, 2) == 0
+	# Three events, drawn by weight without repeats.
+	var pool: Array = EVENTS.keys()
+	var chosen: Array = []
+	while chosen.size() < 3 and not pool.is_empty():
+		var total := 0
+		for id in pool:
+			total += int(EVENTS[id].weight)
+		var roll := rng.randi_range(1, total)
+		for id in pool:
+			roll -= int(EVENTS[id].weight)
+			if roll <= 0:
+				chosen.append(id)
+				pool.erase(id)
+				break
+	t.events = chosen
+	return t
+
+static func of(world) -> Dictionary:
+	var t = world.s.get("world_traits", null)
+	return t if t is Dictionary else defaults()
+
+static func valid(value: Variant) -> bool:
+	if not value is Dictionary:
+		return false
+	for key in ["pace", "outage_grid", "outage_water", "horde_size"]:
+		var n = value.get(key)
+		if not (n is int or n is float) or float(n) < 0.1 or float(n) > 5.0:
+			return false
+	return HORDE_ROUTES.has(str(value.get("horde_route", ""))) and value.get("events") is Array and value.get("stock") is Dictionary
+
+## Applied once when the world is made: shop stock.
+static func apply_start(world) -> void:
+	var t := of(world)
+	for site in t.stock:
+		if world.s.district.sites.has(site):
+			var s: Dictionary = world.s.district.sites[site]
+			s.food = snappedf(float(s.food) * float(t.stock[site]), 0.5)
+			s.water = snappedf(float(s.water) * float(t.stock[site]), 0.5)
+
+## The stage order, for "has the world reached this stage".
+const STAGES := ["normal", "alert", "disrupted", "emergency"]
+
+static func reached(world, stage: String) -> bool:
+	return STAGES.find(str(world.s.society)) >= STAGES.find(stage)
+
+## Hourly: this world's events, each once when its stage comes.
+static func hourly(world) -> void:
+	var t = world.s.get("world_traits", null)
+	if not t is Dictionary:
+		return
+	if not t.has("done_events"):
+		t.done_events = []
+	for id in t.events:
+		if id in t.done_events or not reached(world, str(EVENTS[id].stage)):
+			continue
+		t.done_events.append(id)
+		_happen(world, str(id))
+		break   # one a hour, so they arrive as separate moments
+
+static func _happen(world, id: String) -> void:
+	var notices: Array = world.s.walkers.notices if world.s.has("walkers") else []
+	var news: Dictionary = world.s.get("outbreak_news", {})
+	var items: Array = news.get("items", [])
+	match id:
+		"looting":
+			# The shops are stripped before the player gets there.
+			for site in world.s.district.sites:
+				var s: Dictionary = world.s.district.sites[site]
+				s.food = snappedf(float(s.food) * 0.5, 0.5)
+				s.water = snappedf(float(s.water) * 0.5, 0.5)
+			items.append({"minute": int(world.s.minute), "text": "商店街やコンビニで略奪が相次ぐ。警察は対応しきれていない。"})
+			notices.append("【ニュース速報】このあたりの店で、略奪が始まったらしい。（スマホに届いた通知）")
+		"fire":
+			# A fire in the residential streets: noise and smoke draw the dead.
+			if world.s.has("walkers"):
+				var w: Dictionary = world.s.walkers
+				w.noise["住宅街"] = int(world.s.minute) + 12 * 60
+			notices.append("【危険】住宅街の方角に、黒い煙が上がっている。サイレンは聞こえない。燃える音に、感染者が引き寄せられていく。")
+		"rolling_blackout":
+			world.s.grid_online = false
+			world.s.rolling_blackout_until = int(world.s.minute) + 8 * 60
+			notices.append("【記録】計画停電が始まった。家の電気が止まった。（8時間の予定）")
+		"curfew":
+			items.append({"minute": int(world.s.minute), "text": "区が夜間の外出禁止を要請。午後8時から午前6時まで。"})
+			notices.append("【防災無線】こちらは防災無線です。本日より、夜間の外出を禁止します。夜は家から出ないでください。")
+		"rescue_rumor":
+			items.append({"minute": int(world.s.minute), "text": "（SNS）「自衛隊が駅の向こうで救助拠点を開いた」という書き込みが広がっている。真偽は不明。"})
+			notices.append("スマホに、救助拠点の噂が流れてきた。駅の向こうで、自衛隊が人を集めているという。……本当だろうか。")
+		"shelter_closed":
+			items.append({"minute": int(world.s.minute), "text": "区立小学校の避難所で感染者が出て、閉鎖された。"})
+			notices.append("【記録】ラジオによれば、避難所になっていた小学校で感染者が出て、閉鎖されたという。")
+	news["items"] = items
+
+## A rolling blackout ends on its own.
+static func restore(world) -> void:
+	if world.s.has("rolling_blackout_until") and int(world.s.minute) >= int(world.s.rolling_blackout_until):
+		world.s.erase("rolling_blackout_until")
+		if str(world.s.society) != "emergency":
+			world.s.grid_online = true
+			if world.s.has("walkers"):
+				world.s.walkers.notices.append("【記録】計画停電が終わり、電気が戻った。")
