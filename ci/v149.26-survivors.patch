@@ -0,0 +1,58 @@
+extends SceneTree
+## Real-model evaluation: one generated survivor per voice, the same questions
+## to each. Prints JSON lines (voice, question, reply, rejected attempts).
+## DCJ_LLAMA_PROBE, DCJ_GGUF, optional DCJ_VOICES=gruff,young
+const Main = preload("res://main.tscn")
+const Real = preload("res://qa/real_npc_scenarios.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const PLACES := ["デパート", "デパート正面", "デパート地下", "薬局", "コンビニ", "住宅街", "近所の空き家", "駅前", "商店通り", "食品店", "金物店"]
+const QUESTIONS := ["大丈夫ですか？", "ここで何があったんですか？", "何か必要なものはある？", "家族は無事なの？", "その傷、どうしたの？", "一人で怖くない？", "名前、聞いてもいい？", "好きな食べ物は？", "このあとどうするつもり？", "前は何してたの？", "最近、眠れてる？", "このへんで安全な場所ってある？", "ありがとう、また来るよ"]
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func run() -> void:
+	var wanted := ["gruff", "young", "calm", "edgy", "warm", "elder", "child", "foreign"]
+	if not OS.get_environment("DCJ_VOICES").is_empty():
+		wanted = Array(OS.get_environment("DCJ_VOICES").split(","))
+	var picked := {}
+	for seed in range(1, 400):
+		var people := Survivors.generate(seed * 104729, PLACES)
+		for id in people:
+			var p: Dictionary = people[id]
+			if p.voice in wanted and not picked.has(p.voice):
+				picked[p.voice] = [seed * 104729, id]
+		if picked.size() == wanted.size():
+			break
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var backend = Real.RealModel.new()
+	for voice in wanted:
+		if not picked.has(voice):
+			continue
+		var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+		profile.seed = int(picked[voice][0])
+		g._start_new_game(profile)
+		g._finish_intro()
+		g.local_model.backend = backend
+		g.local_model.enabled = true
+		g.local_model.load_timeout_ms = 400000
+		g.local_model.generation_timeout_ms = 400000
+		var w = g.world
+		w.s.society = "disrupted"
+		w.s.minute = 4 * 60 + 14 * 1440
+		var id: String = picked[voice][1]
+		var p: Dictionary = Survivors.person(w, id)
+		p.trust = 40
+		g.location = p.place
+		g.survivor_partner = ""
+		await g._on_command(p.label + "に話しかける")
+		print(JSON.stringify({"voice": voice, "who": "%s %s %d %s" % [p.name, p.job, p.age, p.gender], "tag": p.tag, "trait": p.trait, "q": "(greeting)", "a": g.log_entries[-1]}))
+		for q in QUESTIONS:
+			var calls: int = backend.calls
+			g.survivor_rejects = []
+			await g._on_command(q)
+			print(JSON.stringify({"voice": voice, "q": q, "a": g.log_entries[-1], "calls": backend.calls - calls, "rejected": g.survivor_rejects}))
+		await g._on_command("会話を終える")
+	quit()
