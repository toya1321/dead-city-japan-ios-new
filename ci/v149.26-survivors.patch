diff --git a/tests/test_roles149_27.gd b/tests/test_roles149_27.gd
new file mode 100644
index 0000000..0fe246e
--- /dev/null
+++ b/tests/test_roles149_27.gd
@@ -0,0 +1,126 @@
+extends SceneTree
+## v149.27: housemates' roles: watch, cook, repair, scout, medic.
+const Main = preload("res://main.tscn")
+const Roles = preload("res://scripts/roles.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+
+var failures := 0
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func check(condition: bool, label: String) -> void:
+	print(("PASS " if condition else "FAIL ") + label)
+	if not condition:
+		failures += 1
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.cohabitants = 3
+	p.companion_names = ["詩音", "蒼", "陸"]
+	p.companion_genders = ["女性", "男性", "男性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var shion: Dictionary = w.s.household_members[0]
+	var ao: Dictionary = w.s.household_members[1]
+	var riku: Dictionary = w.s.household_members[2]
+	g.location = "居間"
+	for m in w.s.household_members:
+		m.location = "居間"
+		m.activity = "在宅"
+	w.s.society = "disrupted"
+	g._refresh()
+	check("役割を決める" in g._suggestions(), "sharing out the work is suggested once things go wrong")
+	await g._on_command("役割を決める")
+	check(g.log_entries[-1].contains("見張り") and g.log_entries[-1].contains("なし"), "the roles are listed")
+	# --- Parsing: a standing job vs a one-off request.
+	check(Roles.parse("詩音に見張りを頼む") == "watch" and Roles.parse("蒼を料理担当にする") == "cook" and Roles.parse("詩音、料理して") == "", "a role is a standing job; a request to cook now is not")
+	await g._on_command("詩音に見張りを頼む")
+	await g._on_command("蒼を料理担当にする")
+	await g._on_command("陸に修理を任せる")
+	check(Roles.role_of(shion) == "watch" and Roles.role_of(ao) == "cook" and Roles.role_of(riku) == "repair", "roles are given")
+	check(g._household_text().contains("（見張り）"), "the household panel shows roles")
+	# --- Watch: puts the lights out when someone in the street turns toward the house.
+	w.s.minute = 13 * 60 + 5 * 1440   # 21:00
+	w.s.lights_off = false
+	w.s.walkers.places = {"屋外": 2}
+	w.s.walkers.notices = []
+	Walkers.home_events(w)
+	Roles.hourly(w)
+	check(bool(w.s.lights_off) and str(w.s.walkers.notices).contains("明かりを消した"), "the watch puts the lights out at the first sign")
+	w.s.minute += 60
+	Walkers.home_events(w)
+	check(Walkers.count(w, "建物前") == 0, "so nobody comes to the door")
+	# --- Cook: a warm dinner lifts everyone and smells.
+	w.s.minute = 10 * 60 + 6 * 1440   # 18:00
+	w.s.food = 5.0
+	w.s.grid_online = true
+	var m0: float = Mood.of(w.s)
+	ao.activity = "在宅"
+	w.s.walkers.notices = []
+	Roles.hourly(w)
+	check(Mood.of(w.s) > m0 + 3.0 and str(w.s.walkers.notices).contains("夕食") and "smell" in Walkers.home_reasons(w), "the cook's dinner lifts everyone, and smells")
+	# --- Repair: mends the door by day, loudly.
+	w.s.door_hp = 50.0
+	w.s.minute = 3 * 60 + 7 * 1440   # 11:00
+	riku.activity = "在宅"
+	Roles.hourly(w)
+	check(float(w.s.door_hp) > 60.0 and "noise" in Walkers.home_reasons(w), "the door is mended by day, with hammering")
+	# --- Scout: out for four hours, back with supplies from empty buildings.
+	await g._on_command("陸に探索を頼む")
+	w.s.district.sites["コンビニ"].vacant = true
+	w.s.walkers.places = {}
+	w.s.minute = 2 * 60 + 8 * 1440   # 10:00
+	riku.activity = "在宅"
+	riku.health = 100.0
+	w.s.walkers.notices = []
+	Roles.hourly(w)
+	check(riku.has("scouting") and riku.activity == "外出", "the scout sets out at ten")
+	var food0: float = w.s.food
+	w.s.minute += 4 * 60
+	w.s.walkers.notices = []
+	Roles.hourly(w)
+	check(not riku.has("scouting") and riku.activity == "在宅" and (float(w.s.food) > food0 or str(w.s.walkers.notices).contains("戻って")), "and comes back: " + str(w.s.walkers.notices))
+	# Many dead about: scouting can go wrong.
+	var hurt := 0
+	for i in 30:
+		riku.health = 100.0
+		riku.erase("bitten")
+		riku.scouting = {"until": int(w.s.minute)}
+		w.s.walkers.places = {"駅前": 60, "商店通り": 40}
+		w.s.minute += 97
+		w.s.walkers.notices = []
+		Roles.hourly(w)
+		if str(w.s.walkers.notices).contains("足を引きずって") or bool(riku.get("bitten", false)):
+			hurt += 1
+	check(hurt > 0 and hurt < 30, "with the town full of the dead, scouting is dangerous (%d of 30)" % hurt)
+	riku.erase("bitten")
+	riku.health = 100.0
+	# --- Medic: dresses wounds with bandages.
+	await g._on_command("詩音を手当て担当にする")
+	w.s.injuries = 3.0
+	w.s.inventory.bandage = 1
+	shion.activity = "在宅"
+	shion.erase("role_done_day")
+	w.s.minute += 1440
+	Roles.hourly(w)
+	check(float(w.s.injuries) < 3.0 and int(w.s.inventory.bandage) == 0, "the medic dresses wounds")
+	# --- Refusals and clearing.
+	shion.mood = 10.0
+	await g._on_command("詩音に見張りを頼む")
+	check(str(g.log_entries.slice(-3)).contains("引き受けられない"), "someone at the end of their tether refuses")
+	riku.age = 9
+	await g._on_command("陸に探索を頼む")
+	check(str(g.log_entries.slice(-3)).contains("子ども"), "a child is not sent out")
+	await g._on_command("蒼の役割を外す")
+	check(Roles.role_of(ao) == "", "a role can be cleared")
+	check(w.validate_state(w.s) and g._save().begins_with("保存") and g._load() == "保存データを読み込んだ。", "roles save and load")
+	print("v149.27 role checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
