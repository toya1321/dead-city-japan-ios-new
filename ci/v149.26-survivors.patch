@@ -0,0 +1,46 @@
+extends SceneTree
+## How long the shelter lasts in untouched worlds, and why it ends.
+const Main = preload("res://main.tscn")
+const Shelter = preload("res://scripts/shelter.gd")
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func run() -> void:
+	for helping in ([true] if OS.get_environment("DCJ_TRACE") == "1" else [false, true]):
+		await _pass(helping)
+	quit()
+
+func _pass(helping: bool) -> void:
+	print("--- player helping: %s" % helping)
+	for seed in ([13] if OS.get_environment("DCJ_TRACE") == "1" else [11, 12, 13, 14, 15, 16, 17, 18]):
+		var g = Main.instantiate()
+		root.add_child(g)
+		for i in 3: await process_frame
+		var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+		p.seed = seed
+		g._start_new_game(p)
+		g._finish_intro()
+		var w = g.world
+		var opened := -1
+		var line := ""
+		for h in 24 * 150:
+			w.s.health = 100.0; w.s.hunger = 0.0; w.s.thirst = 0.0; w.s.fatigue = 0.0
+			w.advance(60)
+			var st: Dictionary = Shelter.state(w)
+			if helping and str(st.status) == "open" and int(w.hour_of_day()) == 9:
+				st.watch_day = Shelter._day(w)
+				st.order = minf(90.0, float(st.order) + 4.0)
+				st.gate = minf(100.0, float(st.gate) + 5.0 + (30.0 if (h / 24) % 3 == 0 else 0.0))
+				if (h / 24) % 2 == 0:
+					st.stock = float(st.stock) + 15.0
+			if opened < 0 and str(st.status) == "open":
+				opened = h / 24
+			if OS.get_environment("DCJ_TRACE") == "1" and int(w.hour_of_day()) == 7 and str(st.status) == "open":
+				print("  d%d pop %d stock %.0f order %.0f garden %.0f town %d sick %d hungry %d" % [h / 24, st.pop, st.stock, st.order, st.get("garden", 0.0), load("res://scripts/walkers.gd").total(w), st.sick, st.hungry_days])
+			if str(st.status) in ["overrun", "abandoned"]:
+				line = "%s(%s) day %d" % [st.status, st.get("cause", ""), h / 24]
+				break
+		var st2: Dictionary = Shelter.state(w)
+		print("seed %d society %s opened day %d -> %s pop %d stock %.0f order %.0f gate %.0f outside %d sick %d supplied %s" % [seed, w.s.society, opened, line if line != "" else "still open", st2.pop, st2.stock, st2.order, st2.gate, st2.outside, st2.sick, st2.supplied])
+		g.queue_free()
