@@ -0,0 +1,223 @@
+extends RefCounted
+## v149.27: what a housemate is trusted to do. One role each:
+## - watch: notices figures in the street and the horde's approach, puts the
+##   lights out and says so; night watches are tiring
+## - cook: a warm meal for everyone in the evening (lifts everyone, smells)
+## - repair: mends the front door by day (hammering is heard outside)
+## - scout: after the breakdown, goes out for four hours by day to empty
+##   buildings and brings back food and water; can be hurt or bitten
+## - medic: dresses the household's wounds with bandages
+## A matching occupation does it better. Children are not sent out or set to
+## hammering; someone at the end of their tether refuses.
+
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+const WorldTraits = preload("res://scripts/world_traits.gd")
+
+const ROLES := {
+	"watch": {"label": "見張り", "words": ["見張り", "見張って", "見張る", "警戒"], "jobs": ["元自衛官", "警備員"]},
+	"cook": {"label": "料理", "words": ["料理", "ご飯", "食事の支度", "炊事"], "jobs": ["居酒屋の店主", "主婦"]},
+	"repair": {"label": "修理", "words": ["修理", "直して", "修繕", "大工仕事"], "jobs": ["大工"]},
+	"scout": {"label": "探索", "words": ["探索", "物資を探", "調達", "物資集め"], "jobs": ["元自衛官"]},
+	"medic": {"label": "手当て", "words": ["手当て", "治療", "看護", "けがの世話"], "jobs": ["看護師", "薬剤師"]},
+}
+## Words that make a line about a standing job, not a one-off request
+## ("詩音、料理して" stays a request to cook now).
+const ASSIGN_WORDS := ["担当", "係", "役割", "役目", "任せ", "毎日の", "毎晩の"]
+const ASK_WORDS := ["頼む", "頼んだ", "お願い"]
+const CLEAR_WORDS := ["役割を外", "役割をやめ", "役目を外", "仕事を外", "もうしなくていい", "休ませ"]
+
+static func role_of(person: Dictionary) -> String:
+	return str(person.get("role", ""))
+
+static func skilled(person: Dictionary, role: String) -> bool:
+	return str(person.get("job", "")) in ROLES[role].jobs
+
+## "詩音に見張りを頼む" → the role id, "" if the line is not about roles.
+static func parse(text: String) -> String:
+	for id in ROLES:
+		if not _has(text, ROLES[id].words):
+			continue
+		if _has(text, ASSIGN_WORDS) or (id in ["watch", "scout"] and _has(text, ASK_WORDS)):
+			return id
+	return ""
+
+static func _has(text: String, words: Array) -> bool:
+	for word in words:
+		if text.contains(word):
+			return true
+	return false
+
+static func assign(world, person: Dictionary, role: String) -> String:
+	var name := str(person.name)
+	if float(person.health) <= 0:
+		return "%sは、もう何もできない。" % name
+	if bool(person.get("bitten", false)):
+		return "%sは熱で起き上がれない。役割を任せられる状態ではない。" % name
+	if int(person.get("age", 30)) < 13 and role in ["scout", "repair"]:
+		return "%sはまだ子どもだ。%sは任せられない。" % [name, ROLES[role].label]
+	if Mood.of(person) < 20.0:
+		return "%s「……ごめん。今は、何も引き受けられない」" % name
+	person.role = role
+	person.erase("role_done_day")
+	var bonus := "（%sの経験が生きる）" % str(person.job) if skilled(person, role) else ""
+	var lines := {
+		"watch": "%s「分かった。外の様子は、私が見ておく」%s" % [name, bonus],
+		"cook": "%s「任せて。夜は温かいものを作るよ」%s" % [name, bonus],
+		"repair": "%s「扉は昼のうちに、少しずつ直しておく」%s" % [name, bonus],
+		"scout": "%s「昼のうちに、空いた建物を回ってみる。無理はしない」%s" % [name, bonus],
+		"medic": "%s「けがをしたら、すぐ言って。手当てする」%s" % [name, bonus],
+	}
+	return str(lines[role])
+
+static func clear(person: Dictionary) -> String:
+	if role_of(person).is_empty():
+		return "%sには、今は役割を任せていない。" % person.name
+	var label: String = ROLES[role_of(person)].label
+	person.erase("role")
+	return "%sの%sの役割を外した。" % [person.name, label]
+
+static func summary(world) -> String:
+	var lines: Array = []
+	for person in world.s.household_members:
+		var role := role_of(person)
+		lines.append("%s：%s" % [person.name, ROLES[role].label if not role.is_empty() else "なし"])
+	if lines.is_empty():
+		return "同居人はいない。"
+	return "役割　" + "、".join(lines) + "\n（例：「%sに見張りを頼む」「%sを料理担当にする」。見張り・料理・修理・探索・手当て）" % [world.s.household_members[0].name, world.s.household_members[0].name]
+
+static func _able(world, person: Dictionary) -> bool:
+	return float(person.health) > 0 and not bool(person.get("bitten", false)) and Mood.of(person) >= 20.0 and str(person.get("isolated", "")).is_empty()
+
+static func _home(person: Dictionary) -> bool:
+	return str(person.get("activity", "")) != "外出" and not person.has("scouting")
+
+## Hourly, after the walkers have moved.
+static func hourly(world) -> void:
+	var minute := int(world.s.minute)
+	var hour := int(world.hour_of_day())
+	var day := minute / 1440
+	var night := hour < 6 or hour >= 18
+	var notices: Array = world.s.walkers.notices if world.s.has("walkers") else []
+	var w: Dictionary = world.s.get("walkers", {})
+	for person in world.s.household_members:
+		var role := role_of(person)
+		# A scout out of the house comes back on time, whatever their state.
+		if person.has("scouting") and minute >= int(person.scouting.until):
+			notices.append(_return(world, person))
+			continue
+		if role.is_empty() or not _able(world, person):
+			continue
+		var good := skilled(person, role)
+		match role:
+			"watch":
+				if not _home(person):
+					continue
+				if night:
+					person.fatigue = minf(100.0, float(person.fatigue) + (1.0 if good else 2.0))
+					if str(person.get("activity", "")) == "睡眠":
+						person.activity = "在宅"
+						person.location = "居間"
+				var horde: Dictionary = w.get("horde", {})
+				var horde_near: bool = not horde.is_empty() and str(horde.place) in ["住宅街", "屋外", "商店通り"]
+				var raid: bool = world.s.get("raid", {}) is Dictionary and not world.s.get("raid", {}).is_empty()
+				var trouble: bool = w.has("drawn_at") or Walkers.count(world, "建物前") > 0 or horde_near or raid
+				if trouble and night and world.has_home_power() and not bool(world.s.get("lights_off", false)) and not bool(world.s.get("blackout", false)):
+					world.s.lights_off = true
+					w.erase("drawn_at")
+					notices.append("%s「%s。明かりを消したよ」" % [person.name, "外に人の声がする" if raid else "通りに人影が見える"])
+				elif horde_near and int(person.get("warned_horde_at", -1)) != int(horde.get("step", -1)) and int(horde.step) <= 1:
+					person.warned_horde_at = int(horde.step)
+					notices.append("%s「群れが動き出した。こっちに来るかもしれない。静かにしていよう」" % person.name)
+			"cook":
+				if hour == 18 and _home(person) and int(person.get("role_done_day", -1)) != day:
+					person.role_done_day = day
+					var heat: String = load("res://scripts/home_life.gd").heat_source(world)
+					var eaters: int = 1 + world.s.household_members.filter(func(m): return float(m.health) > 0 and _home(m)).size()
+					if heat.is_empty() or float(world.s.food) < 0.25:
+						notices.append("%s「今日は火も食材も足りなくて、温かいものは作れなかった。ごめん」" % person.name)
+						continue
+					if heat == "cassette":
+						world.s.gas_cans = maxf(0.0, float(world.s.get("gas_cans", 0.0)) - 0.25)
+					var lift := 6.0 if good else 4.0
+					Mood.change(world.s, lift)
+					for m in world.s.household_members:
+						if float(m.health) > 0 and _home(m):
+							Mood.change(m, lift)
+					Walkers.make_smell(world, 60)
+					notices.append("%sが夕食を作った。湯気の立つ鍋を、%d人で囲んだ。換気扇から、においが外に流れていく。" % [person.name, eaters])
+			"repair":
+				if hour >= 9 and hour <= 16 and _home(person) and int(person.get("role_done_day", -1)) != day:
+					var hp := float(world.s.get("door_hp", 100.0))
+					if hp >= 100.0 and not bool(world.s.get("door_broken", false)):
+						continue
+					person.role_done_day = day
+					if bool(world.s.get("door_broken", false)):
+						if int(world.s.inventory.wood) < 1 or int(world.s.inventory.parts) < 1:
+							notices.append("%s「扉を直したいけど、木材と部品が足りない」" % person.name)
+							continue
+						world.s.inventory.wood = int(world.s.inventory.wood) - 1
+						world.s.inventory.parts = int(world.s.inventory.parts) - 1
+						world.s.door_broken = false
+						world.s.door_hp = 60.0 if good else 40.0
+					else:
+						world.s.door_hp = minf(100.0, hp + (35.0 if good else 20.0))
+					Walkers.make_noise(world, "玄関", 60)
+					person.fatigue = minf(100.0, float(person.fatigue) + 8.0)
+					notices.append("%sが玄関の扉を直した。金づちの音が、外に響いた。" % person.name)
+			"scout":
+				if hour == 10 and _home(person) and int(person.get("role_done_day", -1)) != day and float(person.health) >= 60.0 and str(person.get("activity", "")) != "睡眠":
+					person.role_done_day = day
+					if not WorldTraits.reached(world, "disrupted"):
+						continue
+					person.scouting = {"until": minute + 4 * 60}
+					person.activity = "外出"
+					person.location = "屋外"
+					notices.append("%sが、空いた建物を探しに出かけていった。「暗くなる前には戻る」" % person.name)
+			"medic":
+				if int(person.get("role_done_day", -1)) == day or not _home(person) or int(world.s.inventory.get("bandage", 0)) < 1:
+					continue
+				if float(world.s.get("injuries", 0)) > 0:
+					person.role_done_day = day
+					world.s.inventory.bandage = int(world.s.inventory.bandage) - 1
+					world.s.injuries = maxf(0.0, float(world.s.injuries) - (3.0 if good else 2.0))
+					notices.append("%sが、あなたの傷を手当てしてくれた。（包帯1つ）" % person.name)
+
+## A scout comes home: supplies, an injury, or a bite.
+static func _return(world, person: Dictionary) -> String:
+	person.erase("scouting")
+	person.activity = "在宅"
+	person.location = "居間"
+	person.fatigue = minf(100.0, float(person.fatigue) + 20.0)
+	var minute := int(world.s.minute)
+	var good := skilled(person, "scout")
+	var risk := clampi(Walkers.total(world) / 4 - (8 if good else 0), 3, 35)
+	var roll: int = world.draw(minute, int(person.id), "scout", 100)
+	if roll < risk / 3:
+		var index: int = world.s.household_members.find(person)
+		Walkers.bite_housemate(world, index)
+		return "【危険】%sが、青い顔で戻ってきた。袖の下から血がにじんでいる。「……つかまった。噛まれたかもしれない」" % person.name
+	if roll < risk:
+		person.health = maxf(1.0, float(person.health) - 20.0)
+		return "%sが、足を引きずって戻ってきた。「感染者に追われて、転んだ。……何も持ってこられなかった」" % person.name
+	# What empty buildings still hold.
+	var found_food := 0.0
+	var found_water := 0.0
+	for site in world.s.district.sites:
+		var s: Dictionary = world.s.district.sites[site]
+		if not bool(s.vacant):
+			continue
+		var take_food := minf(float(s.food), 2.0 - found_food)
+		var take_water := minf(float(s.water), 4.0 - found_water)
+		s.food = float(s.food) - take_food
+		s.water = float(s.water) - take_water
+		found_food += take_food
+		found_water += take_water
+		if found_food >= 2.0 and found_water >= 4.0:
+			break
+	if found_food <= 0.0 and found_water <= 0.0:
+		return "%sが戻ってきた。「空いた建物は、どこももう空っぽだった」" % person.name
+	world.s.food = float(world.s.food) + found_food
+	world.s.water = float(world.s.water) + found_water
+	Mood.change(person, 3.0)
+	return "%sが無事に戻ってきた。食料%.1f人日分と、水%.0fLを持ち帰った。" % [person.name, found_food, found_water]
