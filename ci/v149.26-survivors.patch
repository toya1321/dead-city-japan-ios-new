diff --git a/scripts/shelter.gd b/scripts/shelter.gd
new file mode 100644
index 0000000..d985161
--- /dev/null
+++ b/scripts/shelter.gd
@@ -0,0 +1,384 @@
+extends RefCounted
+## v149.27: the district's elementary school as an evacuation shelter.
+## It opens when life breaks down. Whether it lasts is not decided in advance;
+## like the house, it falls only for reasons:
+## - infection inside: newcomers hide bites; one turns at night. The watch
+##   holds them down if order is good (and better if the player keeps watch)
+## - the gate: walkers drawn by the crowd gather at the fence and wear the
+##   gate down; volunteers mend it while order holds, and the player can too
+## - hunger: the city's supplies stop some time into the emergency (at once
+##   if this world's "shelter_closed" event comes); with the store empty,
+##   order breaks and people leave, until the shelter is abandoned
+## The player can live there: queue for the daily ration, sleep among the
+## others (company, but noise and theft when order is poor), keep watch,
+## mend the gate, donate food. State: `s.shelter` (see `state`).
+
+const Survivors = preload("res://scripts/survivors.gd")
+const WorldTraits = preload("res://scripts/world_traits.gd")
+const Mood = preload("res://scripts/mood.gd")
+const Walkers = preload("res://scripts/walkers.gd")
+const PLACE := "避難所"
+const CAPACITY := 180
+const STATUSES := ["school", "open", "overrun", "abandoned"]
+
+static func state(world) -> Dictionary:
+	if not world.s.has("shelter") or not world.s.shelter is Dictionary:
+		world.s.shelter = {}
+	var st: Dictionary = world.s.shelter
+	var defaults := {"status": "school", "ration_day": -1, "pop": 0, "stock": 0.0, "order": 70.0, "gate": 60.0,
+			"outside": 0, "sick": 0, "supplied": true, "supply_end": -1, "hungry_days": 0, "watch_day": -1, "tick_day": -1, "garden": 0.0}
+	for key in defaults:
+		if not st.has(key):
+			st[key] = defaults[key]
+	return st
+
+static func status(world) -> String:
+	return str(world.s.shelter.get("status", "school")) if world.s.get("shelter") is Dictionary else "school"
+
+static func is_open(world) -> bool:
+	return status(world) == "open"
+
+static func valid(value: Variant) -> bool:
+	return value is Dictionary and str(value.get("status", "school")) in STATUSES
+
+## The calendar day (it turns at midnight, not at the start time).
+static func _day(world) -> int:
+	return (int(float(world.s.get("start_hour", 0)) * 60.0) + int(world.s.minute)) / 1440
+
+static func _notice(world, text: String) -> void:
+	if world.s.has("walkers"):
+		world.s.walkers.notices.append(text)
+
+static func _player_here(world) -> bool:
+	return world.has_meta("player_place") and str(world.get_meta("player_place")) == PLACE
+
+static func hourly(world) -> void:
+	var st := state(world)
+	var minute := int(world.s.minute)
+	var hour := int(world.hour_of_day())
+	var day := _day(world)
+	if str(st.status) == "school":
+		if WorldTraits.reached(world, "disrupted"):
+			st.status = "open"
+			st.pop = 60 + world.draw(minute, 20, "shelter-pop", 40)
+			st.stock = float(st.pop) * 4.0
+			st.tick_day = day
+		return
+	if str(st.status) != "open":
+		return
+	var traits: Dictionary = WorldTraits.of(world)
+	if bool(st.supplied) and "shelter_closed" in traits.get("done_events", []):
+		st.supplied = false
+		st.order = float(st.order) - 25.0
+		_notice(world, "【記録】区の職員が避難所から引き上げたらしい。これからは、物資の補給がない。")
+	if bool(st.supplied) and int(st.supply_end) < 0 and WorldTraits.reached(world, "emergency"):
+		st.supply_end = minute + (2 + world.draw(minute, 21, "shelter-supply", 8)) * 1440
+	if bool(st.supplied) and int(st.supply_end) >= 0 and minute >= int(st.supply_end):
+		st.supplied = false
+		_notice(world, "【記録】避難所への物資のトラックが、来なくなったらしい。")
+	if hour == 6 and int(st.tick_day) != day:
+		st.tick_day = day
+		_daily(world, st, minute)
+	elif hour == 2 and int(st.sick) > 0:
+		_night(world, st, minute)
+
+static func _daily(world, st: Dictionary, minute: int) -> void:
+	if str(st.status) != "open":
+		return
+	var society := str(world.s.society)
+	var arrivals := 0
+	var bite := 0
+	match society:
+		"disrupted":
+			arrivals = 3 + world.draw(minute, 22, "shelter-in", 10); bite = 2
+		"emergency":
+			arrivals = 8 + world.draw(minute, 22, "shelter-in", 20); bite = 6
+		_:
+			arrivals = world.draw(minute, 22, "shelter-in", 5); bite = 10
+	var watched := int(st.watch_day) >= _day(world) - 1
+	var hidden := 0
+	for i in arrivals:
+		var chance := bite * (3 if watched or float(st.order) >= 70.0 else 10)
+		if world.draw(minute, 230 + i, "shelter-bite", 1000) < chance:
+			hidden += 1
+	# The gym holds so many; the rest are turned away at the gate.
+	arrivals = mini(arrivals, maxi(0, CAPACITY - int(st.pop)))
+	# Word gets round when there is no food: nobody new comes.
+	if float(st.stock) < float(st.pop):
+		arrivals = 0
+	st.pop = int(st.pop) + arrivals
+	st.sick = int(st.sick) + mini(hidden, arrivals)
+	# Food: the city's trucks until they stop; then what volunteers bring
+	# back from empty houses (less as the town fills with the dead), and gifts.
+	if bool(st.supplied):
+		st.stock = float(st.stock) + float(st.pop) * 0.6
+	else:
+		var town := Walkers.total(world) if world.s.has("walkers") else 0
+		var scarce := clampf(1.0 - float(town) / 80.0, 0.3, 1.0)
+		# Volunteers go out (more hands, but the same empty houses), and the
+		# schoolyard beds, dug once things settle, feed a few more each week.
+		st.stock = float(st.stock) + (8.0 + float(st.pop) * 0.15) * float(st.order) / 100.0 * scarce
+		if float(st.order) >= 30.0:
+			st.garden = minf(20.0, float(st.get("garden", 0.0)) + 1.0)
+		st.stock = float(st.stock) + float(st.get("garden", 0.0))
+	st.stock = float(st.stock) - float(st.pop) * 0.5
+	if float(st.stock) <= 0.0:
+		st.stock = 0.0
+		st.hungry_days = int(st.hungry_days) + 1
+		st.order = float(st.order) - 5.0
+		st.pop = int(int(st.pop) * 0.8)   # people leave to try their luck
+	else:
+		st.hungry_days = 0
+		if float(st.stock) >= float(st.pop) * 2.0:
+			st.order = float(st.order) + 3.0
+		elif float(st.stock) < float(st.pop):
+			st.pop = int(int(st.pop) * 0.95)
+	if int(st.pop) > 150:
+		st.order = float(st.order) - 2.0
+	elif int(st.pop) < 80 and float(st.order) < 60.0:
+		st.order = float(st.order) + 2.0   # fewer mouths, calmer nights
+	st.order = clampf(float(st.order), 0.0, 90.0)
+	# The crowd's noise and lights draw walkers to the fence.
+	var drawn := 0
+	if world.s.has("walkers"):
+		drawn = world.draw(minute, 24, "shelter-fence", maxi(2, int((2.0 + float(Walkers.total(world)) / 15.0) * float(st.pop) / 100.0) + 1))
+	st.outside = mini(40, int(st.outside) + drawn - int(st.outside) / 5)
+	st.gate = float(st.gate) - maxf(0.0, float(st.outside) - 6.0) * 0.8
+	if float(st.order) >= 40.0:
+		st.gate = float(st.gate) + float(st.order) / 8.0
+	st.gate = clampf(float(st.gate), 0.0, 100.0)
+	if float(st.gate) <= 0.0 and int(st.outside) >= 8:
+		_fall(world, "gate")
+	elif (int(st.hungry_days) >= 8 and float(st.order) < 30.0) or int(st.pop) < 10:
+		_abandon(world)
+
+## A hidden bite turns at night.
+static func _night(world, st: Dictionary, minute: int) -> void:
+	st.sick = int(st.sick) - 1
+	var hold := 30 + int(float(st.order)) + (25 if int(st.watch_day) >= _day(world) - 1 else 0)
+	if world.draw(minute, 25, "shelter-turn", 100) < hold:
+		var hurt: int = 1 + world.draw(minute, 26, "shelter-hurt", 3)
+		st.pop = maxi(0, int(st.pop) - hurt)
+		st.sick = int(st.sick) + world.draw(minute, 27, "shelter-spread", 2)
+		st.order = maxf(0.0, float(st.order) - 8.0)
+		var text := "夜中、体育館で悲鳴が上がった。発症した人が暴れ出し、見張りの人たちが取り押さえた。%d人が噛まれ、校舎の外へ連れ出されていった。" % hurt
+		if _player_here(world):
+			Mood.change(world.s, -6.0)
+			_notice(world, "【危険】" + text)
+		else:
+			_notice(world, "【記録】避難所で、夜中に発症した人が出たらしい。")
+		return
+	_fall(world, "inside")
+
+## Overrun: the dead are inside. Many do not get out.
+static func _fall(world, cause: String) -> void:
+	var st := state(world)
+	st.status = "overrun"
+	st.cause = cause
+	if world.s.has("walkers"):
+		world.s.walkers.places[PLACE] = int(world.s.walkers.places.get(PLACE, 0)) + 12
+	var lost: Array = []
+	var people: Dictionary = Survivors.ensure(world).people
+	for id in people:
+		var p: Dictionary = people[id]
+		if str(p.place) != PLACE or str(p.status) != "alive":
+			continue
+		if world.draw(int(world.s.minute), absi(hash(id)) % 1000, "shelter-flee", 100) < 35:
+			p.place = "住宅街"
+			continue
+		p.status = "dead"
+		p.cause = "shelter"
+		p.died = int(world.s.minute)
+		if bool(p.met) or bool(p.get("former", false)):
+			lost.append(str(p.name))
+	var how := "門が破られ、感染者がなだれ込んだ" if cause == "gate" else "体育館の中で発症した人を止められず、感染が広がった"
+	if _player_here(world):
+		world.s.walkers.alarm = true
+		world.s.health = maxf(1.0, float(world.s.health) - 10.0)
+		Mood.change(world.s, -15.0)
+		_notice(world, "【危険】%s。悲鳴と足音の中、人を押しのけて逃げ道を探す。……すぐにここを出なければ。" % how)
+	else:
+		_notice(world, "【記録】避難所の小学校で、%sらしい。多くの人が逃げ遅れた。%s" % [how, (("……%sも、あそこにいたはずだ。" % "、".join(lost)) if not lost.is_empty() else "")])
+
+## Hunger and distrust empty the shelter without the dead.
+static func _abandon(world) -> void:
+	var st := state(world)
+	st.status = "abandoned"
+	st.pop = 0
+	var people: Dictionary = Survivors.ensure(world).people
+	for id in people:
+		var p: Dictionary = people[id]
+		if str(p.place) == PLACE and str(p.status) == "alive":
+			p.place = "住宅街"
+	_notice(world, "【記録】避難所の食料が尽き、人々は散り散りに出ていったらしい。小学校は、もう空っぽだ。")
+
+## A housemate who left with a note goes to the shelter, where they can be
+## found again and brought home. If it is not open, they go elsewhere.
+static func admit(world, mate: Dictionary) -> void:
+	var people: Dictionary = Survivors.ensure(world).people
+	var id := "former_%s" % str(mate.name)
+	var male := str(mate.get("gender", "")) == "男性"
+	var here := is_open(world)
+	people[id] = {
+		"id": id, "name": str(mate.name), "label": str(mate.name), "age": int(mate.get("age", 25)), "gender": "男性" if male else "女性",
+		"role": "former", "job": str(mate.get("job", "")), "situation": "", "tag": "", "place": PLACE if here else "住宅街",
+		"background": "以前、あなたの家で一緒に暮らしていた。限界になって、書き置きを残して出ていった。", "secret": "",
+		"trait": str(mate.get("trait", "人に気をつかう")), "traits": {"honesty": int(mate.get("honesty", 60)), "courage": 40, "temper": 30, "loyalty": 70, "suspicion": 20},
+		"voice": "young", "style": "丁寧だが少し早口な話し方", "first_person": "俺" if male else "私",
+		"needs": [], "offers": [], "info": "体育館は人でいっぱいで、毎晩けんかが起きてる。食べ物も、もう少ない。" if here else "避難所は開いてなかった。空き家を転々としてる。",
+		"joinable": true, "join_trust": 60, "intro": ("体育館の隅に、%sがいた。" if here else "路地の陰に、%sがいた。") % str(mate.name) + "こちらに気づくと、気まずそうに目をそらした。「……来てくれたんだ」",
+		"status": "alive", "met": false, "trust": 70, "known_name": true, "given": 0, "talks": 0, "talk_at": -100000, "traded": [],
+		"former": true, "left_at": int(world.s.minute), "detail": "", "likes": "",
+	}
+
+## Once a day, a little water and food for whoever queues, while it lasts.
+static func ration(world) -> String:
+	var st := state(world)
+	if not is_open(world):
+		return "避難所は開いていない。" if str(st.status) == "school" else "もう配給をする人はいない。"
+	var day := _day(world)
+	if int(st.ration_day) == day:
+		return "今日の配給は、もう受け取った。"
+	if float(st.stock) < 1.0:
+		return "配給の列はあるが、配るものが残っていない。係の人が頭を下げ続けている。"
+	world.advance_safe(60)
+	st.ration_day = day
+	var bag: Dictionary = world.s.district.bag
+	var lean := not bool(st.supplied)
+	var water := minf(1.0 if lean else 2.0, 8.0 - float(bag.water))
+	var food := minf(0.5 if lean else 1.0, 4.0 - float(bag.food))
+	bag.water = float(bag.water) + water
+	bag.food = float(bag.food) + food
+	st.stock = maxf(0.0, float(st.stock) - food)
+	return "体育館の長い列に1時間並び、配給を受け取った（水%.0fL、食料%.1f人日分）。%s" % [water, food, "量が、前より減っている。" if lean else "係の人の顔にも、疲れがにじんでいる。"]
+
+static func board(world) -> String:
+	var names: Array = []
+	for id in Survivors.ensure(world).people:
+		var p: Dictionary = Survivors.person(world, id)
+		if str(p.place) == PLACE and str(p.status) == "alive":
+			names.append("「%s、無事です。体育館にいます」" % p.name)
+	var lines := "入口の掲示板には、家族を探す紙がびっしりと貼られている。"
+	if not names.is_empty():
+		lines += "その中に、" + "、".join(names) + "という紙もあった。"
+	return lines
+
+## What a person can see and hear here: crowd, food, mood, the gate.
+static func report(world) -> String:
+	var st := state(world)
+	if not is_open(world):
+		return describe(world)
+	world.advance_safe(10)
+	var pop := int(st.pop)
+	var crowd := "体育館は人であふれ、廊下にまで毛布が敷かれている" if pop > 150 else ("体育館は人でいっぱいだ" if pop > 80 else "体育館には、まだ少し隙間がある")
+	var days := float(st.stock) / maxf(1.0, float(pop) * 0.5)
+	var food := "倉庫の段ボールは山積みだ" if bool(st.supplied) and days >= 4 else ("食料は、あと数日分だと係の人がこぼしていた" if days >= 2 else "食料は、ほとんど残っていないらしい")
+	var mood := "係の人たちが落ち着いて仕切っている" if float(st.order) >= 60 else ("あちこちで言い争いが起きている" if float(st.order) >= 30 else "誰も係の人の言うことを聞いていない。物の取り合いが起きている")
+	var gate := "門は頑丈に閉ざされている" if float(st.gate) >= 60 else ("門のあちこちが歪んでいる" if float(st.gate) >= 25 else "門は今にも外れそうだ")
+	var fence := "" if int(st.outside) <= 0 else ("フェンスの外に、感染者が%sいる。" % ("何体か" if int(st.outside) < 8 else "大勢"))
+	var cough := "毛布をかぶって咳き込んでいる人が、何人か目につく。" if int(st.sick) > 0 and float(st.order) < 60 else ""
+	return "%s。%s。%s。%s。%s%s" % [crowd, food, mood, gate, fence, cough]
+
+## Four hours at the gate and the entrance: newcomers are checked, the gate
+## is looked after, and the watch is stronger tonight.
+static func keep_watch(world) -> String:
+	var st := state(world)
+	if not is_open(world):
+		return "見張る相手が、もういない。"
+	var minute := int(world.s.minute)
+	world.advance_safe(240)
+	st.watch_day = _day(world)
+	st.order = minf(90.0, float(st.order) + 4.0)
+	st.gate = minf(100.0, float(st.gate) + 5.0)
+	world.s.fatigue = minf(100.0, float(world.s.fatigue) + 12.0)
+	Mood.change(world.s, 2.0)
+	var found := ""
+	if int(st.sick) > 0 and world.draw(minute, 28, "shelter-spot", 100) < 40:
+		st.sick = int(st.sick) - 1
+		found = "受付で、袖を押さえて顔色の悪い人がいた。腕を見せてもらうと、噛み傷があった。係の人が、黙って別の教室へ連れていった。"
+	return "4時間、校門と受付の見張りに立った。%s係の人に「助かったよ」と声をかけられた。" % found
+
+## Mending the gate with wood from the house.
+static func mend_gate(world) -> String:
+	var st := state(world)
+	if not is_open(world):
+		return "直しても、守る人がもういない。"
+	if int(world.s.inventory.get("wood", 0)) < 1:
+		return "門を補強する木材がない（木材1が必要）。"
+	world.s.inventory.wood = int(world.s.inventory.wood) - 1
+	world.advance_safe(60)
+	st.gate = minf(100.0, float(st.gate) + 30.0)
+	world.s.fatigue = minf(100.0, float(world.s.fatigue) + 6.0)
+	return "木材を打ちつけて、校門の歪みを補強した。金づちの音に、フェンスの外の感染者が顔を上げた。"
+
+## Half a day out with the shelter's volunteers, through empty houses.
+static func supply_run(world) -> String:
+	var st := state(world)
+	if not is_open(world):
+		return "一緒に行く人が、もういない。"
+	var minute := int(world.s.minute)
+	var hour: float = world.hour_of_day()
+	if hour < 7.0 or hour >= 15.0:
+		return "物資探しの班は、朝のうちに出発する（7〜15時）。"
+	if float(world.s.health) < 50.0:
+		return "係の人に止められた。「その体じゃ無理だ。休んでて」"
+	world.advance_safe(300)
+	world.s.fatigue = minf(100.0, float(world.s.fatigue) + 20.0)
+	var town := Walkers.total(world) if world.s.has("walkers") else 0
+	var roll: int = world.draw(minute, 30, "shelter-run", 100)
+	if roll < clampi(town / 4, 3, 30):
+		world.s.health = maxf(1.0, float(world.s.health) - 20.0)
+		world.s.injuries = float(world.s.injuries) + 1.0
+		return "【危険】班で住宅を回っている途中、感染者の群れに出くわした。逃げる途中で転び、腕をすりむいた。何も持ち帰れなかった。"
+	var found := float(12 + world.draw(minute, 31, "shelter-found", 18)) * clampf(1.0 - float(town) / 80.0, 0.2, 1.0)
+	st.stock = float(st.stock) + found
+	st.order = minf(90.0, float(st.order) + 3.0)
+	Mood.change(world.s, 3.0)
+	return "避難所の班と5時間、空き家を回った。缶詰や米を集め、およそ%d人日分の食料を倉庫に運び込んだ。" % int(found)
+
+static func donate(world) -> String:
+	var st := state(world)
+	if not is_open(world):
+		return "受け取る人がいない。"
+	var bag: Dictionary = world.s.district.bag
+	var food := minf(2.0, float(bag.food))
+	if food < 0.5:
+		return "寄付できる食料を持っていない（持ち出し袋の食料を渡す）。"
+	bag.food = float(bag.food) - food
+	world.advance_safe(5)
+	st.stock = float(st.stock) + food
+	st.order = minf(90.0, float(st.order) + 2.0)
+	Mood.change(world.s, 2.0)
+	return "持ち出し袋の食料%.1f人日分を、倉庫の係に渡した。「ありがとう、子どもたちに回すよ」" % food
+
+## A night on a blanket in the gym: not alone, but never quiet; and when
+## order is poor, things go missing.
+static func sleep_night(world) -> String:
+	var st := state(world)
+	var minute := int(world.s.minute)
+	var elapsed: int = world.advance_safe(480, true)
+	var lines := "%d分、体育館の毛布の上で眠った。" % elapsed
+	if not is_open(world):
+		return lines
+	Mood.change(world.s, 3.0 if float(st.order) >= 50 else -2.0)
+	world.s.fatigue = minf(100.0, float(world.s.fatigue) + 8.0)   # never deep sleep in a crowd
+	lines += "まわりの寝息と、誰かのすすり泣きが一晩中聞こえていた。"
+	if float(st.order) < 40.0 and world.draw(minute, 29, "shelter-theft", 100) < 50:
+		var bag: Dictionary = world.s.district.bag
+		var food := minf(1.0, float(bag.food))
+		var water := minf(2.0, float(bag.water))
+		bag.food = float(bag.food) - food
+		bag.water = float(bag.water) - water
+		if food + water > 0.0:
+			lines += "朝、持ち出し袋が開けられていた。食料%.1f人日分と水%.0fLがなくなっている。" % [food, water]
+	return lines
+
+static func describe(world) -> String:
+	match status(world):
+		"school":
+			return "区立小学校。授業は休みで、校門は閉まっている。"
+		"open":
+			return "区立小学校の避難所。体育館に毛布が並び、疲れた顔の人々が身を寄せ合っている。入口で配給の列ができている。"
+		"abandoned":
+			return "避難所だった小学校。体育館には毛布と段ボールが散らばったまま、誰もいない。"
+	return "避難所だった小学校。校門は倒れ、体育館の窓は割れている。中から、うめき声が聞こえる。"
