+extends SceneTree
+## 400 days of world time with a household kept alive; checks the state each day.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+func _initialize() -> void:
+	call_deferred("run")
+func run() -> void:
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = int(OS.get_environment("DCJ_SEED")) if not OS.get_environment("DCJ_SEED").is_empty() else 4242
+	p.cohabitants = 2
+	p.companion_names = ["詩音", "蒼"]
+	p.companion_genders = ["女性", "男性"]
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	var w = g.world
+	var bad := 0
+	for day in 400:
+		for h in 24:
+			w.s.food = maxf(float(w.s.food), 5.0)
+			w.s.water = maxf(float(w.s.water), 10.0)
+			w.s.health = maxf(float(w.s.health), 50.0)
+			for m in w.s.household_members:
+				m.health = maxf(float(m.health), 50.0)
+			w.advance_safe(60)
+		g._refresh()
+		if not w.validate_state(w.s):
+			bad += 1
+			print("BAD state day ", day)
+		if day % 50 == 0 or day in [59, 61, 365, 399]:
+			var horde: Dictionary = w.s.walkers.get("horde", {})
+			print("day %d %s walkers %d horde %s mood %.0f household %d survivors alive %d photo %s" % [day, w.s.society, Walkers.total(w), horde.get("place", "-"), float(w.s.get("mood", 70)), w.s.household_members.size(), Survivors.ensure(w).people.values().filter(func(x): return x.status == "alive").size(), str(g.picture.texture.resource_path).get_file() if g.picture.texture else "-"])
+		if day % 30 == 0:
+			for cmd in ["窓から外を見る", "ニュースを見る", "周囲を見る"]:
+				await g._on_command(cmd)
+	print("LONGSIM bad days: ", bad)
+	quit()
