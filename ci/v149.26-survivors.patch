+	mate.role = "watch"
+	mate.activity = "在宅"
+	mate.mood = 60.0
+	w3.s.lights_off = false
+	w3.s.raid = {"at": int(w3.s.minute), "size": 2}
+	w3.s.walkers.notices = []
+	load("res://scripts/roles.gd").hourly(w3)
+	check(bool(w3.s.lights_off) and str(w3.s.walkers.notices).contains("人の声"), "the watch puts the light out")
+	check(w3.validate_state(w3.s) and g3._save().begins_with("保存") and g3._load() == "保存データを読み込んだ。", "a save during a raid loads")
+	print("v149.27 shelter and raid checks failed: %d" % failures)
+	quit(1 if failures > 0 else 0)
