@@ -0,0 +1,103 @@
+extends RefCounted
+## v149.27: looters. People, not the dead. Like the dead they come for a
+## reason: a light showing at night once society has broken down. They talk
+## outside the door first; the household has an hour to answer: put the
+## light out, shout them away, hand over a little food, or fight. Left alone
+## they rob an open door and threaten a locked one.
+## State: `s.raid = {} | {"at", "size"}`.
+
+const Walkers = preload("res://scripts/walkers.gd")
+const Mood = preload("res://scripts/mood.gd")
+const WorldTraits = preload("res://scripts/world_traits.gd")
+
+static func active(world) -> bool:
+	return world.s.get("raid", {}) is Dictionary and not world.s.get("raid", {}).is_empty()
+
+static func valid(value: Variant) -> bool:
+	return value is Dictionary and (value.is_empty() or (value.has("at") and value.has("size")))
+
+static func _light_showing(world) -> bool:
+	return "light" in Walkers.home_reasons(world)
+
+static func hourly(world) -> void:
+	var minute := int(world.s.minute)
+	var hour: float = world.hour_of_day()
+	var night := hour < 6.0 or hour >= 18.0
+	var notices: Array = world.s.walkers.notices if world.s.has("walkers") else []
+	if not active(world):
+		if not night or not WorldTraits.reached(world, "disrupted") or not _light_showing(world):
+			return
+		if world.draw(minute, 31, "raid", 100) >= 6:
+			return
+		world.s.raid = {"at": minute, "size": 2 + world.draw(minute, 32, "raid-size", 3)}
+		world.s.walkers.alarm = true
+		Mood.everyone(world, -4.0)
+		notices.append("【危険】玄関の外で、人の声がする。「おい、明かりがついてるぞ。誰かいる」……感染者ではない。人間だ。%d人はいる。" % int(world.s.raid.size))
+		return
+	if minute - int(world.s.raid.at) < 60:
+		return
+	_resolve(world, notices)
+
+static func _resolve(world, notices: Array) -> void:
+	var raid: Dictionary = world.s.raid
+	world.s.raid = {}
+	if not _light_showing(world):
+		notices.append("玄関の外の声が、しばらく何か言い合っていた。「……気のせいか」足音が遠ざかっていった。")
+		return
+	var open: bool = (not bool(world.s.door_locked) and int(world.s.barricade) <= 0) or (bool(world.s.get("door_broken", false)) and int(world.s.barricade) <= 0)
+	if open:
+		notices.append(_rob(world, "扉が開き、男たちが押し入ってきた。"))
+		return
+	world.s.longplay.shelter_integrity = maxf(0.0, float(world.s.longplay.shelter_integrity) - 3.0)
+	Mood.everyone(world, -5.0)
+	notices.append("【危険】男たちは扉を何度も叩き、「開けろ！」と怒鳴った。……やがて「また来るからな」と言い残して去っていった。")
+
+static func _rob(world, lead: String) -> String:
+	var food := minf(3.0, float(world.s.food))
+	var water := minf(6.0, float(world.s.water))
+	var cash := mini(10000, int(world.s.cash))
+	world.s.food = float(world.s.food) - food
+	world.s.water = float(world.s.water) - water
+	world.s.cash = int(world.s.cash) - cash
+	Mood.everyone(world, -10.0)
+	return "【危険】%s台所の食料%.1f人日分、水%.0fL、現金%d円を奪って、走り去った。" % [lead, food, water, cash]
+
+static func adults(world) -> int:
+	var n := 1
+	for m in world.s.household_members:
+		if float(m.health) > 0 and not bool(m.get("bitten", false)) and int(m.get("age", 30)) >= 13 and str(m.get("activity", "")) != "外出":
+			n += 1
+	return n
+
+## The household answers. kind: shout / give / fight. Returns the line.
+static func answer(world, kind: String, weapon: int = 0) -> String:
+	if not active(world):
+		return "外に人の気配はない。"
+	var minute := int(world.s.minute)
+	var roll: int = world.draw(minute, 33, "raid-" + kind, 100)
+	world.advance_safe(5)
+	match kind:
+		"shout":
+			var chance := mini(85, 25 + 15 * adults(world))
+			if roll < chance:
+				world.s.raid = {}
+				return "扉越しに、ありったけの声で怒鳴った。%s中の気配に、相手は舌打ちして去っていった。" % ("家の中から何人もの声が重なり、" if adults(world) > 1 else "")
+			return "怒鳴り返したが、外から笑い声が返ってきた。扉を叩く音が強くなる。"
+		"give":
+			if float(world.s.food) < 1.0:
+				return "渡せる食料がない。"
+			world.s.food = float(world.s.food) - 1.0
+			world.s.raid = {}
+			Mood.everyone(world, -2.0)
+			return "扉の隙間から食料（1人日分）を差し出すと、ひったくるように受け取って去っていった。"
+		"fight":
+			var chance := mini(85, 35 + weapon + 10 * adults(world))
+			world.s.injuries = float(world.s.injuries) + 1.0
+			if roll < chance:
+				world.s.raid = {}
+				world.s.health = maxf(1.0, float(world.s.health) - 10.0)
+				return "扉を開け放ち、武器を振り上げて飛び出した。もみ合いになり、腕を殴られたが、相手は逃げていった。"
+			world.s.health = maxf(1.0, float(world.s.health) - 25.0)
+			world.s.raid = {}
+			return _rob(world, "飛び出したが、数人がかりで殴り倒された。")
+	return ""
