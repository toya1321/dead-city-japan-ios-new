+func _survivor_talk(id: String, speech: String) -> String:
+	var reply := ""
+	if local_model.available():
+		_set_local_inference(true)
+		var data := Survivors.context(world, id, speech, Walkers.count(world, location))
+		var last := ""
+		var history: Array = data.get("_history", [])
+		if not history.is_empty():
+			last = str(history.back()[1])
+		for attempt in 3:
+			var verdict := await local_model.ask(self, data, false, Survivors.INSTRUCTIONS)
+			if str(verdict.get("kind", "")) != "chat":
+				continue
+			var candidate := str(verdict.value).strip_edges()
+			var why := Survivors.reject_reason(world, id, candidate, speech)
+			if why.is_empty() and candidate != last:
+				reply = candidate
+				break
+			survivor_rejects.append([candidate, why if not why.is_empty() else "repeated"])
+			# The model answers the same input the same way: name the rejected
+			# line so the next attempt has to say something else.
+			var banned: Array = data["事実"].get("使えない言い方", [])
+			banned.append(candidate)
+			data["事実"]["使えない言い方"] = banned
+		_set_local_inference(false)
+	Survivors.talked(world, id)
+	world.advance_safe(2)
+	if reply.is_empty():
+		if not local_model.available():
+			return "%s「%s」" % [Survivors.call_name(world, id), Survivors.offline_reply(world, id)]
+		# Better silence than a repeated or broken line.
+		return "%sは少し考え込んで、何も答えなかった。" % Survivors.call_name(world, id)
+	Survivors.remember(world, id, speech, reply)
+	return "%s「%s」" % [Survivors.call_name(world, id), reply]
