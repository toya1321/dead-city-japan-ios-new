diff --git a/qa/combo.gd b/qa/combo.gd
new file mode 100644
index 0000000..4c84dbc
--- /dev/null
+++ b/qa/combo.gd
@@ -0,0 +1,164 @@
+extends SceneTree
+## Rare combinations, one scenario each; prints OK/NG per scenario.
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+const Mood = preload("res://scripts/mood.gd")
+
+var results: Array = []
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func fresh(cohab: int = 1, housing: String = "一戸建て", seed: int = 5):
+	var g = Main.instantiate()
+	root.add_child(g)
+	for i in 3: await process_frame
+	var p: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+	p.seed = seed
+	p.housing = housing
+	p.cohabitants = cohab
+	p.companion_names = ["詩音", "蒼", "陸"].slice(0, cohab)
+	p.companion_genders = ["女性", "男性", "男性"].slice(0, cohab)
+	g._start_new_game(p)
+	g._finish_intro()
+	g.local_model.enabled = false
+	return g
+
+func run_cmds(g, cmds: Array) -> void:
+	for c in cmds:
+		await g._on_command(c)
+		var guard := 0
+		while g.advancing and guard < 30000:
+			await process_frame
+			guard += 1
+
+func verdict(name: String, g, extra: bool = true) -> void:
+	var ok: bool = g.world.validate_state(g.world.s) and extra and int(g.world.s.profile.cohabitants) == g.world.s.household_members.size()
+	results.append([name, ok])
+	print(("OK " if ok else "NG ") + name + " | last: " + str(g.log_entries[-1]).left(80).replace("\n", " / "))
+	g.queue_free()
+	await process_frame
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	# 1. The player dies while talking with a survivor; a housemate takes over.
+	var g = await fresh(1)
+	var w = g.world
+	w.s.society = "disrupted"
+	var sid: String = Survivors.ensure(w).people.keys()[0]
+	var sp: Dictionary = Survivors.person(w, sid)
+	g.location = sp.place
+	await run_cmds(g, ["%sに話しかける" % sp.label])
+	w.s.health = 0.0
+	g._refresh()
+	await process_frame
+	await run_cmds(g, ["周囲を見る", "水を渡す"])
+	await verdict("death mid-conversation → succession", g, g.survivor_partner == "" and float(w.s.health) > 0)
+	# 2. A horde passes while the door is battered down.
+	g = await fresh(1)
+	w = g.world
+	w.s.society = "emergency"
+	w.s.minute = 13 * 60 + 20 * 1440
+	w.s.walkers.risen = [7]
+	w.s.walkers.horde = {"place": "屋外", "step": 4, "size": 30}
+	w.s.door_hp = 10.0
+	g.location = "居間"
+	for i in 6:
+		w.s.minute += 60
+		Walkers.horde_hourly(w)
+		Walkers.home_events(w)
+		Walkers.make_sound(w, 120)
+	g._refresh()
+	await run_cmds(g, ["窓から外を見る", "玄関へ行く", "逃げる", "裏口から外に出る", "息をひそめる", "裏口から家に入る"])
+	await verdict("horde + broken door + back door", g)
+	# 3. A household of six.
+	g = await fresh(3)
+	w = g.world
+	w.s.society = "disrupted"
+	var joined := 0
+	for id in Survivors.ensure(w).people:
+		var p: Dictionary = Survivors.person(w, id)
+		if bool(p.joinable) and joined < 3:
+			p.trust = 90
+			p.join_trust = 60
+			Survivors.invite(w, id)
+			joined += 1
+	var names: Array = w.s.household_members.map(func(m): return str(m.name))
+	g.location = "居間"
+	for m in w.s.household_members:
+		m.location = "居間"
+		m.activity = "在宅"
+	await run_cmds(g, ["%s、おはよう" % names[-1], "%s、水を飲んで" % names[-1], "会話を終える", "%sの話を聞く" % names[4], "1日待つ"])
+	var saved: String = g._save()
+	var loaded: String = g._load()
+	await verdict("household of six (%d) talks, waits, saves" % w.s.household_members.size(), g, saved.begins_with("保存") and loaded == "保存データを読み込んだ。")
+	# 4. A flat: down the balcony ladder at night into walkers, and back.
+	g = await fresh(0, "集合住宅")
+	w = g.world
+	w.s.society = "emergency"
+	w.s.minute = 14 * 60 + 18 * 1440
+	w.s.walkers.risen = [7]
+	w.s.walkers.places = {"屋外": 3, "建物前": 2}
+	g.location = "居間"
+	await run_cmds(g, ["外に出る", "ベランダから外に出る", "隠れる", "逃げる", "ベランダから家に戻る", "窓から物を投げて気をそらす"])
+	await verdict("flat: ladder at night, walkers below", g)
+	# 5. A year on.
+	g = await fresh(1)
+	w = g.world
+	w.s.society = "emergency"
+	w.s.walkers.places = {"駅前": 20, "商店通り": 10, "屋外": 4}
+	w.s.minute = 400 * 1440
+	for i in 48:
+		w.s.minute += 60
+		w.step(false)
+	g._refresh()
+	await run_cmds(g, ["外に出る", "駅前へ行く", "デパートの前へ行く", "デパートに入る", "デパ地下へ行く", "家に帰る"])
+	await verdict("a year on: decay, overgrown photos", g, str(g.picture.texture.resource_path) != "")
+	# 6. Bitten and alone: leaving home with nobody to hand over to.
+	g = await fresh(0)
+	w = g.world
+	w.s.bitten = true
+	w.s.exposure = 10
+	g.location = "居間"
+	await run_cmds(g, ["みんなのために、一人で出ていく", "周囲を見る"])
+	await verdict("bitten and alone leaves", g)
+	# 7. A thief with nothing to steal.
+	g = await fresh(1)
+	w = g.world
+	var m0: Dictionary = w.s.household_members[0]
+	m0.honesty = 10
+	m0.leaving = true
+	m0.theft = true
+	w.s.food = 0.0
+	w.s.water = 0.0
+	g._refresh()
+	await verdict("thief with empty stores", g, w.s.household_members.is_empty() and float(w.s.food) >= 0.0)
+	# 8. A hidden bite surfaces during a horde.
+	g = await fresh(0)
+	w = g.world
+	w.s.society = "disrupted"
+	var hid: String = Survivors.ensure(w).people.keys()[1]
+	var hp: Dictionary = Survivors.person(w, hid)
+	hp.tag = "hidden_bite"
+	hp.secret = "誰にも言っていないが、肩を噛まれている。"
+	hp.joinable = true
+	hp.trust = 90
+	hp.join_trust = 60
+	Survivors.invite(w, hid)
+	w.s.household_members[0].hidden_bite_at = int(w.s.minute) + 60
+	w.s.walkers.horde = {"place": "屋外", "step": 4, "size": 20}
+	g.location = "居間"
+	await run_cmds(g, ["3時間待つ", "%sを寝室に隔離する" % hp.name, "息をひそめる", "1日待つ", "1日待つ", "1日待つ", "1日待つ"])
+	await verdict("hidden bite during a horde, isolated, dies and rises", g)
+	# 9. Survivor conversation then the shop: actions still work.
+	g = await fresh(0)
+	w = g.world
+	w.s.society = "disrupted"
+	w.s.minute = 4 * 60 + 12 * 1440
+	g.location = "コンビニ"
+	await run_cmds(g, ["タバコを買う", "店の在庫を見る", "食料を2個買う", "家に帰る"])
+	await verdict("konbini errands after the breakdown", g)
+	var ng := results.filter(func(r): return not r[1]).size()
+	print("COMBO %d / %d OK" % [results.size() - ng, results.size()])
+	quit()
diff --git a/qa/crawl.gd b/qa/crawl.gd
new file mode 100644
index 0000000..f80708b
--- /dev/null
+++ b/qa/crawl.gd
@@ -0,0 +1,190 @@
+extends SceneTree
+## Bug crawler: plays worlds by pressing suggestions and typing common
+## commands at random, checking the state after every step.
+## DCJ_SEEDS=1,2,3  DCJ_STEPS=400
+const Main = preload("res://main.tscn")
+const Walkers = preload("res://scripts/walkers.gd")
+const Survivors = preload("res://scripts/survivors.gd")
+
+const TYPED := ["周囲を見る", "避難所へ行く", "配給を受け取る", "掲示板を見る", "見張りを手伝う", "物資探しを手伝う", "避難所で寝る", "避難所の様子を聞く", "大声で追い払う", "食料を渡して帰ってもらう", "窓から外を見る", "ニュースを見る", "外に出る", "家に帰る", "寝る", "食事する", "水を飲む", "1時間待つ", "3時間待つ", "1日待つ",
+	"商店通りへ行く", "駅前へ行く", "住宅街へ行く", "デパートへ行く", "デパ地下へ行く", "薬局へ行く", "コンビニへ行く", "近所の空き家へ行く", "金物店へ行く", "食品店へ行く",
+	"食料を3個買う", "飲料水を3本買う", "包帯を2個買う", "木材を3個買う", "部品を2個買う", "タバコを買う", "カセットボンベを買う", "物資を持っていく", "物資を置く", "物資を探索する", "ここを拠点にする",
+	"明かりを消す", "明かりをつける", "窓を目張りする", "窓の目張りを外す", "鍵を閉める", "鍵を開ける", "玄関を補強", "玄関の補強を外す", "扉を直す",
+	"浴槽に水をためる", "浴槽の水を汲む", "温かい料理を作る", "映画を観る", "タバコを吸う", "本を読む", "通りが空くまで待つ", "息をひそめる",
+	"裏口から外に出る", "裏口から家に入る", "窓から物を投げて気をそらす", "隠れる", "逃げる", "戦う", "様子を見る", "物を投げて気をそらす",
+	"持ち物", "状態", "会話を終える", "水を渡す", "食料を渡す", "包帯を渡す", "交換できるものを聞く", "一緒に来ないか誘う", "何か知っていることはないか聞く",
+	"詩音に見張りを頼む", "蒼に探索を頼む", "詩音を料理担当にする", "蒼に修理を任せる", "詩音を手当て担当にする", "詩音の役割を外す", "役割を決める",
+	"大丈夫ですか？", "家族は無事なの？", "その傷、どうしたの？", "名前、聞いてもいい？", "みんなのために、一人で出ていく"]
+
+var problems: Array = []
+var rng := RandomNumberGenerator.new()
+
+func _initialize() -> void:
+	call_deferred("run")
+
+func problem(seed: int, step: int, cmd: String, what: String) -> void:
+	problems.append([seed, step, cmd, what])
+	print("PROBLEM seed=%d step=%d cmd=%s :: %s" % [seed, step, cmd, what])
+
+func check_state(g, seed: int, step: int, cmd: String) -> void:
+	var w = g.world
+	var s: Dictionary = w.s
+	if not w.validate_state(s):
+		problem(seed, step, cmd, "validate_state failed")
+	for key in ["health", "hunger", "thirst", "fatigue"]:
+		var v := float(s[key])
+		if is_nan(v) or v < -0.001 or v > 100.001:
+			problem(seed, step, cmd, "%s out of range: %f" % [key, v])
+	if s.has("mood") and (float(s.mood) < 0 or float(s.mood) > 100):
+		problem(seed, step, cmd, "mood out of range")
+	for key in ["food", "water"]:
+		if float(s[key]) < -0.001 or is_nan(float(s[key])):
+			problem(seed, step, cmd, "%s negative: %f" % [key, float(s[key])])
+	if float(s.district.bag.food) < -0.001 or float(s.district.bag.water) < -0.001:
+		problem(seed, step, cmd, "bag negative")
+	for item in s.inventory:
+		if float(s.inventory[item]) < 0:
+			problem(seed, step, cmd, "inventory %s negative" % item)
+	if int(s.profile.cohabitants) != s.household_members.size():
+		problem(seed, step, cmd, "cohabitants %d != members %d" % [int(s.profile.cohabitants), s.household_members.size()])
+	if s.profile.companion_names.size() != s.household_members.size():
+		problem(seed, step, cmd, "companion_names size mismatch")
+	for i in s.household_members.size():
+		var m: Dictionary = s.household_members[i]
+		if int(m.id) != i:
+			problem(seed, step, cmd, "member id %d at index %d" % [int(m.id), i])
+		if s.profile.companion_names.size() > i and str(s.profile.companion_names[i]) != str(m.name):
+			problem(seed, step, cmd, "companion name mismatch at %d" % i)
+		for key in ["health", "hunger", "thirst", "fatigue"]:
+			if float(m.get(key, 0)) < -0.001 or float(m.get(key, 0)) > 100.001:
+				problem(seed, step, cmd, "member %s %s out of range" % [m.name, key])
+	for place in s.walkers.places:
+		if int(s.walkers.places[place]) < 0:
+			problem(seed, step, cmd, "walkers negative at %s" % place)
+	var horde: Dictionary = s.walkers.get("horde", {})
+	if not horde.is_empty() and int(horde.size) < 0:
+		problem(seed, step, cmd, "horde size negative")
+	if not s.walkers.encounter.is_empty() and str(s.walkers.encounter.place) != g.location and float(s.health) > 0:
+		pass   # cleared on the next command by design
+	if g.dialogue.partner >= s.household_members.size():
+		problem(seed, step, cmd, "dialogue partner out of range")
+	if not g.survivor_partner.is_empty() and Survivors.person(w, g.survivor_partner).is_empty():
+		problem(seed, step, cmd, "survivor partner unknown")
+	if not Navigation_has(g.location, str(s.profile.housing)):
+		problem(seed, step, cmd, "unknown location " + g.location)
+	if g.advancing:
+		problem(seed, step, cmd, "still advancing after the command")
+	if g.log_entries.is_empty():
+		problem(seed, step, cmd, "empty log")
+
+## Survivor play: go to someone, talk, give, trade, ask, invite.
+func survivor_move(g, w) -> String:
+	var alive: Array = []
+	var people: Dictionary = Survivors.ensure(w).people
+	for id in people:
+		if people[id].status == "alive":
+			alive.append(id)
+	if alive.is_empty():
+		return "1日待つ"
+	var id: String = alive[rng.randi_range(0, alive.size() - 1)]
+	var p: Dictionary = people[id]
+	w.s.district.bag.food = 4.0
+	w.s.district.bag.water = 8.0
+	w.s.inventory.bandage = maxi(int(w.s.inventory.bandage), 2)
+	if g.location != str(p.place):
+		return "%sへ行く" % p.place
+	var r := rng.randi_range(1, 7)
+	if r == 7:
+		p.trust = mini(100, int(p.trust) + 30)
+	return ["%sに話しかける" % p.label, "水を渡す", "食料を渡す", "包帯を渡す", "交換できるものを聞く", "%sと交換する" % "包帯", "一緒に来ないか誘う", "何か知っていることはないか聞く"][r - 1] if r < 7 else "一緒に来ないか誘う"
+
+func Navigation_has(place: String, housing: String) -> bool:
+	var graph: Dictionary = load("res://scripts/navigation.gd").graph(housing)
+	return graph.has(place)
+
+func run() -> void:
+	root.size = Vector2i(390, 844)
+	var seeds: Array = []
+	for part in OS.get_environment("DCJ_SEEDS").split(","):
+		if not part.is_empty():
+			seeds.append(int(part))
+	if seeds.is_empty():
+		seeds = [11, 22, 33]
+	var steps := int(OS.get_environment("DCJ_STEPS")) if not OS.get_environment("DCJ_STEPS").is_empty() else 300
+	for seed in seeds:
+		rng.seed = seed
+		var g = Main.instantiate()
+		root.add_child(g)
+		for i in 3: await process_frame
+		var profile: Dictionary = g.world.DEFAULT_PROFILE.duplicate(true)
+		profile.seed = seed
+		profile.cohabitants = [0, 1, 2][seed % 3]
+		profile.housing = ["一戸建て", "集合住宅"][rng.randi_range(0, 1)]
+		profile.companion_names = ["詩音", "蒼"].slice(0, profile.cohabitants)
+		profile.companion_genders = ["女性", "男性"].slice(0, profile.cohabitants)
+		g._start_new_game(profile)
+		g._finish_intro()
+		g.local_model.enabled = false
+		var w = g.world
+		var deaths := 0
+		var mode := OS.get_environment("DCJ_MODE")
+		if mode == "survivors":
+			w.s.society = "disrupted"
+			w.s.regional_cases = 150
+		for step in steps:
+			var cmd := ""
+			var roll := rng.randi_range(1, 100)
+			var chips: Array = g._suggestions()
+			if mode == "long" and roll <= 55:
+				roll = 200   # mostly whole days
+			if mode == "survivors" and roll <= 30:
+				roll = 300
+			if roll == 200:
+				cmd = "1日待つ"
+			elif roll == 300:
+				cmd = survivor_move(g, w)
+			elif roll <= 45 and not chips.is_empty():
+				cmd = str(chips[rng.randi_range(0, chips.size() - 1)])
+			elif roll <= 78:
+				cmd = TYPED[rng.randi_range(0, TYPED.size() - 1)]
+			elif roll <= 95:
+				cmd = "%d時間待つ" % rng.randi_range(4, 23)
+			else:
+				cmd = "(save/load)"
+			# Keep the household fed so the run goes deep into the outbreak.
+			if step % 20 == 0:
+				w.s.food = maxf(float(w.s.food), 6.0)
+				w.s.water = maxf(float(w.s.water), 10.0)
+				w.s.cash = maxi(int(w.s.cash), 20000)
+			if cmd == "(save/load)":
+				var saved: String = g._save()
+				var bytes := var_to_bytes(w.s)
+				var loaded: String = g._load()
+				if not saved.begins_with("保存") or loaded != "保存データを読み込んだ。":
+					problem(seed, step, cmd, "save/load failed: %s / %s" % [saved, loaded])
+				elif var_to_bytes(g.world.s) != bytes:
+					problem(seed, step, cmd, "state changed across save/load")
+				w = g.world
+			else:
+				await g._on_command(cmd)
+				var guard := 0
+				while g.advancing and guard < 20000:
+					await process_frame
+					guard += 1
+			check_state(g, seed, step, cmd)
+			if OS.get_environment("DCJ_TRACE") == "1":
+				print("TRACE %d %s | 曝露%d 発症%s 噛%s 傷%d | 体%.1f 満%.0f 水%.0f 休%.0f | %s | %s" % [step, cmd, int(w.s.exposure), str(w.s.symptomatic), str(w.s.get("bitten", false)), int(w.s.injuries), float(w.s.health), 100 - float(w.s.hunger), 100 - float(w.s.thirst), 100 - float(w.s.fatigue), g.location, g.log_entries[-1].left(90).replace("\n", " / ")])
+			if mode == "survivors" and not str(w.s.society) in ["disrupted", "emergency"]:
+				w.s.society = "disrupted"
+				w.s.regional_cases = maxi(int(w.s.regional_cases), 150)
+			if mode == "long" and step % 25 == 0:
+				w.s.health = maxf(float(w.s.health), 60.0)
+			if float(w.s.health) <= 0:
+				deaths += 1
+				print("seed %d: died at step %d (day %d)" % [seed, step, int(w.s.minute) / 1440])
+				break
