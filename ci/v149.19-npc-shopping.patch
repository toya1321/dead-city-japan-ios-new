+	var each := RegEx.new()
+	each.compile("(%s)\\s*(?:%s)?\\s*(?:ずつ|づつ)" % [HouseholdErrands.COUNT, HouseholdErrands.UNITS])
+	var shared := each.search(speech)
+	var result: Array = []
+	for entry in items:
+		var quantity := int(entry[1])
+		for answer in named:
